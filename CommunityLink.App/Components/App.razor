@using System.Globalization
@{
    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("my", StringComparison.OrdinalIgnoreCase) ? "my" : "en";
}
<!DOCTYPE html>
<html lang="@currentLang" class="h-full overflow-hidden">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('communitylink_theme');
                var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <!-- Self-hosted Myanmar Fonts Preload -->
    <link rel="preload" href="fonts/Pyidaungsu-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="fonts/Pyidaungsu-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="css/app.css?v=2.0" />
    <link rel="stylesheet" href="CommunityLink.App.styles.css?v=2.0" />
    <link rel="stylesheet" href="css/home.css?v=2.0" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="h-full overflow-hidden bg-[#F8FAFC] dark:bg-[#0A0D14] text-[#0A1B2E] dark:text-[#E1E2EC] antialiased font-sans transition-colors duration-150">
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/theme.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r125/three.min.js"></script>
    <script src="js/globe.js?v=6"></script>
    <script src="js/linkdrop-3d.js"></script>
    <script src="js/chat.js"></script>
    <script>
        function togglePasswordVisibility(button) {
            var container = button.closest('.relative');
            if (!container) return;
            var input = container.querySelector('input');
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            var svgs = button.querySelectorAll('svg');
            svgs.forEach(function (svg) {
                svg.classList.toggle('hidden');
            });
        }

        window.scrollToElement = function (id) {
            var el = document.getElementById(id);
            if (!el) return;

            var parent = el.parentElement;
            var scrollContainer = null;
            while (parent && parent !== document.body && parent !== document.documentElement) {
                var style = window.getComputedStyle(parent);
                var overflowY = style.overflowY || style.overflow;
                if (overflowY === 'auto' || overflowY === 'scroll') {
                    scrollContainer = parent;
                    break;
                }
                parent = parent.parentElement;
            }

            if (!scrollContainer) {
                scrollContainer = document.querySelector('main') || window;
            }

            if (scrollContainer && scrollContainer !== window && scrollContainer.scrollTo) {
                var rect = el.getBoundingClientRect();
                var containerRect = scrollContainer.getBoundingClientRect();
                var targetTop = scrollContainer.scrollTop + (rect.top - containerRect.top) - 16;
                scrollContainer.scrollTo({ top: targetTop, behavior: 'smooth' });
            } else {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        };
    </script>
</body>

</html>
