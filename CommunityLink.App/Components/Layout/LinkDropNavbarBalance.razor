@rendermode InteractiveServer
@inject LinkDropApiService LinkDropApi
@inject NavigationManager Navigation
@implements IDisposable

<div class="relative inline-flex items-center" data-testid="linkdrop-navbar-balance">
    <a href="linkdrops"
       class="inline-flex items-center gap-1.5 pl-1.5 pr-2.5 py-1 rounded-lg text-xs font-bold @(isError ? "bg-slate-100 dark:bg-[#182030] text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-[rgba(255,255,255,0.08)]" : "bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-200 border border-sky-200 dark:border-sky-800/60 hover:bg-sky-100 dark:hover:bg-sky-900/50 hover:border-sky-300 dark:hover:border-sky-700") transition shadow-2xs group cursor-pointer"
       title="@(isLoading ? "Loading Link Drop Balance..." : isError || wallet == null ? "Link Drop Wallet Unavailable" : $"Total Link Drops: {wallet.Balance:N0} (Purchased: {wallet.PurchasedBalance:N0} | Earned: {wallet.EarnedBalance:N0})")">
        <LinkDrop3dIcon Class="w-6 h-6 shrink-0 group-hover:scale-110 transition-transform" />
        @if (isLoading)
        {
            <span class="animate-pulse text-sky-500 font-mono">...</span>
        }
        else if (isError || wallet == null)
        {
            <span class="font-mono">--</span>
        }
        else
        {
            <span class="font-mono tracking-tight" data-testid="linkdrop-total-balance">@wallet.Balance.ToString("N0")</span>
        }
    </a>
</div>

@code {
    private LinkDropWalletDto? wallet;
    private bool isLoading = true;
    private bool isError;
    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await FetchWalletAsync();

        pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await FetchWalletAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task FetchWalletAsync()
    {
        try
        {
            var result = await LinkDropApi.GetUserWalletAsync();
            if (result.IsSuccess && result.Data != null)
            {
                wallet = result.Data;
                isError = false;
            }
            else
            {
                isError = true;
            }
        }
        catch
        {
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}
