@inherits LayoutComponentBase
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PremiumUpgradeApiService UpgradeApi

<div class="h-screen flex overflow-hidden bg-[#F8FAFC] dark:bg-[#0A0D14] text-[#0A1B2E] dark:text-[#E1E2EC] font-sans antialiased transition-colors duration-150">
    <!-- Backdrop for mobile when sidebar is open -->
    @if (isSidebarOpen && !isNormalUser)
    {
        <div class="fixed inset-0 bg-[#0A1B2E]/20 dark:bg-black/60 backdrop-blur-xs z-30 lg:hidden" @onclick="ToggleSidebar"></div>
    }

    <!-- Executive Minimalist Closeable Sidebar (Fixed / Stays in place) - hidden for the default USER role -->
    @if (!isNormalUser)
    {
        <aside class="@(isSidebarOpen ? "w-64 min-w-[16rem]" : "w-0 min-w-0 border-r-0 overflow-hidden pointer-events-none") fixed lg:relative inset-y-0 left-0 h-screen bg-white dark:bg-[#0A0D14] text-[#0A1B2E] dark:text-[#E1E2EC] flex flex-col border-r border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] shadow-sm z-40 transition-all duration-200 ease-in-out shrink-0">
            <NavMenu OnClose="ToggleSidebar" />
        </aside>
    }

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col h-screen min-w-0 overflow-hidden">
        <!-- Top App Bar with Global Search & Primary Menu -->
        <header class="bg-white/95 dark:bg-[#111622]/95 backdrop-blur-md border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] px-4 sm:px-6 py-2.5 flex items-center gap-3 shadow-xs shrink-0 z-40 relative">
            <!-- Left: Brand, Sidebar Toggle, Search & Menu -->
            <div class="flex items-center gap-3 flex-1 min-w-0">
                @if (isNormalUser)
                {
                    <a href="" class="flex items-center gap-2.5 no-underline shrink-0" title="CommunityLink">
                        <span class="w-8 h-8 rounded bg-[#0A1B2E] dark:bg-[#D4AF37] text-white dark:text-[#0A0D14] flex items-center justify-center font-bold text-sm shadow-sm transition-colors duration-150" style="font-family:'Plus Jakarta Sans',sans-serif">CL</span>
                        <span class="hidden xl:block leading-none">
                            <span class="font-bold text-sm text-[#0A1B2E] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Community<span class="text-[#D4AF37]">Link</span></span>
                            <span class="block font-mono text-[9px] uppercase tracking-wider text-[#64748B] dark:text-[#94A3B8] mt-0.5">SOVEREIGN NETWORK</span>
                        </span>
                    </a>
                }
                else
                {
                    <button @onclick="ToggleSidebar" class="p-1.5 rounded text-[#557392] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-white hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition cursor-pointer shrink-0" title="Toggle navigation sidebar" aria-label="Toggle navigation sidebar">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                }

                <!-- Global Search Box -->
                <div class="relative w-40 sm:w-56 xl:w-72 shrink">
                    <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-[#7A8CA6] dark:text-[#64748B]">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                    <input type="text"
                           placeholder="Search hubs, spaces, passes..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown"
                           class="w-full pl-8 pr-3 py-1.5 text-xs rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.10)] bg-[#F1F5F9] dark:bg-[#0A0D14] text-[#0A1B2E] dark:text-[#E1E2EC] placeholder-[#7A8CA6] dark:placeholder-[#64748B] focus:bg-white dark:focus:bg-[#0A0D14] focus:outline-none focus:ring-1 focus:ring-[#6366F1] focus:border-[#6366F1] transition" />
                </div>

                @if (isNormalUser)
                {
                    <nav class="flex items-center gap-1 flex-1 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" aria-label="Primary">
                        <NavLink class="px-3 py-1.5 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2 whitespace-nowrap" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="" Match="NavLinkMatch.All">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            <span>Home</span>
                        </NavLink>
                        <NavLink class="px-3 py-1.5 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2 whitespace-nowrap" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="communities">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                            <span>Communities</span>
                        </NavLink>
                        <NavLink class="px-3 py-1.5 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2 whitespace-nowrap" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="groups">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Groups</span>
                        </NavLink>
                        <NavLink class="px-3 py-1.5 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2 whitespace-nowrap" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="chat">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z"/></svg>
                            <span>Chat</span>
                        </NavLink>
                        <NavLink class="px-3 py-1.5 rounded text-xs font-semibold text-[#D4AF37] hover:bg-[#D4AF37]/10 transition flex items-center gap-2 whitespace-nowrap" ActiveClass="!bg-[#D4AF37] !text-[#0A0D14] shadow-sm font-bold" href="upgrade">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <span class="font-bold">Premium</span>
                        </NavLink>
                    </nav>
                }
            </div>

            <!-- Right: Status Pill, Theme Toggle, Admin Badge, User Actions -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <!-- Theme Toggle Button (Midnight Executive) -->
                <button @onclick="ToggleThemeAsync"
                        class="p-1.5 rounded border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.10)] bg-[#F1F5F9] dark:bg-[#182030] text-[#0A1B2E] dark:text-[#E1E2EC] hover:bg-[#E2E8F0] dark:hover:bg-[#1C263A] transition cursor-pointer flex items-center justify-center shadow-2xs"
                        title="@(isDarkMode ? "Switch to Executive Minimalist Light Mode" : "Switch to Midnight Executive Dark Mode")"
                        aria-label="Toggle visual optical mode">
                    @if (isDarkMode)
                    {
                        <!-- Sun Icon for switching to light -->
                        <svg class="w-4 h-4 text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                    }
                    else
                    {
                        <!-- Moon Icon for switching to dark -->
                        <svg class="w-4 h-4 text-[#0A1B2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                    }
                </button>

                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-2 sm:gap-3">
                            <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)" Context="adminCtx">
                                <Authorized>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-mono font-bold bg-[#F1F5F9] dark:bg-[#182030] text-[#0A1B2E] dark:text-[#E1E2EC] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] shadow-xs">
                                        <svg class="w-3 h-3 text-[#0A1B2E] dark:text-[#D4AF37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        <span class="hidden sm:inline">ADMIN NODE</span>
                                    </span>
                                </Authorized>
                            </AuthorizeView>
                            <LinkDropNavbarBalance />

                            <NotificationBell />

                            <div class="relative">
                                <button type="button" @onclick="ToggleProfileMenu" @onclick:stopPropagation
                                        class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E2EC] hover:text-[#557392] dark:hover:text-white transition flex items-center gap-1.5 px-2 py-1 rounded hover:bg-[#F1F5F9] dark:hover:bg-[#182030] cursor-pointer"
                                        title="Account menu" aria-label="Account menu" aria-expanded="@(isProfileMenuOpen ? "true" : "false")">
                                    <svg class="w-3.5 h-3.5 text-[#557392] dark:text-[#94A3B8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span class="hidden md:inline">@context.User.Identity?.Name</span>
                                </button>

                                @if (isProfileMenuOpen)
                                {
                                    <div class="fixed inset-0 z-[90] cursor-default bg-transparent" @onclick="CloseProfileMenu"></div>

                                    <div class="absolute right-0 mt-2 w-64 rounded-xl bg-white dark:bg-[#111622] shadow-2xl border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.15)] z-[100] overflow-hidden animate-in fade-in zoom-in-95 duration-150">
                                        <div class="p-3.5 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-[#F8FAFC] dark:bg-[#0A0D14] flex items-center gap-3">
                                            <div class="w-9 h-9 rounded bg-[#0A1B2E] dark:bg-[#D4AF37] text-white dark:text-[#0A0D14] font-bold text-xs flex items-center justify-center shrink-0 shadow-sm transition-colors duration-150" style="font-family:'Plus Jakarta Sans',sans-serif">
                                                @userInitials
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E2EC] truncate flex items-center gap-1.5">
                                                    <span class="truncate">@userDisplayName</span>
                                                    <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)" Context="cardAdminCtx">
                                                        <Authorized>
                                                            <span class="w-3.5 h-3.5 flex items-center justify-center text-[#0A1B2E] dark:text-[#D4AF37]" title="Administrator">
                                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                                            </span>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </div>
                                                <div class="text-[10px] text-[#64748B] dark:text-[#94A3B8] truncate font-mono">
                                                    @userRoleLabel
                                                </div>
                                            </div>
                                        </div>

                                        <nav class="p-2 flex flex-col gap-0.5" aria-label="Account">
                                            <NavLink @onclick="CloseProfileMenu" class="px-3.5 py-2 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="profile">
                                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                                <span>Profile</span>
                                            </NavLink>
                                            <NavLink @onclick="CloseProfileMenu" class="px-3.5 py-2 rounded text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] shadow-sm" href="activity">
                                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                                                <span>Activity</span>
                                            </NavLink>
                                        </nav>

                                        <div class="p-2 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-slate-50/50 dark:bg-black/20">
                                            <form method="post" action="/account/logout" class="w-full">
                                                <AntiforgeryToken />
                                                <button type="submit" class="w-full flex items-center gap-2 px-3.5 py-2 rounded text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer" title="Disconnect Session">
                                                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                                    <span>Log Out</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="flex items-center gap-2">
                            <a href="login" class="px-3.5 py-1.5 rounded text-xs font-bold text-white bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#D4AF37] dark:hover:bg-[#F2CA50] dark:text-[#0A0D14] shadow-xs transition no-underline">Login</a>
                            <a href="register" class="px-3.5 py-1.5 rounded text-xs font-bold text-[#0A1B2E] dark:text-[#E1E2EC] bg-white dark:bg-[#182030] hover:bg-[#F1F5F9] dark:hover:bg-[#1C263A] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.10)] transition no-underline">Register</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Body -->
        <main class="flex-1 p-6 overflow-y-auto bg-[#F8FAFC] dark:bg-[#0A0D14] transition-colors duration-150">
            @Body
        </main>
        <ToastContainer />
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet class="hidden fixed bottom-0 inset-x-0 bg-amber-600 text-white p-3 z-50 text-center font-medium shadow-2xl">
    An unhandled error has occurred.
    <a href="." class="underline font-bold ml-2">Reload</a>
    <span class="dismiss cursor-pointer ml-4 font-bold">🗙</span>
</div>

@code {
    private bool isSidebarOpen = true;
    private string searchQuery = "";
    private bool isDarkMode = false;
    private bool isProfileMenuOpen = false;
    private bool isNormalUser = false;
    private string userDisplayName = "Member";
    private string userInitials = "U";
    private string userRoleLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userDisplayName = user.Identity.Name ?? "Member";
            userInitials = string.IsNullOrWhiteSpace(userDisplayName) ? "U" : userDisplayName.Trim()[..1].ToUpperInvariant();
        }

        var roleCode = (user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value ?? string.Empty).Trim();
        bool isPremiumRole = roleCode.Equals("DOMAIN_PRO", StringComparison.OrdinalIgnoreCase) ||
                             roleCode.Equals("DOMAIN_PROFESSIONAL", StringComparison.OrdinalIgnoreCase) ||
                             roleCode.Equals("PUBLIC_FIGURE", StringComparison.OrdinalIgnoreCase) ||
                             roleCode.Equals("ADMIN", StringComparison.OrdinalIgnoreCase);

        bool hasActiveSubscription = false;
        if (user.Identity?.IsAuthenticated == true && !isPremiumRole)
        {
            try
            {
                var statusRes = await UpgradeApi.GetMyStatusAsync();
                if (statusRes.IsSuccess && statusRes.Data?.HasActiveSubscription == true)
                {
                    hasActiveSubscription = true;
                    if (!string.IsNullOrEmpty(statusRes.Data.TierName))
                    {
                        userRoleLabel = statusRes.Data.TierName;
                    }
                }
            }
            catch
            {
                // Graceful fallback if api unavailable
            }
        }

        // Sidebar is for Premium and Admin users. The navbar is only for Default User Role.
        isNormalUser = user.Identity?.IsAuthenticated == true && !isPremiumRole && !hasActiveSubscription;

        if (string.IsNullOrEmpty(userRoleLabel))
        {
            userRoleLabel = roleCode.ToUpperInvariant() switch
            {
                "ADMIN" => "Administrator",
                "USER" => "Default User",
                "MEMBER" => "Community Member",
                "MODERATOR" => "Community Moderator",
                "DOMAIN_PRO" or "DOMAIN_PROFESSIONAL" => "Domain Professional",
                "PUBLIC_FIGURE" => "Public Figure",
                _ => string.IsNullOrEmpty(roleCode) ? "Guest" : roleCode
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var currentTheme = await JS.InvokeAsync<string>("themeManager.getTheme");
                isDarkMode = currentTheme == "dark";
                StateHasChanged();
            }
            catch
            {
                // Silently handle if JS is unavailable during prerender
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var nextTheme = await JS.InvokeAsync<string>("themeManager.toggleTheme");
            isDarkMode = nextTheme == "dark";
        }
        catch
        {
            isDarkMode = !isDarkMode;
        }
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    private void CloseProfileMenu()
    {
        isProfileMenuOpen = false;
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"communities?search={Uri.EscapeDataString(searchQuery.Trim())}");
        }
    }
}
