@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthSessionService Session

<div class="flex min-h-screen bg-slate-50 font-sans text-slate-800">
    <!-- Admin Sidebar -->
    <aside class="w-64 min-w-[16rem] bg-slate-900 text-slate-100 p-5 flex flex-col justify-between shadow-xl">
        <div>
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-800">
                <span class="text-2xl">🛡️</span>
                <div>
                    <h5 class="text-base font-bold text-white tracking-tight">Community<span class="text-indigo-400">Link</span></h5>
                    <p class="text-xs text-slate-400 font-medium">Admin Control Panel</p>
                </div>
            </div>

            <nav class="flex flex-col gap-1">
                <NavLink href="admin/dashboard" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>📊</span> Overview Stats
                </NavLink>
                <NavLink href="admin/communities" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>🏛️</span> Hub Moderation
                </NavLink>
                <NavLink href="admin/users" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>👥</span> User Directory
                </NavLink>
                <NavLink href="admin/accounts" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>🔑</span> Account Creation
                </NavLink>
                <NavLink href="admin/rbac" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>🛡️</span> Role &amp; Permissions
                </NavLink>
                <NavLink href="admin/audits" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>📜</span> System Audit Logs
                </NavLink>
                <NavLink href="admin/settings" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>⚙️</span> Platform Settings
                </NavLink>
                <NavLink href="admin/linkdrops" Match="NavLinkMatch.Prefix" class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600">
                    <span>💧</span> Link Drops Review
                </NavLink>
            </nav>
        </div>

        <div class="pt-4 border-t border-slate-800">
            <a href="/" class="flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
                <span>←</span> Back to Main App
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto">
        @Body
    </main>
</div>
