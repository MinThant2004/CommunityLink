@rendermode InteractiveServer
@inject NotificationApiService NotificationApi
@inject NavigationManager Navigation
@implements IDisposable

<div class="relative inline-block text-left" @onclick:stopPropagation>
    <!-- Bell Button with Unread Badge -->
    <button type="button" @onclick="ToggleDropdown"
            class="relative p-1.5 rounded text-[#557392] hover:text-[#0A1B2E] hover:bg-[#F1F5F9] dark:text-[#C4D2E1] dark:hover:text-white dark:hover:bg-[#1B3B5A] transition focus:outline-none cursor-pointer"
            title="Notifications">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>

        @if (unreadCount > 0)
        {
            <span class="absolute -top-1 -right-1 flex h-4 min-w-[1rem] px-1 items-center justify-center rounded-full bg-[#BA1A1A] text-[9px] font-bold text-white shadow-xs animate-pulse">
                @(unreadCount > 99 ? "99+" : unreadCount.ToString())
            </span>
        }
    </button>

    <!-- Dropdown Panel -->
    @if (isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="notification-dropdown-panel absolute right-0 mt-2 rounded-xl bg-white dark:bg-[#112A46] shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] z-50 overflow-hidden animate-in fade-in zoom-in-95 duration-150"
             style="width: min(32rem, calc(100vw - 2rem));">
            <!-- Header -->
            <div class="p-3.5 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <h3 class="font-bold text-xs text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Notifications</h3>
                    @if (unreadCount > 0)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#E3EFFF] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.2)]">
                            @unreadCount new
                        </span>
                    }
                </div>
                @if (unreadCount > 0)
                {
                    <button type="button" @onclick="MarkAllAsRead" class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
                        Mark all as read
                    </button>
                }
            </div>

            <!-- List Body -->
            <div class="max-h-[30rem] overflow-y-auto divide-y divide-slate-100 dark:divide-[rgba(196,210,225,0.08)]">
                @if (isLoading && notifications.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400 dark:text-[#7A8CA6]">
                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-[#0A1B2E] dark:border-white"></div>
                        <p class="text-xs mt-2">Loading notifications...</p>
                    </div>
                }
                else if (notifications.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400 dark:text-[#7A8CA6]">
                        <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-2 text-slate-400 dark:text-[#7A8CA6]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9M3 3l18 18" />
                            </svg>
                        </div>
                        <p class="text-xs font-medium text-slate-600 dark:text-[#E1E8F0]">No notifications yet</p>
                        <p class="text-[11px] text-slate-400 dark:text-[#7A8CA6] mt-0.5">When you get likes, comments, votes or group updates, they will appear here.</p>
                    </div>
                }
                else
                {
                    @foreach (var notif in notifications)
                    {
                        <div @onclick="() => HandleNotificationClick(notif)"
                             class="p-3.5 flex items-start gap-3 transition cursor-pointer hover:bg-slate-50/80 dark:hover:bg-[#1B3B5A]/40 @(!notif.IsRead ? "bg-indigo-50/40 dark:bg-indigo-950/20" : "")">
                            <!-- Icon / Avatar -->
                            <div class="relative shrink-0">
                                @if (!string.IsNullOrEmpty(notif.ActorAvatar))
                                {
                                    <img src="@notif.ActorAvatar" alt="@notif.ActorName" class="w-9 h-9 rounded-full object-cover border border-slate-200 dark:border-[rgba(196,210,225,0.2)]" />
                                }
                                else
                                {
                                    <div class="w-9 h-9 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 font-bold text-xs flex items-center justify-center">
                                        @(string.IsNullOrWhiteSpace(notif.ActorName) ? "U" : notif.ActorName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full flex items-center justify-center bg-white dark:bg-[#112A46] shadow-xs border border-slate-200 dark:border-slate-700">
                                    @RenderNotificationBadgeIcon(notif.NotificationType)
                                </span>
                            </div>

                            <!-- Text Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <h4 class="text-xs font-bold text-slate-900 dark:text-[#E1E8F0] truncate">@notif.Title</h4>
                                    <span class="text-[10px] text-slate-400 dark:text-[#7A8CA6] shrink-0">@FormatTimeAgo(notif.CreatedAt)</span>
                                </div>
                                <p class="text-xs text-slate-600 dark:text-[#C4D2E1] mt-0.5 leading-snug break-words">@notif.Message</p>
                            </div>

                            <!-- Unread Indicator Dot -->
                            @if (!notif.IsRead)
                            {
                                <span class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] shrink-0 mt-2" title="Unread"></span>
                            }
                        </div>
                    }

                    <!-- See More Button -->
                    @if (hasMore)
                    {
                        <div class="p-3 bg-slate-50/60 dark:bg-[#0A1B2E]/60 text-center border-t border-slate-100 dark:border-[rgba(196,210,225,0.1)]">
                            <button type="button" @onclick="LoadMoreNotifications" disabled="@isLoadingMore"
                                    class="w-full py-1.5 px-3 text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-slate-200 dark:hover:bg-[#1B3B5A] rounded-lg transition disabled:opacity-50 flex items-center justify-center gap-1.5 cursor-pointer">
                                @if (isLoadingMore)
                                {
                                    <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <span>See more</span>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                                }
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen;
    private int unreadCount = 0;
    private int totalCount = 0;
    private List<NotificationDto> notifications = new();
    private bool isLoading;
    private bool isLoadingMore;
    private int currentSkip = 0;
    private const int PageSize = 10;
    private bool hasMore => notifications.Count < totalCount;
    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadCount();

        // Check for new notifications every 30 seconds
        pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadUnreadCount();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            currentSkip = 0;
            notifications.Clear();
            await FetchNotifications();
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var res = await NotificationApi.GetUnreadCountAsync();
            if (res.IsSuccess)
            {
                unreadCount = res.Data;
            }
        }
        catch
        {
            // Silently handle
        }
    }

    private async Task FetchNotifications()
    {
        try
        {
            isLoading = true;
            var res = await NotificationApi.GetNotificationsAsync(skip: currentSkip, take: PageSize);
            if (res.IsSuccess && res.Data != null)
            {
                totalCount = res.Data.TotalCount;
                unreadCount = res.Data.UnreadCount;
                notifications = res.Data.Notifications.ToList();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMoreNotifications()
    {
        if (isLoadingMore || !hasMore) return;

        try
        {
            isLoadingMore = true;
            currentSkip += PageSize;
            var res = await NotificationApi.GetNotificationsAsync(skip: currentSkip, take: PageSize);
            if (res.IsSuccess && res.Data != null)
            {
                totalCount = res.Data.TotalCount;
                unreadCount = res.Data.UnreadCount;
                notifications.AddRange(res.Data.Notifications);
            }
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private async Task HandleNotificationClick(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            notif.IsRead = true;
            if (unreadCount > 0) unreadCount--;
            await NotificationApi.MarkAsReadAsync(notif.NotificationId);
        }

        isOpen = false;

        if (!string.IsNullOrWhiteSpace(notif.TargetUrl))
        {
            Navigation.NavigateTo(notif.TargetUrl);
        }
        else
        {
            Navigation.NavigateTo("/groups");
        }
    }

    private async Task MarkAllAsRead()
    {
        await NotificationApi.MarkAllAsReadAsync();
        foreach (var n in notifications)
        {
            n.IsRead = true;
        }
        unreadCount = 0;
    }

    private RenderFragment RenderNotificationBadgeIcon(string type) => builder =>
    {
        var upper = type?.ToUpperInvariant();
        switch (upper)
        {
            case "LIKE":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-rose-500 fill-rose-500"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z""/></svg>");
                break;
            case "COMMENT":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-sky-500"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z""/></svg>");
                break;
            case "SHARE":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-indigo-500"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z""/></svg>");
                break;
            case "POLL_VOTE":
            case "POLL_END":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-violet-500"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z""/></svg>");
                break;
            case "GROUP_UPDATE":
            case "GROUP_JOIN_REQUEST":
            case "USER_FOLLOW":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-blue-500"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z""/></svg>");
                break;
            case "GROUP_JOIN_APPROVED":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-emerald-500"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M5 13l4 4L19 7""/></svg>");
                break;
            case "GROUP_RATING":
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-amber-500 fill-amber-500"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z""/></svg>");
                break;
            default:
                builder.AddMarkupContent(0, @"<svg class=""w-2.5 h-2.5 text-[#557392]"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9""/></svg>");
                break;
        }
    };

    private string FormatTimeAgo(DateTime utcDate)
    {
        var span = DateTime.UtcNow - utcDate;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d");
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}
