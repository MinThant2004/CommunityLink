@rendermode InteractiveServer
@inject NotificationApiService NotificationApi
@inject NavigationManager Navigation
@implements IDisposable

<div class="relative inline-block text-left" @onclick:stopPropagation>
    <!-- Bell Button with Unread Badge -->
    <button type="button" @onclick="ToggleDropdown"
            class="relative p-2 rounded-xl text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition focus:outline-none cursor-pointer"
            title="Notifications">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>

        @if (unreadCount > 0)
        {
            <span class="absolute -top-1 -right-1 flex h-5 min-w-[1.25rem] px-1 items-center justify-center rounded-full bg-rose-600 text-[10px] font-extrabold text-white shadow-xs animate-pulse">
                @(unreadCount > 99 ? "99+" : unreadCount.ToString())
            </span>
        }
    </button>

    <!-- Dropdown Panel -->
    @if (isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="notification-dropdown-panel absolute right-0 mt-2 rounded-2xl bg-white shadow-2xl border border-slate-200/80 z-50 overflow-hidden animate-in fade-in zoom-in-95 duration-150"
             style="width: min(38rem, calc(100vw - 2rem));">
            <!-- Header -->
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div class="flex items-center gap-2">
                    <span class="text-base">🔔</span>
                    <h3 class="font-bold text-sm text-slate-800">Notifications</h3>
                    @if (unreadCount > 0)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
                            @unreadCount new
                        </span>
                    }
                </div>
                @if (unreadCount > 0)
                {
                    <button type="button" @onclick="MarkAllAsRead" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition cursor-pointer">
                        Mark all as read
                    </button>
                }
            </div>

            <!-- List Body -->
            <div class="max-h-[30rem] overflow-y-auto divide-y divide-slate-100">
                @if (isLoading && notifications.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400">
                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-indigo-600"></div>
                        <p class="text-xs mt-2">Loading notifications...</p>
                    </div>
                }
                else if (notifications.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400">
                        <span class="text-3xl block mb-2">🔕</span>
                        <p class="text-xs font-medium text-slate-600">No notifications yet</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">When you get likes, comments, votes or group updates, they will appear here.</p>
                    </div>
                }
                else
                {
                    @foreach (var notif in notifications)
                    {
                        <div @onclick="() => HandleNotificationClick(notif)"
                             class="p-3.5 flex items-start gap-3 transition cursor-pointer hover:bg-slate-50/80 @(!notif.IsRead ? "bg-indigo-50/40" : "")">
                            <!-- Icon / Avatar -->
                            <div class="relative shrink-0">
                                @if (!string.IsNullOrEmpty(notif.ActorAvatar))
                                {
                                    <img src="@notif.ActorAvatar" alt="@notif.ActorName" class="w-9 h-9 rounded-full object-cover border border-slate-200" />
                                }
                                else
                                {
                                    <div class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center">
                                        @(string.IsNullOrWhiteSpace(notif.ActorName) ? "U" : notif.ActorName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full flex items-center justify-center text-[10px] bg-white shadow-xs">
                                    @GetNotificationIcon(notif.NotificationType)
                                </span>
                            </div>

                            <!-- Text Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <h4 class="text-xs font-bold text-slate-900 truncate">@notif.Title</h4>
                                    <span class="text-[10px] text-slate-400 shrink-0">@FormatTimeAgo(notif.CreatedAt)</span>
                                </div>
                                <p class="text-xs text-slate-600 mt-0.5 leading-snug break-words">@notif.Message</p>
                            </div>

                            <!-- Unread Indicator Dot -->
                            @if (!notif.IsRead)
                            {
                                <span class="w-2 h-2 rounded-full bg-indigo-600 shrink-0 mt-2" title="Unread"></span>
                            }
                        </div>
                    }

                    <!-- See More Button -->
                    @if (hasMore)
                    {
                        <div class="p-3 bg-slate-50/60 text-center border-t border-slate-100">
                            <button type="button" @onclick="LoadMoreNotifications" disabled="@isLoadingMore"
                                    class="w-full py-1.5 px-3 text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50/50 rounded-lg transition disabled:opacity-50 flex items-center justify-center gap-1 cursor-pointer">
                                @if (isLoadingMore)
                                {
                                    <span class="animate-spin text-xs">⏳</span>
                                    <span>Loading...</span>
                                }
                                else
                                {
                                    <span>See more</span>
                                    <span>▼</span>
                                }
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen;
    private int unreadCount = 0;
    private int totalCount = 0;
    private List<NotificationDto> notifications = new();
    private bool isLoading;
    private bool isLoadingMore;
    private int currentSkip = 0;
    private const int PageSize = 10;
    private bool hasMore => notifications.Count < totalCount;
    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadCount();

        // Check for new notifications every 30 seconds
        pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadUnreadCount();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            currentSkip = 0;
            notifications.Clear();
            await FetchNotifications();
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            var res = await NotificationApi.GetUnreadCountAsync();
            if (res.IsSuccess)
            {
                unreadCount = res.Data;
            }
        }
        catch
        {
            // Silently handle
        }
    }

    private async Task FetchNotifications()
    {
        try
        {
            isLoading = true;
            var res = await NotificationApi.GetNotificationsAsync(skip: currentSkip, take: PageSize);
            if (res.IsSuccess && res.Data != null)
            {
                totalCount = res.Data.TotalCount;
                unreadCount = res.Data.UnreadCount;
                notifications = res.Data.Notifications.ToList();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMoreNotifications()
    {
        if (isLoadingMore || !hasMore) return;

        try
        {
            isLoadingMore = true;
            currentSkip += PageSize;
            var res = await NotificationApi.GetNotificationsAsync(skip: currentSkip, take: PageSize);
            if (res.IsSuccess && res.Data != null)
            {
                totalCount = res.Data.TotalCount;
                unreadCount = res.Data.UnreadCount;
                notifications.AddRange(res.Data.Notifications);
            }
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private async Task HandleNotificationClick(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            notif.IsRead = true;
            if (unreadCount > 0) unreadCount--;
            await NotificationApi.MarkAsReadAsync(notif.NotificationId);
        }

        isOpen = false;

        if (!string.IsNullOrWhiteSpace(notif.TargetUrl))
        {
            Navigation.NavigateTo(notif.TargetUrl);
        }
        else
        {
            Navigation.NavigateTo("/groups");
        }
    }

    private async Task MarkAllAsRead()
    {
        await NotificationApi.MarkAllAsReadAsync();
        foreach (var n in notifications)
        {
            n.IsRead = true;
        }
        unreadCount = 0;
    }

    private string GetNotificationIcon(string type) => type?.ToUpperInvariant() switch
    {
        "LIKE" => "❤️",
        "COMMENT" => "💬",
        "SHARE" => "🚀",
        "POLL_VOTE" => "🗳️",
        "POLL_END" => "⏰",
        "GROUP_UPDATE" => "👥",
        "GROUP_JOIN_REQUEST" => "🙋",
        "GROUP_JOIN_APPROVED" => "✅",
        _ => "🔔"
    };

    private string FormatTimeAgo(DateTime utcDate)
    {
        var span = DateTime.UtcNow - utcDate;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d");
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}
