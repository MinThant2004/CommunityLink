<div class="px-5 py-4 flex items-center gap-3 border-b border-slate-800">
    <a class="text-lg font-bold text-white tracking-tight flex items-center gap-2" href="">
        <span aria-hidden="true">🌐</span> Community<span class="text-indigo-400">Link</span>
    </a>
</div>

<div class="p-3 flex-1 overflow-y-auto">
    <nav class="flex flex-col gap-1">
        <AuthorizeView>
            <Authorized>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true">🏠</span> Home
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="communities">
                        <span aria-hidden="true">🏛️</span> Communities
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="groups">
                        <span aria-hidden="true">👥</span> Groups
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    @* Direct messages and chat groups share one surface at /chat. *@
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="chat">
                        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z" />
                        </svg>
                        Chat
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="dashboard">
                        <span aria-hidden="true">📊</span> Dashboard
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="profile">
                        <span aria-hidden="true">👤</span> Profile
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="linkdrops">
                        <span aria-hidden="true">💧</span> Link Drops
                    </NavLink>
                </div>
                <div class="px-1 py-0.5 mt-3 pt-3 border-t border-slate-800 space-y-1">
                    <div class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                        Creator Center
                    </div>
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="creator/earnings">
                        <span aria-hidden="true">💰</span> Earnings
                    </NavLink>
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="creator/payouts">
                        <span aria-hidden="true">💸</span> Payouts
                    </NavLink>
                </div>
                <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)" Context="adminContext">
                    <Authorized>
                        <div class="px-1 py-0.5 mt-4 pt-4 border-t border-slate-800 space-y-1">
                            <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-amber-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-amber-600 text-white hover:bg-amber-600" href="admin/dashboard">
                                <span aria-hidden="true">🛡️</span> Admin Portal
                            </NavLink>
                            <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-amber-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-amber-600 text-white hover:bg-amber-600" href="admin/linkdrops">
                                <span aria-hidden="true">💧</span> Link Drops Review
                            </NavLink>
                            <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-amber-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-amber-600 text-white hover:bg-amber-600" href="admin/payouts">
                                <span aria-hidden="true">💸</span> Creator Payouts Review
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </Authorized>
            <NotAuthorized>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="guest">
                        <span aria-hidden="true">🌐</span> Welcome
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="communities">
                        <span aria-hidden="true">🏛️</span> Communities
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="login">
                        <span aria-hidden="true">🔑</span> Login
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="register">
                        <span aria-hidden="true">📝</span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<!-- Sidebar Profile Card Footer -->
<AuthorizeView>
    <Authorized>
        <div class="p-3 border-t border-slate-800 bg-slate-950/40">
            <a href="profile" class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-800/80 transition group">
                <div class="w-9 h-9 rounded-lg bg-indigo-600 text-white font-bold text-sm flex items-center justify-center shrink-0 shadow-md">
                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold text-slate-200 truncate group-hover:text-indigo-400 transition flex items-center gap-1">
                        <span class="truncate">@(context.User.Identity?.Name ?? "Member")</span>
                        <span class="text-xs shrink-0" aria-hidden="true">⭐</span>
                    </div>
                    <div class="text-[11px] text-slate-400 truncate font-mono">
                        View Profile &rarr;
                    </div>
                </div>
            </a>
        </div>
    </Authorized>
</AuthorizeView>
