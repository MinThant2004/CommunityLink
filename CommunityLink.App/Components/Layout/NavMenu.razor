<!-- Sidebar Profile Card Footer -->
<AuthorizeView>
    <Authorized>
        <div class="p-3 border-t border-slate-800 bg-slate-950/40">
            <a href="profile" class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-800/80 transition group">
                <div class="w-9 h-9 rounded-lg bg-indigo-600 text-white font-bold text-sm flex items-center justify-center shrink-0 shadow-md">
                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold text-slate-200 truncate group-hover:text-indigo-400 transition flex items-center gap-1">
                        <span class="truncate">@(context.User.Identity?.Name ?? "Member")</span>
                        <span class="text-xs shrink-0">⭐</span>
                    </div>
                    <div class="text-[11px] text-slate-400 truncate font-mono">
                        View Profile &rarr;
                    </div>
                </div>
            </a>
        </div>
    </Authorized>
</AuthorizeView>