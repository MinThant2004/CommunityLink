                        <NavLink class="px-3.5 py-2 rounded text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#112A46] hover:text-[#0A1B2E] dark:hover:text-white transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#E1E8F0] dark:!text-[#0A1B2E] shadow-sm" href="login">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            <span>Login</span>
                        </NavLink>
                    </div>
                    <div class="px-1 py-0.5">
                        <NavLink class="px-3.5 py-2 rounded text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#112A46] hover:text-[#0A1B2E] dark:hover:text-white transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#E1E8F0] dark:!text-[#0A1B2E] shadow-sm" href="register">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            <span>Register</span>
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    <!-- Stationary Sidebar Profile Card Footer -->
    <div class="shrink-0 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] z-10 transition-colors duration-150">
        <AuthorizeView>
            <Authorized>
                <div class="p-3">
                    <a href="profile" class="flex items-center gap-3 p-2 rounded hover:bg-white dark:hover:bg-[#112A46] transition border border-transparent hover:border-[#E2E8F0] dark:hover:border-[rgba(196,210,225,0.15)] group no-underline">
                        <div class="w-8 h-8 rounded bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] font-bold text-xs flex items-center justify-center shrink-0 shadow-sm transition-colors duration-150" style="font-family:'Manrope',sans-serif">
                            @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0] truncate flex items-center gap-1.5">
                                <span class="truncate">@(context.User.Identity?.Name ?? "Member")</span>
                                <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)" Context="badgeCtx">
                                    <Authorized>
                                        <span class="w-3.5 h-3.5 flex items-center justify-center text-[#0A1B2E] dark:text-[#E1E8F0]" title="Administrator">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        </span>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="w-3.5 h-3.5 flex items-center justify-center text-amber-500" title="Verified Member">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                        </span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                            <div class="text-[10px] text-[#64748B] dark:text-[#7A8CA6] truncate font-mono">
                                View Node &rarr;
                            </div>
                        </div>
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

