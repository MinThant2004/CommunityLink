                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="communities">
                        <span>🏛️</span> Communities
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="groups">
                        <span>👥</span> Groups
                    </NavLink>
                </div>
                <div class="px-1 py-0.5">
                    <NavLink class="px-3.5 py-2.5 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition flex items-center gap-2.5" ActiveClass="bg-indigo-600 text-white hover:bg-indigo-600" href="chat-groups">
