@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using CommunityLink.App.Services
@implements IDisposable
@inject CultureService Culture
@inject IStringLocalizer<AppResources> Loc
@inject AuthenticationStateProvider AuthStateProvider
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.UserProfile
@inject UserProfileApiService UserProfileApi

<div class="h-full flex flex-col min-h-0 overflow-hidden select-none bg-white dark:bg-[#0A0D14] transition-colors duration-150">
    <!-- Stationary Sidebar Header -->
    <div class="px-5 py-4 flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] shrink-0 bg-white dark:bg-[#0A0D14] z-10 transition-colors duration-150">
        <a class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E2EC] tracking-tight flex items-center gap-2.5 no-underline" href="@brandUrl">
            <span class="w-8 h-8 rounded bg-[#0A1B2E] dark:bg-[#D4AF37] text-white dark:text-[#0A0D14] flex items-center justify-center font-bold text-sm shadow-sm transition-colors duration-150" style="font-family:'Plus Jakarta Sans',sans-serif">CL</span>
            <div class="leading-none">
                <span class="font-bold text-[#0A1B2E] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Community<span class="text-[#D4AF37]">Link</span></span>
                <span class="block font-mono text-[9px] uppercase tracking-wider text-[#64748B] dark:text-[#94A3B8] mt-0.5">SOVEREIGN NETWORK</span>
            </div>
        </a>

    </div>

    <!-- Independent Scrollable Navigation Area (Isolated Scrolling) -->
    <div class="p-3 flex-1 overflow-y-auto min-h-0 overscroll-contain custom-scrollbar">
        <nav class="flex flex-col gap-1">
            <AuthorizeView>
                <Authorized>
                    @{
                        var user = context.User;
                        var roleCode = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                                       ?? user.FindFirst("role")?.Value 
                                       ?? string.Empty;
                        bool isAdminActor = user.HasClaim("is_admin", "true") ||
                                           user.IsInRole("ADMIN") ||
                                           user.IsInRole("SYSTEM_ADMIN") ||
                                           user.IsInRole("SYSTEMADMIN") ||
                                           user.IsInRole("SUPERADMIN") ||
                                           string.Equals(roleCode, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                                           string.Equals(roleCode, "SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase) ||
                                           string.Equals(roleCode, "SYSTEMADMIN", StringComparison.OrdinalIgnoreCase) ||
                                           string.Equals(roleCode, "SUPERADMIN", StringComparison.OrdinalIgnoreCase) ||
                                           user.HasClaim("permission", PermissionCatalog.AdminUserView);
                    }

                    @if (isAdminActor)
                    {
                        <!-- Administration Navigation ONLY (Admin-Side) -->
                        <div class="px-1 py-1 space-y-1">
                            <div class="px-3 pb-2 flex items-center justify-between font-mono text-[10px] font-bold tracking-wider text-[#64748B] dark:text-[#94A3B8] uppercase">
                                <span>@Loc["Nav_Administration"]</span>
                                <span class="px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#182030] text-[#0A1B2E] dark:text-[#E1E2EC] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[9px]">ADMIN</span>
                            </div>

                            <NavLink class="px-3.5 py-2.5 rounded-lg text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] dark:!border dark:!border-[#D4AF37]/30 shadow-sm" href="admin/dashboard">
                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                                <span>@Loc["Nav_AdminDashboard"]</span>
                            </NavLink>
                            <NavLink class="px-3.5 py-2.5 rounded-lg text-xs font-semibold text-[#557392] dark:text-[#94A3B8] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] transition flex items-center gap-2.5" ActiveClass="!bg-[#0A1B2E] !text-white dark:!bg-[#182030] dark:!text-[#D4AF37] dark:!border dark:!border-[#D4AF37]/30 shadow-sm" href="communities">
                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                                <span>@Loc["Nav_Communities"]</span>
                            </NavLink>
                            <div>
