@code {
    [Parameter] public EventCallback OnClose { get; set; }
    private bool isReportOpen = true;
    private bool isContentModerationOpen = true;
    private string brandUrl = "";
    private string? navAvatarUrl;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            try
            {
                var profileRes = await UserProfileApi.GetOwnerProfileAsync();
                if (profileRes.IsSuccess && profileRes.Data != null)
                {
                    navAvatarUrl = profileRes.Data.AvatarUrl;
                }
            }
            catch
            {
                // Graceful fallback
            }
            var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                       ?? user.FindFirst("role")?.Value 
                       ?? string.Empty;
            bool isAdmin = user.HasClaim("is_admin", "true") ||
                           user.IsInRole("ADMIN") ||
                           user.IsInRole("SYSTEM_ADMIN") ||
                           user.IsInRole("SYSTEMADMIN") ||
                           user.IsInRole("SUPERADMIN") ||
                           string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(role, "SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase);
            brandUrl = isAdmin ? "admin/dashboard" : "";
        }
    }

    protected override void OnInitialized()
    {
        Culture.OnCultureChanged += HandleCultureChanged;
    }

    private void HandleCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Culture.OnCultureChanged -= HandleCultureChanged;
    }

    private void ToggleReportMenu()
    {
        isReportOpen = !isReportOpen;
    }

    private void ToggleContentModerationMenu()
    {
        isContentModerationOpen = !isContentModerationOpen;
    }
}
