                                        <span>@Loc["Nav_AdminContentModeration"]</span>
                                    </div>
                                    <svg class="w-3.5 h-3.5 transform transition-transform duration-200 @(isContentModerationOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>
                                @if (isContentModerationOpen)
                                {
