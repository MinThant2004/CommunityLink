                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    <!-- Stationary Sidebar Profile Card Footer -->
    <div class="shrink-0 bg-[#F8FAFC] dark:bg-[#0A0D14] border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] z-10 transition-colors duration-150">
        <AuthorizeView>
            <Authorized>
                <div class="p-3">
                    <a href="profile" class="flex items-center gap-3 p-2 rounded hover:bg-white dark:hover:bg-[#111622] transition border border-transparent hover:border-[#E2E8F0] dark:hover:border-[rgba(255,255,255,0.08)] group no-underline">
                        <div class="w-8 h-8 rounded bg-[#0A1B2E] dark:bg-[#D4AF37] text-white dark:text-[#0A0D14] font-bold text-xs flex items-center justify-center shrink-0 shadow-sm transition-colors duration-150" style="font-family:'Plus Jakarta Sans',sans-serif">
                            @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E2EC] truncate flex items-center gap-1.5">
                                <span class="truncate">@(context.User.Identity?.Name ?? "Member")</span>
                                <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)" Context="badgeCtx">
                                    <Authorized>
                                        <span class="w-3.5 h-3.5 flex items-center justify-center text-[#0A1B2E] dark:text-[#D4AF37]" title="Administrator">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                        </span>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="w-3.5 h-3.5 flex items-center justify-center text-[#D4AF37]" title="Verified Member">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                        </span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                            <div class="text-[10px] text-[#64748B] dark:text-[#94A3B8] truncate font-mono">
                                View Node &rarr;
                            </div>
                        </div>
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

