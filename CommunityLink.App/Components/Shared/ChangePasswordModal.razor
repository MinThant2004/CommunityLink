@using CommunityLink.Shared.Features.Authentication
@using CommunityLink.App.Apis
@using CommunityLink.App.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject AuthenticationApiService AuthApi

<div class="fixed inset-0 z-[120] flex items-center justify-center bg-[#0A1B2E]/60 dark:bg-black/80 backdrop-blur-sm p-4 animate-fade-in" @onclick="CloseOnBackdrop">
    <div class="w-full max-w-lg space-y-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#112A46] p-7 sm:p-8 shadow-2xl relative" @onclick:stopPropagation>

        <button type="button" @onclick="OnClose" aria-label="Close"
                class="absolute top-5 right-5 flex h-8 w-8 items-center justify-center rounded-lg text-[#64748B] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <!-- Header with Shield Lock Icon -->
        <div class="border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-4">
            <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                        Change Password
                    </h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">
                        Update your account password to keep your profile secure.
                    </p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="@AuthClasses.ErrorAlert">
                <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <span>@errorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="@AuthClasses.SuccessAlert">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>@successMessage</span>
            </div>
        }

        <div class="space-y-4">
            <!-- Current Password -->
            <div class="space-y-1.5">
                <label class="@AuthClasses.Label">Current Password</label>
                <div class="relative">
                    <input type="password" @bind="currentPassword" autocomplete="current-password"
                           placeholder="Enter your current password" class="@AuthClasses.Input pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer" aria-label="Toggle current password visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <!-- New Password -->
            <div class="space-y-1.5">
                <label class="@AuthClasses.Label">New Password</label>
                <div class="relative">
                    <input type="password" @bind="newPassword" autocomplete="new-password"
                           placeholder="Enter new password" class="@AuthClasses.Input pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer" aria-label="Toggle new password visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <!-- Confirm New Password -->
            <div class="space-y-1.5">
                <label class="@AuthClasses.Label">Confirm New Password</label>
                <div class="relative">
                    <input type="password" @bind="confirmNewPassword" autocomplete="new-password"
                           placeholder="Re-enter your new password" class="@AuthClasses.Input pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer" aria-label="Toggle confirm new password visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <!-- Password Policy Requirement Hint -->
            <p class="text-[11px] text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5 pt-0.5">
                <svg class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Use at least 8 characters with uppercase, lowercase, number &amp; symbol.</span>
            </p>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button type="button" disabled="@isSubmitting" @onclick="OnClose"
                        class="px-4 py-2 text-xs font-semibold rounded-lg border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" disabled="@isSubmitting" @onclick="HandleChangePasswordAsync"
                        class="flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 px-5 py-2 text-xs font-bold text-white shadow-sm disabled:opacity-60 transition cursor-pointer">
                    @if (isSubmitting)
                    {
                        <div class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></div>
                        <span>Updating Password...</span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmNewPassword = string.Empty;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    private async Task CloseOnBackdrop()
    {
        if (!isSubmitting)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            errorMessage = "Current password is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            errorMessage = "New password fields are required.";
            return;
        }

        if (currentPassword == newPassword)
        {
            errorMessage = "New password must be different from your current password.";
            return;
        }

        if (newPassword.Length < 8)
        {
            errorMessage = "Password must be at least 8 characters long.";
            return;
        }

        if (!newPassword.Any(char.IsUpper))
        {
            errorMessage = "Password must contain at least one uppercase letter (A-Z).";
            return;
        }

        if (!newPassword.Any(char.IsLower))
        {
            errorMessage = "Password must contain at least one lowercase letter (a-z).";
            return;
        }

        if (!newPassword.Any(char.IsDigit))
        {
            errorMessage = "Password must contain at least one number (0-9).";
            return;
        }

        if (!newPassword.Any(ch => !char.IsLetterOrDigit(ch)))
        {
            errorMessage = "Password must contain at least one special character (e.g. !@#$%^&*).";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.ChangePasswordAsync(new ChangePasswordRequestModel(currentPassword, newPassword));
        if (result.IsSuccess)
        {
            successMessage = "Your password has been changed successfully!";
            currentPassword = string.Empty;
            newPassword = string.Empty;
            confirmNewPassword = string.Empty;
            await Task.Delay(1400);
            await OnClose.InvokeAsync();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }
}
