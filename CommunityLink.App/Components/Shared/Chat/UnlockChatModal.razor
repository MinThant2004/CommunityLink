@using CommunityLink.App.Components.Shared.Chat
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<AppResources> Loc

@*
    One-time LinkDrop payment confirmation, shared by paid group joins and paid 1:1 unlocks.
*@

<ChatModal IsOpen="IsOpen" Title="@ModalTitle" MaxWidth="max-w-md" OnClose="OnClose">
    <ChildContent>
    <div class="space-y-4 px-4 py-4">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="rounded-lg border border-rose-200 dark:border-rose-900/40 bg-rose-50 dark:bg-rose-950/40 p-3" role="alert">
                <p class="text-sm font-medium text-rose-800 dark:text-rose-300">@errorMessage</p>
            </div>
        }

        <div class="flex items-center gap-3">
            <UserAvatar Url="@AvatarUrl"
                        Name="@SubjectName"
                        Size="h-11 w-11"
                        Class="shrink-0"
                        BgClass="bg-slate-100 dark:bg-[#1D263B]"
                        ColorClass="text-slate-600 dark:text-[#E1E2EC]"
                        TextClass="text-sm font-semibold" />
            <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-[#E1E2EC]">@SubjectName</p>
                <p class="text-xs text-slate-500 dark:text-[#94A3B8]">@SubjectSubtitle</p>
            </div>
        </div>

        <dl class="divide-y divide-slate-100 dark:divide-[rgba(255,255,255,0.08)] rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-slate-50/50 dark:bg-[#191B23]">
            <div class="flex items-center justify-between px-3 py-2.5">
                <dt class="text-sm text-slate-600 dark:text-[#94A3B8]">@Loc["Chat_TotalPrice"]</dt>
                <dd class="text-sm font-semibold font-mono text-slate-900 dark:text-[#E1E2EC] inline-flex items-center gap-1.5">
                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                    <span>@Loc["Chat_FeeDrops", FeeLinkDrops]</span>
                </dd>
            </div>
            <div class="flex items-center justify-between px-3 py-2.5">
                <dt class="text-sm text-slate-600 dark:text-[#94A3B8]">@Loc["Chat_YourBalance"]</dt>
                <dd class="text-sm font-semibold font-mono @(HasSufficientBalance ? "text-emerald-700 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400") inline-flex items-center gap-1.5">
                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                    <span>@Loc["Chat_FeeDrops", Balance]</span>
                </dd>
            </div>
        </dl>

        @if (!HasSufficientBalance)
        {
            <p class="text-xs leading-relaxed text-rose-700 dark:text-rose-300">
                @Loc["Chat_InsufficientDrops", Math.Max(0, FeeLinkDrops - Balance)]
            </p>
        }

        <p class="text-xs leading-relaxed text-slate-500 dark:text-[#94A3B8]">
            @Loc["Chat_PaymentDisclaimer", IsGroupUnlock ? Loc["Chat_GroupUnlockEffect"] : Loc["Chat_DirectUnlockEffect"]]
        </p>
    </div>
    </ChildContent>

    <FooterContent>
        <button type="button"
                @onclick="OnClose"
                class="rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#191B23] px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-[#E1E2EC] transition hover:bg-slate-50 dark:hover:bg-[#182030] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-slate-300">
            @Loc["Common_Cancel"]
        </button>
        <button type="button"
                @onclick="OnConfirm"
                disabled="@(IsSubmitting || !HasSufficientBalance)"
                class="rounded-lg bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#E1E8F0] dark:hover:bg-white dark:text-[#0A1B2E] px-4 py-2 text-xs font-semibold transition active:scale-[0.98] shadow-xs disabled:cursor-not-allowed disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:ring-offset-2">
            @if (IsSubmitting)
            {
                <span class="flex items-center gap-1.5">
                    <span class="h-3 w-3 animate-spin rounded-full border-b-2 border-current"></span>
                    @Loc["Common_Processing"]
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 font-mono">
                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                    <span>@Loc["Chat_PayDrops", FeeLinkDrops]</span>
                </span>
            }
        </button>
    </FooterContent>
</ChatModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsGroupUnlock { get; set; }
    [Parameter] public string SubjectName { get; set; } = string.Empty;
    [Parameter] public string? SubjectSubtitle { get; set; }
    [Parameter] public string? AvatarUrl { get; set; }
    [Parameter] public long FeeLinkDrops { get; set; }
    [Parameter] public long Balance { get; set; }
    [Parameter] public decimal CommissionPercentage { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? errorMessage { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string ModalTitle => IsGroupUnlock ? Loc["Chat_JoinPaidGroup"] : Loc["Chat_UnlockConversation"];

    private bool HasSufficientBalance => Balance >= FeeLinkDrops;

    private long CommissionAmount => (long)Math.Round(
        FeeLinkDrops * (CommissionPercentage / 100m),
        MidpointRounding.AwayFromZero);

    private long CreatorAmount => FeeLinkDrops - CommissionAmount;

    private string Initials => string.IsNullOrWhiteSpace(SubjectName) ? "?" : SubjectName.Trim()[..1].ToUpperInvariant();
}
