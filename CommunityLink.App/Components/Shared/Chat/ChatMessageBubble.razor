@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.Chat
@using Microsoft.Extensions.Localization
@inject IJSRuntime JS
@inject ToastService Toast
@inject IStringLocalizer<AppResources> Loc

@*
    Telegram-style Chat Message Bubble. Renders quoted replies, reaction badges,
    and interactive Telegram-style context popup with quick emoji bar, reply, copy,
    and dual delete actions (delete for me / delete for everyone).
*@

@if (Message.MessageType == "SYSTEM")
{
    <div class="my-2 flex justify-center w-full select-none">
        <div class="rounded-full bg-slate-200/90 dark:bg-[#1D263B] px-3.5 py-1 text-center text-xs font-medium text-slate-600 dark:text-[#E1E2EC] shadow-xs border border-slate-300/40 dark:border-[rgba(255,255,255,0.08)] max-w-[85%]">
            @Message.Content
        </div>
    </div>
}
else
{
<div class="flex flex-col @(Message.IsMine ? "items-end" : "items-start") group/message relative @(showMenu ? "z-30" : "")">
    @if (ShowHeader)
    {
        <div class="mb-1 flex items-center gap-1.5 px-1 @(Message.IsMine ? "flex-row-reverse" : "flex-row")">
            @if (!Message.IsMine)
            {
                <UserAvatar Url="@Message.SenderAvatar"
                            Name="@Message.SenderName"
                            Size="h-6 w-6" />
            }
            <a href="u/@(Message.SenderName)" class="text-xs font-medium text-slate-600 dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] hover:underline">
                @(Message.IsMine ? Loc["Chat_You"] : Message.SenderName)
            </a>
        </div>
    }

    <div class="group/bubble relative flex max-w-[85%] items-end gap-1 sm:max-w-[70%]">
        <!-- Message Bubble Body -->
        <div class="@(IsStickerMessage
                        ? "rounded-2xl p-1 bg-transparent shadow-none border-0"
                        : (Message.IsMine
                            ? "rounded-2xl rounded-br-md bg-[#0A1B2E] text-white dark:bg-[#182030] dark:text-[#E1E2EC] dark:border dark:border-[rgba(196,210,225,0.20)] px-3.5 py-2 text-sm leading-relaxed transition-shadow hover:shadow-sm"
                            : "rounded-2xl rounded-bl-md border border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111622] text-slate-800 dark:text-[#E1E2EC] px-3.5 py-2 text-sm leading-relaxed transition-shadow hover:shadow-sm"))">

            <!-- Quoted Reply Preview Strip -->
            @if (Message.ReplyToMessageId.HasValue)
            {
                <div @onclick="HandleQuotedReplyClick"
                     @onclick:stopPropagation="true"
                     class="mb-1.5 rounded-lg border-l-3 px-2.5 py-1 text-xs select-none cursor-pointer transition hover:opacity-90 active:scale-[0.99]
                             @(Message.IsMine ? "border-white/30 bg-[#112A46] text-white" : "border-[#0A1B2E] dark:border-[#E1E8F0] bg-slate-100 dark:bg-[#191B23] text-slate-700 dark:text-[#E1E2EC]")">
                    @if (Message.ReplyToIsDeleted)
                    {
                        <span class="italic text-slate-400 dark:text-[#94A3B8]">@Loc["Chat_OriginalMessageDeleted"]</span>
                    }
                    else
                    {
                        <div class="font-semibold @(Message.IsMine ? "text-white" : "text-[#0A1B2E] dark:text-[#E1E8F0]")">@Message.ReplyToSenderName</div>
                        <div class="truncate opacity-90">@FormatReplyPreview(Message.ReplyToPreview)</div>
                    }
                </div>
            }

            <!-- Media & File Attachments -->
            @if (!string.IsNullOrWhiteSpace(Message.AttachmentUrl))
            {
                <div class="my-1.5">
                    @if (Message.MessageType == "IMAGE")
                    {
                        <button type="button"
                                @onclick="OpenImageLightbox"
                                @onclick:stopPropagation="true"
                                class="block text-left cursor-zoom-in overflow-hidden rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30">
                            <img src="@Message.AttachmentUrl" alt="@(Message.FileName ?? "Attachment Image")" class="max-h-60 max-w-full rounded-lg object-cover shadow-sm transition hover:opacity-90 hover:scale-[1.01]" />
                        </button>

                        @if (showImageLightbox)
                        {
                            <div class="fixed inset-0 z-50 flex flex-col items-center justify-between bg-slate-950/90 p-4 backdrop-blur-md animate-in fade-in duration-150 select-none"
                                 @onclick="CloseImageLightbox"
                                 @onclick:stopPropagation="true">
                                <!-- Telegram-style Lightbox Top Control Bar -->
                                <div class="flex w-full max-w-5xl items-center justify-between px-2 py-2 text-white" @onclick:stopPropagation="true">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <span class="truncate text-sm font-semibold text-slate-100">@(Message.FileName ?? "Image")</span>
                                        @if (!string.IsNullOrWhiteSpace(Message.FormattedFileSize))
                                        {
                                            <span class="rounded bg-slate-800 px-2 py-0.5 text-xs text-slate-300 font-mono">@Message.FormattedFileSize</span>
                                        }
                                    </div>

                                    <div class="flex items-center gap-2.5">
                                        <a href="@Message.AttachmentUrl"
                                           download="@(Message.FileName ?? "image.png")"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="@Loc["Chat_DownloadImage"]"
                                           class="flex items-center gap-1.5 rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-700 focus:outline-none">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                            </svg>
                                            <span>@Loc["Chat_Download"]</span>
                                        </a>

                                        <button type="button"
                                                @onclick="CloseImageLightbox"
                                                title="@Loc["Chat_ClosePreview"]"
                                                class="rounded-lg bg-slate-800 p-1.5 text-slate-300 transition hover:bg-slate-700 hover:text-white focus:outline-none">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Main Centered Image View -->
                                <div class="flex min-h-0 flex-1 items-center justify-center py-4" @onclick="CloseImageLightbox">
                                    <img src="@Message.AttachmentUrl"
                                         alt="@(Message.FileName ?? "Full image preview")"
                                         class="max-h-[85vh] max-w-[90vw] rounded-xl object-contain shadow-2xl transition-transform"
                                         @onclick:stopPropagation="true" />
                                </div>

                                <!-- Footer Info -->
                                <div class="pb-2 text-xs text-slate-400 font-mono">
                                    <span>@((MarkupString)string.Format(System.Net.WebUtility.HtmlEncode(Loc["Chat_SentByAt"]), $"<strong class=\"text-slate-200\">{System.Net.WebUtility.HtmlEncode(Message.SenderName)}</strong>", System.Net.WebUtility.HtmlEncode(Message.SentTime)))</span>
                                </div>
                            </div>
                        }
                    }
                    else if (Message.MessageType == "VIDEO")
                    {
                        <div class="my-1 flex flex-col gap-1">
                            <video controls preload="metadata" class="max-h-64 max-w-full rounded-lg shadow-sm">
                                <source src="@Message.AttachmentUrl" />
                                @Loc["Chat_VideoNotSupported"]
                            </video>
                            <a href="@Message.AttachmentUrl" download="@(Message.FileName ?? "video.mp4")" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-1.5 text-[11px] font-medium opacity-90 hover:underline">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                                <span>@Loc["Chat_DownloadVideo", Message.FormattedFileSize ?? "file"]</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="@Message.AttachmentUrl" download="@Message.FileName" target="_blank" rel="noopener noreferrer"
                           class="flex items-center gap-2.5 rounded-lg border p-2.5 text-xs transition @(Message.IsMine ? "border-white/20 bg-[#112A46] text-white hover:bg-[#1B3B5A]" : "border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-slate-50 dark:bg-[#191B23] text-slate-800 dark:text-[#E1E2EC] hover:bg-slate-100 dark:hover:bg-[#182030]")">
                            <span class="rounded-md @(Message.IsMine ? "bg-white/10" : "bg-[#0A1B2E]/10 dark:bg-[#E1E8F0]/10") p-1.5">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                </svg>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-semibold">@(Message.FileName ?? "Attachment File")</p>
                                @if (!string.IsNullOrWhiteSpace(Message.FormattedFileSize))
                                {
                                    <p class="text-[10px] opacity-75 font-mono">@Message.FormattedFileSize</p>
                                }
                            </div>
                        </a>
                    }
                </div>
            }

            <!-- Main Message Text or Sticker -->
            @if (TryGetStickerUrl(Message.Content, out var stickerUrl))
            {
                <div class="my-1 flex items-center justify-center p-0.5">
                    <img src="@stickerUrl"
                         alt="Sticker"
                         class="h-28 w-28 sm:h-32 sm:w-32 object-contain drop-shadow-md select-none transition-transform hover:scale-105 active:scale-95"
                         loading="lazy" />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Message.Content))
            {
                <div class="whitespace-pre-wrap break-words">@Message.Content</div>
            }

            <!-- Reaction Badges Bar -->
            @if (GroupedReactions.Any())
            {
                <div class="mt-1.5 flex flex-wrap gap-1">
                    @foreach (var r in GroupedReactions)
                    {
                        <button type="button"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleReaction(r.Emoji)"
                                title="@r.UserList"
                                class="flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium transition
                                       @(r.HasUserReacted
                                           ? (Message.IsMine ? "bg-white/20 text-white" : "bg-[#0A1B2E]/10 dark:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.30)]")
                                           : (Message.IsMine ? "bg-black/10 text-slate-200 hover:bg-black/20" : "bg-slate-100 dark:bg-[#1D263B] text-slate-600 dark:text-[#94A3B8] hover:bg-slate-200 dark:hover:bg-[#182030]"))">
                            <span>@r.Emoji</span>
                            <span class="font-mono">@r.Count</span>
                        </button>
                    }
                </div>
            }

            <!-- Time and Read Status -->
            <div class="mt-0.5 flex items-center justify-end gap-1 select-none text-right font-mono
                        @(IsStickerMessage
                            ? "rounded-full bg-slate-900/60 dark:bg-black/60 px-2 py-0.5 text-[10px] text-white shadow-xs backdrop-blur-xs self-end ml-auto"
                            : "text-xs " + (Message.IsMine ? "text-slate-200 dark:text-slate-300" : "text-slate-400 dark:text-[#94A3B8]"))">
                @if (Message.IsPinned)
                {
                    <span class="inline-flex items-center gap-0.5" title="@Loc["Chat_PinnedMessage"]">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M16 3l5 5-4 1-2.5 2.5L15 15l-2 2-4-4-4.5 4.5L4 17l4.5-4.5-4-4 2-2 3.5.5L12.5 4.5 13 3z" />
                        </svg>
                        <span>@Loc["Chat_Pinned"]</span>
                    </span>
                }
                <span>@Message.SentTime</span>
                @if (Message.IsMine && Message.ThreadType == ChatThreadType.Private)
                {
                    <span title="@(Message.IsRead ? Loc["Chat_Read"] : Loc["Chat_Delivered"])">
                        @(Message.IsRead ? "✓✓" : "✓")
                    </span>
                }
            </div>
        </div>

        <!-- Quick Action Dots Trigger (More Options) -->
        @if (ShowActions)
        {
            <div class="flex items-center rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#191B23] p-0.5 shadow-sm transition
                        @(showMenu ? "opacity-100 visible" : "opacity-0 invisible group-hover/bubble:visible group-hover/bubble:opacity-100")">
                <button type="button"
                        @ref="menuTriggerRef"
                        @onclick="ToggleContextMenu"
                        @onclick:stopPropagation="true"
                        title="@Loc["Chat_MoreOptions"]"
                        aria-label="@Loc["Chat_MoreOptions"]"
                        class="rounded p-1 text-slate-500 dark:text-[#94A3B8] hover:bg-slate-100 dark:hover:bg-[#182030] hover:text-slate-800 dark:hover:text-[#E1E2EC] focus:outline-none">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                    </svg>
                </button>
            </div>
        }

        <!-- Telegram-Style Context Menu Box -->
        @if (showMenu)
        {
            <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>
            <div class="absolute z-50 min-w-[220px] max-w-[280px] rounded-xl border border-slate-200 dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] p-2 shadow-xl animate-in fade-in zoom-in-95 duration-100 max-h-[calc(100vh-100px)] overflow-y-auto
                        @(placeAbove ? "bottom-full mb-2 origin-bottom" : "top-full mt-2 origin-top")
                        @(Message.IsMine ? "right-0" : "left-0")">
                
                <!-- Quick Reaction Strip -->
                <div class="mb-2 flex items-center justify-between rounded-lg bg-slate-50 dark:bg-[#191B23] px-2 py-1.5 border border-slate-100 dark:border-[rgba(255,255,255,0.08)]">
                    @foreach (var emoji in TelegramEmojis)
                    {
                        <button type="button"
                                @onclick="() => SelectEmojiAndClose(emoji)"
                                class="transform rounded-md p-1 text-lg transition hover:scale-125 hover:bg-white dark:hover:bg-[#1D263B] focus:outline-none">
                            @emoji
                        </button>
                    }
                </div>

                <!-- Action Items List -->
                <div class="space-y-0.5 text-xs font-medium text-slate-700 dark:text-[#E1E2EC]">
                    <!-- Reply -->
                    <button type="button"
                            @onclick="ReplyClicked"
                            class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 transition hover:bg-slate-100 dark:hover:bg-[#1D263B] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0]">
                        <svg class="h-4 w-4 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                        </svg>
                        <span>@Loc["Chat_Reply"]</span>
                    </button>

                    <!-- Copy -->
                    <button type="button"
                            @onclick="CopyText"
                            class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 transition hover:bg-slate-100 dark:hover:bg-[#1D263B] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0]">
                        <svg class="h-4 w-4 text-slate-500 dark:text-[#94A3B8]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m0 0h1.5a5.25 5.25 0 0 1 5.25 5.25v1.5" />
                        </svg>
                        <span>@Loc["Chat_CopyMessage"]</span>
                    </button>

                    <!-- Pin / Unpin -->
                    @if (CanTogglePin)
                    {
                        <button type="button"
                                @onclick="TogglePinClicked"
                                class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 transition hover:bg-slate-100 dark:hover:bg-[#1D263B] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0]">
                            <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            <span>@(Message.IsPinned ? Loc["Chat_UnpinMessageAction"] : Loc["Chat_PinMessageAction"])</span>
                        </button>
                    }

                    <div class="my-1 border-t border-slate-100 dark:border-[rgba(255,255,255,0.08)]"></div>

                    <!-- Delete for Me -->
                    @if (Message.CanDeleteForSelf)
                    {
                        <button type="button"
                                @onclick="DeleteForSelfClicked"
                                class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 transition hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400">
                            <svg class="h-4 w-4 text-rose-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            <span>@Loc["Chat_DeleteForMe"]</span>
                        </button>
                    }

                    <!-- Delete for Everyone -->
                    @if (Message.CanDeleteForEveryone || Message.IsMine || Message.CanDelete)
                    {
                        <button type="button"
                                @onclick="DeleteForEveryoneClicked"
                                class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 font-semibold text-rose-600 dark:text-rose-400 transition hover:bg-rose-100 dark:hover:bg-rose-950/60">
                            <svg class="h-4 w-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                            </svg>
                            <span>@Loc["Chat_DeleteForEveryone"]</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>
}

@code {
    [Parameter, EditorRequired] public ChatMessageViewModel Message { get; set; } = default!;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public EventCallback<ChatMessageViewModel> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnDeleteForSelf { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnDeleteForEveryone { get; set; }
    [Parameter] public EventCallback<(ChatMessageViewModel Message, string Emoji)> OnToggleReaction { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnPin { get; set; }
    [Parameter] public EventCallback OnUnpin { get; set; }
    [Parameter] public EventCallback<int> OnSelectReplyMessage { get; set; }

    private async Task HandleQuotedReplyClick()
    {
        if (Message.ReplyToMessageId.HasValue && !Message.ReplyToIsDeleted)
        {
            await OnSelectReplyMessage.InvokeAsync(Message.ReplyToMessageId.Value);
        }
    }

    /// <summary>
    /// The pin menu entry is offered when the viewer could either pin this message or clear the
    /// existing pin. An already-pinned message is unpinned; anything else is pinned.
    /// </summary>
    private bool CanTogglePin => Message.IsPinned ? Message.CanUnpin : Message.CanPin;

    private ElementReference menuTriggerRef;
    private bool placeAbove;
    private bool showMenu;
    private bool showImageLightbox;

    private void OpenImageLightbox() => showImageLightbox = true;
    private void CloseImageLightbox() => showImageLightbox = false;

    private static readonly string[] TelegramEmojis = ["👍", "❤️", "🔥", "😂", "😮", "😢", "🙏", "👏"];

    private string Initial => string.IsNullOrWhiteSpace(Message.SenderName)
        ? "?"
        : Message.SenderName.Trim()[..1].ToUpperInvariant();

    private IEnumerable<GroupedReaction> GroupedReactions
    {
        get
        {
            if (Message.Reactions == null || Message.Reactions.Count == 0)
            {
                return Enumerable.Empty<GroupedReaction>();
            }

            return Message.Reactions
                .GroupBy(r => r.Emoji)
                .Select(g => new GroupedReaction(
                    g.Key,
                    g.Count(),
                    g.Any(x => x.UserName == Message.SenderName || x.UserId == Message.SenderId),
                    string.Join(", ", g.Select(x => x.UserName))
                ));
        }
    }

    private async Task ToggleContextMenu()
    {
        if (!showMenu)
        {
            try
            {
                var placement = await JS.InvokeAsync<string>("communityLinkChat.getPopupPlacement", menuTriggerRef);
                placeAbove = string.Equals(placement, "above", StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                placeAbove = false;
            }
            showMenu = true;
        }
        else
        {
            showMenu = false;
        }
    }

    private void CloseMenu() => showMenu = false;

    private async Task SelectEmojiAndClose(string emoji)
    {
        showMenu = false;
        await ToggleReaction(emoji);
    }

    private async Task ToggleReaction(string emoji)
    {
        await OnToggleReaction.InvokeAsync((Message, emoji));
    }

    private async Task ReplyClicked()
    {
        showMenu = false;
        await OnReply.InvokeAsync(Message);
    }

    private async Task CopyText()
    {
        showMenu = false;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Content);
            Toast.Success(Loc["Chat_MessageCopied"]);
        }
        catch
        {
            Toast.Error(Loc["Chat_CouldNotCopyMessage"]);
        }
    }

    private async Task DeleteForSelfClicked()
    {
        showMenu = false;
        await OnDeleteForSelf.InvokeAsync(Message);
    }

    private async Task DeleteForEveryoneClicked()
    {
        showMenu = false;
        await OnDeleteForEveryone.InvokeAsync(Message);
    }

    private async Task TogglePinClicked()
    {
        showMenu = false;
        if (Message.IsPinned)
        {
            await OnUnpin.InvokeAsync();
        }
        else
        {
            await OnPin.InvokeAsync(Message);
        }
    }

    private bool IsStickerMessage => TryGetStickerUrl(Message.Content, out _);

    private static bool TryGetStickerUrl(string? content, out string stickerUrl)
    {
        stickerUrl = string.Empty;
        if (string.IsNullOrWhiteSpace(content))
        {
            return false;
        }

        var trimmed = content.Trim();
        if (trimmed.StartsWith("[sticker:", StringComparison.OrdinalIgnoreCase) && trimmed.EndsWith("]"))
        {
            var raw = trimmed.Substring(9, trimmed.Length - 10).Trim();
            if (!string.IsNullOrWhiteSpace(raw))
            {
                if (!raw.StartsWith("/") && !raw.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !raw.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                {
                    raw = "/" + raw;
                }
                stickerUrl = raw;
                return true;
            }
        }

        return false;
    }

    private string FormatReplyPreview(string? preview)
    {
        if (string.IsNullOrWhiteSpace(preview))
        {
            return string.Empty;
        }

        if (TryGetStickerUrl(preview, out _))
        {
            return "🎨 " + Loc["Chat_Stickers"];
        }

        return preview;
    }

    private record GroupedReaction(string Emoji, int Count, bool HasUserReacted, string UserList);
}
