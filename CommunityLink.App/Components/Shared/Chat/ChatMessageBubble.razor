@using CommunityLink.App.Components.Shared.Chat
@inject IJSRuntime JS
@inject ToastService Toast

@*
    Bubble for both 1:1 and group messages. Flat: no shadows, a single indigo accent for
    the viewer's own messages, and a hairline border for everyone else's.
*@

<div class="flex flex-col @(Message.IsMine ? "items-end" : "items-start")">
    @if (ShowHeader)
    {
        <div class="mb-1 flex items-center gap-1.5 px-1 @(Message.IsMine ? "flex-row-reverse" : "flex-row")">
            @if (!Message.IsMine)
            {
                @if (!string.IsNullOrWhiteSpace(Message.SenderAvatar))
                {
                    <img src="@Message.SenderAvatar" alt="" class="h-6 w-6 rounded-full object-cover" />
                }
                else
                {
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">@Initial</span>
                }
            }
            <span class="text-xs font-medium text-slate-600">@(Message.IsMine ? "You" : Message.SenderName)</span>
        </div>
    }

    <div class="group/bubble relative flex max-w-[85%] items-end gap-1 sm:max-w-[70%]">
        <div class="rounded-2xl px-3.5 py-2 text-sm leading-relaxed
                    @(Message.IsMine
                        ? "rounded-br-md bg-indigo-600 text-white"
                        : "rounded-bl-md border border-slate-200 bg-white text-slate-800")">
            <div class="whitespace-pre-wrap break-words">@Message.Content</div>
            <div class="mt-0.5 select-none text-right text-xs @(Message.IsMine ? "text-indigo-100" : "text-slate-400")">
                @Message.SentTime
                @if (Message.IsMine && Message.ThreadType == ChatThreadType.Private)
                {
                    <span class="ml-1" title="@(Message.IsRead ? "Read" : "Delivered")">
                        @(Message.IsRead
                            ? "✓✓"
                            : "✓")
                    </span>
                }
            </div>
        </div>

        @if (ShowActions)
        {
            <div class="invisible flex items-center gap-0.5 rounded-lg border border-slate-200 bg-white p-0.5 opacity-0 transition group-hover/bubble:visible group-hover/bubble:opacity-100 focus-within:visible focus-within:opacity-100">
                <button type="button"
                        @onclick="CopyText"
                        title="Copy message"
                        aria-label="Copy message"
                        class="rounded p-1 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m0 0h1.5a5.25 5.25 0 0 1 5.25 5.25v1.5" />
                    </svg>
                </button>

                @if (Message.CanDelete)
                {
                    <button type="button"
                            @onclick="OnDeleteClicked"
                            title="Delete message"
                            aria-label="Delete message"
                            class="rounded p-1 text-slate-500 transition hover:bg-rose-50 hover:text-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-400">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChatMessageViewModel Message { get; set; } = default!;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private string Initial => string.IsNullOrWhiteSpace(Message.SenderName)
        ? "?"
        : Message.SenderName.Trim()[..1].ToUpperInvariant();

    private async Task CopyText()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Content);
            Toast.Success("Message copied.");
        }
        catch
        {
            Toast.Error("Could not copy to clipboard.");
        }
    }

    private async Task OnDeleteClicked() => await OnDelete.InvokeAsync(Message.Id);
}
