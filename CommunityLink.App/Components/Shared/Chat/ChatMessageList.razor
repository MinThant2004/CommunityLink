@using CommunityLink.App.Components.Shared.Chat
@inject IJSRuntime JS

@*
    Scrollable message stream. Renders 1:1 and group messages identically because both
    arrive as ChatMessageViewModel, with date separators and sender grouping.
*@

<div @ref="_scrollContainer"
     class="min-h-0 flex-1 overflow-y-auto bg-slate-50 px-3 py-4 sm:px-5"
     role="log"
     aria-live="polite"
     aria-relevant="additions">
    <div class="mx-auto w-full max-w-3xl space-y-1">
        @if (IsLoading)
        {
            <div class="space-y-3 py-2" aria-busy="true">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="flex @(i % 2 == 0 ? "justify-start" : "justify-end")">
                        <div class="skeleton h-10 w-2/5 rounded-2xl"></div>
                    </div>
                }
            </div>
        }
        else if (HasError)
        {
            <div class="mx-auto max-w-sm rounded-lg border border-rose-200 bg-white p-6 text-center">
                <svg class="mx-auto h-7 w-7 text-rose-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                </svg>
                <p class="mt-2 text-sm font-medium text-rose-700">Couldn't load messages</p>
                <button type="button"
                        @onclick="OnRetry"
                        class="mt-3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    Try again
                </button>
            </div>
        }
        else if (Messages.Count == 0)
        {
            <div class="mx-auto max-w-sm rounded-lg border border-slate-200 bg-white p-8 text-center">
                <svg class="mx-auto h-8 w-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z" />
                </svg>
                <p class="mt-3 text-sm font-semibold text-slate-800">No messages yet</p>
                <p class="mt-1 text-xs text-slate-500">Say hello to get the conversation started.</p>
            </div>
        }
        else
        {
            DateOnly? lastDate = null;
            var lastSenderId = 0;

            @for (var i = 0; i < Messages.Count; i++)
            {
                var message = Messages[i];
                var messageDate = DateOnly.FromDateTime(message.SentAtLocal);
                var showDateSeparator = lastDate != messageDate;
                var showHeader = showDateSeparator || lastSenderId != message.SenderId;

                if (showDateSeparator)
                {
                    <div class="flex justify-center py-3" role="separator">
                        <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600">
                            @ChatThreadMapper.FormatDateSeparator(message.SentAtLocal)
                        </span>
                    </div>
                }

                <div id="@($"msg-{message.Id}")" class="py-0.5 transition-all">
                    <ChatMessageBubble Message="message"
                                       ShowHeader="showHeader"
                                       OnReply="OnReply"
                                       OnSelectReplyMessage="ScrollToAndHighlightMessageAsync"
                                       OnDeleteForSelf="OnDeleteForSelf"
                                       OnDeleteForEveryone="OnDeleteForEveryone"
                                       OnToggleReaction="OnToggleReaction"
                                       OnPin="OnPin"
                                       OnUnpin="OnUnpin" />
                </div>

                lastDate = messageDate;
                lastSenderId = message.SenderId;
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatMessageViewModel> Messages { get; set; } = Array.Empty<ChatMessageViewModel>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnDeleteForSelf { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnDeleteForEveryone { get; set; }
    [Parameter] public EventCallback<(ChatMessageViewModel Message, string Emoji)> OnToggleReaction { get; set; }
    [Parameter] public EventCallback<ChatMessageViewModel> OnPin { get; set; }
    [Parameter] public EventCallback OnUnpin { get; set; }

    public async Task ScrollToAndHighlightMessageAsync(int messageId)
    {
        try
        {
            await JS.InvokeVoidAsync("communityLinkChat.scrollToAndHighlightMessage", messageId);
        }
        catch
        {
            // Cosmetic animation; ignore JS interop failure
        }
    }

    private ElementReference _scrollContainer;
    private int? _lastMessageId;
    private int _lastCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var newest = Messages.Count > 0 ? Messages[^1].Id : (int?)null;
        if (newest == _lastMessageId && Messages.Count == _lastCount)
        {
            return;
        }

        _lastMessageId = newest;
        _lastCount = Messages.Count;

        try
        {
            await JS.InvokeVoidAsync("communityLinkChat.scrollToBottom", _scrollContainer);
        }
        catch
        {
            // Scrolling is cosmetic; ignore JS interop failures.
        }
    }
}
