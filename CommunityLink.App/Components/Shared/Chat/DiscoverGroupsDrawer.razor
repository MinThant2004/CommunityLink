@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.ChatGroup

@*
    Folds the standalone /chat-groups-directory browse grid into Chat as a right-side
    drawer, so every chat surface lives under one nav item.
*@

<div class="fixed inset-0 z-50 flex justify-end" @onkeydown="HandleKeyDown" role="presentation">
    <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" @onclick="OnClose"></div>

    <aside class="relative flex h-full w-full max-w-md flex-col border-l border-slate-200 dark:border-[rgba(196,210,225,0.12)] bg-white dark:bg-[#112A46]"
           role="dialog"
           aria-modal="true"
           aria-label="Discover chat groups"
           tabindex="-1"
           @ref="_panel"
           @onkeydown="HandleKeyDown"
           @onkeydown:stopPropagation="true">
        <div class="flex shrink-0 items-center justify-between gap-2 border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)] px-4 py-3">
            <div>
                <h2 class="text-sm font-semibold text-slate-900 dark:text-[#E1E8F0]">Discover groups</h2>
                <p class="text-xs text-slate-500 dark:text-[#C4D2E1]">Browse public chat groups and communities</p>
            </div>
            <button type="button"
                    @onclick="OnClose"
                    aria-label="Close discover groups"
                    class="rounded-lg p-1.5 text-slate-500 dark:text-[#C4D2E1] transition hover:bg-slate-100 dark:hover:bg-[#1B3B5A] hover:text-slate-900 dark:hover:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="shrink-0 border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)] p-3">
            <div class="relative">
                <label for="discover-group-search" class="sr-only">Search groups</label>
                <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 dark:text-[#C4D2E1]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607Z" />
                </svg>
                <input id="discover-group-search"
                       type="search"
                       @bind="searchText"
                       @bind:event="oninput"
                       @bind:after="NotifySearchChanged"
                       placeholder="Search groups"
                       class="w-full rounded-lg border border-slate-200 dark:border-[rgba(196,210,225,0.12)] bg-slate-50 dark:bg-[#0A1B2E] py-2 pl-9 pr-3 text-sm text-slate-900 dark:text-[#E1E8F0] placeholder-slate-400 dark:placeholder-slate-500 transition focus:border-indigo-600 focus:bg-white dark:focus:bg-[#0A1B2E] focus:outline-none focus:ring-1 focus:ring-indigo-600" />
            </div>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto p-3">
            @if (IsLoading)
            {
                <div class="space-y-2" aria-busy="true">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="rounded-lg border border-slate-200 dark:border-[rgba(196,210,225,0.12)] p-3">
                            <div class="skeleton h-4 w-2/5"></div>
                            <div class="skeleton mt-2 h-3 w-4/5"></div>
                        </div>
                    }
                </div>
            }
            else if (FilteredGroups.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <svg class="mx-auto h-8 w-8 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.94-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.06 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                    </svg>
                    <p class="mt-3 text-sm font-semibold text-slate-700 dark:text-[#E1E8F0]">No groups found</p>
                    <p class="mt-1 text-xs text-slate-500 dark:text-[#C4D2E1]">Try a different search term.</p>
                </div>
            }
            else
            {
                <ul class="space-y-2" role="list">
                    @foreach (var group in FilteredGroups)
                    {
                        var isPaid = string.Equals(group.ChatType, "PAID", StringComparison.OrdinalIgnoreCase);
                        <li>
                            <button type="button"
                                    @onclick="() => OnSelect.InvokeAsync(group)"
                                    class="w-full rounded-lg border border-slate-200 dark:border-[rgba(196,210,225,0.12)] bg-white dark:bg-[#0A1B2E] p-3 text-left transition hover:border-indigo-200 dark:hover:border-indigo-800/50 hover:bg-slate-50 dark:hover:bg-[#1B3B5A] focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                                <div class="flex items-start gap-3">
                                    @if (!string.IsNullOrWhiteSpace(group.AvatarUrl))
                                    {
                                        <img src="@group.AvatarUrl" alt="" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-[#1B3B5A] text-sm font-semibold text-slate-600 dark:text-[#E1E8F0]">@Initial(group.Name)</span>
                                    }
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="truncate text-sm font-semibold text-slate-900 dark:text-[#E1E8F0]">@group.Name</span>
                                            @if (isPaid)
                                            {
                                                <span class="shrink-0 inline-flex items-center gap-1 rounded border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 text-xs font-semibold text-amber-700 dark:text-amber-300">
                                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                                    <span>@group.JoinFeeLinkDrops drops</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="shrink-0 rounded border border-emerald-200 dark:border-emerald-800/40 bg-emerald-50 dark:bg-emerald-950/40 px-1.5 py-0.5 text-xs font-semibold text-emerald-700 dark:text-emerald-300">Free</span>
                                            }
                                        </div>
                                        <p class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-slate-500 dark:text-[#C4D2E1]">
                                            @(string.IsNullOrWhiteSpace(group.Description) ? "No description provided." : group.Description)
                                        </p>
                                        <div class="mt-1.5 flex items-center gap-2 text-xs text-slate-400 dark:text-[#C4D2E1]/70">
                                            <span>@group.MemberCount @(group.MemberCount == 1 ? "member" : "members")</span>
                                            <span aria-hidden="true">·</span>
                                            <span class="truncate">@group.CreatorName</span>
                                            @if (group.IsJoined)
                                            {
                                                <span class="ml-auto shrink-0 font-medium text-emerald-600 dark:text-emerald-400">Joined</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (IsPremiumCreator)
        {
            <div class="shrink-0 border-t border-slate-200 dark:border-[rgba(196,210,225,0.12)] bg-slate-50 dark:bg-[#112A46] px-3 py-3">
                <button type="button"
                        @onclick="OnCreateGroup"
                        class="w-full rounded-lg bg-indigo-600 px-3.5 py-2.5 text-xs font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Create a chat group
                </button>
            </div>
        }
    </aside>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatGroupModel> Groups { get; set; } = Array.Empty<ChatGroupModel>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsPremiumCreator { get; set; }
    [Parameter] public string? searchText { get; set; }

    [Parameter] public EventCallback<ChatGroupModel> OnSelect { get; set; }
    [Parameter] public EventCallback OnCreateGroup { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _panel;

    private IReadOnlyList<ChatGroupModel> FilteredGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return Groups;
            }

            var term = searchText.Trim();
            return Groups
                .Where(g =>
                    g.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (g.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    g.CreatorName.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _panel.FocusAsync();
            }
            catch
            {
                // Ignore: the drawer is non-interactive until it is opened.
            }
        }
    }

    private Task NotifySearchChanged() =>
        SearchChanged.InvokeAsync(searchText);

    [Parameter] public EventCallback<string?> SearchChanged { get; set; }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
