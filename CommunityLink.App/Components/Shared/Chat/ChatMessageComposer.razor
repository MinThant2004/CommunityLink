@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Chat
@using CommunityLink.Shared.Utils
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization

@inject ChatApiService ChatApi
@inject IStringLocalizer<AppResources> Loc

@*
    Message composer. Model-agnostic: it emits text, optional replyToId, and attachment details (IMAGE, FILE, VIDEO),
    so the unified page routes the result to the 1:1 or group endpoint depending on active thread.

    Attachments are uploaded to /api/chat/attachments first and the resulting short URL travels with the
    message. The file bytes are never inlined into the message payload.
*@

<div class="shrink-0 border-t border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111622] px-3 py-3 sm:px-4">
    @if (ReplyToMessage is not null)
    {
        <div class="mx-auto mb-2.5 flex max-w-3xl items-center justify-between rounded-xl border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.30)] bg-[#0A1B2E]/5 dark:bg-[#182030] px-3.5 py-2 text-xs">
            <div class="min-w-0 flex-1 border-l-2 border-[#0A1B2E] dark:border-[#E1E8F0] pl-2.5">
                <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Chat_ReplyingTo", ReplyToMessage.SenderName]</span>
                <p class="truncate text-slate-600 dark:text-[#94A3B8]">@FormatReplyPreview(ReplyToMessage.Content)</p>
            </div>
            <button type="button"
                    @onclick="CancelReply"
                    title="@Loc["Chat_CancelReply"]"
                    aria-label="@Loc["Chat_CancelReply"]"
                    class="ml-2 rounded-md p-1 text-slate-400 dark:text-[#94A3B8] transition hover:bg-[#0A1B2E]/10 dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-white">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    @if (attachmentError is not null)
    {
        <p class="mx-auto mb-2.5 max-w-3xl text-xs font-medium text-red-600 dark:text-red-400">@attachmentError</p>
    }
    else if (attachedFile is not null)
    {
        <div class="mx-auto mb-2.5 flex max-w-3xl items-center justify-between rounded-xl border border-emerald-200 dark:border-emerald-800/40 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-2 text-xs">
            <div class="flex min-w-0 items-center gap-2">
                <span class="rounded bg-emerald-600 px-1.5 py-0.5 font-bold uppercase text-white font-mono">@attachmentType</span>
                <span class="truncate font-medium text-slate-800 dark:text-[#E1E2EC]">@attachedFileName</span>
                <span class="shrink-0 text-slate-500 dark:text-[#94A3B8] font-mono">(@formattedFileSize)</span>
            </div>
            <button type="button"
                    @onclick="ClearAttachment"
                    title="@Loc["Chat_RemoveAttachment"]"
                    aria-label="@Loc["Chat_RemoveAttachment"]"
                    class="ml-2 rounded-md p-1 text-slate-400 dark:text-[#94A3B8] transition hover:bg-emerald-100 dark:hover:bg-emerald-900/50 hover:text-slate-700 dark:hover:text-white">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    <div class="mx-auto flex max-w-3xl items-end gap-2">
        <div class="relative shrink-0 flex items-center gap-1">
            <button type="button"
                    @onclick="ToggleEmojiPicker"
                    title="@Loc["Chat_InsertEmoji"]"
                    aria-label="@Loc["Chat_InsertEmoji"]"
                    aria-expanded="@showEmojiPicker.ToString().ToLowerInvariant()"
                    class="rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] p-2 text-slate-600 dark:text-[#94A3B8] transition hover:bg-slate-50 dark:hover:bg-[#182030] hover:text-slate-900 dark:hover:text-white active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30 focus:ring-offset-2">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
                </svg>
            </button>

            <label title="@Loc["Chat_AttachFile"]" class="cursor-pointer rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] p-2 text-slate-600 dark:text-[#94A3B8] transition hover:bg-slate-50 dark:hover:bg-[#182030] hover:text-slate-900 dark:hover:text-white active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                </svg>
                <InputFile OnChange="HandleFileSelected" accept="@ChatAttachmentPolicy.AcceptAttribute" class="hidden" disabled="@(IsSubmitting || Disabled)" />
            </label>

            @if (showEmojiPicker)
            {
                <div class="fixed inset-0 z-20" @onclick="ClosePickers"></div>
                <div class="absolute bottom-12 left-0 z-30 flex gap-1 rounded-xl border border-slate-200 dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] p-2 text-xl shadow-lg">
                    @foreach (var emoji in quickEmojis)
                    {
                        <button type="button" @onclick="() => AddEmoji(emoji)" class="cursor-pointer rounded-lg p-1.5 transition hover:bg-slate-100 dark:hover:bg-[#182030] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30">
                            @emoji
                        </button>
                    }
                </div>
            }

            <!-- Sticker Picker Button -->
            <button type="button"
                    @onclick="ToggleStickerPicker"
                    title="@Loc["Chat_SendSticker"]"
                    aria-label="@Loc["Chat_SendSticker"]"
                    aria-expanded="@showStickerPicker.ToString().ToLowerInvariant()"
                    class="rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] p-2 text-slate-600 dark:text-[#94A3B8] transition hover:bg-[#0A1B2E]/5 dark:hover:bg-[#182030] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.30)] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30 focus:ring-offset-2">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                    <path d="M9 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor"/>
                    <path d="M15 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor"/>
                    <path d="M10 16c.8 1 3.2 1 4 0"/>
                </svg>
            </button>

            @if (showStickerPicker)
            {
                <div class="fixed inset-0 z-20" @onclick="ClosePickers"></div>
                <div class="absolute bottom-12 left-8 z-30 flex items-center gap-2 rounded-2xl border border-slate-200 dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] p-2.5 shadow-xl animate-in fade-in zoom-in-95 duration-150">
                    <div class="text-[11px] font-semibold text-slate-400 dark:text-[#94A3B8] uppercase tracking-wider px-1">@Loc["Chat_Stickers"]</div>
                    @foreach (var s in availableStickers)
                    {
                        <button type="button"
                                @onclick="() => SendSticker(s.Url)"
                                title="@s.Name"
                                disabled="@(IsSubmitting || Disabled)"
                                class="group relative flex h-12 w-12 items-center justify-center rounded-xl p-1 transition hover:scale-110 hover:bg-[#0A1B2E]/5 dark:hover:bg-[#182030] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/30">
                            <img src="@s.Url" alt="@s.Name" class="h-10 w-10 object-contain drop-shadow-sm transition group-hover:drop-shadow-md" />
                        </button>
                    }
                </div>
            }
        </div>

        <label for="chat-composer" class="sr-only">@Loc["Chat_MessageLabel"]</label>
        <textarea id="chat-composer"
                  value="@messageText"
                  @oninput="OnInputChanged"
                  @onkeydown="HandleKeyDown"
                  rows="1"
                  placeholder="@(string.IsNullOrWhiteSpace(Placeholder) ? Loc["Chat_ComposerPlaceholderDirect"] : Placeholder)"
                  disabled="@(IsSubmitting || isUploading || Disabled)"
                  class="max-h-32 min-h-[42px] w-full resize-none rounded-lg border border-slate-300 dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#191B23] px-3.5 py-2.5 text-sm leading-relaxed text-slate-900 dark:text-[#E1E2EC] placeholder-slate-400 dark:placeholder-slate-500 transition focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none focus:ring-1 focus:ring-[#0A1B2E] dark:focus:ring-[#E1E8F0] disabled:bg-slate-100 dark:disabled:bg-[#111622] disabled:text-slate-400 dark:disabled:text-slate-500"></textarea>

        <button type="button"
                @onclick="SubmitMessage"
                disabled="@(IsSubmitting || isUploading || Disabled || (!HasContentToSubmit))"
                aria-label="@Loc["Chat_SendMessage"]"
                class="flex h-[42px] shrink-0 items-center justify-center gap-1.5 rounded-lg bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] dark:hover:bg-white px-4 text-xs font-semibold transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-[#0A1B2E] dark:disabled:hover:bg-[#E1E8F0] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/30 focus:ring-offset-2">
            @if (IsSubmitting || isUploading)
            {
                <span class="h-3.5 w-3.5 animate-spin rounded-full border-b-2 border-white"></span>
                <span class="hidden sm:inline">@(isUploading ? Loc["Chat_Uploading"] : Loc["Chat_Sending"])</span>
            }
            else
            {
                <span class="hidden sm:inline">@Loc["Chat_Send"]</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.126A59.768 59.768 0 0 1 21.485 12 59.77 59.77 0 0 1 3.27 20.876L5.999 12Zm0 0h7.5" />
                </svg>
            }
        </button>
    </div>

    @if (Disabled && !string.IsNullOrWhiteSpace(DisabledReason))
    {
        <p class="mx-auto mt-2 max-w-3xl text-xs text-slate-500 dark:text-[#94A3B8]">@DisabledReason</p>
    }
</div>

@code {
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Write a message...";
    [Parameter] public ChatMessageViewModel? ReplyToMessage { get; set; }
    [Parameter] public EventCallback<SendMessagePayload> OnSend { get; set; }
    [Parameter] public EventCallback OnCancelReply { get; set; }
    [Parameter] public EventCallback<bool> OnTyping { get; set; }

    private string messageText = "";
    private bool showEmojiPicker;
    private bool showStickerPicker;
    private bool _isCurrentlyTyping;
    private System.Threading.Timer? _typingTimer;

    private IBrowserFile? attachedFile;
    private string? attachedFileName;
    private long? attachedFileSize;
    private string formattedFileSize = "0 B";
    private string? attachmentError;
    private string attachmentType = ChatAttachmentPolicy.MessageTypeText;
    private bool isUploading;

    private bool HasContentToSubmit => !string.IsNullOrWhiteSpace(messageText) || attachedFile is not null;

    private static readonly string[] quickEmojis = ["👍", "❤️", "🔥", "😊", "🎉", "👏", "🚀", "💡"];

    private record StickerItem(string Name, string Url);
    private static readonly StickerItem[] availableStickers =
    [
        new("Like", "/stickers/like.svg"),
        new("Love", "/stickers/love.svg"),
        new("Fire", "/stickers/fire.svg"),
        new("Party", "/stickers/party.svg"),
        new("Cool", "/stickers/cool.svg")
    ];

    private void ClosePickers()
    {
        showStickerPicker = false;
        showEmojiPicker = false;
    }

    private string FormatReplyPreview(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return string.Empty;
        var trimmed = content.Trim();
        if (trimmed.StartsWith("[sticker:", StringComparison.OrdinalIgnoreCase) && trimmed.EndsWith("]"))
        {
            return "🎨 " + Loc["Chat_Stickers"];
        }
        return content;
    }

    private void ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
        if (showEmojiPicker) showStickerPicker = false;
    }

    private void ToggleStickerPicker()
    {
        showStickerPicker = !showStickerPicker;
        if (showStickerPicker) showEmojiPicker = false;
    }

    private async Task SendSticker(string stickerUrl)
    {
        if (IsSubmitting || Disabled) return;
        showStickerPicker = false;
        var payload = new SendMessagePayload($"[sticker:{stickerUrl}]", ReplyToMessage?.Id);
        await OnSend.InvokeAsync(payload);
    }

    private async Task AddEmoji(string emoji)
    {
        messageText += emoji;
        showEmojiPicker = false;
        await OnInputChanged(new ChangeEventArgs { Value = messageText });
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        ClosePickers();
        messageText = e.Value?.ToString() ?? "";
        await NotifyTypingAsync(!string.IsNullOrWhiteSpace(messageText));
    }

    private Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return Task.CompletedTask;

        attachmentError = null;

        if (!ChatAttachmentPolicy.IsAllowed(file.Name))
        {
            ResetAttachmentState();
            attachmentError = Loc["Chat_UnsupportedFileType", ChatAttachmentPolicy.AllowedExtensionsDisplay];
            return Task.CompletedTask;
        }

        if (file.Size > ChatAttachmentPolicy.MaxBytes)
        {
            ResetAttachmentState();
            attachmentError = Loc["Chat_FileTooLarge", file.Name, FileSizeFormatter.FormatFileSize(file.Size)];
            return Task.CompletedTask;
        }

        if (file.Size == 0)
        {
            ResetAttachmentState();
            attachmentError = Loc["Chat_FileIsEmpty", file.Name];
            return Task.CompletedTask;
        }

        attachedFile = file;
        attachedFileName = file.Name;
        attachedFileSize = file.Size;
        formattedFileSize = FileSizeFormatter.FormatFileSize(file.Size);
        attachmentType = ChatAttachmentPolicy.Classify(file.Name, file.ContentType);

        return Task.CompletedTask;
    }

    private void ClearAttachment()
    {
        ResetAttachmentState();
        attachmentError = null;
    }

    private void ResetAttachmentState()
    {
        attachedFile = null;
        attachedFileName = null;
        attachedFileSize = null;
        formattedFileSize = "0 B";
        attachmentType = ChatAttachmentPolicy.MessageTypeText;
    }

    private async Task NotifyTypingAsync(bool isTyping)
    {
        if (isTyping != _isCurrentlyTyping)
        {
            _isCurrentlyTyping = isTyping;
            await OnTyping.InvokeAsync(_isCurrentlyTyping);
        }

        _typingTimer?.Dispose();
        if (_isCurrentlyTyping)
        {
            _typingTimer = new System.Threading.Timer(async _ =>
            {
                _isCurrentlyTyping = false;
                await InvokeAsync(async () => await OnTyping.InvokeAsync(false));
            }, null, 3000, System.Threading.Timeout.Infinite);
        }
    }

    private async Task CancelReply() => await OnCancelReply.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClosePickers();
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SubmitMessage();
        }
    }

    private async Task SubmitMessage()
    {
        if (IsSubmitting || Disabled || isUploading || !HasContentToSubmit)
        {
            return;
        }

        _typingTimer?.Dispose();
        if (_isCurrentlyTyping)
        {
            _isCurrentlyTyping = false;
            await OnTyping.InvokeAsync(false);
        }

        var text = messageText.Trim();
        var replyToId = ReplyToMessage?.Id;
        var file = attachedFile;

        // Upload the attachment first so the message we post carries a short URL. Doing it
        // the other way round would leave an orphaned upload whenever the send is rejected.
        string? attachmentUrl = null;
        var messageType = ChatAttachmentPolicy.MessageTypeText;

        if (file is not null)
        {
            isUploading = true;
            StateHasChanged();

            var upload = await ChatApi.UploadAttachmentAsync(file);
            isUploading = false;

            if (upload.IsFailure || upload.Data is null)
            {
                attachmentError = upload.Message ?? Loc["Chat_UploadFailed"];
                StateHasChanged();
                return;
            }

            attachmentUrl = upload.Data.Url;
            messageType = upload.Data.MessageType;
        }

        var payload = new SendMessagePayload(
            Text: text,
            ReplyToId: replyToId,
            MessageType: messageType,
            AttachmentUrl: attachmentUrl,
            FileName: file?.Name,
            FileSizeByte: attachedFileSize
        );

        messageText = "";
        showEmojiPicker = false;
        ClearAttachment();
        StateHasChanged();
        await OnSend.InvokeAsync(payload);
    }

    public record SendMessagePayload(
        string Text,
        int? ReplyToId,
        string MessageType = ChatAttachmentPolicy.MessageTypeText,
        string? AttachmentUrl = null,
        string? FileName = null,
        long? FileSizeByte = null
    );
}
