@using CommunityLink.App.Components.Shared.Chat

@*
    Pane 1 of the unified Chat layout: one list holding both 1:1 conversations and
    joined chat groups, ordered by recent activity and filtered by segment.
*@

<div class="flex h-full w-full shrink-0 flex-col border-slate-200 bg-white md:w-80 md:border-r lg:w-80">
    <div class="shrink-0 border-b border-slate-200 px-4 py-3.5">
        <div class="flex items-center justify-between gap-2">
            <h1 class="flex items-center gap-2 text-base font-semibold text-slate-900">
                <svg class="h-5 w-5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z" />
                </svg>
                Chat
            </h1>

            <div class="flex items-center gap-1.5">
                @if (IsPremiumCreator)
                {
                    <button type="button"
                            @onclick="OnNewGroup"
                            title="Create a chat group"
                            aria-label="Create a chat group"
                            class="flex items-center gap-1.5 rounded-lg bg-indigo-600 px-2.5 py-1.5 text-xs font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        <span class="hidden sm:inline">New group</span>
                    </button>
                }
                <button type="button"
                        @onclick="OnDiscover"
                        title="Discover chat groups"
                        aria-label="Discover chat groups"
                        class="rounded-lg border border-slate-200 p-1.5 text-slate-600 transition hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607Z" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="relative mt-3">
            <label for="chat-thread-search" class="sr-only">Search conversations and people by username</label>
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607Z" />
            </svg>
            <input id="chat-thread-search"
                   type="search"
                   @bind="SearchText"
                   @bind:event="oninput"
                   @bind:after="NotifySearchChanged"
                   placeholder="Search username or conversations..."
                   class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-900 placeholder-slate-400 transition focus:border-indigo-600 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-600" />
        </div>

        <div class="mt-2 grid grid-cols-3 gap-1 rounded-lg bg-slate-100 p-1 text-xs font-medium" role="tablist" aria-label="Filter conversations">
            @foreach (var segment in Segments)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(ActiveSegment == segment.Key)"
                        @onclick="() => OnSegmentChanged.InvokeAsync(segment.Key)"
                        class="rounded-md px-2 py-1.5 text-center transition focus:outline-none focus:ring-2 focus:ring-indigo-500
                               @(ActiveSegment == segment.Key ? "bg-white font-semibold text-indigo-700" : "text-slate-600 hover:text-slate-900")">
                    @segment.Label
                </button>
            }
        </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto">
        @if (IsLoading)
        {
            <div class="space-y-1 p-2" aria-busy="true" aria-label="Loading conversations">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="flex items-center gap-3 rounded-lg p-2.5">
                        <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                        <div class="flex-1 space-y-2">
                            <div class="skeleton h-3 w-2/5"></div>
                            <div class="skeleton h-2.5 w-3/5"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (HasError)
        {
            <div class="m-4 rounded-lg border border-rose-200 bg-rose-50 p-4 text-center">
                <svg class="mx-auto h-6 w-6 text-rose-500" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                </svg>
                <p class="mt-2 text-sm font-medium text-rose-800">Couldn't load your conversations</p>
                <button type="button"
                        @onclick="OnRetry"
                        class="mt-3 rounded-lg border border-rose-300 bg-white px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-400">
                    Try again
                </button>
            </div>
        }
        else
        {
            @if (ShowPeopleSection)
            {
                <section class="border-b border-slate-200 px-1.5 pb-2 pt-2" aria-label="People">
                    <h2 class="px-1 pb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">People</h2>

                    @if (IsSearchingUsers)
                    {
                        <div class="space-y-1" aria-busy="true">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="flex items-center gap-3 rounded-lg p-2.5">
                                    <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
                                    <div class="flex-1 space-y-2">
                                        <div class="skeleton h-3 w-2/5"></div>
                                        <div class="skeleton h-2.5 w-1/3"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (UserMatches.Count == 0)
                    {
                        <p class="px-1 py-3 text-xs text-slate-500">No people match that username.</p>
                    }
                    else
                    {
                        <ul class="space-y-0.5" role="list">
                            @foreach (var person in UserMatches)
                            {
                                var isExisting = DirectThreadUserIds.Contains(person.UserId);
                                <li>
                                    <button type="button"
                                            @onclick="() => OnStartChat.InvokeAsync(person)"
                                            aria-label="@(isExisting ? $"Open chat with {person.DisplayName}" : $"Start a chat with {person.DisplayName}")"
                                            class="group flex w-full items-center gap-3 rounded-lg border border-transparent px-2.5 py-2.5 text-left transition hover:border-indigo-200 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                                        @if (!string.IsNullOrWhiteSpace(person.AvatarUrl))
                                        {
                                            <img src="@person.AvatarUrl" alt="" class="h-10 w-10 shrink-0 rounded-full object-cover" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                            <span class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@Initial(person.DisplayName)</span>
                                        }
                                        else
                                        {
                                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@Initial(person.DisplayName)</span>
                                        }

                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-center gap-1">
                                                <span class="truncate text-sm font-medium text-slate-900">@person.DisplayName</span>
                                                @if (person.IsVerified)
                                                {
                                                    <svg class="h-3.5 w-3.5 shrink-0 text-indigo-600" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-label="Verified">
                                                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                                                    </svg>
                                                }
                                            </span>
                                            <span class="mt-0.5 block truncate text-xs text-slate-500">@@@person.UserName</span>
                                        </span>

                                        <span class="shrink-0 text-xs font-medium text-indigo-600 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">
                                            @(isExisting ? "Open chat" : "Message")
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (VisibleThreads.Count == 0)
            {
                @if (!ShowPeopleSection)
                {
                    <div class="px-6 py-12 text-center">
                        <svg class="mx-auto h-8 w-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z" />
                        </svg>
                        <p class="mt-3 text-sm font-semibold text-slate-700">@EmptyTitle</p>
                        <p class="mt-1 text-xs text-slate-500">@EmptyDescription</p>
                    </div>
                }
            }
            else
            {
                <ul class="p-1.5" role="list">
                @foreach (var thread in VisibleThreads)
                {
                    var isActive = IsActive(thread);
                    <li>
                        <button type="button"
                                @onclick="() => OnSelect.InvokeAsync(thread)"
                                aria-current="@(isActive ? "true" : null)"
                                class="flex w-full items-center gap-3 rounded-lg border px-2.5 py-2.5 text-left transition
                                       @(isActive
                                            ? "border-indigo-200 bg-indigo-50"
                                            : "border-transparent hover:bg-slate-50")">
                            <span class="relative shrink-0">
                                @if (!string.IsNullOrWhiteSpace(thread.AvatarUrl))
                                {
                                    <img src="@thread.AvatarUrl" alt="" class="h-10 w-10 rounded-full object-cover" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                    <span class="hidden h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@thread.Initials</span>
                                }
                                else
                                {
                                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@thread.Initials</span>
                                }
                                @if (thread.IsDirect && thread.IsOnline)
                                {
                                    <span class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500" title="Online"></span>
                                }
                                else if (thread.IsGroup)
                                {
                                    <span class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-slate-600 text-white" title="Chat group">
                                        <svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.94-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.06 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                                        </svg>
                                    </span>
                                }
                                @if (!thread.IsUnlocked)
                                {
                                    <span class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-amber-500 text-white" title="Paid chat">
                                        <svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                        </svg>
                                    </span>
                                }
                            </span>

                            <span class="min-w-0 flex-1">
                                <span class="flex items-baseline justify-between gap-2">
                                    <span class="truncate text-sm @(isActive ? "font-semibold text-indigo-900" : "font-medium text-slate-900")">@thread.Title</span>
                                    <span class="shrink-0 text-xs text-slate-400">@ChatThreadMapper.FormatActivityTime(thread.LastActivityAt)</span>
                                </span>
                                <span class="mt-0.5 flex items-center justify-between gap-2">
                                    <span class="truncate text-xs text-slate-500">@ChatThreadMapper.FormatPreview(thread.LastMessagePreview)</span>
                                    @if (thread.RequiresPayment)
                                    {
                                        <span class="shrink-0 rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-xs font-semibold text-amber-700">@thread.FeeLinkDrops drops</span>
                                    }
                                </span>
                            </span>
                        </button>
                    </li>
                }
                </ul>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatThreadViewModel> VisibleThreads { get; set; } = Array.Empty<ChatThreadViewModel>();
    [Parameter] public ChatThreadType? ActiveThreadType { get; set; }
    [Parameter] public int? ActiveThreadId { get; set; }
    [Parameter] public string ActiveSegment { get; set; } = "all";
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public IReadOnlyList<UserSearchResultDto> UserMatches { get; set; } = Array.Empty<UserSearchResultDto>();
    [Parameter] public IReadOnlyCollection<int> DirectThreadUserIds { get; set; } = Array.Empty<int>();
    [Parameter] public bool IsSearchingUsers { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public bool IsPremiumCreator { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No conversations yet";
    [Parameter] public string EmptyDescription { get; set; } = "Start a chat from a member's profile, or join a group.";

    [Parameter] public EventCallback<ChatThreadViewModel> OnSelect { get; set; }
    [Parameter] public EventCallback<string> OnSegmentChanged { get; set; }
    [Parameter] public EventCallback<string?> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<UserSearchResultDto> OnStartChat { get; set; }
    [Parameter] public EventCallback OnDiscover { get; set; }
    [Parameter] public EventCallback OnNewGroup { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private bool ShowPeopleSection => IsSearchingUsers || UserMatches.Count > 0;

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static readonly (string Key, string Label)[] Segments =
    [
        ("all", "All"),
        ("direct", "Direct"),
        ("group", "Groups")
    ];

    private bool IsActive(ChatThreadViewModel thread) =>
        ActiveThreadId == thread.Id && ActiveThreadType == thread.Type;

    private Task NotifySearchChanged() =>
        OnSearchChanged.InvokeAsync(SearchText);
}
