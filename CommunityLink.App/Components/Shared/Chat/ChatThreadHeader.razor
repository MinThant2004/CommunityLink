@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.ChatGroup

@*
    Thread header for both 1:1 conversations and chat groups.
*@

<div class="shrink-0 border-b border-slate-200 bg-white">
<div class="flex items-center justify-between gap-3 px-3 py-3 sm:px-4">
    <div class="flex min-w-0 items-center gap-2.5">
        @if (ShowBackButton)
        {
            <button type="button"
                    @onclick="OnBack"
                    aria-label="Back to conversations"
                    class="shrink-0 rounded-lg border border-slate-200 p-2 text-slate-600 transition hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 md:hidden">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
            </button>
        }

        <button type="button"
                @onclick="OnToggleInfo"
                class="flex min-w-0 items-center gap-2.5 rounded-lg px-1 py-1 text-left transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <span class="shrink-0">
                @if (!string.IsNullOrWhiteSpace(Thread.AvatarUrl))
                {
                    <img src="@Thread.AvatarUrl" alt="" class="h-10 w-10 rounded-full object-cover" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                    <span class="hidden h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@Thread.Initials</span>
                }
                else
                {
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">@Thread.Initials</span>
                }
            </span>

            <span class="min-w-0">
                <span class="flex items-center gap-1.5">
                    <span class="truncate text-sm font-semibold text-slate-900">@Thread.Title</span>
                    @if (Thread.IsGroup)
                    {
                        <span class="shrink-0 rounded border @(Thread.RequiresPayment ? "border-amber-200 bg-amber-50 text-amber-700" : "border-emerald-200 bg-emerald-50 text-emerald-700") px-1.5 py-0.5 text-xs font-semibold">
                            @Thread.Badge
                        </span>
                    }
                    else if (Thread.RequiresPayment)
                    {
                        <span class="shrink-0 rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-xs font-semibold text-amber-700">Paid</span>
                    }
                </span>
                <span class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-500">
                    @if (!string.IsNullOrWhiteSpace(TypingText))
                    {
                        <span class="flex items-center gap-1 font-medium text-indigo-600 animate-pulse">
                            <span class="h-1.5 w-1.5 rounded-full bg-indigo-600 animate-bounce"></span>
                            @TypingText
                        </span>
                    }
                    else if (Thread.IsDirect)
                    {
                        @if (Thread.IsOnline)
                        {
                            <span class="font-medium text-emerald-600">online</span>
                        }
                        else
                        {
                            <span class="truncate text-slate-500">@ChatThreadMapper.FormatPresenceText(false, Thread.OtherUserLastActiveAt)</span>
                        }
                    }
                    else if (Thread.IsGroup)
                    {
                        <span>@Thread.Subtitle</span>
                        @if (Thread.UserRole is not null && Thread.UserRole != "NONE")
                        {
                            <span aria-hidden="true">·</span>
                            <span class="text-indigo-600">@Thread.UserRole</span>
                        }
                    }
                    else
                    {
                        <span class="truncate">@Thread.Subtitle</span>
                    }
                </span>
            </span>
        </button>
    </div>

    <div class="flex shrink-0 items-center gap-2">
        <button type="button"
                @onclick="OnToggleInfo"
                title="@InfoButtonTitle"
                aria-label="@InfoButtonTitle"
                class="rounded-lg border border-slate-200 p-2 text-slate-600 transition hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
        </button>
    </div>
</div>

    @* Pinned banner: part of reading the group, so it sits above the conversation for every member
       and is not tied to whether the pin happens to be inside the loaded page of history. *@
    @if (PinnedMessage is not null)
    {
        <div class="flex items-start gap-2 border-t border-amber-100 bg-amber-50 px-3 py-2 sm:px-4 cursor-pointer hover:bg-amber-100/70 transition"
             @onclick="HandlePinnedClick">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16 3l5 5-4 1-2.5 2.5L15 15l-2 2-4-4-4.5 4.5L4 17l4.5-4.5-4-4 2-2 3.5.5L12.5 4.5 13 3z" />
            </svg>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-amber-900">Pinned message</p>
                <p class="truncate text-sm text-amber-800">
                    <span class="font-medium">@PinnedMessage.SenderDisplayName:</span>
                    @(string.IsNullOrWhiteSpace(PinnedMessage.Content) ? "Attachment" : PinnedMessage.Content)
                </p>
            </div>
            @if (CanUnpin)
            {
                <button type="button"
                        @onclick="OnUnpin"
                        @onclick:stopPropagation="true"
                        title="Unpin message"
                        aria-label="Unpin message"
                        class="shrink-0 rounded-lg p-1.5 text-amber-600 transition hover:bg-amber-100 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatThreadViewModel Thread { get; set; } = default!;
    [Parameter] public string? TypingText { get; set; }
    [Parameter] public bool ShowBackButton { get; set; }

    /// <summary>The group's pinned message, or null. Only rendered for group threads.</summary>
    [Parameter] public ChatGroupPinnedMessageModel? PinnedMessage { get; set; }

    /// <summary>Whether the viewer may clear the pin, i.e. sent it or holds CanPinMessages.</summary>
    [Parameter] public bool CanUnpin { get; set; }

    [Parameter] public EventCallback OnToggleInfo { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnUnpin { get; set; }
    [Parameter] public EventCallback<int> OnSelectPinnedMessage { get; set; }

    private async Task HandlePinnedClick()
    {
        if (PinnedMessage is not null)
        {
            await OnSelectPinnedMessage.InvokeAsync(PinnedMessage.ChatGroupMessageId);
        }
    }

    private string InfoButtonTitle => Thread.IsGroup ? "Group info and members" : "Conversation details";
}
