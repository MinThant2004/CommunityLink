@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.ChatGroup
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Loc

@*
    Thread header for both 1:1 conversations and chat groups.
*@

<div class="shrink-0 border-b border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111622]">
<div class="flex items-center justify-between gap-3 px-3 py-3 sm:px-4">
    <div class="flex min-w-0 items-center gap-2.5">
        @if (ShowBackButton)
        {
            <button type="button"
                    @onclick="OnBack"
                    aria-label="@Loc["Chat_BackToConversations"]"
                    class="shrink-0 rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] p-2 text-slate-600 dark:text-[#94A3B8] transition hover:bg-slate-50 dark:hover:bg-[#182030] hover:text-slate-900 dark:hover:text-[#E1E2EC] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:ring-offset-2 md:hidden">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
            </button>
        }

        <button type="button"
                @onclick="OnToggleInfo"
                class="flex min-w-0 items-center gap-2.5 rounded-lg px-1 py-1 text-left transition hover:bg-slate-50 dark:hover:bg-[#182030] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:ring-offset-2">
            <span class="shrink-0">
                <UserAvatar Url="@Thread.AvatarUrl"
                            Name="@Thread.Title"
                            Size="h-10 w-10"
                            TextClass="text-sm font-semibold"
                            BgClass="bg-slate-100 dark:bg-[#1D263B]" />
            </span>

            <span class="min-w-0">
                <span class="flex items-center gap-1.5">
                    <span class="truncate text-sm font-semibold text-slate-900 dark:text-[#E1E2EC]">@Thread.Title</span>
                    @if (Thread.IsGroup)
                    {
                        <span class="shrink-0 rounded border @(Thread.RequiresPayment ? "border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300" : "border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300") px-1.5 py-0.5 text-xs font-semibold">
                            @(Thread.IsBanned ? Loc["Chat_Banned"] : (Thread.RequiresPayment ? Loc["Chat_Paid"] : Loc["Chat_Free"]))
                        </span>
                    }
                    else if (Thread.RequiresPayment)
                    {
                        <span class="shrink-0 rounded border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/50 px-1.5 py-0.5 text-xs font-semibold text-amber-700 dark:text-amber-300">@Loc["Chat_Paid"]</span>
                    }
                </span>
                <span class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-500 dark:text-[#94A3B8]">
                    @if (!string.IsNullOrWhiteSpace(TypingText))
                    {
                        <span class="flex items-center gap-1 font-medium text-[#0A1B2E] dark:text-[#E1E8F0] animate-pulse">
                            <span class="h-1.5 w-1.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] animate-bounce"></span>
                            @TypingText
                        </span>
                    }
                    else if (Thread.IsDirect)
                    {
                        @if (Thread.IsOnline)
                        {
                            <span class="font-medium text-emerald-600 dark:text-emerald-400">@Loc["Chat_Online"]</span>
                        }
                        else
                        {
                            <span class="truncate text-slate-500 dark:text-[#94A3B8]">@ChatThreadMapper.FormatPresenceText(false, Thread.OtherUserLastActiveAt, Loc)</span>
                        }
                    }
                    else if (Thread.IsGroup)
                    {
                        <span>@Thread.Subtitle</span>
                        @if (Thread.UserRole is not null && Thread.UserRole != "NONE")
                        {
                            <span aria-hidden="true">·</span>
                            <span class="text-[#0A1B2E] dark:text-[#E1E8F0]">@FormatRole(Thread.UserRole)</span>
                        }
                    }
                    else
                    {
                        <span class="truncate">@Thread.Subtitle</span>
                    }
                </span>
            </span>
        </button>
    </div>

    <div class="flex shrink-0 items-center gap-2">
        <button type="button"
                @onclick="OnToggleInfo"
                title="@InfoButtonTitle"
                aria-label="@InfoButtonTitle"
                class="rounded-lg border border-slate-200 dark:border-[rgba(255,255,255,0.08)] p-2 text-slate-600 dark:text-[#94A3B8] transition hover:bg-slate-50 dark:hover:bg-[#182030] hover:text-slate-900 dark:hover:text-[#E1E2EC] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:ring-offset-2">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
        </button>
    </div>
</div>

    @* Pinned banner: part of reading the group, so it sits above the conversation for every member
       and is not tied to whether the pin happens to be inside the loaded page of history. *@
    @if (PinnedMessage is not null)
    {
        <div class="flex items-start gap-2 border-t border-amber-100 dark:border-amber-900/40 bg-amber-50 dark:bg-amber-950/40 px-3 py-2 sm:px-4 cursor-pointer hover:bg-amber-100/70 dark:hover:bg-amber-900/60 transition"
             @onclick="HandlePinnedClick">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500 dark:text-amber-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16 3l5 5-4 1-2.5 2.5L15 15l-2 2-4-4-4.5 4.5L4 17l4.5-4.5-4-4 2-2 3.5.5L12.5 4.5 13 3z" />
            </svg>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-amber-900 dark:text-amber-300">@Loc["Chat_PinnedMessage"]</p>
                <p class="truncate text-sm text-amber-800 dark:text-amber-400">
                    <span class="font-medium">@PinnedMessage.SenderDisplayName:</span>
                    @(string.IsNullOrWhiteSpace(PinnedMessage.Content) ? Loc["Chat_Attachment"] : PinnedMessage.Content)
                </p>
            </div>
            @if (CanUnpin)
            {
                <button type="button"
                        @onclick="OnUnpin"
                        @onclick:stopPropagation="true"
                        title="@Loc["Chat_UnpinMessage"]"
                        aria-label="@Loc["Chat_UnpinMessage"]"
                        class="shrink-0 rounded-lg p-1.5 text-amber-600 dark:text-amber-400 transition hover:bg-amber-100 dark:hover:bg-amber-900/60 hover:text-amber-800 dark:hover:text-amber-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatThreadViewModel Thread { get; set; } = default!;
    [Parameter] public string? TypingText { get; set; }
    [Parameter] public bool ShowBackButton { get; set; }

    /// <summary>The group's pinned message, or null. Only rendered for group threads.</summary>
    [Parameter] public ChatGroupPinnedMessageModel? PinnedMessage { get; set; }

    /// <summary>Whether the viewer may clear the pin, i.e. sent it or holds CanPinMessages.</summary>
    [Parameter] public bool CanUnpin { get; set; }

    [Parameter] public EventCallback OnToggleInfo { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnUnpin { get; set; }
    [Parameter] public EventCallback<int> OnSelectPinnedMessage { get; set; }

    private async Task HandlePinnedClick()
    {
        if (PinnedMessage is not null)
        {
            await OnSelectPinnedMessage.InvokeAsync(PinnedMessage.ChatGroupMessageId);
        }
    }

    private string InfoButtonTitle => Thread.IsGroup ? Loc["Chat_GroupInfoAndMembers"] : Loc["Chat_ConversationDetails"];

    private string FormatRole(string? role) => (role?.ToUpperInvariant()) switch
    {
        "OWNER" => Loc["Chat_Role_Owner"],
        "ADMIN" => Loc["Chat_Role_Admin"],
        "MEMBER" => Loc["Chat_Role_Member"],
        _ => role ?? string.Empty
    };
}
