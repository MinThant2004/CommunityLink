@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.ChatGroup
@using CommunityLink.Shared.Features.UserProfile
@inject ChatGroupApiService ChatGroupApi
@inject UserProfileApiService UserApi
@inject IJSRuntime JS
@inject NavigationManager Navigation

<ChatModal IsOpen="IsOpen"
           Title="@(Thread.IsGroup ? "Group info" : "Conversation details")"
           MaxWidth="max-w-md"
           OnClose="OnClose">
    <ChildContent>
        <div class="flex flex-col bg-white">
            <!-- Telegram-style Group Header & Quick Actions -->
            <div class="flex flex-col items-center border-b border-slate-100 bg-slate-50/60 px-5 py-5 text-center">
                <div class="relative">
                    @if (!string.IsNullOrWhiteSpace(Thread.AvatarUrl))
                    {
                        <img src="@Thread.AvatarUrl" alt="" class="h-20 w-20 rounded-full object-cover shadow-sm ring-4 ring-white" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                        <span class="hidden h-20 w-20 items-center justify-center rounded-full bg-indigo-600 text-2xl font-bold text-white shadow-sm ring-4 ring-white">@Thread.Initials</span>
                    }
                    else
                    {
                        <span class="flex h-20 w-20 items-center justify-center rounded-full bg-indigo-600 text-2xl font-bold text-white shadow-sm ring-4 ring-white">@Thread.Initials</span>
                    }

                    @if (IsOwner)
                    {
                        <label for="cg-panel-avatar"
                               title="Change group avatar"
                               class="absolute -bottom-1 -right-1 flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow transition hover:bg-slate-50 hover:text-indigo-600 focus-within:ring-2 focus-within:ring-indigo-500">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
                            </svg>
                            <InputFile id="cg-panel-avatar" class="sr-only" OnChange="OnImageSelected" accept="@ChatGroupImagePolicy.AcceptAttribute" />
                        </label>
                    }
                </div>

                @if (IsOwner && editImageFile is not null)
                {
                    <div class="mt-3 flex items-center gap-2">
                        <button type="button" @onclick="UploadImageAsync" disabled="@IsSubmitting"
                                class="rounded-lg bg-indigo-600 px-3 py-1 text-xs font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                            @(IsSubmitting ? "Uploading…" : "Save avatar")
                        </button>
                        <button type="button" @onclick="CancelImage" disabled="@IsSubmitting"
                                class="rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
                            Cancel
                        </button>
                    </div>
                }

                <h2 class="mt-3 text-lg font-bold text-slate-900">@Thread.Title</h2>
                <p class="mt-0.5 text-xs text-slate-500 font-medium">@Thread.Subtitle</p>

                <!-- Telegram Quick Action Buttons (Mute, Manage) -->
                @if (Thread.IsGroup)
                {
                    <div class="mt-4 flex items-center justify-center gap-2.5">
                        <!-- Mute / Unmute Button -->
                        <button type="button"
                                @onclick="ToggleMuteAsync"
                                disabled="@IsSubmitting"
                                title="Toggle group notifications"
                                class="flex flex-col items-center justify-center gap-1 rounded-xl bg-white border border-slate-200 w-16 py-2 shadow-sm transition hover:bg-slate-100 hover:border-slate-300 active:scale-95 disabled:opacity-50">
                            @if (IsMuted)
                            {
                                <svg class="h-4 w-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75 19.5 12m0 0 2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6 4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.395C2.806 8.757 3.63 8.25 4.51 8.25H6.75Z" />
                                </svg>
                                <span class="text-[10px] font-semibold text-rose-600">Unmute</span>
                            }
                            else
                            {
                                <svg class="h-4 w-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                                </svg>
                                <span class="text-[10px] font-semibold text-slate-700">Mute</span>
                            }
                        </button>

                        <!-- Invite Link Quick Button (Owner / Admin) -->
                        @if (IsAdminOrOwner)
                        {
                            <button type="button"
                                    @onclick="OpenInviteLinksModalAsync"
                                    title="Group invite links"
                                    class="flex flex-col items-center justify-center gap-1 rounded-xl bg-white border border-slate-200 w-16 py-2 shadow-sm transition hover:bg-slate-100 hover:border-slate-300 active:scale-95">
                                <svg class="h-4 w-4 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                                </svg>
                                <span class="text-[10px] font-semibold text-slate-700">Invite link</span>
                            </button>
                        }

                        <!-- Manage Group Button (Owner / Admin) -->
                        @if (IsAdminOrOwner)
                        {
                            <button type="button"
                                    @onclick="ToggleManageSection"
                                    title="Manage group settings"
                                    class="flex flex-col items-center justify-center gap-1 rounded-xl bg-white border @(showManageSection ? "border-indigo-600 ring-2 ring-indigo-500/20 bg-indigo-50/50" : "border-slate-200 hover:bg-slate-100 hover:border-slate-300") w-16 py-2 shadow-sm transition active:scale-95">
                                <svg class="h-4 w-4 @(showManageSection ? "text-indigo-600" : "text-slate-600")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                                </svg>
                                <span class="text-[10px] font-semibold @(showManageSection ? "text-indigo-600" : "text-slate-700")">Manage</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Scrollable Content Body (About Section, Manage Settings, Members List) -->
            <div class="flex-1 max-h-[55vh] overflow-y-auto px-5 py-4 space-y-4 divide-y divide-slate-100">
                <!-- About Section -->
                @if (Thread.IsGroup)
                {
                    <div class="pt-1">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">About</h3>
                        <p class="mt-1.5 whitespace-pre-wrap text-sm text-slate-700 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(Thread.Description) ? "No description provided." : Thread.Description)
                        </p>
                    </div>
                }

                <!-- Manage Group Settings Section -->
                @if (IsAdminOrOwner && Thread.IsGroup && showManageSection)
                {
                    <div class="pt-4 space-y-4">
                        <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-900 flex items-center gap-1.5">
                                <svg class="h-3.5 w-3.5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                                </svg>
                                Group Settings & Administration
                            </h3>

                            @if (actionError is not null)
                            {
                                <p class="mt-2.5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium text-rose-700" role="alert">@actionError</p>
                            }

                            <!-- Edit Name & Description (Owner) -->
                            @if (IsOwner)
                            {
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    @if (isEditing)
                                    {
                                        <div class="space-y-2.5">
                                            <div>
                                                <label for="mg-name" class="mb-1 block text-xs font-semibold text-slate-700">Group name</label>
                                                <input id="mg-name" type="text" @bind="editName"
                                                       class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-900 focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600" />
                                            </div>
                                            <div>
                                                <label for="mg-desc" class="mb-1 block text-xs font-semibold text-slate-700">Description</label>
                                                <textarea id="mg-desc" @bind="editDescription" rows="2"
                                                          class="w-full resize-none rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-900 focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600"></textarea>
                                            </div>
                                            <div class="flex items-center gap-2 pt-1">
                                                <button type="button" @onclick="SaveInfoAsync" disabled="@IsSubmitting"
                                                        class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                                                    @(IsSubmitting ? "Saving…" : "Save changes")
                                                </button>
                                                <button type="button" @onclick="CancelEdit" disabled="@IsSubmitting"
                                                        class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="BeginEdit" disabled="@IsSubmitting"
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-center gap-1.5">
                                            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                                            </svg>
                                            Edit group name & description
                                        </button>
                                    }
                                </div>

                                <!-- Invite Links Row (Owner / Admin) -->
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    <button type="button" @onclick="OpenInviteLinksModalAsync" disabled="@IsSubmitting"
                                            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="h-3.5 w-3.5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                                            </svg>
                                            <span>Invite links</span>
                                        </div>
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-600">
                                            @(inviteLinks.Count > 0 ? inviteLinks.Count : (primaryInviteLink != null ? 1 : 1))
                                        </span>
                                    </button>
                                </div>
                            }

                            <!-- Join Fee (Owner) -->
                            @if (IsOwner)
                            {
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    @if (isEditingFee)
                                    {
                                        <div class="space-y-2.5">
                                            <label for="mg-fee" class="block text-xs font-semibold text-slate-700">Join fee (LinkDrops)</label>
                                            <input id="mg-fee" type="number" min="0" @bind="editFeeLinkDrops"
                                                   class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-900 focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600" />
                                            <p class="text-[11px] text-slate-500">A fee of 0 makes the group free.</p>
                                            <div class="flex items-center gap-2 pt-1">
                                                <button type="button" @onclick="SaveFeeAsync" disabled="@IsSubmitting"
                                                        class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                                                    @(IsSubmitting ? "Saving…" : "Update fee")
                                                </button>
                                                <button type="button" @onclick="CancelEditFee" disabled="@IsSubmitting"
                                                        class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="BeginEditFee" disabled="@IsSubmitting"
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-center gap-1.5">
                                            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33" />
                                            </svg>
                                            Change join fee (@Thread.FeeLinkDrops LinkDrops)
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Access Mode (Owner) -->
                            @if (IsOwner)
                            {
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    @if (isEditingAccessMode)
                                    {
                                        <div class="space-y-2.5">
                                            <label class="block text-xs font-semibold text-slate-700">Access Mode</label>
                                            <div class="grid grid-cols-2 gap-2">
                                                <button type="button" @onclick='() => editAccessMode = "PUBLIC"'
                                                        class="flex items-center justify-center gap-1.5 rounded-lg border p-2 text-xs font-semibold transition @(editAccessMode == "PUBLIC" ? "border-indigo-600 bg-indigo-50 text-indigo-700 ring-1 ring-indigo-600" : "border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                                    <span>🌐</span>
                                                    <span>Public</span>
                                                </button>
                                                <button type="button" @onclick='() => editAccessMode = "PRIVATE"'
                                                        class="flex items-center justify-center gap-1.5 rounded-lg border p-2 text-xs font-semibold transition @(editAccessMode == "PRIVATE" ? "border-indigo-600 bg-indigo-50 text-indigo-700 ring-1 ring-indigo-600" : "border-slate-200 bg-white text-slate-600 hover:bg-slate-50")">
                                                    <span>🔒</span>
                                                    <span>Private</span>
                                                </button>
                                            </div>
                                            <p class="text-[11px] text-slate-500">
                                                @(editAccessMode == "PRIVATE" ? "Private groups require approval before new members can join." : "Public groups allow anyone to join immediately.")
                                            </p>
                                            <div class="flex items-center gap-2 pt-1">
                                                <button type="button" @onclick="SaveAccessModeAsync" disabled="@IsSubmitting"
                                                        class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                                                    @(IsSubmitting ? "Saving…" : "Save Access Mode")
                                                </button>
                                                <button type="button" @onclick="CancelEditAccessMode" disabled="@IsSubmitting"
                                                        class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="BeginEditAccessMode" disabled="@IsSubmitting"
                                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-center gap-1.5">
                                            <span class="text-sm">@(Thread.AccessMode == "PRIVATE" ? "🔒" : "🌐")</span>
                                            Change access mode (@(Thread.AccessMode == "PRIVATE" ? "Private 🔒" : "Public 🌐"))
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Pending Join Requests (Admin or Owner) -->
                            @if (IsAdminOrOwner)
                            {
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    <button type="button" @onclick="ToggleJoinRequestsAsync" disabled="@IsSubmitting"
                                            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="h-3.5 w-3.5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                                            </svg>
                                            <span>Join Requests</span>
                                        </div>
                                        @if (joinRequests.Count(r => r.Status == "PENDING_APPROVAL") > 0)
                                        {
                                            <span class="rounded-full bg-rose-500 px-2 py-0.5 text-[10px] font-bold text-white">
                                                @joinRequests.Count(r => r.Status == "PENDING_APPROVAL")
                                            </span>
                                        }
                                    </button>

                                    @if (showJoinRequests)
                                    {
                                        <div class="mt-2 space-y-2">
                                            @if (isLoadingJoinRequests)
                                            {
                                                <p class="py-2 text-center text-xs text-slate-500">Loading join requests…</p>
                                            }
                                            else if (joinRequests.Count == 0)
                                            {
                                                <p class="py-2 text-center text-xs text-slate-500">No pending join requests.</p>
                                            }
                                            else
                                            {
                                                <ul class="max-h-48 space-y-1.5 overflow-y-auto" role="list">
                                                    @foreach (var req in joinRequests)
                                                    {
                                                        <li class="flex items-center justify-between gap-2 rounded-lg bg-white p-2.5 shadow-sm border border-slate-100">
                                                            <div class="flex min-w-0 items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(req.UserAvatar))
                                                                {
                                                                    <img src="@req.UserAvatar" alt="" class="h-7 w-7 shrink-0 rounded-full object-cover" />
                                                                }
                                                                else
                                                                {
                                                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-[10px] font-bold text-indigo-600">@Initial(req.UserDisplayName)</span>
                                                                }
                                                                <div class="min-w-0">
                                                                    <div class="flex items-center gap-1.5">
                                                                        <p class="truncate text-xs font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(req.UserDisplayName) ? req.UserName : req.UserDisplayName)</p>
                                                                        @if (req.IsOnline)
                                                                        {
                                                                            <span class="h-2 w-2 rounded-full bg-emerald-500" title="Online"></span>
                                                                        }
                                                                    </div>
                                                                    <p class="text-[10px] text-slate-400">@req.RequestedAt.ToLocalTime().ToString("MMM d, HH:mm")</p>
                                                                </div>
                                                            </div>
                                                            <div class="flex items-center gap-1 shrink-0">
                                                                @if (req.Status == "PENDING_APPROVAL")
                                                                {
                                                                    <button type="button" @onclick="() => ApproveJoinRequestAsync(req.ChatGroupJoinRequestId)" disabled="@IsSubmitting"
                                                                            class="rounded bg-indigo-600 px-2 py-1 text-[10px] font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                                                                        Approve
                                                                    </button>
                                                                    <button type="button" @onclick="() => RejectJoinRequestAsync(req.ChatGroupJoinRequestId)" disabled="@IsSubmitting"
                                                                            class="rounded border border-slate-200 bg-white px-2 py-1 text-[10px] font-semibold text-slate-600 transition hover:bg-slate-50 disabled:opacity-50">
                                                                        Reject
                                                                    </button>
                                                                }
                                                                else if (req.Status == "APPROVED_WAITING_PAYMENT")
                                                                {
                                                                    <span class="rounded bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700 border border-amber-200">
                                                                        Approved (Waiting Payment)
                                                                    </span>
                                                                }
                                                                else if (req.Status == "REJECTED")
                                                                {
                                                                    <span class="rounded bg-rose-50 px-2 py-0.5 text-[10px] font-semibold text-rose-600">
                                                                        Rejected
                                                                    </span>
                                                                }
                                                                else if (req.Status == "JOINED")
                                                                {
                                                                    <span class="rounded bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-600">
                                                                        Joined
                                                                    </span>
                                                                }
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Add Members Directly (Owner) -->
                            @* Owner-only: the server rejects AddMembersAsync for an admin, so the
                               control is hidden rather than shown-and-failing. In a PAID group it
                               issues an invite instead of a membership. *@
                            @if (IsOwner)
                            {
                            <div class="mt-3 border-t border-indigo-100 pt-3">
                                @if (isAdding)
                                {
                                    <label for="mg-add-user" class="block text-xs font-semibold text-slate-700">
                                        @(IsPaidGroup ? "Invite members" : "Add members directly")
                                    </label>
                                    <input @key="addInputKey"
                                           id="mg-add-user" type="text"
                                           @bind="addSearch"
                                           @bind:event="oninput"
                                           @bind:after="OnAddSearchInputAsync"
                                           @onkeydown="OnAddSearchKeyDownAsync"
                                           placeholder="Search user name..."
                                           class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs text-slate-900 focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600" />

                                    @if (isSearching)
                                    {
                                        <p class="mt-2 text-xs text-slate-500">Searching…</p>
                                    }
                                    else if (addCandidates.Count == 0 && addSearch.Trim().Length > 0)
                                    {
                                        <p class="mt-2 text-xs text-slate-500">No matching users found.</p>
                                    }
                                    else
                                    {
                                        <ul class="mt-2 max-h-36 space-y-1 overflow-y-auto" role="list">
                                            @foreach (var candidate in addCandidates)
                                            {
                                                <li class="flex items-center justify-between gap-2 rounded-lg bg-white px-2.5 py-1.5 shadow-sm">
                                                    <div class="flex min-w-0 items-center gap-2">
                                                        @if (!string.IsNullOrWhiteSpace(candidate.AvatarUrl))
                                                        {
                                                            <img src="@candidate.AvatarUrl" alt="" class="h-6 w-6 shrink-0 rounded-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[10px] font-semibold text-slate-600">@Initial(candidate.DisplayName)</span>
                                                        }
                                                        <span class="min-w-0 truncate text-xs text-slate-800">@(string.IsNullOrWhiteSpace(candidate.DisplayName) ? candidate.UserName : candidate.DisplayName)</span>
                                                    </div>
                                                    <button type="button" @onclick="() => AddUserAsync(candidate.UserId)" disabled="@IsSubmitting"
                                                            class="shrink-0 rounded bg-indigo-600 px-2.5 py-1 text-[11px] font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50">
                                                        Add
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }

                                    <button type="button" @onclick="CancelAdd" disabled="@IsSubmitting"
                                            class="mt-2 rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
                                        Close
                                    </button>
                                }
                                else
                                {
                                    <button type="button" @onclick="BeginAdd" disabled="@IsSubmitting"
                                            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-center gap-1.5">
                                        <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                                        </svg>
                                        @(IsPaidGroup ? "Invite members" : "Add members directly")
                                    </button>
                                    @if (IsPaidGroup)
                                    {
                                        <p class="mt-1.5 text-[11px] leading-relaxed text-slate-500">
                                            Invited people are not members yet. They appear under pending invitations and must
                                            pay the @Thread.FeeLinkDrops LinkDrops join fee to take part.
                                        </p>
                                    }
                                }
                            </div>
                            }

                            <!-- Pending Invitations (Admin or Owner) -->
                            @* Invitees are not members, so they are absent from the roster above and
                               are tracked separately until they pay, decline, or are revoked. *@
                            @if (IsPaidGroup)
                            {
                                <div class="mt-3 border-t border-indigo-100 pt-3">
                                    <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pending invitations</h4>

                                    @if (IsLoadingInvitations)
                                    {
                                        <p class="mt-2 text-xs text-slate-500">Loading…</p>
                                    }
                                    else if (Invitations.Count == 0)
                                    {
                                        <p class="mt-1.5 text-xs text-slate-500">No pending invitations.</p>
                                    }
                                    else
                                    {
                                        <ul class="mt-2 max-h-36 space-y-1 overflow-y-auto" role="list">
                                            @foreach (var invite in Invitations)
                                            {
                                                <li class="flex items-center justify-between gap-2.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm">
                                                    <div class="flex min-w-0 items-center gap-2">
                                                        @if (!string.IsNullOrWhiteSpace(invite.InvitedUserAvatar))
                                                        {
                                                            <img src="@invite.InvitedUserAvatar" alt="" class="h-6 w-6 shrink-0 rounded-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-[10px] font-semibold text-indigo-700">@Initial(InviteeName(invite))</span>
                                                        }
                                                        <div class="min-w-0">
                                                            <p class="min-w-0 truncate text-xs text-slate-800">@InviteeName(invite)</p>
                                                            <p class="text-[11px] text-slate-500">Quoted @invite.FeeAtInviteLinkDrops LinkDrops · @invite.InvitedAt.ToLocalTime().ToString("MMM d, HH:mm")</p>
                                                        </div>
                                                    </div>
                                                    <button type="button" @onclick="() => RevokeAsync(invite.InvitedUserId)" disabled="@IsSubmitting"
                                                            class="shrink-0 rounded bg-white px-2.5 py-1 text-[11px] font-semibold text-rose-600 transition hover:bg-rose-50 disabled:opacity-50">
                                                        Revoke
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }

                            <!-- Banned Members -->
                            <div class="mt-3 border-t border-indigo-100 pt-3">
                                <button type="button" @onclick="ToggleBanningAsync" disabled="@IsSubmitting"
                                        class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50 flex items-center justify-center gap-1.5">
                                    <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                                    </svg>
                                    @(isBanning ? "Hide banned list" : "Banned members list")
                                </button>

                                @if (isBanning)
                                {
                                    <ul class="mt-2 max-h-36 space-y-1 overflow-y-auto" role="list">
                                        @if (bannedMembers.Count == 0)
                                        {
                                            <li class="py-2 text-center text-xs text-slate-500">No banned members.</li>
                                        }
                                        else
                                        {
                                            @foreach (var banned in bannedMembers)
                                            {
                                                <li class="flex items-center justify-between gap-2.5 rounded-lg bg-white px-2.5 py-1.5 shadow-sm">
                                                    <span class="min-w-0 truncate text-xs text-slate-800">@banned.BannedUserName</span>
                                                    <button type="button" @onclick="() => UnbanUserAsync(banned.BannedUserId)" disabled="@IsSubmitting"
                                                            class="shrink-0 rounded bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 transition hover:bg-emerald-100 disabled:opacity-50">
                                                        Unban
                                                    </button>
                                                </li>
                                            }
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Members List Section -->
                @if (Thread.IsGroup && Thread.IsJoined)
                {
                    <div class="pt-4">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">@Thread.MemberCount MEMBERS</h3>
                            @if (IsAdminOrOwner)
                            {
                                <button type="button"
                                        @onclick="() => { showManageSection = true; isAdding = true; }"
                                        title="Add Member"
                                        class="flex items-center gap-1 text-xs font-semibold text-indigo-600 hover:text-indigo-700">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                                    </svg>
                                    <span>Add</span>
                                </button>
                            }
                        </div>

                        <ul class="space-y-1.5" role="list">
                            @if (IsLoadingMembers)
                            {
                                <li class="space-y-2 py-2">
                                    @for (var i = 0; i < 4; i++)
                                    {
                                        <div class="skeleton h-10 w-full rounded-lg"></div>
                                    }
                                </li>
                            }
                            else if (Members.Count == 0)
                            {
                                <li class="py-4 text-center text-xs text-slate-500">No members to display.</li>
                            }
                            else
                            {
                                @foreach (var member in Members)
                                {
                                    <li class="rounded-xl transition hover:bg-slate-50">
                                        <div class="flex items-center justify-between gap-3 p-2">
                                        <div class="flex min-w-0 items-center gap-3">
                                            <div class="relative shrink-0">
                                                @if (!string.IsNullOrWhiteSpace(member.UserAvatar))
                                                {
                                                    <img src="@member.UserAvatar" alt="" class="h-9 w-9 shrink-0 rounded-full object-cover shadow-sm" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                                    <span class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">@Initial(member.DisplayName)</span>
                                                }
                                                else
                                                {
                                                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">@Initial(member.DisplayName)</span>
                                                }
                                                @if (member.IsOnline)
                                                {
                                                    <span class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white bg-emerald-500" title="Online"></span>
                                                }
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="truncate text-sm font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(member.DisplayName) ? member.UserName : member.DisplayName)</span>
                                                <span class="text-[11px] text-slate-400">
                                                    @if (member.IsOnline)
                                                    {
                                                        <span class="font-medium text-emerald-600">online</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@@@member.UserName</span>
                                                    }
                                                </span>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-1.5 shrink-0">
                                            @if (member.Role is "OWNER" or "ADMIN")
                                            {
                                                <span class="rounded-full border @(member.Role == "OWNER" ? "border-amber-200 bg-amber-50 text-amber-700" : "border-indigo-200 bg-indigo-50 text-indigo-700") px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider">@member.Role</span>
                                            }
                                            @if (member.IsMuted)
                                            {
                                                <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[10px] font-semibold text-rose-600" title="Muted">🔕 Muted</span>
                                            }

                                            @if (CanManageMember(member))
                                            {
                                                @if (Thread.UserRole == "OWNER")
                                                {
                                                    @if (member.Role == "MEMBER")
                                                    {
                                                        <button type="button"
                                                                @onclick="() => OnPromoteMember.InvokeAsync(member)"
                                                                disabled="@IsSubmitting"
                                                                title="Promote to Admin"
                                                                class="rounded-lg bg-indigo-50 px-2 py-1 text-[11px] font-semibold text-indigo-700 hover:bg-indigo-100 transition">
                                                            Promote
                                                        </button>
                                                    }
                                                    else if (member.Role == "ADMIN")
                                                    {
                                                        <button type="button"
                                                                @onclick="() => OnDemoteMember.InvokeAsync(member)"
                                                                disabled="@IsSubmitting"
                                                                title="Demote to Member"
                                                                class="rounded-lg bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200 transition">
                                                            Demote
                                                        </button>
                                                    }
                                                }

                                                @if (CanRemoveMember(member))
                                                {
                                                    <button type="button"
                                                            @onclick="() => OnRemoveMember.InvokeAsync(member)"
                                                            disabled="@IsSubmitting"
                                                            title="Remove member"
                                                            class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition">
                                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                        </svg>
                                                    </button>
                                                }

                                                @* Ban is a separate control from Remove because the two
                                                   differ in consequence: Remove lets the user rejoin
                                                   freely, Ban blocks the join and add paths entirely.
                                                   Both hierarchy and the owner-granted flag are encoded,
                                                   matching what the server enforces. *@
                                                @if (CanBanMember(member))
                                                {
                                                    <button type="button"
                                                            @onclick="() => OnBanMember.InvokeAsync(member)"
                                                            disabled="@IsSubmitting"
                                                            title="Ban member"
                                                            class="rounded-lg p-1 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition">
                                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                                                        </svg>
                                                    </button>
                                                }

                                                @* The permission matrix only applies to an admin and is
                                                   owner-only: an admin must not be able to grant powers
                                                   to themselves or a peer. *@
                                                @if (IsOwner && member.Role == "ADMIN")
                                                {
                                                    <button type="button"
                                                            @onclick="() => OpenPermissionEditor(member)"
                                                            disabled="@IsSubmitting"
                                                            title="Edit admin permissions"
                                                            class="rounded-lg bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200 transition">
                                                        Permissions
                                                    </button>
                                                }
                                            }
                                        </div>
                                        </div>

                                        @if (editingPermissionsUserId == member.UserId)
                                        {
                                            <div class="mb-1 ml-2 mr-2 rounded-xl border border-indigo-100 bg-indigo-50/60 p-3">
                                                <p class="text-xs font-semibold text-indigo-900">
                                                    Permissions for @(string.IsNullOrWhiteSpace(member.DisplayName) ? member.UserName : member.DisplayName)
                                                </p>

                                                <div class="mt-2 space-y-1.5">
                                                    <label class="flex items-center gap-2 text-xs text-slate-700">
                                                        <input type="checkbox" @bind="editCanDeleteMessages" disabled="@IsSubmitting" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                        <span>Delete messages</span>
                                                    </label>
                                                    <label class="flex items-center gap-2 text-xs text-slate-700">
                                                        <input type="checkbox" @bind="editCanRemoveMembers" disabled="@IsSubmitting" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                        <span>Remove members</span>
                                                    </label>
                                                    <label class="flex items-center gap-2 text-xs text-slate-700">
                                                        <input type="checkbox" @bind="editCanBanMembers" disabled="@IsSubmitting" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                        <span>Ban members</span>
                                                    </label>
                                                    <label class="flex items-center gap-2 text-xs text-slate-700">
                                                        <input type="checkbox" @bind="editCanManageInviteLinks" disabled="@IsSubmitting" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                        <span>Manage invite links</span>
                                                    </label>
                                                    <label class="flex items-center gap-2 text-xs text-slate-700">
                                                        <input type="checkbox" @bind="editCanPinMessages" disabled="@IsSubmitting" class="h-3.5 w-3.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                        <span>Pin messages</span>
                                                    </label>
                                                </div>

                                                <div class="mt-3 flex justify-end gap-2">
                                                    <button type="button"
                                                            @onclick="CancelPermissionEditor"
                                                            disabled="@IsSubmitting"
                                                            class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600 transition hover:bg-slate-50">
                                                        Cancel
                                                    </button>
                                                    <button type="button"
                                                            @onclick="() => SavePermissionsAsync(member)"
                                                            disabled="@IsSubmitting"
                                                            class="rounded-lg bg-indigo-600 px-2.5 py-1 text-[11px] font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-60">
                                                        @(IsSubmitting ? "Saving." : "Save")
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </ChildContent>

    <FooterContent>
        @if (Thread.IsDirect)
        {
            <button type="button"
                    @onclick="OnToggleBlockUser"
                    disabled="@IsSubmitting"
                    class="rounded-lg border @(Thread.IsBlockedByMe ? "border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100" : "border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100") px-3.5 py-2 text-xs font-semibold transition disabled:opacity-50">
                @(Thread.IsBlockedByMe ? "Unblock User" : "Block User")
            </button>
            <button type="button"
                    @onclick="() => showConfirmDeleteChatModal = true"
                    disabled="@IsSubmitting"
                    class="rounded-lg border border-rose-200 bg-white px-3.5 py-2 text-xs font-semibold text-rose-600 transition hover:bg-rose-50 disabled:opacity-50">
                Delete Chat
            </button>
        }
        @if (Thread.IsGroup && CanLeave)
        {
            <button type="button"
                    @onclick="() => showConfirmLeaveModal = true"
                    class="rounded-lg border border-rose-200 bg-white px-3.5 py-2 text-xs font-semibold text-rose-600 transition hover:bg-rose-50">
                @(IsOwner ? "Delete and leave" : "Leave group")
            </button>
        }
        <button type="button"
                @onclick="OnClose"
                class="rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50">
            Close
        </button>
    </FooterContent>
</ChatModal>

<!-- Dedicated Confirmation Modal Box for Deleting 1:1 Chat -->
<ChatModal IsOpen="showConfirmDeleteChatModal" Title="Delete Chat" MaxWidth="max-w-md" OnClose="() => showConfirmDeleteChatModal = false">
    <ChildContent>
        <div class="flex items-start gap-4 p-5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
            </div>
            <div class="space-y-1">
                <h3 class="text-sm font-semibold text-slate-900">Delete chat history with @Thread.Title?</h3>
                <p class="text-xs text-slate-500 leading-relaxed">
                    This will clear all messages in this conversation for you. The other user will still keep their copy of the conversation.
                </p>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button"
                @onclick="() => showConfirmDeleteChatModal = false"
                disabled="@IsSubmitting"
                class="rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
            Cancel
        </button>
        <button type="button"
                @onclick="ConfirmDeleteChatAsync"
                disabled="@IsSubmitting"
                class="rounded-lg bg-rose-600 px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-rose-700 disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-rose-500">
            @(IsSubmitting ? "Deleting…" : "Delete chat")
        </button>
    </FooterContent>
</ChatModal>

<!-- Dedicated Confirmation Modal Box for Leaving Group -->
<ChatModal IsOpen="showConfirmLeaveModal" Title="Leave Group" MaxWidth="max-w-md" OnClose="() => showConfirmLeaveModal = false">
    <ChildContent>
        <div class="flex items-start gap-4 p-5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                </svg>
            </div>
            <div class="space-y-1">
                @if (IsOwner)
                {
                    <h3 class="text-sm font-semibold text-slate-900">Leaving will delete this group</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        You are the owner of <strong>@Thread.Title</strong>. Ownership cannot be
                        transferred to another member, so leaving deletes the group for everyone.
                        Everyone is removed and no one can rejoin.
                    </p>
                }
                else
                {
                    <h3 class="text-sm font-semibold text-slate-900">Are you sure you want to leave this group?</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        You will no longer be able to send or receive messages in <strong>@Thread.Title</strong> unless you are invited or join again.
                    </p>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button"
                @onclick="() => showConfirmLeaveModal = false"
                disabled="@IsSubmitting"
                class="rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">
            Cancel
        </button>
        <button type="button"
                @onclick="ConfirmLeaveGroupAsync"
                disabled="@IsSubmitting"
                class="rounded-lg bg-rose-600 px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-rose-700 disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-rose-500">
            @(IsSubmitting
                ? (IsOwner ? "Deleting…" : "Leaving…")
                : (IsOwner ? "Yes, delete group and leave" : "Yes, leave group"))
        </button>
    </FooterContent>
</ChatModal>


<!-- Dedicated Invite Links Modal Box (Telegram Style) -->
