                                        <p class="font-mono text-[11px] text-slate-500 truncate">@Navigation.ToAbsoluteUri($"/invite/{link.Token}")</p>
                                        <p class="text-[10px] text-slate-400">Used @link.UseCount times</p>
                                    </div>
                                    <div class="flex items-center gap-1 shrink-0">
                                        <button type="button" @onclick="() => CopyInviteLinkAsync(link.Token)" class="p-1 text-slate-400 hover:text-indigo-600">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.375a9.06 9.06 0 00-1.5-.124H15.75" />
                                            </svg>
                                        </button>
                                        <button type="button" @onclick="() => RevokeInviteLinkAsync(link.ChatGroupInviteLinkId)" class="p-1 text-slate-400 hover:text-rose-600">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <p class="text-[11px] text-slate-400 leading-relaxed pt-2">
                    You can generate invite links that expire after they are used.
                </p>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button"
                @onclick="CloseInviteLinksModal"
                class="w-full rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800">
            Done
        </button>
    </FooterContent>
</ChatModal>

@code {
    // Invite links state
    private bool showInviteLinksModal;
    private bool isLoadingInviteLinks;
    private bool isCreatingLink;
    private bool showCreateLinkInput;
    private string newLinkName = "";
    private string? copySuccessMessage;
    private ChatGroupInviteLinkModel? primaryInviteLink;
    private IReadOnlyList<ChatGroupInviteLinkModel> inviteLinks = Array.Empty<ChatGroupInviteLinkModel>();

    private async Task OpenInviteLinksModalAsync()
    {
        showInviteLinksModal = true;
        await LoadInviteLinksAsync();
    }

    private void CloseInviteLinksModal()
    {
        showInviteLinksModal = false;
        showCreateLinkInput = false;
        newLinkName = "";
        copySuccessMessage = null;
    }

    private async Task LoadInviteLinksAsync()
    {
        isLoadingInviteLinks = true;
        var pRes = await ChatGroupApi.GetOrCreatePrimaryInviteLinkAsync(Thread.Id);
        if (pRes.IsSuccess && pRes.Data != null)
        {
            primaryInviteLink = pRes.Data;
        }

        var lRes = await ChatGroupApi.GetInviteLinksAsync(Thread.Id);
        if (lRes.IsSuccess && lRes.Data != null)
        {
            inviteLinks = lRes.Data;
        }
        isLoadingInviteLinks = false;
    }

    private async Task CopyInviteLinkAsync(string token)
    {
        if (string.IsNullOrWhiteSpace(token)) return;
        var fullUrl = Navigation.ToAbsoluteUri($"/invite/{token}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", fullUrl);
            copySuccessMessage = "Link copied to clipboard!";
        }
        catch
        {
            copySuccessMessage = fullUrl;
        }
        StateHasChanged();
        await Task.Delay(2000);
        copySuccessMessage = null;
        StateHasChanged();
    }

    private async Task CopyPrimaryInviteLinkAsync()
    {
        if (primaryInviteLink != null && !string.IsNullOrWhiteSpace(primaryInviteLink.Token))
        {
            await CopyInviteLinkAsync(primaryInviteLink.Token);
        }
    }

    private async Task CreateCustomLinkAsync()
    {
        if (isCreatingLink) return;
        isCreatingLink = true;

        var request = new CreateInviteLinkRequestModel(Name: string.IsNullOrWhiteSpace(newLinkName) ? null : newLinkName.Trim());
        var res = await ChatGroupApi.CreateInviteLinkAsync(Thread.Id, request);
        isCreatingLink = false;

        if (res.IsSuccess)
        {
            showCreateLinkInput = false;
            newLinkName = "";
            await LoadInviteLinksAsync();
        }
    }

    private async Task RevokeInviteLinkAsync(int linkId)
    {
        var res = await ChatGroupApi.RevokeInviteLinkAsync(Thread.Id, linkId);
        if (res.IsSuccess)
        {
            await LoadInviteLinksAsync();
        }
    }

    [Parameter, EditorRequired] public ChatThreadViewModel Thread { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyList<ChatGroupMemberModel> Members { get; set; } = Array.Empty<ChatGroupMemberModel>();
    [Parameter] public bool IsLoadingMembers { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public bool IsMuted { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? CreatorName { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public EventCallback OnToggleMute { get; set; }
    [Parameter] public EventCallback<ChatGroupMemberModel> OnPromoteMember { get; set; }
    [Parameter] public EventCallback<ChatGroupMemberModel> OnDemoteMember { get; set; }
    [Parameter] public EventCallback<ChatGroupMemberModel> OnRemoveMember { get; set; }
    [Parameter] public EventCallback<ChatGroupMemberModel> OnBanMember { get; set; }

    /// <summary>OWNER. Persists a whole permission set for one admin.</summary>
    [Parameter] public EventCallback<(ChatGroupMemberModel Member, ChatGroupPermissionSet Permissions)> OnUpdateMemberPermissions { get; set; }
    [Parameter] public EventCallback<ChatGroupModel> OnGroupChanged { get; set; }
    [Parameter] public EventCallback<string?> OnGroupImageChanged { get; set; }
    [Parameter] public EventCallback OnDeleteGroup { get; set; }
    [Parameter] public EventCallback OnToggleBlockUser { get; set; }
    [Parameter] public EventCallback OnDeleteConversation { get; set; }
    [Parameter] public Func<int, Task<bool>>? OnAddMembers { get; set; }

    // Outstanding PAID-group invitations. Supplied by the page, which clears them whenever the
    // open thread is not a group or the viewer is not a member, so a stale list cannot render.
    [Parameter] public IReadOnlyList<ChatGroupInviteModel> Invitations { get; set; } = Array.Empty<ChatGroupInviteModel>();
    [Parameter] public bool IsLoadingInvitations { get; set; }
    [Parameter] public EventCallback<int> OnRevokeInvitation { get; set; }

    private bool IsOwner => Thread.IsGroup && Thread.UserRole == "OWNER";
    private bool IsAdminOrOwner => Thread.IsGroup && (Thread.UserRole == "OWNER" || Thread.UserRole == "ADMIN");
    /// <summary>
    /// Every member, the owner included, may leave. The owner is not exempt: ownership is not
    /// transferable, so an owner leave deletes the group (see LeaveChatGroupAsync).
    /// </summary>
    private bool CanLeave => Thread.IsGroup && Thread.IsJoined;

    // Mirrors the server rule in AddMembersAsync: only a PAID group with a non-zero fee is served
    // through invitations, so the wording and the pending list track the real behaviour.
    private bool IsPaidGroup => Thread.IsGroup && Thread.RequiresPayment && Thread.FeeLinkDrops > 0;

    // Manage group state
    private bool showManageSection;
    private bool isEditing;
    private bool isEditingFee;
    private bool isEditingAccessMode;
    private string editAccessMode = "PUBLIC";
    private bool showJoinRequests;
    private bool isLoadingJoinRequests;
    private IReadOnlyList<ChatGroupJoinRequestModel> joinRequests = Array.Empty<ChatGroupJoinRequestModel>();
    private bool isAdding;
    private bool isBanning;
    private bool showConfirmLeaveModal;
    private bool showConfirmDeleteChatModal;

    private async Task ConfirmDeleteChatAsync()
    {
        showConfirmDeleteChatModal = false;
        await OnDeleteConversation.InvokeAsync();
    }

    private async Task ConfirmLeaveGroupAsync()
    {
        showConfirmLeaveModal = false;
        // Owner leave deletes the group, so route through OnDeleteGroup for owners.
        if (IsOwner)
            await OnDeleteGroup.InvokeAsync();
        else
            await OnLeave.InvokeAsync();
    }

    private string? actionError;
    private string editName = "";
    private string? editDescription;
    private long editFeeLinkDrops;
    private IBrowserFile? editImageFile;

    // Add-members search
    private readonly object addInputKey = new();
    private string addSearch = "";
    private bool isSearching;
    private IReadOnlyList<UserSearchResultDto> addCandidates = Array.Empty<UserSearchResultDto>();
    private System.Threading.CancellationTokenSource? addSearchCts;

    /// <summary>
    /// Supersedes any in-flight add-member search. Cancelling and disposing the source here is
    /// safe because the superseded handler only ever touches its own snapshot of the token, never
    /// the <c>CancellationTokenSource</c> itself: reading <c>cts.Token</c> after disposal throws.
    /// </summary>
    private void CancelAddSearch()
    {
        var pending = addSearchCts;
        if (pending is null)
        {
            return;
        }

        addSearchCts = null;
        pending.Cancel();
        pending.Dispose();
    }

    // Banned list, loaded lazily when the owner/admin opens it.
    private IReadOnlyList<ChatGroupBannedMemberModel> bannedMembers = Array.Empty<ChatGroupBannedMemberModel>();

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            showConfirmLeaveModal = false;
        }

        if (Thread != null && !isEditing)
        {
            editName = Thread.Title;
            editDescription = Thread.Description ?? Description;
        }
    }

    private bool CanManageMember(ChatGroupMemberModel member)
    {
        if (!Thread.IsGroup || member.Role == "OWNER") return false;
        if (Thread.UserRole == "OWNER") return true;
        if (Thread.UserRole == "ADMIN" && member.Role == "MEMBER") return true;
        return false;
    }

    /// <summary>
    /// Hierarchy plus the owner-granted flag. An admin who was stripped of CanRemoveMembers still
    /// sees no Remove control, matching what the server would reject.
    /// </summary>
    private bool CanRemoveMember(ChatGroupMemberModel member) =>
        CanManageMember(member) && (Thread.UserRole == "OWNER" || Thread.CanRemoveMembers);

    /// <summary>Hierarchy plus CanBanMembers, and only where the banned list would list them.</summary>
    private bool CanBanMember(ChatGroupMemberModel member) =>
        CanManageMember(member) && (Thread.UserRole == "OWNER" || Thread.CanBanMembers);

    // ---- Per-admin permission editor (owner only) ----

    private int? editingPermissionsUserId;
    private bool editCanDeleteMessages;
    private bool editCanRemoveMembers;
    private bool editCanBanMembers;
    private bool editCanManageInviteLinks;
    private bool editCanPinMessages;

    private void OpenPermissionEditor(ChatGroupMemberModel member)
    {
        editingPermissionsUserId = member.UserId;
        var current = member.Permissions ?? ChatGroupPermissionSet.None;
        editCanDeleteMessages = current.CanDeleteMessages;
        editCanRemoveMembers = current.CanRemoveMembers;
        editCanBanMembers = current.CanBanMembers;
        editCanManageInviteLinks = current.CanManageInviteLinks;
        editCanPinMessages = current.CanPinMessages;
    }

    private void CancelPermissionEditor() => editingPermissionsUserId = null;

    private async Task SavePermissionsAsync(ChatGroupMemberModel member)
    {
        var permissions = new ChatGroupPermissionSet(
            editCanDeleteMessages,
            editCanRemoveMembers,
            editCanBanMembers,
            editCanManageInviteLinks,
            editCanPinMessages);

        // Closed before the await so a slow round trip cannot leave two editors open.
        editingPermissionsUserId = null;
        await OnUpdateMemberPermissions.InvokeAsync((member, permissions));
    }

    private void ToggleManageSection()
    {
        showManageSection = !showManageSection;
        actionError = null;
    }

    private async Task ToggleMuteAsync()
    {
        await OnToggleMute.InvokeAsync();
    }

    private void BeginEdit()
    {
        editName = Thread.Title;
        editDescription = Thread.Description ?? Description;
        actionError = null;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        actionError = null;
    }

    private void BeginEditFee()
    {
        editFeeLinkDrops = Thread.FeeLinkDrops;
        actionError = null;
        isEditingFee = true;
    }

    private void CancelEditFee()
    {
        isEditingFee = false;
        actionError = null;
    }

    private void BeginAdd()
    {
        isAdding = true;
        addSearch = "";
        addCandidates = Array.Empty<UserSearchResultDto>();
        actionError = null;
    }

    private void CancelAdd()
    {
        isAdding = false;
        addSearch = "";
        addCandidates = Array.Empty<UserSearchResultDto>();
        actionError = null;
        CancelAddSearch();
    }

    private async Task SaveInfoAsync()
    {
        if (string.IsNullOrWhiteSpace(editName))
        {
            actionError = "The group name cannot be empty.";
            return;
        }

        if (editName.Trim().Length > 100)
        {
            actionError = "The group name cannot exceed 100 characters.";
            return;
        }

        var request = new UpdateChatGroupRequestModel(
            editName.Trim(),
            string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim(),
            Thread.RequiresPayment ? "PAID" : "FREE",
            Thread.FeeLinkDrops,
            Thread.AccessMode ?? "PUBLIC");

        var res = await ChatGroupApi.UpdateInfoAsync(Thread.Id, request);
        if (res.IsSuccess && res.Data is not null)
        {
            isEditing = false;
            actionError = null;
            Thread.Title = res.Data.Name;
            Thread.Description = res.Data.Description;
            Thread.AccessMode = res.Data.AccessMode;
            await OnGroupChanged.InvokeAsync(res.Data);
        }
        else
        {
            actionError = res.Message ?? "The group could not be updated.";
        }
    }

    private void BeginEditAccessMode()
    {
        editAccessMode = Thread.AccessMode ?? "PUBLIC";
        actionError = null;
        isEditingAccessMode = true;
    }

    private void CancelEditAccessMode()
    {
        isEditingAccessMode = false;
        actionError = null;
    }

    private async Task SaveAccessModeAsync()
    {
        var request = new UpdateChatGroupRequestModel(
            Thread.Title,
            Thread.Description ?? Description,
            Thread.RequiresPayment ? "PAID" : "FREE",
            Thread.FeeLinkDrops,
            editAccessMode);

        var res = await ChatGroupApi.UpdateInfoAsync(Thread.Id, request);
        if (res.IsSuccess && res.Data is not null)
        {
            isEditingAccessMode = false;
            actionError = null;
            Thread.AccessMode = res.Data.AccessMode;
            await OnGroupChanged.InvokeAsync(res.Data);
        }
        else
        {
            actionError = res.Message ?? "The access mode could not be updated.";
        }
    }

    private async Task ToggleJoinRequestsAsync()
    {
        showJoinRequests = !showJoinRequests;
        actionError = null;
        if (showJoinRequests)
        {
            await LoadJoinRequestsAsync();
        }
    }

    private async Task LoadJoinRequestsAsync()
    {
        isLoadingJoinRequests = true;
        var res = await ChatGroupApi.GetJoinRequestsAsync(Thread.Id);
        if (res.IsSuccess && res.Data is not null)
        {
            joinRequests = res.Data;
        }
        else
        {
            actionError = res.Message ?? "Could not load join requests.";
        }
        isLoadingJoinRequests = false;
    }

    private async Task ApproveJoinRequestAsync(int requestId)
    {
        actionError = null;
        var res = await ChatGroupApi.ApproveJoinRequestAsync(Thread.Id, requestId);
        if (res.IsSuccess)
        {
            await LoadJoinRequestsAsync();
        }
        else
        {
            actionError = res.Message ?? "Failed to approve join request.";
        }
    }

    private async Task RejectJoinRequestAsync(int requestId)
    {
        actionError = null;
        var res = await ChatGroupApi.RejectJoinRequestAsync(Thread.Id, requestId);
        if (res.IsSuccess)
        {
            await LoadJoinRequestsAsync();
        }
        else
        {
            actionError = res.Message ?? "Failed to reject join request.";
        }
    }

    private async Task SaveFeeAsync()
    {
        if (editFeeLinkDrops < 0)
        {
            actionError = "The join fee cannot be negative.";
            return;
        }

        var res = await ChatGroupApi.SetJoinFeeAsync(Thread.Id, editFeeLinkDrops);
        if (res.IsSuccess && res.Data is not null)
        {
            isEditingFee = false;
            actionError = null;
            Thread.FeeLinkDrops = res.Data.JoinFeeLinkDrops;
            Thread.RequiresPayment = string.Equals(res.Data.ChatType, "PAID", StringComparison.OrdinalIgnoreCase);
            await OnGroupChanged.InvokeAsync(res.Data);
        }
        else
        {
            actionError = res.Message ?? "The join fee could not be updated.";
        }
    }

    private void OnImageSelected(InputFileChangeEventArgs args)
    {
        actionError = null;

        var file = args.File;
        if (file is null)
        {
            return;
        }

        if (!ChatGroupImagePolicy.IsAllowed(file.Name))
        {
            actionError = $"Unsupported image type. Allowed: {ChatGroupImagePolicy.AllowedExtensionsDisplay}.";
            return;
        }

        if (file.Size > ChatGroupImagePolicy.MaxBytes)
        {
            actionError = "Image is too large. The maximum is 5 MB.";
            return;
        }

        editImageFile = file;
    }

    private void CancelImage()
    {
        editImageFile = null;
        actionError = null;
    }

    private async Task UploadImageAsync()
    {
        if (editImageFile is null)
        {
            return;
        }

        var res = await ChatGroupApi.UpdateImageAsync(Thread.Id, editImageFile);
        if (res.IsSuccess && res.Data is not null)
        {
            editImageFile = null;
            actionError = null;
            Thread.AvatarUrl = res.Data.Url;
            await OnGroupImageChanged.InvokeAsync(res.Data.Url);
        }
        else
        {
            actionError = res.Message ?? "The image could not be uploaded.";
        }
    }

    private async Task OnAddSearchInputAsync()
    {
        CancelAddSearch();

        var term = addSearch.Trim();
        if (term.Length == 0)
        {
            addCandidates = Array.Empty<UserSearchResultDto>();
            isSearching = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var cts = new System.Threading.CancellationTokenSource();
        addSearchCts = cts;

        // Snapshot the token. Every await below re-checks this local copy instead of cts.Token:
        // a newer keystroke disposes cts, and the property getter would then throw
        // ObjectDisposedException on resume. A copied token stays valid after disposal.
        var token = cts.Token;

        try
        {
            // Debounce so a burst of keystrokes only issues one search request.
            await Task.Delay(250, token);

            if (token.IsCancellationRequested)
            {
                return;
            }

            isSearching = true;
            await InvokeAsync(StateHasChanged);

            var res = await UserApi.SearchUsersAsync(term, 8);

            if (token.IsCancellationRequested)
            {
                return;
            }

            if (res.IsSuccess && res.Data is not null)
            {
                var existing = Members.Select(m => m.UserId).ToHashSet();
                addCandidates = res.Data
                    .Where(c => !existing.Contains(c.UserId))
                    .ToList();
            }
            else
            {
                addCandidates = Array.Empty<UserSearchResultDto>();
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke; the newer run owns the results.
        }
        finally
        {
            // Only the current run clears the searching indicator. A superseded run was already
            // cancelled and its source disposed by CancelAddSearch.
            if (addSearchCts == cts)
            {
                addSearchCts = null;
                cts.Dispose();
                isSearching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnAddSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            CancelAddSearch();

            var term = addSearch.Trim();
            if (term.Length == 0)
            {
                addCandidates = Array.Empty<UserSearchResultDto>();
                isSearching = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            isSearching = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                var res = await UserApi.SearchUsersAsync(term, 8);
                if (res.IsSuccess && res.Data is not null)
                {
                    var existing = Members.Select(m => m.UserId).ToHashSet();
                    addCandidates = res.Data
                        .Where(c => !existing.Contains(c.UserId))
                        .ToList();
                }
                else
                {
                    addCandidates = Array.Empty<UserSearchResultDto>();
                }
            }
            finally
            {
                isSearching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task AddUserAsync(int userId)
    {
        actionError = null;

        if (OnAddMembers is null)
        {
            actionError = "Adding members is not available here.";
            return;
        }

        var added = await OnAddMembers(userId);

        if (added)
        {
            addCandidates = addCandidates.Where(c => c.UserId != userId).ToList();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string InviteeName(ChatGroupInviteModel invite) =>
        string.IsNullOrWhiteSpace(invite.InvitedUserDisplayName) ? invite.InvitedUserName : invite.InvitedUserDisplayName;

    private async Task RevokeAsync(int userId)
    {
        actionError = null;
        await OnRevokeInvitation.InvokeAsync(userId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UnbanUserAsync(int userId)
    {
        actionError = null;
        var res = await ChatGroupApi.UnbanMemberAsync(Thread.Id, userId);
        if (res.IsSuccess)
        {
            bannedMembers = bannedMembers.Where(b => b.BannedUserId != userId).ToList();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            actionError = res.Message ?? "The ban could not be lifted.";
        }
    }

    private async Task ToggleBanningAsync()
    {
        isBanning = !isBanning;
        actionError = null;

        if (isBanning && bannedMembers.Count == 0)
        {
            var res = await ChatGroupApi.GetBannedMembersAsync(Thread.Id);
            if (res.IsSuccess && res.Data is not null)
            {
                bannedMembers = res.Data;
            }
            else
            {
                actionError = res.Message ?? "The banned members list could not be loaded.";
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string Initial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name.Trim()[..1].ToUpperInvariant();
    }
}
