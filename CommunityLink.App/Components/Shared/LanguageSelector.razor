@using System.Globalization
@using CommunityLink.App.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc
@inject CultureService CultureService
@inject IJSRuntime JS
@implements IDisposable

<nav aria-label="@Loc["Common_LanguageSelection"]" class="inline-flex items-center gap-1 rounded-md border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.1)] bg-white/80 dark:bg-[#0A0D14]/80 p-0.5 text-xs font-medium backdrop-blur-sm transition-colors">
    <a href="@GetCultureSwitchUrl("en")"
       @onclick='() => SwitchLanguageAsync("en")'
       @onclick:preventDefault
       class="px-2 py-1 rounded transition-colors cursor-pointer @(IsActive("en") 
           ? "bg-[#0A1B2E] text-white dark:bg-[#D4AF37] dark:text-[#0A0D14] font-semibold shadow-xs" 
           : "text-[#557392] hover:text-[#0A1B2E] dark:text-[#94A3B8] dark:hover:text-[#E1E2EC] hover:bg-[#F1F5F9] dark:hover:bg-[#182030]")"
       aria-label="@Loc["Common_SwitchToEnglish"]"
       aria-current="@(IsActive("en") ? "true" : null)">
        EN
    </a>
    <span class="text-[#CBD5E1] dark:text-[rgba(255,255,255,0.2)] select-none text-[11px]" aria-hidden="true">|</span>
    <a href="@GetCultureSwitchUrl("my")"
       @onclick='() => SwitchLanguageAsync("my")'
       @onclick:preventDefault
       class="px-2 py-1 rounded transition-colors cursor-pointer @(IsActive("my") 
           ? "bg-[#0A1B2E] text-white dark:bg-[#D4AF37] dark:text-[#0A0D14] font-semibold shadow-xs" 
           : "text-[#557392] hover:text-[#0A1B2E] dark:text-[#94A3B8] dark:hover:text-[#E1E2EC] hover:bg-[#F1F5F9] dark:hover:bg-[#182030]")"
       aria-label="@Loc["Common_SwitchToMyanmar"]"
       aria-current="@(IsActive("my") ? "true" : null)">
        မြန်မာ
    </a>
</nav>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += HandleCultureChanged;
    }

    private void HandleCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string cultureCode)
    {
        return string.Equals(CultureService.CurrentCultureName, cultureCode, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SwitchLanguageAsync(string targetCulture)
    {
        if (IsActive(targetCulture)) return;

        CultureService.SetCulture(targetCulture);

        try
        {
            await JS.InvokeVoidAsync("setCulturePreference", targetCulture);
        }
        catch
        {
            // Prerendering or testing fallback
        }
    }

    private string GetCultureSwitchUrl(string targetCulture)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var localPath = string.IsNullOrEmpty(relativePath) ? "/" : "/" + relativePath;
        var encodedReturnUrl = Uri.EscapeDataString(localPath);
        return $"/culture/set?culture={targetCulture}&returnUrl={encodedReturnUrl}";
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= HandleCultureChanged;
    }
}
