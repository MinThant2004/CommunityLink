@using System.Globalization
@using System.Text

<div class="flex flex-col gap-2 @Class">
    <div class="flex items-start justify-between gap-3">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant truncate">@Title</span>
        @if (!string.IsNullOrWhiteSpace(Highlight))
        {
            <span class="shrink-0 font-mono text-label-sm text-primary font-bold whitespace-nowrap">@Highlight</span>
        }
    </div>

    <div class="relative">
        <svg class="w-full h-auto" viewBox="0 0 320 100" preserveAspectRatio="xMidYMid meet" role="img" aria-label="@Title">
            <defs>
                <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="rgb(var(--cl-primary))" stop-opacity="0.38"></stop>
                    <stop offset="62%" stop-color="rgb(var(--cl-primary))" stop-opacity="0.12"></stop>
                    <stop offset="100%" stop-color="rgb(var(--cl-primary))" stop-opacity="0"></stop>
                </linearGradient>
            </defs>

            @* Gridlines *@
            @foreach (var tick in ticks)
            {
                <line x1="@F(PlotLeft)" y1="@F(tick.Y)" x2="@F(PlotRight)" y2="@F(tick.Y)"
                      stroke="rgb(var(--cl-outline-variant))" stroke-width="1"
                      vector-effect="non-scaling-stroke" opacity="0.8"></line>
            }

            @* Area fill *@
            @if (!string.IsNullOrEmpty(areaPath))
            {
                <path d="@areaPath" fill="url(#@gradientId)"></path>
            }

            @* Secondary series *@
            @if (!string.IsNullOrEmpty(secondaryPath))
            {
                <path d="@secondaryPath" fill="none" stroke="rgb(var(--cl-secondary))"
                      stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                      stroke-dasharray="4 3" vector-effect="non-scaling-stroke" opacity="0.9"></path>
            }

            @* Primary series *@
            @if (!string.IsNullOrEmpty(primaryPath))
            {
                <path d="@primaryPath" fill="none" stroke="rgb(var(--cl-primary))"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      vector-effect="non-scaling-stroke"></path>
            }

            @* Hover guide *@
            @if (hoverIndex is int hi && hi >= 0 && hi < primaryPoints.Count)
            {
                <line x1="@F(primaryPoints[hi].X)" y1="@F(PlotTop - 2)" x2="@F(primaryPoints[hi].X)" y2="@F(PlotBottom)"
                      stroke="rgb(var(--cl-outline))" stroke-width="1" stroke-dasharray="2 2"
                      vector-effect="non-scaling-stroke" opacity="0.8"></line>
                @if (hi < secondaryPoints.Count)
                {
                    <circle cx="@F(secondaryPoints[hi].X)" cy="@F(secondaryPoints[hi].Y)" r="2.4"
                            fill="rgb(var(--cl-surface-container-low))" stroke="rgb(var(--cl-secondary))"
                            stroke-width="1.5" vector-effect="non-scaling-stroke"></circle>
                }
                <circle cx="@F(primaryPoints[hi].X)" cy="@F(primaryPoints[hi].Y)" r="3.2"
                        fill="rgb(var(--cl-surface-container-low))" stroke="rgb(var(--cl-primary))"
                        stroke-width="2" vector-effect="non-scaling-stroke"></circle>
            }

            @* Latest value marker *@
            @if (primaryPoints.Count > 0)
            {
                var last = primaryPoints[^1];
                <circle cx="@F(last.X)" cy="@F(last.Y)" r="4.5" fill="none"
                        stroke="rgb(var(--cl-primary))" stroke-width="1.5" vector-effect="non-scaling-stroke">
                    <animate attributeName="r" values="3.5;9" dur="2.4s" repeatCount="indefinite"></animate>
                    <animate attributeName="opacity" values="0.5;0" dur="2.4s" repeatCount="indefinite"></animate>
                </circle>
                <circle cx="@F(last.X)" cy="@F(last.Y)" r="2.8" fill="rgb(var(--cl-primary))"
                        stroke="rgb(var(--cl-surface-container-low))" stroke-width="1.5"
                        vector-effect="non-scaling-stroke"></circle>
            }

            @* Hit areas *@
            @for (var i = 0; i < primaryPoints.Count; i++)
            {
                var idx = i;
                <rect x="@F(primaryPoints[i].X - columnWidth / 2)" y="@F(PlotTop - 4)"
                      width="@F(columnWidth)" height="@F(PlotBottom - PlotTop + 8)"
                      fill="transparent" style="cursor: crosshair"
                      @onmouseover="() => hoverIndex = idx"
                      @onmouseleave="ClearHover"></rect>
            }
        </svg>

        @* Y axis labels (HTML overlay: Razor reserves the SVG <text> element) *@
        @foreach (var tick in ticks)
        {
            <span class="absolute left-0 -translate-y-1/2 font-mono text-[9px] leading-none text-on-surface-variant pointer-events-none opacity-90"
                  style="bottom: @PctY(ViewHeight - tick.Y)">@tick.Label</span>
        }

        @* X axis labels *@
        @foreach (var index in xLabelIndexes.OrderBy(i => i))
        {
            <span class="absolute -translate-x-1/2 font-mono text-[9px] leading-none text-on-surface-variant pointer-events-none opacity-85 whitespace-nowrap"
                  style="left: @PctX(primaryPoints[index].X); bottom: @PctY(ViewHeight - LabelBaseline)">@AxisLabel(index)</span>
        }
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 pt-1.5 border-t border-surface-container-high/20">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-label-sm text-label-sm text-on-surface-variant">
            <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
                @PrimaryLabel
                <span class="font-mono text-on-surface font-semibold">@FormatValue(ActiveIndex)</span>
            </span>
            @if (HasSecondary)
            {
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-secondary inline-block"></span>
                    @SecondaryLabel
                    <span class="font-mono text-on-surface font-semibold">@FormatValue(ActiveSecondaryIndex)</span>
                </span>
            }
        </div>
        <span class="font-mono text-label-sm text-primary">@Stamp</span>
    </div>
</div>

@code {
    private const int PlotLeft = 26;
    private const int PlotRight = 317;
    private const int PlotTop = 8;
    private const int PlotBottom = 80;
    private const int LabelBaseline = 93;
    private const int ViewWidth = 320;
    private const int ViewHeight = 100;
    private const int TickCount = 4;

    [Parameter] public string Title { get; set; } = "Telemetry";
    [Parameter] public string? Highlight { get; set; }
    [Parameter] public string PrimaryLabel { get; set; } = "Liquidity";
    [Parameter] public string SecondaryLabel { get; set; } = "Velocity";
    [Parameter] public string ValueSuffix { get; set; } = "";
    [Parameter] public IReadOnlyList<double>? Values { get; set; }
    [Parameter] public IReadOnlyList<double>? SecondaryValues { get; set; }
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }
    [Parameter] public string? Class { get; set; }

    private readonly record struct Point(double X, double Y);
    private readonly record struct Tick(double Y, string Label);

    private string gradientId = "";
    private string primaryPath = "";
    private string secondaryPath = "";
    private string areaPath = "";
    private List<Point> primaryPoints = new();
    private List<Point> secondaryPoints = new();
    private List<Tick> ticks = new();
    private HashSet<int> xLabelIndexes = new();
    private double columnWidth = 20;
    private int? hoverIndex;

    private bool HasSecondary => secondaryPoints.Count > 0;

    private int ActiveIndex => hoverIndex ?? Math.Max(0, primaryPoints.Count - 1);
    private int ActiveSecondaryIndex => hoverIndex ?? Math.Max(0, secondaryPoints.Count - 1);

    private string Stamp => hoverIndex is int i && i >= 0 && i < primaryPoints.Count
        ? AxisLabel(i)
        : string.Empty;

    protected override void OnInitialized()
    {
        gradientId = "tc" + Guid.NewGuid().ToString("N")[..6];
    }

    protected override void OnParametersSet()
    {
        Rebuild();
    }

    private void Rebuild()
    {
        var values = Sanitize(Values);
        var secondary = Sanitize(SecondaryValues);

        if (values.Count == 0)
        {
            values = new List<double> { 0 };
        }

        if (secondary.Count > 0)
        {
            while (secondary.Count < values.Count)
            {
                secondary.Add(secondary.Count > 0 ? secondary[^1] : 0);
            }
            if (secondary.Count > values.Count)
            {
                secondary = secondary.Take(values.Count).ToList();
            }
        }

        var all = values.Concat(secondary).ToList();
        var rawMin = all.Count > 0 ? all.Min() : 0;
        var rawMax = all.Count > 0 ? all.Max() : 1;
        if (Math.Abs(rawMax - rawMin) < 1e-9)
        {
            var pad = Math.Max(1, Math.Abs(rawMax) * 0.15);
            rawMin -= pad;
            rawMax += pad;
        }

        var (min, max, step) = NiceScale(rawMin, rawMax, TickCount);
        var span = max - min;
        if (span <= 0) span = 1;

        ticks = new List<Tick>();
        for (var v = min; v <= max + step * 0.5; v += step)
        {
            var y = PlotBottom - ((v - min) / span) * (PlotBottom - PlotTop);
            ticks.Add(new Tick(y, FormatTick(v, step)));
        }

        var n = values.Count;
        columnWidth = n > 0 ? (PlotRight - PlotLeft) / (double)n : 20;

        primaryPoints = new List<Point>();
        secondaryPoints = new List<Point>();
        for (var i = 0; i < n; i++)
        {
            var x = n == 1
                ? PlotLeft + (PlotRight - PlotLeft) / 2.0
                : PlotLeft + (PlotRight - PlotLeft) * (i / (double)(n - 1));
            primaryPoints.Add(new Point(x, Y(values[i], min, span)));
            if (secondary.Count > 0)
            {
                secondaryPoints.Add(new Point(x, Y(secondary[i], min, span)));
            }
        }

        primaryPath = SmoothPath(primaryPoints);
        secondaryPath = SmoothPath(secondaryPoints);

        areaPath = primaryPoints.Count > 0
            ? primaryPath
                + $" L {F(primaryPoints[^1].X)},{F(PlotBottom)}"
                + $" L {F(primaryPoints[0].X)},{F(PlotBottom)} Z"
            : "";

        var labelStep = Math.Max(1, (int)Math.Ceiling(n / 5.0));
        xLabelIndexes = new HashSet<int>();
        for (var i = 0; i < n; i += labelStep)
        {
            xLabelIndexes.Add(i);
        }
        if (n > 0)
        {
            xLabelIndexes.Add(n - 1);
        }

        hoverIndex = null;
    }

    private static List<double> Sanitize(IReadOnlyList<double>? source)
    {
        if (source == null) return new List<double>();
        return source.Where(v => !double.IsNaN(v) && !double.IsInfinity(v)).ToList();
    }

    private static double Y(double value, double min, double span)
    {
        var raw = PlotBottom - ((value - min) / span) * (PlotBottom - PlotTop);
        return Math.Clamp(raw, PlotTop - 2, PlotBottom + 2);
    }

    private static (double Min, double Max, double Step) NiceScale(double rawMin, double rawMax, int divisions)
    {
        var range = rawMax - rawMin;
        if (range <= 0) range = Math.Max(1, Math.Abs(rawMax) * 0.2);

        var rough = range / divisions;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var normalized = rough / magnitude;
        var nice = normalized switch
        {
            <= 1 => 1d,
            <= 2 => 2d,
            <= 2.5 => 2.5d,
            <= 5 => 5d,
            _ => 10d
        };
        var step = nice * magnitude;

        var min = Math.Floor(rawMin / step) * step;
        var max = Math.Ceiling(rawMax / step) * step;
        if (max - min < step) max = min + step;
        return (min, max, step);
    }

    private static string SmoothPath(IReadOnlyList<Point> pts)
    {
        if (pts.Count == 0) return "";
        if (pts.Count == 1) return $"M {F(pts[0].X)},{F(pts[0].Y)}";

        var sb = new StringBuilder();
        sb.Append("M ").Append(F(pts[0].X)).Append(',').Append(F(pts[0].Y));

        for (var i = 0; i < pts.Count - 1; i++)
        {
            var p0 = pts[Math.Max(0, i - 1)];
            var p1 = pts[i];
            var p2 = pts[i + 1];
            var p3 = pts[Math.Min(pts.Count - 1, i + 2)];

            var c1x = p1.X + (p2.X - p0.X) / 6.0;
            var c1y = Math.Clamp(p1.Y + (p2.Y - p0.Y) / 6.0, PlotTop - 3, PlotBottom + 3);
            var c2x = p2.X - (p3.X - p1.X) / 6.0;
            var c2y = Math.Clamp(p2.Y - (p3.Y - p1.Y) / 6.0, PlotTop - 3, PlotBottom + 3);

            sb.Append(" C ").Append(F(c1x)).Append(',').Append(F(c1y))
              .Append(' ').Append(F(c2x)).Append(',').Append(F(c2y))
              .Append(' ').Append(F(p2.X)).Append(',').Append(F(p2.Y));
        }

        return sb.ToString();
    }

    private string AxisLabel(int index)
    {
        if (Labels != null && index < Labels.Count && !string.IsNullOrWhiteSpace(Labels[index]))
        {
            return Labels[index];
        }
        return "W" + (index + 1).ToString(CultureInfo.InvariantCulture);
    }

    private double ValueAt(int index)
    {
        var v = Values;
        if (v == null || v.Count == 0) return 0;
        return v[Math.Clamp(index, 0, v.Count - 1)];
    }

    private double SecondaryValueAt(int index)
    {
        var v = SecondaryValues;
        if (v == null || v.Count == 0) return 0;
        return v[Math.Clamp(index, 0, v.Count - 1)];
    }

    private string FormatValue(double value) =>
        Math.Abs(value) >= 1000
            ? (value / 1000d).ToString("0.#", CultureInfo.InvariantCulture) + "k" + ValueSuffix
            : value.ToString("0.##", CultureInfo.InvariantCulture) + ValueSuffix;

    private string FormatTick(double value, double step) => step >= 1
        ? value.ToString("0", CultureInfo.InvariantCulture)
        : value.ToString("0.##", CultureInfo.InvariantCulture);

    private void ClearHover() => hoverIndex = null;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // Horizontal position: viewBox units out of ViewWidth across the full container width.
    private static string PctX(double x) => (x / ViewWidth * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    // Vertical position: distance from the bottom of the viewBox, as a share of container height.
    private static string PctY(double yFromBottom) => (yFromBottom / ViewHeight * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}
