@using CommunityLink.Shared.Features.Authentication
@using CommunityLink.App.Apis
@using CommunityLink.App.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using System.Threading
@implements IDisposable
@rendermode InteractiveServer
@inject AuthenticationApiService AuthApi

<div class="fixed inset-0 z-50 flex items-center justify-center bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm p-4">
    <div class="w-full max-w-md space-y-6 rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#112A46] p-7 shadow-xl relative">

        <button type="button" @onclick="OnClose" aria-label="Close"
                class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded text-[#64748B] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
            ✕
        </button>

        <div>
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] text-lg">🔐</span>
                <div>
                    <h3 class="text-lg font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Reset Password @(IsAdmin ? "(Admin)" : "")</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] font-mono mt-0.5">
                        @if (step == 1) { <span>STEP 1 OF 3: ENTER ACCOUNT EMAIL FOR OTP</span> }
                        else if (step == 2) { <span>STEP 2 OF 3: ENTER 6-DIGIT VERIFICATION CODE</span> }
                        else { <span>STEP 3 OF 3: CONFIGURE NEW PASSWORD</span> }
                    </p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="@AuthClasses.ErrorAlert">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="@AuthClasses.SuccessAlert">@successMessage</div>
        }

        @if (step == 1)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Email address</label>
                    <input type="email" @bind="email" required placeholder="you@example.com" class="@AuthClasses.Input" />
                </div>
                <button type="button" disabled="@isSubmitting" @onclick="SendOtp"
                        class="@(IsAdmin ? AuthClasses.PrimaryButtonAdmin : AuthClasses.PrimaryButton)">
                    @if (isSubmitting) { <span>Sending OTP...</span> } else { <span>Send 6-Digit OTP</span> }
                </button>
            </div>
        }
        else if (step == 2)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Enter 6-Digit OTP</label>
                    <div class="flex items-center gap-2" role="group" aria-label="Enter the 6-digit verification code">
                        @for (var i = 0; i < 6; i++)
                        {
                            var index = i;
                            <input type="text"
                                   value="@otpBoxes[index]"
                                   @ref="otpBoxRefs[index]"
                                   @oninput="e => HandleOtpInput(index, e)"
                                   @onkeydown="e => HandleOtpKeyDown(index, e)"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="1"
                                   aria-label="Digit @(index + 1) of 6"
                                   disabled="@isSubmitting"
                                   class="h-12 w-full min-w-0 flex-1 rounded border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#0A1B2E] text-center text-lg font-semibold text-[#0A1B2E] dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition-colors" />
                        }
                    </div>
                </div>

                <div class="flex items-center justify-between rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F1F5F9] dark:bg-[#0A1B2E] px-4 py-3 text-xs">
                    <div class="flex items-center gap-1.5 font-mono">
                        <span class="animate-pulse">⏱️</span>
                        <span class="font-medium text-[#557392] dark:text-[#C4D2E1]">OTP EXPIRATION:</span>
                    </div>
                    <div class="font-mono text-sm font-bold @(secondsRemaining <= 10 ? "text-red-600 dark:text-rose-400 animate-pulse" : "text-[#0A1B2E] dark:text-[#E1E8F0]")">
                        @FormattedTime
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" disabled="@isSubmitting" @onclick="VerifyOtp"
                            class="@(IsAdmin ? AuthClasses.PrimaryButtonAdmin : AuthClasses.PrimaryButton) flex-1">
                        Verify OTP
                    </button>
                    <button type="button" disabled="@(!canResend || isSubmitting)" @onclick="SendOtp"
                            class="px-4 py-2.5 rounded border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-white dark:bg-[#112A46] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] disabled:opacity-40 transition cursor-pointer">
                        Resend OTP
                    </button>
                </div>
            </div>
        }
        else if (step == 3)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">New Password</label>
                    <div class="relative">
                        <input type="password" @bind="newPassword" placeholder="At least 8 characters" class="@AuthClasses.Input pr-12" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle new password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Confirm New Password</label>
                    <div class="relative">
                        <input type="password" @bind="confirmNewPassword" placeholder="Re-enter your password" class="@AuthClasses.Input pr-12" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle confirm new password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <button type="button" disabled="@isSubmitting" @onclick="ResetPassword"
                        class="w-full flex items-center justify-center gap-2 rounded bg-[#0A1B2E] dark:bg-[#E1E8F0] px-4 py-2.5 text-sm font-semibold text-white dark:text-[#0A1B2E] shadow-sm hover:bg-[#112A46] dark:hover:bg-white focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 disabled:opacity-60 transition cursor-pointer">
                    @if (isSubmitting) { <span>Resetting Password...</span> } else { <span>Set New Password</span> }
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int step = 1;
    private string email = "";
    private string otpCode = "";
    private string newPassword = "";
    private string confirmNewPassword = "";

    private readonly string[] otpBoxes = new string[6];
    private readonly ElementReference[] otpBoxRefs = new ElementReference[6];
    private bool focusOtpOnNextRender;

    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;

    private System.Threading.Timer? timer;
    private int secondsRemaining = 60;
    private bool canResend;

    private string FormattedTime => $"{secondsRemaining / 60:D2}:{secondsRemaining % 60:D2}";

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.SendPasswordResetOtpAsync(new SendOtpRequestModel(email, IsAdmin));
        if (result.IsSuccess)
        {
            successMessage = "We sent a 6-digit code to your email. It expires in 1 minute.";
            ClearOtpBoxes();
            step = 2;
            StartCountdownTimer();
            focusOtpOnNextRender = true;
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOtpOnNextRender)
        {
            focusOtpOnNextRender = false;
            var emptyIndex = Array.FindIndex(otpBoxes, d => d.Length == 0);
            await FocusBoxAsync(emptyIndex < 0 ? 0 : emptyIndex);
        }
    }

    private void StartCountdownTimer()
    {
        timer?.Dispose();
        secondsRemaining = 60;
        canResend = false;

        timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (secondsRemaining > 0)
                {
                    secondsRemaining--;
                }
                else
                {
                    canResend = true;
                    errorMessage = "OTP timer expired. Please click 'Resend OTP'.";
                    timer?.Dispose();
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private async Task VerifyOtp()
    {
        if (otpCode.Length != 6)
        {
            errorMessage = "Please enter the 6-digit OTP code.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.VerifyPasswordResetOtpAsync(new VerifyOtpRequestModel(otpCode));
        if (result.IsSuccess)
        {
            successMessage = "OTP verified successfully! Set your new password below.";
            step = 3;
            timer?.Dispose();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            errorMessage = "Password fields are required.";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.ResetPasswordAsync(new ResetPasswordRequestModel(
            otpCode, newPassword));

        if (result.IsSuccess)
        {
            successMessage = "Password reset successfully! Redirecting to sign in...";
            await Task.Delay(1500);
            await OnClose.InvokeAsync();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    private void SyncOtpCode()
    {
        otpCode = string.Concat(otpBoxes);
    }

    private void ClearOtpBoxes()
    {
        for (var i = 0; i < otpBoxes.Length; i++)
        {
            otpBoxes[i] = string.Empty;
        }
        SyncOtpCode();
    }

    private async Task HandleOtpInput(int index, ChangeEventArgs args)
    {
        var raw = args?.Value?.ToString() ?? string.Empty;

        if (raw.Length == 0)
        {
            if (otpBoxes[index].Length > 0)
            {
                otpBoxes[index] = string.Empty;
                SyncOtpCode();
            }
            return;
        }

        var digits = raw.Where(char.IsDigit).ToArray();
        if (digits.Length == 0) return;

        var position = index;
        foreach (var ch in digits)
        {
            if (position >= otpBoxes.Length) break;
            otpBoxes[position] = ch.ToString();
            position++;
        }
        SyncOtpCode();

        if (position < otpBoxes.Length)
            await FocusBoxAsync(position);
    }

    private async Task HandleOtpKeyDown(int index, KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Backspace":
                if (otpBoxes[index].Length == 0 && index > 0)
                    await FocusBoxAsync(index - 1);
                break;
            case "ArrowLeft" when index > 0:
                await FocusBoxAsync(index - 1);
                break;
            case "ArrowRight" when index < otpBoxes.Length - 1:
                await FocusBoxAsync(index + 1);
                break;
        }
    }

    private async Task FocusBoxAsync(int index)
    {
        if (index < 0 || index >= otpBoxRefs.Length) return;
        await otpBoxRefs[index].FocusAsync();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}