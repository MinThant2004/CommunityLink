@using CommunityLink.Shared.Features.Authentication
@using CommunityLink.App.Apis
@using CommunityLink.App.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using System.Threading
@implements IDisposable
@rendermode InteractiveServer
@inject AuthenticationApiService AuthApi

<div class="fixed inset-0 z-50 flex items-center justify-center bg-[#0A1B2E]/60 dark:bg-black/80 backdrop-blur-sm p-4 animate-fade-in">
    <div class="w-full max-w-lg space-y-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#112A46] p-7 sm:p-8 shadow-2xl relative">

        <button type="button" @onclick="OnClose" aria-label="Close"
                class="absolute top-5 right-5 flex h-8 w-8 items-center justify-center rounded-lg text-[#64748B] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <!-- Header with meaningful SVG Icon and Step Indicator -->
        <div class="border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-4">
            <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                            Account Security &bull; Reset Password
                        </h3>
                        @if (IsAdmin)
                        {
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">ADMIN</span>
                        }
                    </div>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] font-mono">
                            STEP @step OF 3
                        </span>
                        <span class="text-xs text-[#557392] dark:text-[#C4D2E1]">
                            @if (step == 1) { <span>Enter verified email address</span> }
                            else if (step == 2) { <span>Verify 6-digit one-time code</span> }
                            else { <span>Create and configure new password</span> }
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="@AuthClasses.ErrorAlert">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="@AuthClasses.SuccessAlert">@successMessage</div>
        }

        @if (step == 1)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Account Email Address</label>
                    <input type="email" @bind="email" required placeholder="you@example.com" class="@AuthClasses.Input" />
                    <p class="text-[11px] text-[#557392] dark:text-[#C4D2E1]">We will send a single-use 6-digit verification code to this address.</p>
                </div>
                <button type="button" disabled="@isSubmitting" @onclick="SendOtp"
                        class="@(IsAdmin ? AuthClasses.PrimaryButtonAdmin : AuthClasses.PrimaryButton)">
                    @if (isSubmitting) { <span>Sending OTP...</span> } else { <span>Send Verification Code &rarr;</span> }
                </button>
            </div>
        }
        else if (step == 2)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Enter 6-Digit OTP</label>
                    <div class="flex items-center gap-2" role="group" aria-label="Enter the 6-digit verification code">
                        @for (var i = 0; i < 6; i++)
                        {
                            var index = i;
                            <input type="text"
                                   value="@otpBoxes[index]"
                                   @ref="otpBoxRefs[index]"
                                   @oninput="e => HandleOtpInput(index, e)"
                                   @onkeydown="e => HandleOtpKeyDown(index, e)"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="1"
                                   aria-label="Digit @(index + 1) of 6"
                                   disabled="@isSubmitting"
                                   class="h-12 w-full min-w-0 flex-1 rounded-lg border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#0A1B2E] text-center text-lg font-bold text-[#0A1B2E] dark:text-white shadow-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/20 dark:focus:ring-indigo-400/20 focus:border-indigo-600 transition-colors" />
                        }
                    </div>
                </div>

                <div class="flex items-center justify-between rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] px-4 py-3 text-xs">
                    <div class="flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 animate-pulse text-[#557392] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="font-medium text-[#557392] dark:text-[#C4D2E1]">OTP EXPIRATION:</span>
                    </div>
                    <div class="font-mono text-sm font-bold @(secondsRemaining <= 10 ? "text-red-600 dark:text-rose-400 animate-pulse" : "text-[#0A1B2E] dark:text-[#E1E8F0]")">
                        @FormattedTime
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" disabled="@isSubmitting" @onclick="VerifyOtp"
                            class="@(IsAdmin ? AuthClasses.PrimaryButtonAdmin : AuthClasses.PrimaryButton) flex-1">
                        Verify Code
                    </button>
                    <button type="button" disabled="@(!canResend || isSubmitting)" @onclick="SendOtp"
                            class="px-4 py-2.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-white dark:bg-[#112A46] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] disabled:opacity-40 transition cursor-pointer">
                        Resend OTP
                    </button>
                </div>
            </div>
        }
        else if (step == 3)
        {
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">New Password</label>
                    <div class="relative">
                        <input type="password" @bind="newPassword" autocomplete="new-password" placeholder="At least 8 characters" class="@AuthClasses.Input pr-12" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer" aria-label="Toggle new password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="@AuthClasses.Label">Confirm New Password</label>
                    <div class="relative">
                        <input type="password" @bind="confirmNewPassword" autocomplete="new-password" placeholder="Re-enter your new password" class="@AuthClasses.Input pr-12" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer" aria-label="Toggle confirm new password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <!-- Password Policy Requirement Hint -->
                <p class="text-[11px] text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5 pt-0.5">
                    <svg class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Use at least 8 characters with uppercase, lowercase, number &amp; symbol.</span>
                </p>

                <button type="button" disabled="@isSubmitting" @onclick="ResetPassword"
                        class="w-full flex items-center justify-center gap-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm disabled:opacity-60 transition cursor-pointer">
                    @if (isSubmitting) { <span>Resetting Password...</span> } else { <span>Set New Password &rarr;</span> }
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int step = 1;
    private string email = "";
    private string otpCode = "";
    private string newPassword = "";
    private string confirmNewPassword = "";

    private readonly string[] otpBoxes = new string[6];
    private readonly ElementReference[] otpBoxRefs = new ElementReference[6];
    private bool focusOtpOnNextRender;

    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;

    private System.Threading.Timer? timer;
    private int secondsRemaining = 60;
    private bool canResend;

    private string FormattedTime => $"{secondsRemaining / 60:D2}:{secondsRemaining % 60:D2}";

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.SendPasswordResetOtpAsync(new SendOtpRequestModel(email, IsAdmin));
        if (result.IsSuccess)
        {
            successMessage = "We sent a 6-digit code to your email. It expires in 1 minute.";
            ClearOtpBoxes();
            step = 2;
            StartCountdownTimer();
            focusOtpOnNextRender = true;
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOtpOnNextRender)
        {
            focusOtpOnNextRender = false;
            var emptyIndex = Array.FindIndex(otpBoxes, d => d.Length == 0);
            await FocusBoxAsync(emptyIndex < 0 ? 0 : emptyIndex);
        }
    }

    private void StartCountdownTimer()
    {
        timer?.Dispose();
        secondsRemaining = 60;
        canResend = false;

        timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (secondsRemaining > 0)
                {
                    secondsRemaining--;
                }
                else
                {
                    canResend = true;
                    errorMessage = "OTP timer expired. Please click 'Resend OTP'.";
                    timer?.Dispose();
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private async Task VerifyOtp()
    {
        if (otpCode.Length != 6)
        {
            errorMessage = "Please enter the 6-digit OTP code.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.VerifyPasswordResetOtpAsync(new VerifyOtpRequestModel(otpCode));
        if (result.IsSuccess)
        {
            successMessage = "OTP verified successfully! Set your new password below.";
            newPassword = "";
            confirmNewPassword = "";
            step = 3;
            timer?.Dispose();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmNewPassword))
        {
            errorMessage = "Password fields are required.";
            return;
        }

        if (newPassword.Length < 8)
        {
            errorMessage = "Password must be at least 8 characters long.";
            return;
        }

        if (!newPassword.Any(char.IsUpper))
        {
            errorMessage = "Password must contain at least one uppercase letter (A-Z).";
            return;
        }

        if (!newPassword.Any(char.IsLower))
        {
            errorMessage = "Password must contain at least one lowercase letter (a-z).";
            return;
        }

        if (!newPassword.Any(char.IsDigit))
        {
            errorMessage = "Password must contain at least one number (0-9).";
            return;
        }

        if (!newPassword.Any(ch => !char.IsLetterOrDigit(ch)))
        {
            errorMessage = "Password must contain at least one special character (e.g. !@#$%^&*).";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthApi.ResetPasswordAsync(new ResetPasswordRequestModel(
            otpCode, newPassword));

        if (result.IsSuccess)
        {
            successMessage = "Password reset successfully! Redirecting to sign in...";
            await Task.Delay(1500);
            await OnClose.InvokeAsync();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    private void SyncOtpCode()
    {
        otpCode = string.Concat(otpBoxes);
    }

    private void ClearOtpBoxes()
    {
        for (var i = 0; i < otpBoxes.Length; i++)
        {
            otpBoxes[i] = string.Empty;
        }
        SyncOtpCode();
    }

    private async Task HandleOtpInput(int index, ChangeEventArgs args)
    {
        var raw = args?.Value?.ToString() ?? string.Empty;

        if (raw.Length == 0)
        {
            if (otpBoxes[index].Length > 0)
            {
                otpBoxes[index] = string.Empty;
                SyncOtpCode();
            }
            return;
        }

        var digits = raw.Where(char.IsDigit).ToArray();
        if (digits.Length == 0) return;

        var position = index;
        foreach (var ch in digits)
        {
            if (position >= otpBoxes.Length) break;
            otpBoxes[position] = ch.ToString();
            position++;
        }
        SyncOtpCode();

        if (position < otpBoxes.Length)
            await FocusBoxAsync(position);
    }

    private async Task HandleOtpKeyDown(int index, KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Backspace":
                if (otpBoxes[index].Length == 0 && index > 0)
                    await FocusBoxAsync(index - 1);
                break;
            case "ArrowLeft" when index > 0:
                await FocusBoxAsync(index - 1);
                break;
            case "ArrowRight" when index < otpBoxes.Length - 1:
                await FocusBoxAsync(index + 1);
                break;
        }
    }

    private async Task FocusBoxAsync(int index)
    {
        if (index < 0 || index >= otpBoxRefs.Length) return;
        await otpBoxRefs[index].FocusAsync();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}