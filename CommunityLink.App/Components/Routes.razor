@using CommunityLink.App.Components.Shared
@using CommunityLink.App.Components.Pages

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <AccessDenied />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <div class="flex items-center justify-center min-h-[50vh] text-slate-500 text-sm">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-700 dark:border-slate-300 border-t-transparent mr-3"></div>
                    <span>Checking authorization...</span>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
