@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@inject GroupApiService GroupApi
@inject CommunityApiService CommunityApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment

<PageTitle>Community Groups - CommunityLink</PageTitle>

<div class="max-w-6xl mx-auto py-6 px-4 sm:px-6 space-y-6">
    <!-- Top Header Banner -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center text-white text-2xl font-bold shadow-md shadow-indigo-500/20">
                    👥
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Community Groups</h1>
                    <p class="text-xs sm:text-sm text-slate-500">Discover focused sub-groups, join conversations, or launch your own room.</p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" @onclick="OpenCreateGroupModal"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-full shadow hover:shadow-md transition-all active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Create Group</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <!-- Sub-Community Filter Dropdown -->
        <div class="flex items-center gap-2 flex-1 max-w-xs">
            <span class="text-xs font-semibold text-slate-500 shrink-0">Filter:</span>
            <select class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    value="@selectedSubCommunityFilter"
                    @onchange="OnSubCommunityFilterChanged">
                <option value="0">All Sub-Communities</option>
                @foreach (var sc in subCommunities)
                {
                    <option value="@sc.CommunityId">📁 @sc.Name</option>
                }
            </select>
        </div>

        <!-- Search Input -->
        <div class="relative flex-1 max-w-sm">
            <input type="text" @bind="searchTerm" @bind:after="OnSearchInputChanged"
                   placeholder="Search groups by name or topic..."
                   class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
    </div>

    <!-- Groups Grid Listing -->
    @if (isLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (groups == null || groups.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500">
            <div class="text-4xl mb-3">🏔️</div>
            <h3 class="text-base font-semibold text-slate-800">No groups found</h3>
            <p class="text-sm mt-1">Be the first to create a group under your sub-community!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var grp in groups)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition-all duration-200 hover:shadow-md hover:border-slate-300 flex flex-col justify-between">
                    <!-- Group Header & Info -->
                    <div>
                        <!-- Top Banner / Avatar Bar -->
                        <div class="h-20 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 relative p-3">
                            <div class="absolute -bottom-4 left-4">
                                @if (!string.IsNullOrEmpty(grp.AvatarUrl))
                                {
                                    <img src="@grp.AvatarUrl" alt="@grp.Name" class="w-12 h-12 rounded-xl object-cover border-2 border-white shadow-md bg-white" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-xl bg-white border-2 border-white shadow-md flex items-center justify-center font-bold text-indigo-700 text-base">
                                        @(string.IsNullOrWhiteSpace(grp.Name) ? "G" : grp.Name.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>
                            <div class="flex justify-end">
                                @if (grp.Visibility == "PRIVATE")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/90 text-white shadow-sm backdrop-blur-xs">
                                        🔒 Private Group
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/90 text-white shadow-sm backdrop-blur-xs">
                                        🔓 Public Group
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 pt-6 space-y-2">
                            <div>
                                <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition">
                                    <a href="/group/@grp.GroupId">@grp.Name</a>
                                </h3>
                                @if (!string.IsNullOrEmpty(grp.SubCommunityName))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-indigo-50 text-indigo-700 border border-indigo-100 mt-1">
                                        📁 @grp.SubCommunityName
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(grp.Description))
                            {
                                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">@grp.Description</p>
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic">No description provided.</p>
                            }
                        </div>
                    </div>

                    <!-- Card Footer: Stats & Action Button -->
                    <div class="p-4 border-t border-slate-100 bg-slate-50/50 space-y-3">
                        <div class="flex items-center justify-between text-xs text-slate-500 font-medium">
                            <div class="flex items-center gap-3">
                                <span>👥 @grp.MemberCount members</span>
                                <span>•</span>
                                <span>📝 @grp.PostCount posts</span>
                            </div>
                            <span class="text-[11px] text-slate-400">By @grp.CreatorName</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <a href="/group/@grp.GroupId"
                               class="flex-1 text-center py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">
                                View Group
                            </a>

                            @if (grp.IsJoined)
                            {
                                <span class="px-3 py-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-xl inline-flex items-center gap-1 shrink-0">
                                    ✓ Joined
                                </span>
                            }
                            else if (grp.UserJoinStatus == "PENDING")
                            {
                                <span class="px-3 py-2 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-semibold rounded-xl inline-flex items-center gap-1 shrink-0">
                                    ⏳ Pending
                                </span>
                            }
                            else
                            {
                                <button type="button" @onclick="() => JoinGroup(grp)"
                                        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition shadow-sm shrink-0">
                                    @(grp.Visibility == "PRIVATE" ? "Request Join" : "Join Direct")
                                </button>
                            }

                            @if (currentUserId.HasValue && grp.CreatorId == currentUserId.Value)
                            {
                                <button type="button" @onclick="() => OpenRequestsDrawer(grp.GroupId)"
                                        title="Manage Join Requests"
                                        class="p-2 bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 rounded-xl text-xs font-semibold transition shrink-0">
                                    📩 Requests
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE GROUP MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">👥</span>
                    <h3 class="font-bold text-slate-900">Create New Group</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <!-- Parent Sub-Community Dropdown -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Select Sub-Community <span class="text-red-500">*</span></label>
                    <select class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                            value="@createSubCommunityId"
                            @onchange="OnCreateSubCommunityChanged">
                        <option value="0">-- Select Sub-Community --</option>
                        @foreach (var sc in subCommunities)
                        {
                            <option value="@sc.CommunityId">📁 @sc.Name</option>
                        }
                    </select>

                    @if (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember)
                    {
                        <div class="mt-2 p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 flex items-start gap-2">
                            <span>⚠️</span>
                            <span>You must join <strong>@selectedSubCommunityName</strong> first before creating a group inside it.</span>
                        </div>
                    }
                </div>

                <!-- Group Name -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Group Name <span class="text-red-500">*</span></label>
                    <input type="text" @bind="createGroupName" placeholder="e.g. EF Core Developers Room"
                           class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium" />
                </div>

                <!-- Group Description -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Description <span class="text-slate-400 font-normal">(Optional)</span></label>
                    <textarea @bind="createGroupDescription" rows="3" placeholder="Briefly describe the purpose of this group room..."
                              class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl p-3 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                </div>

                <!-- Privacy & Access Type -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-2">Privacy & Access Control <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex flex-col p-3 rounded-xl border cursor-pointer transition @(createVisibility == "PUBLIC" ? "border-indigo-600 bg-indigo-50/50 ring-2 ring-indigo-500/20" : "border-slate-200 bg-slate-50")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PUBLIC" checked="@(createVisibility == "PUBLIC")" @onchange='() => createVisibility = "PUBLIC"' class="text-indigo-600 focus:ring-indigo-500" />
                                <span class="text-xs font-bold text-slate-900">🔓 Public Group</span>
                            </div>
                            <span class="text-[11px] text-slate-500 mt-1 pl-5">Anyone can join directly without approval.</span>
                        </label>

                        <label class="flex flex-col p-3 rounded-xl border cursor-pointer transition @(createVisibility == "PRIVATE" ? "border-amber-600 bg-amber-50/50 ring-2 ring-amber-500/20" : "border-slate-200 bg-slate-50")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PRIVATE" checked="@(createVisibility == "PRIVATE")" @onchange='() => createVisibility = "PRIVATE"' class="text-amber-600 focus:ring-amber-500" />
                                <span class="text-xs font-bold text-slate-900">🔒 Private Group</span>
                            </div>
                            <span class="text-[11px] text-slate-500 mt-1 pl-5">Requires owner approval to join.</span>
                        </label>
                    </div>
                </div>

                <!-- Group Avatar Image Upload (Computer file picker) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Group Avatar Image</label>
                    <InputFile OnChange="HandleGroupAvatarSelected" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" />

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 text-xs text-indigo-600 flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> Uploading avatar image...
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(createAvatarUrl))
                    {
                        <div class="mt-3 relative rounded-xl overflow-hidden border border-slate-200 w-24 h-24 bg-slate-100 flex items-center justify-center">
                            <img src="@createAvatarUrl" alt="Avatar Preview" class="w-full h-full object-cover" />
                            <button type="button" @onclick="RemoveGroupAvatar"
                                    class="absolute top-1 right-1 bg-red-600 text-white rounded-full p-1 shadow hover:bg-red-700 transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800 font-medium rounded-xl hover:bg-slate-200/60 transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitCreateGroup" disabled="@(isSubmitting || (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember))"
                        class="px-5 py-2 text-sm bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Publish Group</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= PENDING REQUESTS DRAWER ================= -->
@if (showRequestsDrawer)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📩</span>
                    <h3 class="font-bold text-slate-900">Pending Join Requests</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-5 space-y-3 max-h-[60vh] overflow-y-auto">
                @if (pendingRequests == null || pendingRequests.Count == 0)
                {
                    <p class="text-xs text-slate-400 text-center py-6">No pending join requests for this group.</p>
                }
                else
                {
                    @foreach (var req in pendingRequests)
                    {
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-semibold text-slate-900">@req.UserName</span>
                                <span class="text-[10px] text-slate-400">@req.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <p class="text-xs text-slate-500">@req.UserEmail</p>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNote))
                            {
                                <p class="text-xs text-slate-700 bg-white p-2 rounded-lg border border-slate-200 italic">"@req.RequestNote"</p>
                            }
                            <div class="flex items-center justify-end gap-2 pt-1">
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, false)"
                                        class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold rounded-lg transition">
                                    Reject
                                </button>
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, true)"
                                        class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-xs">
                                    Approve
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 text-right">
                <button type="button" @onclick="CloseModals" class="px-4 py-1.5 text-xs text-slate-600 font-semibold rounded-lg bg-slate-200 hover:bg-slate-300 transition">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<GroupModel>? groups;
    private List<CommunityModel> subCommunities = [];
    private List<CommunityModel> joinedCommunities = [];
    private IReadOnlyList<GroupJoinRequestModel>? pendingRequests;

    private int? currentUserId;
    private bool isAdmin;
    private bool isLoading = true;
    private bool isSubmitting;
    private int selectedSubCommunityFilter = 0;
    private string searchTerm = "";

    // Create Modal State
    private bool showCreateModal;
    private int createSubCommunityId;
    private string createGroupName = "";
    private string createGroupDescription = "";
    private string createVisibility = "PUBLIC";
    private string? createAvatarUrl;
    private bool isUploadingImage;
    private bool isUserSubCommunityMember;
    private string selectedSubCommunityName = "";

    // Requests Drawer State
    private bool showRequestsDrawer;
    private int managingGroupId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);

        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        await Task.WhenAll(LoadSubCommunities(), LoadGroups());
    }

    private async Task LoadSubCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            // Sub-communities have ParentCommunityId != null
            subCommunities = res.Data.Where(c => c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private async Task LoadGroups()
    {
        isLoading = true;
        var res = await GroupApi.GetGroupsAsync(selectedSubCommunityFilter > 0 ? selectedSubCommunityFilter : null, searchTerm);
        if (res.IsSuccess)
        {
            groups = res.Data;
        }
        isLoading = false;
    }

    private async Task OnSubCommunityFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            selectedSubCommunityFilter = subId;
            await LoadGroups();
        }
    }

    private async Task OnSearchInputChanged()
    {
        await LoadGroups();
    }

    private async Task JoinGroup(GroupModel grp)
    {
        var res = await GroupApi.JoinGroupAsync(grp.GroupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined group!");
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join group.");
        }
    }

    private async Task OpenCreateGroupModal()
    {
        createGroupName = "";
        createGroupDescription = "";
        createVisibility = "PUBLIC";
        createAvatarUrl = null;
        createSubCommunityId = subCommunities.FirstOrDefault()?.CommunityId ?? 0;
        await CheckSubCommunityMembership(createSubCommunityId);
        showCreateModal = true;
    }

    private async Task OnCreateSubCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            createSubCommunityId = subId;
            await CheckSubCommunityMembership(subId);
        }
    }

    private async Task CheckSubCommunityMembership(int subCommunityId)
    {
        if (subCommunityId <= 0)
        {
            isUserSubCommunityMember = false;
            selectedSubCommunityName = "";
            return;
        }

        var sc = subCommunities.FirstOrDefault(c => c.CommunityId == subCommunityId);
        selectedSubCommunityName = sc?.Name ?? "";

        if (isAdmin)
        {
            isUserSubCommunityMember = true;
            return;
        }

        // Check if user joined this sub-community by requesting community detail
        var res = await CommunityApi.GetCommunityByIdAsync(subCommunityId);
        if (res.IsSuccess && res.Data != null)
        {
            // If current user is in joined communities list
            if (currentUserId.HasValue)
            {
                var joinedRes = await CommunityApi.GetCommunitiesAsync(); // fallback check
                isUserSubCommunityMember = joinedRes.Data != null && joinedRes.Data.Any(c => c.CommunityId == subCommunityId);
            }
        }
    }

    private async Task SubmitCreateGroup()
    {
        if (createSubCommunityId == 0)
        {
            Toast.Warning("Please select a parent sub-community.");
            return;
        }

        if (string.IsNullOrWhiteSpace(createGroupName))
        {
            Toast.Warning("Group name is required.");
            return;
        }

        if (!isAdmin && !isUserSubCommunityMember)
        {
            Toast.Warning($"You must join sub-community '{selectedSubCommunityName}' before creating a group in it.");
            return;
        }

        isSubmitting = true;
        var req = new CreateGroupRequestModel(
            createSubCommunityId,
            createGroupName,
            createGroupDescription,
            createAvatarUrl,
            null,
            createVisibility,
            createVisibility == "PRIVATE" ? "APPROVAL_REQUIRED" : "INSTANT"
        );

        var res = await GroupApi.CreateGroupAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group created successfully!");
            CloseModals();
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create group.");
        }
    }

    private async Task OpenRequestsDrawer(int groupId)
    {
        managingGroupId = groupId;
        var res = await GroupApi.GetGroupJoinRequestsAsync(groupId);
        if (res.IsSuccess)
        {
            pendingRequests = res.Data;
            showRequestsDrawer = true;
        }
        else
        {
            Toast.Error("Failed to load join requests.");
        }
    }

    private async Task ReviewRequest(int requestId, bool approve)
    {
        var res = approve ? await GroupApi.ApproveJoinRequestAsync(requestId) : await GroupApi.RejectJoinRequestAsync(requestId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Updated!");
            await OpenRequestsDrawer(managingGroupId);
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to review request.");
        }
    }

    private async Task HandleGroupAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"group_{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            createAvatarUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Group avatar uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to upload avatar: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveGroupAvatar()
    {
        createAvatarUrl = null;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showRequestsDrawer = false;
    }
}
