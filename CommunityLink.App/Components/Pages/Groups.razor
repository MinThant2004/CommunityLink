@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@inject GroupApiService GroupApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment
@inject RoleAndPermissionApiService RoleApi

<PageTitle>Groups — CommunityLink</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <div>
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Groups</h1>
                <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-0.5">Join focused rooms inside sub-communities, or launch your own.</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Search Input -->
            <div class="relative min-w-[220px]">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#7A8CA6]">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </span>
                <input type="text"
                       class="w-full pl-8 pr-7 py-1.5 text-xs rounded bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15 focus:border-[#4F46E5] transition"
                       placeholder="Search groups..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       @bind:after="LoadGroupsAsync" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button type="button" @onclick="ClearSearch" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                }
            </div>

            @if (canCreateGroup)
            {
                <button type="button" @onclick="OpenCreateGroupModal"
                        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded text-xs font-semibold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white border border-[#0A1B2E] dark:border-[#E1E8F0] transition cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    <span>Create Group</span>
                </button>
            }
        </div>
    </div>

    <!-- Joined / Browse Tabs -->
    <div class="inline-flex items-center gap-0.5 p-1 rounded bg-[#F1F5F9] dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
        <button type="button" @onclick='() => SetTab("joined")'
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold transition @(activeTab == "joined" ? "bg-[#0A1B2E] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span>Joined</span>
            <span class="px-1.5 py-0.5 rounded font-mono text-[10px] font-bold @(activeTab == "joined" ? "bg-white/20 dark:bg-[#0A1B2E]/10" : "bg-[#E2E8F0] dark:bg-[#1B3B5A]")">@joinedCount</span>
        </button>
        <button type="button" @onclick='() => SetTab("browse")'
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold transition @(activeTab == "browse" ? "bg-[#0A1B2E] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <span>Browse</span>
            <span class="px-1.5 py-0.5 rounded font-mono text-[10px] font-bold @(activeTab == "browse" ? "bg-white/20 dark:bg-[#0A1B2E]/10" : "bg-[#E2E8F0] dark:bg-[#1B3B5A]")">@browseCount</span>
        </button>
    </div>

    <!-- Group Cards -->
    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-3 font-medium">Loading groups...</p>
        </div>
    }
    else if (ActiveGroups.Count == 0)
    {
        <div class="text-center py-16 bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)]">
            <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center mx-auto mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            @if (activeTab == "joined")
            {
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">You have not joined any groups yet</h3>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1 max-w-sm mx-auto">Browse the current room listings and join one to get started.</p>
                <button type="button" @onclick='() => SetTab("browse")' class="mt-4 inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition">
                    Browse Groups
                </button>
            }
            else
            {
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Nothing here to browse</h3>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1 max-w-sm mx-auto">All groups are currently in view, or none match your search.</p>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var grp in ActiveGroups)
            {
                var isCreator = currentUserId.HasValue && grp.CreatorId == currentUserId.Value;
                var photoUrl = GetGroupPhoto(grp);

                <div class="bg-white dark:bg-[#0A1B2E] rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.14)] hover:border-[#CBD5E1] dark:hover:border-[#D4AF37]/40 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                    <div>
                        <!-- 1. Cinematic Banner Container -->
                        <div class="relative h-44 sm:h-48 w-full overflow-hidden bg-[#071321]">
                            <img src="@photoUrl"
                                 alt="@grp.Name"
                                 class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out" />

                            <!-- Dark Gradient Scrim Overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0A1B2E] via-[#0A1B2E]/60 to-transparent"></div>

                            <!-- Top Pills on Banner -->
                            <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                                <span class="px-2.5 py-0.5 rounded text-[10px] font-bold tracking-wider uppercase bg-black/60 backdrop-blur-md text-[#D4AF37] border border-[#D4AF37]/30 shadow-sm truncate max-w-[65%]">
                                    @(string.IsNullOrWhiteSpace(grp.SubCommunityName) ? "WORKING GROUP" : grp.SubCommunityName)
                                </span>

                                @if (grp.Visibility == "PRIVATE")
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wider uppercase bg-amber-950/80 backdrop-blur-md text-amber-300 border border-amber-700/50 shadow-sm">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                        Private
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wider uppercase bg-emerald-950/80 backdrop-blur-md text-emerald-300 border border-emerald-700/50 shadow-sm">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Public
                                    </span>
                                }
                            </div>

                            <!-- Bottom Header Over Banner (Title & Avatar) -->
                            <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <span class="block text-[10px] font-bold uppercase tracking-wider text-amber-300/90 font-mono drop-shadow">
                                        WORKING GROUP ROOM
                                    </span>
                                    <a href="/group/@grp.GroupId" class="text-base sm:text-lg font-black text-white tracking-tight leading-snug drop-shadow hover:underline block truncate" style="font-family:'Manrope',sans-serif">
                                        @grp.Name
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(grp.AvatarUrl) && grp.AvatarUrl != grp.BannerUrl)
                                {
                                    <img src="@grp.AvatarUrl" alt="@grp.Name" class="w-7 h-7 rounded-lg border-2 border-[#0A1B2E] object-cover ring-1 ring-white/10 shrink-0" />
                                }
                                else
                                {
                                    <div class="w-7 h-7 rounded-lg border-2 border-[#0A1B2E] bg-slate-800/80 backdrop-blur flex items-center justify-center font-bold text-white text-[11px] shrink-0 font-mono">
                                        @(string.IsNullOrWhiteSpace(grp.Name) ? "G" : grp.Name.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. Card Content Area -->
                        <div class="p-4 space-y-3.5">
                            <!-- Description -->
                            <p class="text-xs text-[#557392] dark:text-[#94A3B8] leading-relaxed line-clamp-2">
                                @(string.IsNullOrWhiteSpace(grp.Description) ? "Active working group for structured collaboration, specialized discussion, and resource syndication." : grp.Description)
                            </p>

                            <!-- 3. Metadata Bar (Under Description) -->
                            <div class="bg-[#F8FAFC] dark:bg-[#071321] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] px-3 py-2 flex items-center justify-between text-[11px] font-mono text-[#0A1B2E] dark:text-[#C4D2E1] flex-wrap gap-1.5">
                                <span class="inline-flex items-center gap-1 font-semibold">
                                    <svg class="w-3.5 h-3.5 text-[#557392] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    @grp.MemberCount.ToString("N0") Members
                                </span>

                                <span class="text-[#CBD5E1] dark:text-[#1E3A5F]">•</span>

                                <span class="inline-flex items-center gap-1 text-[#557392] dark:text-[#C4D2E1] font-medium">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                    @grp.PostCount.ToString("N0") Posts
                                </span>

                                <span class="text-[#CBD5E1] dark:text-[#1E3A5F]">•</span>

                                <span class="inline-flex items-center gap-1 text-amber-500 font-semibold">
                                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                    @(grp.AverageRating.HasValue ? grp.AverageRating.Value.ToString("0.0") : "5.0")
                                </span>
                            </div>

                            <!-- Creator Strip -->
                            <div class="flex items-center justify-between text-[11px] text-[#7A8CA6] font-mono pt-1">
                                <span>Curated by <strong>@grp.CreatorName</strong></span>
                                @if (isCreator)
                                {
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0]">YOU MANAGE</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 4. Dual-Action Footer -->
                    <div class="p-4 pt-0 grid grid-cols-2 gap-2.5 mt-2">
                        <a href="/group/@grp.GroupId"
                           class="w-full px-3 py-2 rounded-lg text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-[#D4AF37] dark:hover:text-[#D4AF37] bg-[#F1F5F9] dark:bg-[#112A46] hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] transition inline-flex items-center justify-center gap-1.5 cursor-pointer">
                            <span>View Room</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>

                        @if (grp.IsJoined)
                        {
                            <div class="flex items-center gap-1.5 w-full">
                                <button type="button" disabled
                                        class="flex-1 px-3 py-2 rounded-lg text-xs font-bold text-[#0A1B2E] bg-[#D4AF37] border border-[#D4AF37] inline-flex items-center justify-center gap-1.5 shadow-sm cursor-default">
                                    <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>
                                    <span>Joined</span>
                                </button>
                                @if (isCreator)
                                {
                                    <button type="button" @onclick="() => OpenRequestsDrawer(grp.GroupId)"
                                            title="Manage join requests"
                                            class="p-2 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] text-[#557392] dark:text-[#C4D2E1] transition cursor-pointer shrink-0">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                    </button>
                                }
                            </div>
                        }
                        else if (grp.UserJoinStatus == "PENDING")
                        {
                            <span class="w-full px-3 py-2 rounded-lg text-xs font-semibold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 inline-flex items-center justify-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span>Pending Approval</span>
                            </span>
                        }
                        else
                        {
                            <button type="button" @onclick="() => JoinGroup(grp)"
                                    class="w-full px-3 py-2 rounded-lg text-xs font-semibold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white border border-[#0A1B2E] dark:border-[#E1E8F0] inline-flex items-center justify-center gap-1.5 transition shadow-sm cursor-pointer">
                                <span>@(grp.JoinPolicy == "APPROVAL_REQUIRED" || grp.Visibility == "PRIVATE" ? "+ Request Join" : "+ Join Room")</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE GROUP MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                    <svg class="w-4 h-4 text-[#557392] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Create New Group
                </h3>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <!-- Parent Sub-Community Dropdown -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Select Sub-Community <span class="text-rose-500">*</span></label>
                    <select class="w-full text-xs bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15 focus:border-[#4F46E5]"
                            value="@createSubCommunityId"
                            @onchange="OnCreateSubCommunityChanged">
                        <option value="0">-- Select Sub-Community --</option>
                        @foreach (var sc in subCommunities)
                        {
                            <option value="@sc.CommunityId">@sc.Name</option>
                        }
                    </select>

                    @if (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember)
                    {
                        <div class="mt-2 p-2.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 rounded text-xs text-amber-700 dark:text-amber-300 flex items-start gap-2">
                            <svg class="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            <span>You must join <strong>@selectedSubCommunityName</strong> first before creating a group inside it.</span>
                        </div>
                    }
                </div>

                <!-- Group Name -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Group Name <span class="text-rose-500">*</span></label>
                    <input type="text" @bind="createGroupName" placeholder="e.g. EF Core Developers Room"
                           class="w-full text-xs bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15 focus:border-[#4F46E5] font-medium" />
                </div>

                <!-- Group Description -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Description <span class="text-[#7A8CA6] font-normal">(Optional)</span></label>
                    <textarea @bind="createGroupDescription" rows="3" placeholder="Briefly describe the purpose of this group room..."
                              class="w-full text-xs bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] rounded p-3 focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15 focus:border-[#4F46E5]"></textarea>
                </div>

                <!-- Privacy & Access Type -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-2">Privacy & Access Control <span class="text-rose-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex flex-col p-3 rounded border cursor-pointer transition @(createVisibility == "PUBLIC" ? "border-[#0A1B2E] dark:border-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] ring-2 ring-[#0A1B2E]/10" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#0A1B2E]")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PUBLIC" checked="@(createVisibility == "PUBLIC")" @onchange='() => createVisibility = "PUBLIC"' class="accent-[#0A1B2E] dark:accent-[#E1E8F0]" />
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    Public Group
                                </span>
                            </div>
                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-1 pl-5">Anyone can join directly without approval.</span>
                        </label>

                        <label class="flex flex-col p-3 rounded border cursor-pointer transition @(createVisibility == "PRIVATE" ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 ring-2 ring-amber-500/20" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#0A1B2E]")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PRIVATE" checked="@(createVisibility == "PRIVATE")" @onchange='() => createVisibility = "PRIVATE"' class="accent-amber-600" />
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Private Group
                                </span>
                            </div>
                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-1 pl-5">Requires owner approval to join.</span>
                        </label>
                    </div>
                </div>

                <!-- Group Photo / Cover Image Upload -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1.5">
                        Group Photo / Cover Image
                    </label>

                    @if (!string.IsNullOrEmpty(createAvatarUrl) || !string.IsNullOrEmpty(createBannerUrl))
                    {
                        var previewImg = createBannerUrl ?? createAvatarUrl;
                        <div class="relative h-32 rounded-lg overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] group">
                            <img src="@previewImg" class="w-full h-full object-cover" alt="Group Preview" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                                <button type="button" @onclick="RemoveGroupAvatar" class="px-2.5 py-1 rounded bg-rose-600 text-white text-xs font-semibold shadow hover:bg-rose-700 transition inline-flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    <span>Remove Photo</span>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] rounded-xl p-4 text-center hover:border-indigo-500 transition">
                            <InputFile OnChange="HandleGroupAvatarSelected" accept=".jpg,.jpeg,.png,.webp" class="hidden" id="groupBannerFileInput" />
                            <label for="groupBannerFileInput" class="cursor-pointer flex flex-col items-center">
                                <svg class="w-7 h-7 text-[#7A8CA6] mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                                <span class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">Upload custom group photo</span>
                                <span class="text-[10px] text-[#7A8CA6] mt-0.5">JPEG, PNG, WebP (Max 10MB)</span>
                            </label>
                        </div>
                    }

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 flex items-center gap-2 text-xs text-indigo-600 dark:text-indigo-400">
                            <div class="w-3.5 h-3.5 border-2 border-indigo-600 dark:border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
                            <span>Uploading and optimizing group photo...</span>
                        </div>
                    }

                    <!-- Quick Preset Selectors -->
                    <div class="mt-2">
                        <span class="text-[10px] font-mono text-[#7A8CA6] uppercase tracking-wider block mb-1">Or choose an executive room preset:</span>
                        <div class="grid grid-cols-4 gap-1.5">
                            @for (var i = 0; i < fallbackGroupBanners.Length; i++)
                            {
                                var presetUrl = fallbackGroupBanners[i];
                                var isSelected = (createBannerUrl ?? createAvatarUrl) == presetUrl;
                                <button type="button" @onclick="() => SelectPresetGroupBanner(presetUrl)"
                                        class="relative h-12 rounded overflow-hidden border-2 transition @(isSelected ? "border-[#D4AF37] scale-102 ring-2 ring-[#D4AF37]/30" : "border-transparent opacity-70 hover:opacity-100")">
                                    <img src="@presetUrl" class="w-full h-full object-cover" alt="Preset" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-3.5 py-1.5 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-medium rounded hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitCreateGroup" disabled="@(isSubmitting || (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember))"
                        class="px-4 py-1.5 text-xs bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold rounded shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <div class="animate-spin rounded-full h-3 w-3 border-2 border-white dark:border-[#0A1B2E] border-t-transparent"></div>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Publish Group</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= PENDING REQUESTS DRAWER ================= -->
@if (showRequestsDrawer)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-md overflow-hidden">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                    <svg class="w-4 h-4 text-[#557392] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Pending Join Requests
                </h3>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-5 space-y-3 max-h-[60vh] overflow-y-auto">
                @if (pendingRequests == null || pendingRequests.Count == 0)
                {
                    <p class="text-xs text-[#7A8CA6] text-center py-6">No pending join requests for this group.</p>
                }
                else
                {
                    @foreach (var req in pendingRequests)
                    {
                        <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</span>
                                <span class="text-[10px] text-[#7A8CA6] font-mono">@req.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@req.UserEmail</p>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNote))
                            {
                                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] p-2 rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] italic">"@req.RequestNote"</p>
                            }
                            <div class="flex items-center justify-end gap-2 pt-1">
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, false)"
                                        class="px-3 py-1.5 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] text-xs font-semibold rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition">
                                    Reject
                                </button>
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, true)"
                                        class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded transition shadow-sm">
                                    Approve
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-right">
                <button type="button" @onclick="CloseModals" class="px-4 py-1.5 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-semibold rounded bg-[#E2E8F0] dark:bg-[#1B3B5A] hover:bg-[#CBD5E1] dark:hover:bg-[#112A46] transition">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<GroupModel>? groups;
    private List<CommunityModel> subCommunities = [];
    private IReadOnlyList<GroupJoinRequestModel>? pendingRequests;

    private int? currentUserId;
    private bool isAdmin;
    private bool canCreateGroup = false;
    private bool isLoading = true;
    private bool isSubmitting;
    private string searchTerm = "";
    private string activeTab = "browse";

    // Create Modal State
    private bool showCreateModal;
    private int createSubCommunityId;
    private string createGroupName = "";
    private string createGroupDescription = "";
    private string createVisibility = "PUBLIC";
    private string? createAvatarUrl;
    private string? createBannerUrl;
    private bool isUploadingImage;
    private bool isUserSubCommunityMember;
    private string selectedSubCommunityName = "";

    private readonly string[] fallbackGroupBanners = new[]
    {
        "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1200&q=80"
    };

    private string GetGroupPhoto(GroupModel grp)
    {
        if (!string.IsNullOrWhiteSpace(grp.BannerUrl)) return grp.BannerUrl;
        if (!string.IsNullOrWhiteSpace(grp.AvatarUrl)) return grp.AvatarUrl;
        var idx = Math.Abs(grp.GroupId.GetHashCode()) % fallbackGroupBanners.Length;
        return fallbackGroupBanners[idx];
    }

    private void SelectPresetGroupBanner(string url)
    {
        createBannerUrl = url;
        createAvatarUrl = url;
    }

    // Requests Drawer State
    private bool showRequestsDrawer;
    private int managingGroupId;

    private IReadOnlyList<GroupModel> ActiveGroups =>
        activeTab == "joined"
            ? (groups?.Where(g => g.IsJoined).ToList() ?? new List<GroupModel>())
            : (groups?.Where(g => !g.IsJoined).ToList() ?? new List<GroupModel>());

    private int joinedCount => groups?.Count(g => g.IsJoined) ?? 0;
    private int browseCount => groups?.Count(g => !g.IsJoined) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);

        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        if (isAdmin)
        {
            canCreateGroup = true;
        }
        else
        {
            try
            {
                var permRes = await RoleApi.GetMyPermissionsAsync();
                if (permRes.IsSuccess && permRes.Data != null)
                {
                    canCreateGroup = permRes.Data.Any(p => p.Equals("GROUP.CREATE", StringComparison.OrdinalIgnoreCase));
                }
            }
            catch { }
        }

        await Task.WhenAll(LoadSubCommunities(), LoadGroupsAsync());
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task LoadSubCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            subCommunities = res.Data.Where(c => c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private async Task LoadGroupsAsync()
    {
        isLoading = true;
        var res = await GroupApi.GetGroupsAsync(null, searchTerm);
        if (res.IsSuccess)
        {
            groups = res.Data;
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to load groups.");
        }
        isLoading = false;
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await LoadGroupsAsync();
    }

    private async Task JoinGroup(GroupModel grp)
    {
        var res = await GroupApi.JoinGroupAsync(grp.GroupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined group!");
            await LoadGroupsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join group.");
        }
    }

    private async Task LeaveGroup(GroupModel grp)
    {
        var res = await GroupApi.LeaveGroupAsync(grp.GroupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Left group.");
            await LoadGroupsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to leave group.");
        }
    }

    private async Task OpenCreateGroupModal()
    {
        createGroupName = "";
        createGroupDescription = "";
        createVisibility = "PUBLIC";
        createAvatarUrl = null;
        createBannerUrl = null;
        createSubCommunityId = subCommunities.FirstOrDefault()?.CommunityId ?? 0;
        await CheckSubCommunityMembership(createSubCommunityId);
        showCreateModal = true;
    }

    private async Task OnCreateSubCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            createSubCommunityId = subId;
            await CheckSubCommunityMembership(subId);
        }
    }

    private async Task CheckSubCommunityMembership(int subCommunityId)
    {
        if (subCommunityId <= 0)
        {
            isUserSubCommunityMember = false;
            selectedSubCommunityName = "";
            return;
        }

        var sc = subCommunities.FirstOrDefault(c => c.CommunityId == subCommunityId);
        selectedSubCommunityName = sc?.Name ?? "";

        if (isAdmin)
        {
            isUserSubCommunityMember = true;
            return;
        }

        var res = await CommunityApi.GetCommunitiesAsync();
        isUserSubCommunityMember = res.Data != null && res.Data.Any(c => c.CommunityId == subCommunityId && c.IsJoined);
    }

    private async Task SubmitCreateGroup()
    {
        if (createSubCommunityId == 0)
        {
            Toast.Warning("Please select a parent sub-community.");
            return;
        }

        if (string.IsNullOrWhiteSpace(createGroupName))
        {
            Toast.Warning("Group name is required.");
            return;
        }

        if (!isAdmin && !isUserSubCommunityMember)
        {
            Toast.Warning($"You must join sub-community '{selectedSubCommunityName}' before creating a group in it.");
            return;
        }

        isSubmitting = true;
        var finalPhoto = createBannerUrl ?? createAvatarUrl;
        var req = new CreateGroupRequestModel(
            createSubCommunityId,
            createGroupName,
            createGroupDescription,
            finalPhoto,
            finalPhoto,
            createVisibility,
            createVisibility == "PRIVATE" ? "APPROVAL_REQUIRED" : "INSTANT"
        );

        var res = await GroupApi.CreateGroupAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group created successfully!");
            CloseModals();
            await LoadGroupsAsync();
            SetTab("joined");
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create group.");
        }
    }

    private async Task OpenRequestsDrawer(int groupId)
    {
        managingGroupId = groupId;
        var res = await GroupApi.GetGroupJoinRequestsAsync(groupId);
        if (res.IsSuccess)
        {
            pendingRequests = res.Data;
            showRequestsDrawer = true;
        }
        else
        {
            Toast.Error("Failed to load join requests.");
        }
    }

    private async Task ReviewRequest(int requestId, bool approve)
    {
        var res = approve ? await GroupApi.ApproveJoinRequestAsync(requestId) : await GroupApi.RejectJoinRequestAsync(requestId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Updated!");
            await OpenRequestsDrawer(managingGroupId);
            await LoadGroupsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to review request.");
        }
    }

    private async Task HandleGroupAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"group_{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            createAvatarUrl = $"/uploads/{uniqueFileName}";
            createBannerUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Group photo uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to upload photo: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveGroupAvatar()
    {
        createAvatarUrl = null;
        createBannerUrl = null;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showRequestsDrawer = false;
    }
}