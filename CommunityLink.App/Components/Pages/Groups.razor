@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@inject GroupApiService GroupApi
@inject CommunityApiService CommunityApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment
@inject RoleAndPermissionApiService RoleApi

<PageTitle>Community Groups - CommunityLink</PageTitle>

<div class="max-w-6xl mx-auto py-6 px-4 sm:px-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Top Header Banner -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-5 sm:p-6 transition-colors duration-150">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-2xl font-bold shadow-sm">
                    👥
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-extrabold text-[#0A1B2E] dark:text-[#E1E8F0] tracking-tight" style="font-family:'Manrope',sans-serif">Community Groups</h1>
                    <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1]">Discover focused sub-groups, join conversations, or launch your own room.</p>
                </div>
            </div>
            @if (canCreateGroup)
            {
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" @onclick="OpenCreateGroupModal"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-full shadow hover:shadow-md transition-all active:scale-95 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span>Create Group</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-colors duration-150">
        <!-- Sub-Community Filter Dropdown -->
        <div class="flex items-center gap-2 flex-1 max-w-xs">
            <span class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] shrink-0">Filter:</span>
            <select class="w-full text-xs sm:text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"
                    value="@selectedSubCommunityFilter"
                    @onchange="OnSubCommunityFilterChanged">
                <option value="0">All Sub-Communities</option>
                @foreach (var sc in subCommunities)
                {
                    <option value="@sc.CommunityId">📁 @sc.Name</option>
                }
            </select>
        </div>

        <!-- Search Input -->
        <div class="relative flex-1 max-w-sm">
            <input type="text" @bind="searchTerm" @bind:after="OnSearchInputChanged"
                   placeholder="Search groups by name or topic..."
                   class="w-full text-xs sm:text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl pl-9 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20" />
            <svg class="w-4 h-4 text-[#7A8CA6] absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
    </div>

    <!-- Groups Grid Listing -->
    @if (isLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
        </div>
    }
    else if (groups == null || groups.Count == 0)
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="text-4xl mb-3">🏔️</div>
            <h3 class="text-base font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No groups found</h3>
            <p class="text-sm mt-1">Be the first to create a group under your sub-community!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var grp in groups)
            {
                <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] overflow-hidden transition-all duration-200 hover:shadow-md flex flex-col justify-between group">
                    <!-- Group Header & Info -->
                    <div>
                        <!-- Top Banner / Avatar Bar -->
                        <div class="h-20 bg-gradient-to-r from-[#F1F5F9] via-[#E2E8F0] to-[#F8FAFC] dark:from-[#1B3B5A] dark:via-[#112A46] dark:to-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] relative p-3">
                            <div class="absolute -bottom-4 left-4">
                                @if (!string.IsNullOrEmpty(grp.AvatarUrl))
                                {
                                    <img src="@grp.AvatarUrl" alt="@grp.Name" class="w-12 h-12 rounded-xl object-cover border-2 border-white dark:border-[#112A46] shadow-md bg-[#F1F5F9] dark:bg-[#1B3B5A]" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] border-2 border-white dark:border-[#112A46] shadow-md flex items-center justify-center font-bold text-[#557392] dark:text-[#C4D2E1] text-base">
                                        @(string.IsNullOrWhiteSpace(grp.Name) ? "G" : grp.Name.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>
                            <div class="flex justify-end">
                                @if (grp.Visibility == "PRIVATE")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50 shadow-sm">
                                        🔒 Private Group
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50 shadow-sm">
                                        🔓 Public Group
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 pt-6 space-y-2">
                            <div>
                                <h3 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] group-hover:text-[#557392] dark:group-hover:text-white transition" style="font-family:'Manrope',sans-serif">
                                    <a href="/group/@grp.GroupId">@grp.Name</a>
                                </h3>
                                @if (!string.IsNullOrEmpty(grp.SubCommunityName))
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] mt-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                                        @grp.SubCommunityName
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(grp.Description))
                            {
                                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] line-clamp-2 leading-relaxed">@grp.Description</p>
                            }
                            else
                            {
                                <p class="text-xs text-[#7A8CA6] italic">No description provided.</p>
                            }
                        </div>
                    </div>

                    <!-- Card Footer: Stats & Action Button -->
                    <div class="p-4 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 space-y-3">
                        <div class="flex items-center justify-between text-xs text-[#557392] dark:text-[#C4D2E1] font-medium font-mono">
                            <div class="flex items-center gap-3">
                                <span>👥 @grp.MemberCount members</span>
                                <span>•</span>
                                <span>📝 @grp.PostCount posts</span>
                            </div>
                            <span class="text-[11px] text-[#7A8CA6]">By @grp.CreatorName</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <a href="/group/@grp.GroupId"
                               class="flex-1 text-center py-2 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] text-xs font-semibold rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition">
                                View Group
                            </a>

                            @if (grp.IsJoined)
                            {
                                <span class="px-3 py-2 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50 text-xs font-semibold rounded-xl inline-flex items-center gap-1 shrink-0">
                                    ✓ Joined
                                </span>
                            }
                            else if (grp.UserJoinStatus == "PENDING")
                            {
                                <span class="px-3 py-2 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50 text-xs font-semibold rounded-xl inline-flex items-center gap-1 shrink-0">
                                    ⏳ Pending
                                </span>
                            }
                            else
                            {
                                <button type="button" @onclick="() => JoinGroup(grp)"
                                        class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-semibold rounded-xl transition shadow-sm shrink-0">
                                    @(grp.Visibility == "PRIVATE" ? "Request Join" : "Join Direct")
                                </button>
                            }

                            @if (currentUserId.HasValue && grp.CreatorId == currentUserId.Value)
                            {
                                <button type="button" @onclick="() => OpenRequestsDrawer(grp.GroupId)"
                                        title="Manage Join Requests"
                                        class="p-2 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] rounded-xl text-xs font-semibold transition shrink-0">
                                    📩 Requests
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE GROUP MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">👥</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Create New Group</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <!-- Parent Sub-Community Dropdown -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Select Sub-Community <span class="text-red-500">*</span></label>
                    <select class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"
                            value="@createSubCommunityId"
                            @onchange="OnCreateSubCommunityChanged">
                        <option value="0">-- Select Sub-Community --</option>
                        @foreach (var sc in subCommunities)
                        {
                            <option value="@sc.CommunityId">📁 @sc.Name</option>
                        }
                    </select>

                    @if (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember)
                    {
                        <div class="mt-2 p-2.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 rounded-xl text-xs text-amber-700 dark:text-amber-300 flex items-start gap-2">
                            <span>⚠️</span>
                            <span>You must join <strong>@selectedSubCommunityName</strong> first before creating a group inside it.</span>
                        </div>
                    }
                </div>

                <!-- Group Name -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Group Name <span class="text-red-500">*</span></label>
                    <input type="text" @bind="createGroupName" placeholder="e.g. EF Core Developers Room"
                           class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 font-medium" />
                </div>

                <!-- Group Description -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Description <span class="text-[#7A8CA6] font-normal">(Optional)</span></label>
                    <textarea @bind="createGroupDescription" rows="3" placeholder="Briefly describe the purpose of this group room..."
                              class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"></textarea>
                </div>

                <!-- Privacy & Access Type -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-2">Privacy & Access Control <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex flex-col p-3 rounded-xl border cursor-pointer transition @(createVisibility == "PUBLIC" ? "border-[#0A1B2E] dark:border-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] ring-2 ring-[#0A1B2E]/10" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#0A1B2E]")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PUBLIC" checked="@(createVisibility == "PUBLIC")" @onchange='() => createVisibility = "PUBLIC"' class="accent-[#0A1B2E] dark:accent-[#E1E8F0]" />
                                <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">🔓 Public Group</span>
                            </div>
                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-1 pl-5">Anyone can join directly without approval.</span>
                        </label>

                        <label class="flex flex-col p-3 rounded-xl border cursor-pointer transition @(createVisibility == "PRIVATE" ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 ring-2 ring-amber-500/20" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-white dark:bg-[#0A1B2E]")">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="visibilityGroup" value="PRIVATE" checked="@(createVisibility == "PRIVATE")" @onchange='() => createVisibility = "PRIVATE"' class="accent-amber-600" />
                                <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">🔒 Private Group</span>
                            </div>
                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-1 pl-5">Requires owner approval to join.</span>
                        </label>
                    </div>
                </div>

                <!-- Group Avatar Image Upload -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Group Avatar Image</label>
                    <InputFile OnChange="HandleGroupAvatarSelected" accept="image/*" class="w-full text-xs text-[#557392] dark:text-[#C4D2E1] file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#E2E8F0] dark:file:bg-[#1B3B5A] file:text-[#0A1B2E] dark:file:text-[#E1E8F0] hover:file:bg-[#CBD5E1] cursor-pointer" />

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 text-xs text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> Uploading avatar image...
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(createAvatarUrl))
                    {
                        <div class="mt-3 relative rounded-xl overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-24 h-24 bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center">
                            <img src="@createAvatarUrl" alt="Avatar Preview" class="w-full h-full object-cover" />
                            <button type="button" @onclick="RemoveGroupAvatar"
                                    class="absolute top-1 right-1 bg-red-600 text-white rounded-full p-1 shadow hover:bg-red-700 transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-2 text-sm text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-medium rounded-xl hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitCreateGroup" disabled="@(isSubmitting || (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember))"
                        class="px-5 py-2 text-sm bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold rounded-xl shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Publish Group</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= PENDING REQUESTS DRAWER ================= -->
@if (showRequestsDrawer)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-md overflow-hidden">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📩</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Pending Join Requests</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-5 space-y-3 max-h-[60vh] overflow-y-auto">
                @if (pendingRequests == null || pendingRequests.Count == 0)
                {
                    <p class="text-xs text-[#7A8CA6] text-center py-6">No pending join requests for this group.</p>
                }
                else
                {
                    @foreach (var req in pendingRequests)
                    {
                        <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</span>
                                <span class="text-[10px] text-[#7A8CA6] font-mono">@req.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@req.UserEmail</p>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNote))
                            {
                                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] p-2 rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] italic">"@req.RequestNote"</p>
                            }
                            <div class="flex items-center justify-end gap-2 pt-1">
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, false)"
                                        class="px-3 py-1.5 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] text-xs font-semibold rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition">
                                    Reject
                                </button>
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, true)"
                                        class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-sm">
                                    Approve
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-right">
                <button type="button" @onclick="CloseModals" class="px-4 py-1.5 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-semibold rounded-lg bg-[#E2E8F0] dark:bg-[#1B3B5A] hover:bg-[#CBD5E1] dark:hover:bg-[#112A46] transition">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<GroupModel>? groups;
    private List<CommunityModel> subCommunities = [];
    private List<CommunityModel> joinedCommunities = [];
    private IReadOnlyList<GroupJoinRequestModel>? pendingRequests;

    private int? currentUserId;
    private bool isAdmin;
    private bool canCreateGroup = false;
    private bool isLoading = true;
    private bool isSubmitting;
    private int selectedSubCommunityFilter = 0;
    private string searchTerm = "";

    // Create Modal State
    private bool showCreateModal;
    private int createSubCommunityId;
    private string createGroupName = "";
    private string createGroupDescription = "";
    private string createVisibility = "PUBLIC";
    private string? createAvatarUrl;
    private bool isUploadingImage;
    private bool isUserSubCommunityMember;
    private string selectedSubCommunityName = "";

    // Requests Drawer State
    private bool showRequestsDrawer;
    private int managingGroupId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);

        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        if (isAdmin)
        {
            canCreateGroup = true;
        }
        else
        {
            try
            {
                var permRes = await RoleApi.GetMyPermissionsAsync();
                if (permRes.IsSuccess && permRes.Data != null)
                {
                    canCreateGroup = permRes.Data.Any(p => p.Equals("GROUP.CREATE", StringComparison.OrdinalIgnoreCase));
                }
            }
            catch { }
        }

        await Task.WhenAll(LoadSubCommunities(), LoadGroups());
    }

    private async Task LoadSubCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            // Sub-communities have ParentCommunityId != null
            subCommunities = res.Data.Where(c => c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private async Task LoadGroups()
    {
        isLoading = true;
        var res = await GroupApi.GetGroupsAsync(selectedSubCommunityFilter > 0 ? selectedSubCommunityFilter : null, searchTerm);
        if (res.IsSuccess)
        {
            groups = res.Data;
        }
        isLoading = false;
    }

    private async Task OnSubCommunityFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            selectedSubCommunityFilter = subId;
            await LoadGroups();
        }
    }

    private async Task OnSearchInputChanged()
    {
        await LoadGroups();
    }

    private async Task JoinGroup(GroupModel grp)
    {
        var res = await GroupApi.JoinGroupAsync(grp.GroupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined group!");
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join group.");
        }
    }

    private async Task OpenCreateGroupModal()
    {
        createGroupName = "";
        createGroupDescription = "";
        createVisibility = "PUBLIC";
        createAvatarUrl = null;
        createSubCommunityId = subCommunities.FirstOrDefault()?.CommunityId ?? 0;
        await CheckSubCommunityMembership(createSubCommunityId);
        showCreateModal = true;
    }

    private async Task OnCreateSubCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            createSubCommunityId = subId;
            await CheckSubCommunityMembership(subId);
        }
    }

    private async Task CheckSubCommunityMembership(int subCommunityId)
    {
        if (subCommunityId <= 0)
        {
            isUserSubCommunityMember = false;
            selectedSubCommunityName = "";
            return;
        }

        var sc = subCommunities.FirstOrDefault(c => c.CommunityId == subCommunityId);
        selectedSubCommunityName = sc?.Name ?? "";

        if (isAdmin)
        {
            isUserSubCommunityMember = true;
            return;
        }

        // Check if user joined this sub-community by requesting community detail
        var res = await CommunityApi.GetCommunityByIdAsync(subCommunityId);
        if (res.IsSuccess && res.Data != null)
        {
            // If current user is in joined communities list
            if (currentUserId.HasValue)
            {
                var joinedRes = await CommunityApi.GetCommunitiesAsync(); // fallback check
                isUserSubCommunityMember = joinedRes.Data != null && joinedRes.Data.Any(c => c.CommunityId == subCommunityId);
            }
        }
    }

    private async Task SubmitCreateGroup()
    {
        if (createSubCommunityId == 0)
        {
            Toast.Warning("Please select a parent sub-community.");
            return;
        }

        if (string.IsNullOrWhiteSpace(createGroupName))
        {
            Toast.Warning("Group name is required.");
            return;
        }

        if (!isAdmin && !isUserSubCommunityMember)
        {
            Toast.Warning($"You must join sub-community '{selectedSubCommunityName}' before creating a group in it.");
            return;
        }

        isSubmitting = true;
        var req = new CreateGroupRequestModel(
            createSubCommunityId,
            createGroupName,
            createGroupDescription,
            createAvatarUrl,
            null,
            createVisibility,
            createVisibility == "PRIVATE" ? "APPROVAL_REQUIRED" : "INSTANT"
        );

        var res = await GroupApi.CreateGroupAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group created successfully!");
            CloseModals();
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create group.");
        }
    }

    private async Task OpenRequestsDrawer(int groupId)
    {
        managingGroupId = groupId;
        var res = await GroupApi.GetGroupJoinRequestsAsync(groupId);
        if (res.IsSuccess)
        {
            pendingRequests = res.Data;
            showRequestsDrawer = true;
        }
        else
        {
            Toast.Error("Failed to load join requests.");
        }
    }

    private async Task ReviewRequest(int requestId, bool approve)
    {
        var res = approve ? await GroupApi.ApproveJoinRequestAsync(requestId) : await GroupApi.RejectJoinRequestAsync(requestId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Updated!");
            await OpenRequestsDrawer(managingGroupId);
            await LoadGroups();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to review request.");
        }
    }

    private async Task HandleGroupAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"group_{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            createAvatarUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Group avatar uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to upload avatar: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveGroupAvatar()
    {
        createAvatarUrl = null;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showRequestsDrawer = false;
    }
}
