@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@using System.Globalization
@inject GroupApiService GroupApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment
@inject RoleAndPermissionApiService RoleApi
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@(selectedSubCommunity != null ? string.Format(CultureInfo.CurrentUICulture, Loc["Groups_PageTitleWithSubCommunity"], selectedSubCommunity.Name) : Loc["Groups_PageTitle"])</PageTitle>

<div class="min-h-screen bg-background font-body-md text-body-md text-on-surface antialiased transition-colors duration-200">
    <!-- Top Directory Strip -->
    <section class="bg-surface-container-lowest/80 backdrop-blur-md border-b border-surface-container-high/30">
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop py-space-sm flex items-center justify-between gap-3">
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <a href="/" class="hover:text-on-surface transition-colors flex items-center gap-1">@Loc["Common_Platform"]</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">@Loc["Groups_WorkingRoomDirectory"]</span>
            </div>
            <div class="flex items-center gap-space-sm">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider hidden sm:inline">@Loc["Groups_RoomSync"]</span>
                <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-primary font-label-sm text-label-sm border border-primary/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>@Loc["Communities_LiveIndex"]
                </span>
            </div>
        </div>
    </section>

    <div class="relative w-full overflow-hidden">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute top-40 right-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pt-space-md pb-space-lg w-full">
            <nav aria-label="@Loc["Common_Breadcrumbs"]" class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant mb-space-md">
                <a class="hover:text-primary transition-colors" href="/">@Loc["Common_Platform"]</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <a class="hover:text-primary transition-colors" href="/communities">@Loc["Communities_Breadcrumb"]</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold truncate">@(selectedSubCommunity?.Name ?? Loc["Groups_BreadcrumbDefault"])</span>
            </nav>

            <!-- Hero Panel -->
            <div class="relative rounded-xl bg-surface-container-low p-space-md md:p-space-lg overflow-hidden border border-surface-container-high/30">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
                    <div class="lg:col-span-7 flex flex-col gap-space-sm">
                        <div class="flex flex-wrap items-center gap-space-sm">
                            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-highest text-primary font-label-sm text-label-sm uppercase tracking-wider border border-primary/20">
                                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">verified</span>@Loc["Groups_RoomIndex"]
                            </span>
                            <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-surface-container text-secondary font-label-sm text-label-sm border border-secondary/20">
                                <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></span>@string.Format(CultureInfo.CurrentUICulture, Loc["Groups_RoomsIndexed"], totalGroupCount)
                            </span>
                            @if (SubCommunityId.HasValue)
                            {
                                <button type="button" @onclick="ClearSubCommunityFilter"
                                        aria-label="@Loc["Groups_ClearSubCommunityFilter"]"
                                        title="@Loc["Groups_ClearSubCommunityFilter"]"
                                        class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-error/10 text-error font-label-sm text-label-sm border border-error/30 hover:bg-error/20 transition-colors cursor-pointer">
                                    <span class="material-symbols-outlined text-xs">close</span>
                                    <span class="truncate max-w-[10rem]">@selectedSubCommunityName</span>
                                </button>
                            }

                            <!-- Sub-Community Switcher -->
                            @if (subCommunities.Count > 0)
                            {
                                <div class="relative inline-block ml-auto sm:ml-0">
                                    <select class="bg-surface-container-highest text-on-surface font-label-sm text-label-sm py-0.5 px-2 rounded-full border border-surface-container-high focus:outline-none focus:border-primary cursor-pointer max-w-[12rem]"
                                            value="@(SubCommunityId?.ToString() ?? "")"
                                            @onchange="OnSubCommunityFilterChanged">
                                        <option value="">@Loc["Groups_Filter_AllSubCommunities"]</option>
                                        @foreach (var sc in subCommunities)
                                        {
                                            <option value="@sc.CommunityId">@sc.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <h1 class="font-headline-lg text-headline-lg md:text-display-md text-on-surface tracking-tight mt-space-xs font-bold">
                            @(selectedSubCommunity != null ? selectedSubCommunity.Name : Loc["Groups_HeroTitle"])
                        </h1>

                        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl leading-relaxed">
                            @Loc["Groups_HeroSubtitle"]
                        </p>

                        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 pt-space-sm mt-space-xs text-body-sm text-body-sm">
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-xs text-primary">forum</span>
                                <span class="text-on-surface-variant">@Loc["Groups_Metric_Rooms"]</span>
                                <span class="font-mono font-bold text-on-surface">@totalGroupCount</span>
                            </span>
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-xs text-secondary">groups</span>
                                <span class="text-on-surface-variant">@Loc["Groups_Metric_Members"]</span>
                                <span class="font-mono font-bold text-on-surface">@FormatCompact(totalMemberCount)</span>
                            </span>
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-xs text-primary">article</span>
                                <span class="text-on-surface-variant">@Loc["Groups_Metric_Posts"]</span>
                                <span class="font-mono font-bold text-on-surface">@FormatCompact(totalPostCount)</span>
                            </span>
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-xs text-secondary" style="font-variation-settings: 'FILL' 1;">star</span>
                                <span class="text-on-surface-variant">@Loc["Groups_Metric_AvgRating"]</span>
                                <span class="font-mono font-bold text-on-surface">@averageRating</span>
                            </span>
                        </div>
                    </div>

                    <div class="lg:col-span-5 flex flex-col bg-surface-container-lowest/60 p-space-md rounded-xl border border-surface-container-high/30 backdrop-blur-sm">
                        <TelemetryChart Title="@Loc["TelemetryChart_RoomTitle"]" PrimaryLabel="@Loc["TelemetryChart_Members"]" SecondaryLabel="@Loc["TelemetryChart_Posts"]" Values="liquiditySeries" SecondaryValues="velocitySeries" Labels="chartLabels" Highlight="@roomHighlight" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Strip -->
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pb-space-md w-full flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md">
            <div class="flex items-center gap-space-sm">
                <span class="font-title-lg text-title-lg text-on-surface font-bold">@Loc["Groups_SectionTitle"]</span>
                <span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-primary font-label-md text-label-md border border-primary/20">
                    @string.Format(CultureInfo.CurrentUICulture, Loc["Groups_ShownCount"], ActiveGroups.Count)
                </span>
            </div>

            <div class="flex flex-wrap items-center gap-space-sm w-full sm:w-auto">
                <!-- Joined / Browse Tabs -->
                <div class="inline-flex items-center gap-0.5 p-1 rounded-lg bg-surface-container border border-surface-container-high/30">
                    <button type="button" @onclick='() => SetTab("joined")'
                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md font-label-md text-label-md transition-colors cursor-pointer @(activeTab == "joined" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:text-on-surface")">
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">favorite</span>
                        <span>@Loc["Groups_Tab_Joined"]</span>
                        <span class="px-1.5 py-0.5 rounded font-mono text-label-sm @(activeTab == "joined" ? "bg-on-primary/20" : "bg-surface-container-high text-on-surface-variant")">@joinedCount</span>
                    </button>
                    <button type="button" @onclick='() => SetTab("browse")'
                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md font-label-md text-label-md transition-colors cursor-pointer @(activeTab == "browse" ? "bg-primary text-on-primary font-bold" : "text-on-surface-variant hover:text-on-surface")">
                        <span class="material-symbols-outlined text-sm">travel_explore</span>
                        <span>@Loc["Groups_Tab_Browse"]</span>
                        <span class="px-1.5 py-0.5 rounded font-mono text-label-sm @(activeTab == "browse" ? "bg-on-primary/20" : "bg-surface-container-high text-on-surface-variant")">@browseCount</span>
                    </button>
                </div>

                <!-- Search Input -->
                <div class="relative flex-1 sm:w-56">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-sm pointer-events-none">search</span>
                    <input type="text"
                           class="w-full bg-surface-container-low text-on-surface placeholder-on-surface-variant text-body-sm pl-9 pr-8 py-1.5 rounded-lg border border-surface-container-high/30 focus:outline-none focus:bg-surface-container-high focus:border-primary transition-colors"
                           placeholder="@Loc["Groups_SearchPlaceholder"]"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @bind:after="LoadGroupsAsync" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button type="button" @onclick="ClearSearch"
                                class="absolute right-2 top-2 flex items-center text-on-surface-variant hover:text-on-surface transition-colors">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    }
                </div>

                <!-- Sort Button -->
                <button type="button" @onclick="ToggleSort"
                        class="px-3 py-1.5 bg-surface-container text-on-surface hover:text-primary rounded-lg font-label-md text-label-md flex items-center gap-1 shrink-0 transition-colors border border-surface-container-high/40 cursor-pointer">
                    <span class="material-symbols-outlined text-sm">tune</span>
                    <span>@string.Format(CultureInfo.CurrentUICulture, Loc["Groups_SortLabel"], GetLocalizedSortMode(sortMode))</span>
                </button>

                <!-- Create Group Button -->
                @if (canCreateGroup)
                {
                    <button type="button" @onclick="OpenCreateGroupModal"
                            class="px-3.5 py-1.5 bg-surface-container-high hover:bg-surface-container-highest dark:bg-[#1E3A8A] dark:hover:bg-[#1D4ED8] text-on-surface dark:text-white rounded-lg font-label-md text-label-md font-bold flex items-center gap-1.5 shrink-0 transition-all cursor-pointer border border-surface-container-high/40 dark:border-blue-400/30 shadow-xs">
                        <span class="material-symbols-outlined text-sm text-primary dark:text-blue-300">add_circle</span>
                        <span>@Loc["Groups_CreateGroupBtn"]</span>
                    </button>
                }
            </div>
        </div>

        <!-- Group Cards Grid -->
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pb-space-lg w-full">
            @if (isLoading)
            {
                <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 flex flex-col items-center justify-center py-16">
                    <div class="animate-spin rounded-full h-8 w-8 border-4 border-primary border-t-transparent"></div>
                    <p class="font-label-md text-label-md text-on-surface-variant mt-3">@Loc["Groups_LoadingText"]</p>
                </div>
            }
            else if (ActiveGroups.Count == 0)
            {
                <div class="rounded-xl bg-surface-container-low border border-dashed border-surface-container-high/40 text-center py-14 px-4">
                    <div class="w-11 h-11 rounded-xl bg-surface-container text-on-surface-variant flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-2xl">forum</span>
                    </div>
                    @if (activeTab == "joined")
                    {
                        <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">@Loc["Groups_EmptyJoinedTitle"]</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1.5 max-w-md mx-auto">@Loc["Groups_EmptyJoinedSubtitle"]</p>
                        <button type="button" @onclick='() => SetTab("browse")'
                                class="mt-4 px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold inline-flex items-center gap-1.5 cursor-pointer transition-colors hover:bg-primary-fixed-dim">
                            <span class="material-symbols-outlined text-sm">travel_explore</span>
                            <span>@Loc["Groups_EmptyBrowseBtn"]</span>
                        </button>
                    }
                    else
                    {
                        <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">@Loc["Groups_EmptySearchTitle"]</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1.5 max-w-md mx-auto">
                            @(string.IsNullOrEmpty(searchTerm)
                                ? Loc["Groups_EmptyAllJoinedSubtitle"]
                                : string.Format(CultureInfo.CurrentUICulture, Loc["Groups_EmptySearchMatchSubtitle"], searchTerm))
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-space-lg">
                    @for (var gIdx = 0; gIdx < ActiveGroups.Count; gIdx++)
                    {
                        var grp = ActiveGroups[gIdx];
                        var cardIndex = gIdx;
                        var isCreator = currentUserId.HasValue && grp.CreatorId == currentUserId.Value;
                        var photoUrl = GetGroupPhoto(grp);

                        <div class="group flex flex-col justify-between rounded-xl bg-surface-container-low hover:bg-surface-container transition-all duration-300 overflow-hidden relative border border-surface-container-highest/20 hover:border-primary/30">
                            <div class="absolute inset-x-0 top-0 h-1 opacity-80 @GetGlowGradientForIndex(cardIndex)"></div>

                            <div class="p-space-md flex flex-col gap-space-sm">
                                <!-- Banner (without gradient shadow overlay) -->
                                <div class="relative h-36 rounded-lg overflow-hidden bg-surface-container-lowest border border-slate-200 dark:border-surface-container-high/30">
                                    <img src="@photoUrl" alt="@grp.Name"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />

                                    <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
                                        <span class="px-2 py-1 rounded-md bg-white/90 dark:bg-surface-container-lowest/90 backdrop-blur-md text-[#0A1B2E] dark:text-primary font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1 border border-slate-300/80 dark:border-primary/20 truncate max-w-[70%] font-semibold shadow-xs">
                                            <span class="material-symbols-outlined text-xs shrink-0 text-primary">@GetCategoryIcon(cardIndex)</span>
                                            <span class="truncate">@(string.IsNullOrWhiteSpace(grp.SubCommunityName) ? Loc["Groups_DefaultSubCommunityBadge"] : grp.SubCommunityName)</span>
                                        </span>

                                        @if (grp.Visibility == "PRIVATE")
                                        {
                                            <span class="shrink-0 inline-flex items-center gap-1 px-2 py-1 rounded-md bg-white/90 dark:bg-surface-container-lowest/90 backdrop-blur-md text-slate-800 dark:text-on-surface font-label-sm text-label-sm uppercase tracking-wider border border-slate-300 dark:border-outline-variant/40 font-semibold shadow-xs">
                                                <span class="material-symbols-outlined text-xs">lock</span>@Loc["Groups_Badge_Private"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="shrink-0 inline-flex items-center gap-1 px-2 py-1 rounded-md bg-white/90 dark:bg-surface-container-lowest/90 backdrop-blur-md text-secondary font-label-sm text-label-sm uppercase tracking-wider border border-secondary/30 font-semibold shadow-xs">
                                                <span class="material-symbols-outlined text-xs">visibility</span>@Loc["Groups_Badge_Public"]
                                            </span>
                                        }
                                    </div>

                                    <div class="absolute bottom-2 left-2 right-2 p-2 rounded-lg bg-white/90 dark:bg-surface-container-lowest/90 backdrop-blur-md border border-slate-200/80 dark:border-surface-container-high/30 flex items-center justify-between gap-2 shadow-xs">
                                        <div class="min-w-0">
                                            <span class="block font-label-sm text-[10px] text-slate-500 dark:text-on-surface-variant uppercase tracking-wider font-semibold truncate">@GetTierLabel(cardIndex)</span>
                                            <a href="/group/@grp.GroupId"
                                               class="block font-title-md text-sm text-slate-900 dark:text-on-surface font-bold tracking-tight truncate hover:text-primary transition-colors">
                                                @grp.Name
                                            </a>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(grp.AvatarUrl) && grp.AvatarUrl != grp.BannerUrl)
                                        {
                                            <div class="w-7 h-7 rounded-full bg-surface-container-high overflow-hidden border-2 border-white dark:border-surface-container-lowest shrink-0 shadow-xs">
                                                <img class="w-full h-full object-cover" src="@grp.AvatarUrl" alt="@grp.Name" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="w-7 h-7 rounded-full bg-slate-200 dark:bg-surface-container-highest text-slate-800 dark:text-on-surface-variant font-label-sm text-xs flex items-center justify-center font-bold border-2 border-white dark:border-surface-container-lowest shrink-0 shadow-xs">
                                                @InitialOf(grp.Name)
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Description -->
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(grp.Description)
                                        ? Loc["Groups_DefaultDescription"]
                                        : grp.Description)
                                </p>

                                <!-- Metrics -->
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm text-body-sm py-space-xs px-space-sm rounded-lg bg-surface-container-lowest/50 border border-surface-container-high/20">
                                    <span class="flex items-center gap-1 text-on-surface font-semibold">
                                        <span class="material-symbols-outlined text-xs text-primary">groups</span>
                                        @string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Card_Members"], FormatCompact(grp.MemberCount))
                                    </span>
                                    <span class="text-on-surface-variant">•</span>
                                    <span class="flex items-center gap-1 text-primary font-medium">
                                        <span class="material-symbols-outlined text-xs">article</span>
                                        @string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Card_Posts"], FormatCompact(grp.PostCount))
                                    </span>
                                    <span class="text-on-surface-variant">•</span>
                                    <span class="flex items-center gap-1 text-secondary font-medium">
                                        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                                        @RatingLabel(grp)
                                    </span>
                                </div>

                                <!-- Curator Strip -->
                                <div class="flex items-center justify-between gap-2 pt-space-xs font-label-sm text-label-sm text-on-surface-variant">
                                    <span class="truncate">@((MarkupString)string.Format(CultureInfo.CurrentUICulture, Loc["Groups_CuratedBy"], $"<span class=\"font-mono text-on-surface font-bold\">{System.Net.WebUtility.HtmlEncode(grp.CreatorName)}</span>"))</span>
                                    @if (isCreator)
                                    {
                                        <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-primary-container text-on-primary-container font-mono uppercase">
                                            <span class="material-symbols-outlined text-label-sm">shield</span>@Loc["Groups_Badge_YouManage"]
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="p-space-md pt-0 flex items-stretch gap-space-sm">
                                <a class="flex-1 py-2 px-space-sm rounded-lg bg-surface-container-high text-primary hover:bg-surface-container-highest font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all no-underline cursor-pointer border border-primary/20"
                                   href="/group/@grp.GroupId">
                                    <span class="truncate">@Loc["Groups_Action_EnterRoom"]</span>
                                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                </a>

                                @if (grp.IsJoined)
                                {
                                    <button type="button" disabled
                                            class="flex-1 py-2 px-space-sm rounded-lg bg-surface-container-highest text-on-surface font-label-lg text-label-lg font-bold flex items-center justify-center gap-1.5 cursor-default border border-surface-container-high">
                                        <span class="material-symbols-outlined text-sm text-primary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                        <span>@Loc["Groups_Action_Joined"]</span>
                                    </button>
                                    @if (isCreator)
                                    {
                                        <button type="button" @onclick="() => OpenRequestsDrawer(grp.GroupId)"
                                                title="@Loc["Groups_Tooltip_ManageRequests"]"
                                                class="shrink-0 w-10 py-2 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface border border-surface-container-high/40 transition-colors flex items-center justify-center cursor-pointer">
                                            <span class="material-symbols-outlined text-sm">outgoing_mail</span>
                                        </button>
                                    }
                                }
                                else if (grp.UserJoinStatus == "PENDING")
                                {
                                    <span class="flex-1 py-2 px-space-sm rounded-lg bg-surface-container-high text-on-surface-variant font-label-lg text-label-lg font-semibold flex items-center justify-center gap-1.5 border border-surface-container-high/50">
                                        <span class="material-symbols-outlined text-sm">schedule</span>
                                        <span class="truncate">@Loc["Groups_Action_Pending"]</span>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => JoinGroup(grp)"
                                            class="flex-1 py-2 px-space-sm rounded-lg bg-primary text-on-primary hover:bg-primary-fixed-dim font-label-lg text-label-lg font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">lock_open</span>
                                        <span class="truncate">@(grp.JoinPolicy == "APPROVAL_REQUIRED" || grp.Visibility == "PRIVATE" ? Loc["Groups_Action_Request"] : Loc["Groups_Action_Join"])</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= CREATE GROUP MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-surface-dim/70 backdrop-blur-sm p-4">
        <div class="relative bg-surface-container-low rounded-xl shadow-2xl border border-surface-container-high/40 w-full max-w-lg overflow-hidden">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-space-md py-space-sm border-b border-surface-container-high/30">
                <h3 class="font-title-lg text-title-lg text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">forum</span>
                    <span>@Loc["Groups_Modal_Title"]</span>
                </h3>
                <button type="button" @onclick="CloseModals"
                        class="w-6 h-6 rounded-md flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-space-md space-y-space-md max-h-[75vh] overflow-y-auto">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="p-space-sm rounded-lg bg-error/10 text-error text-body-sm flex items-start gap-2 border border-error/30">
                        <span class="material-symbols-outlined text-sm shrink-0 mt-px">warning</span>
                        <span class="flex-1">@modalError</span>
                    </div>
                }

                <!-- Parent Sub-Community Selector -->
                <div>
                    <label class="block font-label-md text-label-md text-on-surface mb-1.5">@Loc["Groups_Modal_SelectSubCommunityLabel"] <span class="text-error">*</span></label>
                    <select class="w-full bg-surface-container-lowest text-on-surface text-body-sm rounded-lg border border-surface-container-high/30 focus:outline-none focus:border-primary px-3 py-2 cursor-pointer"
                            value="@createSubCommunityId"
                            @onchange="OnCreateSubCommunityChanged">
                        <option value="0">@Loc["Groups_Modal_SelectSubCommunityPlaceholder"]</option>
                        @foreach (var sc in subCommunities)
                        {
                            <option value="@sc.CommunityId">@sc.Name</option>
                        }
                    </select>

                    @if (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember)
                    {
                        <div class="mt-2 p-space-sm rounded-lg bg-error/10 text-error text-body-sm flex items-start gap-2 border border-error/30">
                            <span class="material-symbols-outlined text-sm shrink-0 mt-px">warning</span>
                            <span>@((MarkupString)string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Modal_MustJoinParentFirst"], $"<strong>{System.Net.WebUtility.HtmlEncode(selectedSubCommunityName)}</strong>"))</span>
                        </div>
                    }
                </div>

                <!-- Group Name -->
                <div>
                    <label class="block font-label-md text-label-md text-on-surface mb-1.5">@Loc["Groups_Modal_GroupNameLabel"] <span class="text-error">*</span></label>
                    <input type="text" @bind="createGroupName" placeholder="@Loc["Groups_Modal_GroupNamePlaceholder"]"
                           class="w-full bg-surface-container-lowest text-on-surface placeholder-on-surface-variant text-body-sm rounded-lg border border-surface-container-high/30 focus:outline-none focus:border-primary px-3 py-2 font-semibold" />
                </div>

                <!-- Group Description -->
                <div>
                    <label class="block font-label-md text-label-md text-on-surface mb-1.5">@Loc["Groups_Modal_DescriptionLabel"] <span class="text-on-surface-variant font-normal">@Loc["Groups_Modal_Optional"]</span></label>
                    <textarea @bind="createGroupDescription" rows="3" placeholder="@Loc["Groups_Modal_DescriptionPlaceholder"]"
                              class="w-full bg-surface-container-lowest text-on-surface placeholder-on-surface-variant text-body-sm rounded-lg border border-surface-container-high/30 focus:outline-none focus:border-primary px-3 py-2 leading-relaxed"></textarea>
                </div>

                <!-- Privacy & Access Type -->
                <div>
                    <label class="block font-label-md text-label-md text-on-surface mb-2">@Loc["Groups_Modal_PrivacyLabel"] <span class="text-error">*</span></label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
                        <button type="button" @onclick='() => createVisibility = "PUBLIC"'
                                class="px-3 py-2.5 rounded-lg border text-left transition cursor-pointer @(createVisibility == "PUBLIC" ? "border-primary bg-slate-100 dark:bg-surface-container-highest font-bold text-slate-900 dark:text-white ring-1 ring-primary/40 shadow-xs" : "border-slate-200 dark:border-surface-container-high/30 bg-white dark:bg-surface-container-low text-slate-600 dark:text-on-surface-variant hover:border-slate-300 dark:hover:border-surface-container-high")">
                            <span class="inline-flex items-center gap-1.5 font-label-md text-label-md text-slate-900 dark:text-white">
                                <span class="material-symbols-outlined text-primary">visibility</span>@Loc["Groups_Modal_PublicGroupTitle"]
                            </span>
                            <span class="block font-body-sm text-body-sm text-slate-500 dark:text-on-surface-variant font-normal mt-0.5">@Loc["Groups_Modal_PublicGroupDesc"]</span>
                        </button>

                        <button type="button" @onclick='() => createVisibility = "PRIVATE"'
                                class="px-3 py-2.5 rounded-lg border text-left transition cursor-pointer @(createVisibility == "PRIVATE" ? "border-primary bg-slate-100 dark:bg-surface-container-highest font-bold text-slate-900 dark:text-white ring-1 ring-primary/40 shadow-xs" : "border-slate-200 dark:border-surface-container-high/30 bg-white dark:bg-surface-container-low text-slate-600 dark:text-on-surface-variant hover:border-slate-300 dark:hover:border-surface-container-high")">
                            <span class="inline-flex items-center gap-1.5 font-label-md text-label-md text-slate-900 dark:text-white">
                                <span class="material-symbols-outlined text-primary">lock</span>@Loc["Groups_Modal_PrivateGroupTitle"]
                            </span>
                            <span class="block font-body-sm text-body-sm text-slate-500 dark:text-on-surface-variant font-normal mt-0.5">@Loc["Groups_Modal_PrivateGroupDesc"]</span>
                        </button>
                    </div>
                </div>

                <!-- Group Photo / Cover Image -->
                <div>
                    <label class="block font-label-md text-label-md text-on-surface mb-1.5">@Loc["Groups_Modal_PhotoLabel"]</label>

                    @if (!string.IsNullOrEmpty(createAvatarUrl) || !string.IsNullOrEmpty(createBannerUrl))
                    {
                        var previewImg = createBannerUrl ?? createAvatarUrl;
                        <div class="relative h-32 rounded-lg overflow-hidden border border-surface-container-high/30 group">
                            <img src="@previewImg" class="w-full h-full object-cover" alt="@Loc["Groups_Modal_PreviewAlt"]" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                                <button type="button" @onclick="RemoveGroupAvatar"
                                        class="px-2.5 py-1 rounded bg-error text-on-error text-body-sm font-semibold shadow hover:opacity-90 transition inline-flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                    <span>@Loc["Groups_Modal_RemovePhotoBtn"]</span>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="border-2 border-dashed border-surface-container-high/30 rounded-xl p-4 text-center hover:border-primary transition">
                            <InputFile OnChange="HandleGroupAvatarSelected" accept=".jpg,.jpeg,.png,.webp" class="hidden" id="groupBannerFileInput" />
                            <label for="groupBannerFileInput" class="cursor-pointer flex flex-col items-center">
                                <span class="material-symbols-outlined text-2xl text-on-surface-variant mb-1">image</span>
                                <span class="font-label-md text-label-md text-on-surface">@Loc["Groups_Modal_UploadPrompt"]</span>
                                <span class="font-label-sm text-label-sm text-on-surface-variant mt-0.5">@Loc["Groups_Modal_UploadFormats"]</span>
                            </label>
                        </div>
                    }

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 flex items-center gap-2 text-body-sm text-primary">
                            <div class="w-3.5 h-3.5 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                            <span>@Loc["Groups_Modal_UploadingPhoto"]</span>
                        </div>
                    }

                    <!-- Quick Preset Selectors -->
                    <div class="mt-2">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block mb-1">@Loc["Groups_Modal_PresetPrompt"]</span>
                        <div class="grid grid-cols-4 gap-1.5">
                            @for (var i = 0; i < fallbackGroupBanners.Length; i++)
                            {
                                var presetUrl = fallbackGroupBanners[i];
                                var isSelected = (createBannerUrl ?? createAvatarUrl) == presetUrl;
                                <button type="button" @onclick="() => SelectPresetGroupBanner(presetUrl)"
                                        class="relative h-12 rounded overflow-hidden border-2 transition cursor-pointer @(isSelected ? "border-primary ring-2 ring-primary/30" : "border-transparent opacity-70 hover:opacity-100")">
                                    <img src="@presetUrl" class="w-full h-full object-cover" alt="@Loc["Groups_Modal_PresetAlt"]" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-space-md py-space-sm bg-surface-container-lowest/60 border-t border-surface-container-high/30 flex items-center justify-end gap-space-sm">
                <button type="button" @onclick="CloseModals" disabled="@isSubmitting"
                        class="px-3.5 py-1.5 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg font-label-md text-label-md transition-colors border border-surface-container-high/40 cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitCreateGroup" disabled="@(isSubmitting || (!isAdmin && createSubCommunityId > 0 && !isUserSubCommunityMember))"
                        class="px-4 py-1.5 bg-primary text-on-primary hover:bg-primary-fixed-dim rounded-lg font-label-md text-label-md font-bold transition-colors disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmitting)
                    {
                        <div class="w-3 h-3 border-2 border-on-primary border-t-transparent rounded-full animate-spin"></div>
                        <span>@Loc["Groups_Modal_CreatingBtn"]</span>
                    }
                    else
                    {
                        <span>@Loc["Groups_Modal_PublishBtn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= PENDING REQUESTS DRAWER ================= -->
@if (showRequestsDrawer)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-surface-dim/70 backdrop-blur-sm p-4">
        <div class="relative bg-surface-container-low rounded-xl shadow-2xl border border-surface-container-high/40 w-full max-w-md overflow-hidden">
            <div class="flex items-center justify-between px-space-md py-space-sm border-b border-surface-container-high/30">
                <h3 class="font-title-lg text-title-lg text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">outgoing_mail</span>
                    <span>@Loc["Groups_Drawer_Title"]</span>
                </h3>
                <button type="button" @onclick="CloseModals"
                        class="w-6 h-6 rounded-md flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <div class="p-space-md space-y-space-sm max-h-[60vh] overflow-y-auto">
                @if (pendingRequests == null || pendingRequests.Count == 0)
                {
                    <div class="rounded-lg border border-dashed border-surface-container-high/40 text-center py-8 px-4">
                        <div class="w-9 h-9 rounded-lg bg-surface-container text-on-surface-variant flex items-center justify-center mx-auto mb-2">
                            <span class="material-symbols-outlined text-lg">inbox</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">@Loc["Groups_Drawer_EmptyText"]</p>
                    </div>
                }
                else
                {
                    @foreach (var req in pendingRequests)
                    {
                        <div class="p-space-sm rounded-lg bg-surface-container-lowest/50 border border-surface-container-high/20 space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-title-md text-title-md text-on-surface truncate">@req.UserName</span>
                                <span class="font-label-sm text-label-sm font-mono text-on-surface-variant shrink-0">@req.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">@req.UserEmail</p>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNote))
                            {
                                <p class="font-body-sm text-body-sm text-on-surface-variant bg-surface-container rounded-lg p-2 border border-surface-container-high/20 italic">"@req.RequestNote"</p>
                            }
                            <div class="flex items-center justify-end gap-space-sm pt-1">
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, false)"
                                        class="px-3 py-1.5 bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg font-label-md text-label-md border border-surface-container-high/40 transition-colors cursor-pointer">
                                    @Loc["Groups_Drawer_RejectBtn"]
                                </button>
                                <button type="button" @onclick="() => ReviewRequest(req.GroupJoinRequestId, true)"
                                        class="px-3 py-1.5 bg-primary text-on-primary hover:bg-primary-fixed-dim rounded-lg font-label-md text-label-md font-bold transition-colors cursor-pointer">
                                    @Loc["Groups_Drawer_ApproveBtn"]
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="px-space-md py-space-sm bg-surface-container-lowest/60 border-t border-surface-container-high/30 flex items-center justify-end">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-1.5 bg-surface-container hover:bg-surface-container-high text-on-surface rounded-lg font-label-md text-label-md font-bold transition-colors cursor-pointer">
                    @Loc["Common_Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "subCommunityId")]
    public int? SubCommunityId { get; set; }

    private IReadOnlyList<GroupModel>? groups;
    private List<CommunityModel> subCommunities = [];
    private IReadOnlyList<GroupJoinRequestModel>? pendingRequests;

    private int? currentUserId;
    private bool isAdmin;
    private bool canCreateGroup;
    private bool isLoading = true;
    private bool isSubmitting;
    private string searchTerm = "";
    private string activeTab = "browse";
    private string sortMode = "Activity";
    private string? modalError;

    private int? appliedSubCommunityId;
    private bool isInitialized;

    // Create Modal State
    private bool showCreateModal;
    private int createSubCommunityId;
    private string createGroupName = "";
    private string createGroupDescription = "";
    private string createVisibility = "PUBLIC";
    private string? createAvatarUrl;
    private string? createBannerUrl;
    private bool isUploadingImage;
    private bool isUserSubCommunityMember;
    private string selectedSubCommunityName = "";

    // Requests Drawer State
    private bool showRequestsDrawer;
    private int managingGroupId;

    private readonly string[] fallbackGroupBanners = new[]
    {
        "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1200&q=80"
    };

    private CommunityModel? selectedSubCommunity =>
        SubCommunityId.HasValue
            ? subCommunities.FirstOrDefault(c => c.CommunityId == SubCommunityId.Value)
            : null;

    private IReadOnlyList<GroupModel> ActiveGroups
    {
        get
        {
            IEnumerable<GroupModel> list = activeTab == "joined"
                ? (groups ?? []).Where(g => g.IsJoined)
                : (groups ?? []).Where(g => !g.IsJoined);

            return sortMode switch
            {
                "Members" => list.OrderByDescending(g => g.MemberCount).ThenBy(g => g.Name).ToList(),
                "Name" => list.OrderBy(g => g.Name).ToList(),
                _ => list.OrderByDescending(g => g.PostCount).ThenByDescending(g => g.MemberCount).ToList()
            };
        }
    }

    private int joinedCount => groups?.Count(g => g.IsJoined) ?? 0;
    private int browseCount => groups?.Count(g => !g.IsJoined) ?? 0;

    private int totalGroupCount => groups?.Count ?? 0;
    private int totalMemberCount => groups?.Sum(g => g.MemberCount) ?? 0;
    private int totalPostCount => groups?.Sum(g => g.PostCount) ?? 0;

    private string averageRating
    {
        get
        {
            var rated = groups?.Where(g => g.RatingCount > 0).ToList() ?? [];
            if (rated.Count == 0) return Loc["Groups_Rating_NA"];
            return (rated.Sum(g => g.AverageRating ?? 0d) / rated.Count).ToString("0.0", CultureInfo.InvariantCulture);
        }
    }

    // Telemetry chart series: ranked member concentration and post velocity across the room directory.
    private const int MaxChartPoints = 12;

    private List<GroupModel> chartSource => (groups ?? (IReadOnlyList<GroupModel>)Array.Empty<GroupModel>())
        .Where(g => g.MemberCount > 0 || g.PostCount > 0)
        .OrderByDescending(g => g.MemberCount)
        .ThenByDescending(g => g.PostCount)
        .Take(MaxChartPoints)
        .ToList();

    private List<double> liquiditySeries => chartSource.Select(g => (double)g.MemberCount).ToList();
    private List<double> velocitySeries => chartSource.Select(g => (double)g.PostCount).ToList();
    private List<string> chartLabels => chartSource.Select(g => ShortenLabel(g.Name)).ToList();

    private string roomHighlight
    {
        get
        {
            var ranked = chartSource;
            if (ranked.Count == 0) return Loc["TelemetryChart_NoSignal"];
            var total = ranked.Sum(g => g.MemberCount);
            if (total <= 0) return Loc["TelemetryChart_NoSignal"];
            var top = ranked.Take(3).Sum(g => g.MemberCount);
            var pct = (top / (double)total * 100d).ToString("0", CultureInfo.InvariantCulture);
            return string.Format(CultureInfo.CurrentUICulture, Loc["TelemetryChart_Concentration"], pct);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);

        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        if (isAdmin)
        {
            canCreateGroup = true;
        }
        else
        {
            try
            {
                var permRes = await RoleApi.GetMyPermissionsAsync();
                if (permRes.IsSuccess && permRes.Data != null)
                {
                    canCreateGroup = permRes.Data.Any(p => p.Equals("GROUP.CREATE", StringComparison.OrdinalIgnoreCase));
                }
            }
            catch { }
        }

        await Task.WhenAll(LoadSubCommunities(), LoadGroupsAsync());
        isInitialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!isInitialized) return;
        if (SubCommunityId == appliedSubCommunityId) return;

        appliedSubCommunityId = SubCommunityId;
        await LoadGroupsAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void ToggleSort()
    {
        sortMode = sortMode switch
        {
            "Activity" => "Members",
            "Members" => "Name",
            _ => "Activity"
        };
    }

    private void OnSubCommunityFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId) && subId > 0)
        {
            Navigation.NavigateTo($"/groups?subCommunityId={subId}");
        }
        else
        {
            Navigation.NavigateTo("/groups");
        }
    }

    private void ClearSubCommunityFilter()
    {
        Navigation.NavigateTo("/groups");
    }

    private async Task LoadSubCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            subCommunities = res.Data
                .Where(c => c.ParentCommunityId.HasValue)
                .OrderByDescending(c => c.MemberCount)
                .ThenBy(c => c.Name)
                .ToList();
        }
    }

    private async Task LoadGroupsAsync()
    {
        isLoading = true;
        appliedSubCommunityId = SubCommunityId;
        var res = await GroupApi.GetGroupsAsync(SubCommunityId, searchTerm);
        if (res.IsSuccess)
        {
            groups = res.Data;
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Groups_Toast_LoadFailed"]);
        }
        isLoading = false;
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await LoadGroupsAsync();
    }

    private async Task JoinGroup(GroupModel grp)
    {
        var res = await GroupApi.JoinGroupAsync(grp.GroupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? Loc["Groups_Toast_JoinedSuccess"]);
            await LoadGroupsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Groups_Toast_JoinFailed"]);
        }
    }

    private string GetGroupPhoto(GroupModel grp)
    {
        if (!string.IsNullOrWhiteSpace(grp.BannerUrl)) return grp.BannerUrl;
        if (!string.IsNullOrWhiteSpace(grp.AvatarUrl)) return grp.AvatarUrl;
        var idx = Math.Abs(grp.GroupId) % fallbackGroupBanners.Length;
        return fallbackGroupBanners[idx];
    }

    private void SelectPresetGroupBanner(string url)
    {
        createBannerUrl = url;
        createAvatarUrl = url;
    }

    private async Task OpenCreateGroupModal()
    {
        createGroupName = "";
        createGroupDescription = "";
        createVisibility = "PUBLIC";
        createAvatarUrl = null;
        createBannerUrl = null;
        modalError = null;
        createSubCommunityId = SubCommunityId > 0
            ? SubCommunityId.Value
            : subCommunities.FirstOrDefault()?.CommunityId ?? 0;
        await CheckSubCommunityMembership(createSubCommunityId);
        showCreateModal = true;
    }

    private async Task OnCreateSubCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var subId))
        {
            createSubCommunityId = subId;
            modalError = null;
            await CheckSubCommunityMembership(subId);
        }
    }

    private async Task CheckSubCommunityMembership(int subCommunityId)
    {
        if (subCommunityId <= 0)
        {
            isUserSubCommunityMember = false;
            selectedSubCommunityName = "";
            return;
        }

        var sc = subCommunities.FirstOrDefault(c => c.CommunityId == subCommunityId);
        selectedSubCommunityName = sc?.Name ?? "";

        if (isAdmin)
        {
            isUserSubCommunityMember = true;
            return;
        }

        var res = await CommunityApi.GetCommunitiesAsync();
        isUserSubCommunityMember = res.Data != null && res.Data.Any(c => c.CommunityId == subCommunityId && c.IsJoined);
    }

    private async Task SubmitCreateGroup()
    {
        modalError = null;

        if (createSubCommunityId == 0)
        {
            modalError = Loc["Groups_Val_SelectSubCommunity"];
            return;
        }

        if (string.IsNullOrWhiteSpace(createGroupName))
        {
            modalError = Loc["Groups_Val_NameRequired"];
            return;
        }

        if (!isAdmin && !isUserSubCommunityMember)
        {
            modalError = string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Val_MustJoinSubCommunity"], selectedSubCommunityName);
            return;
        }

        isSubmitting = true;
        var finalPhoto = createBannerUrl ?? createAvatarUrl;
        var req = new CreateGroupRequestModel(
            createSubCommunityId,
            createGroupName.Trim(),
            createGroupDescription,
            finalPhoto,
            finalPhoto,
            createVisibility,
            createVisibility == "PRIVATE" ? "APPROVAL_REQUIRED" : "INSTANT"
        );

        var res = await GroupApi.CreateGroupAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["Groups_Toast_CreateSuccess"]);
            CloseModals();
            await LoadGroupsAsync();
            SetTab("joined");
        }
        else
        {
            modalError = res.Message ?? Loc["Groups_Toast_CreateFailed"];
        }
    }

    private async Task OpenRequestsDrawer(int groupId)
    {
        managingGroupId = groupId;
        var res = await GroupApi.GetGroupJoinRequestsAsync(groupId);
        if (res.IsSuccess)
        {
            pendingRequests = res.Data;
            showRequestsDrawer = true;
        }
        else
        {
            Toast.Error(Loc["Groups_Toast_LoadRequestsFailed"]);
        }
    }

    private async Task ReviewRequest(int requestId, bool approve)
    {
        var res = approve ? await GroupApi.ApproveJoinRequestAsync(requestId) : await GroupApi.RejectJoinRequestAsync(requestId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? Loc["Groups_Toast_RequestUpdated"]);
            await OpenRequestsDrawer(managingGroupId);
            await LoadGroupsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Groups_Toast_ReviewRequestFailed"]);
        }
    }

    private async Task HandleGroupAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"group_{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            createAvatarUrl = $"/uploads/{uniqueFileName}";
            createBannerUrl = $"/uploads/{uniqueFileName}";
            Toast.Success(Loc["Groups_Toast_PhotoUploaded"]);
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Toast_PhotoUploadError"], ex.Message));
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveGroupAvatar()
    {
        createAvatarUrl = null;
        createBannerUrl = null;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showRequestsDrawer = false;
        modalError = null;
    }

    private string GetLocalizedSortMode(string mode) => mode switch
    {
        "Members" => Loc["Groups_Sort_Members"],
        "Name" => Loc["Groups_Sort_Name"],
        _ => Loc["Groups_Sort_Activity"]
    };

    private static string ShortenLabel(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Room";
        var cleaned = name.Trim();
        var cut = cleaned.IndexOfAny(new[] { ' ', '&', '-', '/', ',' });
        if (cut > 1) cleaned = cleaned[..cut];
        return cleaned.Length <= 12 ? cleaned : cleaned[..12];
    }

    private static string InitialOf(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static string FormatCompact(int value)
    {
        if (value >= 1_000_000) return (value / 1_000_000D).ToString("0.#", CultureInfo.InvariantCulture) + "M";
        if (value >= 1_000) return (value / 1_000D).ToString("0.#", CultureInfo.InvariantCulture) + "k";
        return value.ToString("N0", CultureInfo.InvariantCulture);
    }

    private string GetTierLabel(int index) => index switch
    {
        0 => Loc["Groups_Tier_Largest"],
        1 => Loc["Groups_Tier_SecondLargest"],
        2 => Loc["Groups_Tier_ThirdLargest"],
        _ => string.Format(CultureInfo.CurrentUICulture, Loc["Groups_Tier_Rank"], (index + 1).ToString(CultureInfo.InvariantCulture))
    };

    private static string GetCategoryIcon(int index) => (index % 4) switch
    {
        0 => "hub",
        1 => "memory",
        2 => "precision_manufacturing",
        _ => "science"
    };

    private static string GetGlowGradientForIndex(int index) => (index % 4) switch
    {
        0 => "bg-gradient-to-r from-primary via-primary-fixed to-transparent",
        1 => "bg-gradient-to-r from-secondary via-secondary-container to-transparent",
        2 => "bg-gradient-to-r from-primary via-surface-tint to-transparent",
        _ => "bg-gradient-to-r from-tertiary via-secondary to-transparent"
    };

    private string RatingLabel(GroupModel grp)
    {
        if (grp.RatingCount <= 0 || !grp.AverageRating.HasValue) return Loc["Groups_Rating_Unrated"];
        return grp.AverageRating.Value.ToString("0.0", CultureInfo.InvariantCulture);
    }
