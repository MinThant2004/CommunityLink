@page "/admin/reports/users"
@page "/reports/users"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.ReportView)]
@using CommunityLink.Shared.Features.Report
@inject ReportApiService ReportApi
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Report_User_PageTitle"]</PageTitle>

<div class="max-w-7xl mx-auto space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150 p-4 md:p-6">
    <!-- Domain Header & Refresh Button -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-4">
        <div>
            <div class="flex items-center gap-2">
                <svg class="w-7 h-7 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                <h1 class="text-2xl font-bold tracking-tight" style="font-family:'Manrope',sans-serif">@Loc["Report_User_Heading"]</h1>
            </div>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">
                @Loc["Report_User_Subtitle"]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick="LoadUsersAsync" class="px-3.5 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white text-xs font-semibold flex items-center gap-1.5 transition shadow-sm cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                @Loc["Report_User_BtnRefresh"]
            </button>
        </div>
    </div>

    <!-- Navigation Tabs (Communities vs User Popularity) -->
    <div class="flex items-center gap-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-2">
        <NavLink href="admin/reports/communities"
                 class="px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]"
                 ActiveClass="!bg-[#0A1B2E] dark:!bg-[#E1E8F0] !text-white dark:!text-[#0A1B2E] shadow-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
            <span>@Loc["Nav_CommunityReport"]</span>
        </NavLink>
        <NavLink href="admin/reports/users"
                 class="px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]"
                 ActiveClass="!bg-[#0A1B2E] dark:!bg-[#E1E8F0] !text-white dark:!text-[#0A1B2E] shadow-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
            <span>@Loc["Nav_UserReport"]</span>
        </NavLink>
    </div>

    @if (isLoadingUsers)
    {
        <div class="p-16 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-3 text-sm font-medium">@Loc["Report_User_LoadingUsers"]</p>
        </div>
    }
    else if (users == null || !users.Any())
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl p-12 text-center border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-500 mx-auto flex items-center justify-center mb-3">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
            </div>
            <p class="mt-3 text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Report_User_EmptyUsers"]</p>
        </div>
    }
    else
    {
        <!-- Main Layout: User List (Left) and Content Details (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- Left Panel: Ranked Users List -->
            <div class="lg:col-span-5 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
                <div class="p-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#7A8CA6] font-mono">@Loc["Report_User_RankedHeading"]</span>
                    <span class="text-xs text-[#7A8CA6] font-mono">@string.Format(Loc["Report_User_UsersCount"], users.Count)</span>
                </div>

                <!-- Search Box with Search Button -->
                <div class="p-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-white dark:bg-[#112A46]">
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#7A8CA6]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            </span>
                            <input type="text" @bind="userSearchTerm" @bind:event="oninput" @onkeydown="HandleUserSearchKeyDown"
                                   placeholder="Search user by name or username..."
                                   class="w-full pl-9 pr-7 py-2 bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] rounded-xl text-xs text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] focus:outline-none focus:ring-2 focus:ring-indigo-500/20 shadow-2xs" />
                            @if (!string.IsNullOrWhiteSpace(userSearchTerm))
                            {
                                <button type="button" @onclick="ClearUserSearch"
                                        class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white text-xs font-bold cursor-pointer">
                                    &times;
                                </button>
                            }
                        </div>
                        <button type="button" @onclick="ExecuteUserSearch"
                                class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-xs cursor-pointer shrink-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <span>Search</span>
                        </button>
                    </div>
                </div>

                @{
                    var displayedUsers = users
                        .Where(u => string.IsNullOrWhiteSpace(appliedUserSearchTerm) ||
                                    (u.DisplayName != null && u.DisplayName.Contains(appliedUserSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                    (u.UserName != null && u.UserName.Contains(appliedUserSearchTerm, StringComparison.OrdinalIgnoreCase)))
                        .ToList();
                }

                @if (displayedUsers.Count == 0)
                {
                    <div class="p-8 text-center text-xs text-[#7A8CA6]">
                        No users found matching "@appliedUserSearchTerm"
                    </div>
                }
                else
                {
                    <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)] max-h-[720px] overflow-y-auto">
                        @for (int i = 0; i < displayedUsers.Count; i++)
                        {
                            var u = displayedUsers[i];
                            var rank = i + 1;
                            var isSelected = selectedUserId == u.UserId;

                        <button type="button" @onclick="() => SelectUserAsync(u.UserId)" class="w-full text-left p-4 hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/40 transition flex items-center gap-3 cursor-pointer @(isSelected ? "bg-indigo-50/80 dark:bg-indigo-950/40 border-l-4 border-indigo-600" : "")">
                            <span class="font-mono text-xs font-bold @(rank <= 3 ? "text-amber-500" : "text-[#7A8CA6]") w-6 shrink-0">
                                #@rank
                            </span>

                            <UserAvatar Url="@u.AvatarUrl"
                                        Name="@u.DisplayName"
                                        Size="w-9 h-9"
                                        Class="shrink-0 shadow-sm"
                                        BgClass="bg-[#0A1B2E] dark:bg-[#E1E8F0]"
                                        ColorClass="text-white dark:text-[#0A1B2E]"
                                        TextClass="text-xs" />

                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-xs text-[#0A1B2E] dark:text-[#E1E8F0] truncate">
                                    @u.DisplayName
                                </div>
                                <div class="text-[11px] text-[#7A8CA6] font-mono truncate">
                                    @@@u.UserName
                                </div>
                            </div>

                            <div class="text-right shrink-0">
                                <div class="text-xs font-bold text-indigo-600 dark:text-indigo-400">
                                    @u.FollowersCount
                                </div>
                                <div class="text-[10px] text-[#7A8CA6]">
                                    @Loc["Report_User_FollowersLabel"]
                                </div>
                            </div>
                        </button>
                    }
                    </div>
                }
            </div>

            <!-- Right Panel: Selected User Most Liked Posts & Polls -->
            <div class="lg:col-span-7 space-y-6">
                @if (isLoadingContent)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl p-12 text-center border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                        <p class="mt-2 text-xs font-medium text-[#557392] dark:text-[#C4D2E1]">@Loc["Report_User_LoadingContent"]</p>
                    </div>
                }
                else if (userContent == null)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl p-12 text-center border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-500 mx-auto flex items-center justify-center mb-3">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
                        </div>
                        <p class="mt-2 text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Report_User_SelectPromptTitle"]</p>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">@Loc["Report_User_SelectPromptDesc"]</p>
                    </div>
                }
                else
                {
                    <!-- Selected User Header -->
                    <div class="bg-white dark:bg-[#112A46] p-5 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <UserAvatar Url="@userContent.User.AvatarUrl"
                                        Name="@userContent.User.DisplayName"
                                        Size="w-12 h-12"
                                        Class="shrink-0 shadow-sm"
                                        BgClass="bg-[#0A1B2E] dark:bg-[#E1E8F0]"
                                        ColorClass="text-white dark:text-[#0A1B2E]"
                                        TextClass="text-base" />
                            <div>
                                <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@userContent.User.DisplayName</h2>
                                <p class="text-xs text-[#7A8CA6] font-mono">@@@userContent.User.UserName • @string.Format(Loc["Report_User_JoinedDate"], userContent.User.CreatedAt.ToString("dd-MM-yyyy"))</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="text-center px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-[#0A1B2E] border border-slate-200 dark:border-slate-800">
                                <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400">@userContent.User.FollowersCount</div>
                                <div class="text-[10px] text-[#7A8CA6]">@Loc["Report_User_StatFollowers"]</div>
                            </div>
                            <div class="text-center px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-[#0A1B2E] border border-slate-200 dark:border-slate-800">
                                <div class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@userContent.User.PostCount</div>
                                <div class="text-[10px] text-[#7A8CA6]">@Loc["Report_User_StatPosts"]</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Posts Section -->
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
                        <div class="p-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                            <div class="text-xs font-bold uppercase tracking-wider text-[#7A8CA6] font-mono flex items-center gap-2">
                                <svg class="w-4 h-4 text-rose-500 fill-rose-500" viewBox="0 0 24 24"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/></svg>
                                <span>@Loc["Report_User_TopPostsHeading"]</span>
                            </div>
                            <span class="text-xs text-[#7A8CA6] font-mono">@string.Format(Loc["Report_User_ItemsCount"], userContent.TopPosts.Count)</span>
                        </div>

                        @if (!userContent.TopPosts.Any())
                        {
                            <div class="p-8 text-center text-xs text-slate-500 italic">
                                @Loc["Report_User_NoPostsYet"]
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                                @foreach (var p in userContent.TopPosts)
                                {
                                    <div class="p-4 hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/30 transition space-y-2">
                                        <div class="flex items-center justify-between text-xs">
                                            <div class="flex items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(p.GroupName))
                                                {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300">
                                                        @string.Format(Loc["Report_User_PrefixGroup"], p.GroupName)
                                                    </span>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(p.CommunityName))
                                                {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300">
                                                        @string.Format(Loc["Report_User_PrefixCommunity"], p.CommunityName)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">
                                                        @Loc["Report_User_BadgePublicPost"]
                                                    </span>
                                                }
                                                <span class="text-[11px] text-[#7A8CA6] font-mono">@p.CreatedAt.ToString("dd-MM-yyyy")</span>
                                            </div>

                                            <div class="flex items-center gap-3">
                                                <span class="flex items-center gap-1 font-bold text-xs text-rose-500">
                                                    <svg class="w-3.5 h-3.5 fill-rose-500" viewBox="0 0 24 24"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/></svg>
                                                    <span>@p.LikeCount</span>
                                                </span>
                                                <span class="flex items-center gap-1 text-xs text-[#7A8CA6]">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
                                                    <span>@p.CommentCount</span>
                                                </span>
                                            </div>
                                        </div>

                                        <p class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] leading-relaxed whitespace-pre-line line-clamp-3">
                                            @p.Content
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Top Polls Section -->
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
                        <div class="p-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                            <div class="text-xs font-bold uppercase tracking-wider text-[#7A8CA6] font-mono flex items-center gap-2">
                                <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
                                <span>@Loc["Report_User_TopPollsHeading"]</span>
                            </div>
                            <span class="text-xs text-[#7A8CA6] font-mono">@string.Format(Loc["Report_User_PollsCount"], userContent.TopPolls.Count)</span>
                        </div>

                        @if (!userContent.TopPolls.Any())
                        {
                            <div class="p-8 text-center text-xs text-slate-500 italic">
                                @Loc["Report_User_NoPollsYet"]
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                                @foreach (var pl in userContent.TopPolls)
                                {
                                    <div class="p-4 hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/30 transition space-y-2">
                                        <div class="flex items-center justify-between text-xs">
                                            <div class="flex items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(pl.GroupName))
                                                {
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300">
                                                        Group: @pl.GroupName
                                                    </span>
                                                }
                                                <span class="text-[11px] text-[#7A8CA6] font-mono">@pl.CreatedAt.ToString("dd-MM-yyyy")</span>
                                            </div>

                                            <div class="flex items-center gap-3">
                                                <span class="flex items-center gap-1 font-bold text-xs text-indigo-600 dark:text-indigo-400">
                                                    <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                                                    <span>@string.Format(Loc["Report_User_TotalVotes"], pl.TotalVotes)</span>
                                                </span>
                                                <span class="flex items-center gap-1 text-xs text-rose-500">
                                                    <svg class="w-3.5 h-3.5 fill-rose-500" viewBox="0 0 24 24"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/></svg>
                                                    <span>@pl.LikeCount</span>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                            @pl.Question
                                        </div>

                                        @if (pl.Options.Any())
                                        {
                                            <div class="flex flex-wrap gap-1.5 pt-1">
                                                @foreach (var opt in pl.Options)
                                                {
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-slate-100 dark:bg-[#0A1B2E] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800">
                                                        @opt
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoadingUsers = true;
    private bool isLoadingContent = false;
    private IReadOnlyList<UserReportItemModel>? users;
    private int? selectedUserId;
    private UserTopContentModel? userContent;
    private string userSearchTerm = "";
    private string appliedUserSearchTerm = "";

    private void ExecuteUserSearch()
    {
        appliedUserSearchTerm = userSearchTerm.Trim();
    }

    private void ClearUserSearch()
    {
        userSearchTerm = "";
        appliedUserSearchTerm = "";
    }

    private void HandleUserSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteUserSearch();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoadingUsers = true;
        var res = await ReportApi.GetUserReportAsync();
        if (res.IsSuccess && res.Data != null)
        {
            users = res.Data;
            if (users.Any())
            {
                await SelectUserAsync(users.First().UserId);
            }
        }
        isLoadingUsers = false;
    }

    private async Task SelectUserAsync(int userId)
    {
        selectedUserId = userId;
        isLoadingContent = true;
        var res = await ReportApi.GetUserTopContentAsync(userId);
        if (res.IsSuccess && res.Data != null)
        {
            userContent = res.Data;
        }
        isLoadingContent = false;
    }
}
