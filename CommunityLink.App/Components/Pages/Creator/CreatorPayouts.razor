@page "/creator/payouts"
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Payout
@using CommunityLink.Shared.Security
@using Microsoft.Extensions.Localization
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.CreatorPayouts)]
@inject CreatorPayoutApiService PayoutApi
@inject ToastService Toast
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["CreatorPayouts_PageTitle"]</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 text-slate-800 dark:text-slate-200">
    <!-- Header / Breadcrumbs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-[#94A3B8] uppercase tracking-wider mb-1 font-mono">
                <span>@Loc["Creator_Center"]</span>
                <span>&rarr;</span>
                <span class="text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["CreatorPayouts_WithdrawalsAndPayouts"]</span>
            </div>
            <h1 class="text-2xl font-bold text-[#0F172A] dark:text-[#E1E8F0] tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif">@Loc["CreatorPayouts_Heading"]</h1>
            <p class="text-sm text-[#475569] dark:text-[#94A3B8] mt-1">
                @Loc["CreatorPayouts_Subtitle"]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="creator/earnings" class="px-4 py-2 bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] text-[#475569] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#F8FAFC] dark:hover:bg-[#182030] hover:text-[#0F172A] dark:hover:text-white transition-all duration-150 shadow-xs active:scale-[0.98] flex items-center gap-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
                <span>@Loc["CreatorPayouts_EarningsDashboardBtn"]</span>
            </a>
            <button type="button" @onclick="OpenRequestModal" class="px-4 py-2 bg-[#0F172A] hover:bg-[#1E293B] text-white dark:bg-[#E1E8F0] dark:hover:bg-white dark:text-[#0A1B2E] rounded-lg text-xs font-bold transition-all duration-150 shadow-xs active:scale-[0.98] flex items-center gap-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6H2.25m0 0v8.25m0 0h.75A.75.75 0 0 1 3.75 15v.75m0-9.75h16.5m0 0v.75A.75.75 0 0 0 21 6h.75m0 0v8.25m0 0h-.75a.75.75 0 0 0-.75.75v.75m0-9.75v9.75m0 0h-16.5"/></svg>
                <span>@Loc["CreatorPayouts_RequestWithdrawalBtn"]</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-12 text-center shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-200 dark:border-slate-700 border-t-[#0A1B2E] dark:border-t-[#E1E8F0] mb-4"></div>
            <p class="text-sm font-medium text-[#475569] dark:text-[#94A3B8]">@Loc["CreatorPayouts_LoadingSummary"]</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl p-6 text-rose-800 dark:text-rose-200 shadow-xs flex items-start gap-4">
            <div class="flex-1">
                <h3 class="font-bold text-rose-900 dark:text-rose-100">@Loc["CreatorPayouts_ErrorTitle"]</h3>
                <p class="text-sm text-rose-700 dark:text-rose-300 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadData" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition cursor-pointer">
                    @Loc["Common_TryAgain"]
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- SUMMARY CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <!-- Available Earned Balance -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-emerald-500/40 dark:hover:bg-[#182030] dark:hover:border-emerald-400/40">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">@Loc["CreatorPayouts_AvailableEarnings"]</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold shadow-xs">
                        <LinkDropIcon Class="w-5 h-5 shrink-0" />
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @(summary?.AvailableEarnedBalance ?? 0) <span class="text-sm font-normal text-[#64748B]">@Loc["Creator_LinkDrops"]</span>
                </div>
                <div class="text-xs font-mono font-medium text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded-md px-2.5 py-1 inline-block">
                    ≈ @(((summary?.AvailableEarnedBalance ?? 0) * 100m).ToString("N0")) MMK
                </div>
            </div>

            <!-- Pending Payout Amount -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-amber-500/40 dark:hover:bg-[#182030] dark:hover:border-amber-400/40">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">@Loc["CreatorPayouts_PendingPayouts"]</span>
                    <span class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-bold shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @(summary?.PendingPayoutAmount ?? 0) <span class="text-sm font-normal text-[#64748B]">@Loc["Creator_LinkDrops"]</span>
                </div>
                <p class="text-xs text-[#64748B]">@Loc["CreatorPayouts_AwaitingAdminReview"]</p>
            </div>

            <!-- Completed Payout Amount -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:bg-[#112A46] dark:hover:border-[rgba(196,210,225,0.30)]">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">@Loc["CreatorPayouts_CompletedPayouts"]</span>
                    <span class="w-8 h-8 rounded-lg bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center text-sm font-bold shadow-xs">
                        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @(summary?.CompletedPayoutAmount ?? 0) <span class="text-sm font-normal text-[#64748B]">@Loc["Creator_LinkDrops"]</span>
                </div>
                <p class="text-xs text-[#64748B]">@Loc["CreatorPayouts_TotalCashedOut"]</p>
            </div>
        </div>

        <!-- PAYOUT HISTORY TABLE -->
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-4">
                <div>
                    <h2 class="text-lg font-bold text-[#0F172A] dark:text-[#E1E8F0]" style="font-family:'Plus Jakarta Sans',sans-serif">@Loc["CreatorPayouts_WithdrawalHistory"]</h2>
                    <p class="text-xs text-[#475569] dark:text-[#94A3B8]">@Loc["CreatorPayouts_WithdrawalHistorySubtitle"]</p>
                </div>

                <!-- Rows per page selector like CreatorEarnings / AdminUsers -->
                <div class="flex items-center gap-2 shrink-0 text-xs text-[#557392] dark:text-[#C4D2E1] sm:ml-auto">
                    <span class="font-medium">@Loc["Admin_Users_RowsPerPageLabel"]</span>
                    <select value="@pageSize" @onchange="OnPageSizeChanged" class="px-2.5 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#191B23] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 cursor-pointer">
                        <option value="10">@string.Format(Loc["Admin_Finance_RowsPerPage"], 10)</option>
                        <option value="25">@string.Format(Loc["Admin_Finance_RowsPerPage"], 25)</option>
                        <option value="50">@string.Format(Loc["Admin_Finance_RowsPerPage"], 50)</option>
                        <option value="100">@string.Format(Loc["Admin_Finance_RowsPerPage"], 100)</option>
                    </select>
                </div>
            </div>

            @if (payoutList.Count == 0)
            {
                <div class="py-12 px-4 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl space-y-3">
                    <div class="w-12 h-12 bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-slate-400 rounded-full flex items-center justify-center mx-auto text-xl font-bold shadow-xs">
                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6H2.25m0 0v8.25m0 0h.75A.75.75 0 0 1 3.75 15v.75m0-9.75h16.5m0 0v.75A.75.75 0 0 0 21 6h.75m0 0v8.25m0 0h-.75a.75.75 0 0 0-.75.75v.75m0-9.75v9.75m0 0h-16.5"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-[#0F172A] dark:text-white" style="font-family:'Plus Jakarta Sans',sans-serif">@Loc["CreatorPayouts_NoRequestsYet"]</h3>
                    <p class="text-xs text-[#64748B] max-w-sm mx-auto">
                        @Loc["CreatorPayouts_NoRequestsDesc"]
                    </p>
                    <div class="pt-2">
                        <button type="button" @onclick="OpenRequestModal" class="px-4 py-2 bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] dark:hover:bg-white rounded-lg text-xs font-semibold transition shadow-xs cursor-pointer">
                            @Loc["CreatorPayouts_RequestWithdrawalBtn"]
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Desktop Table -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 dark:text-slate-300 border-collapse">
                        <thead>
                            <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em]">
                                <th class="py-3 px-4">@Loc["Admin_Users_ColNo"]</th>
                                <th class="py-3 px-4">@Loc["CreatorPayouts_ColDate"]</th>
                                <th class="py-3 px-4 text-right">@Loc["CreatorPayouts_ColAmountLd"]</th>
                                <th class="py-3 px-4 text-right">@Loc["CreatorPayouts_ColEstMmk"]</th>
                                <th class="py-3 px-4">@Loc["CreatorPayouts_ColPaymentMethod"]</th>
                                <th class="py-3 px-4">@Loc["CreatorPayouts_ColAccountDetails"]</th>
                                <th class="py-3 px-4 text-center">@Loc["CreatorPayouts_ColStatus"]</th>
                                <th class="py-3 px-4">@Loc["CreatorPayouts_ColNotes"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                            @{
                                var currentPagedList = pagedPayouts.ToList();
                                for (var index = 0; index < currentPagedList.Count; index++)
                                {
                                    var p = currentPagedList[index];
                                    var rowNo = (pageNumber - 1) * pageSize + index + 1;
                                    <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                        <td class="py-3.5 px-4 font-mono text-xs text-[#7A8CA6] whitespace-nowrap">
                                            @(rowNo).
                                        </td>
                                        <td class="py-3.5 px-4 font-mono text-xs text-[#64748B]">
                                            @p.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-mono font-bold text-[#0F172A] dark:text-white">
                                            @p.AmountLinkDrops LD
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-mono font-medium text-emerald-600 dark:text-emerald-400">
                                            @p.AmountMMK.ToString("N0") MMK
                                        </td>
                                        <td class="py-3.5 px-4 font-semibold text-[#0F172A] dark:text-[#E1E8F0]">
                                            @p.PaymentMethod
                                        </td>
                                        <td class="py-3.5 px-4 text-xs text-[#475569] dark:text-[#C4D2E1]">
                                            <div><span class="font-medium text-[#0F172A] dark:text-white">@p.PaymentAccountName</span></div>
                                            <div class="font-mono text-[#64748B]">@p.PaymentAccountNumber</div>
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            @if (p.Status == "PENDING")
                                            {
                                                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300">
                                                    @Loc["CreatorPayouts_StatusPending"]
                                                </span>
                                            }
                                            else if (p.Status == "COMPLETED")
                                            {
                                                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300">
                                                    @Loc["CreatorPayouts_StatusCompleted"]
                                                </span>
                                            }
                                            else if (p.Status == "APPROVED")
                                            {
                                                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300">
                                                    @Loc["CreatorPayouts_StatusApproved"]
                                                </span>
                                            }
                                            else if (p.Status == "REJECTED")
                                            {
                                                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-800 dark:text-rose-300">
                                                    @Loc["CreatorPayouts_StatusRejected"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-800 dark:text-rose-300">
                                                    @p.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="py-3.5 px-4 text-xs text-[#64748B] max-w-xs truncate">
                                            @(string.IsNullOrWhiteSpace(p.AdminNote) ? "-" : p.AdminNote)
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Cards -->
                <div class="block md:hidden space-y-3">
                    @{
                        var mobilePayoutList = pagedPayouts.ToList();
                        for (var index = 0; index < mobilePayoutList.Count; index++)
                        {
                            var p = mobilePayoutList[index];
                            var rowNo = (pageNumber - 1) * pageSize + index + 1;
                            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-4 space-y-2 shadow-xs transition-all duration-150 hover:-translate-y-0.5 hover:shadow-xs">
                                <div class="flex items-center justify-between text-xs border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-2">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-[#7A8CA6]">@(rowNo).</span>
                                        <span class="font-mono text-[#64748B]">@p.CreatedAt.ToString("dd-MM-yyyy HH:mm")</span>
                                    </div>
                                    <span class="px-2 py-0.5 rounded text-[11px] font-semibold @(p.Status == "PENDING" ? "bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800" : (p.Status == "COMPLETED" || p.Status == "APPROVED") ? "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-900/50")">
                                        @(p.Status == "PENDING" ? Loc["CreatorPayouts_StatusPending"] : p.Status == "COMPLETED" ? Loc["CreatorPayouts_StatusCompleted"] : p.Status == "APPROVED" ? Loc["CreatorPayouts_StatusApproved"] : p.Status == "REJECTED" ? Loc["CreatorPayouts_StatusRejected"] : p.Status)
                                    </span>
                                </div>
                                <div class="flex justify-between items-baseline">
                                    <div class="text-base font-extrabold font-mono text-[#0F172A] dark:text-white">@p.AmountLinkDrops LD</div>
                                    <div class="text-sm font-bold font-mono text-emerald-600 dark:text-emerald-400">@p.AmountMMK.ToString("N0") MMK</div>
                                </div>
                                <div class="text-xs text-[#475569] dark:text-[#C4D2E1] bg-[#F8FAFC] dark:bg-[#191B23] p-2.5 rounded-lg border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                                    <div><span class="font-bold text-[#0F172A] dark:text-[#E1E8F0]">@Loc["CreatorPayouts_LabelMethod"]</span> @p.PaymentMethod</div>
                                    <div><span class="font-bold text-[#0F172A] dark:text-[#E1E8F0]">@Loc["CreatorPayouts_LabelAccount"]</span> @p.PaymentAccountName (<span class="font-mono">@p.PaymentAccountNumber</span>)</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.AdminNote))
                                {
                                    <div class="text-xs text-[#64748B] italic">@Loc["CreatorPayouts_LabelNote"] @p.AdminNote</div>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Modern Pagination Bar -->
                <div class="px-6 py-3.5 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs bg-[#F8FAFC] dark:bg-[#191B23] -mx-6 -mb-6 rounded-b-xl">
                    <!-- Item Range Stats -->
                    <div class="text-[#557392] dark:text-[#C4D2E1] font-medium">
                        @if (totalCount > 0)
                        {
                            var startItem = (pageNumber - 1) * pageSize + 1;
                            var endItem = Math.Min(pageNumber * pageSize, totalCount);
                            <span>@string.Format(Loc["Admin_Users_ShowingRange"], startItem, endItem, totalCount)</span>
                        }
                        else
                        {
                            <span>@Loc["Admin_Users_NoRecords"]</span>
                        }
                    </div>

                    <!-- Pagination Navigation Controls -->
                    <div class="flex items-center gap-1.5">
                        <button type="button" @onclick="GoToFirstPage" disabled="@(pageNumber <= 1)" title="@Loc["Admin_Users_PaginationFirst"]" class="px-2.5 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#557392] dark:text-[#C4D2E1] font-semibold hover:bg-slate-100 dark:hover:bg-[#1E2638] disabled:opacity-40 transition cursor-pointer">
                            @Loc["Admin_Users_PaginationFirst"]
                        </button>
                        <button type="button" @onclick="PreviousPage" disabled="@(pageNumber <= 1)" title="@Loc["Admin_Users_PaginationPrev"]" class="px-3 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#557392] dark:text-[#C4D2E1] font-semibold hover:bg-slate-100 dark:hover:bg-[#1E2638] disabled:opacity-40 transition cursor-pointer">
                            @Loc["Admin_Users_PaginationPrev"]
                        </button>
                        
                        <span class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-[#1E2638] text-[#0A1B2E] dark:text-[#E1E8F0] font-mono font-bold">
                            @string.Format(Loc["Admin_Users_PaginationPageOf"], pageNumber, totalPages)
                        </span>

                        <button type="button" @onclick="NextPage" disabled="@(pageNumber >= totalPages)" title="@Loc["Admin_Users_PaginationNext"]" class="px-3 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#557392] dark:text-[#C4D2E1] font-semibold hover:bg-slate-100 dark:hover:bg-[#1E2638] disabled:opacity-40 transition cursor-pointer">
                            @Loc["Admin_Users_PaginationNext"]
                        </button>
                        <button type="button" @onclick="GoToLastPage" disabled="@(pageNumber >= totalPages)" title="@Loc["Admin_Users_PaginationLast"]" class="px-2.5 py-1.5 rounded-lg border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#557392] dark:text-[#C4D2E1] font-semibold hover:bg-slate-100 dark:hover:bg-[#1E2638] disabled:opacity-40 transition cursor-pointer">
                            @Loc["Admin_Users_PaginationLast"]
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- REQUEST WITHDRAWAL MODAL -->
@if (showModal)
{
