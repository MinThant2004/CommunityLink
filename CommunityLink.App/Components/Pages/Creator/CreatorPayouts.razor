                        <label class="block text-xs font-bold font-mono text-[#475569] dark:text-[#94A3B8] uppercase tracking-wider mb-1">@Loc["CreatorPayouts_FieldAmount"]</label>
                        <input type="number" min="1" max="@(summary?.AvailableEarnedBalance ?? 0)" @bind="requestModelAmount"
                               class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg px-3.5 py-2 text-sm text-[#0F172A] dark:text-[#E1E8F0] font-mono focus:border-[#0A1B2E] focus:ring-2 focus:ring-[#0A1B2E]/20 focus:outline-none" />
                        <p class="text-[11px] text-[#64748B] mt-1">@Loc["CreatorPayouts_FieldEstValue"] <span class="font-semibold font-mono text-emerald-600 dark:text-emerald-400">@((requestModelAmount * 100m).ToString("N0")) MMK</span></p>
                    </div>

                    <div>
