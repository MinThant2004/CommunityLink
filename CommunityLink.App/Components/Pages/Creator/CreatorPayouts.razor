}

@code {
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showModal = false;
    private string? errorMessage;

    private CreatorPayoutSummaryModel? summary;
    private List<CreatorPayoutModel> payoutList = new();

    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount => payoutList.Count;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    private IEnumerable<CreatorPayoutModel> pagedPayouts =>
        payoutList.Skip((pageNumber - 1) * pageSize).Take(pageSize);

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            pageNumber = 1;
        }
    }

    private void GoToFirstPage()
    {
        if (pageNumber > 1) pageNumber = 1;
    }

    private void GoToLastPage()
    {
        if (pageNumber < totalPages) pageNumber = totalPages;
    }

    private void PreviousPage()
    {
        if (pageNumber > 1) pageNumber--;
    }

    private void NextPage()
    {
        if (pageNumber < totalPages) pageNumber++;
    }

    private long requestModelAmount = 10;
    private string requestModelPaymentMethod = "KBZPay";
    private string requestModelAccountName = "";
    private string requestModelAccountNumber = "";

    private CreatePayoutRequestModel requestModel => new(requestModelAmount, requestModelPaymentMethod, requestModelAccountName, requestModelAccountNumber);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var summaryRes = await PayoutApi.GetMyPayoutSummaryAsync();
            if (summaryRes.IsSuccess && summaryRes.Data != null)
            {
                summary = summaryRes.Data;
            }

            var listRes = await PayoutApi.GetMyPayoutsAsync();
            if (listRes.IsSuccess && listRes.Data != null)
            {
                payoutList = listRes.Data.ToList();
                if (pageNumber > totalPages)
                {
                    pageNumber = totalPages;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private void OpenRequestModal()
    {
        requestModelAmount = Math.Min(10, summary?.AvailableEarnedBalance ?? 10);
        if (requestModelAmount <= 0) requestModelAmount = 10;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SubmitRequest()
    {
        if (requestModelAmount <= 0)
        {
            Toast.Error(Loc["CreatorPayouts_Validation_AmountPositive"]);
            return;
        }

        if (string.IsNullOrWhiteSpace(requestModelAccountName) || string.IsNullOrWhiteSpace(requestModelAccountNumber))
        {
            Toast.Error(Loc["CreatorPayouts_Validation_AccountRequired"]);
            return;
        }

        isSubmitting = true;
        var res = await PayoutApi.CreatePayoutRequestAsync(requestModel);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? Loc["CreatorPayouts_Toast_SubmitSuccess"]);
            showModal = false;
            await LoadData();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["CreatorPayouts_Toast_SubmitFailed"]);
        }
    }
}
