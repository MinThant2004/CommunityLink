@page "/creator/earnings"
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Creator
@using CommunityLink.Shared.Security
@using System.Security.Claims
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.CreatorEarnings)]
@inject CreatorEarningsApiService EarningsApi
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Creator Earnings - CommunityLink</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 text-slate-800 dark:text-slate-200">
    <!-- Navigation / Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-[#94A3B8] uppercase tracking-wider mb-1 font-mono">
                <span>Creator Center</span>
                <span>&rarr;</span>
                <span class="text-[#0A1B2E] dark:text-[#E1E8F0]">Earnings Dashboard</span>
            </div>
            <h1 class="text-2xl font-bold text-[#0F172A] dark:text-[#E1E8F0] tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif">Earnings Dashboard</h1>
            <p class="text-sm text-[#475569] dark:text-[#94A3B8] mt-1">
                Monitor your revenue from Paid Chat Groups and platform commissions.
            </p>
        </div>

    </div>

    @if (isLoading)
    {
        <!-- Clean Loading State -->
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-12 text-center shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-200 dark:border-slate-700 border-t-[#0A1B2E] dark:border-t-[#E1E8F0] mb-4"></div>
            <p class="text-sm font-medium text-[#475569] dark:text-[#94A3B8]">Loading your creator earnings...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <!-- Clean Error State -->
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl p-6 text-rose-800 dark:text-rose-200 shadow-xs flex items-start gap-4">
            <svg class="w-6 h-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <div class="flex-1">
                <h3 class="font-bold text-rose-900 dark:text-rose-100">Unable to load earnings</h3>
                <p class="text-sm text-rose-700 dark:text-rose-300 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadEarningsData" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition cursor-pointer">
                    Retry
                </button>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- SUMMARY CARDS SECTION -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Card 1: Available Earnings -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-emerald-500/40 dark:hover:bg-[#182030] dark:hover:border-emerald-400/40">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">Available Earnings</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold shadow-xs">
                        <LinkDropIcon Class="w-5 h-5 shrink-0" />
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @dashboard.Summary.AvailableEarnings <span class="text-sm font-normal text-[#64748B]">Link Drops</span>
                </div>
                <div class="text-xs font-mono font-medium text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded-md px-2.5 py-1 inline-block">
                    Est. Value: @dashboard.Summary.EstimatedValueMmk.ToString("N0") MMK
                </div>
            </div>

            <!-- Card 2: Total Earned -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:bg-[#182030] dark:hover:border-[rgba(196,210,225,0.40)]">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">Total Earned</span>
                    <span class="w-8 h-8 rounded-lg bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center text-sm font-bold shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"/></svg>
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @dashboard.Summary.TotalEarned <span class="text-sm font-normal text-[#64748B]">Link Drops</span>
                </div>
                <p class="text-xs text-[#64748B]">Gross revenue from group joins + private chat unlocks</p>
            </div>

            <!-- Card 3: Net Earnings -->
            <div class="bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-emerald-300 dark:hover:border-emerald-700">
                <div class="flex items-center justify-between text-emerald-700 dark:text-emerald-300">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">Net Earnings</span>
                    <span class="w-8 h-8 rounded-lg bg-white dark:bg-emerald-900/50 border border-emerald-200 dark:border-emerald-800/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-emerald-700 dark:text-emerald-400">
                    @dashboard.Summary.NetEarnings <span class="text-sm font-normal text-emerald-600 dark:text-emerald-500">Link Drops</span>
                </div>
                <p class="text-xs text-emerald-700 dark:text-emerald-300">After platform commission deducted</p>
            </div>

            <!-- Card 4: Total Transactions -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-2 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:bg-[#182030] dark:hover:border-[rgba(196,210,225,0.40)]">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-semibold uppercase tracking-wider font-mono">Total Transactions</span>
                    <span class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-[#191B23] border border-slate-200 dark:border-[rgba(255,255,255,0.08)] text-slate-700 dark:text-slate-300 flex items-center justify-center text-sm font-bold shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"/></svg>
                    </span>
                </div>
                <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                    @dashboard.Summary.TotalTransactions
                </div>
                <p class="text-xs text-[#64748B]">Successful paid member joins</p>
            </div>
        </div>

        <!-- GROUP & SOURCE EARNINGS BREAKDOWN SECTION -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- 1. GROUP EARNINGS BREAKDOWN -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs space-y-4 transition-all duration-200 hover:shadow-md hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)]">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold text-[#0F172A] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Plus Jakarta Sans',sans-serif">
                            <svg class="w-5 h-5 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
                            <span>Earnings by Chat Group</span>
                        </h2>
                        <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Total LinkDrops received from group join requests</p>
                    </div>
                    @if (selectedChatGroupId.HasValue)
                    {
                        <button type="button" @onclick="ClearGroupFilter" class="px-2.5 py-1 bg-[#F1F5F9] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] text-[#475569] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#E2E8F0] dark:hover:bg-[#1E2638] transition cursor-pointer">
                            Clear Filter
                        </button>
                    }
                </div>

                @if (dashboard.GroupBreakdown.Count == 0)
                {
                    <div class="py-8 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl">
                        <p class="text-xs text-[#64748B] italic">No group earnings recorded yet.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2.5 max-h-[360px] overflow-y-auto pr-1">
                        @foreach (var (grp, index) in dashboard.GroupBreakdown.Select((g, i) => (g, i)))
                        {
                            var isSelected = selectedChatGroupId == grp.ChatGroupId;
                            <div @onclick="() => FilterByGroup(grp.ChatGroupId)"
                                 class="cursor-pointer border rounded-xl p-3.5 transition-all duration-150 hover:-translate-y-0.5 hover:shadow-xs flex items-center justify-between gap-3 @(isSelected ? "border-[#0A1B2E] dark:border-[#E1E8F0] bg-[#0A1B2E]/5 dark:bg-[#112A46]/60 ring-2 ring-[#0A1B2E]/20 dark:ring-[#E1E8F0]/20" : "border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#191B23] hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)] hover:bg-[#F8FAFC] dark:hover:bg-[#1E2638]")">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold font-mono shrink-0 @(index == 0 ? "bg-slate-200 dark:bg-slate-700 text-[#0A1B2E] dark:text-white border border-slate-300 dark:border-slate-600" : index == 1 ? "bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700" : "bg-slate-100 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400")">
                                        #@(index + 1)
                                    </div>
                                    <div class="min-w-0">
                                        <div class="font-bold text-sm text-[#0F172A] dark:text-[#E1E8F0] truncate">@grp.ChatGroupName</div>
                                        <div class="text-xs text-[#64748B]">@grp.TransactionCount @(grp.TransactionCount == 1 ? "paid join" : "paid joins")</div>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <div class="text-sm font-extrabold font-mono text-[#0A1B2E] dark:text-[#E1E8F0]">@grp.TotalEarned LD</div>
                                    <div class="text-[11px] text-[#64748B]">Received</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 2. EARNINGS BY SOURCE (GROUP JOINS VS PRIVATE CHAT UNLOCKS) -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs space-y-4 transition-all duration-200 hover:shadow-md hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)]">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-bold text-[#0F172A] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Plus Jakarta Sans',sans-serif">
                            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                            <span>Earnings by Source</span>
                        </h2>
                        <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Paid group joins vs private chat unlocks</p>
                    </div>
                    @if (activeFilterType == "GROUP" || activeFilterType == "PRIVATE_CHAT")
                    {
                        <button type="button" @onclick='() => SetFilterType("ALL")' class="px-2.5 py-1 bg-[#F1F5F9] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] text-[#475569] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#E2E8F0] dark:hover:bg-[#1E2638] transition cursor-pointer">
                            Clear Filter
                        </button>
                    }
                </div>

                <!-- Share bar: solid two-segment (no gradients) -->
                @{
                    var groupShare = GetSourceSharePercent("GROUP", dashboard.SourceBreakdown);
                    var hasSourceData = dashboard.SourceBreakdown.Sum(s => s.Gross) > 0;
                    var privateShare = hasSourceData ? 100 - groupShare : 0;
                }
                <div class="w-full h-2.5 rounded-full bg-[#E2E8F0] dark:bg-[#191B23] overflow-hidden flex border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                    <div class="h-full bg-[#0A1B2E] dark:bg-[#E1E8F0]" style="width: @groupShare%"></div>
                    <div class="h-full bg-emerald-500" style="width: @privateShare%"></div>
                </div>

                <div class="space-y-3">
                    @foreach (var src in dashboard.SourceBreakdown)
                    {
                        var isSelected = activeFilterType == src.Source;
                        var isGroup = src.Source == "GROUP";
                        <div @onclick="() => ToggleSourceFilter(src.Source)"
                             class="cursor-pointer border rounded-xl p-4 transition-all duration-150 hover:-translate-y-0.5 hover:shadow-xs @(isSelected ? "ring-2 " + (isGroup ? "border-[#0A1B2E] dark:border-[#E1E8F0] bg-[#0A1B2E]/5 dark:bg-[#112A46]/60 ring-[#0A1B2E]/20 dark:ring-[#E1E8F0]/20" : "border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 ring-emerald-500/20") : "border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#191B23] hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)] hover:bg-[#F8FAFC] dark:hover:bg-[#1E2638]")">
                            <div class="flex items-center justify-between gap-3 mb-2">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 @(isGroup ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#111622]" : "bg-emerald-500 text-white")">
                                        @if (isGroup)
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <div class="font-bold text-sm text-[#0F172A] dark:text-[#E1E8F0]">@src.Label</div>
                                        <div class="text-xs text-[#64748B]">@src.TransactionCount @(src.TransactionCount == 1 ? (isGroup ? "paid join" : "unlock") : (isGroup ? "paid joins" : "unlocks"))</div>
                                    </div>
                                </div>
                                <span class="text-xs font-bold px-2 py-0.5 rounded-lg shrink-0 @(isGroup ? "bg-slate-100 dark:bg-slate-800 text-[#0A1B2E] dark:text-[#E1E8F0] border border-slate-200 dark:border-slate-700" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800")">
                                    @GetSourceSharePercent(src.Source, dashboard.SourceBreakdown)% share
                                </span>
                            </div>
                            <div class="flex items-end justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="text-xl font-extrabold font-mono @(isGroup ? "text-[#0A1B2E] dark:text-[#E1E8F0]" : "text-emerald-600 dark:text-emerald-400")">+@src.Net LD</div>
                                    <div class="text-[11px] text-[#64748B] font-mono">Est. @(src.Net * 100) MMK</div>
                                </div>
                                <div class="text-right text-[11px] text-[#64748B] font-mono shrink-0 leading-relaxed">
                                    <div>Gross @src.Gross</div>
                                    <div>− Commission @src.Commission</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- EARNINGS HISTORY TABLE SECTION -->
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-4">
                <div>
                    <h2 class="text-lg font-bold text-[#0F172A] dark:text-[#E1E8F0]" style="font-family:'Plus Jakarta Sans',sans-serif">Earnings History</h2>
                    <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Detailed transaction log for group joins and private chat unlocks</p>
                </div>

                <!-- Filters -->
                <div class="flex items-center gap-2">
                    <button type="button" @onclick='() => SetFilterType("ALL")'
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition border cursor-pointer @(activeFilterType == "ALL" ? "bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#112A46] dark:hover:bg-[#1B3B5A] dark:text-[#E1E8F0] border-[#0A1B2E] dark:border-[rgba(196,210,225,0.20)] shadow-xs" : "bg-white dark:bg-[#191B23] text-[#475569] dark:text-[#C4D2E1] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] hover:bg-[#F8FAFC] dark:hover:bg-[#1E2638]")">
                        All
                    </button>
                    <button type="button" @onclick='() => SetFilterType("GROUP")'
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition border cursor-pointer @(activeFilterType == "GROUP" ? "bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#112A46] dark:hover:bg-[#1B3B5A] dark:text-[#E1E8F0] border-[#0A1B2E] dark:border-[rgba(196,210,225,0.20)] shadow-xs" : "bg-white dark:bg-[#191B23] text-[#475569] dark:text-[#C4D2E1] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] hover:bg-[#F8FAFC] dark:hover:bg-[#1E2638]")">
                        Group Joins
                    </button>
                    <button type="button" @onclick='() => SetFilterType("PRIVATE_CHAT")'
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition border cursor-pointer @(activeFilterType == "PRIVATE_CHAT" ? "bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#112A46] dark:hover:bg-[#1B3B5A] dark:text-[#E1E8F0] border-[#0A1B2E] dark:border-[rgba(196,210,225,0.20)] shadow-xs" : "bg-white dark:bg-[#191B23] text-[#475569] dark:text-[#C4D2E1] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] hover:bg-[#F8FAFC] dark:hover:bg-[#1E2638]")">
                        Private Chat
                    </button>
                </div>
            </div>

            @if (dashboard.Transactions.Count == 0)
            {
                <!-- EMPTY STATE -->
                <div class="py-12 px-4 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl space-y-3">
                    <div class="w-12 h-12 bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-slate-400 rounded-full flex items-center justify-center mx-auto text-xl font-bold shadow-xs">
                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-[#0F172A] dark:text-white" style="font-family:'Plus Jakarta Sans',sans-serif">No earnings yet.</h3>
                    <p class="text-xs text-[#64748B] max-w-sm mx-auto">
                        Create a Paid Chat Group and start earning when users join.
                    </p>
                    <div class="pt-2">
                        <a href="chat?type=groups&amp;create=1" class="inline-flex items-center gap-2 px-4 py-2 bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] dark:hover:bg-white rounded-lg text-xs font-semibold transition shadow-xs">
                            Create a Paid Group
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Desktop / Tablet Table View -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 dark:text-slate-300 border-collapse">
                        <thead>
                            <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em]">
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4">Chat Group</th>
                                <th class="py-3 px-4">Buyer</th>
                                <th class="py-3 px-4 text-right">Gross</th>
                                <th class="py-3 px-4 text-right">Commission</th>
                                <th class="py-3 px-4 text-right">Net</th>
                                <th class="py-3 px-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                            @foreach (var tx in dashboard.Transactions)
                            {
                                <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                    <td class="py-3.5 px-4 font-mono text-xs text-[#64748B]">
                                        @tx.Date.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4 font-semibold text-[#0F172A] dark:text-[#E1E8F0]">
                                        @tx.ChatGroupName
                                    </td>
                                    <td class="py-3.5 px-4 text-[#475569] dark:text-[#C4D2E1]">
                                        @tx.BuyerName
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-medium text-[#0F172A] dark:text-[#E1E8F0]">
                                        @tx.GrossAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-medium text-rose-600 dark:text-rose-400">
                                        -@tx.CommissionAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">
                                        +@tx.NetAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400">
                                            @tx.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Responsive List View -->
                <div class="block md:hidden space-y-3">
                    @foreach (var tx in dashboard.Transactions)
                    {
                        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-4 space-y-2 shadow-xs transition-all duration-150 hover:-translate-y-0.5 hover:shadow-xs">
                            <div class="flex items-center justify-between text-xs border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-2">
                                <span class="font-mono text-[#64748B]">@tx.Date.ToString("MMM dd, yyyy HH:mm")</span>
                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400">
                                    @tx.Status
                                </span>
                            </div>
                            <div>
                                <div class="font-bold text-sm text-[#0F172A] dark:text-[#E1E8F0]">@tx.ChatGroupName</div>
                                <div class="text-xs text-[#64748B] mt-0.5">Buyer: <span class="font-medium text-[#475569] dark:text-[#C4D2E1]">@tx.BuyerName</span></div>
                            </div>
                            <div class="pt-2 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] grid grid-cols-3 gap-2 text-center text-xs">
                                <div>
                                    <span class="text-[#64748B] block text-[10px] uppercase font-mono">Gross</span>
                                    <span class="font-semibold font-mono text-[#475569] dark:text-[#C4D2E1]">@tx.GrossAmount LD</span>
                                </div>
                                <div>
                                    <span class="text-[#64748B] block text-[10px] uppercase font-mono">Commission</span>
                                    <span class="font-semibold font-mono text-rose-600 dark:text-rose-400">-@tx.CommissionAmount LD</span>
                                </div>
                                <div>
                                    <span class="text-[#64748B] block text-[10px] uppercase font-mono">Net</span>
                                    <span class="font-bold font-mono text-emerald-600 dark:text-emerald-400">+@tx.NetAmount LD</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private CreatorEarningsDashboardModel? dashboard;
    private string activeFilterType = "ALL";
    private int? selectedChatGroupId;

    protected override async Task OnInitializedAsync()
    {
        await LoadEarningsData();
    }

    private async Task LoadEarningsData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await EarningsApi.GetEarningsAsync(activeFilterType, selectedChatGroupId);
            if (res.IsSuccess && res.Data != null)
            {
                dashboard = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load creator earnings.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private async Task SetFilterType(string filterType)
    {
        activeFilterType = filterType;
        selectedChatGroupId = null;
        await LoadEarningsData();
    }

    private async Task ToggleSourceFilter(string source)
    {
        if (activeFilterType == source)
        {
            activeFilterType = "ALL";
        }
        else
        {
            activeFilterType = source;
            selectedChatGroupId = null;
        }
        await LoadEarningsData();
    }

    private int GetSourceSharePercent(string source, IReadOnlyList<CreatorSourceEarningsModel> sources)
    {
        if (sources.Count == 0)
        {
            return 0;
        }

        long totalNet = sources.Sum(s => s.Net);
        long totalGross = sources.Sum(s => s.Gross);
        bool useNet = totalNet > 0;
        long total = useNet ? totalNet : totalGross;
        if (total <= 0)
        {
            return 0;
        }

        var src = sources.FirstOrDefault(s => s.Source == source);
        if (src is null)
        {
            return 0;
        }

        long value = useNet ? src.Net : src.Gross;
        return (int)Math.Round(value * 100.0 / total);
    }

    private async Task FilterByGroup(int chatGroupId)
    {
        if (selectedChatGroupId == chatGroupId)
        {
            selectedChatGroupId = null;
        }
        else
        {
            selectedChatGroupId = chatGroupId;
        }
        await LoadEarningsData();
    }

    private async Task ClearGroupFilter()
    {
        selectedChatGroupId = null;
        await LoadEarningsData();
    }
}
