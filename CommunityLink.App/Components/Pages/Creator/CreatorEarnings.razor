@page "/creator/earnings"
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Creator
@using System.Security.Claims
@inject CreatorEarningsApiService EarningsApi
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Creator Earnings - CommunityLink</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Navigation / Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">
                <span>Creator Center</span>
                <span>&rarr;</span>
                <span class="text-indigo-600">Earnings Dashboard</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Earnings Dashboard</h1>
            <p class="text-sm text-slate-600 mt-1">
                Monitor your revenue from Paid Chat Groups and platform commissions.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="chat-groups" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-semibold hover:bg-slate-800 transition shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Manage Chat Groups
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <!-- Clean Loading State -->
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-200 border-t-indigo-600 mb-4"></div>
            <p class="text-sm font-medium text-slate-600">Loading your creator earnings...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <!-- Clean Error State -->
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-6 text-rose-800 shadow-sm flex items-start gap-4">
            <svg class="w-6 h-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <div class="flex-1">
                <h3 class="font-bold text-rose-900">Unable to load earnings</h3>
                <p class="text-sm text-rose-700 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadEarningsData" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition">
                    Retry
                </button>
            </div>
        </div>
    }
    else if (dashboard != null)
    {
        <!-- SUMMARY CARDS SECTION -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Card 1: Available Earnings -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-semibold uppercase tracking-wider">Available Earnings</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center text-sm font-bold">💧</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @dashboard.Summary.AvailableEarnings <span class="text-sm font-normal text-slate-500">Link Drops</span>
                </div>
                <div class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-md px-2.5 py-1 inline-block">
                    Est. Value: @dashboard.Summary.EstimatedValueMmk.ToString("N0") MMK
                </div>
            </div>

            <!-- Card 2: Total Earned -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-semibold uppercase tracking-wider">Total Earned</span>
                    <span class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 flex items-center justify-center text-sm font-bold">📈</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @dashboard.Summary.TotalEarned <span class="text-sm font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Gross revenue generated from paid joins</p>
            </div>

            <!-- Card 3: Total Commission -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-semibold uppercase tracking-wider">Total Commission</span>
                    <span class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center text-sm font-bold">🏛️</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @dashboard.Summary.TotalCommission <span class="text-sm font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Platform maintenance commission deducted</p>
            </div>

            <!-- Card 4: Total Transactions -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-semibold uppercase tracking-wider">Total Transactions</span>
                    <span class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center text-sm font-bold">🧾</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @dashboard.Summary.TotalTransactions
                </div>
                <p class="text-xs text-slate-500">Successful paid member joins</p>
            </div>
        </div>

        <!-- EARNINGS BREAKDOWN SECTION -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-5">
            <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Earnings Breakdown</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Gross -->
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Gross Earnings</div>
                    <div class="text-xl font-bold text-slate-800">@dashboard.Summary.GrossEarnings Link Drops</div>
                    <p class="text-xs text-slate-500 mt-1">Total revenue collected from buyers</p>
                </div>

                <!-- Commission -->
                <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Platform Commission</div>
                    <div class="text-xl font-bold text-rose-700">- @dashboard.Summary.PlatformCommission Link Drops</div>
                    <p class="text-xs text-slate-500 mt-1">Deducted platform service fee</p>
                </div>

                <!-- Net Earnings (Visually Prominent Accent Block) -->
                <div class="bg-emerald-50 border-2 border-emerald-300 rounded-lg p-4">
                    <div class="text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1">Net Earnings</div>
                    <div class="text-2xl font-extrabold text-emerald-700">@dashboard.Summary.NetEarnings Link Drops</div>
                    <p class="text-xs font-medium text-emerald-800 mt-1">Total net earnings credited to creator wallet</p>
                </div>
            </div>
        </div>

        <!-- GROUP EARNINGS BREAKDOWN SECTION -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">My Chat Groups</h2>
                    <p class="text-xs text-slate-500">Breakdown of revenue per chat group</p>
                </div>
                @if (selectedChatGroupId.HasValue)
                {
                    <button type="button" @onclick="ClearGroupFilter" class="px-3 py-1 bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-200 transition">
                        Show All Groups
                    </button>
                }
            </div>

            @if (dashboard.GroupBreakdown.Count == 0)
            {
                <p class="text-sm text-slate-500 italic">No Chat Groups found.</p>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    @foreach (var grp in dashboard.GroupBreakdown)
                    {
                        var isSelected = selectedChatGroupId == grp.ChatGroupId;
                        <div @onclick="() => FilterByGroup(grp.ChatGroupId)"
                             class="cursor-pointer border rounded-xl p-4 transition text-left relative overflow-hidden @(isSelected ? "border-indigo-600 bg-indigo-50/40 ring-2 ring-indigo-600/20" : "border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50")">
                            <div class="font-bold text-sm text-slate-900 truncate">@grp.ChatGroupName</div>
                            <div class="text-xs text-slate-500 mt-1">@grp.TransactionCount @(grp.TransactionCount == 1 ? "join" : "joins")</div>
                            <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between">
                                <span class="text-xs font-medium text-slate-600">Total Earned:</span>
                                <span class="text-sm font-bold text-indigo-600">@grp.TotalEarned LD</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- EARNINGS HISTORY TABLE SECTION -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Earnings History</h2>
                    <p class="text-xs text-slate-500">Detailed transaction log for paid joins</p>
                </div>

                <!-- Filters -->
                <div class="flex items-center gap-2">
                    <button type="button" @onclick='() => SetFilterType("ALL")'
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition border @(activeFilterType == "ALL" ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50")">
                        All
                    </button>
                    <button type="button" @onclick='() => SetFilterType("GROUP")'
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold transition border @(activeFilterType == "GROUP" ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50")">
                        Group Payments
                    </button>
                </div>
            </div>

            @if (dashboard.Transactions.Count == 0)
            {
                <!-- EMPTY STATE (No gradient illustrations) -->
                <div class="py-12 px-4 text-center bg-slate-50 border border-slate-200 rounded-xl space-y-3">
                    <div class="w-12 h-12 bg-white border border-slate-200 text-slate-400 rounded-full flex items-center justify-center mx-auto text-xl font-bold">
                        💳
                    </div>
                    <h3 class="text-base font-bold text-slate-800">No earnings yet.</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto">
                        Create a Paid Chat Group and start earning when users join.
                    </p>
                    <div class="pt-2">
                        <a href="chat-groups" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 transition">
                            Create a Paid Group
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Desktop / Tablet Table View -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500 tracking-wider">
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4">Chat Group</th>
                                <th class="py-3 px-4">Buyer</th>
                                <th class="py-3 px-4 text-right">Gross</th>
                                <th class="py-3 px-4 text-right">Commission</th>
                                <th class="py-3 px-4 text-right">Net</th>
                                <th class="py-3 px-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var tx in dashboard.Transactions)
                            {
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="py-3.5 px-4 font-mono text-xs text-slate-600">
                                        @tx.Date.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4 font-semibold text-slate-900">
                                        @tx.ChatGroupName
                                    </td>
                                    <td class="py-3.5 px-4 text-slate-700">
                                        @tx.BuyerName
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-medium text-slate-800">
                                        @tx.GrossAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-medium text-rose-600">
                                        -@tx.CommissionAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-emerald-600">
                                        +@tx.NetAmount LD
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700">
                                            @tx.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Responsive List View (No Horizontal Overflow) -->
                <div class="block md:hidden space-y-3">
                    @foreach (var tx in dashboard.Transactions)
                    {
                        <div class="bg-white border border-slate-200 rounded-xl p-4 space-y-2 shadow-sm">
                            <div class="flex items-center justify-between text-xs border-b border-slate-100 pb-2">
                                <span class="font-mono text-slate-500">@tx.Date.ToString("MMM dd, yyyy HH:mm")</span>
                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 border border-emerald-200 text-emerald-700">
                                    @tx.Status
                                </span>
                            </div>
                            <div>
                                <div class="font-bold text-sm text-slate-900">@tx.ChatGroupName</div>
                                <div class="text-xs text-slate-500 mt-0.5">Buyer: <span class="font-medium text-slate-700">@tx.BuyerName</span></div>
                            </div>
                            <div class="pt-2 border-t border-slate-100 grid grid-cols-3 gap-2 text-center text-xs">
                                <div>
                                    <span class="text-slate-400 block text-[10px] uppercase">Gross</span>
                                    <span class="font-semibold text-slate-700">@tx.GrossAmount LD</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[10px] uppercase">Commission</span>
                                    <span class="font-semibold text-rose-600">-@tx.CommissionAmount LD</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[10px] uppercase">Net</span>
                                    <span class="font-bold text-emerald-600">+@tx.NetAmount LD</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private CreatorEarningsDashboardModel? dashboard;
    private string activeFilterType = "ALL";
    private int? selectedChatGroupId;

    protected override async Task OnInitializedAsync()
    {
        await LoadEarningsData();
    }

    private async Task LoadEarningsData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await EarningsApi.GetEarningsAsync(activeFilterType, selectedChatGroupId);
            if (res.IsSuccess && res.Data != null)
            {
                dashboard = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load creator earnings.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private async Task SetFilterType(string filterType)
    {
        activeFilterType = filterType;
        await LoadEarningsData();
    }

    private async Task FilterByGroup(int chatGroupId)
    {
        if (selectedChatGroupId == chatGroupId)
        {
            selectedChatGroupId = null;
        }
        else
        {
            selectedChatGroupId = chatGroupId;
        }
        await LoadEarningsData();
    }

    private async Task ClearGroupFilter()
    {
        selectedChatGroupId = null;
        await LoadEarningsData();
    }
}
