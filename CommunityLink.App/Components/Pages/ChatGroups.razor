@page "/chat-groups-directory"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@inject ChatGroupApiService ChatGroupApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Chat Groups - CommunityLink</PageTitle>

<div class="max-w-6xl mx-auto py-6 px-4 sm:px-6 space-y-6">
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                </svg>
                Standalone Chat Groups
            </h1>
            <p class="text-xs text-slate-500 mt-1">Multi-user chat rooms created by Premium Creators.</p>
        </div>

        @if (isPremiumCreator)
        {
            <button type="button" @onclick="() => showCreateModal = true"
                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-xl shadow-xs transition inline-flex items-center gap-1.5 cursor-pointer self-start sm:self-auto">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Create Chat Group</span>
            </button>
        }
    </div>

    <!-- Search & Filters -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Tabs -->
        <div class="flex items-center gap-1 p-1 bg-slate-100 border border-slate-200 rounded-xl text-xs font-medium w-full sm:w-auto">
            <button type="button" @onclick="SelectAllTab"
                    class="px-4 py-1.5 rounded-lg transition cursor-pointer @(activeTab == "all" ? "bg-white text-indigo-600 font-bold shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                All Chat Groups
            </button>
            <button type="button" @onclick="SelectMyTab"
                    class="px-4 py-1.5 rounded-lg transition cursor-pointer @(activeTab == "my" ? "bg-white text-indigo-600 font-bold shadow-2xs" : "text-slate-600 hover:text-slate-900")">
                My Groups
            </button>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full sm:w-72">
            <input type="text" @bind="searchText" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Search chat groups..."
                   class="w-full pl-9 pr-4 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
            <span class="absolute left-3 top-2.5 text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </span>
        </div>
    </div>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="py-16 text-center text-slate-500 space-y-3">
            <div class="animate-spin rounded-full h-7 w-7 border-b-2 border-indigo-600 mx-auto"></div>
            <p class="text-xs font-medium">Loading Chat Groups...</p>
        </div>
    }
    else if (displayedGroups == null || displayedGroups.Count == 0)
    {
        <div class="p-10 text-center bg-white border border-slate-200 rounded-2xl shadow-xs space-y-3">
            <svg class="w-12 h-12 mx-auto text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
            </svg>
            <h3 class="text-sm font-bold text-slate-900">No Chat Groups Found</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto">
                @(activeTab == "my" ? "You have not created or joined any Chat Groups yet." : "There are currently no active Chat Groups matching your criteria.")
            </p>
            @if (isPremiumCreator)
            {
                <button type="button" @onclick="() => showCreateModal = true"
                        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-xl shadow-xs transition inline-flex items-center gap-1.5 cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Create First Chat Group
                </button>
            }
        </div>
    }
    else
    {
        <!-- Chat Group Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var group in displayedGroups)
            {
                <div class="p-5 bg-white border border-slate-200 rounded-2xl hover:border-indigo-200 hover:shadow-sm transition flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <!-- Top Info Bar -->
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 text-indigo-600 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                    @if (!string.IsNullOrWhiteSpace(group.AvatarUrl))
                                    {
                                        <img src="@group.AvatarUrl" alt="@group.Name" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span>@(group.Name.Substring(0, 1).ToUpper())</span>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-bold text-slate-900 text-sm truncate hover:text-indigo-600 transition">
                                        <a href="/chat-groups/@group.ChatGroupId">@group.Name</a>
                                    </h3>
                                    <p class="text-[11px] text-slate-500 truncate">
                                        By <span class="text-slate-700 font-semibold">@group.CreatorName</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Group Type Badge -->
                            @if (group.ChatType == "PAID")
                            {
                                <span class="px-2 py-0.5 bg-amber-50 border border-amber-200 text-amber-700 font-semibold text-[11px] rounded-md shrink-0 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                    </svg>
                                    Paid (@group.JoinFeeLinkDrops LD)
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 bg-emerald-50 border border-emerald-200 text-emerald-700 font-semibold text-[11px] rounded-md shrink-0 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                    Free
                                </span>
                            }
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrWhiteSpace(group.Description))
                        {
                            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">@group.Description</p>
                        }
                    </div>

                    <!-- Card Footer Bar -->
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                        <div class="text-[11px] text-slate-500 font-medium flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                            </svg>
                            @group.MemberCount @(group.MemberCount == 1 ? "member" : "members")
                        </div>

                        <div class="flex items-center gap-2">
                            @if (group.IsJoined)
                            {
                                <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-[11px] font-bold rounded-lg border border-emerald-200">
                                    ✓ Joined
                                </span>
                            }
                            <a href="/chat-groups/@group.ChatGroupId"
                               class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-2xs transition inline-flex items-center gap-1">
                                <span>View Group</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- CREATE MODAL -->
@if (showCreateModal)
{
    <CreateChatGroupModal OnSaved="HandleGroupCreated" OnClose="() => showCreateModal = false" />
}

@code {
    private IReadOnlyList<ChatGroupModel>? allGroups;
    private IReadOnlyList<ChatGroupModel>? myGroups;
    private IReadOnlyList<ChatGroupModel>? displayedGroups;

    private bool isLoading = true;
    private bool isPremiumCreator;
    private bool showCreateModal;
    private string activeTab = "all";
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var roleCode = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value;

        isPremiumCreator = string.Equals(roleCode, "DOMAIN_PROFESSIONAL", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(roleCode, "PUBLIC_FIGURE", StringComparison.OrdinalIgnoreCase);

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        var res = await ChatGroupApi.GetChatGroupsAsync();
        if (res.IsSuccess)
        {
            allGroups = res.Data;
        }

        var myRes = await ChatGroupApi.GetMyChatGroupsAsync();
        if (myRes.IsSuccess)
        {
            myGroups = myRes.Data;
        }

        ApplyFilter();
        isLoading = false;
    }

    private void SelectAllTab()
    {
        activeTab = "all";
        ApplyFilter();
    }

    private void SelectMyTab()
    {
        activeTab = "my";
        ApplyFilter();
    }

    private void HandleSearch()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var source = activeTab == "my" ? myGroups : allGroups;
        if (source == null)
        {
            displayedGroups = Array.Empty<ChatGroupModel>();
            return;
        }

        if (string.IsNullOrWhiteSpace(searchText))
        {
            displayedGroups = source;
        }
        else
        {
            displayedGroups = source
                .Where(g => g.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                         || (g.Description != null && g.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                         || (g.CreatorName != null && g.CreatorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private async Task HandleGroupCreated(ChatGroupModel newGroup)
    {
        await LoadData();
    }
}
