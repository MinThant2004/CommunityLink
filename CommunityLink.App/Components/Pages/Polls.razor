@code {
    private IReadOnlyList<PollModel>? polls;
    private List<CommunityModel> allCommunities = [];
    private List<CommunityModel> mainCommunities = [];
    private List<CommunityModel> filteredSubCommunities = [];

    private bool isLoading = true;
    private bool isSubmitting;
    private bool showCreateModal;
    private bool showShareModal;
    private int sharingPostId;
    private string shareNoteText = "";

    // Comments & Likes state
    private HashSet<int> openCommentPostIds = [];
    private Dictionary<int, string> commentInputs = [];
    private Dictionary<int, IReadOnlyList<CommentModel>> commentsByPost = [];

    // Form fields for Poll Creation
    private int selectedParentCommunityId;
    private int selectedSubCommunityId;
    private string newQuestion = "";
    private string newDescription = "";
    private int durationDays = 1;
    private int durationHours = 0;
    private int durationMinutes = 0;
    private List<string> optionsList = ["", ""];

    protected override async Task OnInitializedAsync()
    {
        NavManager.NavigateTo("/groups", replace: true);
        return;
    }

    private async Task LoadCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            allCommunities = res.Data.ToList();
            mainCommunities = allCommunities.Where(c => !c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private void OnParentCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parentId))
        {
            selectedParentCommunityId = parentId;
            selectedSubCommunityId = 0;

            if (parentId > 0)
            {
                filteredSubCommunities = allCommunities
                    .Where(c => c.ParentCommunityId == parentId)
                    .OrderBy(c => c.Name)
                    .ToList();
            }
            else
            {
                filteredSubCommunities.Clear();
            }
        }
    }

    private async Task LoadPolls()
    {
        isLoading = true;
        var res = await PollApi.GetPollsAsync();
        if (res.IsSuccess)
        {
            polls = res.Data;
            foreach (var p in polls ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
        isLoading = false;
    }

    private void OpenCreatePollModal()
    {
        newQuestion = "";
        newDescription = "";
        durationDays = 1;
        durationHours = 0;
        durationMinutes = 0;
        optionsList = ["", ""];
        selectedParentCommunityId = mainCommunities.FirstOrDefault()?.CommunityId ?? 0;
        if (selectedParentCommunityId > 0)
        {
            filteredSubCommunities = allCommunities.Where(c => c.ParentCommunityId == selectedParentCommunityId).OrderBy(c => c.Name).ToList();
        }
        else
        {
            filteredSubCommunities.Clear();
        }
        selectedSubCommunityId = 0;
        showCreateModal = true;
    }

    private void CloseModal()
    {
        showCreateModal = false;
    }

    private void SetPresetDuration(int days, int hours, int minutes)
    {
        durationDays = days;
        durationHours = hours;
        durationMinutes = minutes;
    }

    private void AddOption()
    {
        if (optionsList.Count < 10)
        {
            optionsList.Add("");
        }
    }

    private void RemoveOption(int index)
    {
        if (optionsList.Count > 2 && index >= 0 && index < optionsList.Count)
        {
            optionsList.RemoveAt(index);
        }
    }

    private async Task Vote(int pollId, int optId)
    {
        var res = await PollApi.VoteAsync(new VoteRequestModel(pollId, [optId]));
        if (res.IsSuccess)
        {
            Toast.Success("Vote counted!");
            await LoadPolls();
        }
        else
        {
            Toast.Warning(res.Message ?? "Vote failed.");
        }
    }

    // --- Like / Comment / Share Interactions ---
    private async Task ToggleLike(int postId)
    {
        var res = await PostApi.LikePostAsync(postId);
        if (res.IsSuccess)
        {
            await LoadPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update like.");
        }
    }

    private async Task ToggleCommentBox(int postId)
    {
        if (openCommentPostIds.Contains(postId))
        {
            openCommentPostIds.Remove(postId);
        }
        else
        {
            openCommentPostIds.Add(postId);
            await LoadComments(postId);
        }
    }

    private async Task LoadComments(int postId)
    {
        var res = await PostApi.GetCommentsAsync(postId);
        if (res.IsSuccess && res.Data != null)
        {
            commentsByPost[postId] = res.Data;
        }
    }

    private async Task SubmitComment(int postId)
    {
        if (!commentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var res = await PostApi.AddCommentAsync(new CreateCommentRequestModel(postId, content));
        if (res.IsSuccess)
        {
            commentInputs[postId] = "";
            await LoadComments(postId);
            await LoadPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to post comment.");
        }
    }

    private void OpenShareModal(int postId)
    {
        sharingPostId = postId;
        shareNoteText = "";
        showShareModal = true;
    }

    private void CloseShareModal()
    {
        showShareModal = false;
    }

    private async Task SubmitSharePoll()
    {
        isSubmitting = true;
        var res = await PostApi.SharePostAsync(sharingPostId, new SharePostRequestModel(shareNoteText));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Poll shared!");
            CloseShareModal();
            await LoadPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to share poll.");
        }
    }

    // --- Create Poll Method ---
    private async Task CreatePoll()
    {
        if (selectedParentCommunityId == 0)
        {
            Toast.Warning("Please select a community for this poll.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newQuestion))
        {
            Toast.Warning("Poll question is required.");
            return;
        }

        // Clamp duration values
        if (durationDays < 0) durationDays = 0;
        if (durationHours < 0) durationHours = 0;
        if (durationHours > 23) durationHours = 23;
        if (durationMinutes < 0) durationMinutes = 0;
        if (durationMinutes > 59) durationMinutes = 59;

        var totalMinutes = (durationDays * 24 * 60) + (durationHours * 60) + durationMinutes;
        if (totalMinutes <= 0)
        {
            Toast.Warning("Poll duration must be at least 1 minute.");
            return;
        }

        var validOptions = optionsList.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Toast.Warning("Please provide at least 2 non-empty options (A, B).");
            return;
        }

        if (validOptions.Distinct(StringComparer.OrdinalIgnoreCase).Count() != validOptions.Count)
        {
            Toast.Warning("Poll options must be unique.");
            return;
        }

        isSubmitting = true;
        var targetCommunityId = selectedSubCommunityId > 0 ? selectedSubCommunityId : selectedParentCommunityId;
        var expiresAt = DateTime.UtcNow
            .AddDays(durationDays)
            .AddHours(durationHours)
            .AddMinutes(durationMinutes);

        var res = await PollApi.CreatePollAsync(new CreatePollRequestModel(
            targetCommunityId,
            newDescription,
            newQuestion,
            false,
            expiresAt,
            validOptions));

        isSubmitting = false;

        if (res.IsSuccess)
        {
            showCreateModal = false;
            await LoadPolls();
            Toast.Success("Poll published successfully!");
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to publish poll.");
        }
    }
}