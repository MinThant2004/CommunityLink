@page "/polls"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.PollView)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject PollApiService PollApi
@inject PostApiService PostApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Live Polls &amp; Voting - CommunityLink</PageTitle>

<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 space-y-6 text-[#0A1B2E]">
    <!-- Header Banner -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] p-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#F1F5F9] border border-[#E2E8F0] flex items-center justify-center text-xl font-bold shadow-sm">
                    📊
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-[#0A1B2E] tracking-tight" style="font-family:'Manrope',sans-serif">Live Community Polls</h1>
                    <p class="text-xs text-[#557392]">Participate in community decisions, voice your opinion, or launch a targeted poll.</p>
                </div>
            </div>
            <AuthorizeView Policy="@(PermissionCatalog.PolicyPrefix + PermissionCatalog.PollCreate)">
                <Authorized>
                    <button type="button" @onclick="OpenCreatePollModal"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0A1B2E] hover:bg-[#112A46] text-white font-semibold text-sm rounded-full shadow-sm hover:shadow-md transition-all active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span>Create Poll</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Poll List Section -->
    @if (isLoading)
    {
        <div class="flex justify-center items-center py-16">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] border-t-transparent"></div>
        </div>
    }
    else if (polls == null || polls.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-dashed border-[#CBD5E1] p-12 text-center text-[#557392]">
            <div class="text-4xl mb-3">🗳️</div>
            <h3 class="text-base font-semibold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">No active polls found</h3>
            <p class="text-sm mt-1">Start a discussion and collect opinions by creating the first poll.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var poll in polls)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] hover:border-[#0A1B2E]/20 overflow-hidden transition hover:shadow-md">
                    <!-- Poll Card Header -->
                    <div class="p-5 pb-3">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(poll.AuthorAvatar))
                                {
                                    <img src="@poll.AuthorAvatar" alt="@poll.AuthorName" class="w-9 h-9 rounded-full object-cover border border-[#E2E8F0]" />
                                }
                                else
                                {
                                    <div class="w-9 h-9 rounded-full bg-[#F1F5F9] border border-[#E2E8F0] flex items-center justify-center font-bold text-[#0A1B2E] text-xs">
                                        @(string.IsNullOrWhiteSpace(poll.AuthorName) ? "U" : poll.AuthorName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h2 class="text-sm font-semibold text-[#0A1B2E]">@poll.AuthorName</h2>
                                        @if (!string.IsNullOrEmpty(poll.CommunityName))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E]"></span>
                                                @poll.CommunityName
                                            </span>
                                        }
                                    </div>
                                    <span class="text-xs text-[#7A8CA6] font-mono">@poll.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                </div>
                            </div>

                            <!-- Expiration Badge -->
                            <div>
                                @if (poll.IsExpired)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 border border-red-200">
                                        <span>🔒</span> Closed
                                    </span>
                                }
                                else if (poll.ExpiresAt.HasValue)
                                {
                                    var remaining = poll.ExpiresAt.Value - DateTime.UtcNow;
                                    var remainingStr = remaining.TotalDays >= 1
                                        ? $"{(int)remaining.TotalDays}d left"
                                        : remaining.TotalHours >= 1
                                            ? $"{(int)remaining.TotalHours}h left"
                                            : $"{(int)remaining.TotalMinutes}m left";

                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span>⏳</span> @remainingStr
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0]">
                                        Active
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Description FIRST (if present) -->
                        @if (!string.IsNullOrWhiteSpace(poll.Content) && poll.Content != poll.Question)
                        {
                            <div class="mb-3 text-xs sm:text-sm text-[#557392] bg-[#F8FAFC] rounded-xl p-3 border border-[#E2E8F0] whitespace-pre-line leading-relaxed">
                                @poll.Content
                            </div>
                        }

                        <!-- Poll Question DIRECTLY ABOVE OPTIONS -->
                        <div class="mt-2 mb-1 flex items-start gap-2">
                            <span class="text-[#557392] font-bold text-sm select-none">Q:</span>
                            <h2 class="text-base font-bold text-[#0A1B2E] leading-snug" style="font-family:'Manrope',sans-serif">@poll.Question</h2>
                        </div>
                    </div>

                    <!-- Poll Options List -->
                    <div class="px-5 py-3 space-y-2.5">
                        @foreach (var opt in poll.Options)
                        {
                            var hasUserVotedThis = opt.IsVotedByCurrentUser;
                            var canVote = !poll.HasVoted && !poll.IsExpired;

                            <div class="relative overflow-hidden rounded-xl border transition-all @(hasUserVotedThis ? "border-[#0A1B2E] bg-[#F1F5F9] ring-2 ring-[#0A1B2E]/10" : "border-[#E2E8F0] bg-[#F8FAFC] hover:bg-white")">
                                <!-- Percentage Progress Fill Bar -->
                                <div class="absolute inset-y-0 left-0 bg-[#0A1B2E]/10 transition-all duration-500"
                                     style="width: @(opt.Percentage)%;"></div>

                                <div class="relative z-10 p-3 flex items-center justify-between gap-3 text-sm">
                                    <div class="flex items-center gap-3">
                                        @if (canVote)
                                        {
                                            <button type="button" @onclick="() => Vote(poll.PollId, opt.OptionId)"
                                                    class="w-5 h-5 rounded-full border-2 border-[#0A1B2E] hover:bg-[#0A1B2E] transition flex items-center justify-center shrink-0">
                                                <div class="w-2 h-2 rounded-full bg-white opacity-0 hover:opacity-100"></div>
                                            </button>
                                        }
                                        else if (hasUserVotedThis)
                                        {
                                            <div class="w-5 h-5 rounded-full bg-[#0A1B2E] text-white flex items-center justify-center text-xs shrink-0 shadow-sm">
                                                ✓
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="w-5 h-5 rounded-full border border-[#CBD5E1] shrink-0"></div>
                                        }
                                        <span class="font-medium text-[#0A1B2E] @(hasUserVotedThis ? "font-semibold" : "")">
                                            @opt.Text
                                        </span>
                                    </div>
                                    <div class="text-right shrink-0 font-mono">
                                        <span class="text-xs font-bold text-[#557392]">@opt.Percentage%</span>
                                        <span class="text-[11px] text-[#7A8CA6] ml-1">(@opt.VoteCount)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Voting Summary / Status Line -->
                    <div class="px-5 py-2.5 bg-[#F8FAFC] border-t border-[#E2E8F0] flex items-center justify-between text-xs text-[#557392]">
                        <div class="flex items-center gap-2 font-mono">
                            <span>👥 @poll.TotalVotes total votes</span>
                            <span>•</span>
                            <span>@(poll.IsMultipleChoice ? "Multiple votes allowed" : "Single choice")</span>
                        </div>
                        @if (poll.HasVoted)
                        {
                            <span class="text-[#0A1B2E] font-semibold flex items-center gap-1">
                                <span>✓</span> You voted in this poll
                            </span>
                        }
                        else if (poll.IsExpired)
                        {
                            <span class="text-red-500 font-medium">
                                Voting ended
                            </span>
                        }
                        else
                        {
                            <span class="text-emerald-600 font-medium">
                                Click an option to vote
                            </span>
                        }
                    </div>

                    <!-- Action Buttons: Like, Comment, Share -->
                    <div class="px-4 py-1.5 flex items-center justify-between text-sm font-medium text-[#557392] bg-white border-t border-[#E2E8F0]">
                        <!-- Like Button -->
                        <button type="button" @onclick="() => ToggleLike(poll.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] @(poll.IsLikedByCurrentUser ? "text-red-500 font-semibold" : "")">
                            <svg class="w-5 h-5 @(poll.IsLikedByCurrentUser ? "fill-red-500 stroke-red-500" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                            <span>Like</span>
                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0] font-mono">@poll.LikeCount</span>
                        </button>

                        <!-- Comment Button -->
                        <button type="button" @onclick="() => ToggleCommentBox(poll.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] @(openCommentPostIds.Contains(poll.PostId) ? "text-[#0A1B2E] font-semibold" : "")">
                            <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                            <span>Comment</span>
                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0] font-mono">@poll.CommentCount</span>
                        </button>

                        <!-- Share Button -->
                        <button type="button" @onclick="() => OpenShareModal(poll.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9]">
                            <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                            </svg>
                            <span>Share</span>
                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0] font-mono">@poll.ShareCount</span>
                        </button>
                    </div>

                    <!-- Comment Drawer Section -->
                    @if (openCommentPostIds.Contains(poll.PostId))
                    {
                        <div class="border-t border-[#E2E8F0] p-4 sm:p-5 bg-[#F8FAFC] space-y-4">
                            <!-- New Comment Input -->
                            <div class="flex items-start gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-[#F1F5F9] text-[#557392] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 border border-[#E2E8F0]">
                                    💬
                                </div>
                                <div class="flex-1 flex gap-2">
                                    <input type="text" @bind="commentInputs[poll.PostId]"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(poll.PostId); })"
                                           placeholder="Write a comment on this poll..."
                                           class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] placeholder-[#7A8CA6] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 shadow-sm" />
                                    <button type="button" @onclick="() => SubmitComment(poll.PostId)"
                                            class="px-4 py-2 bg-[#0A1B2E] hover:bg-[#112A46] text-white rounded-xl text-xs font-semibold shadow-sm transition">
                                        Post
                                    </button>
                                </div>
                            </div>

                            <!-- Comment List -->
                            @if (commentsByPost.TryGetValue(poll.PostId, out var commentList) && commentList != null)
                            {
                                if (commentList.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] text-center py-2">No comments yet. Start the conversation!</p>
                                }
                                else
                                {
                                    <div class="space-y-3 pt-2">
                                        @foreach (var comment in commentList)
                                        {
                                            <div class="flex items-start gap-2.5 text-xs">
                                                <div class="w-7 h-7 rounded-full bg-[#E2E8F0] text-[#0A1B2E] flex items-center justify-center font-bold shrink-0">
                                                    @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                </div>
                                                <div class="flex-1 bg-white p-2.5 rounded-xl border border-[#E2E8F0] shadow-sm">
                                                    <div class="flex items-center justify-between gap-2 mb-1">
                                                        <span class="font-semibold text-[#0A1B2E]">@comment.AuthorName</span>
                                                        <span class="text-[10px] text-[#7A8CA6] font-mono">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                    </div>
                                                    <p class="text-[#557392] whitespace-pre-line">@comment.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE POLL MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-[#E2E8F0] w-full max-w-lg overflow-hidden">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E2E8F0] bg-[#F8FAFC] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📊</span>
                    <h3 class="font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">Create Community Poll</h3>
                </div>
                <button type="button" @onclick="CloseModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] p-1 rounded-lg hover:bg-[#E2E8F0] transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <!-- Community Dropdown (Mandatory) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] mb-1">Select Community <span class="text-red-500">*</span></label>
                    <select class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                            value="@selectedParentCommunityId"
                            @onchange="OnParentCommunityChanged">
                        <option value="0">-- Select a Community --</option>
                        @foreach (var c in mainCommunities)
                        {
                            <option value="@c.CommunityId">@c.Name</option>
                        }
                    </select>
                </div>

                <!-- Sub-community Dropdown -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] mb-1">
                        Select Sub-community
                        @if (filteredSubCommunities.Count == 0 && selectedParentCommunityId > 0)
                        {
                            <span class="text-[#7A8CA6] font-normal">(No sub-communities found)</span>
                        }
                    </label>
                    <select class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 disabled:opacity-50"
                            disabled="@(selectedParentCommunityId == 0 || filteredSubCommunities.Count == 0)"
                            @bind="selectedSubCommunityId">
                        <option value="0">-- (Optional) Use Main Community or Pick Sub-community --</option>
                        @foreach (var sc in filteredSubCommunities)
                        {
                            <option value="@sc.CommunityId">@sc.Name</option>
                        }
                    </select>
                </div>

                <!-- Description / Context (optional) -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#0A1B2E]">Description / Context <span class="text-[#7A8CA6] font-normal">(Optional)</span></label>
                        <span class="text-[11px] text-[#7A8CA6]">Displayed first above the question</span>
                    </div>
                    <textarea rows="2" class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] placeholder-[#7A8CA6] rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                              @bind="newDescription" placeholder="Add background details, rules, or context for voters..."></textarea>
                </div>

                <!-- Poll Question (Mandatory) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] mb-1">Poll Question <span class="text-red-500">*</span></label>
                    <input type="text" class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] placeholder-[#7A8CA6] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 font-medium"
                           @bind="newQuestion" placeholder="e.g. Which framework should we choose for our next release?" />
                </div>

                <!-- Dynamic Poll Duration Setup -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#0A1B2E]">Poll Duration <span class="text-red-500">*</span></label>
                        <span class="text-[11px] text-[#557392] font-medium font-mono">
                            Total: @(durationDays)d @(durationHours)h @(durationMinutes)m
                        </span>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div class="flex items-center gap-1.5 mb-2.5 flex-wrap">
                        <button type="button" @onclick="() => SetPresetDuration(0, 1, 0)"
                                class="px-2.5 py-1 text-xs rounded-lg border border-[#CBD5E1] bg-white hover:bg-[#F1F5F9] hover:text-[#0A1B2E] transition">
                            1 Hour
                        </button>
                        <button type="button" @onclick="() => SetPresetDuration(0, 12, 0)"
                                class="px-2.5 py-1 text-xs rounded-lg border border-[#CBD5E1] bg-white hover:bg-[#F1F5F9] hover:text-[#0A1B2E] transition">
                            12 Hours
                        </button>
                        <button type="button" @onclick="() => SetPresetDuration(1, 0, 0)"
                                class="px-2.5 py-1 text-xs rounded-lg border border-[#CBD5E1] bg-white hover:bg-[#F1F5F9] hover:text-[#0A1B2E] transition">
                            1 Day
                        </button>
                        <button type="button" @onclick="() => SetPresetDuration(3, 0, 0)"
                                class="px-2.5 py-1 text-xs rounded-lg border border-[#CBD5E1] bg-white hover:bg-[#F1F5F9] hover:text-[#0A1B2E] transition">
                            3 Days
                        </button>
                        <button type="button" @onclick="() => SetPresetDuration(7, 0, 0)"
                                class="px-2.5 py-1 text-xs rounded-lg border border-[#CBD5E1] bg-white hover:bg-[#F1F5F9] hover:text-[#0A1B2E] transition">
                            7 Days
                        </button>
                    </div>

                    <!-- Free Numeric Inputs: Days, Hours, Minutes -->
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="block text-[11px] text-[#557392] mb-1">Days</label>
                            <input type="number" min="0" max="365"
                                   class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                                   @bind="durationDays" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-[#557392] mb-1">Hours</label>
                            <input type="number" min="0" max="23"
                                   class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                                   @bind="durationHours" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-[#557392] mb-1">Minutes</label>
                            <input type="number" min="0" max="59"
                                   class="w-full text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                                   @bind="durationMinutes" />
                        </div>
                    </div>
                    <p class="text-[11px] text-[#7A8CA6] mt-1.5">Configure any combination of Days, Hours, and Minutes freely.</p>
                </div>

                <!-- Dynamic Poll Options (A, B, C, ...) -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#0A1B2E]">Poll Options <span class="text-red-500">*</span> (Min 2, Max 10)</label>
                        @if (optionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddOption" class="text-xs font-semibold text-[#557392] hover:text-[#0A1B2E]">
                                + Add Option
                            </button>
                        }
                    </div>

                    <div class="space-y-2">
                        @for (int i = 0; i < optionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-[#F1F5F9] text-[#557392] font-bold text-xs flex items-center justify-center shrink-0 border border-[#E2E8F0]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       class="flex-1 text-sm bg-white border border-[#CBD5E1] text-[#0A1B2E] placeholder-[#7A8CA6] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                                       placeholder="@($"Option {labelChar}")"
                                       @bind="optionsList[index]" />
                                @if (optionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemoveOption(index)"
                                            class="text-[#7A8CA6] hover:text-red-500 p-1 rounded-lg transition">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] border-t border-[#E2E8F0] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModal"
                        class="px-4 py-2 text-sm text-[#557392] hover:text-[#0A1B2E] font-medium rounded-xl hover:bg-[#E2E8F0] transition">
                    Cancel
                </button>
                <button type="button" @onclick="CreatePoll" disabled="@isSubmitting"
                        class="px-5 py-2 text-sm bg-[#0A1B2E] hover:bg-[#112A46] text-white font-semibold rounded-xl shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span>Publish Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

