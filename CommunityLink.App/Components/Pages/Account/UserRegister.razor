@page "/register"
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Auth_RegisterPageTitle"]</PageTitle>

<AuthSplitScreen LogoText="CL" Eyebrow="@Loc["Auth_MemberProvisioning"]" Title="@Loc["Auth_RegisterTitle"]"
                 Subtitle="@Loc["Auth_RegisterSubtitle"]">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <div class="mb-4">
            <a href="/login" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition group">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                <span>Back to Sign In</span>
            </a>
        </div>

        <!-- Brand / Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <h2 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">@Loc["Auth_CreateMemberAccount"]</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">@Loc["Auth_CreateAccountSubheading"]</p>
        </div>

        <form method="post" action="/account/register" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="fullName" class="@AuthClasses.Label">@Loc["Auth_FullName"]</label>
                <input id="fullName" name="fullName" type="text" required autocomplete="name"
                       value="@fullName" placeholder="@Loc["Auth_Register_FullNamePlaceholder"]" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <label for="userName" class="@AuthClasses.Label mb-0">@Loc["Auth_Username"]</label>
                    <span class="font-mono text-[10px] text-[#7A8CA6]">@Loc["Auth_UsernameHint"]</span>
                </div>
                <input id="userName" name="userName" type="text" required autocomplete="username"
                       value="@userName" placeholder="@Loc["Auth_Register_UsernamePlaceholder"]" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <label for="email" class="@AuthClasses.Label">@Loc["Auth_EmailAddress"]</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                       value="@email" placeholder="you@example.com" class="@AuthClasses.Input" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <label for="password" class="@AuthClasses.Label">@Loc["Auth_Password"]</label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required
                               autocomplete="new-password" placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="@Loc["Auth_TogglePasswordVisibility"]">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="confirmPassword" class="@AuthClasses.Label">@Loc["Auth_ConfirmPassword"]</label>
                    <div class="relative">
                        <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password"
                               placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="@Loc["Auth_ToggleConfirmPasswordVisibility"]">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>
            </div>

            <!-- Password Policy Requirement Hint -->
            <p class="text-[11px] text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5 pt-0.5">
                <svg class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Loc["Auth_PasswordRequirementHint"]</span>
            </p>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButton mt-2">
                <span>Create Account</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-center text-xs text-[#557392] dark:text-[#C4D2E1]">
            <span>Already have an account?</span>
            <a href="/login" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline transition ml-1">Sign in here &rarr;</a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private string? errorMessage;
    private string fullName = string.Empty;
    private string userName = string.Empty;
    private string email = string.Empty;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
            fullName = query["fullName"] ?? string.Empty;
            userName = query["userName"] ?? string.Empty;
            email = query["email"] ?? string.Empty;
        }
    }
}
