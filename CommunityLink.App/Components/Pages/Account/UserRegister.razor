@page "/register"
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Create Account - CommunityLink</PageTitle>

<AuthSplitScreen LogoText="CL" Eyebrow="GET STARTED" Title="Join the community."
                 Subtitle="Create your account to connect with communities, join discussions, and participate in polls.">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <div class="mb-4">
            <a href="/login" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition group">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                <span>Back to Sign In</span>
            </a>
        </div>

        <!-- Brand / Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#557392] dark:text-[#7A8CA6]">CREATE ACCOUNT</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Create your account</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">It only takes a moment to get started.</p>
        </div>

        <form method="post" action="/account/register" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="fullName" class="@AuthClasses.Label">Full name</label>
                <input id="fullName" name="fullName" type="text" required autocomplete="name"
                       placeholder="Jane Doe" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <label for="userName" class="@AuthClasses.Label mb-0">Username</label>
                    <span class="font-mono text-[10px] text-[#7A8CA6]">3-30 CHARACTERS</span>
                </div>
                <input id="userName" name="userName" type="text" required autocomplete="username"
                       placeholder="janedoe" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <label for="email" class="@AuthClasses.Label">Email address</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                       placeholder="you@example.com" class="@AuthClasses.Input" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <label for="password" class="@AuthClasses.Label">Password</label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required
                               autocomplete="new-password" placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="confirmPassword" class="@AuthClasses.Label">Confirm</label>
                    <div class="relative">
                        <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password"
                               placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle confirm password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButton mt-2">
                <span>Create Account</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] space-y-3">
            <div class="text-center text-xs text-[#557392] dark:text-[#C4D2E1]">
                Already have an account?
            </div>
            <a href="/login" class="w-full flex items-center justify-center gap-2 rounded border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-transparent px-4 py-2.5 text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition">
                <span>Back to Sign In</span>
            </a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
        }
    }
}