@page "/register"
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Create Account - CommunityLink</PageTitle>

<AuthSplitScreen LogoText="CL" Eyebrow="MEMBER PROVISIONING" Title="Join the verified network."
                 Subtitle="Register your node identity to access global community hubs, feeds, and real-time collaboration.">
    <div class="bg-white border border-[#E2E8F0] rounded-lg p-8 shadow-sm">
        <!-- Brand / Node Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#557392]">MEMBER REGISTRY</span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] bg-[#F1F5F9] border border-[#E2E8F0] px-2 py-0.5 rounded">NODE PROVISIONING</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">Create member account</h2>
            <p class="mt-1 text-xs text-[#557392]" style="font-family:'Inter',sans-serif">It only takes a moment to establish your credentials.</p>
        </div>

        <form method="post" action="/account/register" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <span class="mt-0.5">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="fullName" class="@AuthClasses.Label">Full name</label>
                <input id="fullName" name="fullName" type="text" required autocomplete="name"
                       placeholder="Jane Doe" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <label for="userName" class="@AuthClasses.Label mb-0">Username</label>
                    <span class="font-mono text-[10px] text-[#7A8CA6]">3-30 CHARACTERS</span>
                </div>
                <input id="userName" name="userName" type="text" required autocomplete="username"
                       placeholder="janedoe" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <label for="email" class="@AuthClasses.Label">Email address</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                       placeholder="you@example.com" class="@AuthClasses.Input" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <label for="password" class="@AuthClasses.Label">Password</label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required
                               autocomplete="new-password" placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] transition" aria-label="Toggle password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="confirmPassword" class="@AuthClasses.Label">Confirm</label>
                    <div class="relative">
                        <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password"
                               placeholder="••••••••" class="@AuthClasses.Input pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] transition" aria-label="Toggle confirm password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButton mt-2">
                <span>Provision Account</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] text-center text-xs text-[#557392]">
            Already have an account?
            <a href="/login" class="font-semibold text-[#0A1B2E] hover:underline transition ml-1">Sign in here &rarr;</a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
        }
    }
}