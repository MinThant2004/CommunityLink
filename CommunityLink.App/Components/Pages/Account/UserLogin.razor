@page "/login"
@rendermode InteractiveServer
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Sign In - CommunityLink</PageTitle>

@if (showForgotPasswordModal)
{
    <ForgotPasswordModal IsAdmin="false" OnClose="CloseForgotPassword" />
}

<AuthSplitScreen LogoText="CL" Eyebrow="MEMBER AUTHENTICATION GATEWAY" Title="Connect with verified global hubs."
                 Subtitle="Access peer discussions, real-time community feeds, and node collaboration spaces.">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <!-- Brand / Node Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#557392] dark:text-[#7A8CA6]">MEMBER PORTAL</span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] px-2 py-0.5 rounded">NODE 01 · VERIFIED</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Sign in to account</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">Enter your credentials to connect to your profile node.</p>
        </div>

        <form method="post" action="/account/login" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <span class="mt-0.5">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="email" class="@AuthClasses.Label">Email address</label>
                <input id="email" name="email" type="email" required autofocus autocomplete="email"
                       placeholder="you@example.com" class="@AuthClasses.Input" />
            </div>

            <div class="space-y-1.5">
                <label for="password" class="@AuthClasses.Label">Password</label>
                <div class="relative">
                    <input id="password" name="password" type="password" required
                           autocomplete="current-password" placeholder="••••••••" class="@AuthClasses.Input pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle password visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-between pt-1">
                <label for="remember-me" class="flex items-center gap-2 text-xs text-[#557392] dark:text-[#C4D2E1] cursor-pointer">
                    <input type="hidden" name="rememberMe" value="false" />
                    <input id="remember-me" name="rememberMe" type="checkbox" value="true" class="@AuthClasses.Checkbox" />
                    <span>Keep session active</span>
                </label>
                <button type="button" @onclick="OpenForgotPassword" class="font-mono text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">Forgot password?</button>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButton mt-2">
                <span>Authenticate &amp; Enter</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-center text-xs text-[#557392] dark:text-[#C4D2E1]">
            Don't have an account?
            <a href="/register" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline transition ml-1">Create one now &rarr;</a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private bool showForgotPasswordModal;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
        }
    }

    private void OpenForgotPassword() => showForgotPasswordModal = true;
    private void CloseForgotPassword() => showForgotPasswordModal = false;
}