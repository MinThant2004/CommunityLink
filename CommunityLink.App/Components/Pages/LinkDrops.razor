@page "/link-drops"
@page "/linkdrops"
@using CommunityLink.App.Apis
@using CommunityLink.App.Services
@using CommunityLink.Shared.Features.LinkDrop
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>LinkDrop Treasury &amp; Top-Up — CommunityLink</PageTitle>

<div class="min-h-screen bg-background font-body-md text-body-md text-on-surface antialiased transition-colors duration-200">
    <!-- Top System Directory Strip -->
    <section class="bg-surface-container-lowest/80 backdrop-blur-md border-b border-surface-container-high/30">
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop py-2 flex items-center justify-between gap-3">
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <a href="/" class="hover:text-on-surface transition-colors flex items-center gap-1">Platform</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">LinkDrop Treasury</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-container text-primary font-label-sm text-xs border border-primary/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>1 Drop = 10 MMK
                </span>
            </div>
        </div>
    </section>

    <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop py-4 w-full space-y-3">

        <!-- PROMINENT TOTAL LINKDROP BALANCE & 3D SPINNING PRISM SHOWCASE -->
        <div class="rounded-2xl bg-surface-container-lowest border border-surface-container-high/40 p-4 sm:p-5 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <!-- Left: Available Total LinkDrop Balance (Highly Visible to Customer) -->
            <div class="space-y-1.5">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-on-surface-variant font-label-sm">
                        Available Wallet Balance
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container text-primary font-label-sm text-[10px] font-bold border border-primary/20">
                        1 Drop = 10 MMK
                    </span>
                </div>

                <div class="flex items-baseline gap-2.5">
                    <span class="text-3xl sm:text-4xl lg:text-5xl font-black text-primary tracking-tight font-mono">
                        @(wallet?.Balance.ToString("N0") ?? "0")
                    </span>
                    <span class="text-base sm:text-lg font-black text-on-surface">Link Drops</span>
                    <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">
                        ≈ @(((wallet?.Balance ?? 0) * 10).ToString("N0")) MMK
                    </span>
                </div>

                <!-- Balance Breakdown (Purchased & Earned) -->
                <div class="flex flex-wrap items-center gap-3 text-xs text-on-surface-variant pt-0.5">
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-primary"></span>
                        <span>Purchased:</span>
                        <strong class="text-on-surface font-mono font-bold">@(wallet?.PurchasedBalance.ToString("N0") ?? "0")</strong>
                    </span>
                    <span class="text-on-surface-variant/40 hidden sm:inline">&bull;</span>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>Earned:</span>
                        <strong class="text-on-surface font-mono font-bold">@(wallet?.EarnedBalance.ToString("N0") ?? "0")</strong>
                    </span>
                </div>
            </div>

            <!-- Right: Prominent 3D Spinning Prism Showcase (Visible, Eye-Catching & Interactive) -->
            <div class="relative shrink-0 flex items-center justify-center self-center md:self-auto pr-0 sm:pr-2">
                <!-- Soft Cyan/Blue Neon Glow Behind Prism -->
                <div class="absolute w-36 h-36 sm:w-40 sm:h-40 rounded-full bg-gradient-to-tr from-sky-400/25 via-primary/20 to-indigo-500/20 blur-2xl pointer-events-none"></div>

                <!-- 3D Spinning Prism Canvas Container (Large & clearly visible: 136px - 160px) -->
                <div id="@heroPrismContainerId"
                     class="w-32 h-32 sm:w-36 sm:h-36 lg:w-40 lg:h-40 relative z-10 flex items-center justify-center cursor-grab active:cursor-grabbing select-none"
                     title="Interactive 3D LinkDrop Sovereign Prism — Click & drag to rotate">
                </div>
            </div>

        </div>

        <!-- NAVIGATION TABS STRIP -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 bg-surface-container-lowest border border-surface-container-high/40 rounded-xl p-1.5 shadow-xs">
            <div class="flex items-center gap-1 overflow-x-auto p-0.5">
                <button type="button" @onclick='() => SetTab("buy")'
                        class="px-3.5 py-2 rounded-lg font-label-md text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer @(activeTab == "buy" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                    <span>Top-Up LinkDrops</span>
                </button>
                <button type="button" @onclick='() => SetTab("purchases")'
                        class="px-3.5 py-2 rounded-lg font-label-md text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer @(activeTab == "purchases" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                    <span class="material-symbols-outlined text-sm">receipt_long</span>
                    <span>My Purchases</span>
                    @if (userPurchases.Any(p => p.Status == "PENDING"))
                    {
                        <span class="px-2 py-0.5 text-[10px] bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-full font-bold border border-amber-500/30">
                            @(userPurchases.Count(p => p.Status == "PENDING"))
                        </span>
                    }
                </button>
                <button type="button" @onclick='() => SetTab("ledger")'
                        class="px-3.5 py-2 rounded-lg font-label-md text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer @(activeTab == "ledger" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                    <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
                    <span>Wallet &amp; Ledger</span>
                </button>
            </div>

            <!-- Protocol Badge -->
            <div class="flex items-center justify-between sm:justify-end gap-2 px-3 py-1 rounded-lg bg-surface-container border border-surface-container-high/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-on-surface-variant font-label-sm text-xs font-medium">Settlement Rails Active</span>
            </div>
        </div>

        <!-- ============================================================= -->
        <!-- TAB 1: TOP-UP LINKDROPS WORKFLOW                             -->
        <!-- ============================================================= -->
        @if (activeTab == "buy")
        {
            @if (submissionCompleted)
            {
                <!-- SUBMISSION SUCCESS CONFIRMATION BANNER -->
                <div class="rounded-2xl bg-surface-container-lowest border border-emerald-500/30 p-6 text-center space-y-4 shadow-sm max-w-xl mx-auto my-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl font-bold mx-auto border border-emerald-500/30 animate-bounce">
                        ✓
                    </div>
                    <div class="space-y-1">
                        <span class="inline-block px-3 py-0.5 bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/30 text-[10px] font-bold rounded-full uppercase tracking-wider">
                            Status: PENDING ADMIN VERIFICATION
                        </span>
                        <h2 class="text-xl font-bold text-on-surface">Payment Request Submitted!</h2>
                        <p class="text-on-surface-variant text-xs max-w-sm mx-auto leading-relaxed">
                            Your payment receipt slip and transaction reference have been received. LinkDrops will be credited after manual verification.
                        </p>
                    </div>

                    <div class="bg-surface-container-low border border-surface-container-high/50 rounded-xl p-3 text-left text-xs space-y-2 max-w-sm mx-auto">
                        <div class="flex justify-between border-b border-surface-container-high/30 pb-1.5">
                            <span class="text-on-surface-variant">Request Number:</span>
                            <span class="font-mono text-on-surface font-bold">@submittedPurchaseNumber</span>
                        </div>
                        <div class="flex justify-between border-b border-surface-container-high/30 pb-1.5">
                            <span class="text-on-surface-variant">Transaction ID:</span>
                            <span class="font-mono text-primary font-bold">@transactionRefNo</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant">Target Credit:</span>
                            <span class="text-emerald-600 dark:text-emerald-400 font-extrabold flex items-center gap-1">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                +@calculatedDrops.ToString("N0") Link Drops
                            </span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-2.5 justify-center pt-1">
                        <button type="button" @onclick='() => SetTab("purchases")'
                                class="px-4 py-2 bg-primary text-on-primary font-bold text-xs rounded-lg transition-all shadow-xs cursor-pointer hover:opacity-90 flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-sm">receipt_long</span>
                            <span>Track in My Purchases</span>
                        </button>
                        <button type="button" @onclick="ResetForm"
                                class="px-4 py-2 bg-surface-container hover:bg-surface-container-high text-on-surface font-bold text-xs rounded-lg transition-all border border-surface-container-high/50 cursor-pointer flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-sm">add_circle</span>
                            <span>Submit Another Top-Up</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    
                    <!-- STEP 1: SELECT BUNDLE / AMOUNT -->
                    <div class="rounded-xl bg-surface-container-lowest border border-surface-container-high/40 p-4 shadow-xs space-y-3">
                        <div class="flex items-center justify-between border-b border-surface-container-high/30 pb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-md bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                                    1
                                </div>
                                <h2 class="font-title-sm font-bold text-on-surface text-sm">Select LinkDrop Bundle</h2>
                            </div>
                            <span class="text-xs text-on-surface-variant font-medium">1 Drop = 10 MMK</span>
                        </div>

                        <!-- Predefined Packages Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            @foreach (var pkg in activePackages)
                            {
                                var isSelected = !isCustomPurchase && selectedPackage?.PackageId == pkg.PackageId;
                                <div @onclick="() => SelectPackage(pkg)"
                                     class="p-3 rounded-lg border-2 transition-all cursor-pointer flex flex-col justify-between space-y-2 relative @(isSelected ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40 hover:border-surface-container-high")">
                                    
                                    <div class="flex items-center justify-between">
                                        <span class="text-[10px] font-bold uppercase tracking-wider @(isSelected ? "text-primary" : "text-on-surface-variant")">
                                            @pkg.PackageName
                                        </span>
                                        @if (isSelected)
                                        {
                                            <span class="w-3.5 h-3.5 rounded-full bg-primary text-on-primary flex items-center justify-center text-[9px] font-bold">✓</span>
                                        }
                                        else if (pkg.BonusAmount > 0)
                                        {
                                            <span class="px-1 py-0.2 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[9px] border border-emerald-500/20">
                                                +@pkg.BonusAmount.ToString("N0")
                                            </span>
                                        }
                                    </div>

                                    <div>
                                        <div class="text-base font-black text-on-surface flex items-center gap-1">
                                            <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                            <span>+@((pkg.LinkDropAmount + pkg.BonusAmount).ToString("N0"))</span>
                                        </div>
                                        <div class="text-xs font-bold text-primary mt-0.5">
                                            @pkg.RealMoneyAmount.ToString("N0") MMK
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Custom Amount Calculator Card -->
                        <div class="p-3 rounded-lg border-2 transition-all space-y-2.5 @(isCustomPurchase ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40")">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <button type="button" @onclick="EnableCustomPurchase"
                                            class="px-2.5 py-1 bg-primary text-on-primary font-bold text-xs rounded-md shrink-0 flex items-center gap-1 cursor-pointer">
                                        <span class="material-symbols-outlined text-xs">calculate</span>
                                        <span>Custom Amount</span>
                                    </button>
                                    <span class="text-xs text-on-surface-variant">Specify any amount in MMK</span>
                                </div>

                                <!-- Quick Presets (MMK) -->
                                <div class="flex items-center gap-1.5 overflow-x-auto">
                                    <button type="button" @onclick="() => SetPresetAmount(1000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">1,000</button>
                                    <button type="button" @onclick="() => SetPresetAmount(2000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">2,000</button>
                                    <button type="button" @onclick="() => SetPresetAmount(5000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">5,000</button>
                                    <button type="button" @onclick="() => SetPresetAmount(10000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">10,000</button>
                                    <button type="button" @onclick="() => SetPresetAmount(20000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">20,000</button>
                                    <button type="button" @onclick="() => SetPresetAmount(50000)" class="px-2 py-0.5 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">50,000</button>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                                <div class="flex items-center gap-2 flex-1">
                                    <span class="text-xs font-bold text-on-surface-variant">MMK</span>
                                    <input type="number" min="10" step="100"
                                           @bind="customMmkAmount" @bind:after="OnCustomAmountChanged"
                                           class="w-full bg-surface-container-lowest border border-surface-container-high/60 rounded-lg px-3 py-1.5 text-xs font-bold text-on-surface focus:outline-none focus:border-primary"
                                           placeholder="e.g. 10000 MMK" />
                                </div>
                                <div class="flex items-center justify-between sm:justify-start gap-2 bg-surface-container px-3 py-1.5 rounded-lg border border-surface-container-high/30">
                                    <span class="text-xs text-on-surface-variant">Credits:</span>
                                    <span class="text-xs font-black text-primary inline-flex items-center gap-1 whitespace-nowrap">
                                        <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                        <span>+@calculatedDrops.ToString("N0") Drops</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: SELECT PAYMENT METHOD RAIL -->
                    <div class="rounded-xl bg-surface-container-lowest border border-surface-container-high/40 p-4 shadow-xs space-y-3">
                        <div class="flex items-center justify-between border-b border-surface-container-high/30 pb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-md bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                                    2
                                </div>
                                <h2 class="font-title-sm font-bold text-on-surface text-sm">Select Payment Gateway Rail</h2>
                            </div>
                            <span class="text-xs text-on-surface-variant">@activeMethods.Count Rails Active</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            @foreach (var method in activeMethods)
                            {
                                var isSelected = selectedPaymentMethod?.PaymentMethodId == method.PaymentMethodId;
                                <div @onclick="() => SelectPaymentMethod(method)"
                                     class="p-3 rounded-lg border-2 transition-all cursor-pointer flex items-center justify-between @(isSelected ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40 hover:border-surface-container-high")">
                                    <div class="space-y-0.5">
                                        <div class="text-xs font-black text-on-surface flex items-center gap-1.5">
                                            <span>@method.MethodName</span>
                                        </div>
                                        <div class="text-xs font-mono text-primary font-bold">
                                            @method.AccountName
                                        </div>
                                        <div class="text-[11px] font-mono text-on-surface-variant">
                                            @method.AccountNumber
                                        </div>
                                    </div>
                                    <span class="w-4 h-4 rounded-full border-2 flex items-center justify-center @(isSelected ? "border-primary bg-primary text-on-primary text-[9px] font-bold" : "border-surface-container-high")">
                                        @if (isSelected) { <span>✓</span> }
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Instructions & QR Code Panel -->
                        @if (selectedPaymentMethod != null)
                        {
                            <div class="bg-surface-container-low border border-surface-container-high/50 rounded-lg p-3 space-y-2.5">
                                <div class="font-bold text-on-surface text-xs flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-sm text-primary">info</span>
                                    <span>Transfer Instructions &bull; @selectedPaymentMethod.MethodName</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                                    <div class="md:col-span-8 space-y-1.5 text-xs">
                                        <div class="flex items-center justify-between bg-surface-container-lowest p-2 rounded border border-surface-container-high/40">
                                            <span class="text-on-surface-variant">Account Name:</span>
                                            <span class="font-bold text-on-surface">@selectedPaymentMethod.AccountName</span>
                                        </div>
                                        <div class="flex items-center justify-between bg-surface-container-lowest p-2 rounded border border-surface-container-high/40">
                                            <span class="text-on-surface-variant">Account / Phone:</span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-mono font-bold text-primary">@selectedPaymentMethod.AccountNumber</span>
                                                <button type="button" @onclick='() => CopyToClipboard(selectedPaymentMethod.AccountNumber, "Account number")'
                                                        class="px-2 py-0.5 rounded bg-surface-container hover:bg-surface-container-high text-on-surface text-[10px] font-bold border border-surface-container-high/50 cursor-pointer flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-xs">content_copy</span> Copy
                                                </button>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(selectedPaymentMethod.Instructions))
                                        {
                                            <div class="text-[11px] text-on-surface-variant leading-relaxed">
                                                @selectedPaymentMethod.Instructions
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(selectedPaymentMethod.QrCodeImageUrl))
                                    {
                                        <div class="md:col-span-4 text-center">
                                            <div class="bg-white p-1.5 rounded-lg border border-surface-container-high/60 shadow-xs inline-block">
                                                <img src="@selectedPaymentMethod.QrCodeImageUrl" alt="Payment QR Code" class="w-24 h-24 object-contain" />
                                            </div>
                                            <span class="text-[10px] text-on-surface-variant mt-1 block">Scan QR to transfer</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- STEP 3: TRANSACTION PROOF & RECEIPT SLIP -->
                    <div class="rounded-xl bg-surface-container-lowest border border-surface-container-high/40 p-4 shadow-xs space-y-3">
                        <div class="flex items-center justify-between border-b border-surface-container-high/30 pb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-md bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                                    3
                                </div>
                                <h2 class="font-title-sm font-bold text-on-surface text-sm">Transaction Reference &amp; Receipt Proof</h2>
                            </div>
                            <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-label-sm text-xs">
                                <span class="material-symbols-outlined text-xs">shield</span> Escrow Protected
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block text-xs font-bold text-on-surface">
                                    Transaction Reference ID <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" @bind="transactionRefNo"
                                       class="w-full bg-surface-container-low border border-surface-container-high/60 rounded-lg px-3 py-1.5 text-xs font-mono font-bold text-on-surface focus:outline-none focus:border-primary"
                                       placeholder="e.g. TXN9841203 or KBZ-892147" />
                                <span class="text-[10px] text-on-surface-variant block">Copy reference ID from your banking app receipt</span>
                            </div>

                            <div class="space-y-1">
                                <label class="block text-xs font-bold text-on-surface">
                                    Upload Payment Slip Screenshot <span class="text-rose-500">*</span>
                                </label>
                                <InputFile OnChange="OnFileInputChange" accept=".jpg,.jpeg,.png,.webp,.pdf"
                                           class="w-full text-xs text-on-surface-variant file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-surface-container file:text-on-surface hover:file:bg-surface-container-high cursor-pointer" />

                                @if (!string.IsNullOrEmpty(localPreviewDataUrl))
                                {
                                    <div class="flex items-center gap-2.5 pt-1.5">
                                        <div class="relative group cursor-pointer" @onclick="() => OpenEnlargedImage(localPreviewDataUrl)" title="Click to view full size">
                                            <img src="@localPreviewDataUrl" alt="Receipt Preview" class="w-14 h-14 object-cover rounded-lg border border-primary shadow-xs transition group-hover:scale-105" />
                                            <div class="absolute inset-0 bg-black/40 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-white text-[10px] font-bold">
                                                🔍
                                            </div>
                                        </div>
                                        <div class="space-y-0.5">
                                            <button type="button" @onclick="() => OpenEnlargedImage(localPreviewDataUrl)" class="text-xs font-bold text-primary hover:underline flex items-center gap-1 cursor-pointer">
                                                <span>🔍 View full size</span>
                                            </button>
                                            <div class="text-[10px] text-on-surface-variant">@uploadedProofFile?.Name</div>
                                            <button type="button" @onclick="ClearUploadedSlip" class="text-[11px] text-rose-500 hover:underline cursor-pointer">
                                                Remove Screenshot
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label class="block text-xs font-bold text-on-surface">Optional Notes for Admin</label>
                            <input type="text" @bind="userNotes"
                                   class="w-full bg-surface-container-low border border-surface-container-high/60 rounded-lg px-3 py-1.5 text-xs text-on-surface focus:outline-none focus:border-primary"
                                   placeholder="Additional information or sender account details..." />
                        </div>

                        <!-- SUBMIT ACTION BAR (Integrated at bottom of form) -->
                        <div class="border-t border-surface-container-high/30 pt-3 flex flex-col sm:flex-row items-center justify-between gap-3">
                            <div class="text-xs text-on-surface-variant flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm text-emerald-500">verified</span>
                                <span>Manual verification &bull; Usually approved within 15 minutes</span>
                            </div>
                            <div class="flex items-center gap-2.5 w-full sm:w-auto">
                                <button type="button" @onclick="ResetForm"
                                        class="px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-bold text-xs transition cursor-pointer">
