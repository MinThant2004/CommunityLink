@code {
    private string activeTab = "buy";
    private string purchaseStatusFilter = "ALL";
    private bool submissionCompleted = false;
    private string submittedPurchaseNumber = string.Empty;

    private LinkDropWalletDto? wallet;
    private List<LinkDropPackageDto> activePackages = new();
    private List<PaymentMethodDto> activeMethods = new();
    private List<PurchaseResponseDto> userPurchases = new();
    private List<LinkDropTransactionDto> userTransactions = new();

    private bool isCustomPurchase = false;
    private LinkDropPackageDto? selectedPackage;
    private PaymentMethodDto? selectedPaymentMethod;
    private decimal customMmkAmount = 10000.0m;
    private decimal conversionRate = 10.0m; // 10 MMK per 1 Link Drop
    private long calculatedDrops = 1000;
    private decimal calculatedMmkPrice = 10000.0m;

    private string transactionRefNo = string.Empty;
    private string userNotes = string.Empty;
    private IBrowserFile? uploadedProofFile;
    private bool isSubmitting = false;

    private PurchaseResponseDto? selectedDetailPurchase;
    private string? localPreviewDataUrl;
    private bool isLightboxOpen = false;
    private string? lightboxImageUrl;

    // Unique ID for the 3D Spinning Prism header decoration
    private readonly string heroPrismContainerId = "ld_hero_prism_" + Guid.NewGuid().ToString("N")[..8];
    private bool isHeroPrismInitialized = false;

    private IEnumerable<PurchaseResponseDto> FilteredPurchases =>
        string.Equals(purchaseStatusFilter, "ALL", StringComparison.OrdinalIgnoreCase)
            ? userPurchases
            : userPurchases.Where(p => string.Equals(p.Status, purchaseStatusFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isHeroPrismInitialized)
        {
            isHeroPrismInitialized = true;
            try
            {
                await JS.InvokeVoidAsync("initLinkDrop3d", heroPrismContainerId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing hero 3D prism: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeLinkDrop3d", heroPrismContainerId);
        }
        catch
        {
            // Circuit may have disconnected
        }
    }

    private async Task LoadAllAsync()
    {
        var walletRes = await LinkDropApi.GetUserWalletAsync();
        if (walletRes.IsSuccess) wallet = walletRes.Data;

        var rateRes = await LinkDropApi.GetConversionRateAsync();
        if (rateRes.IsSuccess && rateRes.Data > 0) conversionRate = rateRes.Data;

        var pkgRes = await LinkDropApi.GetActivePackagesAsync();
        if (pkgRes.IsSuccess && pkgRes.Data != null)
        {
            activePackages = pkgRes.Data.ToList();
            if (activePackages.Count > 0 && selectedPackage == null)
            {
                selectedPackage = activePackages.First();
                Recalculate();
            }
        }

        var methodRes = await LinkDropApi.GetActivePaymentMethodsAsync();
        if (methodRes.IsSuccess && methodRes.Data != null)
        {
            activeMethods = methodRes.Data.ToList();
            if (activeMethods.Count > 0 && selectedPaymentMethod == null)
            {
                selectedPaymentMethod = activeMethods.First();
            }
        }

        await LoadPurchasesAsync();
        await LoadTransactionsAsync();
    }

    private async Task LoadPurchasesAsync()
    {
        var res = await LinkDropApi.GetUserPurchasesAsync();
        if (res.IsSuccess && res.Data != null) userPurchases = res.Data.ToList();
    }

    private async Task LoadTransactionsAsync()
    {
        var res = await LinkDropApi.GetUserTransactionsAsync();
        if (res.IsSuccess && res.Data != null) userTransactions = res.Data.ToList();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void SelectPackage(LinkDropPackageDto pkg)
    {
        selectedPackage = pkg;
        isCustomPurchase = false;
        Recalculate();
    }

    private void EnableCustomPurchase()
    {
        isCustomPurchase = true;
        Recalculate();
    }

    private void SetPresetAmount(decimal amount)
    {
        isCustomPurchase = true;
        customMmkAmount = amount;
        Recalculate();
    }

    private void SelectPaymentMethod(PaymentMethodDto method)
    {
        selectedPaymentMethod = method;
    }

    private void OnCustomAmountChanged()
    {
        if (customMmkAmount < 10) customMmkAmount = 10;
        Recalculate();
    }

    private void Recalculate()
    {
        if (!isCustomPurchase && selectedPackage != null)
        {
            calculatedMmkPrice = selectedPackage.RealMoneyAmount;
            calculatedDrops = selectedPackage.LinkDropAmount + selectedPackage.BonusAmount;
        }
        else
        {
            if (customMmkAmount < 10) customMmkAmount = 10;
            calculatedMmkPrice = customMmkAmount;
            var rate = conversionRate > 0 ? conversionRate : 10.0m;
            calculatedDrops = (long)(customMmkAmount / rate);
        }
    }

    private async Task CopyToClipboard(string text, string label)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success($"{label} copied to clipboard!");
        }
        catch
        {
            Toast.Info($"{label}: {text}");
        }
    }

    private async Task OnFileInputChange(InputFileChangeEventArgs e)
    {
        uploadedProofFile = e.File;
        localPreviewDataUrl = null;

        if (uploadedProofFile != null)
        {
            try
            {
                var format = uploadedProofFile.ContentType;
                if (string.IsNullOrWhiteSpace(format) || !format.StartsWith("image/"))
                {
                    format = "image/jpeg";
                }
                var resizedImage = await uploadedProofFile.RequestImageFileAsync(format, 1200, 1200);
                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                localPreviewDataUrl = $"data:{format};base64,{base64}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error generating slip preview: {ex.Message}");
            }
        }
    }

    private void ClearUploadedSlip()
    {
        uploadedProofFile = null;
        localPreviewDataUrl = null;
    }

    private void OpenEnlargedImage(string url)
    {
        lightboxImageUrl = url;
        isLightboxOpen = true;
    }

    private void CloseLightbox()
    {
        isLightboxOpen = false;
    }

    private string BuildFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var apiBase = Configuration["CommunityApi:BaseUrl"] ?? "https://localhost:56536";
        return $"{apiBase.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    private async Task SubmitPurchaseAsync()
    {
        if (selectedPaymentMethod == null)
        {
            Toast.Error("Please select a payment method.");
            return;
        }

        if (string.IsNullOrWhiteSpace(transactionRefNo))
        {
            Toast.Error("Please enter your Transaction Reference ID.");
            return;
        }

        if (uploadedProofFile == null)
        {
            Toast.Error("Please upload your payment slip receipt screenshot.");
            return;
        }

        isSubmitting = true;

        var request = new CreatePurchaseRequestDto
        {
            PackageId = isCustomPurchase ? null : selectedPackage?.PackageId,
            PaymentMethodId = selectedPaymentMethod.PaymentMethodId,
            IsCustomPurchase = isCustomPurchase,
            CustomRealMoneyAmount = isCustomPurchase ? customMmkAmount : null,
            CustomLinkDropAmount = isCustomPurchase ? calculatedDrops : null,
            TransactionReferenceNo = transactionRefNo.Trim(),
            UserNotes = string.IsNullOrWhiteSpace(userNotes) ? null : userNotes.Trim()
        };

        var res = await LinkDropApi.SubmitPurchaseAsync(request, uploadedProofFile);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Payment request submitted successfully! Waiting for admin verification.");
            submittedPurchaseNumber = res.Data?.PurchaseNumber ?? string.Empty;
            submissionCompleted = true;
            localPreviewDataUrl = null;
            await LoadPurchasesAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to submit payment request.");
        }
    }

    private void ResetForm()
    {
        submissionCompleted = false;
        transactionRefNo = string.Empty;
        userNotes = string.Empty;
        uploadedProofFile = null;
        localPreviewDataUrl = null;
    }
}