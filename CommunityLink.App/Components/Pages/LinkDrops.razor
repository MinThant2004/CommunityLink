                                        <span class="material-symbols-outlined text-sm">payments</span>
                                        <span>Pay @calculatedMmkPrice.ToString("N0") MMK &bull; Top Up +@calculatedDrops.ToString("N0") Drops</span>
                                    }
                                </button>
                            </div>
                        </div>

                    </div>

                </div>
            }
