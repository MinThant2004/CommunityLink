<!-- ========================================================================= -->
<!-- PURCHASE DETAIL MODAL                                                     -->
<!-- ========================================================================= -->
@if (selectedDetailPurchase != null)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest border border-surface-container-high/50 rounded-2xl p-6 max-w-md w-full space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b border-surface-container-high/30 pb-3">
                <h3 class="font-title-sm font-bold text-on-surface">Purchase Request Detail</h3>
                <button type="button" @onclick="() => selectedDetailPurchase = null" class="text-on-surface-variant hover:text-on-surface font-bold cursor-pointer">✕</button>
            </div>

            <div class="space-y-2.5 text-xs">
                <div class="flex justify-between">
                    <span class="text-on-surface-variant">Request #:</span>
                    <span class="font-mono text-on-surface font-bold">@selectedDetailPurchase.PurchaseNumber</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-on-surface-variant">Status:</span>
                    <span class="font-bold uppercase @(selectedDetailPurchase.Status == "APPROVED" ? "text-emerald-600 dark:text-emerald-400" : selectedDetailPurchase.Status == "REJECTED" ? "text-rose-600 dark:text-rose-400" : "text-amber-600 dark:text-amber-400")">
                        @selectedDetailPurchase.Status
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-on-surface-variant">Transaction ID:</span>
                    <span class="font-mono text-primary font-bold">@selectedDetailPurchase.TransactionReferenceNo</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-on-surface-variant">Amount Paid:</span>
                    <span class="font-bold text-on-surface">$@selectedDetailPurchase.SnapshotRealMoneyAmount.ToString("F2")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-on-surface-variant">Drops Granted:</span>
                    <span class="font-black text-primary inline-flex items-center gap-1.5">
                        <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                        +@selectedDetailPurchase.SnapshotLinkDropAmount.ToString("N0")
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedDetailPurchase.RejectionReason))
                {
                    <div class="bg-rose-500/10 border border-rose-500/20 rounded-xl p-3 text-rose-700 dark:text-rose-300 space-y-1 mt-2">
                        <div class="font-bold">Rejection Reason:</div>
                        <div>@selectedDetailPurchase.RejectionReason</div>
                    </div>
                }
                @if (selectedDetailPurchase.Proof != null && !string.IsNullOrWhiteSpace(selectedDetailPurchase.Proof.FileUrl))
                {
                    var proofUrl = BuildFileUrl(selectedDetailPurchase.Proof.FileUrl);
                    <div class="pt-2">
                        <span class="text-on-surface-variant block mb-1">Receipt Proof Screenshot:</span>
                        <div class="relative group cursor-pointer rounded-xl overflow-hidden border border-surface-container-high/40 bg-surface-container-low flex items-center justify-center p-1"
                             @onclick="() => OpenEnlargedImage(proofUrl)" title="Click to view full size">
                            <img src="@proofUrl" alt="Receipt Proof" class="w-full max-h-56 object-contain rounded-lg" />
                            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-white text-xs font-bold gap-1.5">
                                <span>🔍 Click to view full size</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="pt-2">
                <button type="button" @onclick="() => selectedDetailPurchase = null" class="w-full py-2.5 bg-surface-container hover:bg-surface-container-high text-on-surface font-bold rounded-lg text-xs cursor-pointer transition">
                    Close Detail
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- FULL-SIZE IMAGE LIGHTBOX MODAL                                            -->
<!-- ========================================================================= -->
@if (isLightboxOpen && !string.IsNullOrEmpty(lightboxImageUrl))
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-sm"
         @onclick="CloseLightbox">
        <div class="relative max-w-4xl max-h-[90vh] bg-surface-container-lowest border border-surface-container-high/60 rounded-2xl p-4 shadow-2xl overflow-hidden flex flex-col items-center"
             @onclick:stopPropagation="true">
            <div class="w-full flex items-center justify-between pb-2 mb-2 border-b border-surface-container-high/40 text-on-surface px-1">
                <span class="text-xs font-bold text-on-surface">Payment Slip Receipt (Original Resolution)</span>
                <button type="button" @onclick="CloseLightbox" class="text-on-surface-variant hover:text-on-surface text-lg font-bold p-1 cursor-pointer">✕</button>
            </div>
            <div class="overflow-auto max-h-[80vh] flex items-center justify-center w-full">
                <img src="@lightboxImageUrl" alt="Full size payment slip" class="max-w-full max-h-[78vh] object-contain rounded-lg" />
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "buy";
    private string purchaseStatusFilter = "ALL";
    private bool submissionCompleted = false;
    private string submittedPurchaseNumber = string.Empty;

    private LinkDropWalletDto? wallet;
    private List<LinkDropPackageDto> activePackages = new();
    private List<PaymentMethodDto> activeMethods = new();
    private List<PurchaseResponseDto> userPurchases = new();
    private List<LinkDropTransactionDto> userTransactions = new();

    private bool isCustomPurchase = false;
    private LinkDropPackageDto? selectedPackage;
    private PaymentMethodDto? selectedPaymentMethod;
    private decimal customUsdAmount = 10.0m;
    private decimal conversionRate = 100.0m;
    private long calculatedDrops = 1000;
    private decimal calculatedUsdPrice = 10.0m;

    private string transactionRefNo = string.Empty;
    private string userNotes = string.Empty;
    private IBrowserFile? uploadedProofFile;
    private bool isSubmitting = false;

    private PurchaseResponseDto? selectedDetailPurchase;
    private string? localPreviewDataUrl;
    private bool isLightboxOpen = false;
    private string? lightboxImageUrl;

    // Unique ID for the large 3D Spinning Prism hero decoration
    private readonly string heroPrismContainerId = "ld_hero_prism_" + Guid.NewGuid().ToString("N")[..8];
    private bool isHeroPrismInitialized = false;

    private IEnumerable<PurchaseResponseDto> FilteredPurchases =>
        string.Equals(purchaseStatusFilter, "ALL", StringComparison.OrdinalIgnoreCase)
            ? userPurchases
            : userPurchases.Where(p => string.Equals(p.Status, purchaseStatusFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isHeroPrismInitialized)
        {
            isHeroPrismInitialized = true;
            try
            {
                await JS.InvokeVoidAsync("initLinkDrop3d", heroPrismContainerId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing hero 3D prism: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeLinkDrop3d", heroPrismContainerId);
        }
        catch
        {
            // Circuit may have disconnected
        }
    }

    private async Task LoadAllAsync()
    {
        var walletRes = await LinkDropApi.GetUserWalletAsync();
        if (walletRes.IsSuccess) wallet = walletRes.Data;

        var rateRes = await LinkDropApi.GetConversionRateAsync();
        if (rateRes.IsSuccess) conversionRate = rateRes.Data;

        var pkgRes = await LinkDropApi.GetActivePackagesAsync();
        if (pkgRes.IsSuccess && pkgRes.Data != null)
        {
            activePackages = pkgRes.Data.ToList();
            if (activePackages.Count > 0 && selectedPackage == null)
            {
                selectedPackage = activePackages.First();
                Recalculate();
            }
        }

        var methodRes = await LinkDropApi.GetActivePaymentMethodsAsync();
        if (methodRes.IsSuccess && methodRes.Data != null)
        {
            activeMethods = methodRes.Data.ToList();
            if (activeMethods.Count > 0 && selectedPaymentMethod == null)
            {
                selectedPaymentMethod = activeMethods.First();
            }
        }

        await LoadPurchasesAsync();
        await LoadTransactionsAsync();
    }

    private async Task LoadPurchasesAsync()
    {
        var res = await LinkDropApi.GetUserPurchasesAsync();
        if (res.IsSuccess && res.Data != null) userPurchases = res.Data.ToList();
    }

    private async Task LoadTransactionsAsync()
    {
        var res = await LinkDropApi.GetUserTransactionsAsync();
        if (res.IsSuccess && res.Data != null) userTransactions = res.Data.ToList();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void SelectPackage(LinkDropPackageDto pkg)
    {
        selectedPackage = pkg;
        isCustomPurchase = false;
        Recalculate();
    }

    private void EnableCustomPurchase()
    {
        isCustomPurchase = true;
        Recalculate();
    }

    private void SetPresetAmount(decimal amount)
    {
        isCustomPurchase = true;
        customUsdAmount = amount;
        Recalculate();
    }

    private void SelectPaymentMethod(PaymentMethodDto method)
    {
        selectedPaymentMethod = method;
    }

    private void OnCustomAmountChanged()
    {
        if (customUsdAmount < 1) customUsdAmount = 1;
        Recalculate();
    }

    private void Recalculate()
    {
        if (!isCustomPurchase && selectedPackage != null)
        {
            calculatedUsdPrice = selectedPackage.RealMoneyAmount;
            calculatedDrops = selectedPackage.LinkDropAmount + selectedPackage.BonusAmount;
        }
        else
        {
            calculatedUsdPrice = customUsdAmount;
            calculatedDrops = (long)(customUsdAmount * conversionRate);
        }
    }

    private async Task CopyToClipboard(string text, string label)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success($"{label} copied to clipboard!");
        }
        catch
        {
            Toast.Info($"{label}: {text}");
        }
    }

    private async Task OnFileInputChange(InputFileChangeEventArgs e)
    {
        uploadedProofFile = e.File;
        localPreviewDataUrl = null;

        if (uploadedProofFile != null)
        {
            try
            {
                var format = uploadedProofFile.ContentType;
                if (string.IsNullOrWhiteSpace(format) || !format.StartsWith("image/"))
                {
                    format = "image/jpeg";
                }
                var resizedImage = await uploadedProofFile.RequestImageFileAsync(format, 1200, 1200);
                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                localPreviewDataUrl = $"data:{format};base64,{base64}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error generating slip preview: {ex.Message}");
            }
        }
    }

    private void ClearUploadedSlip()
    {
        uploadedProofFile = null;
        localPreviewDataUrl = null;
    }

    private void OpenEnlargedImage(string url)
    {
        lightboxImageUrl = url;
        isLightboxOpen = true;
    }

    private void CloseLightbox()
    {
        isLightboxOpen = false;
    }

    private string BuildFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var apiBase = Configuration["CommunityApi:BaseUrl"] ?? "https://localhost:56536";
        return $"{apiBase.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    private async Task SubmitPurchaseAsync()
    {
        if (selectedPaymentMethod == null)
        {
            Toast.Error("Please select a payment method.");
            return;
        }

        if (string.IsNullOrWhiteSpace(transactionRefNo))
        {
            Toast.Error("Please enter your Transaction Reference ID.");
            return;
        }

        if (uploadedProofFile == null)
        {
            Toast.Error("Please upload your payment slip receipt screenshot.");
            return;
        }

        isSubmitting = true;

        var request = new CreatePurchaseRequestDto
        {
            PackageId = isCustomPurchase ? null : selectedPackage?.PackageId,
            PaymentMethodId = selectedPaymentMethod.PaymentMethodId,
            IsCustomPurchase = isCustomPurchase,
            CustomRealMoneyAmount = isCustomPurchase ? customUsdAmount : null,
            CustomLinkDropAmount = isCustomPurchase ? calculatedDrops : null,
            TransactionReferenceNo = transactionRefNo.Trim(),
            UserNotes = string.IsNullOrWhiteSpace(userNotes) ? null : userNotes.Trim()
        };

        var res = await LinkDropApi.SubmitPurchaseAsync(request, uploadedProofFile);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Payment request submitted successfully! Waiting for admin verification.");
            submittedPurchaseNumber = res.Data?.PurchaseNumber ?? string.Empty;
            submissionCompleted = true;
            localPreviewDataUrl = null;
            await LoadPurchasesAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to submit payment request.");
        }
    }

    private void ResetForm()
    {
        submissionCompleted = false;
        transactionRefNo = string.Empty;
        userNotes = string.Empty;
        uploadedProofFile = null;
        localPreviewDataUrl = null;
    }
}