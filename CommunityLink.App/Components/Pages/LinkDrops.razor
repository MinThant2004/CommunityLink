                <!-- Ledger Audit Table -->
                <div class="rounded-xl bg-surface-container-lowest border border-surface-container-high/40 p-4 shadow-xs space-y-3">
                    <div class="border-b border-surface-container-high/30 pb-2">
                        <h2 class="font-title-sm font-bold text-on-surface text-sm">Wallet Transaction Ledger</h2>
                        <p class="text-on-surface-variant text-xs">Immutable audit trail of all debits, credits, and platform settlements</p>
                    </div>

                    @if (userTransactions.Count == 0)
                    {
                        <div class="py-8 text-center text-on-surface-variant text-xs">No transactions logged on this wallet yet.</div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-surface-container text-on-surface-variant uppercase text-[10px] tracking-wider border-b border-surface-container-high/40">
                                    <tr>
                                        <th class="p-2.5">Date</th>
                                        <th class="p-2.5">Transaction Type</th>
                                        <th class="p-2.5">Amount</th>
                                        <th class="p-2.5">Balance Before</th>
                                        <th class="p-2.5">Balance After</th>
                                        <th class="p-2.5">Audit Notes</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-surface-container-high/30">
                                    @foreach (var tx in userTransactions)
                                    {
                                        <tr class="hover:bg-surface-container/50 transition-colors">
                                            <td class="p-2.5 font-mono text-on-surface-variant">@tx.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td class="p-2.5 font-bold text-primary">@tx.TransactionType</td>
                                            <td class="p-2.5 font-black @(tx.Amount >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                                                @(tx.Amount >= 0 ? "+" : "")@tx.Amount.ToString("N0") Drops
                                            </td>
                                            <td class="p-2.5 font-mono text-on-surface-variant">@tx.BalanceBefore.ToString("N0")</td>
                                            <td class="p-2.5 font-mono text-on-surface font-bold">@tx.BalanceAfter.ToString("N0")</td>
                                            <td class="p-2.5 text-on-surface-variant">@(tx.Notes ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

