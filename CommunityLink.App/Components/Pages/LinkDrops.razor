@page "/link-drops"
@page "/linkdrops"
@using CommunityLink.App.Apis
@using CommunityLink.App.Services
@using CommunityLink.Shared.Features.LinkDrop
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>LinkDrop Sovereign Treasury & Refill — CommunityLink</PageTitle>

<div class="min-h-screen bg-background font-body-md text-body-md text-on-surface antialiased transition-colors duration-200">
    <!-- Top System Directory Strip -->
    <section class="bg-surface-container-lowest/80 backdrop-blur-md border-b border-surface-container-high/30">
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop py-space-sm flex items-center justify-between gap-3">
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <a href="/" class="hover:text-on-surface transition-colors flex items-center gap-1">Platform</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">LinkDrop Treasury</span>
            </div>
            <div class="flex items-center gap-space-sm">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider hidden sm:inline">Settlement Protocol</span>
                <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-primary font-label-sm text-label-sm border border-primary/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>LinkDrop Settlement Active
                </span>
            </div>
        </div>
    </section>

    <!-- Ambient Glowing Background Elements -->
    <div class="relative w-full overflow-hidden">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute top-40 right-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pt-space-md pb-space-lg w-full space-y-space-lg">

            <!-- Breadcrumbs -->
            <nav aria-label="Breadcrumbs" class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <a class="hover:text-primary transition-colors" href="/">Platform</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">LinkDrop Virtual Currency &amp; Treasury</span>
            </nav>

            <!-- HERO PANEL: Executive Layout with Large 3D Spinning Prism Showcase -->
            <div class="relative rounded-2xl bg-surface-container-low p-space-md md:p-space-lg lg:p-space-xl overflow-hidden border border-surface-container-high/30 shadow-xs">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/35 to-transparent"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
                    
                    <!-- Left Column: Title & Sovereign Settlement Context -->
                    <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-space-sm">
                        <!-- Badges Row -->
                        <div class="flex flex-wrap items-center gap-space-sm">
                            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-highest text-primary font-label-sm text-label-sm uppercase tracking-wider border border-primary/20">
                                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">verified</span>Sovereign Virtual Currency
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm border border-surface-container-high/40">
                                <span class="material-symbols-outlined text-xs text-secondary">currency_exchange</span>
                                <span>Exchange Peg:</span>
                                <strong class="text-on-surface font-mono">1 USD = 100 Drops (~10 MMK/Drop)</strong>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm border border-surface-container-high/40">
                                <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                <span>Balance:</span>
                                <strong class="text-primary font-mono">@(wallet?.Balance.ToString("N0") ?? "0") Drops</strong>
                            </span>
                        </div>

                        <!-- Grand Title -->
                        <h1 class="font-headline-lg text-headline-lg md:text-display-md text-on-surface tracking-tight font-black leading-tight mt-space-xs">
                            LinkDrop Treasury &amp; Settlement Platform
                        </h1>

                        <!-- Rich Narrative Content -->
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed max-w-2xl">
                            LinkDrops are the sovereign utility currency powering CommunityLink. Use your balance to unlock verified creator memberships, book private 1-on-1 expert advisory sessions, tip standout community builders, and gain access to sovereign sub-communities. Choose a verified top-up bundle or specify a custom allocation with instant multi-channel local settlement.
                        </p>

                        <!-- Quick Statistics Strip -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-space-sm mt-space-xs">
                            <div class="p-3 rounded-xl bg-surface-container-lowest/80 border border-surface-container-high/40 shadow-xs flex flex-col justify-between">
                                <span class="text-[11px] font-label-sm text-on-surface-variant uppercase tracking-wider">Total Balance</span>
                                <div class="text-lg font-black text-primary flex items-center gap-1.5 mt-0.5">
                                    <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                    <span>@(wallet?.Balance.ToString("N0") ?? "0")</span>
                                </div>
                            </div>
                            <div class="p-3 rounded-xl bg-surface-container-lowest/80 border border-surface-container-high/40 shadow-xs flex flex-col justify-between">
                                <span class="text-[11px] font-label-sm text-on-surface-variant uppercase tracking-wider">Purchased Drops</span>
                                <div class="text-lg font-bold text-on-surface mt-0.5">
                                    @(wallet?.PurchasedBalance.ToString("N0") ?? "0")
                                </div>
                            </div>
                            <div class="p-3 rounded-xl bg-surface-container-lowest/80 border border-surface-container-high/40 shadow-xs flex flex-col justify-between">
                                <span class="text-[11px] font-label-sm text-on-surface-variant uppercase tracking-wider">Earned Drops</span>
                                <div class="text-lg font-bold text-on-surface mt-0.5">
                                    @(wallet?.EarnedBalance.ToString("N0") ?? "0")
                                </div>
                            </div>
                            <div class="p-3 rounded-xl bg-surface-container-lowest/80 border border-surface-container-high/40 shadow-xs flex flex-col justify-between">
                                <span class="text-[11px] font-label-sm text-on-surface-variant uppercase tracking-wider">Verification SLA</span>
                                <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 mt-0.5">
                                    <span class="material-symbols-outlined text-sm">bolt</span>
                                    <span>&lt; 15 Mins</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Prominent 3D Spinning Prism Page Decoration -->
                    <div class="lg:col-span-5 xl:col-span-4 flex flex-col items-center justify-center relative">
                        <!-- Ambient Neon Glow Halo Backdrop -->
                        <div class="absolute w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full bg-gradient-to-tr from-sky-400/20 via-primary/25 to-indigo-500/20 blur-3xl pointer-events-none -z-0"></div>

                        <!-- Showcase Stage Card -->
                        <div class="relative w-full max-w-[320px] rounded-3xl bg-surface-container/50 backdrop-blur-md border border-surface-container-high/50 p-4 flex flex-col items-center justify-center shadow-lg group">
                            
                            <!-- Concentric Neon Orbit Accents -->
                            <div class="absolute inset-4 rounded-full border border-sky-400/20 animate-pulse pointer-events-none"></div>
                            <div class="absolute inset-8 rounded-full border border-primary/20 border-dashed pointer-events-none"></div>

                            <!-- 3D Spinning Prism Container -->
                            <div id="@heroPrismContainerId"
                                 class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 relative z-10 flex items-center justify-center cursor-grab active:cursor-grabbing select-none"
                                 title="Interactive 3D LinkDrop Sovereign Prism — Click & drag to rotate freely">
                            </div>

                            <!-- Interactive Badge Label -->
                            <div class="relative z-10 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md border border-surface-container-high/50 text-on-surface-variant font-label-sm text-[11px] shadow-xs mt-1 transition group-hover:border-primary/40">
                                <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-ping"></span>
                                <span class="font-medium">✨ 3D Sovereign Prism &bull; Drag to Rotate</span>
                            </div>

                            <!-- Micro Feature Chips -->
                            <div class="flex items-center gap-2 mt-3 text-[10px] font-label-sm text-on-surface-variant/80">
                                <span>Zero Fees</span>
                                <span>&bull;</span>
                                <span>On-Platform Escrow</span>
                                <span>&bull;</span>
                                <span>Instant Utility</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- NAVIGATION TABS STRIP -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-space-sm bg-surface-container-lowest border border-surface-container-high/40 rounded-xl p-2 shadow-xs">
                <div class="flex items-center gap-1.5 overflow-x-auto p-1">
                    <button type="button" @onclick='() => SetTab("buy")'
                            class="px-4 py-2.5 rounded-lg font-label-md text-label-md font-bold transition-all flex items-center gap-2 cursor-pointer @(activeTab == "buy" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                        <LinkDropIcon Class="w-4 h-4 shrink-0" />
                        <span>Top-Up LinkDrops</span>
                    </button>
                    <button type="button" @onclick='() => SetTab("purchases")'
                            class="px-4 py-2.5 rounded-lg font-label-md text-label-md font-bold transition-all flex items-center gap-2 cursor-pointer @(activeTab == "purchases" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                        <span class="material-symbols-outlined text-sm">receipt_long</span>
                        <span>My Purchases</span>
                        @if (userPurchases.Any(p => p.Status == "PENDING"))
                        {
                            <span class="px-2 py-0.5 text-[10px] bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-full font-bold border border-amber-500/30">
                                @(userPurchases.Count(p => p.Status == "PENDING"))
                            </span>
                        }
                    </button>
                    <button type="button" @onclick='() => SetTab("ledger")'
                            class="px-4 py-2.5 rounded-lg font-label-md text-label-md font-bold transition-all flex items-center gap-2 cursor-pointer @(activeTab == "ledger" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                        <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
                        <span>Wallet &amp; Ledger</span>
                    </button>
                    <button type="button" @onclick='() => SetTab("utility")'
                            class="px-4 py-2.5 rounded-lg font-label-md text-label-md font-bold transition-all flex items-center gap-2 cursor-pointer @(activeTab == "utility" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container")">
                        <span class="material-symbols-outlined text-sm">help_outline</span>
                        <span>Ecosystem Utility</span>
                    </button>
                </div>

                <!-- Quick Active Balance Pill -->
                <div class="flex items-center justify-between sm:justify-end gap-3 px-3 py-1.5 rounded-lg bg-surface-container border border-surface-container-high/30">
                    <span class="text-on-surface-variant font-label-sm text-label-sm">Active Balance:</span>
                    <div class="inline-flex items-center gap-1.5 font-title-sm font-bold text-primary">
                        <LinkDropIcon Class="w-4 h-4 shrink-0" />
                        <span>@(wallet?.Balance.ToString("N0") ?? "0") Drops</span>
                    </div>
                </div>
            </div>

            <!-- ============================================================= -->
            <!-- TAB 1: TOP-UP LINKDROPS WORKFLOW                             -->
            <!-- ============================================================= -->
            @if (activeTab == "buy")
            {
                @if (submissionCompleted)
                {
                    <!-- SUBMISSION SUCCESS CONFIRMATION BANNER -->
                    <div class="rounded-2xl bg-surface-container-lowest border border-emerald-500/30 p-8 text-center space-y-6 shadow-sm max-w-2xl mx-auto">
                        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-3xl font-bold mx-auto border border-emerald-500/30 animate-bounce">
                            ✓
                        </div>
                        <div class="space-y-2">
                            <span class="inline-block px-3 py-0.5 bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/30 text-[11px] font-bold rounded-full uppercase tracking-wider">
                                Status: PENDING ADMIN VERIFICATION
                            </span>
                            <h2 class="text-2xl font-black text-on-surface">Payment Request Submitted!</h2>
                            <p class="text-on-surface-variant text-sm max-w-md mx-auto leading-relaxed">
                                Your payment receipt slip and transaction reference have been received by SecOps. LinkDrops will be credited after manual audit verification.
                            </p>
                        </div>

                        <div class="bg-surface-container-low border border-surface-container-high/50 rounded-xl p-4 text-left text-xs space-y-2.5 max-w-md mx-auto">
                            <div class="flex justify-between border-b border-surface-container-high/30 pb-2">
                                <span class="text-on-surface-variant font-medium">Request Number:</span>
                                <span class="font-mono text-on-surface font-bold">@submittedPurchaseNumber</span>
                            </div>
                            <div class="flex justify-between border-b border-surface-container-high/30 pb-2">
                                <span class="text-on-surface-variant font-medium">Transaction ID:</span>
                                <span class="font-mono text-primary font-bold">@transactionRefNo</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-on-surface-variant font-medium">Target Credit:</span>
                                <span class="text-emerald-600 dark:text-emerald-400 font-extrabold flex items-center gap-1">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    +@calculatedDrops.ToString("N0") Link Drops
                                </span>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3 justify-center pt-2">
                            <button @onclick='() => SetTab("purchases")'
                                    class="px-5 py-2.5 bg-primary text-on-primary font-bold text-xs rounded-lg transition-all shadow-xs cursor-pointer hover:opacity-90 flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm">receipt_long</span>
                                <span>Track in My Purchases</span>
                            </button>
                            <button @onclick="ResetForm"
                                    class="px-5 py-2.5 bg-surface-container hover:bg-surface-container-high text-on-surface font-bold text-xs rounded-lg transition-all border border-surface-container-high/50 cursor-pointer flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm">add_circle</span>
                                <span>Submit Another Top-Up</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
                        
                        <!-- Left Form Sections (8 Cols) -->
                        <div class="lg:col-span-8 space-y-space-md">
                            
                            <!-- STEP 1: SELECT BUNDLE / AMOUNT -->
                            <div class="rounded-2xl bg-surface-container-lowest border border-surface-container-high/40 p-space-md md:p-space-lg shadow-xs space-y-space-md">
                                <div class="flex items-center justify-between border-b border-surface-container-high/30 pb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                                            1
                                        </div>
                                        <div>
                                            <h2 class="font-title-md font-bold text-on-surface">Select LinkDrop Bundle</h2>
                                            <p class="text-on-surface-variant font-label-sm text-label-sm">Choose a predefined tier or specify custom allocation</p>
                                        </div>
                                    </div>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-[11px]">
                                        <span class="material-symbols-outlined text-xs text-primary">percent</span> Bonus Included
                                    </span>
                                </div>

                                <!-- Predefined Packages Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                    @foreach (var pkg in activePackages)
                                    {
                                        var isSelected = !isCustomPurchase && selectedPackage?.PackageId == pkg.PackageId;
                                        <div @onclick="() => SelectPackage(pkg)"
                                             class="p-4 rounded-xl border-2 transition-all cursor-pointer flex flex-col justify-between space-y-3 relative @(isSelected ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40 hover:border-surface-container-high")">
                                            
                                            <div class="flex items-center justify-between">
                                                <span class="text-[11px] font-black uppercase tracking-wider @(isSelected ? "text-primary" : "text-on-surface-variant")">
                                                    @pkg.PackageName
                                                </span>
                                                @if (isSelected)
                                                {
                                                    <span class="w-4 h-4 rounded-full bg-primary text-on-primary flex items-center justify-center text-[10px] font-bold">✓</span>
                                                }
                                                else if (pkg.BonusAmount > 0)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[9px] border border-emerald-500/20">
                                                        +@pkg.BonusAmount.ToString("N0") Bonus
                                                    </span>
                                                }
                                            </div>

                                            <div>
                                                <div class="text-xl font-black text-on-surface flex items-center gap-1.5">
                                                    <LinkDropIcon Class="w-5 h-5 shrink-0" />
                                                    <span>+@((pkg.LinkDropAmount + pkg.BonusAmount).ToString("N0"))</span>
                                                </div>
                                                <div class="text-xs font-bold text-on-surface-variant mt-0.5">
                                                    $@pkg.RealMoneyAmount.ToString("F2") USD
                                                </div>
                                                <div class="text-[11px] text-on-surface-variant/70 font-mono mt-0.5">
                                                    ~@((pkg.RealMoneyAmount * 3500m).ToString("N0")) MMK
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Custom Amount Calculator Card -->
                                <div class="p-4 rounded-xl border-2 transition-all space-y-3 @(isCustomPurchase ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40")">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <button type="button" @onclick="EnableCustomPurchase"
                                                    class="px-3 py-1.5 bg-primary text-on-primary font-bold text-xs rounded-lg shrink-0 flex items-center gap-1.5 cursor-pointer">
                                                <span class="material-symbols-outlined text-xs">calculate</span>
                                                <span>Custom Amount</span>
                                            </button>
                                            <span class="text-xs text-on-surface-variant font-medium">Specify any custom budget in USD</span>
                                        </div>

                                        <!-- Quick Presets -->
                                        <div class="flex items-center gap-1.5 overflow-x-auto">
                                            <button type="button" @onclick="() => SetPresetAmount(10)" class="px-2 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">$10</button>
                                            <button type="button" @onclick="() => SetPresetAmount(25)" class="px-2 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">$25</button>
                                            <button type="button" @onclick="() => SetPresetAmount(50)" class="px-2 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">$50</button>
                                            <button type="button" @onclick="() => SetPresetAmount(100)" class="px-2 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">$100</button>
                                            <button type="button" @onclick="() => SetPresetAmount(250)" class="px-2 py-1 rounded bg-surface-container text-on-surface-variant hover:text-on-surface text-[11px] font-bold cursor-pointer">$250</button>
                                        </div>
                                    </div>

                                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
                                        <div class="flex items-center gap-2 flex-1">
                                            <span class="text-sm font-bold text-on-surface-variant">$</span>
                                            <input type="number" min="1" max="10000" step="1"
                                                   @bind="customUsdAmount" @bind:after="OnCustomAmountChanged"
                                                   class="w-full bg-surface-container-lowest border border-surface-container-high/60 rounded-lg px-3 py-2 text-sm font-bold text-on-surface focus:outline-none focus:border-primary"
                                                   placeholder="e.g. 50.00 USD" />
                                        </div>
                                        <div class="flex items-center justify-between sm:justify-start gap-2 bg-surface-container px-3 py-2 rounded-lg border border-surface-container-high/30">
                                            <span class="text-xs text-on-surface-variant">Credits:</span>
                                            <span class="text-sm font-black text-primary inline-flex items-center gap-1.5 whitespace-nowrap">
                                                <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                                <span>+@calculatedDrops.ToString("N0") Drops</span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- STEP 2: SELECT PAYMENT METHOD RAIL -->
                            <div class="rounded-2xl bg-surface-container-lowest border border-surface-container-high/40 p-space-md md:p-space-lg shadow-xs space-y-space-md">
                                <div class="flex items-center justify-between border-b border-surface-container-high/30 pb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                                            2
                                        </div>
                                        <div>
                                            <h2 class="font-title-md font-bold text-on-surface">Select Payment Gateway Rail</h2>
                                            <p class="text-on-surface-variant font-label-sm text-label-sm">Direct transfer via verified local mobile wallets &amp; bank accounts</p>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-on-surface-variant">@activeMethods.Count Rails Active</span>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var method in activeMethods)
                                    {
                                        var isSelected = selectedPaymentMethod?.PaymentMethodId == method.PaymentMethodId;
                                        <div @onclick="() => SelectPaymentMethod(method)"
                                             class="p-4 rounded-xl border-2 transition-all cursor-pointer flex items-center justify-between @(isSelected ? "bg-primary/5 border-primary shadow-xs" : "bg-surface-container-low border-surface-container-high/40 hover:border-surface-container-high")">
                                            <div class="space-y-1">
                                                <div class="text-sm font-black text-on-surface flex items-center gap-1.5">
                                                    <span>@method.MethodName</span>
                                                </div>
                                                <div class="text-xs font-mono text-primary font-bold">
                                                    @method.AccountName
                                                </div>
                                                <div class="text-[11px] font-mono text-on-surface-variant">
                                                    @method.AccountNumber
                                                </div>
                                            </div>
                                            <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center @(isSelected ? "border-primary bg-primary text-on-primary text-[10px] font-bold" : "border-surface-container-high")">
                                                @if (isSelected) { <span>✓</span> }
                                            </span>
                                        </div>
                                    }
                                </div>

                                <!-- Dynamic Instructions & QR Code Panel -->
                                @if (selectedPaymentMethod != null)
                                {
