@inject ChatGroupApiService ChatGroupApi
@inject ToastService Toast
@inject NavigationManager NavManager

<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl">
        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                    </svg>
                </span>
                <h3 class="font-bold text-slate-900 text-base">Create Standalone Chat Group</h3>
            </div>
            <button type="button" @onclick="OnClose" class="text-slate-400 hover:text-slate-700 p-1.5 rounded-xl hover:bg-slate-200 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Form Body -->
        <div class="p-6 space-y-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-center gap-2 font-medium">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Chat Group Name <span class="text-rose-500">*</span></label>
                <input type="text" @bind="name" placeholder="e.g., Mg Mg C# Expert Group"
                       class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Description</label>
                <textarea @bind="description" rows="3" placeholder="What is this Chat Group about?"
                          class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition resize-none"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Avatar Image URL (Optional)</label>
                <input type="text" @bind="avatarUrl" placeholder="https://example.com/avatar.png"
                       class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
            </div>

            <!-- Chat Type Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-2">Group Type</label>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" @onclick="SelectFreeType"
                            class="p-3.5 rounded-xl border text-left transition flex items-center gap-3 cursor-pointer @(chatType == "FREE" ? "bg-emerald-50 border-emerald-300 text-emerald-800 shadow-2xs" : "bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300")">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <div>
                            <div class="text-xs font-bold text-slate-900">Free Group</div>
                            <div class="text-[11px] text-slate-500">Anyone can join instantly</div>
                        </div>
                    </button>

                    <button type="button" @onclick="SelectPaidType"
                            class="p-3.5 rounded-xl border text-left transition flex items-center gap-3 cursor-pointer @(chatType == "PAID" ? "bg-amber-50 border-amber-300 text-amber-800 shadow-2xs" : "bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300")">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        <div>
                            <div class="text-xs font-bold text-slate-900">Paid Group</div>
                            <div class="text-[11px] text-slate-500">Requires Link Drops fee</div>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Join Fee input when PAID selected -->
            @if (chatType == "PAID")
            {
                <div class="p-4 bg-amber-50/60 border border-amber-200 rounded-xl space-y-2">
                    <label class="block text-xs font-bold text-amber-900">Join Fee (Link Drops) <span class="text-rose-500">*</span></label>
                    <input type="number" min="1" @bind="joinFeeLinkDrops" placeholder="e.g. 50"
                           class="w-full px-3.5 py-2 bg-white border border-amber-300 rounded-xl text-sm text-slate-900 font-bold focus:outline-none focus:border-amber-500 transition" />
                    <p class="text-[11px] text-amber-800">Users will be required to pay this fee in Link Drops to join.</p>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-end gap-3">
            <button type="button" @onclick="OnClose" disabled="@isSubmitting"
                    class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 shadow-2xs transition cursor-pointer">
                Cancel
            </button>
            <button type="button" @onclick="HandleSubmit" disabled="@isSubmitting"
                    class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition inline-flex items-center gap-2 cursor-pointer disabled:opacity-50">
                @if (isSubmitting)
                {
                    <span class="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-white"></span>
                    <span>Creating...</span>
                }
                else
                {
                    <span>Create Chat Group</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<ChatGroupModel> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string name = "";
    private string description = "";
    private string avatarUrl = "";
    private string chatType = "FREE";
    private long joinFeeLinkDrops = 50;

    private bool isSubmitting;
    private string? errorMessage;

    private void SelectFreeType() => chatType = "FREE";
    private void SelectPaidType() => chatType = "PAID";

    private async Task HandleSubmit()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "Please enter a group name.";
            return;
        }

        if (chatType == "PAID" && joinFeeLinkDrops <= 0)
        {
            errorMessage = "Join fee must be greater than 0 Link Drops for Paid Chat Groups.";
            return;
        }

        isSubmitting = true;
        var request = new CreateChatGroupRequestModel(name, description, avatarUrl, chatType, chatType == "PAID" ? joinFeeLinkDrops : 0);
        var res = await ChatGroupApi.CreateChatGroupAsync(request);
        isSubmitting = false;

        if (res.IsSuccess && res.Data != null)
        {
            Toast.Success("Chat Group created successfully!");
            await OnSaved.InvokeAsync(res.Data);
            await OnClose.InvokeAsync();
            NavManager.NavigateTo($"/chat-groups/{res.Data.ChatGroupId}");
        }
        else
        {
            errorMessage = res.Message ?? "Failed to create Chat Group.";
            Toast.Error(errorMessage);
        }
    }
}
