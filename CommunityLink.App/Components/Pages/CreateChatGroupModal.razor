@using CommunityLink.App.Components.Shared.Chat
@inject ChatGroupApiService ChatGroupApi
@inject ToastService Toast

<ChatModal IsOpen="true" Title="Create a chat group" MaxWidth="max-w-lg" OnClose="OnClose">
    <ChildContent>
    <div class="space-y-4 px-4 py-4">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="flex items-start gap-2 rounded-lg border border-rose-200 bg-rose-50 p-3" role="alert">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <span class="text-sm font-medium text-rose-800">@errorMessage</span>
            </div>
        }

        <div>
            <label for="cg-name" class="mb-1 block text-xs font-semibold text-slate-700">Group name <span class="text-rose-500" aria-hidden="true">*</span></label>
            <input id="cg-name" type="text" @bind="name" placeholder="e.g. .NET Community Group"
                   class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600" />
        </div>

        <div>
            <label for="cg-description" class="mb-1 block text-xs font-semibold text-slate-700">Description</label>
            <textarea id="cg-description" @bind="description" rows="3" placeholder="What is this group about?"
                      class="w-full resize-none rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600"></textarea>
        </div>

        <div>
            <label for="cg-avatar" class="mb-1 block text-xs font-semibold text-slate-700">Avatar image URL <span class="text-slate-400">(optional)</span></label>
            <input id="cg-avatar" type="text" @bind="avatarUrl" placeholder="https://example.com/avatar.png"
                   class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600" />
        </div>

        <fieldset>
            <legend class="mb-2 text-xs font-semibold text-slate-700">Group type</legend>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <button type="button" @onclick="SelectFreeType" aria-pressed="@(chatType == "FREE")"
                        class="flex items-center gap-3 rounded-lg border p-3.5 text-left transition focus:outline-none focus:ring-2 focus:ring-indigo-500
                               @(chatType == "FREE" ? "border-emerald-300 bg-emerald-50" : "border-slate-200 bg-slate-50 hover:border-slate-300")">
                    <svg class="h-5 w-5 shrink-0 @(chatType == "FREE" ? "text-emerald-600" : "text-slate-400")" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>
                        <span class="block text-xs font-semibold text-slate-900">Free group</span>
                        <span class="block text-xs text-slate-500">Anyone can join instantly</span>
                    </span>
                </button>

                <button type="button" @onclick="SelectPaidType" aria-pressed="@(chatType == "PAID")"
                        class="flex items-center gap-3 rounded-lg border p-3.5 text-left transition focus:outline-none focus:ring-2 focus:ring-indigo-500
                               @(chatType == "PAID" ? "border-amber-300 bg-amber-50" : "border-slate-200 bg-slate-50 hover:border-slate-300")">
                    <svg class="h-5 w-5 shrink-0 @(chatType == "PAID" ? "text-amber-600" : "text-slate-400")" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>
                        <span class="block text-xs font-semibold text-slate-900">Paid group</span>
                        <span class="block text-xs text-slate-500">Requires a LinkDrops fee</span>
                    </span>
                </button>
            </div>
        </fieldset>

        @if (chatType == "PAID")
        {
            <div class="space-y-2 rounded-lg border border-amber-200 bg-amber-50 p-4">
                <label for="cg-fee" class="block text-xs font-semibold text-amber-900">Join fee (LinkDrops)</label>
                <input id="cg-fee" type="number" min="1" @bind="joinFeeLinkDrops" placeholder="e.g. 50"
                       class="w-full rounded-lg border border-amber-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 transition focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500" />
                <p class="text-xs text-amber-800">
                    Members pay this once to join. The platform commission is deducted automatically and the rest is credited to your earnings.
                </p>
            </div>
        }
    </div>
    </ChildContent>

    <FooterContent>
        <button type="button" @onclick="OnClose" disabled="@isSubmitting"
                class="rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-slate-300">
            Cancel
        </button>
        <button type="button" @onclick="HandleSubmit" disabled="@isSubmitting"
                class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            @if (isSubmitting)
            {
                <span class="h-3.5 w-3.5 animate-spin rounded-full border-b-2 border-white"></span>
                <span>Creating…</span>
            }
            else
            {
                <span>Create group</span>
            }
        </button>
    </FooterContent>
</ChatModal>

@code {
    [Parameter] public EventCallback<ChatGroupModel> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string name = "";
    private string description = "";
    private string avatarUrl = "";
    private string chatType = "FREE";
    private long joinFeeLinkDrops = 50;

    private bool isSubmitting;
    private string? errorMessage;

    private void SelectFreeType() => chatType = "FREE";

    private void SelectPaidType() => chatType = "PAID";

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "Please enter a group name.";
            return;
        }

        if (chatType == "PAID" && joinFeeLinkDrops <= 0)
        {
            errorMessage = "Join fee must be greater than 0 LinkDrops for paid groups.";
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        var request = new CreateChatGroupRequestModel(
            name.Trim(),
            string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
            string.IsNullOrWhiteSpace(avatarUrl) ? null : avatarUrl.Trim(),
            chatType,
            chatType == "PAID" ? joinFeeLinkDrops : 0);

        var res = await ChatGroupApi.CreateChatGroupAsync(request);
        isSubmitting = false;

        if (res.IsSuccess && res.Data is not null)
        {
            // The parent owns navigation, so the new thread opens exactly once.
            await OnSaved.InvokeAsync(res.Data);
        }
        else
        {
            errorMessage = res.Message ?? "Failed to create the group.";
            Toast.Error(errorMessage);
        }
    }
}
