    private static List<AttachedTextFileItem> ParseProfileTextFiles(string codeSnippet, string? codeFileName)
    {
        var list = new List<AttachedTextFileItem>();
        if (string.IsNullOrWhiteSpace(codeSnippet)) return list;

        if (codeSnippet.TrimStart().StartsWith("[") && codeSnippet.Contains("\"FileName\""))
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<AttachedTextFileItem>>(codeSnippet, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (parsed != null && parsed.Count > 0)
                {
                    return parsed;
                }
            }
            catch { }
        }

        list.Add(new AttachedTextFileItem(string.IsNullOrWhiteSpace(codeFileName) ? "attachment.txt" : codeFileName, codeSnippet));
        return list;
    }

