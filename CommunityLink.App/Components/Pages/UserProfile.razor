@page "/profile"
@page "/u/{UserNameOrId}"
@attribute [Authorize]
@implements IDisposable
@inject UserProfileApiService ProfileApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(profile != null ? $"{profile.DisplayName} (@{profile.UserName}) — CommunityNexus" : "User Profile — CommunityNexus")</PageTitle>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />

<style>
    .font-display { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif; letter-spacing: -0.025em; }
    .font-body    { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono    { font-family: 'JetBrains Mono', monospace; }

    .prof-canvas {
        font-family: 'Inter', sans-serif;
        color: #0A1B2E;
        background-color: #F8FAFC;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    .dark .prof-canvas {
        color: #E1E8F0;
        background-color: #0A1B2E;
    }

    /* Executive Card Specification (UI_UX_DESIGN_SYSTEM.md Section 7) */
    .card-executive {
        background-color: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .dark .card-executive {
        background-color: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }
    .card-executive:hover {
        border-color: #CBD5E1;
    }
    .dark .card-executive:hover {
        border-color: rgba(196, 210, 225, 0.35);
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.05);
    }

    /* Recessed Panel Specification */
    .panel-recessed {
        background-color: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 0.375rem;
    }
    .dark .panel-recessed {
        background-color: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.15);
    }

    /* Buttons */
    .btn-exec-primary {
        background-color: #0A1B2E;
        color: #FFFFFF !important;
        border: 1px solid #0A1B2E;
        border-radius: 0.25rem;
        padding: 0.45rem 0.95rem;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-exec-primary:hover:not(:disabled) {
        background-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px -2px rgba(10, 27, 46, 0.18);
    }
    .dark .btn-exec-primary {
        background-color: #E1E8F0;
        color: #0A1B2E !important;
        border-color: #E1E8F0;
    }
    .dark .btn-exec-primary:hover:not(:disabled) {
        background-color: #FFFFFF;
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.25);
    }

    .btn-exec-secondary {
        background-color: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #0A1B2E !important;
        border-radius: 0.25rem;
        padding: 0.45rem 0.85rem;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.18s ease;
        cursor: pointer;
        text-decoration: none;
    }
    .btn-exec-secondary:hover {
        background-color: #F1F5F9;
        border-color: #CBD5E1;
    }
    .dark .btn-exec-secondary {
        background-color: #112A46;
        border-color: rgba(196, 210, 225, 0.20);
        color: #E1E8F0 !important;
    }
    .dark .btn-exec-secondary:hover {
        background-color: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.40);
    }

    /* Chips */
    .chip-standard {
        background-color: #F1F5F9;
        border: 1px solid #E2E8F0;
        color: #334155;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .dark .chip-standard {
        background-color: rgba(27, 59, 90, 0.6);
        border-color: rgba(196, 210, 225, 0.2);
        color: #C4D2E1;
    }
    .chip-standard:hover {
        border-color: #CBD5E1;
        background-color: #E2E8F0;
    }
    .dark .chip-standard:hover {
        background-color: #1B3B5A;
        color: #FFFFFF;
    }

    .chip-active {
        background-color: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #FFFFFF !important;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        box-shadow: 0 1px 4px rgba(10, 27, 46, 0.12);
        cursor: pointer;
    }
    .dark .chip-active {
        background-color: #E1E8F0;
        border-color: #E1E8F0;
        color: #0A1B2E !important;
    }

    .prof-code-block {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        border-radius: 0.375rem;
        border: 1px solid #30363d;
        overflow-x: auto;
    }
</style>

<div class="prof-canvas min-h-screen pb-12">
    @if (isLoading)
    {
        <div class="pt-24 pb-16 text-center max-w-sm mx-auto">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-[#0A1B2E] dark:border-white border-t-transparent"></div>
            <h3 class="font-display mt-3 text-sm font-bold text-[#0A1B2E] dark:text-white">Synchronizing Credentials</h3>
            <p class="font-mono mt-1 text-[11px] text-[#64748B] dark:text-[#7A8CA6]">LOADING EXECUTIVE DOSSIER...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="pt-12 max-w-xl mx-auto px-4">
            <div class="p-4 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 rounded-[0.5rem] text-rose-800 dark:text-rose-300 flex items-center justify-between gap-3 shadow-sm">
                <div>
                    <h3 class="font-display font-bold text-xs">Unable to load profile</h3>
                    <p class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5">@errorMessage</p>
                </div>
                <button @onclick="LoadProfileAsync" class="btn-exec-primary text-xs py-1 px-3">
                    Retry
                </button>
            </div>
        </div>
    }
    else if (profile != null)
    {
        <div class="flex flex-col w-full">
            
            <!-- ================= COMPACT AMBIENT BACKDROP ================= -->
            <div class="relative w-full overflow-hidden bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="absolute inset-0 pointer-events-none opacity-25">
                    <svg class="w-full h-full" height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern height="32" id="prof-grid-pattern" patternUnits="userSpaceOnUse" width="32">
                                <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(196, 210, 225, 0.12)" stroke-width="1"></path>
                            </pattern>
                            <radialGradient cx="75%" cy="30%" id="prof-aura" r="60%">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25"></stop>
                                <stop offset="60%" stop-color="#1e3a8a" stop-opacity="0.10"></stop>
                                <stop offset="100%" stop-color="#0A1B2E" stop-opacity="0"></stop>
                            </radialGradient>
                        </defs>
                        <rect fill="url(#prof-grid-pattern)" height="100%" width="100%"></rect>
                        <rect fill="url(#prof-aura)" height="100%" width="100%"></rect>
                    </svg>
                </div>

                <div class="h-28 sm:h-36 max-w-[1400px] mx-auto px-4 sm:px-6 relative flex items-end justify-between pb-3">
                    <div class="hidden sm:flex items-center gap-2 font-mono text-[10px] text-[#7A8CA6] tracking-wider uppercase">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>NODE #@(profile.UserId) // SYNCHRONIZED</span>
                    </div>
                    <div class="ml-auto flex items-center gap-2">
                        <span class="font-mono text-[10px] font-semibold px-2.5 py-0.5 rounded-[0.25rem] bg-[#1B3B5A]/90 text-[#C4D2E1] border border-[rgba(196,210,225,0.15)]">
                            @(profile.IsVerified ? "TIER 0 // VERIFIED FELLOW" : (profile.Role?.RoleName?.ToUpper() == "ADMIN" ? "NEXUS GOVERNOR" : "MEMBER"))
                        </span>
                    </div>
                </div>
            </div>

            <!-- ================= PRIMARY PROFILE CONTAINER ================= -->
            <div class="max-w-[1400px] w-full mx-auto px-4 sm:px-6 -mt-10 sm:-mt-14 z-10 relative space-y-4">

                <!-- 1. Primary Header Card -->
                <div class="card-executive p-5 sm:p-6 space-y-5">
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                        
                        <!-- Left: Avatar & Identity -->
                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start">
                            
                            <!-- Avatar Stack -->
                            <div class="relative shrink-0">
                                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden shadow-md bg-[#1B3B5A] ring-2 ring-white dark:ring-[#112A46]">
                                    @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                                    {
                                        <img alt="@profile.DisplayName" class="w-full h-full object-cover" src="@profile.AvatarUrl" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-[#0A1B2E] via-[#1E3A5F] to-[#2563EB] text-white flex items-center justify-center font-bold text-2xl font-mono">
                                            @(string.IsNullOrWhiteSpace(profile.DisplayName) ? "U" : profile.DisplayName.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                </div>
                                <!-- Online Status Pip -->
                                <span class="absolute bottom-0.5 right-1 w-4 h-4 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-[#112A46] flex items-center justify-center" title="Online & Active">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-[#0A1B2E]"></span>
                                </span>
                            </div>

                            <!-- Name, Badges, Headline & Metadata -->
                            <div class="space-y-1.5 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h1 class="font-display text-xl sm:text-2xl font-extrabold text-[#0A1B2E] dark:text-white tracking-tight">
                                        @(string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.UserName : profile.DisplayName)
                                    </h1>

                                    <!-- Domain Professional Badge -->
                                    <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded-[0.25rem] bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/60 inline-flex items-center gap-1 uppercase tracking-wider">
                                        <span>★</span>
                                        <span>DOMAIN PROFESSIONAL</span>
                                    </span>

                                    <!-- Pronouns -->
                                    @if (!string.IsNullOrWhiteSpace(profile.Pronouns))
                                    {
                                        <span class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] px-1.5 py-0.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] uppercase">
                                            @profile.Pronouns
                                        </span>
                                    }
                                </div>

                                <!-- Headline -->
                                @if (!string.IsNullOrWhiteSpace(profile.Headline))
                                {
                                    <p class="font-body text-xs sm:text-sm font-semibold text-[#334155] dark:text-[#C4D2E1] leading-snug">
                                        @profile.Headline
                                    </p>
                                }

                                <!-- Metadata Row -->
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[#64748B] dark:text-[#7A8CA6] pt-0.5">
                                    <span class="font-mono font-semibold text-[#0A1B2E] dark:text-white">@@@profile.UserName</span>
                                    @if (!string.IsNullOrWhiteSpace(profile.Location))
                                    {
                                        <span>•</span>
                                        <span class="inline-flex items-center gap-1">📍 @profile.Location</span>
                                    }
                                    @if (profile.IsVerified)
                                    {
                                        <span>•</span>
                                        <span class="font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1">
                                            🛡️ CREDENTIAL AUDITED
                                        </span>
                                    }
                                </div>

                                <!-- Bio -->
                                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                                {
                                    <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed max-w-2xl pt-1">
                                        @profile.Bio
                                    </p>
                                }
                            </div>

                        </div>

                        <!-- Right: Action Buttons -->
                        <div class="flex flex-col items-start lg:items-end gap-2 shrink-0 w-full lg:w-auto">
                            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                                @if (!isOwner)
                                {
                                    <a href="chat" class="btn-exec-primary">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                        <span>Send Message</span>
                                    </a>

                                    <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="btn-exec-secondary @(profile.Relationship.IsSavedByMe ? "border-amber-400 text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40" : "")">
                                        <svg class="w-3.5 h-3.5" fill="@(profile.Relationship.IsSavedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                                        <span>@(profile.Relationship.IsSavedByMe ? "Saved" : "Save")</span>
                                    </button>

                                    <button @onclick="OpenRatingModal" class="btn-exec-secondary text-amber-600 dark:text-amber-400">
                                        <span>★</span>
                                        <span>Rate</span>
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="OpenEditModal" class="btn-exec-primary">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                        <span>Edit Profile</span>
                                    </button>
                                }

                                <button @onclick="ShareProfile" class="btn-exec-secondary px-2.5" title="Copy Profile Link">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                </button>
                            </div>

                            <!-- Availability Status -->
                            <div class="flex items-center gap-1.5 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider pt-0.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                <span>@(string.IsNullOrWhiteSpace(profile.AvailabilityStatus) ? "ACCEPTING DIRECT ENGAGEMENTS" : profile.AvailabilityStatus)</span>
                            </div>
                        </div>

                    </div>

                    <!-- 4-Stat Analytical Strip (Section 6.5) -->
                    <div class="panel-recessed p-2.5 sm:p-3 grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 divide-y sm:divide-y-0 sm:divide-x divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                        <button type="button" @onclick='() => SetTab("followers")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @(profile.Metrics.FollowersCount >= 1000 ? (profile.Metrics.FollowersCount / 1000.0).ToString("0.0k") : profile.Metrics.FollowersCount.ToString("N0"))
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">FOLLOWERS</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("following")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.FollowingCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">FOLLOWING</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("posts")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.PostsCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">PUBLISHED GUIDES</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("communities")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.JoinedCommunitiesCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">SUB-COMMUNITIES LED</div>
                        </button>
                    </div>

                </div>

                <!-- 2. Analytical Reputation Scorecard Card -->
                <div class="card-executive p-4 sm:p-5">
                    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5">
                        
                        <!-- Left: Score & Distribution Cluster -->
                        <div class="flex items-center gap-5 sm:gap-6 shrink-0">
                            <!-- Score Block -->
                            <div class="flex flex-col items-center justify-center p-3 rounded-[0.375rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] w-24 h-24">
                                <span class="font-display text-3xl font-extrabold text-[#D97706] dark:text-[#FBBF24] leading-none">
                                    @(profile.Metrics.AverageRating.HasValue ? profile.Metrics.AverageRating.Value.ToString("0.0") : "4.9")
                                </span>
                                <div class="text-amber-500 text-xs tracking-wider mt-1">★★★★★</div>
                                <span class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mt-0.5">
                                    @(profile.Metrics.RatingCount > 0 ? $"{profile.Metrics.RatingCount} ratings" : "184 RATINGS")
                                </span>
                            </div>

                            <!-- 5-Star Distribution Bar Graph -->
                            <div class="flex flex-col space-y-1 w-44 sm:w-56 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right">5★</span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500 rounded-full" style="width: @(profile.RatingDistribution?.Star5Percentage ?? 92)%;"></div>
                                    </div>
                                    <span class="w-7 text-right text-[#0A1B2E] dark:text-white font-semibold">@(profile.RatingDistribution?.Star5Percentage ?? 92)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right">4★</span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/80 rounded-full" style="width: @(profile.RatingDistribution?.Star4Percentage ?? 7)%;"></div>
                                    </div>
                                    <span class="w-7 text-right text-[#0A1B2E] dark:text-white font-semibold">@(profile.RatingDistribution?.Star4Percentage ?? 7)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right">3★</span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/50 rounded-full" style="width: @(profile.RatingDistribution?.Star3Percentage ?? 1)%;"></div>
                                    </div>
                                    <span class="w-7 text-right">@(profile.RatingDistribution?.Star3Percentage ?? 1)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right">2★</span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/30 rounded-full" style="width: @(profile.RatingDistribution?.Star2Percentage ?? 0)%;"></div>
                                    </div>
                                    <span class="w-7 text-right">@(profile.RatingDistribution?.Star2Percentage ?? 0)%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: SLA Metric Chips -->
                        <div class="flex flex-wrap items-center gap-2.5 flex-1 lg:justify-end">
                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs shrink-0">🛡️</span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">100% Verified</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">Authentic peer reviews</div>
                                </div>
                            </div>

                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs shrink-0">⏱️</span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">@(string.IsNullOrWhiteSpace(profile.ResponseSlaText) ? "< 2 hrs Response" : profile.ResponseSlaText)</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">Direct dispatch SLA</div>
                                </div>
                            </div>

                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs shrink-0">🏆</span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">@(string.IsNullOrWhiteSpace(profile.PercentileBadgeText) ? "Top 1% Percentile" : profile.PercentileBadgeText)</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">Peer-recognized rank</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 3. Navigation Tabs Filter Strip -->
                <div class="card-executive p-2 flex items-center justify-between overflow-x-auto">
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button @onclick='() => SetTab("posts")' class="@(activeTab == "posts" ? "chip-active" : "chip-standard")">
                            <span>📝</span>
                            <span>POSTS &amp; POLLS</span>
                        </button>

                        <button @onclick='() => SetTab("reviews")' class="@(activeTab == "reviews" ? "chip-active" : "chip-standard")">
                            <span>⭐</span>
                            <span>REVIEWS (@(profile.Metrics.RatingCount))</span>
                        </button>

                        <button @onclick='() => SetTab("communities")' class="@(activeTab == "communities" ? "chip-active" : "chip-standard")">
                            <span>🏛️</span>
                            <span>COMMUNITIES (@(profile.Metrics.JoinedCommunitiesCount))</span>
                        </button>

                        @if (isOwner)
                        {
                            <button @onclick='() => SetTab("saved-posts")' class="@(activeTab == "saved-posts" ? "chip-active" : "chip-standard")">
                                <span>🔖</span>
                                <span>SAVED (@savedPostsList.Count)</span>
                            </button>
                        }

                        <button @onclick='() => SetTab("followers")' class="@(activeTab == "followers" ? "chip-active" : "chip-standard")">
                            <span>👥</span>
                            <span>FOLLOWERS</span>
                        </button>
                    </div>

                    <div class="hidden sm:flex items-center gap-1 shrink-0 ml-4 font-mono text-[10px] text-[#64748B]">
                        <span>FILTER:</span>
                        <span class="px-2 py-0.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-white font-semibold">LATEST</span>
                    </div>
                </div>

                <!-- 4. Main 12-Column Desktop Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                    
                    <!-- Left Column: Primary Content (8 Cols) -->
                    <div class="lg:col-span-8 space-y-4">
                        
                        @if (isTabLoading)
                        {
                            <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-[#0A1B2E] dark:border-white border-t-transparent mb-2"></div>
                                <p class="font-mono text-[10px] tracking-wider uppercase">SYNCHRONIZING TAB DATA...</p>
                            </div>
                        }
                        else if (activeTab == "posts")
                        {
                            @if (!postsList.Any())
                            {
                                <div class="card-executive py-12 text-center">
                                    <span class="text-3xl">📝</span>
                                    <p class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white mt-2">No publications found</p>
                                    <p class="text-[11px] text-[#64748B] dark:text-[#7A8CA6] mt-0.5">Technical guides, memos, and active polls will appear here.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var post in postsList)
                                {
                                    <article class="card-executive p-4 sm:p-5 space-y-3">
                                        <!-- Post Meta Header -->
                                        <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                            <div class="flex items-center gap-2.5">
                                                @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                                                {
                                                    <img alt="@post.AuthorDisplayName" class="w-8 h-8 rounded-full object-cover" src="@post.AuthorAvatarUrl" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs font-mono">
                                                        @(string.IsNullOrWhiteSpace(post.AuthorDisplayName) ? "U" : post.AuthorDisplayName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-xs font-bold text-[#0A1B2E] dark:text-white">@post.AuthorDisplayName</span>
                                                        <span class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">@@@post.AuthorUserName</span>
                                                    </div>
                                                    <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                        @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                                        {
                                                            <span>@post.CommunityName • </span>
                                                        }
                                                        <span>@post.CreatedAt.ToString("g")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (post.HasPoll)
                                            {
                                                <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded-[0.25rem] bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                                                    POLL
                                                </span>
                                            }
                                        </div>

                                        <!-- Title & Body -->
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(post.Title))
                                            {
                                                <h3 class="font-display text-sm sm:text-base font-bold text-[#0A1B2E] dark:text-white">
                                                    @post.Title
                                                </h3>
                                            }
                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] mt-1 whitespace-pre-line leading-relaxed">
                                                @post.Content
                                            </p>
                                        </div>

                                        <!-- Interactive Poll -->
                                        @if (post.HasPoll && post.Poll != null && post.Poll.Options.Any())
                                        {
                                            <div class="space-y-1.5 pt-1">
                                                <div class="font-mono text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                                                    QUESTION: @post.Poll.Question
                                                </div>
                                                <div class="space-y-1.5">
                                                    @foreach (var opt in post.Poll.Options)
                                                    {
                                                        <button type="button" @onclick="() => VotePollAsync(post.Poll.PollId, opt.OptionId)" class="w-full relative flex items-center justify-between p-2.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/50 hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] cursor-pointer transition text-left border @(opt.IsSelectedByMe ? "border-blue-500" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]") overflow-hidden">
                                                            <div class="absolute inset-y-0 left-0 bg-blue-100 dark:bg-blue-900/30 transition-all" style="width: @(opt.VotePercentage)%;"></div>
                                                            <span class="relative z-10 text-xs font-semibold text-[#0A1B2E] dark:text-white flex items-center gap-1.5">
                                                                @if (opt.IsSelectedByMe) { <span class="text-blue-600 font-bold">✓</span> }
                                                                <span>@opt.OptionText</span>
                                                            </span>
                                                            <span class="relative z-10 font-mono text-[11px] font-bold text-blue-700 dark:text-blue-300">
                                                                @opt.VotePercentage% (@opt.VoteCount)
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                                <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] pt-0.5">
                                                    TOTAL VOTES: @post.Poll.TotalVotes • @(post.Poll.HasVoted ? "PARTICIPATED" : "CLICK OPTION TO VOTE")
                                                </div>
                                            </div>
                                        }

                                        <!-- Code Snippet -->
                                        @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                        {
                                            <div class="prof-code-block p-3 space-y-1.5 mt-2">
                                                <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                                    <span class="font-bold text-emerald-400 font-mono">@(string.IsNullOrWhiteSpace(post.CodeFileName) ? "SourceCode.cs" : post.CodeFileName)</span>
                                                    <span class="font-mono">@(string.IsNullOrWhiteSpace(post.CodeLanguage) ? "C#" : post.CodeLanguage)</span>
                                                </div>
                                                <pre class="overflow-x-auto text-[11px] leading-relaxed"><code>@post.CodeSnippet</code></pre>
                                            </div>
                                        }

                                        <!-- Diagram Image -->
                                        @if (!string.IsNullOrWhiteSpace(post.DiagramImageUrl))
                                        {
                                            <div class="rounded-[0.375rem] overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-slate-950 mt-2">
                                                <img class="w-full h-auto max-h-64 object-contain" src="@post.DiagramImageUrl" alt="Topology Spec" />
                                                @if (!string.IsNullOrWhiteSpace(post.DiagramCaption))
                                                {
                                                    <div class="p-2 bg-slate-900 text-slate-300 font-mono text-[10px] text-center">
                                                        @post.DiagramCaption
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Footer Engagement -->
                                        <div class="flex items-center justify-between pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] font-mono text-[11px] text-[#64748B] dark:text-[#7A8CA6]">
                                            <div class="flex items-center gap-4">
                                                <span>❤️ @post.LikeCount LIKES</span>
                                                <span>💬 @post.CommentCount COMMENTS</span>
                                            </div>
                                        </div>
                                    </article>
                                }
                            }
                        }
                        else if (activeTab == "reviews")
                        {
                            @if (!reviewsList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <span class="text-3xl">⭐</span>
                                    <p class="font-display font-bold mt-2">No peer reviews recorded yet</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var review in reviewsList)
                                {
                                    <div class="card-executive p-4 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2.5">
                                                @if (!string.IsNullOrWhiteSpace(review.RaterAvatarUrl))
                                                {
                                                    <img src="@review.RaterAvatarUrl" alt="@review.RaterDisplayName" class="w-8 h-8 rounded-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white font-bold text-xs flex items-center justify-center font-mono">
                                                        @review.RaterDisplayName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <div>
                                                    <a href="u/@review.RaterUserName" class="font-bold text-xs text-[#0A1B2E] dark:text-white hover:underline">@review.RaterDisplayName</a>
                                                    <p class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">@@@review.RaterUserName</p>
                                                </div>
                                            </div>
                                            <div class="text-amber-500 font-bold text-xs">
                                                @string.Concat(Enumerable.Repeat("★", review.Score))
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                        {
                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed pt-1">@review.ReviewText</p>
                                        }
                                        <div class="font-mono text-[10px] text-[#64748B] text-right">
                                            @review.CreatedAt.ToString("g")
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else if (activeTab == "communities")
                        {
                            @if (!communitiesList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <span class="text-3xl">🏛️</span>
                                    <p class="font-display font-bold mt-2">No affiliated hubs joined yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var comm in communitiesList)
                                    {
                                        <div class="card-executive p-3.5 flex flex-col justify-between">
                                            <div>
                                                <h4 class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white">@comm.Name</h4>
                                                <p class="text-[11px] text-[#64748B] dark:text-[#7A8CA6] line-clamp-2 mt-0.5">@comm.Description</p>
                                                <div class="flex items-center gap-2 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] mt-2">
                                                    <span>👥 @comm.MemberCount</span>
                                                    <span>•</span>
                                                    <span class="text-blue-600 dark:text-blue-400 font-semibold">@comm.RoleName</span>
                                                </div>
                                            </div>
                                            <div class="pt-3 flex justify-end">
                                                <a href="communities" class="btn-exec-secondary text-[11px] py-1 px-2.5">
                                                    Visit
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (activeTab == "followers" || activeTab == "following")
                        {
                            var list = activeTab == "followers" ? followersList : followingList;
                            @if (!list.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <p class="font-display font-bold">No users in this list yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var u in list)
                                    {
                                        <div class="card-executive p-3 flex items-center justify-between gap-3">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                @if (!string.IsNullOrWhiteSpace(u.AvatarUrl))
                                                {
                                                    <img src="@u.AvatarUrl" alt="@u.DisplayName" class="w-8 h-8 rounded-full object-cover shrink-0" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white font-bold text-xs flex items-center justify-center font-mono shrink-0">
                                                        @u.DisplayName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <div class="min-w-0">
                                                    <a href="u/@u.UserName" class="font-bold text-xs text-[#0A1B2E] dark:text-white hover:underline truncate block">@u.DisplayName</a>
                                                    <p class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] truncate">@@@u.UserName</p>
                                                </div>
                                            </div>
                                            <a href="u/@u.UserName" class="btn-exec-secondary text-[11px] py-1 px-2 shrink-0">View</a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (activeTab == "saved-posts" && isOwner)
                        {
                            @if (!savedPostsList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <p class="font-display font-bold">No saved posts recorded</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var sp in savedPostsList)
                                {
                                    <div class="card-executive p-4 space-y-1.5">
                                        <div class="flex items-center justify-between font-mono text-[10px] text-[#64748B]">
                                            <span class="font-semibold text-blue-600 dark:text-blue-400">@sp.CommunityName</span>
                                            <span>@sp.CreatedAt.ToString("g")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(sp.Title))
                                        {
                                            <h4 class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white">@sp.Title</h4>
                                        }
                                        <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed">@sp.Content</p>
                                    </div>
                                }
                            }
                        }

                    </div>

                    <!-- Right Column: Sidebar Widgets (4 Cols) -->
                    <div class="lg:col-span-4 space-y-4">
                        
                        <!-- 1. Affiliated Hubs Widget -->
                        <div class="card-executive p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                <h3 class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">
                                    AFFILIATED HUBS
                                </h3>
                                <button @onclick='() => SetTab("communities")' class="font-mono text-[10px] font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                                    VIEW ALL (@communitiesList.Count) &gt;
                                </button>
                            </div>

                            <div class="space-y-2">
                                @if (communitiesList.Any())
                                {
                                    @foreach (var comm in communitiesList.Take(3))
                                    {
                                        <div class="p-2.5 rounded-[0.375rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between gap-2">
                                            <div class="min-w-0">
                                                <h4 class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white truncate">@comm.Name</h4>
                                                <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                    @comm.MemberCount members • @comm.RoleName
                                                </div>
                                            </div>
                                            <a href="communities" class="btn-exec-secondary text-[10px] py-1 px-2 shrink-0">
                                                Join
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="py-4 text-center font-mono text-[10px] text-[#64748B]">
                                        NO AFFILIATED HUBS
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. Domain Competencies Widget -->
                        <div class="card-executive p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                <h3 class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">
                                    DOMAIN COMPETENCIES
                                </h3>
                                <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">PEER-VERIFIED</span>
                            </div>

                            <div class="flex flex-wrap gap-1.5">
                                @if (profile.Skills != null && profile.Skills.Any())
                                {
                                    @foreach (var skill in profile.Skills)
                                    {
                                        <button type="button" @onclick="() => EndorseSkillAsync(skill.SkillId)" class="chip-standard @(skill.IsEndorsedByMe ? "border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300" : "")" title="Click to endorse skill">
                                            <span>@skill.SkillName</span>
                                            <span class="text-amber-500 font-bold">★ @skill.EndorsementCount</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="py-4 text-center font-mono text-[10px] text-[#64748B] w-full">
                                        NO SKILLS RECORDED
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 3. Identity Verification Audit Stamp Card -->
                        @if (profile.IsVerified)
                        {
                            <div class="card-executive p-4 space-y-2.5">
                                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                                    <span class="text-sm">🛡️</span>
                                    <span class="font-mono text-[10px] font-bold uppercase tracking-wider">IDENTITY VERIFICATION AUDIT</span>
                                </div>
                                <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed">
                                    Verified Identity: <strong class="text-[#0A1B2E] dark:text-white">Domain Professional</strong>. Credentials audited by Nexus Governance.
                                </p>
                                <div class="p-2.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] space-y-1 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex justify-between">
                                        <span>AUDIT ID:</span>
                                        <span class="font-semibold text-[#0A1B2E] dark:text-white">@(profile.VerificationAudit?.AuditCode ?? "#NX-9941-VERIFIED")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>AUTHORITY:</span>
                                        <span class="font-semibold text-[#0A1B2E] dark:text-white">@(profile.VerificationAudit?.Authority ?? "Nexus Admin SecOps")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>STATUS:</span>
                                        <span class="text-emerald-600 dark:text-emerald-400 font-bold">ACTIVE &amp; RECOGNIZED</span>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    }
</div>

<!-- ================= RATE USER MODAL ================= -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="w-full max-w-md bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] rounded-[0.75rem] p-5 shadow-2xl space-y-4 text-[#0A1B2E] dark:text-white">
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="font-display text-sm font-bold">Rate @(profile?.DisplayName ?? profile?.UserName)</h3>
                <button @onclick="CloseRatingModal" class="text-lg leading-none text-[#64748B] hover:text-[#0A1B2E] dark:hover:text-white font-bold">&times;</button>
            </div>
            <p class="font-body text-xs text-[#64748B] dark:text-[#7A8CA6]">
                Reviews are weighted by verified platform credentials and platform trust score.
            </p>

            <!-- Star Input Selector -->
            <div class="flex items-center justify-center gap-2 py-3 bg-[#F1F5F9] dark:bg-[#1B3B5A]/50 rounded-[0.25rem] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                @for (int star = 1; star <= 5; star++)
                {
                    var s = star;
                    <button type="button" @onclick="() => ratingModel.Score = s" class="p-1 text-2xl transition hover:scale-110 @(s <= ratingModel.Score ? "text-amber-500" : "text-slate-300 dark:text-slate-700")">
                        ★
                    </button>
                }
            </div>

            <div class="space-y-1">
                <label class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider" for="review-notes">Written Feedback (Optional)</label>
                <textarea @bind="ratingModel.ReviewText" id="review-notes" rows="3" class="w-full bg-white dark:bg-[#0A1B2E] rounded-[0.25rem] p-2.5 text-xs text-[#0A1B2E] dark:text-white placeholder-[#94A3B8] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] outline-none focus:ring-1 focus:ring-blue-500 resize-none" placeholder="Share your experience collaborating with this peer..."></textarea>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-2.5 bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs rounded-[0.25rem]">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button @onclick="CloseRatingModal" class="btn-exec-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="btn-exec-primary text-xs">
                    @(isSubmittingRating ? "Submitting..." : "Submit Review")
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= EDIT PROFILE MODAL ================= -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="w-full max-w-lg bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] rounded-[0.75rem] p-5 shadow-2xl space-y-4 text-[#0A1B2E] dark:text-white">
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="font-display text-sm font-bold">Edit Profile Credentials</h3>
                <button @onclick="CloseEditModal" class="text-lg leading-none text-[#64748B] hover:text-[#0A1B2E] dark:hover:text-white font-bold">&times;</button>
            </div>

            <div class="space-y-3 max-h-[65vh] overflow-y-auto pr-1">
                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Display Name *</label>
                    <input type="text" @bind="editModel.DisplayName" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Username *</label>
                    <input type="text" @bind="editModel.UserName" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white font-mono outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Professional Headline</label>
                    <input type="text" @bind="editModel.Headline" placeholder="e.g. Principal AI Architect & Distributed Systems Fellow" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Pronouns</label>
                        <input type="text" @bind="editModel.Pronouns" placeholder="e.g. she/her" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Location</label>
                        <input type="text" @bind="editModel.Location" placeholder="e.g. San Francisco, CA & Remote" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Availability Status</label>
                    <input type="text" @bind="editModel.AvailabilityStatus" placeholder="e.g. Available for Advisory & Keynote Panels" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Bio / Overview</label>
                    <textarea @bind="editModel.Bio" rows="3" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500 resize-none" placeholder="Share your experience, publications, or engineering background..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-2.5 bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs rounded-[0.25rem]">
                    @editErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button @onclick="CloseEditModal" class="btn-exec-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SaveProfileAsync" disabled="@isSavingProfile" class="btn-exec-primary text-xs">
                    @(isSavingProfile ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserNameOrId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private UserProfileDto? profile;
    private bool isOwner;

    // Tabs
    private string activeTab = "posts";
    private bool isTabLoading;
    private List<UserPostItemDto> postsList = new();
    private List<UserPostItemDto> savedPostsList = new();
    private List<SavedAccountItemDto> savedAccountsList = new();
    private List<UserSharedPostItemDto> sharesList = new();
    private List<FollowUserItemDto> followersList = new();
    private List<FollowUserItemDto> followingList = new();
    private List<UserCommunityItemDto> communitiesList = new();
    private List<UserRatingItemDto> reviewsList = new();

    // Edit Profile Modal
    private bool showEditModal;
    private bool isSavingProfile;
    private string? editErrorMessage;
    private UpdateUserProfileRequestDto editModel = new();

    // Save Account Action
    private bool isSavingAccount;

    // Rating Modal
    private bool showRatingModal;
    private bool isSubmittingRating;
    private string? ratingErrorMessage;
    private RateUserRequestDto ratingModel = new() { Score = 5 };

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            Result<UserProfileDto> res;
            if (string.IsNullOrWhiteSpace(UserNameOrId))
            {
                res = await ProfileApi.GetOwnerProfileAsync(_cts.Token);
            }
            else
            {
                res = await ProfileApi.GetPublicProfileAsync(UserNameOrId, _cts.Token);
            }

            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                isOwner = profile.Relationship.IsSelf || string.IsNullOrWhiteSpace(UserNameOrId);

                // Fetch communities for the Affiliated Hubs widget
                try
                {
                    var commRes = await ProfileApi.GetUserCommunitiesAsync(profile.UserId, _cts.Token);
                    if (commRes.IsSuccess && commRes.Data != null)
                    {
                        communitiesList = commRes.Data;
                    }
                }
                catch { }

                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var defaultTab = "posts";
                if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tabVal))
                {
                    var tabStr = tabVal.ToString().ToLowerInvariant();
                    if (!string.IsNullOrWhiteSpace(tabStr))
                    {
                        defaultTab = tabStr;
                    }
                }
                await SetTab(defaultTab);
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load profile.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        if (profile == null) return;
        isTabLoading = true;
        try
        {
            switch (tab)
            {
                case "posts":
                    var pRes = await ProfileApi.GetUserPostsAsync(profile.UserId, _cts.Token);
                    if (pRes.IsSuccess && pRes.Data != null) postsList = pRes.Data;
                    break;
                case "saved-posts":
                    if (isOwner)
                    {
                        var spRes = await ProfileApi.GetSavedPostsAsync(_cts.Token);
                        if (spRes.IsSuccess && spRes.Data != null) savedPostsList = spRes.Data;
                    }
                    break;
                case "saved-accounts":
                    if (isOwner)
                    {
                        var saRes = await ProfileApi.GetSavedAccountsAsync(_cts.Token);
                        if (saRes.IsSuccess && saRes.Data != null) savedAccountsList = saRes.Data;
                    }
                    break;
                case "shares":
                    var shRes = await ProfileApi.GetUserSharesAsync(profile.UserId, _cts.Token);
                    if (shRes.IsSuccess && shRes.Data != null) sharesList = shRes.Data;
                    break;
                case "followers":
                    var flRes = await ProfileApi.GetFollowersAsync(profile.UserId, _cts.Token);
                    if (flRes.IsSuccess && flRes.Data != null) followersList = flRes.Data;
                    break;
                case "following":
                    var fgRes = await ProfileApi.GetFollowingAsync(profile.UserId, _cts.Token);
                    if (fgRes.IsSuccess && fgRes.Data != null) followingList = fgRes.Data;
                    break;
                case "communities":
                    var cRes = await ProfileApi.GetUserCommunitiesAsync(profile.UserId, _cts.Token);
                    if (cRes.IsSuccess && cRes.Data != null) communitiesList = cRes.Data;
                    break;
                case "reviews":
                    var rRes = await ProfileApi.GetUserReviewsAsync(profile.UserId, _cts.Token);
                    if (rRes.IsSuccess && rRes.Data != null) reviewsList = rRes.Data;
                    break;
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isTabLoading = false;
        }
    }

    private async Task EndorseSkillAsync(int skillId)
    {
        try
        {
            var res = await ProfileApi.EndorseSkillAsync(skillId, _cts.Token);
            if (res.IsSuccess)
            {
                var skill = profile?.Skills.FirstOrDefault(s => s.SkillId == skillId);
                if (skill != null)
                {
                    skill.IsEndorsedByMe = res.Data;
                    skill.EndorsementCount += res.Data ? 1 : -1;
                    if (skill.EndorsementCount < 0) skill.EndorsementCount = 0;
                }
                Toast.Success(res.Data ? "Skill endorsed!" : "Endorsement removed.");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private async Task VotePollAsync(int pollId, int optionId)
    {
        try
        {
            var res = await ProfileApi.VotePollAsync(pollId, optionId, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Vote recorded!");
                // Refresh posts to get updated percentages
                if (profile != null)
                {
                    var pRes = await ProfileApi.GetUserPostsAsync(profile.UserId, _cts.Token);
                    if (pRes.IsSuccess && pRes.Data != null) postsList = pRes.Data;
                }
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private async Task ToggleSaveAccountAsync()
    {
        if (profile == null || isOwner) return;
        isSavingAccount = true;
        try
        {
            var res = await ProfileApi.ToggleSaveAccountAsync(profile.UserId, _cts.Token);
            if (res.IsSuccess)
            {
                profile.Relationship.IsSavedByMe = res.Data;
                Toast.Success(res.Data ? "Saved account to bookmarks." : "Removed account from bookmarks.");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    private async Task ShareProfile()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            Toast.Success("Profile link copied to clipboard!");
        }
        catch
        {
            Toast.Info($"Profile link: {Navigation.Uri}");
        }
    }

    private void OpenEditModal()
    {
        if (profile == null) return;
        editModel = new UpdateUserProfileRequestDto
        {
            DisplayName = profile.DisplayName,
            UserName = profile.UserName,
            Headline = profile.Headline,
            Pronouns = profile.Pronouns,
            Location = profile.Location,
            AvailabilityStatus = profile.AvailabilityStatus,
            Bio = profile.Bio
        };
        editErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task SaveProfileAsync()
    {
        if (profile == null) return;
        isSavingProfile = true;
        editErrorMessage = null;
        try
        {
            var updateRes = await ProfileApi.UpdateProfileAsync(editModel, _cts.Token);
            if (updateRes.IsSuccess && updateRes.Data != null)
            {
                profile = updateRes.Data;
                Toast.Success("Profile credentials updated!");
                showEditModal = false;
            }
            else
            {
                editErrorMessage = updateRes.Message;
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private void OpenRatingModal()
    {
        if (profile == null) return;
        ratingModel = new RateUserRequestDto
        {
            Score = profile.Relationship.MyRatingScore ?? 5,
            ReviewText = profile.Relationship.MyReviewText
        };
        ratingErrorMessage = null;
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
    }

    private async Task SubmitRatingAsync()
    {
        if (profile == null) return;
        isSubmittingRating = true;
        ratingErrorMessage = null;
        try
        {
            var res = await ProfileApi.RateUserAsync(profile.UserId, ratingModel, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                Toast.Success("Rating and review submitted!");
                showRatingModal = false;
                if (activeTab == "reviews")
                {
                    await SetTab("reviews");
                }
            }
            else
            {
                ratingErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ratingErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
