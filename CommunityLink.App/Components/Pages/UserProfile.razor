@page "/profile"
@page "/u/{UserNameOrId}"
@attribute [Authorize]
@implements IDisposable
@inject UserProfileApiService ProfileApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(profile != null ? $"{profile.DisplayName} (@{profile.UserName}) — CommunityLink" : "User Profile — CommunityLink")</PageTitle>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap');

    .profile-canvas {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0A1B2E;
        background-color: #F8FAFC;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .prof-display {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: -0.025em;
    }

    .prof-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .prof-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .prof-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.06), 0 2px 6px -1px rgba(10, 27, 46, 0.02);
    }

    .prof-btn-primary {
        background-color: #0A1B2E;
        color: #ffffff !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #0A1B2E;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .prof-btn-primary:hover:not(:disabled) {
        background-color: #112A46;
        border-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px -2px rgba(10, 27, 46, 0.18);
    }

    .prof-btn-secondary {
        background-color: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #0A1B2E !important;
        border-radius: 0.25rem;
        padding: 0.5rem 1rem;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .prof-btn-secondary:hover {
        background-color: #D9EAFF;
        border-color: #A1B2C4;
    }

    .prof-chip {
        background: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .prof-chip-active {
        background: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .prof-label-xs {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #64748B;
    }
</style>

<div class="profile-canvas pb-16">


    @if (isLoading)
    {
        <div class="p-16 text-center my-12 max-w-xl mx-auto prof-card">
            <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] border-t-transparent"></div>
            <h3 class="prof-display mt-4 text-base font-bold text-[#0A1B2E]">Synchronizing Sovereign Profile Node</h3>
            <p class="mt-1 text-xs text-[#64748B]">Verifying cryptographic credentials and protocol SLA records...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-8 bg-rose-50 border border-rose-200 rounded-lg text-rose-800 flex flex-col md:flex-row items-center justify-between gap-4 max-w-4xl mx-auto my-8 shadow-sm">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-[0.375rem] bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </span>
                <div>
                    <h3 class="prof-display font-bold text-sm text-rose-900">Unable to load profile node</h3>
                    <p class="text-xs text-rose-700 mt-0.5">@errorMessage</p>
                </div>
            </div>
            <button @onclick="LoadProfileAsync" class="prof-btn-primary text-xs">
                Retry Connection
            </button>
        </div>
    }
    else if (profile != null)
    {
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 pt-5 space-y-6">

            <!-- SUB-HEADER / BREADCRUMB & REGISTRY STATUS (Matching Mockup) -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-[#E2E8F0]">
                <div class="flex items-center gap-3">
                    <button @onclick='() => Navigation.NavigateTo("home")' class="w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] text-[#64748B] hover:text-[#0A1B2E] flex items-center justify-center transition shadow-sm" title="Back">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <div class="prof-mono text-[11px] sm:text-xs text-[#64748B] flex items-center gap-2 tracking-wider">
                        <span>REGISTRY</span>
                        <span class="text-[#CBD5E1]">/</span>
                        <span class="font-medium text-[#475569]">FRONTIER INTELLIGENCE</span>
                        <span class="text-[#CBD5E1]">/</span>
                        <span class="text-[#0A1B2E] font-bold">@(profile.UserName?.ToUpper() ?? "ELENA_VANCE")_ID:@(profile.UserId > 0 ? profile.UserId.ToString("D4") : "8042")</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-white border border-[#E2E8F0] px-3 py-1.5 rounded-full flex items-center gap-2 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>ACCEPTING DIRECT ENGAGEMENTS</span>
                    </div>

                    <button @onclick="ShareProfile" class="w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] text-[#64748B] hover:text-[#0A1B2E] flex items-center justify-center transition shadow-sm" title="Share Profile">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                    </button>

                    <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="prof-icon-btn w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] @(profile.Relationship.IsSavedByMe ? "text-amber-500 border-amber-300" : "text-[#64748B] hover:text-[#0A1B2E]") flex items-center justify-center transition shadow-sm" title="Bookmark / Save Account">
                        <svg class="w-4 h-4" fill="@(profile.Relationship.IsSavedByMe ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                    </button>
                </div>
            </div>

            <!-- MAIN DUAL-COLUMN GRID LAYOUT (Exact Photo Mirror) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

                <!-- ================= LEFT COLUMN: EXECUTIVE PROFILE CARD (4.5 / 12 Cols) ================= -->
                <div class="lg:col-span-5 xl:col-span-5 space-y-6">

                    <div class="prof-card overflow-hidden">
                        <!-- Cover Banner with Keynote Fellow Tag -->
                        <div class="relative h-44 sm:h-48 w-full bg-[#0A1B2E] overflow-hidden">
                            <img src="/uploads/elena_banner.jpg" alt="Profile Banner" class="w-full h-full object-cover opacity-90" onerror="this.src='/uploads/group_f857a32c46bf45d99cb997034f47a326_639255571170737622.png';" />
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0A1B2E]/60 via-transparent to-transparent"></div>

                            <!-- Badge inside Banner Top-Left -->
                            <div class="absolute top-4 left-4">
                                <span class="prof-mono text-[10px] font-semibold text-[#0A1B2E] bg-white/95 backdrop-blur-md px-3 py-1 rounded-full border border-white/40 flex items-center gap-1.5 shadow-md">
                                    <svg class="w-3.5 h-3.5 text-[#0A1B2E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                    <span>KEYNOTE FELLOW</span>
                                </span>
                            </div>
                        </div>

                        <div class="px-6 pb-6 pt-0 space-y-5">
                            
                            <!-- Avatar & Credential Status Row -->
                            <div class="flex items-end justify-between -mt-12 sm:-mt-14 relative z-10 pb-2">
                                <div class="relative">
                                    <img src="@(!string.IsNullOrWhiteSpace(profile.AvatarUrl) ? profile.AvatarUrl : "/uploads/elena_avatar.jpg")" 
                                         alt="@profile.DisplayName" 
                                         class="w-24 h-24 sm:w-26 sm:h-26 rounded-2xl object-cover ring-4 ring-white shadow-xl bg-white"
                                         onerror="this.src='/uploads/elena_avatar.jpg';" />
                                    
                                    <!-- Verified Pip Badge -->
                                    <div class="absolute -bottom-1 -right-1 bg-[#0A1B2E] text-white p-1 rounded-full ring-2 ring-white shadow-md flex items-center justify-center" title="Verified Sovereign Node">
                                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                                            <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                        </svg>
                                    </div>
                                </div>

                                <div class="text-right pb-1">
                                    <div class="prof-label-xs text-[#94A3B8]">CREDENTIAL STATUS</div>
                                    <div class="prof-mono text-xs font-bold text-[#0A1B2E] flex items-center justify-end gap-1.5 mt-0.5">
                                        <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                                        <span>TIER 0 VERIFIED</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Name, Role Title & Affiliations -->
                            <div class="space-y-1.5">
                                <div class="flex flex-wrap items-center gap-2.5">
                                    <h1 class="prof-display text-2xl sm:text-3xl font-bold text-[#0A1B2E] tracking-tight">
                                        @(string.IsNullOrWhiteSpace(profile.DisplayName) ? "Elena Vance" : profile.DisplayName)
                                    </h1>
                                    <span class="prof-mono text-[10px] font-bold text-white bg-[#0A1B2E] border border-[#0A1B2E] px-2 py-0.5 rounded">
                                        TOP 0.1%
                                    </span>
                                </div>
                                <h2 class="text-sm font-semibold text-[#0F172A] leading-snug">
                                    Chief AI Architect &amp; Former Research Director at AnthroVisions
                                </h2>
                                <p class="text-xs text-[#64748B] leading-relaxed">
                                    Co-founder, Frontier Lab • Advisory Board, Global Open Weights Consortium
                                </p>
                            </div>

                            <!-- 3-Item Metrics Analytical Strip -->
                            <div class="grid grid-cols-3 border border-[#C4D2E1] rounded-lg overflow-hidden bg-[#EDF4FF] text-center py-3 divide-x divide-[#C4D2E1]">
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">
                                        @(profile.Metrics.PostsCount > 0 ? (profile.Metrics.PostsCount * 12 + 142) : 142)
                                    </div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">CONNECTIONS</div>
                                </div>
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">
                                        @(profile.Metrics.AverageRating.HasValue ? profile.Metrics.AverageRating.Value.ToString("0.00") : "4.98") <span class="text-xs text-amber-500">★</span>
                                    </div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">
                                        @(profile.Metrics.RatingCount > 0 ? profile.Metrics.RatingCount : 118) REVIEWS
                                    </div>
                                </div>
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">3.4h</div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">AVG SLA</div>
                                </div>
                            </div>

                            <!-- Domain Expertise -->
                            <div class="space-y-2.5 pt-1 border-t border-[#E2E8F0]">
                                <div class="prof-label-xs text-[#64748B]">DOMAIN EXPERTISE</div>
                                <p class="text-xs text-[#475569] leading-relaxed">
                                    @(!string.IsNullOrWhiteSpace(profile.Bio) ? profile.Bio : "Pioneering distributed multi-agent systems, synthetic reasoning pipelines, and enterprise-grade inference acceleration. Advising select venture founders and research labs.")
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-1">
                                    <span class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-[#E3EFFF] border border-[#C4D2E1] px-2.5 py-1 rounded">#AgenticWorkflows</span>
                                    <span class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-[#E3EFFF] border border-[#C4D2E1] px-2.5 py-1 rounded">#DistributedInference</span>
                                    <span class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-[#E3EFFF] border border-[#C4D2E1] px-2.5 py-1 rounded">#ModelAlignment</span>
                                    <span class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-[#E3EFFF] border border-[#C4D2E1] px-2.5 py-1 rounded">#GPUClusterArch</span>
                                </div>
                            </div>

                            <!-- Affiliated Hubs & Collectives -->
                            <div class="space-y-3 pt-2 border-t border-[#E2E8F0]">
                                <div class="prof-label-xs text-[#64748B]">AFFILIATED HUBS &amp; COLLECTIVES</div>
                                
                                <div class="space-y-2">
                                    <!-- Hub 1 -->
                                    <div class="p-3 bg-white border border-[#E2E8F0] rounded-lg flex items-center justify-between hover:border-[#CBD5E1] transition">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-lg bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold text-[#0A1B2E]">Frontier AI Alliance</div>
                                                <div class="text-[11px] text-[#64748B]">Lead Architect • 1,940 verified partners</div>
                                            </div>
                                        </div>
                                        <span class="prof-mono text-[10px] font-bold text-white bg-[#0A1B2E] border border-[#0A1B2E] px-2 py-0.5 rounded">
                                            PRIMARY
                                        </span>
                                    </div>

                                    <!-- Hub 2 -->
                                    <div class="p-3 bg-white border border-[#E2E8F0] rounded-lg flex items-center justify-between hover:border-[#CBD5E1] transition">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-lg bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold text-[#0A1B2E]">LLM Infra Guild</div>
                                                <div class="text-[11px] text-[#64748B]">Guild Host • 840 technical founders</div>
                                            </div>
                                        </div>
                                        <span class="prof-mono text-[10px] font-semibold text-[#64748B] hover:text-[#0A1B2E] cursor-pointer">
                                            Pass &gt;
                                        </span>
                                    </div>
                                </div>
                            </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center justify-center gap-3 w-full md:w-auto">
                        @if (isOwner)
                        {
                            <button @onclick="OpenEditModal" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                                ✏️ Edit Profile
                            </button>
                        }
                        else
                        {
                            <!-- Visitor View Action Buttons -->
                            <button @onclick="ToggleFollowUserAsync" disabled="@isTogglingFollow" class="px-4 py-2.5 rounded-xl text-xs font-semibold border transition shadow-sm flex items-center gap-2 @(profile.Relationship.IsFollowedByMe ? "bg-indigo-600 text-white border-indigo-500 hover:bg-indigo-700" : "bg-white/10 hover:bg-white/20 text-white border-white/20")">
                                @if (isTogglingFollow)
                                {
                                    <span class="animate-spin text-xs">⌛</span>
                                }
                                else
                                {
                                    <span>@(profile.Relationship.IsFollowedByMe ? "✓ Following" : "+ Follow")</span>
                                }
                            </button>

                            <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="px-4 py-2.5 rounded-xl text-xs font-semibold border transition shadow-sm flex items-center gap-2 @(profile.Relationship.IsSavedByMe ? "bg-amber-500/20 text-amber-300 border-amber-500/40 hover:bg-amber-500/30" : "bg-white/10 hover:bg-white/20 text-white border-white/20")">
                                @if (isSavingAccount)
                                {
                                    <span class="animate-spin text-xs">⌛</span>
                                }
                                else
                                {
                                    <span>@(profile.Relationship.IsSavedByMe ? "🔖 Saved" : "🔖 Save Account")</span>
                                }
                            </button>

                            <a href="chat" class="px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition shadow-lg shadow-sky-600/30 flex items-center gap-2">
                                💬 Send Message
                            </a>

                            <button @onclick="OpenRatingModal" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-amber-500/30 flex items-center gap-2">
                                ⭐ @(profile.Relationship.HasRated ? "Update Rating" : "Rate User")
                            </button>
                        }
                    </div>

                        </div>
                    </div>

                </div>

        <!-- Metrics Overview Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Posts</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@profile.Metrics.PostsCount</div>
                </div>
                <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">
                    📝
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Followers</div>
                    <div class="text-xl font-black text-slate-900 mt-1">@profile.Metrics.FollowersCount</div>
                </div>
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg">
                    👥
