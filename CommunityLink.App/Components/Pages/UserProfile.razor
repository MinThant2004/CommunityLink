@page "/profile"
@page "/u/{UserNameOrId}"
@attribute [Authorize]
@implements IDisposable
@inject UserProfileApiService ProfileApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(profile != null ? $"{profile.DisplayName} (@{profile.UserName}) — CommunityLink" : "User Profile — CommunityLink")</PageTitle>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap');

    .profile-canvas {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0A1B2E;
        background-color: #F8FAFC;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .prof-display {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: -0.025em;
    }

    .prof-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .prof-card {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .prof-card:hover {
        border-color: #CBD5E1;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.06), 0 2px 6px -1px rgba(10, 27, 46, 0.02);
    }

    .prof-btn-primary {
        background-color: #0A1B2E;
        color: #ffffff !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #0A1B2E;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .prof-btn-primary:hover:not(:disabled) {
        background-color: #112A46;
        border-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px -2px rgba(10, 27, 46, 0.18);
    }

    .prof-btn-secondary {
        background-color: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #0A1B2E !important;
        border-radius: 0.25rem;
        padding: 0.5rem 1rem;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .prof-btn-secondary:hover {
        background-color: #D9EAFF;
        border-color: #A1B2C4;
    }

    .prof-chip {
        background: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .prof-label-xs {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #64748B;
    }
</style>

<div class="profile-canvas pb-16">
    @if (isLoading)
    {
        <div class="p-16 text-center my-12 max-w-xl mx-auto prof-card">
            <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] border-t-transparent"></div>
            <h3 class="prof-display mt-4 text-base font-bold text-[#0A1B2E]">Synchronizing Profile Data</h3>
            <p class="mt-1 text-xs text-[#64748B]">Retrieving verified records, community memberships, and peer activity...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-8 bg-rose-50 border border-rose-200 rounded-lg text-rose-800 flex flex-col md:flex-row items-center justify-between gap-4 max-w-4xl mx-auto my-8 shadow-sm">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-[0.375rem] bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
                <div>
                    <h3 class="prof-display font-bold text-sm text-rose-900">Unable to load profile</h3>
                    <p class="text-xs text-rose-700 mt-0.5">@errorMessage</p>
                </div>
            </div>
            <button @onclick="LoadProfileAsync" class="prof-btn-primary text-xs">
                Retry Connection
            </button>
        </div>
    }
    else if (profile != null)
    {
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 pt-5 space-y-6">

            <!-- SUB-HEADER / BREADCRUMB & REGISTRY STATUS -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-[#E2E8F0]">
                <div class="flex items-center gap-3">
                    <button @onclick='() => Navigation.NavigateTo("home")' class="w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] text-[#64748B] hover:text-[#0A1B2E] flex items-center justify-center transition shadow-sm" title="Back to Home">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <div class="prof-mono text-[11px] sm:text-xs text-[#64748B] flex items-center gap-2 tracking-wider">
                        <span>REGISTRY</span>
                        <span class="text-[#CBD5E1]">/</span>
                        <span class="font-medium text-[#475569]">@(profile.Role.RoleName?.ToUpper() ?? "MEMBER")</span>
                        <span class="text-[#CBD5E1]">/</span>
                        <span class="text-[#0A1B2E] font-bold">@(profile.UserName?.ToUpper())_ID:@(profile.UserId.ToString("D4"))</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="prof-mono text-[11px] font-semibold text-[#0A1B2E] bg-white border border-[#E2E8F0] px-3 py-1.5 rounded-full flex items-center gap-2 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>@(profile.IsVerified ? "VERIFIED NODE" : "ACTIVE MEMBER")</span>
                    </div>

                    <button @onclick="ShareProfile" class="w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] text-[#64748B] hover:text-[#0A1B2E] flex items-center justify-center transition shadow-sm" title="Share Profile Link">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                    </button>

                    @if (!isOwner)
                    {
                        <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="w-8 h-8 rounded-lg bg-white border border-[#E2E8F0] @(profile.Relationship.IsSavedByMe ? "text-amber-500 border-amber-300" : "text-[#64748B] hover:text-[#0A1B2E]") flex items-center justify-center transition shadow-sm" title="@(profile.Relationship.IsSavedByMe ? "Remove from Bookmarks" : "Bookmark Account")">
                            <svg class="w-4 h-4" fill="@(profile.Relationship.IsSavedByMe ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                        </button>
                    }
                </div>
            </div>

            <!-- MAIN DUAL-COLUMN GRID LAYOUT -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

                <!-- ================= LEFT COLUMN: EXECUTIVE PROFILE CARD (4.5 / 12 Cols) ================= -->
                <div class="lg:col-span-5 xl:col-span-5 space-y-6">

                    <div class="prof-card overflow-hidden">
                        <!-- Cover Banner -->
                        <div class="relative h-36 sm:h-40 w-full bg-gradient-to-r from-[#0A1B2E] via-[#112A46] to-[#1E3A5F] overflow-hidden">
                            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px]"></div>

                            <!-- Badge inside Banner Top-Left -->
                            <div class="absolute top-4 left-4">
                                <span class="prof-mono text-[10px] font-semibold text-[#0A1B2E] bg-white/95 backdrop-blur-md px-3 py-1 rounded-full border border-white/40 flex items-center gap-1.5 shadow-sm">
                                    <span>@(profile.Role?.Badge ?? "👤")</span>
                                    <span>@(profile.Role?.RoleName?.ToUpper() ?? "MEMBER")</span>
                                </span>
                            </div>
                        </div>

                        <div class="px-6 pb-6 pt-0 space-y-5">
                            
                            <!-- Avatar & Credential Status Row -->
                            <div class="flex items-end justify-between -mt-12 sm:-mt-14 relative z-10 pb-2">
                                <div class="relative">
                                    @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                                    {
                                        <img src="@profile.AvatarUrl" 
                                             alt="@profile.DisplayName" 
                                             class="w-24 h-24 sm:w-26 sm:h-26 rounded-2xl object-cover ring-4 ring-white shadow-xl bg-white" />
                                    }
                                    else
                                    {
                                        <div class="w-24 h-24 sm:w-26 sm:h-26 rounded-2xl bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-3xl ring-4 ring-white shadow-xl prof-display">
                                            @(string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.UserName?.Substring(0, 1).ToUpper() : profile.DisplayName.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                    
                                    @if (profile.IsVerified)
                                    {
                                        <!-- Verified Pip Badge -->
                                        <div class="absolute -bottom-1 -right-1 bg-[#0A1B2E] text-white p-1 rounded-full ring-2 ring-white shadow-md flex items-center justify-center" title="Verified Member">
                                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                                                <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                            </svg>
                                        </div>
                                    }
                                </div>

                                <div class="text-right pb-1">
                                    <div class="prof-label-xs text-[#94A3B8]">CREDENTIAL STATUS</div>
                                    <div class="prof-mono text-xs font-bold text-[#0A1B2E] flex items-center justify-end gap-1.5 mt-0.5">
                                        <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                                        <span>TIER @(profile.Role?.RoleCode == "ADMIN" || profile.Role?.RoleCode == "SUPER_ADMIN" ? "0" : "1") ACTIVE</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Name, Role Title & Affiliations -->
                            <div class="space-y-1">
                                <div class="flex flex-wrap items-center gap-2.5">
                                    <h1 class="prof-display text-2xl sm:text-3xl font-bold text-[#0A1B2E] tracking-tight">
                                        @(string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.UserName : profile.DisplayName)
                                    </h1>
                                    <span class="prof-mono text-[10px] font-bold text-white bg-[#0A1B2E] border border-[#0A1B2E] px-2 py-0.5 rounded">
                                        @@@profile.UserName
                                    </span>
                                </div>
                                <h2 class="text-sm font-semibold text-[#557392] leading-snug">
                                    @(profile.Role?.RoleName ?? "Member") &middot; CommunityLink Member
                                </h2>
                                <p class="text-xs text-[#7A8CA6] leading-relaxed">
                                    Registered Member since @profile.CreatedAt.ToString("MMMM yyyy")
                                </p>
                            </div>

                            <!-- 3-Item Metrics Analytical Strip -->
                            <div class="grid grid-cols-3 border border-[#C4D2E1] rounded-lg overflow-hidden bg-[#EDF4FF] text-center py-3 divide-x divide-[#C4D2E1]">
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">
                                        @profile.Metrics.PostsCount
                                    </div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">POSTS</div>
                                </div>
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">
                                        @profile.Metrics.JoinedCommunitiesCount
                                    </div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">HUBS</div>
                                </div>
                                <div class="px-2">
                                    <div class="prof-display text-lg sm:text-xl font-bold text-[#0A1B2E]">
                                        @(profile.Metrics.AverageRating.HasValue ? profile.Metrics.AverageRating.Value.ToString("0.0") : "N/A")
                                        @if (profile.Metrics.AverageRating.HasValue)
                                        {
                                            <span class="text-xs text-amber-500">★</span>
                                        }
                                    </div>
                                    <div class="prof-mono text-[10px] font-semibold text-[#64748B] uppercase tracking-wider mt-0.5">
                                        @profile.Metrics.RatingCount REVIEWS
                                    </div>
                                </div>
                            </div>

                            <!-- Domain Expertise / Bio -->
                            <div class="space-y-2 pt-1 border-t border-[#E2E8F0]">
                                <div class="prof-label-xs text-[#64748B]">BIOGRAPHY &amp; EXPERTISE</div>
                                <p class="text-xs text-[#475569] leading-relaxed whitespace-pre-line">
                                    @(!string.IsNullOrWhiteSpace(profile.Bio) ? profile.Bio : "This member has not provided a biography yet.")
                                </p>
                            </div>

                            <!-- Affiliated Hubs Summary -->
                            <div class="space-y-3 pt-2 border-t border-[#E2E8F0]">
                                <div class="flex items-center justify-between">
                                    <div class="prof-label-xs text-[#64748B]">AFFILIATED COMMUNITIES</div>
                                    <span class="prof-mono text-[10px] text-[#7A8CA6]">@(userCommunities?.Count ?? 0) Hubs</span>
                                </div>
                                
                                @if (isLoadingCommunities)
                                {
                                    <div class="py-4 text-center">
                                        <div class="inline-block animate-spin rounded-full h-5 w-5 border-2 border-[#0A1B2E] border-t-transparent"></div>
                                    </div>
                                }
                                else if (userCommunities == null || userCommunities.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] py-2">No community affiliations recorded yet.</p>
                                }
                                else
                                {
                                    <div class="space-y-2">
                                        @foreach (var hub in userCommunities.Take(3))
                                        {
                                            <div class="p-2.5 bg-white border border-[#E2E8F0] rounded-lg flex items-center justify-between hover:border-[#CBD5E1] transition">
                                                <div class="flex items-center gap-2.5">
                                                    <div class="w-8 h-8 rounded-lg bg-[#F1F5F9] text-[#0A1B2E] border border-[#E2E8F0] flex items-center justify-center font-bold text-xs">
                                                        @hub.Name.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div>
                                                        <div class="text-xs font-bold text-[#0A1B2E]">@hub.Name</div>
                                                        <div class="text-[10px] text-[#64748B]">@hub.RoleName &bull; @hub.MemberCount members</div>
                                                    </div>
                                                </div>
                                                <a href="communities" class="prof-mono text-[10px] font-semibold text-[#557392] hover:text-[#0A1B2E]">
                                                    View &rarr;
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Owner or Visitor Control Buttons -->
                            <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between gap-3">
                                @if (isOwner)
                                {
                                    <button @onclick="OpenEditModal" class="prof-btn-primary w-full text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                        Edit Profile Credentials
                                    </button>
                                }
                                else
                                {
                                    <a href="chat" class="prof-btn-primary flex-1 text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                        Direct Message
                                    </a>
                                    <button @onclick="OpenRatingModal" class="prof-btn-secondary text-xs">
                                        <svg class="w-4 h-4 text-amber-500" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        @(profile.Relationship.HasRated ? "Edit Review" : "Rate Member")
                                    </button>
                                }
                            </div>

                        </div>
                    </div>

                </div>

                <!-- ================= RIGHT COLUMN: ACTIVITY & CONTRIBUTION TABS (7.5 / 12 Cols) ================= -->
                <div class="lg:col-span-7 xl:col-span-7 space-y-6">

                    <!-- Section Header -->
                    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                        <div>
                            <div class="prof-label-xs text-[#64748B]">COMMUNITY WORKSPACE</div>
                            <h2 class="prof-display text-2xl sm:text-3xl font-bold text-[#0A1B2E] tracking-tight">
                                Activity &amp; Contributions
                            </h2>
                        </div>
                        <p class="text-xs text-[#64748B] max-w-xs text-left sm:text-right leading-relaxed">
                            Verified broadcasts, community affiliations, and peer reviews for @(string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.UserName : profile.DisplayName).
                        </p>
                    </div>

                    <!-- Navigation Tabs Bar -->
                    <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] p-1.5 flex flex-wrap items-center gap-1.5">
                        <button type="button" @onclick='() => activeTab = "posts"'
                                class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition text-center @(activeTab == "posts" ? "bg-[#0A1B2E] text-white shadow-sm" : "text-[#557392] hover:text-[#0A1B2E] hover:bg-[#F1F5F9]")">
                            📝 Posts (@(userPosts?.Count ?? 0))
                        </button>
                        <button type="button" @onclick='() => activeTab = "communities"'
                                class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition text-center @(activeTab == "communities" ? "bg-[#0A1B2E] text-white shadow-sm" : "text-[#557392] hover:text-[#0A1B2E] hover:bg-[#F1F5F9]")">
                            🏛️ Hubs (@(userCommunities?.Count ?? 0))
                        </button>
                        <button type="button" @onclick='() => activeTab = "reviews"'
                                class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition text-center @(activeTab == "reviews" ? "bg-[#0A1B2E] text-white shadow-sm" : "text-[#557392] hover:text-[#0A1B2E] hover:bg-[#F1F5F9]")">
                            ⭐ Reviews (@(userReviews?.Count ?? 0))
                        </button>
                        @if (isOwner)
                        {
                            <button type="button" @onclick='() => activeTab = "saved"'
                                    class="flex-1 py-2 px-3 text-xs font-bold rounded-xl transition text-center @(activeTab == "saved" ? "bg-[#0A1B2E] text-white shadow-sm" : "text-[#557392] hover:text-[#0A1B2E] hover:bg-[#F1F5F9]")">
                                🔖 Saved (@((savedPosts?.Count ?? 0) + (savedAccounts?.Count ?? 0)))
                            </button>
                        }
                    </div>

                    <!-- TAB 1: POSTS -->
                    @if (activeTab == "posts")
                    {
                        @if (isLoadingPosts)
                        {
                            <div class="p-12 text-center bg-white rounded-2xl border border-[#E2E8F0]">
                                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                                <p class="mt-2 text-xs text-[#7A8CA6]">Loading user posts...</p>
                            </div>
                        }
                        else if (userPosts == null || userPosts.Count == 0)
                        {
                            <div class="bg-white rounded-2xl border border-dashed border-[#CBD5E1] p-12 text-center text-[#7A8CA6] space-y-2">
                                <div class="text-4xl mb-2">✍️</div>
                                <h3 class="text-base font-bold text-[#0A1B2E]">No broadcasts published yet</h3>
                                <p class="text-xs text-[#557392] max-w-sm mx-auto">
                                    @(isOwner ? "You haven't shared any posts yet. Broadcast your insights to your community network!" : "This member has not shared any public broadcasts yet.")
                                </p>
                                @if (isOwner)
                                {
                                    <div class="pt-2">
                                        <a href="feed" class="prof-btn-primary text-xs">Create Broadcast Now</a>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="space-y-4">
                                @foreach (var post in userPosts)
                                {
                                    <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] hover:border-[#CBD5E1] p-5 space-y-3 transition">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                <span class="prof-mono text-[10px] font-bold text-[#0A1B2E] bg-[#F1F5F9] border border-[#E2E8F0] px-2.5 py-0.5 rounded">
                                                    @(string.IsNullOrWhiteSpace(post.CommunityName) ? "GENERAL" : post.CommunityName.ToUpper())
                                                </span>
                                                <span class="prof-mono text-[11px] text-[#7A8CA6]">@post.CreatedAt.ToString("g")</span>
                                            </div>
                                            <a href="feed" class="text-xs font-semibold text-[#557392] hover:text-[#0A1B2E]">
                                                View Post &rarr;
                                            </a>
                                        </div>

                                        <p class="text-sm text-[#0A1B2E] leading-relaxed whitespace-pre-line">
                                            @post.Content
                                        </p>

                                        <div class="pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs text-[#7A8CA6] font-mono">
                                            <div class="flex items-center gap-4">
                                                <span>❤️ @post.LikeCount Likes</span>
                                                <span>💬 @post.CommentCount Comments</span>
                                            </div>
                                            <a href="feed" class="text-xs font-semibold text-[#0A1B2E] hover:underline">
                                                Join Discussion
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <!-- TAB 2: COMMUNITIES -->
                    @if (activeTab == "communities")
                    {
                        @if (isLoadingCommunities)
                        {
                            <div class="p-12 text-center bg-white rounded-2xl border border-[#E2E8F0]">
                                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                                <p class="mt-2 text-xs text-[#7A8CA6]">Loading community affiliations...</p>
                            </div>
                        }
                        else if (userCommunities == null || userCommunities.Count == 0)
                        {
                            <div class="bg-white rounded-2xl border border-dashed border-[#CBD5E1] p-12 text-center text-[#7A8CA6] space-y-2">
                                <div class="text-4xl mb-2">🏛️</div>
                                <h3 class="text-base font-bold text-[#0A1B2E]">No communities joined yet</h3>
                                <p class="text-xs text-[#557392] max-w-sm mx-auto">
                                    @(isOwner ? "Explore public community hubs across the network and participate in discussions." : "This member is not an active member in any public hubs yet.")
                                </p>
                                @if (isOwner)
                                {
                                    <div class="pt-2">
                                        <a href="communities" class="prof-btn-primary text-xs">Explore Hubs Directory</a>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                @foreach (var comm in userCommunities)
                                {
                                    <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] hover:border-[#CBD5E1] p-5 space-y-3 transition flex flex-col justify-between">
                                        <div class="space-y-2">
                                            <div class="flex items-center justify-between">
                                                <span class="prof-mono text-[10px] font-bold text-white bg-[#0A1B2E] px-2 py-0.5 rounded">
                                                    @comm.RoleName.ToUpper()
                                                </span>
                                                <span class="prof-mono text-[11px] text-[#7A8CA6]">👥 @comm.MemberCount</span>
                                            </div>
                                            <h3 class="font-bold text-sm text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">@comm.Name</h3>
                                            <p class="text-xs text-[#557392] line-clamp-2 leading-relaxed">
                                                @(string.IsNullOrWhiteSpace(comm.Description) ? "Active collaborative community on CommunityLink." : comm.Description)
                                            </p>
                                        </div>

                                        <div class="pt-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs">
                                            <span class="prof-mono text-[10px] text-[#7A8CA6]">Joined @comm.JoinedAt.ToString("MMM yyyy")</span>
                                            <a href="communities" class="prof-btn-secondary text-xs !py-1 !px-2.5">
                                                Enter Hub &rarr;
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <!-- TAB 3: PEER REVIEWS -->
                    @if (activeTab == "reviews")
                    {
                        @if (isLoadingReviews)
                        {
                            <div class="p-12 text-center bg-white rounded-2xl border border-[#E2E8F0]">
                                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                                <p class="mt-2 text-xs text-[#7A8CA6]">Loading peer reviews...</p>
                            </div>
                        }
                        else if (userReviews == null || userReviews.Count == 0)
                        {
                            <div class="bg-white rounded-2xl border border-dashed border-[#CBD5E1] p-12 text-center text-[#7A8CA6] space-y-2">
                                <div class="text-4xl mb-2">⭐</div>
                                <h3 class="text-base font-bold text-[#0A1B2E]">No peer reviews recorded yet</h3>
                                <p class="text-xs text-[#557392] max-w-sm mx-auto">
                                    @(isOwner ? "When peers and collaborators review your work or engagements, their ratings will appear here." : "Be the first to rate and review this member!")
                                </p>
                                @if (!isOwner)
                                {
                                    <div class="pt-2">
                                        <button @onclick="OpenRatingModal" class="prof-btn-primary text-xs">Rate This Member</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="space-y-4">
                                @foreach (var review in userReviews)
                                {
                                    <div class="bg-white rounded-2xl shadow-sm border border-[#E2E8F0] hover:border-[#CBD5E1] p-5 space-y-3 transition">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(review.RaterAvatarUrl))
                                                {
                                                    <img src="@review.RaterAvatarUrl" alt="@review.RaterDisplayName" class="w-9 h-9 rounded-full object-cover border border-[#E2E8F0]" />
                                                }
                                                else
                                                {
                                                    <div class="w-9 h-9 rounded-full bg-[#0A1B2E] text-white font-bold text-xs flex items-center justify-center">
                                                        @(string.IsNullOrWhiteSpace(review.RaterDisplayName) ? "U" : review.RaterDisplayName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <div class="text-xs font-bold text-[#0A1B2E]">@review.RaterDisplayName</div>
                                                    <div class="prof-mono text-[10px] text-[#7A8CA6]">@@@review.RaterUserName &bull; @review.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1 text-amber-500 text-sm">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <span>@(i <= review.Score ? "★" : "☆")</span>
                                                }
                                                <span class="prof-mono text-xs font-bold text-[#0A1B2E] ml-1">@review.Score.ToString("0.0")</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                        {
                                            <p class="text-xs text-[#334155] leading-relaxed italic bg-[#F8FAFC] p-3 rounded-lg border border-[#E2E8F0]">
                                                "@review.ReviewText"
                                            </p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    <!-- TAB 4: SAVED (Owner Only) -->
                    @if (isOwner && activeTab == "saved")
                    {
                        <div class="space-y-6">
                            <!-- Saved Posts -->
                            <div class="space-y-3">
                                <h3 class="text-sm font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">📌 Saved Posts &amp; Broadcasts</h3>
                                @if (savedPosts == null || savedPosts.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] p-4 bg-white rounded-xl border border-[#E2E8F0]">No saved posts yet.</p>
                                }
                                else
                                {
                                    <div class="space-y-3">
                                        @foreach (var sp in savedPosts)
                                        {
                                            <div class="bg-white rounded-xl border border-[#E2E8F0] p-4 flex items-center justify-between gap-3">
                                                <div>
                                                    <div class="text-xs font-semibold text-[#557392]">@@@sp.AuthorUserName in @sp.CommunityName</div>
                                                    <p class="text-xs text-[#0A1B2E] line-clamp-1 mt-0.5">@sp.Content</p>
                                                </div>
                                                <a href="feed" class="prof-btn-secondary text-xs !py-1 !px-2.5 whitespace-nowrap">View</a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Saved Accounts -->
                            <div class="space-y-3">
                                <h3 class="text-sm font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">👥 Saved Peer Accounts</h3>
                                @if (savedAccounts == null || savedAccounts.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] p-4 bg-white rounded-xl border border-[#E2E8F0]">No saved accounts bookmarked yet.</p>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @foreach (var sa in savedAccounts)
                                        {
                                            <div class="bg-white rounded-xl border border-[#E2E8F0] p-3 flex items-center justify-between gap-3">
                                                <div class="flex items-center gap-2.5">
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs">
                                                        @(string.IsNullOrWhiteSpace(sa.DisplayName) ? "U" : sa.DisplayName.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <div>
                                                        <div class="text-xs font-bold text-[#0A1B2E]">@sa.DisplayName</div>
                                                        <div class="prof-mono text-[10px] text-[#7A8CA6]">@@@sa.UserName</div>
                                                    </div>
                                                </div>
                                                <a href="u/@sa.UserName" class="prof-btn-secondary text-xs !py-1 !px-2.5">Profile</a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>

            </div>

            <!-- FOOTER -->
            <footer class="pt-12 pb-6 border-t border-[#E2E8F0] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#64748B]">
                <div class="flex items-center gap-2">
                    <span class="w-5 h-5 rounded bg-[#0A1B2E] text-white text-[10px] font-bold flex items-center justify-center">CL</span>
                    <span>&copy; CommunityLink Platform. Verified Node Architecture.</span>
                </div>
                <div class="prof-mono text-[10px] flex flex-wrap items-center gap-5 tracking-wider">
                    <a href="communities" class="text-[#64748B] hover:text-[#0A1B2E] transition">COMMUNITIES DIRECTORY</a>
                    <a href="feed" class="text-[#64748B] hover:text-[#0A1B2E] transition">PUBLIC FEED</a>
                    <a href="dashboard" class="text-[#64748B] hover:text-[#0A1B2E] transition">MY DASHBOARD</a>
                </div>
            </footer>

        </div>
    }
</div>

<!-- EDIT PROFILE MODAL -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="bg-white rounded-lg shadow-2xl border border-[#E2E8F0] max-w-lg w-full p-6 space-y-5 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <h3 class="prof-display text-lg font-bold text-[#0A1B2E]">Edit Profile Credentials</h3>
                <button @onclick="CloseEditModal" class="text-[#94A3B8] hover:text-[#0A1B2E] text-2xl leading-none font-bold">&times;</button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Display Name *</label>
                    <input type="text" @bind="editModel.DisplayName" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] focus:border-[#0A1B2E] outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Username *</label>
                    <input type="text" @bind="editModel.UserName" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] prof-mono focus:border-[#0A1B2E] outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Domain Expertise / Bio</label>
                    <textarea @bind="editModel.Bio" rows="3" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] focus:border-[#0A1B2E] outline-none resize-none" placeholder="Share your experience, interests, or background..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded">
                    @editErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                <button @onclick="CloseEditModal" class="prof-btn-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SaveProfileAsync" disabled="@isSavingProfile" class="prof-btn-primary text-xs">
                    @if (isSavingProfile)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Profile Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- RATE USER MODAL -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="bg-white rounded-lg shadow-2xl border border-[#E2E8F0] max-w-md w-full p-6 space-y-4 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <h3 class="prof-display text-base font-bold text-[#0A1B2E]">Rate @profile?.DisplayName</h3>
                <button @onclick="CloseRatingModal" class="text-[#94A3B8] hover:text-[#0A1B2E] text-2xl leading-none font-bold">&times;</button>
            </div>

            <div class="space-y-4 text-center">
                <p class="text-xs text-[#64748B]">Select rating score:</p>
                <div class="flex items-center justify-center gap-2 text-2xl cursor-pointer py-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var score = i;
                        <span @onclick="() => ratingModel.Score = score" class="transition @(score <= ratingModel.Score ? "text-amber-500" : "text-slate-300")">
                            ★
                        </span>
                    }
                </div>
                <div class="prof-mono text-xs font-bold text-amber-600 uppercase">
                    @ratingModel.Score Star@(ratingModel.Score > 1 ? "s" : "")
                </div>

                <div class="text-left">
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Written Review</label>
                    <textarea @bind="ratingModel.ReviewText" rows="3" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] outline-none" placeholder="Share your experience working with this peer..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                <button @onclick="CloseRatingModal" class="prof-btn-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="prof-btn-primary text-xs">
                    Submit Review
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserNameOrId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private UserProfileDto? profile;
    private bool isOwner;

    // Active Content Tab
    private string activeTab = "posts";

    // Dynamic Live Data Collections
    private List<UserPostItemDto>? userPosts;
    private bool isLoadingPosts;

    private List<UserCommunityItemDto>? userCommunities;
    private bool isLoadingCommunities;

    private List<UserRatingItemDto>? userReviews;
    private bool isLoadingReviews;

    private List<UserPostItemDto>? savedPosts;
    private List<SavedAccountItemDto>? savedAccounts;

    // Edit Profile Modal
    private bool showEditModal;
    private bool isSavingProfile;
    private string? editErrorMessage;
    private UpdateUserProfileRequestDto editModel = new();

    // Save Account Action
    private bool isSavingAccount;

    // Rating Modal
    private bool showRatingModal;
    private bool isSubmittingRating;
    private string? ratingErrorMessage;
    private RateUserRequestDto ratingModel = new() { Score = 5 };

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            Result<UserProfileDto> res;
            if (string.IsNullOrWhiteSpace(UserNameOrId))
            {
                res = await ProfileApi.GetOwnerProfileAsync(_cts.Token);
            }
            else
            {
                res = await ProfileApi.GetPublicProfileAsync(UserNameOrId, _cts.Token);
            }

            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                isOwner = profile.Relationship.IsSelf || string.IsNullOrWhiteSpace(UserNameOrId);
                
                // Concurrently load live related collections
                await Task.WhenAll(
                    LoadUserPostsAsync(profile.UserId),
                    LoadUserCommunitiesAsync(profile.UserId),
                    LoadUserReviewsAsync(profile.UserId),
                    isOwner ? LoadSavedDataAsync() : Task.CompletedTask
                );
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load profile.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUserPostsAsync(int userId)
    {
        isLoadingPosts = true;
        try
        {
            var res = await ProfileApi.GetUserPostsAsync(userId, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                userPosts = res.Data;
            }
        }
        catch { }
        finally
        {
            isLoadingPosts = false;
        }
    }

    private async Task LoadUserCommunitiesAsync(int userId)
    {
        isLoadingCommunities = true;
        try
        {
            var res = await ProfileApi.GetUserCommunitiesAsync(userId, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                userCommunities = res.Data;
            }
        }
        catch { }
        finally
        {
            isLoadingCommunities = false;
        }
    }

    private async Task LoadUserReviewsAsync(int userId)
    {
        isLoadingReviews = true;
        try
        {
            var res = await ProfileApi.GetUserReviewsAsync(userId, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                userReviews = res.Data;
            }
        }
        catch { }
        finally
        {
            isLoadingReviews = false;
        }
    }

    private async Task LoadSavedDataAsync()
    {
        try
        {
            var postsTask = ProfileApi.GetSavedPostsAsync(_cts.Token);
            var accountsTask = ProfileApi.GetSavedAccountsAsync(_cts.Token);
            await Task.WhenAll(postsTask, accountsTask);

            if (postsTask.Result.IsSuccess) savedPosts = postsTask.Result.Data;
            if (accountsTask.Result.IsSuccess) savedAccounts = accountsTask.Result.Data;
        }
        catch { }
    }

    private async Task ToggleSaveAccountAsync()
    {
        if (profile == null || isOwner) return;
        isSavingAccount = true;
        try
        {
            var res = await ProfileApi.ToggleSaveAccountAsync(profile.UserId, _cts.Token);
            if (res.IsSuccess)
            {
                profile.Relationship.IsSavedByMe = res.Data;
                Toast.Success(res.Data ? "Saved account to bookmarks." : "Removed from bookmarks.");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    private async Task ShareProfile()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            Toast.Success("Profile link copied to clipboard!");
        }
        catch
        {
            Toast.Info($"Profile link: {Navigation.Uri}");
        }
    }

    private void OpenEditModal()
    {
        if (profile == null) return;
        editModel = new UpdateUserProfileRequestDto
        {
            DisplayName = profile.DisplayName,
            UserName = profile.UserName,
            Bio = profile.Bio
        };
        editErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task SaveProfileAsync()
    {
        if (profile == null) return;
        isSavingProfile = true;
        editErrorMessage = null;
        try
        {
            var updateRes = await ProfileApi.UpdateProfileAsync(editModel, _cts.Token);
            if (updateRes.IsSuccess && updateRes.Data != null)
            {
                profile = updateRes.Data;
                Toast.Success("Profile credentials updated!");
                showEditModal = false;
            }
            else
            {
                editErrorMessage = updateRes.Message;
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private void OpenRatingModal()
    {
        if (profile == null) return;
        ratingModel = new RateUserRequestDto
        {
            Score = profile.Relationship.MyRatingScore ?? 5,
            ReviewText = profile.Relationship.MyReviewText
        };
        ratingErrorMessage = null;
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
    }

    private async Task SubmitRatingAsync()
    {
        if (profile == null) return;
        isSubmittingRating = true;
        ratingErrorMessage = null;
        try
        {
            var res = await ProfileApi.RateUserAsync(profile.UserId, ratingModel, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                Toast.Success("Rating and review submitted!");
                showRatingModal = false;
                await LoadUserReviewsAsync(profile.UserId);
            }
            else
            {
                ratingErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ratingErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
