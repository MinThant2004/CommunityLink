@page "/profile"
@page "/u/{UserNameOrId}"
@attribute [Authorize]
@implements IDisposable
@inject UserProfileApiService ProfileApi
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>@(profile != null ? $"{profile.DisplayName} (@{profile.UserName}) — CommunityLink" : "User Profile — CommunityLink")</PageTitle>

<div class="max-w-7xl mx-auto space-y-6 pb-12">
    @if (isLoading)
    {
        <div class="p-16 text-center text-slate-500 bg-white rounded-3xl shadow-sm border border-slate-200/80 my-8">
            <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-indigo-600 border-t-transparent"></div>
            <p class="mt-3 text-sm font-semibold text-slate-600">Loading user profile...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="p-8 bg-rose-50 border border-rose-200 rounded-3xl text-rose-700 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="text-2xl">⚠️</span>
                <div>
                    <h3 class="font-bold text-base">Unable to load profile</h3>
                    <p class="text-xs text-rose-600 mt-0.5">@errorMessage</p>
                </div>
            </div>
            <button @onclick="LoadProfileAsync" class="px-5 py-2.5 bg-rose-600 text-white text-xs font-semibold rounded-xl hover:bg-rose-700 transition shadow-sm">
                Retry
            </button>
        </div>
    }
    else if (profile != null)
    {
        <!-- Profile Banner & Hero Header -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white shadow-xl border border-slate-800">
            <!-- Decorative Glow Background Elements -->
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 p-6 md:p-10">
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    
                    <!-- Avatar & User Info -->
                    <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-5">
                        <div class="relative group">
                            @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                            {
                                <img src="@profile.AvatarUrl" alt="@profile.DisplayName" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover ring-4 ring-indigo-500/30 shadow-2xl" />
                            }
                            else
                            {
                                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 text-white font-black text-3xl sm:text-4xl flex items-center justify-center ring-4 ring-indigo-500/30 shadow-2xl">
                                    @profile.DisplayName.Substring(0, 1).ToUpper()
                                </div>
                            }
                            @if (profile.IsVerified)
                            {
                                <div class="absolute -bottom-2 -right-2 bg-emerald-500 text-white p-1.5 rounded-xl shadow-lg ring-2 ring-slate-900" title="Verified Account">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                                        <path d="M6.293 9.293a1 1 0 011.414 0L9 10.586l4.293-4.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 010-1.414z"/>
                                    </svg>
                                </div>
                            }
                        </div>

                        <div class="space-y-2">
                            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
                                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">@profile.DisplayName</h1>
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-indigo-200 border border-white/15 backdrop-blur-md flex items-center gap-1.5 shadow-sm">
                                    <span>@profile.Role.Badge</span>
                                    <span>@profile.Role.RoleName</span>
                                </span>
                            </div>

                            <p class="text-indigo-300 font-mono text-sm font-medium">@@@profile.UserName</p>

                            @if (!string.IsNullOrWhiteSpace(profile.Bio))
                            {
                                <p class="text-slate-300 text-sm max-w-2xl line-clamp-3 leading-relaxed">@profile.Bio</p>
                            }
                            else
                            {
                                <p class="text-slate-400 text-xs italic">No bio provided yet.</p>
                            }

                            <!-- Member since & Rating Summary -->
                            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 pt-1 text-xs text-slate-400 font-medium">
                                <span class="flex items-center gap-1.5">
                                    📅 Joined @profile.CreatedAt.ToString("MMM yyyy")
                                </span>
                                <span class="flex items-center gap-1.5 text-amber-300 font-bold bg-amber-500/10 px-2.5 py-0.5 rounded-lg border border-amber-500/20">
                                    ⭐ @(profile.Metrics.AverageRating.HasValue ? profile.Metrics.AverageRating.Value.ToString("0.00") : "No ratings")
                                    <span class="text-slate-400 font-normal">(@profile.Metrics.RatingCount reviews)</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center justify-center gap-3 w-full md:w-auto">
                        @if (isOwner)
                        {
                            <button @onclick="OpenEditModal" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                                ✏️ Edit Profile
                            </button>
                        }
                        else
                        {
                            <!-- Visitor View Action Buttons -->
                            <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="px-4 py-2.5 rounded-xl text-xs font-semibold border transition shadow-sm flex items-center gap-2 @(profile.Relationship.IsSavedByMe ? "bg-amber-500/20 text-amber-300 border-amber-500/40 hover:bg-amber-500/30" : "bg-white/10 hover:bg-white/20 text-white border-white/20")">
                                @if (isSavingAccount)
                                {
                                    <span class="animate-spin text-xs">⌛</span>
                                }
                                else
                                {
                                    <span>@(profile.Relationship.IsSavedByMe ? "🔖 Saved" : "🔖 Save Account")</span>
                                }
                            </button>

                            <a href="chat" class="px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition shadow-lg shadow-sky-600/30 flex items-center gap-2">
                                💬 Send Message
                            </a>

                            <button @onclick="OpenRatingModal" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-amber-500/30 flex items-center gap-2">
                                ⭐ @(profile.Relationship.HasRated ? "Update Rating" : "Rate User")
                            </button>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- Metrics Overview Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Posts</div>
                    <div class="text-2xl font-black text-slate-900 mt-1">@profile.Metrics.PostsCount</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                    📝
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Communities</div>
                    <div class="text-2xl font-black text-slate-900 mt-1">@profile.Metrics.JoinedCommunitiesCount</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                    🏛️
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rating</div>
                    <div class="text-2xl font-black text-amber-500 mt-1">
                        @(profile.Metrics.AverageRating.HasValue ? profile.Metrics.AverageRating.Value.ToString("0.0") : "—")
                    </div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                    ⭐
                </div>
            </div>

            @if (isOwner)
            {
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Saved Accounts</div>
                        <div class="text-2xl font-black text-slate-900 mt-1">@profile.Metrics.SavedAccountsCount</div>
                    </div>
                    <div class="w-11 h-11 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center text-xl">
                        👥
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Reviews</div>
                        <div class="text-2xl font-black text-slate-900 mt-1">@profile.Metrics.RatingCount</div>
                    </div>
                    <div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                        💬
                    </div>
                </div>
            }
        </div>

        <!-- Tabbed Navigation Bar -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-2">
            <div class="flex flex-wrap items-center gap-1 border-b border-slate-100 pb-2">
                <button @onclick='() => SetTab("posts")' class="px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(activeTab == "posts" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-600 hover:bg-slate-100")">
                    <span>📝</span> Posts (@postsList.Count)
                </button>

                @if (isOwner)
                {
                    <button @onclick='() => SetTab("saved-posts")' class="px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(activeTab == "saved-posts" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-600 hover:bg-slate-100")">
                        <span>🔖</span> Saved Posts (@savedPostsList.Count)
                    </button>

                    <button @onclick='() => SetTab("saved-accounts")' class="px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(activeTab == "saved-accounts" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-600 hover:bg-slate-100")">
                        <span>👥</span> Saved Accounts (@savedAccountsList.Count)
                    </button>
                }

                <button @onclick='() => SetTab("communities")' class="px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(activeTab == "communities" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-600 hover:bg-slate-100")">
                    <span>🏛️</span> Communities (@communitiesList.Count)
                </button>

                <button @onclick='() => SetTab("reviews")' class="px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(activeTab == "reviews" ? "bg-indigo-600 text-white shadow-md shadow-indigo-600/20" : "text-slate-600 hover:bg-slate-100")">
                    <span>⭐</span> Reviews (@reviewsList.Count)
                </button>
            </div>

            <!-- Tab Contents -->
            <div class="p-4 md:p-6">
                @if (isTabLoading)
                {
                    <div class="py-12 text-center text-slate-400 font-medium text-xs">
                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-indigo-600 border-t-transparent mb-2"></div>
                        <p>Loading tab content...</p>
                    </div>
                }
                else if (activeTab == "posts")
                {
                    @if (!postsList.Any())
                    {
                        <div class="py-12 text-center text-slate-500">
                            <span class="text-3xl">📝</span>
                            <p class="mt-2 text-sm font-semibold">No posts published yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var post in postsList)
                            {
                                <div class="p-5 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-200/80 transition space-y-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="px-2.5 py-0.5 rounded-md bg-indigo-100 text-indigo-700 font-bold">🏛️ @post.CommunityName</span>
                                        <span class="text-slate-400 font-medium">@post.CreatedAt.ToString("g")</span>
                                    </div>
                                    <h3 class="font-bold text-base text-slate-900">@post.Title</h3>
                                    <p class="text-slate-700 text-sm line-clamp-3 leading-relaxed">@post.Content</p>
                                    <div class="flex items-center gap-4 text-xs font-semibold text-slate-500 pt-2">
                                        <span>❤️ @post.LikeCount Likes</span>
                                        <span>💬 @post.CommentCount Comments</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (activeTab == "saved-posts" && isOwner)
                {
                    @if (!savedPostsList.Any())
                    {
                        <div class="py-12 text-center text-slate-500">
                            <span class="text-3xl">🔖</span>
                            <p class="mt-2 text-sm font-semibold">No saved posts yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var post in savedPostsList)
                            {
                                <div class="p-5 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-200/80 transition space-y-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <div class="flex items-center gap-2">
                                            <span class="px-2.5 py-0.5 rounded-md bg-indigo-100 text-indigo-700 font-bold">🏛️ @post.CommunityName</span>
                                            <span class="text-slate-500">by <strong>@@@post.AuthorUserName</strong></span>
                                        </div>
                                        <span class="text-slate-400 font-medium">@post.CreatedAt.ToString("g")</span>
                                    </div>
                                    <h3 class="font-bold text-base text-slate-900">@post.Title</h3>
                                    <p class="text-slate-700 text-sm line-clamp-3 leading-relaxed">@post.Content</p>
                                    <div class="flex items-center gap-4 text-xs font-semibold text-slate-500 pt-2">
                                        <span>❤️ @post.LikeCount Likes</span>
                                        <span>💬 @post.CommentCount Comments</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (activeTab == "saved-accounts" && isOwner)
                {
                    @if (!savedAccountsList.Any())
                    {
                        <div class="py-12 text-center text-slate-500">
                            <span class="text-3xl">👥</span>
                            <p class="mt-2 text-sm font-semibold">No saved accounts yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var sa in savedAccountsList)
                            {
                                <div class="p-4 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-200/80 transition flex items-center justify-between gap-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(sa.AvatarUrl))
                                        {
                                            <img src="@sa.AvatarUrl" alt="@sa.DisplayName" class="w-12 h-12 rounded-xl object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white font-bold text-lg flex items-center justify-center">
                                                @sa.DisplayName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div>
                                            <a href="u/@sa.UserName" class="font-bold text-sm text-slate-900 hover:text-indigo-600 transition">@sa.DisplayName</a>
                                            <p class="text-xs text-indigo-600 font-mono">@@@sa.UserName</p>
                                            <div class="text-xs text-slate-400 mt-0.5">
                                                ⭐ @(sa.AverageRating.HasValue ? sa.AverageRating.Value.ToString("0.0") : "N/A")
                                            </div>
                                        </div>
                                    </div>
                                    <a href="u/@sa.UserName" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition">
                                        View
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
                else if (activeTab == "communities")
                {
                    @if (!communitiesList.Any())
                    {
                        <div class="py-12 text-center text-slate-500">
                            <span class="text-3xl">🏛️</span>
                            <p class="mt-2 text-sm font-semibold">No communities joined.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var comm in communitiesList)
                            {
                                <div class="p-5 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-200/80 transition flex items-center justify-between gap-4">
                                    <div>
                                        <div class="font-bold text-base text-slate-900">@comm.Name</div>
                                        <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">@comm.Description</p>
                                        <div class="flex items-center gap-3 text-xs font-medium text-slate-400 mt-2">
                                            <span>👥 @comm.MemberCount members</span>
                                            <span>🛡️ @comm.RoleName</span>
                                        </div>
                                    </div>
                                    <a href="communities" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition whitespace-nowrap">
                                        Visit
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
                else if (activeTab == "reviews")
                {
                    @if (!reviewsList.Any())
                    {
                        <div class="py-12 text-center text-slate-500">
                            <span class="text-3xl">⭐</span>
                            <p class="mt-2 text-sm font-semibold">No reviews received yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var review in reviewsList)
                            {
                                <div class="p-5 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-2">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrWhiteSpace(review.RaterAvatarUrl))
                                            {
                                                <img src="@review.RaterAvatarUrl" alt="@review.RaterDisplayName" class="w-9 h-9 rounded-xl object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-9 h-9 rounded-xl bg-slate-200 text-slate-700 font-bold text-sm flex items-center justify-center">
                                                    @review.RaterDisplayName.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <div>
                                                <a href="u/@review.RaterUserName" class="font-bold text-xs text-slate-900 hover:text-indigo-600 transition">@review.RaterDisplayName</a>
                                                <p class="text-[11px] text-slate-400">@@@review.RaterUserName</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1 text-amber-500 font-bold text-sm">
                                            <span>@string.Concat(Enumerable.Repeat("★", review.Score))</span>
                                            <span class="text-slate-300">@string.Concat(Enumerable.Repeat("★", 5 - review.Score))</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                    {
                                        <p class="text-slate-700 text-sm leading-relaxed pt-1">@review.ReviewText</p>
                                    }
                                    <div class="text-[11px] text-slate-400 font-medium text-right">
                                        @review.CreatedAt.ToString("g")
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- EDIT PROFILE MODAL -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-lg w-full overflow-hidden space-y-5 p-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <span>✏️</span> Edit User Profile
                </h3>
                <button @onclick="CloseEditModal" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>

            <!-- Avatar Uploader -->
            <div class="flex flex-col items-center gap-3 py-2 border-b border-slate-100 pb-4">
                <div class="relative">
                    @if (!string.IsNullOrWhiteSpace(editAvatarPreview))
                    {
                        <img src="@editAvatarPreview" alt="Avatar preview" class="w-24 h-24 rounded-2xl object-cover ring-4 ring-indigo-500/20" />
                    }
                    else if (!string.IsNullOrWhiteSpace(profile?.AvatarUrl))
                    {
                        <img src="@profile.AvatarUrl" alt="Avatar" class="w-24 h-24 rounded-2xl object-cover ring-4 ring-indigo-500/20" />
                    }
                    else
                    {
                        <div class="w-24 h-24 rounded-2xl bg-indigo-600 text-white font-black text-3xl flex items-center justify-center ring-4 ring-indigo-500/20">
                            @(editModel.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                    }
                </div>

                <label class="cursor-pointer px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-xs rounded-xl border border-indigo-200 transition">
                    📷 Choose Avatar Image
                    <InputFile OnChange="OnAvatarSelected" accept=".jpg,.jpeg,.png,.webp" class="hidden" />
                </label>
                @if (selectedAvatarFile != null)
                {
                    <span class="text-xs text-slate-500 font-medium">Selected: @selectedAvatarFile.Name</span>
                }
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Display Name *</label>
                    <input type="text" @bind="editModel.DisplayName" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition" placeholder="e.g. Alex Morgan" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Username *</label>
                    <input type="text" @bind="editModel.UserName" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition font-mono" placeholder="e.g. alex_morgan" />
                    <p class="text-[11px] text-slate-400 mt-1">Letters, numbers, and underscores only. Min 3, max 50 chars.</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Bio Summary</label>
                    <textarea @bind="editModel.Bio" rows="3" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition" placeholder="Tell the community about yourself..."></textarea>
                    <p class="text-[11px] text-slate-400 mt-1">Max 500 characters.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                    @editErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button @onclick="CloseEditModal" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Cancel
                </button>
                <button @onclick="SaveProfileAsync" disabled="@isSavingProfile" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-md shadow-indigo-600/30 flex items-center gap-2">
                    @if (isSavingProfile)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- RATE USER MODAL -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <span>⭐</span> Rate @profile?.DisplayName
                </h3>
                <button @onclick="CloseRatingModal" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>

            <div class="space-y-4 text-center">
                <p class="text-xs text-slate-600">Select a star rating from 1 to 5 stars:</p>

                <!-- Interactive Star Picker -->
                <div class="flex items-center justify-center gap-2 text-3xl cursor-pointer py-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starScore = i;
                        <span @onclick="() => ratingModel.Score = starScore" class="transition-transform hover:scale-125 @(i <= ratingModel.Score ? "text-amber-400" : "text-slate-200")">
                            ★
                        </span>
                    }
                </div>
                <div class="text-xs font-bold text-amber-600 uppercase tracking-wider">
                    @ratingModel.Score Star@(ratingModel.Score > 1 ? "s" : "")
                </div>

                <div class="text-left">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Optional Feedback Review</label>
                    <textarea @bind="ratingModel.ReviewText" rows="3" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition" placeholder="Share your experience working or interacting with this user..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button @onclick="CloseRatingModal" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Cancel
                </button>
                <button @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-md shadow-amber-500/30 flex items-center gap-2">
                    @if (isSubmittingRating)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Review</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserNameOrId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private UserProfileDto? profile;
    private bool isOwner;

    // Tabs
    private string activeTab = "posts";
    private bool isTabLoading;
    private List<UserPostItemDto> postsList = new();
    private List<UserPostItemDto> savedPostsList = new();
    private List<SavedAccountItemDto> savedAccountsList = new();
    private List<UserCommunityItemDto> communitiesList = new();
    private List<UserRatingItemDto> reviewsList = new();

    // Edit Profile Modal
    private bool showEditModal;
    private bool isSavingProfile;
    private string? editErrorMessage;
    private UpdateUserProfileRequestDto editModel = new();
    private IBrowserFile? selectedAvatarFile;
    private string? editAvatarPreview;

    // Save Account Action
    private bool isSavingAccount;

    // Rating Modal
    private bool showRatingModal;
    private bool isSubmittingRating;
    private string? ratingErrorMessage;
    private RateUserRequestDto ratingModel = new() { Score = 5 };

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            Result<UserProfileDto> res;
            if (string.IsNullOrWhiteSpace(UserNameOrId))
            {
                res = await ProfileApi.GetOwnerProfileAsync(_cts.Token);
            }
            else
            {
                res = await ProfileApi.GetPublicProfileAsync(UserNameOrId, _cts.Token);
            }

            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                isOwner = profile.Relationship.IsSelf || string.IsNullOrWhiteSpace(UserNameOrId);
                await SetTab("posts");
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load profile.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        if (profile == null) return;
        isTabLoading = true;
        try
        {
            switch (tab)
            {
                case "posts":
                    var pRes = await ProfileApi.GetUserPostsAsync(profile.UserId, _cts.Token);
                    if (pRes.IsSuccess && pRes.Data != null) postsList = pRes.Data;
                    break;
                case "saved-posts":
                    if (isOwner)
                    {
                        var spRes = await ProfileApi.GetSavedPostsAsync(_cts.Token);
                        if (spRes.IsSuccess && spRes.Data != null) savedPostsList = spRes.Data;
                    }
                    break;
                case "saved-accounts":
                    if (isOwner)
                    {
                        var saRes = await ProfileApi.GetSavedAccountsAsync(_cts.Token);
                        if (saRes.IsSuccess && saRes.Data != null) savedAccountsList = saRes.Data;
                    }
                    break;
                case "communities":
                    var cRes = await ProfileApi.GetUserCommunitiesAsync(profile.UserId, _cts.Token);
                    if (cRes.IsSuccess && cRes.Data != null) communitiesList = cRes.Data;
                    break;
                case "reviews":
                    var rRes = await ProfileApi.GetUserReviewsAsync(profile.UserId, _cts.Token);
                    if (rRes.IsSuccess && rRes.Data != null) reviewsList = rRes.Data;
                    break;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading tab: {ex.Message}");
        }
        finally
        {
            isTabLoading = false;
        }
    }

    // Toggle Save Account
    private async Task ToggleSaveAccountAsync()
    {
        if (profile == null || isOwner) return;
        isSavingAccount = true;
        try
        {
            var res = await ProfileApi.ToggleSaveAccountAsync(profile.UserId, _cts.Token);
            if (res.IsSuccess)
            {
                profile.Relationship.IsSavedByMe = res.Data;
                Toast.Success(res.Data ? "Saved account to bookmarks." : "Removed account from bookmarks.");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    // Edit Profile Modal Methods
    private void OpenEditModal()
    {
        if (profile == null) return;
        editModel = new UpdateUserProfileRequestDto
        {
            DisplayName = profile.DisplayName,
            UserName = profile.UserName,
            Bio = profile.Bio
        };
        editErrorMessage = null;
        selectedAvatarFile = null;
        editAvatarPreview = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        selectedAvatarFile = e.File;
        if (selectedAvatarFile != null)
        {
            var resized = await selectedAvatarFile.RequestImageFileAsync(selectedAvatarFile.ContentType, 300, 300);
            var buffer = new byte[resized.Size];
            await resized.OpenReadStream().ReadAsync(buffer);
            editAvatarPreview = $"data:{selectedAvatarFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private async Task SaveProfileAsync()
    {
        if (profile == null) return;
        isSavingProfile = true;
        editErrorMessage = null;
        try
        {
            // Upload Avatar first if selected
            if (selectedAvatarFile != null)
            {
                using var stream = selectedAvatarFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                var uploadRes = await ProfileApi.UploadAvatarAsync(stream, selectedAvatarFile.Name, selectedAvatarFile.ContentType, _cts.Token);
                if (!uploadRes.IsSuccess)
                {
                    editErrorMessage = uploadRes.Message;
                    isSavingProfile = false;
                    return;
                }
            }

            var updateRes = await ProfileApi.UpdateProfileAsync(editModel, _cts.Token);
            if (updateRes.IsSuccess && updateRes.Data != null)
            {
                profile = updateRes.Data;
                Toast.Success("Profile updated successfully!");
                showEditModal = false;
            }
            else
            {
                editErrorMessage = updateRes.Message;
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    // Rate User Modal Methods
    private void OpenRatingModal()
    {
        if (profile == null) return;
        ratingModel = new RateUserRequestDto
        {
            Score = profile.Relationship.MyRatingScore ?? 5,
            ReviewText = profile.Relationship.MyReviewText
        };
        ratingErrorMessage = null;
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
    }

    private async Task SubmitRatingAsync()
    {
        if (profile == null) return;
        isSubmittingRating = true;
        ratingErrorMessage = null;
        try
        {
            var res = await ProfileApi.RateUserAsync(profile.UserId, ratingModel, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                Toast.Success("Rating and review submitted!");
                showRatingModal = false;
                if (activeTab == "reviews") await SetTab("reviews");
            }
            else
            {
                ratingErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ratingErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
