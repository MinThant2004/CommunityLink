    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            Result<UserProfileDto> res;
            if (string.IsNullOrWhiteSpace(UserNameOrId))
            {
                res = await ProfileApi.GetOwnerProfileAsync(_cts.Token);
            }
            else
            {
                res = await ProfileApi.GetPublicProfileAsync(UserNameOrId, _cts.Token);
            }

            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                isOwner = profile.Relationship.IsSelf || string.IsNullOrWhiteSpace(UserNameOrId);
                // Fetch communities for the Affiliated Hubs widget
                try
                {
                    var commRes = await ProfileApi.GetUserCommunitiesAsync(profile.UserId, _cts.Token);
                    if (commRes.IsSuccess && commRes.Data != null)
                    {
                        communitiesList = commRes.Data;
                    }
                }
                catch { }

                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var defaultTab = "posts";
                if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tabVal))
                {
                    var tabStr = tabVal.ToString().ToLowerInvariant();
                    if (!string.IsNullOrWhiteSpace(tabStr))
                    {
                        defaultTab = tabStr;
                    }
                }
                await SetTab(defaultTab);

                if (!isOwner)
                {
                    await LoadPrivateChatStatusAsync();
                }
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load profile.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

