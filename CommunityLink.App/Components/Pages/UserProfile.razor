        try
        {
            var res = await PostApi.LikePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                var targetPost = postsList.FirstOrDefault(p => p.PostId == postId) ?? savedPostsList.FirstOrDefault(p => p.PostId == postId);
                if (targetPost != null)
                {
                    targetPost.IsLikedByCurrentUser = !targetPost.IsLikedByCurrentUser;
                    targetPost.LikeCount += targetPost.IsLikedByCurrentUser ? 1 : -1;
                    if (targetPost.LikeCount < 0) targetPost.LikeCount = 0;
                    StateHasChanged();
                }
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private async Task ToggleProfileCommentBox(int postId)
    {
        if (openProfileCommentPostIds.Contains(postId))
        {
            openProfileCommentPostIds.Remove(postId);
            return;
        }

        openProfileCommentPostIds.Add(postId);
        if (!profileCommentInputs.ContainsKey(postId))
        {
            profileCommentInputs[postId] = string.Empty;
        }

        if (!profileCommentsByPost.ContainsKey(postId))
        {
            try
            {
                var res = await PostApi.GetCommentsAsync(postId, _cts.Token);
                if (res.IsSuccess && res.Data != null)
                {
                    profileCommentsByPost[postId] = res.Data;
                }
            }
            catch { }
        }
    }

    private async Task SubmitProfileCommentAsync(int postId)
    {
        if (!profileCommentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        try
        {
            var req = new CreateCommentRequestModel(postId, content.Trim());
            var res = await PostApi.AddCommentAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                profileCommentInputs[postId] = string.Empty;
                var commentsRes = await PostApi.GetCommentsAsync(postId, _cts.Token);
                if (commentsRes.IsSuccess && commentsRes.Data != null)
                {
                    profileCommentsByPost[postId] = commentsRes.Data;
                }
                var targetPost = postsList.FirstOrDefault(p => p.PostId == postId) ?? savedPostsList.FirstOrDefault(p => p.PostId == postId);
                if (targetPost != null)
                {
                    targetPost.CommentCount += 1;
                }
                Toast.Success("Comment posted!");
                StateHasChanged();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to post comment: {ex.Message}");
        }
    }

    private void OpenProfileShareModal(int postId)
    {
        profileSharingPostId = postId;
        profileShareNoteText = string.Empty;
        showProfileShareModal = true;
    }

    private void CloseProfileShareModal()
    {
        showProfileShareModal = false;
        profileSharingPostId = null;
        profileShareNoteText = string.Empty;
    }

    private async Task SubmitProfileSharePostAsync()
    {
        if (!profileSharingPostId.HasValue) return;

        isSharingProfilePost = true;
        try
        {
            var req = new SharePostRequestModel(
                string.IsNullOrWhiteSpace(profileShareNoteText) ? null : profileShareNoteText.Trim(),
                null
            );

            var res = await PostApi.SharePostAsync(profileSharingPostId.Value, req, _cts.Token);
            if (res.IsSuccess)
            {
                var targetPost = postsList.FirstOrDefault(p => p.PostId == profileSharingPostId.Value) ?? savedPostsList.FirstOrDefault(p => p.PostId == profileSharingPostId.Value);
                if (targetPost != null)
                {
                    targetPost.ShareCount += 1;
                }
                Toast.Success("Post shared successfully!");
                CloseProfileShareModal();
                if (profile != null)
                {
                    var pRes = await ProfileApi.GetUserPostsAsync(profile.UserId, _cts.Token);
                    if (pRes.IsSuccess && pRes.Data != null) postsList = pRes.Data;
                    if (isOwner)
                    {
                        var spRes = await ProfileApi.GetSavedPostsAsync(_cts.Token);
                        if (spRes.IsSuccess && spRes.Data != null) savedPostsList = spRes.Data;
                    }
                }
                StateHasChanged();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to share post: {ex.Message}");
        }
        finally
        {
            isSharingProfilePost = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
