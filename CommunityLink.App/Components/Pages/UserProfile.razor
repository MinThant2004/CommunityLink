        <div class="bg-white rounded-lg shadow-2xl border border-[#E2E8F0] max-w-md w-full p-6 space-y-4 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <h3 class="prof-display text-base font-bold text-[#0A1B2E]">Rate @profile?.DisplayName</h3>
