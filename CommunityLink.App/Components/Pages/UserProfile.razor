@page "/profile"
@page "/u/{UserNameOrId}"
@attribute [Authorize]
@implements IDisposable
@using System.IO
@inject UserProfileApiService ProfileApi
@inject PostApiService PostApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ChatApiService ChatApi
@inject LinkDropApiService LinkDropApi
@inject IWebHostEnvironment Environment
@using System.Text.Json
@using CommunityLink.Shared.Features.Post

<PageTitle>@(profile != null ? $"{profile.DisplayName} (@{profile.UserName}) — CommunityLink" : "User Profile — CommunityLink")</PageTitle>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />

<style>
    .font-display { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif; letter-spacing: -0.025em; }
    .font-body    { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .font-mono    { font-family: 'JetBrains Mono', monospace; }

    /* Executive Dual Theme Tokens */
    :root {
        --prof-bg: #F8FAFC;
        --prof-text: #0A1B2E;
        --prof-muted: #64748B;
        --prof-card-bg: #FFFFFF;
        --prof-card-border: #E2E8F0;
        --prof-recessed-bg: #F1F5F9;
        --prof-recessed-border: #E2E8F0;
    }

    html.dark, :root.dark {
        --prof-bg: #10131A;
        --prof-text: #E1E8F0;
        --prof-muted: #7A8CA6;
        --prof-card-bg: #112A46;
        --prof-card-border: rgba(196, 210, 225, 0.12);
        --prof-recessed-bg: #1B3B5A;
        --prof-recessed-border: rgba(196, 210, 225, 0.15);
    }

    .prof-canvas {
        font-family: 'Inter', sans-serif;
        color: var(--prof-text);
        background-color: var(--prof-bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Executive Card Specification */
    .card-executive {
        background-color: var(--prof-card-bg);
        border: 1px solid var(--prof-card-border);
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }
    .dark .card-executive {
        box-shadow: none;
    }
    .card-executive:hover {
        border-color: #CBD5E1;
    }
    .dark .card-executive:hover {
        border-color: rgba(196, 210, 225, 0.35);
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.05);
    }

    /* Recessed Panel Specification */
    .panel-recessed {
        background-color: var(--prof-recessed-bg);
        border: 1px solid var(--prof-recessed-border);
        border-radius: 0.375rem;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    /* Buttons */
    .btn-exec-primary {
        background-color: #0A1B2E;
        color: #FFFFFF !important;
        border: 1px solid #0A1B2E;
        border-radius: 0.25rem;
        padding: 0.45rem 0.95rem;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-exec-primary:hover:not(:disabled) {
        background-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px -2px rgba(10, 27, 46, 0.18);
    }
    .dark .btn-exec-primary {
        background-color: #E1E8F0;
        color: #0A1B2E !important;
        border-color: #E1E8F0;
    }
    .dark .btn-exec-primary:hover:not(:disabled) {
        background-color: #FFFFFF;
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.25);
    }

    .btn-exec-secondary {
        background-color: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #0A1B2E !important;
        border-radius: 0.25rem;
        padding: 0.45rem 0.85rem;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.18s ease;
        cursor: pointer;
        text-decoration: none;
    }
    .btn-exec-secondary:hover {
        background-color: #F1F5F9;
        border-color: #CBD5E1;
    }
    .dark .btn-exec-secondary {
        background-color: #112A46;
        border-color: rgba(196, 210, 225, 0.20);
        color: #E1E8F0 !important;
    }
    .dark .btn-exec-secondary:hover {
        background-color: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.40);
    }

    /* Chips */
    .chip-standard {
        background-color: #F1F5F9;
        border: 1px solid #E2E8F0;
        color: #334155;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .dark .chip-standard {
        background-color: rgba(27, 59, 90, 0.6);
        border-color: rgba(196, 210, 225, 0.2);
        color: #C4D2E1;
    }
    .chip-standard:hover {
        border-color: #CBD5E1;
        background-color: #E2E8F0;
    }
    .dark .chip-standard:hover {
        background-color: #1B3B5A;
        color: #FFFFFF;
    }

    .chip-active {
        background-color: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #FFFFFF !important;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        box-shadow: 0 1px 4px rgba(10, 27, 46, 0.12);
        cursor: pointer;
    }
    .dark .chip-active {
        background-color: #E1E8F0;
        border-color: #E1E8F0;
        color: #0A1B2E !important;
    }

    .prof-code-block {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        border-radius: 0.375rem;
        border: 1px solid #30363d;
        overflow-x: auto;
    }
</style>

<div class="prof-canvas min-h-screen pb-12">
    @if (isLoading)
    {
        <div class="pt-24 pb-16 text-center max-w-sm mx-auto">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-[#0A1B2E] dark:border-white border-t-transparent"></div>
            <h3 class="font-display mt-3 text-sm font-bold text-[#0A1B2E] dark:text-white">Synchronizing Credentials</h3>
            <p class="font-mono mt-1 text-[11px] text-[#64748B] dark:text-[#7A8CA6]">LOADING EXECUTIVE DOSSIER...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="pt-12 max-w-xl mx-auto px-4">
            <div class="p-4 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 rounded-[0.5rem] text-rose-800 dark:text-rose-300 flex items-center justify-between gap-3 shadow-sm">
                <div>
                    <h3 class="font-display font-bold text-xs">Unable to load profile</h3>
                    <p class="text-[11px] text-rose-600 dark:text-rose-400 mt-0.5">@errorMessage</p>
                </div>
                <button @onclick="LoadProfileAsync" class="btn-exec-primary text-xs py-1 px-3">
                    Retry
                </button>
            </div>
        </div>
    }
    else if (profile != null)
    {
        <div class="flex flex-col w-full">
            
            <!-- ================= COMPACT AMBIENT BACKDROP ================= -->
            <div class="relative w-full overflow-hidden bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="absolute inset-0 pointer-events-none opacity-25">
                    <svg class="w-full h-full" height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern height="32" id="prof-grid-pattern" patternUnits="userSpaceOnUse" width="32">
                                <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(196, 210, 225, 0.12)" stroke-width="1"></path>
                            </pattern>
                            <radialGradient cx="75%" cy="30%" id="prof-aura" r="60%">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25"></stop>
                                <stop offset="60%" stop-color="#1e3a8a" stop-opacity="0.10"></stop>
                                <stop offset="100%" stop-color="#0A1B2E" stop-opacity="0"></stop>
                            </radialGradient>
                        </defs>
                        <rect fill="url(#prof-grid-pattern)" height="100%" width="100%"></rect>
                        <rect fill="url(#prof-aura)" height="100%" width="100%"></rect>
                    </svg>
                </div>

                <div class="h-28 sm:h-36 max-w-[1400px] mx-auto px-4 sm:px-6 relative flex items-end justify-between pb-3">
                    <div class="hidden sm:flex items-center gap-2 font-mono text-[10px] text-[#7A8CA6] tracking-wider uppercase">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>NODE #@(profile.UserId) // SYNCHRONIZED</span>
                    </div>
                    <div class="ml-auto flex items-center gap-2">
                        <span class="font-mono text-[10px] font-semibold px-2.5 py-0.5 rounded-[0.25rem] bg-[#1B3B5A]/90 text-[#C4D2E1] border border-[rgba(196,210,225,0.15)]">
                            @(profile.IsVerified ? "TIER 0 // VERIFIED FELLOW" : (profile.Role?.RoleName?.ToUpper() == "ADMIN" ? "GOVERNOR" : "MEMBER"))
                        </span>
                    </div>
                </div>
            </div>

            <!-- ================= PRIMARY PROFILE CONTAINER ================= -->
            <div class="max-w-[1400px] w-full mx-auto px-4 sm:px-6 -mt-10 sm:-mt-14 z-10 relative space-y-4">

                <!-- 1. Primary Header Card -->
                <div class="card-executive p-5 sm:p-6 space-y-5">
                    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5">
                        
                        <!-- Left: Avatar & Identity -->
                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start">
                            
                            <!-- Avatar Stack -->
                            <div class="relative shrink-0 group">
                                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden shadow-md bg-[#1B3B5A] ring-2 ring-white dark:ring-[#112A46] relative">
                                    @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                                    {
                                        <img alt="@profile.DisplayName" class="w-full h-full object-cover" src="@profile.AvatarUrl" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-[#0A1B2E] via-[#1E3A5F] to-[#2563EB] text-white flex items-center justify-center font-bold text-2xl font-mono">
                                            @(string.IsNullOrWhiteSpace(profile.DisplayName) ? "U" : profile.DisplayName.Substring(0, 1).ToUpper())
                                        </div>
                                    }

                                    @if (isUploadingAvatar)
                                    {
                                        <div class="absolute inset-0 bg-black/60 backdrop-blur-xs flex flex-col items-center justify-center text-white">
                                            <div class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                            <span class="text-[9px] font-mono mt-1">Uploading...</span>
                                        </div>
                                    }
                                    else if (isOwner)
                                    {
                                        <label for="directAvatarUpload" class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center text-white cursor-pointer" title="Upload new photo">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <span class="text-[9px] font-semibold mt-0.5">Change</span>
                                        </label>
                                    }
                                </div>

                                @if (isOwner)
                                {
                                    <label for="directAvatarUpload" class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-blue-600 hover:bg-blue-700 text-white ring-2 ring-white dark:ring-[#112A46] flex items-center justify-center shadow-md cursor-pointer transition z-10" title="Upload profile photo">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    </label>
                                    <InputFile id="directAvatarUpload" OnChange="HandleAvatarUploadAsync" accept=".jpg,.jpeg,.png,.webp" class="hidden" disabled="@isUploadingAvatar" />
                                }
                                else
                                {
                                    <!-- Online Status Pip -->
                                    <span class="absolute bottom-0.5 right-1 w-4 h-4 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-[#112A46] flex items-center justify-center" title="Online & Active">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-[#0A1B2E]"></span>
                                    </span>
                                }
                            </div>

                            <!-- Name, Badges, Headline & Metadata -->
                            <div class="space-y-1.5 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h1 class="font-display text-xl sm:text-2xl font-extrabold text-[#0A1B2E] dark:text-white tracking-tight">
                                        @(string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.UserName : profile.DisplayName)
                                    </h1>

                                    <!-- Verified Tier Badge -->
                                    @if (profile.Role?.RoleCode == "PUBLIC_FIGURE")
                                    {
                                        <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded-[0.25rem] bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border border-purple-300 dark:border-purple-700 inline-flex items-center gap-1 uppercase tracking-wider shadow-sm">
                                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                                            <span>PUBLIC FIGURE VIP</span>
                                        </span>
                                    }
                                    else if (profile.Role?.RoleCode == "DOMAIN_PRO" || profile.IsVerified)
                                    {
                                        <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded-[0.25rem] bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/60 inline-flex items-center gap-1 uppercase tracking-wider shadow-sm">
                                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                            <span>DOMAIN PROFESSIONAL</span>
                                        </span>
                                    }
                                    else if (profile.Role?.RoleCode == "ADMIN" || profile.Role?.RoleCode == "SUPER_ADMIN")
                                    {
                                        <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded-[0.25rem] bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 inline-flex items-center gap-1 uppercase tracking-wider">
                                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                            <span>GOVERNOR</span>
                                        </span>
                                    }

                                    <!-- Pronouns -->
                                    @if (!string.IsNullOrWhiteSpace(profile.Pronouns))
                                    {
                                        <span class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] px-1.5 py-0.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] uppercase">
                                            @profile.Pronouns
                                        </span>
                                    }
                                </div>

                                <!-- Headline -->
                                @if (!string.IsNullOrWhiteSpace(profile.Headline))
                                {
                                    <p class="font-body text-xs sm:text-sm font-semibold text-[#334155] dark:text-[#C4D2E1] leading-snug">
                                        @profile.Headline
                                    </p>
                                }

                                <!-- Metadata Row -->
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[#64748B] dark:text-[#7A8CA6] pt-0.5">
                                    <span class="font-mono font-semibold text-[#0A1B2E] dark:text-white">@@@profile.UserName</span>
                                    @if (!string.IsNullOrWhiteSpace(profile.Location))
                                    {
                                        <span>•</span>
                                        <span class="inline-flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                            <span>@profile.Location</span>
                                        </span>
                                    }
                                    @if (profile.IsVerified)
                                    {
                                        <span>•</span>
                                        <span class="font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                            <span>CREDENTIAL AUDITED</span>
                                        </span>
                                    }
                                </div>

                                <!-- Bio -->
                                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                                {
                                    <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed max-w-2xl pt-1">
                                        @profile.Bio
                                    </p>
                                }
                            </div>

                        </div>

                        <!-- Right: Action Buttons -->
                        <div class="flex flex-col items-start lg:items-end gap-2 shrink-0 w-full lg:w-auto">
                            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                                @if (!isOwner)
                                {
                                    <button type="button" @onclick="ToggleFollowUserAsync" disabled="@isTogglingFollow" class="btn-exec-secondary @(profile.Relationship.IsFollowedByMe ? "border-primary text-primary dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40" : "")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="@(profile.Relationship.IsFollowedByMe ? "M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6" : "M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z")"></path></svg>
                                        <span>@(profile.Relationship.IsFollowedByMe ? "Following" : "Follow")</span>
                                    </button>

                                    <button type="button" @onclick="HandleProfileMessageClick" class="btn-exec-primary">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                        @if (isPaidChatEnabled && privateChatFeeLinkDrops > 0)
                                        {
                                            <span class="inline-flex items-center gap-1.5">
                                                <span>Chat</span>
                                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0 inline" />
                                                <span>@privateChatFeeLinkDrops.ToString("N0") Drops</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Send Message</span>
                                        }
                                    </button>

                                    <button @onclick="ToggleSaveAccountAsync" disabled="@isSavingAccount" class="btn-exec-secondary @(profile.Relationship.IsSavedByMe ? "border-amber-400 text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40" : "")">
                                        <svg class="w-3.5 h-3.5" fill="@(profile.Relationship.IsSavedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                                        <span>@(profile.Relationship.IsSavedByMe ? "Saved" : "Save")</span>
                                    </button>

                                    <button @onclick="OpenRatingModal" class="btn-exec-secondary text-amber-600 dark:text-amber-400">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                        <span>@(profile.Relationship.HasRated ? "Edit Review" : "Rate")</span>
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="OpenEditModal" class="btn-exec-primary">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                        <span>Edit Profile</span>
                                    </button>
                                }

                                <button @onclick="ShareProfile" class="btn-exec-secondary px-2.5" title="Copy Profile Link">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                </button>
                            </div>

                            <!-- Availability Status -->
                            <div class="flex items-center gap-1.5 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider pt-0.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                <span>@(string.IsNullOrWhiteSpace(profile.AvailabilityStatus) ? "ACCEPTING DIRECT ENGAGEMENTS" : profile.AvailabilityStatus)</span>
                            </div>
                        </div>

                    </div>

                    <!-- 4-Stat Analytical Strip (Section 6.5) -->
                    <div class="panel-recessed p-2.5 sm:p-3 grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 divide-y sm:divide-y-0 sm:divide-x divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                        <button type="button" @onclick='() => SetTab("followers")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @(profile.Metrics.FollowersCount >= 1000 ? (profile.Metrics.FollowersCount / 1000.0).ToString("0.0k") : profile.Metrics.FollowersCount.ToString("N0"))
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">FOLLOWERS</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("following")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.FollowingCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">FOLLOWING</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("posts")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.PostsCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">PUBLISHED GUIDES</div>
                        </button>

                        <button type="button" @onclick='() => SetTab("communities")' class="text-left px-2 sm:px-3 py-1 group">
                            <div class="font-display text-lg sm:text-xl font-bold text-[#0A1B2E] dark:text-white group-hover:text-blue-600 transition">
                                @profile.Metrics.JoinedCommunitiesCount.ToString("N0")
                            </div>
                            <div class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">SUB-COMMUNITIES LED</div>
                        </button>
                    </div>

                </div>

                <!-- 2. Analytical Reputation Scorecard Card -->
                <div class="card-executive p-4 sm:p-5">
                    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5">
                        
                        <!-- Left: Score & Distribution Cluster -->
                        <div class="flex items-center gap-5 sm:gap-6 shrink-0">
                            <!-- Score Block -->
                            <div class="flex flex-col items-center justify-center p-3 rounded-[0.375rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] w-24 h-24">
                                <span class="font-display text-3xl font-extrabold text-[#D97706] dark:text-[#FBBF24] leading-none">
                                    @(profile.Metrics.AverageRating.HasValue && profile.Metrics.AverageRating.Value > 0 ? profile.Metrics.AverageRating.Value.ToString("0.0") : "0.0")
                                </span>
                                <div class="text-amber-500 text-xs flex items-center gap-0.5 mt-1">
                                    @{
                                        int scoreStars = (int)Math.Round(profile.Metrics.AverageRating ?? 0);
                                    }
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <svg class="w-3 h-3 @(i < scoreStars ? "text-amber-500" : "text-slate-300 dark:text-slate-700")" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    }
                                </div>
                                <span class="font-mono text-[10px] font-semibold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mt-0.5">
                                    @(profile.Metrics.RatingCount > 0 ? $"{profile.Metrics.RatingCount} RATINGS" : "0 RATINGS")
                                </span>
                            </div>

                            <!-- 5-Star Distribution Bar Graph -->
                            <div class="flex flex-col space-y-1 w-44 sm:w-56 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right inline-flex items-center justify-end gap-0.5">5 <svg class="w-2.5 h-2.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500 rounded-full" style="width: @(profile.RatingDistribution?.Star5Percentage ?? 0)%;"></div>
                                    </div>
                                    <span class="w-7 text-right text-[#0A1B2E] dark:text-white font-semibold">@(profile.RatingDistribution?.Star5Percentage ?? 0)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right inline-flex items-center justify-end gap-0.5">4 <svg class="w-2.5 h-2.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/80 rounded-full" style="width: @(profile.RatingDistribution?.Star4Percentage ?? 0)%;"></div>
                                    </div>
                                    <span class="w-7 text-right text-[#0A1B2E] dark:text-white font-semibold">@(profile.RatingDistribution?.Star4Percentage ?? 0)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right inline-flex items-center justify-end gap-0.5">3 <svg class="w-2.5 h-2.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/50 rounded-full" style="width: @(profile.RatingDistribution?.Star3Percentage ?? 0)%;"></div>
                                    </div>
                                    <span class="w-7 text-right">@(profile.RatingDistribution?.Star3Percentage ?? 0)%</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-6 text-right inline-flex items-center justify-end gap-0.5">2 <svg class="w-2.5 h-2.5 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
                                    <div class="flex-1 h-1.5 bg-[#E2E8F0] dark:bg-[#1B3B5A] rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-500/30 rounded-full" style="width: @(profile.RatingDistribution?.Star2Percentage ?? 0)%;"></div>
                                    </div>
                                    <span class="w-7 text-right">@(profile.RatingDistribution?.Star2Percentage ?? 0)%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: SLA Metric Chips -->
                        <div class="flex flex-wrap items-center gap-2.5 flex-1 lg:justify-end">
                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] @(profile.IsVerified ? "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-500") flex items-center justify-center text-xs shrink-0">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                </span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">@(profile.IsVerified ? "Verified Member" : "Active Member")</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">@(profile.Metrics.RatingCount > 0 ? $"{profile.Metrics.RatingCount} peer ratings" : "No peer ratings yet")</div>
                                </div>
                            </div>

                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs shrink-0">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">@(!string.IsNullOrWhiteSpace(profile.ResponseSlaText) ? profile.ResponseSlaText : (profile.IsOnline ? "Active Now" : "Standard Dispatch"))</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">Member Response Status</div>
                                </div>
                            </div>

                            <div class="px-3 py-2 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-[0.25rem] bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs shrink-0">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                                </span>
                                <div>
                                    <div class="font-body text-xs font-bold text-[#0A1B2E] dark:text-white">@(string.IsNullOrWhiteSpace(profile.PercentileBadgeText) ? (profile.IsVerified ? "Audited Node" : "Standard Contributor") : profile.PercentileBadgeText)</div>
                                    <div class="font-body text-[10px] text-[#64748B] dark:text-[#7A8CA6]">Reputation Tier</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 3. Navigation Tabs Filter Strip -->
                <div class="card-executive p-2 flex items-center justify-between overflow-x-auto">
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button @onclick='() => SetTab("posts")' class="@(activeTab == "posts" ? "chip-active" : "chip-standard")">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                            <span>POSTS &amp; POLLS</span>
                        </button>

                        <button @onclick='() => SetTab("reviews")' class="@(activeTab == "reviews" ? "chip-active" : "chip-standard")">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <span>REVIEWS (@(profile.Metrics.RatingCount))</span>
                        </button>

                        <button @onclick='() => SetTab("communities")' class="@(activeTab == "communities" ? "chip-active" : "chip-standard")">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                            <span>COMMUNITIES (@(profile.Metrics.JoinedCommunitiesCount))</span>
                        </button>

                        @if (isOwner)
                        {
                            <button @onclick='() => SetTab("saved-posts")' class="@(activeTab == "saved-posts" ? "chip-active" : "chip-standard")">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                <span>SAVED (@savedPostsList.Count)</span>
                            </button>
                        }

                        <button @onclick='() => SetTab("followers")' class="@(activeTab == "followers" ? "chip-active" : "chip-standard")">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>FOLLOWERS</span>
                        </button>

                        @if (isOwner)
                        {
                            <button @onclick='() => SetTab("recycle-bin")' class="@(activeTab == "recycle-bin" ? "chip-active" : "chip-standard")">
                                <svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                <span>RECYCLE BIN (@recycledPostsList.Count)</span>
                            </button>
                        }
                    </div>

                    <div class="hidden sm:flex items-center gap-1 shrink-0 ml-4 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                        <span>FILTER:</span>
                        <span class="px-2 py-0.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-white font-semibold">LATEST</span>
                    </div>
                </div>

                <!-- 4. Main 12-Column Desktop Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
                    
                    <!-- Left Column: Primary Content (8 Cols) -->
                    <div class="lg:col-span-8 space-y-4">
                        
                        @if (isTabLoading)
                        {
                            <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-[#0A1B2E] dark:border-white border-t-transparent mb-2"></div>
                                <p class="font-mono text-[10px] tracking-wider uppercase">SYNCHRONIZING TAB DATA...</p>
                            </div>
                        }
                        else if (activeTab == "posts")
                        {
                            @if (!postsList.Any())
                            {
                                <div class="card-executive py-12 text-center">
                                    <svg class="w-8 h-8 text-slate-400 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                    <p class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white mt-2">No publications found</p>
                                    <p class="text-[11px] text-[#64748B] dark:text-[#7A8CA6] mt-0.5">Technical guides, memos, and active polls will appear here.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var post in postsList)
                                {
                                    <article class="card-executive p-4 sm:p-5 space-y-3">
                                        @if (!string.IsNullOrWhiteSpace(post.SharedByUserName))
                                        {
                                            <div class="flex items-center gap-1.5 text-xs text-[#64748B] dark:text-[#7A8CA6] font-medium pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                                <span>Shared by <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@(post.SharedByDisplayName ?? post.SharedByUserName)</span></span>
                                                @if (post.SharedAt.HasValue)
                                                {
                                                    <span class="text-[10px] text-[#7A8CA6] font-mono">• @post.SharedAt.Value.ToString("g")</span>
                                                }
                                            </div>
                                        }
                                        <!-- Post Meta Header -->
                                        <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                            <div class="flex items-center gap-2.5">
                                                @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                                                {
                                                    <img alt="@post.AuthorDisplayName" class="w-8 h-8 rounded-full object-cover" src="@post.AuthorAvatarUrl" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs font-mono">
                                                        @(string.IsNullOrWhiteSpace(post.AuthorDisplayName) ? "U" : post.AuthorDisplayName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                                <div>
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-xs font-bold text-[#0A1B2E] dark:text-white">@post.AuthorDisplayName</span>
                                                        <span class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">@@@post.AuthorUserName</span>
                                                    </div>
                                                    <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                        @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                                        {
                                                            <span>@post.CommunityName • </span>
                                                        }
                                                        <span>@post.CreatedAt.ToString("g")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (post.HasPoll)
                                            {
                                                <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded-[0.25rem] bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                                                    POLL
                                                </span>
                                            }
                                        </div>

                                        <!-- Title & Body -->
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(post.Title))
                                            {
                                                <h3 class="font-display text-sm sm:text-base font-bold text-[#0A1B2E] dark:text-white">
                                                    @post.Title
                                                </h3>
                                            }
                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] mt-1 whitespace-pre-line leading-relaxed">
                                                @post.Content
                                            </p>
                                        </div>

                                        <!-- Interactive Poll -->
                                        @if (post.HasPoll && post.Poll != null && post.Poll.Options.Any())
                                        {
                                            <div class="space-y-1.5 pt-1">
                                                <div class="font-mono text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                                                    QUESTION: @post.Poll.Question
                                                </div>
                                                <div class="space-y-1.5">
                                                    @foreach (var opt in post.Poll.Options)
                                                    {
                                                        <button type="button" @onclick="() => VotePollAsync(post.Poll.PollId, opt.OptionId)" class="w-full relative flex items-center justify-between p-2.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/50 hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] cursor-pointer transition text-left border @(opt.IsSelectedByMe ? "border-blue-500" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]") overflow-hidden">
                                                            <div class="absolute inset-y-0 left-0 bg-blue-100 dark:bg-blue-900/30 transition-all" style="width: @(opt.VotePercentage)%;"></div>
                                                            <span class="relative z-10 text-xs font-semibold text-[#0A1B2E] dark:text-white flex items-center gap-1.5">
                                                                @if (opt.IsSelectedByMe) { <span class="text-blue-600 font-bold">✓</span> }
                                                                <span>@opt.OptionText</span>
                                                            </span>
                                                            <span class="relative z-10 font-mono text-[11px] font-bold text-blue-700 dark:text-blue-300">
                                                                @opt.VotePercentage% (@opt.VoteCount)
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                                <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] pt-0.5">
                                                    TOTAL VOTES: @post.Poll.TotalVotes • @(post.Poll.HasVoted ? "PARTICIPATED" : "CLICK OPTION TO VOTE")
                                                </div>
                                            </div>
                                        }

                                        <!-- Code Snippet / Text Files -->
                                        @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                        {
                                            var textFiles = ParseProfileTextFiles(post.CodeSnippet, post.CodeFileName);
                                            if (textFiles.Count > 1)
                                            {
                                                <div class="mt-2 space-y-1.5">
                                                    <div class="text-[11px] font-semibold text-[#64748B] dark:text-[#7A8CA6] flex items-center gap-1">
                                                        <span>📎 Attached Text Files (@textFiles.Count):</span>
                                                    </div>
                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                        @foreach (var tf in textFiles)
                                                        {
                                                            <button type="button" @onclick="() => OpenProfileTextFileModal(tf.FileName, tf.Content)"
                                                                    class="flex items-center justify-between p-3 rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] bg-[#F8FAFC] dark:bg-[#0A1B2E] hover:border-[#0A1B2E] dark:hover:border-white transition text-left cursor-pointer group shadow-2xs">
                                                                <div class="flex items-center gap-2.5 min-w-0">
                                                                    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm shrink-0">
                                                                        📄
                                                                    </div>
                                                                    <div class="min-w-0">
                                                                        <p class="font-mono text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0] truncate group-hover:text-emerald-600 dark:group-hover:text-emerald-400">@tf.FileName</p>
                                                                        <p class="font-mono text-[10px] text-[#7A8CA6]">@(tf.Content.Length) chars • Click to read</p>
                                                                    </div>
                                                                </div>
                                                                <span class="text-xs text-[#7A8CA6] group-hover:translate-x-0.5 transition font-bold ml-2">↗</span>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                var single = textFiles.FirstOrDefault() ?? new AttachedTextFileItem(post.CodeFileName ?? "attachment.txt", post.CodeSnippet);
                                                <div class="prof-code-block p-3 space-y-1.5 mt-2">
                                                    <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                                        <button type="button" @onclick="() => OpenProfileTextFileModal(single.FileName, single.Content)"
                                                                class="font-bold text-emerald-400 font-mono hover:underline flex items-center gap-1 cursor-pointer">
                                                            <span>📄 @single.FileName</span>
                                                            <span class="text-gray-400 font-normal text-[9px]">(Click to expand)</span>
                                                        </button>
                                                        <span class="font-mono">TEXT</span>
                                                    </div>
                                                    <div class="overflow-x-auto overflow-y-auto max-h-72 text-[11px] leading-relaxed">
                                                        <pre class="whitespace-pre font-mono"><code>@single.Content</code></pre>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        <!-- Embedded Original Post for Shared Posts -->
                                        @if (post.OriginalPost != null)
                                        {
                                            <div class="mt-3 p-3.5 rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] bg-[#F8FAFC] dark:bg-[#0A1B2E]/70 space-y-2.5">
                                                <div class="flex items-center gap-2 pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                                                    @if (!string.IsNullOrWhiteSpace(post.OriginalPost.AuthorAvatarUrl))
                                                    {
                                                        <img src="@post.OriginalPost.AuthorAvatarUrl" alt="@post.OriginalPost.AuthorDisplayName" class="w-7 h-7 rounded-full object-cover ring-1 ring-[#CBD5E1]" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-7 h-7 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] font-bold text-[11px] flex items-center justify-center font-mono">
                                                            @(string.IsNullOrWhiteSpace(post.OriginalPost.AuthorDisplayName) ? "U" : post.OriginalPost.AuthorDisplayName.Substring(0, 1).ToUpper())
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="flex items-center gap-1.5">
                                                            <a href="u/@(string.IsNullOrWhiteSpace(post.OriginalPost.AuthorUserName) ? post.OriginalPost.AuthorDisplayName : post.OriginalPost.AuthorUserName)" class="font-bold text-xs text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline">
                                                                @post.OriginalPost.AuthorDisplayName
                                                            </a>
                                                            @if (!string.IsNullOrWhiteSpace(post.OriginalPost.CommunityName))
                                                            {
                                                                <span class="text-[10px] text-[#7A8CA6] font-mono">• @post.OriginalPost.CommunityName</span>
                                                            }
                                                        </div>
                                                        <span class="text-[10px] text-[#7A8CA6] font-mono">@post.OriginalPost.CreatedAt.ToString("g")</span>
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(post.OriginalPost.Content))
                                                {
                                                    <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed whitespace-pre-line">
                                                        @post.OriginalPost.Content
                                                    </p>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(post.OriginalPost.CodeSnippet))
                                                {
                                                    var origFiles = ParseProfileTextFiles(post.OriginalPost.CodeSnippet, post.OriginalPost.CodeFileName);
                                                    var singleOrig = origFiles.FirstOrDefault() ?? new AttachedTextFileItem(post.OriginalPost.CodeFileName ?? "attachment.txt", post.OriginalPost.CodeSnippet);
                                                    <div class="prof-code-block p-2.5 space-y-1 text-xs">
                                                        <div class="flex items-center justify-between pb-1 border-b border-gray-800 text-[10px] text-gray-400">
                                                            <span class="font-bold text-emerald-400 font-mono">📄 @singleOrig.FileName</span>
                                                            <span class="font-mono">TEXT</span>
                                                        </div>
                                                        <div class="overflow-x-auto overflow-y-auto max-h-48 text-[11px] leading-relaxed">
                                                            <pre class="whitespace-pre font-mono"><code>@singleOrig.Content</code></pre>
                                                        </div>
                                                    </div>
                                                }

                                                @if (post.OriginalPost.ImageUrls != null && post.OriginalPost.ImageUrls.Any())
                                                {
                                                    <div class="rounded-lg overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#0d1117] max-h-60 flex items-center justify-center">
                                                        <img src="@post.OriginalPost.ImageUrls.First()" alt="Original attachment" class="w-full h-full object-contain max-h-60" />
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Diagram Image -->
                                        @if (!string.IsNullOrWhiteSpace(post.DiagramImageUrl))
                                        {
                                            <div class="rounded-[0.375rem] overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-slate-950 mt-2">
                                                <img class="w-full h-auto max-h-64 object-contain" src="@post.DiagramImageUrl" alt="Topology Spec" />
                                                @if (!string.IsNullOrWhiteSpace(post.DiagramCaption))
                                                {
                                                    <div class="p-2 bg-slate-900 text-slate-300 font-mono text-[10px] text-center">
                                                        @post.DiagramCaption
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Footer Engagement Counts Strip -->
                                        <div class="px-1 py-1 flex items-center justify-between text-xs text-[#7A8CA6] font-mono border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pt-2 pb-1">
                                            <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-rose-500 fill-rose-500" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>@post.LikeCount @(post.LikeCount == 1 ? "Like" : "Likes")</span>
                                            <span>@post.CommentCount comments • @post.ShareCount shares</span>
                                        </div>

                                        <!-- Post Action Buttons: Like, Comment, Share -->
                                        <div class="flex items-center justify-between pt-1 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] text-xs">
                                            <div class="flex items-center gap-5 w-full">
                                                <!-- Like -->
                                                <button type="button" @onclick="() => ToggleProfilePostLikeAsync(post.PostId)" class="flex items-center gap-1.5 font-medium transition cursor-pointer @(post.IsLikedByCurrentUser ? "text-rose-600 font-semibold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                                                    <svg class="w-4 h-4 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-currentColor")" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                                    </svg>
                                                    <span>Like</span>
                                                </button>

                                                <!-- Comment Toggle -->
                                                <button type="button" @onclick="() => ToggleProfileCommentBox(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer @(openProfileCommentPostIds.Contains(post.PostId) ? "!text-[#0A1B2E] dark:!text-white font-bold" : "")">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                                    <span>Comment</span>
                                                </button>

                                                <!-- Share -->
                                                <button type="button" @onclick="() => OpenProfileShareModal(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                                    <span>Share</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Inline Comment Drawer -->
                                        @if (openProfileCommentPostIds.Contains(post.PostId))
                                        {
                                            <div class="border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] pt-3 mt-2 space-y-3">
                                                <div class="flex items-center gap-2">
                                                    <input type="text" @bind="profileCommentInputs[post.PostId]"
                                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitProfileCommentAsync(post.PostId); })"
                                                           placeholder="Write a comment..."
                                                           class="flex-1 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20" />
                                                    <button type="button" @onclick="() => SubmitProfileCommentAsync(post.PostId)"
                                                            class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold hover:opacity-90 transition cursor-pointer">
                                                        Post
                                                    </button>
                                                </div>

                                                @if (profileCommentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                                {
                                                    @if (commentList.Count == 0)
                                                    {
                                                        <p class="text-xs text-[#7A8CA6] text-center py-2 font-mono">No comments yet. Be the first!</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="space-y-2 pt-1 max-h-60 overflow-y-auto">
                                                            @foreach (var c in commentList)
                                                            {
                                                                <div class="flex items-start gap-2 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] p-2.5 rounded-xl border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                                    <div class="w-6 h-6 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold text-[10px] shrink-0 font-mono">
                                                                        @(string.IsNullOrWhiteSpace(c.AuthorName) ? "U" : c.AuthorName.Substring(0, 1).ToUpper())
                                                                    </div>
                                                                    <div class="flex-1 min-w-0">
                                                                        <div class="flex items-center justify-between mb-0.5">
                                                                            <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@c.AuthorName</span>
                                                                            <span class="text-[10px] text-[#7A8CA6] font-mono">@c.CreatedAt.ToString("g")</span>
                                                                        </div>
                                                                        <p class="text-[#557392] dark:text-[#C4D2E1] leading-relaxed whitespace-pre-wrap">@c.Content</p>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            }
                        }
                        else if (activeTab == "reviews")
                        {
                            @if (!reviewsList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <svg class="w-8 h-8 text-slate-400 mx-auto" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    <p class="font-display font-bold mt-2 text-[#0A1B2E] dark:text-white">No peer reviews recorded yet</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var review in reviewsList)
                                {
                                    <div class="card-executive p-4 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2.5">
                                                @if (!string.IsNullOrWhiteSpace(review.RaterAvatarUrl))
                                                {
                                                    <img src="@review.RaterAvatarUrl" alt="@review.RaterDisplayName" class="w-8 h-8 rounded-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white font-bold text-xs flex items-center justify-center font-mono">
                                                        @review.RaterDisplayName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <div>
                                                    <a href="u/@review.RaterUserName" class="font-bold text-xs text-[#0A1B2E] dark:text-white hover:underline">@review.RaterDisplayName</a>
                                                    <p class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">@@@review.RaterUserName</p>
                                                </div>
                                            </div>
                                            <div class="text-amber-500 font-bold text-xs flex items-center gap-0.5">
                                                @for (int i = 0; i < review.Score; i++)
                                                {
                                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                        {
                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed pt-1">@review.ReviewText</p>
                                        }
                                        <div class="flex items-center justify-between font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] pt-1">
                                            <div>
                                                @if (!isOwner && profile?.Relationship?.HasRated == true && profile?.Relationship?.MyRatingScore == review.Score && (review.ReviewText == profile?.Relationship?.MyReviewText || (string.IsNullOrWhiteSpace(review.ReviewText) && string.IsNullOrWhiteSpace(profile?.Relationship?.MyReviewText))))
                                                {
                                                    <div class="flex items-center gap-3">
                                                        <button type="button" @onclick="OpenRatingModal" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold flex items-center gap-1 cursor-pointer">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                            <span>Edit</span>
                                                        </button>
                                                        <button type="button" @onclick="DeleteRatingAsync" disabled="@isDeletingRating" class="text-rose-600 dark:text-rose-400 hover:underline font-semibold flex items-center gap-1 cursor-pointer">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                            <span>Delete</span>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                            <span>@review.CreatedAt.ToString("g")</span>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else if (activeTab == "communities")
                        {
                            @if (!communitiesList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <svg class="w-8 h-8 text-slate-400 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                                    <p class="font-display font-bold mt-2 text-[#0A1B2E] dark:text-white">No affiliated hubs joined yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var comm in communitiesList)
                                    {
                                        <div class="card-executive p-3.5 flex flex-col justify-between">
                                            <div>
                                                <h4 class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white">@comm.Name</h4>
                                                <p class="text-[11px] text-[#64748B] dark:text-[#7A8CA6] line-clamp-2 mt-0.5">@comm.Description</p>
                                                <div class="flex items-center gap-2 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] mt-2">
                                                    <span class="inline-flex items-center gap-1">
                                                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                                        @comm.MemberCount
                                                    </span>
                                                    <span>•</span>
                                                    <span class="text-blue-600 dark:text-blue-400 font-semibold">@comm.RoleName</span>
                                                </div>
                                            </div>
                                            <div class="pt-3 flex justify-end">
                                                <a href="communities" class="btn-exec-secondary text-[11px] py-1 px-2.5">
                                                    Visit
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (activeTab == "followers" || activeTab == "following")
                        {
                            var list = activeTab == "followers" ? followersList : followingList;
                            @if (!list.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <p class="font-display font-bold">No users in this list yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    @foreach (var u in list)
                                    {
                                        <div class="card-executive p-3 flex items-center justify-between gap-3">
                                            <div class="flex items-center gap-2.5 min-w-0">
                                                @if (!string.IsNullOrWhiteSpace(u.AvatarUrl))
                                                {
                                                    <img src="@u.AvatarUrl" alt="@u.DisplayName" class="w-8 h-8 rounded-full object-cover shrink-0" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white font-bold text-xs flex items-center justify-center font-mono shrink-0">
                                                        @u.DisplayName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <div class="min-w-0">
                                                    <a href="u/@u.UserName" class="font-bold text-xs text-[#0A1B2E] dark:text-white hover:underline truncate block">@u.DisplayName</a>
                                                    <p class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] truncate">@@@u.UserName</p>
                                                </div>
                                            </div>
                                            <a href="u/@u.UserName" class="btn-exec-secondary text-[11px] py-1 px-2 shrink-0">View</a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (activeTab == "saved-posts" && isOwner)
                        {
                            @if (!savedPostsList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6]">
                                    <svg class="w-8 h-8 text-slate-400 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                    <p class="font-display font-bold mt-2 text-[#0A1B2E] dark:text-white">No saved posts recorded</p>
                                    <p class="text-[11px] text-[#64748B] dark:text-[#7A8CA6] mt-0.5">Posts you bookmark will appear here for easy reference.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var post in savedPostsList)
                                {
                                    <article class="card-executive p-4 sm:p-5 space-y-3">
                                        @if (!string.IsNullOrWhiteSpace(post.SharedByUserName))
                                        {
                                            <div class="flex items-center gap-1.5 text-xs text-[#64748B] dark:text-[#7A8CA6] font-medium pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                                <span>Shared by <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@(post.SharedByDisplayName ?? post.SharedByUserName)</span></span>
                                                @if (post.SharedAt.HasValue)
                                                {
                                                    <span class="text-[10px] text-[#7A8CA6] font-mono">• @post.SharedAt.Value.ToString("g")</span>
                                                }
                                            </div>
                                        }
                                        <!-- Post Meta Header with Clickable Profile -->
                                        <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                            <div class="flex items-center gap-2.5">
                                                <a href="u/@post.AuthorUserName" class="shrink-0 hover:opacity-90 transition">
                                                    @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                                                    {
                                                        <img alt="@post.AuthorDisplayName" class="w-8 h-8 rounded-full object-cover" src="@post.AuthorAvatarUrl" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-8 h-8 rounded-full bg-[#0A1B2E] text-white flex items-center justify-center font-bold text-xs font-mono">
                                                            @(string.IsNullOrWhiteSpace(post.AuthorDisplayName) ? "U" : post.AuthorDisplayName.Substring(0, 1).ToUpper())
                                                        </div>
                                                    }
                                                </a>
                                                <div>
                                                    <div class="flex items-center gap-1.5">
                                                        <a href="u/@post.AuthorUserName" class="text-xs font-bold text-[#0A1B2E] dark:text-white hover:underline">@post.AuthorDisplayName</a>
                                                        <a href="u/@post.AuthorUserName" class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] hover:underline">@@@post.AuthorUserName</a>
                                                    </div>
                                                    <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                        @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                                        {
                                                            <span>@post.CommunityName • </span>
                                                        }
                                                        <span>@post.CreatedAt.ToString("g")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (post.HasPoll)
                                            {
                                                <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded-[0.25rem] bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                                                    POLL
                                                </span>
                                            }
                                        </div>

                                        <!-- Title & Body -->
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(post.Title))
                                            {
                                                <h3 class="font-display text-sm sm:text-base font-bold text-[#0A1B2E] dark:text-white">
                                                    @post.Title
                                                </h3>
                                            }
                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] mt-1 whitespace-pre-line leading-relaxed">
                                                @post.Content
                                            </p>
                                        </div>

                                        <!-- Interactive Poll -->
                                        @if (post.HasPoll && post.Poll != null && post.Poll.Options.Any())
                                        {
                                            <div class="space-y-1.5 pt-1">
                                                <div class="font-mono text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                                                    QUESTION: @post.Poll.Question
                                                </div>
                                                <div class="space-y-1.5">
                                                    @foreach (var opt in post.Poll.Options)
                                                    {
                                                        <button type="button" @onclick="() => VotePollAsync(post.Poll.PollId, opt.OptionId)" class="w-full relative flex items-center justify-between p-2.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/50 hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] cursor-pointer transition text-left border @(opt.IsSelectedByMe ? "border-blue-500" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]") overflow-hidden">
                                                            <div class="absolute inset-y-0 left-0 bg-blue-100 dark:bg-blue-900/30 transition-all" style="width: @(opt.VotePercentage)%;"></div>
                                                            <span class="relative z-10 text-xs font-semibold text-[#0A1B2E] dark:text-white flex items-center gap-1.5">
                                                                @if (opt.IsSelectedByMe) { <span class="text-blue-600 font-bold">✓</span> }
                                                                <span>@opt.OptionText</span>
                                                            </span>
                                                            <span class="relative z-10 font-mono text-[11px] font-bold text-blue-700 dark:text-blue-300">
                                                                @opt.VotePercentage% (@opt.VoteCount)
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                                <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] pt-0.5">
                                                    TOTAL VOTES: @post.Poll.TotalVotes • @(post.Poll.HasVoted ? "PARTICIPATED" : "CLICK OPTION TO VOTE")
                                                </div>
                                            </div>
                                        }

                                        <!-- Code Snippet / Text Files -->
                                        @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                        {
                                            var textFiles = ParseProfileTextFiles(post.CodeSnippet, post.CodeFileName);
                                            if (textFiles.Count > 1)
                                            {
                                                <div class="mt-2 space-y-1.5">
                                                    <div class="text-[11px] font-semibold text-[#64748B] dark:text-[#7A8CA6] flex items-center gap-1">
                                                        <span>📎 Attached Text Files (@textFiles.Count):</span>
                                                    </div>
                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                        @foreach (var tf in textFiles)
                                                        {
                                                            <button type="button" @onclick="() => OpenProfileTextFileModal(tf.FileName, tf.Content)"
                                                                    class="flex items-center justify-between p-3 rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] bg-[#F8FAFC] dark:bg-[#0A1B2E] hover:border-[#0A1B2E] dark:hover:border-white transition text-left cursor-pointer group shadow-2xs">
                                                                <div class="flex items-center gap-2.5 min-w-0">
                                                                    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm shrink-0">
                                                                        📄
                                                                    </div>
                                                                    <div class="min-w-0">
                                                                        <p class="font-mono text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0] truncate group-hover:text-emerald-600 dark:group-hover:text-emerald-400">@tf.FileName</p>
                                                                        <p class="font-mono text-[10px] text-[#7A8CA6]">@(tf.Content.Length) chars • Click to read</p>
                                                                    </div>
                                                                </div>
                                                                <span class="text-xs text-[#7A8CA6] group-hover:translate-x-0.5 transition font-bold ml-2">↗</span>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                var single = textFiles.FirstOrDefault() ?? new AttachedTextFileItem(post.CodeFileName ?? "attachment.txt", post.CodeSnippet);
                                                <div class="prof-code-block p-3 space-y-1.5 mt-2">
                                                    <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                                        <button type="button" @onclick="() => OpenProfileTextFileModal(single.FileName, single.Content)"
                                                                class="font-bold text-emerald-400 font-mono hover:underline flex items-center gap-1 cursor-pointer">
                                                            <span>📄 @single.FileName</span>
                                                            <span class="text-gray-400 font-normal text-[9px]">(Click to expand)</span>
                                                        </button>
                                                        <span class="font-mono">TEXT</span>
                                                    </div>
                                                    <div class="overflow-x-auto overflow-y-auto max-h-72 text-[11px] leading-relaxed">
                                                        <pre class="whitespace-pre font-mono"><code>@single.Content</code></pre>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        <!-- Post Images -->
                                        @if (post.ImageUrls != null && post.ImageUrls.Any())
                                        {
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
                                                @foreach (var imgUrl in post.ImageUrls)
                                                {
                                                    <div class="rounded-xl overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] bg-slate-950 flex items-center justify-center max-h-72">
                                                        <img src="@imgUrl" alt="Post attachment" class="w-full h-full object-contain max-h-72" />
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Diagram Image -->
                                        @if (!string.IsNullOrWhiteSpace(post.DiagramImageUrl))
                                        {
                                            <div class="rounded-[0.375rem] overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-slate-950 mt-2">
                                                <img class="w-full h-auto max-h-64 object-contain" src="@post.DiagramImageUrl" alt="Topology Spec" />
                                                @if (!string.IsNullOrWhiteSpace(post.DiagramCaption))
                                                {
                                                    <div class="p-2 bg-slate-900 text-slate-300 font-mono text-[10px] text-center">
                                                        @post.DiagramCaption
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <!-- Footer Engagement Counts Strip -->
                                        <div class="px-1 py-1 flex items-center justify-between text-xs text-[#7A8CA6] font-mono border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pt-2 pb-1">
                                            <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-rose-500 fill-rose-500" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>@post.LikeCount @(post.LikeCount == 1 ? "Like" : "Likes")</span>
                                            <span>@post.CommentCount comments • @post.ShareCount shares</span>
                                        </div>

                                        <!-- Post Action Buttons: Like, Comment, Share -->
                                        <div class="flex items-center justify-between pt-1 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] text-xs">
                                            <div class="flex items-center gap-5 w-full">
                                                <!-- Like -->
                                                <button type="button" @onclick="() => ToggleProfilePostLikeAsync(post.PostId)" class="flex items-center gap-1.5 font-medium transition cursor-pointer @(post.IsLikedByCurrentUser ? "text-rose-600 font-semibold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                                                    <svg class="w-4 h-4 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-currentColor")" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                                    </svg>
                                                    <span>Like</span>
                                                </button>

                                                <!-- Comment Toggle -->
                                                <button type="button" @onclick="() => ToggleProfileCommentBox(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer @(openProfileCommentPostIds.Contains(post.PostId) ? "!text-[#0A1B2E] dark:!text-white font-bold" : "")">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                                    <span>Comment</span>
                                                </button>

                                                <!-- Share -->
                                                <button type="button" @onclick="() => OpenProfileShareModal(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                                    <span>Share</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Inline Comment Drawer -->
                                        @if (openProfileCommentPostIds.Contains(post.PostId))
                                        {
                                            <div class="border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] pt-3 mt-2 space-y-3">
                                                <div class="flex items-center gap-2">
                                                    <input type="text" @bind="profileCommentInputs[post.PostId]"
                                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitProfileCommentAsync(post.PostId); })"
                                                           placeholder="Write a comment..."
                                                           class="flex-1 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20" />
                                                    <button type="button" @onclick="() => SubmitProfileCommentAsync(post.PostId)"
                                                            class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold hover:opacity-90 transition cursor-pointer">
                                                        Post
                                                    </button>
                                                </div>

                                                @if (profileCommentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                                {
                                                    @if (commentList.Count == 0)
                                                    {
                                                        <p class="text-xs text-[#7A8CA6] text-center py-2 font-mono">No comments yet. Be the first!</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="space-y-2 pt-1 max-h-60 overflow-y-auto">
                                                            @foreach (var c in commentList)
                                                            {
                                                                <div class="flex items-start gap-2 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] p-2.5 rounded-xl border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                                    <div class="w-6 h-6 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold text-[10px] shrink-0 font-mono">
                                                                        @(string.IsNullOrWhiteSpace(c.AuthorName) ? "U" : c.AuthorName.Substring(0, 1).ToUpper())
                                                                    </div>
                                                                    <div class="flex-1 min-w-0">
                                                                        <div class="flex items-center justify-between mb-0.5">
                                                                            <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@c.AuthorName</span>
                                                                            <span class="text-[10px] text-[#7A8CA6] font-mono">@c.CreatedAt.ToString("g")</span>
                                                                        </div>
                                                                        <p class="text-[#557392] dark:text-[#C4D2E1] leading-relaxed whitespace-pre-wrap">@c.Content</p>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            }
                        }
                        else if (activeTab == "recycle-bin" && isOwner)
                        {
                            @if (!recycledPostsList.Any())
                            {
                                <div class="card-executive py-12 text-center text-xs text-[#64748B] dark:text-[#7A8CA6] space-y-2">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto text-slate-400">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </div>
                                    <p class="font-display font-bold">Your Recycle Bin is empty</p>
                                    <p class="text-[11px] max-w-sm mx-auto text-[#64748B] dark:text-[#7A8CA6]">Posts moved to the Recycle Bin will be preserved here for 10 days before permanent deletion.</p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    <div class="p-3 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/40 rounded-lg text-xs text-amber-800 dark:text-amber-300 flex items-center justify-between">
                                        <span class="flex items-center gap-1.5">
                                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            Posts in your Recycle Bin are automatically permanently purged after 10 days.
                                        </span>
                                        <span class="font-mono text-[10px] font-semibold">@recycledPostsList.Count ITEM(S)</span>
                                    </div>

                                    @foreach (var rp in recycledPostsList)
                                    {
                                        <div class="card-executive p-4 space-y-3 border-l-4 border-l-amber-500">
                                            <div class="flex items-center justify-between font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-semibold text-blue-600 dark:text-blue-400">@rp.CommunityName</span>
                                                    <span>•</span>
                                                    <span>Recycled @(rp.DeletedAt?.ToString("g") ?? rp.CreatedAt.ToString("g"))</span>
                                                </div>
                                                <span class="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200 font-semibold text-[10px]">
                                                    @(rp.DaysRemaining.HasValue ? $"Expires in {rp.DaysRemaining.Value} days" : "Expires in 10 days")
                                                </span>
                                            </div>

                                            <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed whitespace-pre-line">@rp.Content</p>

                                            @if (rp.ImageUrls != null && rp.ImageUrls.Any())
                                            {
                                                <div class="flex items-center gap-2">
                                                    @foreach (var img in rp.ImageUrls.Take(3))
                                                    {
                                                        <img src="@img" alt="Attachment" class="w-14 h-14 rounded object-cover border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]" />
                                                    }
                                                </div>
                                            }

                                            <div class="pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2">
                                                <button type="button" @onclick="() => RestoreRecycledPostAsync(rp.PostId)" class="btn-exec-secondary text-xs !py-1 !px-3 text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                                                    <span>↺</span>
                                                    <span>Restore Post</span>
                                                </button>
                                                <button type="button" @onclick="() => ConfirmPermanentDeletePost(rp.PostId)" class="btn-exec-secondary text-xs !py-1 !px-3 !border-rose-300 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 flex items-center gap-1.5" title="Permanently Delete">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    <span>Delete Forever</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }

                    </div>

                    <!-- Right Column: Sidebar Widgets (4 Cols) -->
                    <div class="lg:col-span-4 space-y-4">
                        
                        <!-- 1. Affiliated Hubs Widget -->
                        <div class="card-executive p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                <h3 class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">
                                    AFFILIATED HUBS
                                </h3>
                                <button @onclick='() => SetTab("communities")' class="font-mono text-[10px] font-semibold text-blue-600 dark:text-blue-400 hover:underline">
                                    VIEW ALL (@communitiesList.Count) &gt;
                                </button>
                            </div>

                            <div class="space-y-2">
                                @if (communitiesList.Any())
                                {
                                    @foreach (var comm in communitiesList.Take(3))
                                    {
                                        <div class="p-2.5 rounded-[0.375rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between gap-2">
                                            <div class="min-w-0">
                                                <h4 class="font-display font-bold text-xs text-[#0A1B2E] dark:text-white truncate">@comm.Name</h4>
                                                <div class="font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                                    @comm.MemberCount members • @comm.RoleName
                                                </div>
                                            </div>
                                            <a href="communities" class="btn-exec-secondary text-[10px] py-1 px-2 shrink-0">
                                                Join
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="py-4 text-center font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6]">
                                        NO AFFILIATED HUBS
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. Domain Competencies Widget -->
                        <div class="card-executive p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                <h3 class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">
                                    DOMAIN COMPETENCIES
                                </h3>
                                <span class="font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">PEER-VERIFIED</span>
                            </div>

                            <div class="flex flex-wrap gap-1.5">
                                @if (profile?.Skills != null && profile.Skills.Any())
                                {
                                    @foreach (var skill in profile.Skills)
                                    {
                                        <button type="button" @onclick="() => EndorseSkillAsync(skill.SkillId)" class="chip-standard @(skill.IsEndorsedByMe ? "border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300" : "")" title="Click to endorse skill">
                                            <span>@skill.SkillName</span>
                                            <span class="text-amber-500 font-bold inline-flex items-center gap-1">
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                                @skill.EndorsementCount
                                            </span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <div class="py-4 text-center font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] w-full">
                                        NO SKILLS RECORDED
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 3. Identity Verification Audit Stamp Card -->
                        @if (profile.IsVerified)
                        {
                            <div class="card-executive p-4 space-y-2.5">
                                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                                    <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    <span class="font-mono text-[10px] font-bold uppercase tracking-wider">IDENTITY VERIFICATION AUDIT</span>
                                </div>
                                <p class="font-body text-xs text-[#475569] dark:text-[#C4D2E1] leading-relaxed">
                                    Verified Identity: <strong class="text-[#0A1B2E] dark:text-white">@(profile.Role?.RoleName ?? "Community Member")</strong>. Credentials audited by CommunityLink Governance.
                                </p>
                                <div class="p-2.5 rounded-[0.25rem] bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 font-mono text-[10px] text-[#64748B] dark:text-[#7A8CA6] space-y-1 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex justify-between">
                                        <span>AUDIT ID:</span>
                                        <span class="font-semibold text-[#0A1B2E] dark:text-white">@(profile.VerificationAudit?.AuditCode ?? $"#CL-{profile.UserId:D4}-VERIFIED")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>AUTHORITY:</span>
                                        <span class="font-semibold text-[#0A1B2E] dark:text-white">@(profile.VerificationAudit?.Authority ?? "CommunityLink SecOps")</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>STATUS:</span>
                                        <span class="text-emerald-600 dark:text-emerald-400 font-bold">ACTIVE &amp; RECOGNIZED</span>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    }
</div>

<!-- ================= RATE USER MODAL ================= -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="w-full max-w-md bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] rounded-[0.75rem] p-5 shadow-2xl space-y-4 text-[#0A1B2E] dark:text-white">
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="font-display text-sm font-bold">@(profile?.Relationship?.HasRated == true ? "Edit Review for " : "Rate ")@(profile?.DisplayName ?? profile?.UserName)</h3>
                <button @onclick="CloseRatingModal" class="text-lg leading-none text-[#64748B] hover:text-[#0A1B2E] dark:hover:text-white font-bold">&times;</button>
            </div>
            <p class="font-body text-xs text-[#64748B] dark:text-[#7A8CA6]">
                Reviews are weighted by verified platform credentials and platform trust score.
            </p>

            <!-- Star Input Selector -->
            <div class="flex items-center justify-center gap-2 py-3 bg-[#F1F5F9] dark:bg-[#1B3B5A]/50 rounded-[0.25rem] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                @for (int star = 1; star <= 5; star++)
                {
                    var s = star;
                    <button type="button" @onclick="() => ratingModel.Score = s" class="p-1 transition hover:scale-110 @(s <= ratingModel.Score ? "text-amber-500" : "text-slate-300 dark:text-slate-700")">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </button>
                }
            </div>

            <div class="space-y-1">
                <label class="font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider" for="review-notes">Written Feedback (Optional)</label>
                <textarea @bind="ratingModel.ReviewText" id="review-notes" rows="3" class="w-full bg-white dark:bg-[#0A1B2E] rounded-[0.25rem] p-2.5 text-xs text-[#0A1B2E] dark:text-white placeholder-[#94A3B8] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] outline-none focus:ring-1 focus:ring-blue-500 resize-none" placeholder="Share your experience collaborating with this peer..."></textarea>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-2.5 bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs rounded-[0.25rem]">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-between gap-2 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div>
                    @if (profile?.Relationship?.HasRated == true)
                    {
                        <button type="button" @onclick="DeleteRatingAsync" disabled="@(isSubmittingRating || isDeletingRating)" class="text-xs text-rose-600 dark:text-rose-400 hover:underline font-semibold flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            <span>@(isDeletingRating ? "Deleting..." : "Delete Review")</span>
                        </button>
                    }
                </div>
                <div class="flex items-center gap-2">
                    <button @onclick="CloseRatingModal" class="btn-exec-secondary text-xs">
                        Cancel
                    </button>
                    <button @onclick="SubmitRatingAsync" disabled="@(isSubmittingRating || isDeletingRating)" class="btn-exec-primary text-xs">
                        @(isSubmittingRating ? "Saving..." : (profile?.Relationship?.HasRated == true ? "Save Changes" : "Submit Review"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= EDIT PROFILE MODAL ================= -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="w-full max-w-lg bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] rounded-[0.75rem] p-5 shadow-2xl space-y-4 text-[#0A1B2E] dark:text-white">
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="font-display text-sm font-bold">Edit Profile Credentials</h3>
                <button @onclick="CloseEditModal" class="text-lg leading-none text-[#64748B] hover:text-[#0A1B2E] dark:hover:text-white font-bold">&times;</button>
            </div>

            <div class="space-y-3 max-h-[65vh] overflow-y-auto pr-1">
                <!-- Avatar Upload Section in Edit Modal -->
                <div class="p-3 bg-[#F1F5F9] dark:bg-[#0A1B2E] rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden shadow-sm bg-[#1B3B5A] ring-2 ring-white dark:ring-[#112A46] shrink-0">
                            @if (!string.IsNullOrWhiteSpace(editModel.AvatarUrl ?? profile?.AvatarUrl))
                            {
                                <img src="@(editModel.AvatarUrl ?? profile?.AvatarUrl)" alt="Avatar" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-[#0A1B2E] to-[#2563EB] text-white flex items-center justify-center font-bold text-sm font-mono">
                                    @(string.IsNullOrWhiteSpace(editModel.DisplayName) ? "U" : (string.IsNullOrWhiteSpace(profile?.DisplayName) ? "U" : profile.DisplayName[..1].ToUpper()))
                                </div>
                            }
                        </div>
                        <div>
                            <span class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider">PROFILE PICTURE</span>
                            <span class="text-xs text-[#475569] dark:text-[#C4D2E1]">JPG, PNG or WebP (max 5 MB)</span>
                        </div>
                    </div>
                    <div>
                        <label for="modalAvatarUpload" class="btn-exec-secondary text-xs py-1.5 px-3 cursor-pointer @(isUploadingAvatar ? "opacity-50 pointer-events-none" : "")">
                            @if (isUploadingAvatar)
                            {
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <span>Upload New</span>
                            }
                        </label>
                        <InputFile id="modalAvatarUpload" OnChange="HandleAvatarUploadAsync" accept=".jpg,.jpeg,.png,.webp" class="hidden" disabled="@isUploadingAvatar" />
                    </div>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Display Name *</label>
                    <input type="text" @bind="editModel.DisplayName" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Username *</label>
                    <input type="text" @bind="editModel.UserName" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white font-mono outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Professional Headline</label>
                    <input type="text" @bind="editModel.Headline" placeholder="e.g. Principal AI Architect & Distributed Systems Fellow" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Pronouns</label>
                        <input type="text" @bind="editModel.Pronouns" placeholder="e.g. she/her" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Location</label>
                        <input type="text" @bind="editModel.Location" placeholder="e.g. San Francisco, CA & Remote" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Availability Status</label>
                    <input type="text" @bind="editModel.AvailabilityStatus" placeholder="e.g. Available for Advisory & Keynote Panels" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold text-[#64748B] dark:text-[#7A8CA6] uppercase tracking-wider mb-1">Bio / Overview</label>
                    <textarea @bind="editModel.Bio" rows="3" class="w-full px-3 py-1.5 text-xs rounded-[0.25rem] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white outline-none focus:border-blue-500 resize-none" placeholder="Share your experience, publications, or engineering background..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-2.5 bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs rounded-[0.25rem]">
                    @editErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button @onclick="CloseEditModal" class="btn-exec-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SaveProfileAsync" disabled="@isSavingProfile" class="btn-exec-primary text-xs">
                    @(isSavingProfile ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@if (showPermanentDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white dark:bg-[#1E293B] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-lg shadow-2xl max-w-sm w-full p-6 text-center transform transition-all scale-100">
            <div class="w-12 h-12 rounded-full bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 mx-auto flex items-center justify-center mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>
            <h3 class="text-base font-semibold text-[#0F172A] dark:text-[#E2E8F0] mb-2">Delete Permanently?</h3>
            <p class="text-xs text-[#64748B] dark:text-[#94A3B8] mb-6 leading-relaxed">
                Are you sure you want to permanently delete this post? This action cannot be undone and will immediately remove all comments and attachments.
            </p>
            <div class="flex items-center justify-center gap-3">
                <button type="button" @onclick="ClosePermanentDeleteModal" class="px-4 py-2 text-xs font-semibold text-[#475569] dark:text-[#CBD5E1] bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="ExecutePermanentDeleteAsync" class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded transition-colors shadow-sm">
                    Delete Forever
                </button>
            </div>
        </div>
    </div>
}

<!-- PROFILE PRIVATE CHAT UNLOCK MODAL -->
@if (showProfileUnlockModal && profile != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white dark:bg-[#112A46] rounded-3xl shadow-2xl border border-slate-200 dark:border-[rgba(196,210,225,0.15)] max-w-sm w-full overflow-hidden p-6 text-center space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/50 flex items-center justify-center text-sky-700 dark:text-sky-300 mx-auto shadow-xs">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>

            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-[#E1E8F0]">Private Chat Locked</h3>
                <p class="text-xs text-slate-600 dark:text-[#C4D2E1] mt-1 leading-normal">
                    @profile.DisplayName requires a one-time unlock fee for direct 1-on-1 messaging.
                </p>
            </div>

            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2 text-xs">
                <div class="flex items-center justify-between">
                    <span class="text-slate-500 dark:text-slate-400 font-medium">Creator Unlock Fee</span>
                    <span class="font-bold text-sky-700 dark:text-sky-400 flex items-center gap-1.5">
                        <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                        <span>@privateChatFeeLinkDrops.ToString("N0") Link Drops</span>
                    </span>
                </div>
                <div class="flex items-center justify-between border-t border-slate-200/60 dark:border-slate-800 pt-2">
                    <span class="text-slate-500 dark:text-slate-400 font-medium">Your Available Balance</span>
                    <span class="font-mono font-bold flex items-center gap-1.5 @(visitorWalletBalance >= privateChatFeeLinkDrops ? "text-slate-900 dark:text-white" : "text-rose-600 dark:text-rose-400")">
                        <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                        <span>@visitorWalletBalance.ToString("N0") Link Drops</span>
                    </span>
                </div>
            </div>

            @if (visitorWalletBalance < privateChatFeeLinkDrops)
            {
                <div class="p-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 rounded-xl text-[11px] text-amber-800 dark:text-amber-300 text-left flex items-start gap-2">
                    <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                    <div>
                        <span class="font-bold">Insufficient Link Drops.</span> You need @((privateChatFeeLinkDrops - visitorWalletBalance).ToString("N0")) more Link Drops to unlock.
                        <a href="linkdrops" class="text-indigo-600 dark:text-indigo-400 hover:underline font-bold block mt-0.5">Top Up Link Drops &rarr;</a>
                    </div>
                </div>
            }

            <div class="flex items-center gap-2 pt-2">
                <button type="button" @onclick="() => showProfileUnlockModal = false" class="flex-1 py-2.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition cursor-pointer">
                    Cancel
                </button>
                @if (visitorWalletBalance >= privateChatFeeLinkDrops)
                {
                    <button type="button" @onclick="ConfirmProfileUnlockAsync" disabled="@isUnlockingChat" class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/30 transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-1">
                        @if (isUnlockingChat)
                        {
                            <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span>Unlocking...</span>
                        }
                        else
                        {
                            <span>Pay &amp; Start Chat</span>
                        }
                    </button>
                }
                else
                {
                    <a href="linkdrops" class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/30 transition text-center">
                        Top Up Drops
                    </a>
                }
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: FULL TEXT FILE READER ================= -->
@if (showProfileTextFileModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] w-full max-w-2xl max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between bg-[#F8FAFC] dark:bg-[#0A1B2E]">
