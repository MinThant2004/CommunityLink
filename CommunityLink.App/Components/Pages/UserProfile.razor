                                        @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="@user.DisplayName" class="w-10 h-10 rounded-xl object-cover shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-xl bg-sky-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                                                @user.DisplayName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <a href="u/@user.UserName" class="font-bold text-xs text-slate-900 hover:text-indigo-600 transition truncate block">@user.DisplayName</a>
                                            <p class="text-[11px] text-slate-400 truncate">@@@user.UserName</p>
                                        </div>
                                    </div>
                                    <a href="u/@user.UserName" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition shrink-0">
                                        View
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

</div>

<!-- EDIT PROFILE MODAL -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="bg-white rounded-lg shadow-2xl border border-[#E2E8F0] max-w-lg w-full p-6 space-y-5 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <h3 class="prof-display text-lg font-bold text-[#0A1B2E]">Edit Profile Credentials</h3>
                <button @onclick="CloseEditModal" class="text-[#94A3B8] hover:text-[#0A1B2E] text-2xl leading-none font-bold">&times;</button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Display Name *</label>
                    <input type="text" @bind="editModel.DisplayName" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] focus:border-[#0A1B2E] outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Username *</label>
                    <input type="text" @bind="editModel.UserName" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] prof-mono focus:border-[#0A1B2E] outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Domain Expertise / Bio</label>
                    <textarea @bind="editModel.Bio" rows="3" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] focus:border-[#0A1B2E] outline-none resize-none"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded">
                    @editErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                <button @onclick="CloseEditModal" class="prof-btn-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SaveProfileAsync" disabled="@isSavingProfile" class="prof-btn-primary text-xs">
                    @if (isSavingProfile)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Profile Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- RATE USER MODAL -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm">
        <div class="bg-white rounded-lg shadow-2xl border border-[#E2E8F0] max-w-md w-full p-6 space-y-4 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <h3 class="prof-display text-base font-bold text-[#0A1B2E]">Rate @profile?.DisplayName</h3>
                <button @onclick="CloseRatingModal" class="text-[#94A3B8] hover:text-[#0A1B2E] text-2xl leading-none font-bold">&times;</button>
            </div>

            <div class="space-y-4 text-center">
                <p class="text-xs text-[#64748B]">Select advisory rating score:</p>
                <div class="flex items-center justify-center gap-2 text-2xl cursor-pointer py-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var score = i;
                        <span @onclick="() => ratingModel.Score = score" class="transition @(score <= ratingModel.Score ? "text-amber-500" : "text-slate-300")">
                            ★
                        </span>
                    }
                </div>
                <div class="prof-mono text-xs font-bold text-amber-600 uppercase">
                    @ratingModel.Score Star@(ratingModel.Score > 1 ? "s" : "")
                </div>

                <div class="text-left">
                    <label class="block text-xs font-bold text-[#64748B] uppercase tracking-wider mb-1">Written Review</label>
                    <textarea @bind="ratingModel.ReviewText" rows="3" class="w-full px-3.5 py-2 text-xs rounded border border-[#CBD5E1] text-[#0A1B2E] outline-none" placeholder="Share your experience working with this expert..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                <button @onclick="CloseRatingModal" class="prof-btn-secondary text-xs">
                    Cancel
                </button>
                <button @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="prof-btn-primary text-xs">
                    Submit Review
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserNameOrId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private UserProfileDto? profile;
    private bool isOwner;

    // Tabs
    private string activeTab = "posts";
    private bool isTabLoading;
    private List<UserPostItemDto> postsList = new();
    private List<UserPostItemDto> savedPostsList = new();
    private List<SavedAccountItemDto> savedAccountsList = new();
    private List<UserSharedPostItemDto> sharesList = new();
    private List<FollowUserItemDto> followersList = new();
    private List<FollowUserItemDto> followingList = new();
    private List<UserCommunityItemDto> communitiesList = new();
    private List<UserRatingItemDto> reviewsList = new();

    // Edit Profile Modal
    private bool showEditModal;
    private bool isSavingProfile;
    private string? editErrorMessage;
    private UpdateUserProfileRequestDto editModel = new();

    // Save Account Action
    private bool isSavingAccount;
    private bool isTogglingFollow;

    // Rating Modal
    private bool showRatingModal;
    private bool isSubmittingRating;
    private string? ratingErrorMessage;
    private RateUserRequestDto ratingModel = new() { Score = 5 };

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            Result<UserProfileDto> res;
            if (string.IsNullOrWhiteSpace(UserNameOrId))
            {
                res = await ProfileApi.GetOwnerProfileAsync(_cts.Token);
            }
            else
            {
                res = await ProfileApi.GetPublicProfileAsync(UserNameOrId, _cts.Token);
            }

            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                isOwner = profile.Relationship.IsSelf || string.IsNullOrWhiteSpace(UserNameOrId);
                
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var defaultTab = "posts";
                if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tabVal))
                {
                    var tabStr = tabVal.ToString().ToLowerInvariant();
                    if (!string.IsNullOrWhiteSpace(tabStr))
                    {
                        defaultTab = tabStr;
                    }
                }
                await SetTab(defaultTab);
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load profile.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleSaveAccountAsync()
    {
        if (profile == null || isOwner) return;
        isSavingAccount = true;
        try
        {
            switch (tab)
            {
                case "posts":
                    var pRes = await ProfileApi.GetUserPostsAsync(profile.UserId, _cts.Token);
                    if (pRes.IsSuccess && pRes.Data != null) postsList = pRes.Data;
                    break;
                case "saved-posts":
                    if (isOwner)
                    {
                        var spRes = await ProfileApi.GetSavedPostsAsync(_cts.Token);
                        if (spRes.IsSuccess && spRes.Data != null) savedPostsList = spRes.Data;
                    }
                    break;
                case "saved-accounts":
                    if (isOwner)
                    {
                        var saRes = await ProfileApi.GetSavedAccountsAsync(_cts.Token);
                        if (saRes.IsSuccess && saRes.Data != null) savedAccountsList = saRes.Data;
                    }
                    break;
                case "shares":
                    var shRes = await ProfileApi.GetUserSharesAsync(profile.UserId, _cts.Token);
                    if (shRes.IsSuccess && shRes.Data != null) sharesList = shRes.Data;
                    break;
                case "followers":
                    var flRes = await ProfileApi.GetFollowersAsync(profile.UserId, _cts.Token);
                    if (flRes.IsSuccess && flRes.Data != null) followersList = flRes.Data;
                    break;
                case "following":
                    var fgRes = await ProfileApi.GetFollowingAsync(profile.UserId, _cts.Token);
                    if (fgRes.IsSuccess && fgRes.Data != null) followingList = fgRes.Data;
                    break;
                case "communities":
                    var cRes = await ProfileApi.GetUserCommunitiesAsync(profile.UserId, _cts.Token);
                    if (cRes.IsSuccess && cRes.Data != null) communitiesList = cRes.Data;
                    break;
                case "reviews":
                    var rRes = await ProfileApi.GetUserReviewsAsync(profile.UserId, _cts.Token);
                    if (rRes.IsSuccess && rRes.Data != null) reviewsList = rRes.Data;
                    break;
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    // Toggle Follow User
    private async Task ToggleFollowUserAsync()
    {
        if (profile == null || isOwner) return;
        isTogglingFollow = true;
        try
        {
            var res = await ProfileApi.ToggleFollowUserAsync(profile.UserId, _cts.Token);
            if (res.IsSuccess)
            {
                var isFollowed = res.Data;
                profile.Relationship.IsFollowedByMe = isFollowed;
                profile.Metrics.FollowersCount += isFollowed ? 1 : -1;
                if (profile.Metrics.FollowersCount < 0) profile.Metrics.FollowersCount = 0;

                Toast.Success(isFollowed ? $"You are now following {profile.DisplayName}!" : $"Unfollowed {profile.DisplayName}.");
                if (activeTab == "followers") await SetTab("followers");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            isTogglingFollow = false;
        }
    }

    // Toggle Save Account
    private async Task ToggleSaveAccountAsync()
    {
        if (profile == null || isOwner) return;
        isSavingAccount = true;
        try
        {
            var res = await ProfileApi.ToggleSaveAccountAsync(profile.UserId, _cts.Token);
            if (res.IsSuccess)
            {
                profile.Relationship.IsSavedByMe = res.Data;
                Toast.Success(res.Data ? "Saved account to bookmarks." : "Removed account from bookmarks.");
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            Toast.Success("Profile node link copied to clipboard!");
        }
        catch
        {
            Toast.Info($"Profile link: {Navigation.Uri}");
        }
    }

    private void OpenEditModal()
    {
        if (profile == null) return;
        editModel = new UpdateUserProfileRequestDto
        {
            DisplayName = profile.DisplayName,
            UserName = profile.UserName,
            Bio = profile.Bio
        };
        editErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task SaveProfileAsync()
    {
        if (profile == null) return;
        isSavingProfile = true;
        editErrorMessage = null;
        try
        {
            var updateRes = await ProfileApi.UpdateProfileAsync(editModel, _cts.Token);
            if (updateRes.IsSuccess && updateRes.Data != null)
            {
                profile = updateRes.Data;
                Toast.Success("Profile credentials updated!");
                showEditModal = false;
            }
            else
            {
                editErrorMessage = updateRes.Message;
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private void OpenRatingModal()
    {
        if (profile == null) return;
        ratingModel = new RateUserRequestDto
        {
            Score = profile.Relationship.MyRatingScore ?? 5,
            ReviewText = profile.Relationship.MyReviewText
        };
        ratingErrorMessage = null;
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
    }

    private async Task SubmitRatingAsync()
    {
        if (profile == null) return;
        isSubmittingRating = true;
        ratingErrorMessage = null;
        try
        {
            var res = await ProfileApi.RateUserAsync(profile.UserId, ratingModel, _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                profile = res.Data;
                Toast.Success("Rating and endorsement submitted!");
                showRatingModal = false;
            }
            else
            {
                ratingErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            ratingErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
