@page "/user/dashboard"
@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject UserDashboardApiService DashboardApi

<PageTitle>My Dashboard — CommunityLink</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- User Welcome Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-[#0A1B2E] dark:bg-[#112A46] text-white p-6 md:p-8 border border-[#0A1B2E] dark:border-[rgba(196,210,225,0.15)] shadow-sm">
        <div class="absolute -top-20 -right-20 w-72 h-72 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/15 dark:bg-white/10 text-white font-bold text-2xl flex items-center justify-center shadow-lg ring-4 ring-white/10">
                    @(model?.Profile?.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-white" style="font-family:'Manrope',sans-serif">Welcome back, @(model?.Profile?.DisplayName ?? "Member")!</h1>
                    <p class="text-white/60 dark:text-[#C4D2E1] text-sm mt-0.5">Here is your personal activity hub and community updates.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="feed" class="px-4 py-2 rounded-full bg-white dark:bg-[#E1E8F0] text-[#0A1B2E] font-semibold text-xs hover:bg-[#F1F5F9] dark:hover:bg-white transition shadow-sm no-underline flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z"/></svg>
                    <span>My Feed</span>
                </a>
                <a href="communities" class="px-4 py-2 rounded-full bg-white/10 dark:bg-[#1B3B5A] hover:bg-white/20 dark:hover:bg-[#1B3B5A]/80 text-white font-semibold text-xs border border-white/20 dark:border-[rgba(196,210,225,0.20)] transition no-underline flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                    <span>Explore Hubs</span>
                </a>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Loading your personalized dashboard...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="p-6 bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/50 rounded-2xl text-red-700 dark:text-rose-300 flex items-center justify-between">
            <span>@errorMessage</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-2 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-500 transition cursor-pointer">
                Retry
            </button>
        </div>
    }
    else if (model != null)
    {
        <!-- Stat Overview Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-[#112A46] p-5 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">My Hubs</div>
                    <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.JoinedCommunities.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center text-xl font-bold">
                    <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                </div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-5 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Feed Posts</div>
                    <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.RecentPosts.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center text-xl font-bold">
                    <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg>
                </div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-5 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Active Polls</div>
                    <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.ActivePolls.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center text-xl font-bold">
                    <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
                </div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-5 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Messages</div>
                    <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">
                        @if (model.UnreadMessageCount > 0)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-50 dark:bg-rose-950/50 text-red-600 dark:text-rose-300 border border-red-200 dark:border-rose-900/50">
                                @model.UnreadMessageCount unread
                            </span>
                        }
                        else
                        {
                            <span>Active</span>
                        }
                    </div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center text-xl font-bold">
                    <svg class="w-6 h-6 text-sky-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
                </div>
            </div>
        </div>

        <!-- Main Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Joined & Recommended Communities -->
            <div class="space-y-6">
                <!-- Joined Communities -->
                <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                            <span>My Communities</span>
                        </h2>
                        <a href="communities" class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">View All &rarr;</a>
                    </div>
                    @if (!model.JoinedCommunities.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-4">No communities joined yet. <a href="communities" class="text-[#557392] dark:text-[#C4D2E1] font-semibold underline">Discover hubs now!</a></p>
                    }
                    else
                    {
                        <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                            @foreach (var c in model.JoinedCommunities.Take(5))
                            {
                                <div class="py-3 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] font-bold text-sm flex items-center justify-center border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                            @c.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <a href="communities" class="font-bold text-sm text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-[#557392] dark:hover:text-white transition no-underline">@c.Name</a>
                                            <div class="text-xs text-[#7A8CA6] font-mono">@c.MemberCount members &middot; @c.PostCount posts</div>
                                        </div>
                                    </div>
                                    <a href="feed" class="px-3 py-1 rounded-full text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition no-underline">Open</a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Suggested Hubs -->
                <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"/></svg>
                            <span>Recommended Hubs</span>
                        </h2>
                        <span class="text-xs text-[#7A8CA6]">Tailored for you</span>
                    </div>
                    @if (!model.RecommendedCommunities.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-2">You are a member of all available hubs!</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var c in model.RecommendedCommunities.Take(3))
                            {
                                <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between gap-3 hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.30)] transition">
                                    <div>
                                        <div class="font-bold text-xs text-[#0A1B2E] dark:text-[#E1E8F0]">@c.Name</div>
                                        <div class="text-xs text-[#557392] dark:text-[#C4D2E1] line-clamp-1">@c.Description</div>
                                    </div>
                                    <a href="communities" class="px-3 py-1 rounded-full text-xs font-semibold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition shadow-sm whitespace-nowrap no-underline">
                                        Explore
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Feed Activity & Active Polls -->
            <div class="space-y-6">
                <!-- Recent Activity Feed -->
                <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z"/></svg>
                            <span>Recent Activity Feed</span>
                        </h2>
                        <a href="feed" class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">Open Feed &rarr;</a>
                    </div>
                    @if (!model.RecentPosts.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-4">No recent posts found in your feed.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                            @foreach (var p in model.RecentPosts.Take(4))
                            {
                                <div class="py-3">
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="font-bold text-[#557392] dark:text-[#C4D2E1]">@@@p.AuthorName</span>
                                        <span class="text-[#7A8CA6] font-mono">@p.CreatedAt.ToString("g")</span>
                                    </div>
                                    <p class="text-sm text-[#0A1B2E] dark:text-[#E1E8F0] line-clamp-2 mb-2">@p.Content</p>
                                    <div class="flex items-center gap-4 text-xs text-[#7A8CA6] font-medium font-mono">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5 text-rose-500 fill-rose-500" viewBox="0 0 24 24"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/></svg>
                                            <span>@p.LikeCount</span>
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
                                            <span>@p.CommentCount</span>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? model;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess)
            {
                model = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored on navigation
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
