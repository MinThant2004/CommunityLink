@page "/user/dashboard"
@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject UserDashboardApiService DashboardApi

<PageTitle>My Dashboard — CommunityLink</PageTitle>

<div class="space-y-6">
    <!-- User Welcome Hero Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-900 text-white p-6 md:p-8 shadow-lg">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-white text-indigo-600 font-bold text-2xl flex items-center justify-center shadow-md ring-4 ring-white/10">
                    @(model?.Profile?.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight">Welcome back, @(model?.Profile?.DisplayName ?? "Member")!</h1>
                    <p class="text-slate-300 text-sm mt-0.5">Here is your personal activity hub and community updates.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="feed" class="px-4 py-2 rounded-xl bg-white text-indigo-900 font-semibold text-xs hover:bg-slate-100 transition shadow-sm">
                    📰 My Feed
                </a>
                <a href="communities" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition">
                    🏛️ Explore Hubs
                </a>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-500 bg-white rounded-2xl shadow-sm border border-slate-200">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Loading your personalized dashboard...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="p-6 bg-rose-50 border border-rose-200 rounded-2xl text-rose-700 flex items-center justify-between">
            <span>@errorMessage</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-2 bg-rose-600 text-white text-xs font-semibold rounded-xl hover:bg-rose-700 transition">
                Retry
            </button>
        </div>
    }
    else if (model != null)
    {
        <!-- Stat Overview Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium text-slate-500">My Hubs</div>
                    <div class="text-2xl font-black text-indigo-600 mt-1">@model.JoinedCommunities.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
                    🏛️
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium text-slate-500">Feed Posts</div>
                    <div class="text-2xl font-black text-emerald-600 mt-1">@model.RecentPosts.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                    📝
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium text-slate-500">Active Polls</div>
                    <div class="text-2xl font-black text-amber-600 mt-1">@model.ActivePolls.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                    📊
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium text-slate-500">Messages</div>
                    <div class="text-2xl font-black text-sky-600 mt-1">
                        @if (model.UnreadMessageCount > 0)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700">
                                @model.UnreadMessageCount unread
                            </span>
                        }
                        else
                        {
                            <span>Active</span>
                        }
                    </div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl font-bold">
                    💬
                </div>
            </div>
        </div>

        <!-- Main Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Joined & Recommended Communities -->
            <div class="space-y-6">
                <!-- Joined Communities -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-900">🏛️ My Communities</h2>
                        <a href="communities" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">View All &rarr;</a>
                    </div>
                    @if (!model.JoinedCommunities.Any())
                    {
                        <p class="text-xs text-slate-500 py-4">No communities joined yet. <a href="communities" class="text-indigo-600 font-semibold underline">Discover hubs now!</a></p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100">
                            @foreach (var c in model.JoinedCommunities.Take(5))
                            {
                                <div class="py-3 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-100 text-slate-700 font-bold text-sm flex items-center justify-center">
                                            @c.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <a href="communities" class="font-bold text-sm text-slate-900 hover:text-indigo-600 transition">@c.Name</a>
                                            <div class="text-xs text-slate-400">@c.MemberCount members &middot; @c.PostCount posts</div>
                                        </div>
                                    </div>
                                    <a href="feed" class="px-3 py-1 rounded-lg text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 transition">Open</a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Suggested Hubs -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-900">✨ Recommended Hubs</h2>
                        <span class="text-xs text-slate-400">Tailored for you</span>
                    </div>
                    @if (!model.RecommendedCommunities.Any())
                    {
                        <p class="text-xs text-slate-500 py-2">You are a member of all available hubs!</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var c in model.RecommendedCommunities.Take(3))
                            {
                                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between gap-3">
                                    <div>
                                        <div class="font-bold text-xs text-slate-900">@c.Name</div>
                                        <div class="text-xs text-slate-500 line-clamp-1">@c.Description</div>
                                    </div>
                                    <a href="communities" class="px-3 py-1 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-sm whitespace-nowrap">
                                        Explore
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Feed Activity & Active Polls -->
            <div class="space-y-6">
                <!-- Recent Activity Feed -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-900">📰 Recent Activity Feed</h2>
                        <a href="feed" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Open Feed &rarr;</a>
                    </div>
                    @if (!model.RecentPosts.Any())
                    {
                        <p class="text-xs text-slate-500 py-4">No recent posts found in your feed.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-slate-100">
                            @foreach (var p in model.RecentPosts.Take(4))
                            {
                                <div class="py-3">
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="font-bold text-indigo-600">@@@p.AuthorName</span>
                                        <span class="text-slate-400">@p.CreatedAt.ToString("g")</span>
                                    </div>
                                    <p class="text-sm text-slate-800 line-clamp-2 mb-2">@p.Content</p>
                                    <div class="flex items-center gap-4 text-xs text-slate-500 font-medium">
                                        <span>❤️ @p.LikeCount</span>
                                        <span>💬 @p.CommentCount</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? model;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess)
            {
                model = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored on navigation
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
