@page "/user/dashboard"
@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject UserDashboardApiService DashboardApi

<PageTitle>My Dashboard — CommunityLink</PageTitle>

<div class="space-y-6">
    <!-- User Welcome Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-[#0A1B2E] text-white p-6 md:p-8 border border-[#0A1B2E]">
        <div class="absolute -top-20 -right-20 w-72 h-72 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/15 text-white font-bold text-2xl flex items-center justify-center shadow-lg ring-4 ring-white/10">
                    @(model?.Profile?.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-white" style="font-family:'Manrope',sans-serif">Welcome back, @(model?.Profile?.DisplayName ?? "Member")!</h1>
                    <p class="text-white/60 text-sm mt-0.5">Here is your personal activity hub and community updates.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="feed" class="px-4 py-2 rounded-full bg-white text-[#0A1B2E] font-semibold text-xs hover:bg-[#F1F5F9] transition shadow-sm">
                    📰 My Feed
                </a>
                <a href="communities" class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition">
                    🏛️ Explore Hubs
                </a>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] bg-white rounded-2xl border border-[#E2E8F0]">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Loading your personalized dashboard...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="p-6 bg-red-50 border border-red-200 rounded-2xl text-red-700 flex items-center justify-between">
            <span>@errorMessage</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-2 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-500 transition">
                Retry
            </button>
        </div>
    }
    else if (model != null)
    {
        <!-- Stat Overview Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] flex items-center justify-between hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">My Hubs</div>
                    <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.JoinedCommunities.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] text-[#557392] flex items-center justify-center text-xl font-bold">
                    🏛️
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] flex items-center justify-between hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Feed Posts</div>
                    <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.RecentPosts.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] text-[#557392] flex items-center justify-center text-xl font-bold">
                    📝
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] flex items-center justify-between hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Active Polls</div>
                    <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.ActivePolls.Count</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] text-[#557392] flex items-center justify-center text-xl font-bold">
                    📊
                </div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] flex items-center justify-between hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Messages</div>
                    <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">
                        @if (model.UnreadMessageCount > 0)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-50 text-red-600 border border-red-200">
                                @model.UnreadMessageCount unread
                            </span>
                        }
                        else
                        {
                            <span>Active</span>
                        }
                    </div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] text-[#557392] flex items-center justify-center text-xl font-bold">
                    💬
                </div>
            </div>
        </div>

        <!-- Main Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Joined & Recommended Communities -->
            <div class="space-y-6">
                <!-- Joined Communities -->
                <div class="bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0]">
                        <h2 class="text-base font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">🏛️ My Communities</h2>
                        <a href="communities" class="text-xs font-semibold text-[#557392] hover:text-[#0A1B2E] transition">View All &rarr;</a>
                    </div>
                    @if (!model.JoinedCommunities.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-4">No communities joined yet. <a href="communities" class="text-[#557392] font-semibold underline">Discover hubs now!</a></p>
                    }
                    else
                    {
                        <div class="divide-y divide-[#E2E8F0]">
                            @foreach (var c in model.JoinedCommunities.Take(5))
                            {
                                <div class="py-3 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-lg bg-[#F1F5F9] text-[#557392] font-bold text-sm flex items-center justify-center border border-[#E2E8F0]">
                                            @c.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <a href="communities" class="font-bold text-sm text-[#0A1B2E] hover:text-[#557392] transition">@c.Name</a>
                                            <div class="text-xs text-[#7A8CA6] font-mono">@c.MemberCount members &middot; @c.PostCount posts</div>
                                        </div>
                                    </div>
                                    <a href="feed" class="px-3 py-1 rounded-full text-xs font-semibold text-[#0A1B2E] bg-[#F1F5F9] hover:bg-[#E2E8F0] border border-[#E2E8F0] transition">Open</a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Suggested Hubs -->
                <div class="bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0]">
                        <h2 class="text-base font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">✨ Recommended Hubs</h2>
                        <span class="text-xs text-[#7A8CA6]">Tailored for you</span>
                    </div>
                    @if (!model.RecommendedCommunities.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-2">You are a member of all available hubs!</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var c in model.RecommendedCommunities.Take(3))
                            {
                                <div class="p-3 bg-[#F8FAFC] rounded-xl border border-[#E2E8F0] flex items-center justify-between gap-3 hover:border-[#CBD5E1] transition">
                                    <div>
                                        <div class="font-bold text-xs text-[#0A1B2E]">@c.Name</div>
                                        <div class="text-xs text-[#557392] line-clamp-1">@c.Description</div>
                                    </div>
                                    <a href="communities" class="px-3 py-1 rounded-full text-xs font-semibold text-white bg-[#0A1B2E] hover:bg-[#112A46] transition shadow-sm whitespace-nowrap">
                                        Explore
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Feed Activity & Active Polls -->
            <div class="space-y-6">
                <!-- Recent Activity Feed -->
                <div class="bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0]">
                        <h2 class="text-base font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">📰 Recent Activity Feed</h2>
                        <a href="feed" class="text-xs font-semibold text-[#557392] hover:text-[#0A1B2E] transition">Open Feed &rarr;</a>
                    </div>
                    @if (!model.RecentPosts.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] py-4">No recent posts found in your feed.</p>
                    }
                    else
                    {
                        <div class="divide-y divide-[#E2E8F0]">
                            @foreach (var p in model.RecentPosts.Take(4))
                            {
                                <div class="py-3">
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="font-bold text-[#557392]">@@@p.AuthorName</span>
                                        <span class="text-[#7A8CA6] font-mono">@p.CreatedAt.ToString("g")</span>
                                    </div>
                                    <p class="text-sm text-[#0A1B2E] line-clamp-2 mb-2">@p.Content</p>
                                    <div class="flex items-center gap-4 text-xs text-[#7A8CA6] font-medium font-mono">
                                        <span>❤️ @p.LikeCount</span>
                                        <span>💬 @p.CommentCount</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? model;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess)
            {
                model = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored on navigation
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
