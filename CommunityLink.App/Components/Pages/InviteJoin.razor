@page "/invite/{Token}"
@using CommunityLink.App.Apis
@using CommunityLink.App.Components.Shared.Chat
@using CommunityLink.Shared.Features.ChatGroup
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Loc
@inject ChatGroupApiService ChatGroupApi
@inject LinkDropApiService LinkDropApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@Loc["Invite_PageTitle"]</PageTitle>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-slate-900 px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-6 rounded-2xl border border-slate-800 bg-slate-950 p-8 shadow-2xl backdrop-blur-xl">
        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center py-12 space-y-4">
                <div class="h-10 w-10 animate-spin rounded-full border-4 border-indigo-500 border-t-transparent"></div>
                <p class="text-sm font-medium text-slate-400">@Loc["Invite_LoadingDetails"]</p>
            </div>
        }
        else if (error != null)
        {
            <div class="text-center space-y-4 py-6">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-rose-500/10 text-rose-500">
                    <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-white">@Loc["Invite_InvalidTitle"]</h2>
                <p class="text-sm text-slate-400">@error</p>
                <div class="pt-4">
                    <a href="/chat" class="inline-flex items-center justify-center rounded-xl bg-slate-800 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700">
                        @Loc["Invite_Action_GoToChat"]
                    </a>
                </div>
            </div>
        }
        else if (preview != null)
        {
            <div class="flex flex-col items-center text-center space-y-5">
                <!-- Group Avatar -->
                <div class="relative">
                    <UserAvatar Url="@preview.GroupAvatar"
                                Name="@preview.GroupName"
                                Size="h-24 w-24"
                                RingClass="shadow-lg ring-4 ring-slate-800"
                                BgClass="bg-indigo-600"
                                ColorClass="text-white"
                                TextClass="text-3xl font-bold" />
                </div>

                <!-- Group Info -->
                <div class="space-y-1">
                    <h2 class="text-2xl font-bold tracking-tight text-white">@preview.GroupName</h2>
                    <div class="flex items-center justify-center gap-2 text-xs font-medium text-slate-400">
                        <span>@(preview.MemberCount == 1 ? string.Format(Loc["Invite_Members_Single"], preview.MemberCount) : string.Format(Loc["Invite_Members_Count"], preview.MemberCount))</span>
                        <span>•</span>
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold @(preview.AccessMode == "PRIVATE" ? "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20" : "bg-slate-500/10 text-slate-400 border border-slate-500/20")">
                            @(preview.AccessMode == "PRIVATE" ? Loc["Invite_Badge_Private"] : Loc["Invite_Badge_Public"])
                        </span>
                        <span>•</span>
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold @(preview.ChatType == "PAID" ? "bg-amber-500/10 text-amber-400 border border-amber-500/20" : "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20")">
                            @(preview.ChatType == "PAID" ? string.Format(Loc["Invite_Badge_PaidDrops"], preview.JoinFeeLinkDrops) : Loc["Invite_Badge_Free"])
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(preview.GroupDescription))
                {
                    <p class="text-xs text-slate-400 leading-relaxed max-w-xs line-clamp-3">
                        @preview.GroupDescription
                    </p>
                }

                <!-- Status Alerts / Action Buttons -->
                <div class="w-full pt-4 space-y-3">
                    @if (!preview.IsValid)
                    {
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-3.5 text-xs text-rose-300">
                            @(preview.InvalidReason ?? Loc["Invite_NoLongerValid"].Value)
                        </div>
                        <a href="/chat" class="w-full inline-flex items-center justify-center rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">
                            @Loc["Invite_Action_GoToChat"]
                        </a>
                    }
                    else if (!isAuthenticated)
                    {
                        <div class="space-y-3">
                            <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 p-3.5 text-xs font-medium text-amber-300">
                                @Loc["Invite_LoginPrompt"]
                            </div>
                            <a href="@($"/login?returnUrl={Uri.EscapeDataString($"/invite/{Token}")}")"
                               class="w-full flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-indigo-500">
                                @Loc["Invite_Action_LogIn"]
                            </a>
                        </div>
                    }
                    else if (preview.IsAlreadyMember)
                    {
                        <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/10 p-3.5 text-xs text-indigo-300">
                            @Loc["Invite_AlreadyMember"]
                        </div>
                        <button type="button" @onclick="GoToChat" class="w-full inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-indigo-500">
                            @Loc["Invite_Action_OpenChat"]
                        </button>
                    }
                    else if (preview.IsBanned)
                    {
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-left space-y-1.5 select-none">
                            <p class="flex items-center gap-2 text-sm font-semibold text-rose-300">
                                <span class="text-base">🚫</span>
                                @Loc["Invite_Banned_Title"]
                            </p>
                            <p class="text-xs text-rose-200/90 leading-relaxed">
                                @Loc["Invite_Banned_Desc"]
                            </p>
                            <p class="text-xs text-slate-400 leading-relaxed pt-1">
                                @Loc["Invite_Banned_Help"]
                            </p>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(actionError))
                        {
                            <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-3 text-xs text-rose-300">
                                @actionError
                            </div>
                        }

                        @if (preview.AccessMode == "PRIVATE")
                        {
                            @if (preview.RequestStatus == "PENDING_APPROVAL")
                            {
                                <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 p-4 text-center space-y-1">
                                    <p class="text-sm font-semibold text-amber-300">@Loc["Invite_Pending_Title"]</p>
                                    <p class="text-xs text-amber-200/80">@Loc["Invite_Pending_Desc"]</p>
                                </div>
                                <button type="button" disabled
                                        class="w-full inline-flex items-center justify-center rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-slate-400 cursor-not-allowed">
                                    @Loc["Invite_Action_PendingApproval"]
                                </button>
                            }
                            else if (preview.RequestStatus == "REJECTED")
                            {
                                <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-center space-y-1">
                                    <p class="text-sm font-semibold text-rose-300">@Loc["Invite_Declined_Title"]</p>
                                    <p class="text-xs text-rose-200/80">@Loc["Invite_Declined_Desc"]</p>
                                </div>
                                <button type="button" disabled
                                        class="w-full inline-flex items-center justify-center rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-slate-400 cursor-not-allowed">
                                    @Loc["Invite_Action_RequestDeclined"]
                                </button>
                            }
                            else if (preview.RequestStatus == "APPROVED_WAITING_PAYMENT")
                            {
                                <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-center space-y-1">
                                    <p class="text-sm font-semibold text-emerald-300">@Loc["Invite_Approved_Title"]</p>
                                    <p class="text-xs text-emerald-200/80">@string.Format(Loc["Invite_Approved_Desc"], preview.JoinFeeLinkDrops)</p>
                                </div>
                                <button type="button"
                                        @onclick="OnJoinButtonClickedAsync"
                                        disabled="@isJoining"
                                        class="w-full inline-flex items-center justify-center rounded-xl bg-amber-600 hover:bg-amber-500 shadow-lg shadow-amber-600/20 px-5 py-3 text-sm font-semibold text-white transition disabled:opacity-50">
                                    @if (isJoining)
                                    {
                                        <span class="flex items-center gap-2">
                                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                                            @Loc["Invite_Action_Processing"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@string.Format(Loc["Invite_Action_PayDropsAndJoin"], preview.JoinFeeLinkDrops)</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        @onclick="SubmitJoinRequestAsync"
                                        disabled="@isJoining"
                                        class="w-full inline-flex items-center justify-center rounded-xl bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/20 px-5 py-3 text-sm font-semibold text-white transition disabled:opacity-50">
                                    @if (isJoining)
                                    {
                                        <span class="flex items-center gap-2">
                                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                                            @Loc["Invite_Action_SubmittingRequest"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@Loc["Invite_Action_RequestToJoin"]</span>
                                    }
                                </button>
                            }
                        }
                        else
                        {
                            <button type="button"
                                    @onclick="OnJoinButtonClickedAsync"
                                    disabled="@isJoining"
                                    class="w-full inline-flex items-center justify-center rounded-xl @(preview.ChatType == "PAID" ? "bg-amber-600 hover:bg-amber-500 shadow-amber-600/20" : "bg-indigo-600 hover:bg-indigo-500 shadow-indigo-600/20") px-5 py-3 text-sm font-semibold text-white shadow-lg transition disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                @if (isJoining)
                                {
                                    <span class="flex items-center gap-2">
                                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                                        @Loc["Invite_Action_JoiningGroup"]
                                    </span>
                                }
                                else
                                {
                                    <span>@(preview.ChatType == "PAID" ? string.Format(Loc["Invite_Action_PayDropsAndJoin"], preview.JoinFeeLinkDrops) : Loc["Invite_Action_JoinGroup"])</span>
                                }
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Paid Group Unlock Payment Modal -->
@if (preview != null && preview.ChatType == "PAID")
{
    <UnlockChatModal IsOpen="showUnlockModal"
                     IsGroupUnlock="true"
                     SubjectName="@preview.GroupName"
                     SubjectSubtitle="@string.Format(Loc["Invite_Modal_SubjectSubtitle"], preview.MemberCount)"
                     AvatarUrl="@preview.GroupAvatar"
                     FeeLinkDrops="@preview.JoinFeeLinkDrops"
                     Balance="@walletBalance"
                     IsSubmitting="@isProcessingPayment"
                     errorMessage="@paymentError"
                     OnConfirm="ConfirmPaidJoinAsync"
                     OnClose="() => showUnlockModal = false" />
}

@code {
    [Parameter] public string Token { get; set; } = "";

    private bool isLoading = true;
    private bool isAuthenticated;
    private bool isJoining;
    private bool showUnlockModal;
    private bool isProcessingPayment;
    private long walletBalance;
    private string? error;
    private string? actionError;
    private string? paymentError;
    private InviteLinkPreviewModel? preview;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationStateAsync();
        await LoadPreviewAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthenticationStateAsync();
        await LoadPreviewAsync();
    }

    private async Task CheckAuthenticationStateAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        }
        catch
        {
            isAuthenticated = false;
        }
    }

    private async Task LoadPreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            error = Loc["Invite_Error_NoToken"].Value;
            isLoading = false;
            return;
        }

        isLoading = true;
        error = null;

        var res = await ChatGroupApi.GetInviteLinkPreviewAsync(Token);
        isLoading = false;

        if (res.IsSuccess && res.Data != null)
        {
            preview = res.Data;
        }
        else
        {
            error = res.Error ?? Loc["Invite_Error_LoadFailed"].Value;
        }
    }

    private async Task OnJoinButtonClickedAsync()
    {
        if (isJoining || preview == null || !preview.IsValid) return;

        if (preview.ChatType == "PAID")
        {
            paymentError = null;
            // Fetch current wallet balance
            var walletRes = await LinkDropApi.GetUserWalletAsync();
            if (walletRes.IsSuccess && walletRes.Data != null)
            {
                walletBalance = walletRes.Data.Balance;
            }
            showUnlockModal = true;
            return;
        }

        // Free Group Join
        isJoining = true;
        actionError = null;

        var result = await ChatGroupApi.JoinViaInviteLinkAsync(Token);
        isJoining = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/chat");
        }
        else
        {
            actionError = result.Error ?? Loc["Invite_Error_JoinFailed"].Value;
        }
    }

    private async Task SubmitJoinRequestAsync()
    {
        if (isJoining || preview == null) return;

        isJoining = true;
        actionError = null;

        var result = await ChatGroupApi.SubmitJoinRequestAsync(preview.ChatGroupId);
        isJoining = false;

        if (result.IsSuccess)
        {
            preview = preview with { RequestStatus = "PENDING_APPROVAL" };
        }
        else
        {
            actionError = result.Error ?? Loc["Invite_Error_RequestFailed"].Value;
        }
    }

    private async Task ConfirmPaidJoinAsync()
    {
        if (preview == null || isProcessingPayment) return;

        isProcessingPayment = true;
        paymentError = null;

        CommunityLink.Shared.Result result;
        if (preview.AccessMode == "PRIVATE" && preview.RequestStatus == "APPROVED_WAITING_PAYMENT")
        {
            result = await ChatGroupApi.PayAndJoinApprovedRequestAsync(preview.ChatGroupId);
        }
        else
        {
            result = await ChatGroupApi.JoinPaidChatGroupAsync(preview.ChatGroupId);
        }

        isProcessingPayment = false;

        if (result.IsSuccess)
        {
            showUnlockModal = false;
            Navigation.NavigateTo("/chat");
        }
        else
        {
            paymentError = result.Error ?? Loc["Invite_Error_PaymentFailed"].Value;
        }
    }

    private void GoToChat()
    {
        Navigation.NavigateTo("/chat");
    }
}
