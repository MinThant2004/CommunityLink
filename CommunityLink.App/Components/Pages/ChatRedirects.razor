@page "/chat-groups"
@page "/chat-groups/{chatGroupId:int?}"
@page "/chat-groups-directory"
@*
    Legacy route shim. The group chat UI now lives in the unified /chat page, so these
    addresses are kept alive as permanent redirects for existing bookmarks and links.
*@

<div class="flex items-center justify-center py-16 text-sm text-slate-500" role="status">
    <span class="h-5 w-5 animate-spin rounded-full border-b-2 border-indigo-600"></span>
    <span class="ml-2">Opening Chat…</span>
</div>

@code {
    [Parameter] public int? ChatGroupId { get; set; }

    [Inject] private NavigationManager NavManager { get; set; } = default!;

    protected override void OnInitialized() =>
        NavManager.NavigateTo(
            ChatGroupId.HasValue ? $"/chat?type=group&thread={ChatGroupId.Value}" : "/chat",
            replace: true);
}
