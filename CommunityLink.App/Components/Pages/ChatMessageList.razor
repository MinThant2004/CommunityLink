@inject IJSRuntime JS

<div @ref="scrollContainer" class="flex-1 overflow-y-auto p-4 sm:p-6 bg-slate-100 min-h-0">
    <div class="max-w-4xl mx-auto w-full space-y-3">
        @if (IsLoading)
        {
            <div class="py-16 text-center text-slate-500 space-y-2">
                <div class="animate-spin rounded-full h-7 w-7 border-b-2 border-indigo-600 mx-auto"></div>
                <p class="text-xs font-medium">Loading message history...</p>
            </div>
        }
        else if (HasError)
        {
            <div class="py-12 text-center space-y-3">
                <svg class="w-12 h-12 mx-auto text-rose-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <p class="text-xs font-semibold text-rose-600">Unable to load messages.</p>
                <button type="button" @onclick="OnRetry" class="px-4 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-lg transition shadow-xs">
                    Retry
                </button>
            </div>
        }
        else if (Messages == null || Messages.Count == 0)
        {
            <div class="py-12 text-center">
                <div class="max-w-sm mx-auto p-6 bg-white border border-slate-200 rounded-2xl shadow-xs space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                        </svg>
                    </div>
                    <h4 class="text-base font-bold text-slate-800">No messages yet</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Be the first to start the conversation by sending a message below!
                    </p>
                </div>
            </div>
        }
        else
        {
            DateTime? lastDate = null;
            int? lastSenderId = null;

            @for (int i = 0; i < Messages.Count; i++)
            {
                var msg = Messages[i];
                var msgDate = msg.CreatedAt.Date;
                bool showDateSeparator = !lastDate.HasValue || lastDate.Value != msgDate;
                bool showHeader = showDateSeparator || lastSenderId != msg.SenderId;

                if (showDateSeparator)
                {
                    <div class="flex items-center justify-center my-4">
                        <span class="px-3.5 py-1 bg-white border border-slate-200 text-slate-600 text-xs font-semibold rounded-full shadow-2xs">
                            @GetFormattedDateSeparator(msgDate)
                        </span>
                    </div>
                }

                <ChatMessageBubble Message="msg" ShowHeader="showHeader" OnDelete="OnDeleteMessage" />

                lastDate = msgDate;
                lastSenderId = msg.SenderId;
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatGroupMessageModel>? Messages { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback<int> OnDeleteMessage { get; set; }

    private ElementReference scrollContainer;
    private int? lastScrollMessageId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Messages != null && Messages.Count > 0)
        {
            var lastId = Messages[^1].ChatGroupMessageId;
            if (firstRender || lastId != lastScrollMessageId)
            {
                lastScrollMessageId = lastId;
                await ScrollToBottom();
            }
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "(function(el){ if(el) el.scrollTop = el.scrollHeight; })", scrollContainer);
        }
        catch
        {
            // Ignore scroll errors if container not rendered yet
        }
    }

    private string GetFormattedDateSeparator(DateTime date)
    {
        var today = DateTime.UtcNow.Date;
        if (date == today) return "Today";
        if (date == today.AddDays(-1)) return "Yesterday";
        return date.ToString("MMMM dd, yyyy");
    }
}