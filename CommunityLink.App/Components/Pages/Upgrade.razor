                            <p class="font-mono font-bold font-body-sm text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@targetPlan.LinkDropCost.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-1.5 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="font-label-sm text-on-surface-variant uppercase">@Loc["Upgrade_Modal_YourBalance"]</p>
                            <p class="font-mono font-bold font-body-sm text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@userWalletDrops.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-1.5 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="font-label-sm text-on-surface-variant uppercase">@Loc["Upgrade_Modal_Remaining"]</p>
                            @if (userWalletDrops >= targetPlan.LinkDropCost)
                            {
                                <p class="font-mono font-bold font-body-sm text-emerald-600 mt-0.5 flex items-center justify-center gap-1.5">
