@page "/upgrade"
@page "/membership"
@attribute [Authorize]
@inject SubscriptionPlanApiService PlanApi
@inject PremiumUpgradeApiService UpgradeApi
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>@Loc["Upgrade_PageTitle"]</PageTitle>

<style>
    /* Premium Page Focused Button & Vibrant Gold Styling */
    .upgrade-interval-btn-active {
        background-color: #0A1B2E !important;
        color: #FFFFFF !important;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1) !important;
    }
    .upgrade-interval-btn-active:focus,
    .upgrade-interval-btn-active:focus-visible {
        outline: 2px solid #0A1B2E !important;
        outline-offset: 1px !important;
        background-color: #0A1B2E !important;
        color: #FFFFFF !important;
    }
    .dark .upgrade-interval-btn-active {
        background-color: #D4AF37 !important;
        color: #0A0D14 !important;
        box-shadow: 0 0 14px rgba(212, 175, 55, 0.35) !important;
    }
    .dark .upgrade-interval-btn-active:hover {
        background-color: #E5C158 !important;
    }
    .dark .upgrade-interval-btn-active:focus,
    .dark .upgrade-interval-btn-active:focus-visible {
        outline: 2px solid #D4AF37 !important;
        outline-offset: 1px !important;
        background-color: #D4AF37 !important;
        color: #0A0D14 !important;
    }

    .upgrade-btn-primary {
        background-color: #0A1B2E !important;
        color: #FFFFFF !important;
        border: 1px solid #0A1B2E !important;
        transition: all 0.18s ease;
    }
    .upgrade-btn-primary:hover:not(:disabled) {
        background-color: #112A46 !important;
        border-color: #112A46 !important;
        box-shadow: 0 4px 14px -2px rgba(10, 27, 46, 0.25) !important;
    }
    .upgrade-btn-primary:focus,
    .upgrade-btn-primary:focus-visible {
        outline: 2px solid #0A1B2E !important;
        outline-offset: 2px !important;
        background-color: #0A1B2E !important;
        color: #FFFFFF !important;
    }
    .dark .upgrade-btn-primary {
        background-color: #D4AF37 !important;
        color: #0A0D14 !important;
        border-color: #D4AF37 !important;
        box-shadow: 0 0 16px rgba(212, 175, 55, 0.4) !important;
    }
    .dark .upgrade-btn-primary:hover:not(:disabled) {
        background-color: #F2CA50 !important;
        border-color: #F2CA50 !important;
        box-shadow: 0 0 22px rgba(212, 175, 55, 0.6) !important;
    }
    .dark .upgrade-btn-primary:focus,
    .dark .upgrade-btn-primary:focus-visible {
        outline: 2px solid #D4AF37 !important;
        outline-offset: 2px !important;
        background-color: #D4AF37 !important;
        color: #0A0D14 !important;
    }
</style>

<div class="min-h-screen bg-background font-body-md text-body-md text-on-surface antialiased transition-colors duration-200">
    

    <div class="relative w-full overflow-hidden">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute top-40 right-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pt-space-md pb-space-lg w-full space-y-space-lg">

            <!-- Breadcrumbs -->
            <nav aria-label="@Loc["Common_Breadcrumbs"]" class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
                <a class="hover:text-[#0A1B2E] dark:hover:text-[#D4AF37] transition-colors" href="/">@Loc["Upgrade_Nav_Platform"]</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">@Loc["Upgrade_Nav_PremiumMembership"]</span>
            </nav>

            <!-- Hero Panel (Matches Communities.razor) -->
            <div class="relative rounded-xl bg-surface-container-low p-space-md md:p-space-lg overflow-hidden border border-surface-container-high/30">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#0A1B2E]/20 dark:via-[#D4AF37]/30 to-transparent"></div>

                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
                    <div class="flex flex-col gap-space-xs max-w-2xl">
                        <div class="flex flex-wrap items-center gap-space-sm">
                            <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm border border-surface-container-high/40">
                                <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                <span>@Loc["Upgrade_Hero_YourBalance"]</span>
                                <strong class="text-on-surface font-mono">@Loc["Upgrade_Hero_DropsCount", userWalletDrops.ToString("N0")]</strong>
                                <a href="linkdrops" class="text-secondary hover:underline font-semibold ml-1">@Loc["Upgrade_Hero_TopUp"]</a>
                            </span>
                            @if (myStatus?.HasActiveSubscription == true)
                            {
                                <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-[#D4AF37] dark:bg-[#D4AF37]/15 font-label-sm text-label-sm border border-amber-500/30 dark:border-[#D4AF37]/40 font-medium">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 dark:bg-[#D4AF37] animate-pulse"></span>
                                    <span>Active: <strong>@myStatus.TierName</strong></span>
                                    <span class="text-xs opacity-75">(@(myStatus.ExpiresAtUtc?.ToString("dd-MM-yyyy") ?? "-"), @myStatus.DaysRemaining days left)</span>
                                </span>
                            }
                            else if (myStatus?.PendingVerification != null)
                            {
                                <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-label-sm text-label-sm border border-amber-500/20 font-medium">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                    <span>Pending Audit: <strong>@myStatus.PendingVerification.PlanName</strong></span>
                                </span>
                            }
                        </div>

                        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-space-xs font-bold">
                            Premium Membership Tiers
                        </h1>

                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                            @Loc["Upgrade_Hero_Subtitle"]
                        </p>
                    </div>

                    <!-- Billing Interval Selector -->
                    <div class="flex items-center gap-space-sm shrink-0">
                        <div class="inline-flex items-center p-1 rounded-lg bg-surface-container border border-surface-container-high/50 shadow-inner">
                            <button type="button" @onclick='() => isAnnual = false'
                                    class="px-3.5 py-1.5 rounded-md font-label-md text-label-md font-bold transition cursor-pointer @(!isAnnual ? "bg-[#0A1B2E] text-white dark:bg-slate-700 dark:text-white shadow-sm" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/40")">
                                Monthly
                            </button>
                            <button type="button" @onclick='() => isAnnual = true'
                                    class="px-3.5 py-1.5 rounded-md font-label-md text-label-md font-bold transition cursor-pointer @(isAnnual ? "bg-[#0A1B2E] text-white dark:bg-slate-700 dark:text-white shadow-sm" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/40")">
                                Annual
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3-TIER PRICING CARDS -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-space-md items-stretch">

                <!-- 1. Normal User (Current Plan) -->
                <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 p-space-md md:p-space-lg flex flex-col justify-between space-y-space-md shadow-sm">
                    <div class="space-y-space-md">
                        <div class="flex items-center justify-between">
                            <span class="px-space-sm py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider bg-surface-container text-on-surface-variant border border-surface-container-high/30 font-bold">
                                Default Tier
                            </span>
                            <span class="material-symbols-outlined text-base text-on-surface-variant">person</span>
                        </div>

                        <div>
                            <h3 class="font-title-lg font-bold text-on-surface">@Loc["Upgrade_Plan_NormalUserTitle"]</h3>
                            <p class="font-body-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_NormalUserDesc"]</p>
                        </div>

                        <div class="p-space-sm rounded-lg bg-surface-container border border-surface-container-high/30">
                            <div class="flex items-baseline gap-1">
                                <span class="font-headline-lg font-bold text-on-surface font-mono">0</span>
                                <span class="font-body-sm text-on-surface-variant">@Loc["Upgrade_Plan_DropsForever"]</span>
                            </div>
                            <p class="font-label-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_NormalParticipation"]</p>
                        </div>

                        <ul class="space-y-2 pt-space-xs font-body-sm text-on-surface">
                            <li class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-xs text-[#0A1B2E] dark:text-[#D4AF37] mt-0.5">check</span>
                                <span>@Loc["Upgrade_Plan_Perk_DiscoverFeeds"]</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-xs text-[#0A1B2E] dark:text-[#D4AF37] mt-0.5">check</span>
                                <span>@Loc["Upgrade_Plan_Perk_JoinCommunities"]</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-xs text-[#0A1B2E] dark:text-[#D4AF37] mt-0.5">check</span>
                                <span>@Loc["Upgrade_Plan_Perk_CreateArticles"]</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="material-symbols-outlined text-xs text-[#0A1B2E] dark:text-[#D4AF37] mt-0.5">check</span>
                                <span>@Loc["Upgrade_Plan_Perk_DirectMessaging"]</span>
                            </li>
                            <li class="flex items-start gap-2 text-on-surface-variant opacity-60">
                                <span class="material-symbols-outlined text-xs text-outline mt-0.5">close</span>
                                <span>@Loc["Upgrade_Plan_Perk_NoAdvisory"]</span>
                            </li>
                            <li class="flex items-start gap-2 text-on-surface-variant opacity-60">
                                <span class="material-symbols-outlined text-xs text-outline mt-0.5">close</span>
                                <span>@Loc["Upgrade_Plan_Perk_NoVerifiedBadge"]</span>
                            </li>
                        </ul>
                    </div>

                    <div class="pt-space-sm border-t border-surface-container-high/30">
                        <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-on-surface-variant bg-surface-container cursor-not-allowed">
                            @(myStatus?.HasActiveSubscription == true ? Loc["Upgrade_Plan_Btn_StandardDefaultTier"] : Loc["Upgrade_Plan_Btn_CurrentPlan"])
                        </button>
                    </div>
                </div>

                <!-- 2. Domain Professional (PRO) -->
                @{
                    var proPlan = SelectedDomainProPlan;
                }
                <div class="rounded-xl bg-surface-container-low border-2 border-secondary/50 p-space-md md:p-space-lg flex flex-col justify-between space-y-space-md shadow-sm relative">
                    <div class="space-y-space-md">
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider font-bold bg-secondary/10 text-secondary border border-secondary/20">
                                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
                                <span>@Loc["Upgrade_Plan_DomainProBadge"]</span>
                            </span>
                            
                        </div>

                        <div>
                            <h3 class="font-title-lg font-bold text-on-surface">@Loc["Upgrade_Plan_DomainProTitle"]</h3>
                            <p class="font-body-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_DomainProDesc"]</p>
                        </div>

                        <div class="p-space-sm rounded-lg bg-surface-container border border-surface-container-high/30">
                            @if (proPlan != null)
                            {
                                <div class="flex items-baseline gap-1.5">
                                    <span class="font-headline-lg font-bold text-secondary font-mono flex items-center gap-1.5">
                                        <LinkDropIcon Class="w-5 h-5 shrink-0" />
                                        <span>@proPlan.LinkDropCost.ToString("N0")</span>
                                    </span>
                                    <span class="font-body-sm text-on-surface-variant font-semibold">@Loc["Upgrade_Plan_DropsPerInterval", (isAnnual ? Loc["Upgrade_Billing_Year"] : Loc["Upgrade_Billing_Month"])]</span>
                                </div>
                                <p class="font-label-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_BilledInDrops"]</p>
                            }
                            else
                            {
                                <div class="font-body-sm text-on-surface-variant py-1">@Loc["Upgrade_Plan_NotActive"]</div>
                            }
                        </div>

                        <ul class="space-y-2 pt-space-xs font-body-sm text-on-surface">
                            @if (proPlan?.Perks != null && proPlan.Perks.Count > 0)
                            {
                                @foreach (var perk in proPlan.Perks)
                                {
                                    <li class="flex items-start gap-2">
                                        <span class="material-symbols-outlined text-xs text-secondary mt-0.5" style="font-variation-settings: 'FILL' 1;">check</span>
                                        <span>@perk</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="font-body-sm text-on-surface-variant italic">@Loc["Upgrade_Plan_DomainProPerkFallback"]</li>
                            }
                        </ul>
                    </div>

                    <div class="pt-space-sm border-t border-surface-container-high/30">
                        @if (proPlan != null)
                        {
                            @if (myStatus?.HasActiveSubscription == true && (myStatus.TargetRoleCode == "DOMAIN_PRO" || myStatus.TargetRoleCode == "DOMAIN_PROFESSIONAL"))
                            {
                                <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-emerald-600 bg-emerald-500/10 border border-emerald-500/30 cursor-not-allowed flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-outlined text-base">check_circle</span>
                                    <span>@Loc["Upgrade_Plan_Btn_CurrentActiveTier"]</span>
                                </button>
                            }
                            else if (myStatus?.PendingVerification?.PlanId == proPlan.PlanId)
                            {
                                <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-amber-600 bg-amber-500/10 border border-amber-500/30 cursor-not-allowed flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-outlined text-base">hourglass_top</span>
                                    <span>@Loc["Upgrade_Plan_Btn_AuditPendingReview"]</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => OpenUpgradeModal(proPlan)"
                                        class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-on-secondary bg-secondary hover:bg-secondary/90 shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer">
                                    <span>@Loc["Upgrade_Plan_Btn_UpgradeToDomainPro"]</span>
                                    <span>&rarr;</span>
                                </button>
                            }
                        }
                        else
                        {
                            <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-on-surface-variant bg-surface-container cursor-not-allowed">
                                @Loc["Upgrade_Plan_Btn_PlanUnavailable"]
                            </button>
                        }
                    </div>
                </div>

                <!-- 3. Public Figure VIP (VIP) -->
                @{
                    var vipPlan = SelectedPublicFigurePlan;
                }
                <div class="rounded-xl bg-surface-container-low border-2 border-secondary/50 p-space-md md:p-space-lg flex flex-col justify-between space-y-space-md shadow-sm relative">
                    <div class="space-y-space-md">
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider font-bold bg-secondary/10 text-secondary border border-secondary/20">
                                <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                                <span>@Loc["Upgrade_Plan_PublicFigureBadge"]</span>
                            </span>
                            
                        </div>

                        <div>
                            <h3 class="font-title-lg font-bold text-on-surface">@Loc["Upgrade_Plan_PublicFigureTitle"]</h3>
                            <p class="font-body-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_PublicFigureDesc"]</p>
                        </div>

                        <div class="p-space-sm rounded-lg bg-surface-container border border-surface-container-high/30">
                            @if (vipPlan != null)
                            {
                                <div class="flex items-baseline gap-1.5">
                                    <span class="font-headline-lg font-bold text-secondary font-mono flex items-center gap-1.5">
                                        <LinkDropIcon Class="w-5 h-5 shrink-0" />
                                        <span>@vipPlan.LinkDropCost.ToString("N0")</span>
                                    </span>
                                    <span class="font-body-sm text-on-surface-variant font-semibold">@string.Format(Loc["Upgrade_Plan_DropsPerInterval"], (isAnnual ? Loc["Upgrade_Billing_Year"] : Loc["Upgrade_Billing_Month"]))</span>
                                </div>
                                <p class="font-label-sm text-on-surface-variant mt-0.5">@Loc["Upgrade_Plan_BilledInDrops"]</p>
                            }
                            else
                            {
                                <div class="font-body-sm text-on-surface-variant py-1">@Loc["Upgrade_Plan_NotActive"]</div>
                            }
                        </div>

                        <ul class="space-y-2 pt-space-xs font-body-sm text-on-surface">
                            @if (vipPlan?.Perks != null && vipPlan.Perks.Count > 0)
                            {
                                @foreach (var perk in vipPlan.Perks)
                                {
                                    <li class="flex items-start gap-2">
                                        <span class="material-symbols-outlined text-xs text-secondary mt-0.5" style="font-variation-settings: 'FILL' 1;">check</span>
                                        <span>@perk</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="font-body-sm text-on-surface-variant italic">@Loc["Upgrade_Plan_PublicFigurePerkFallback"]</li>
                            }
                        </ul>
                    </div>

                    <div class="pt-space-sm border-t border-surface-container-high/30">
                        @if (vipPlan != null)
                        {
                            @if (myStatus?.HasActiveSubscription == true && myStatus.TargetRoleCode == "PUBLIC_FIGURE")
                            {
                                <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-secondary bg-secondary/10 border border-secondary/30 cursor-not-allowed flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-outlined text-base">check_circle</span>
                                    <span>@Loc["Upgrade_Plan_Btn_CurrentActiveTier"]</span>
                                </button>
                            }
                            else if (myStatus?.PendingVerification?.PlanId == vipPlan.PlanId)
                            {
                                <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-amber-600 bg-amber-500/10 border border-amber-500/30 cursor-not-allowed flex items-center justify-center gap-1.5">
                                    <span class="material-symbols-outlined text-base">hourglass_top</span>
                                    <span>@Loc["Upgrade_Plan_Btn_AuditPendingReview"]</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => OpenUpgradeModal(vipPlan)"
                                        class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-on-secondary bg-secondary hover:bg-secondary/90 shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer">
                                    <span>@Loc["Upgrade_Plan_Btn_ApplyForVIP"]</span>
                                    <span>&rarr;</span>
                                </button>
                            }
                        }
                        else
                        {
                            <button disabled class="w-full py-2.5 rounded-lg font-label-md text-label-md font-bold text-on-surface-variant bg-surface-container cursor-not-allowed">
                                Plan Unavailable
                            </button>
                        }
                    </div>
                </div>

            </div>

            <!-- HOW THE VERIFICATION AUDIT WORKS (4-STEP SYSTEM TIMELINE) -->
            <div class="space-y-space-md pt-space-xs">
                <div class="space-y-space-xs">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">
                        @Loc["Upgrade_Sop_Badge"]
                    </span>
                    <h2 class="font-headline-md text-headline-md font-bold text-on-surface">
                        @Loc["Upgrade_Sop_Title"]
                    </h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant max-w-2xl leading-relaxed">
                        @Loc["Upgrade_Sop_Subtitle"]
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
                    <!-- Step 01 -->
                    <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 p-space-md space-y-space-xs shadow-sm">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#D4AF37]/15 dark:text-[#D4AF37]">01</span>
                            <LinkDropIcon Class="w-5 h-5 shrink-0" />
                        </div>
                        <h4 class="font-title-md font-bold text-on-surface">@Loc["Upgrade_Sop_Step1_Title"]</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                            @Loc["Upgrade_Sop_Step1_Desc"]
                        </p>
                    </div>

                    <!-- Step 02 -->
                    <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 p-space-md space-y-space-xs shadow-sm">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-amber-500/10 text-amber-600 dark:text-amber-400">02</span>
                            <span class="material-symbols-outlined text-lg text-amber-500">badge</span>
                        </div>
                        <h4 class="font-title-md font-bold text-on-surface">@Loc["Upgrade_Sop_Step2_Title"]</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                            @Loc["Upgrade_Sop_Step2_Desc"]
                        </p>
                    </div>

                    <!-- Step 03 -->
                    <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 p-space-md space-y-space-xs shadow-sm">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-secondary/10 text-secondary">03</span>
                            <span class="material-symbols-outlined text-lg text-secondary">verified_user</span>
                        </div>
                        <h4 class="font-title-md font-bold text-on-surface">@Loc["Upgrade_Sop_Step3_Title"]</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                            @Loc["Upgrade_Sop_Step3_Desc"]
                        </p>
                    </div>

                    <!-- Step 04 -->
                    <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 p-space-md space-y-space-xs shadow-sm">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">04</span>
                            <span class="material-symbols-outlined text-lg text-emerald-500">military_tech</span>
                        </div>
                        <h4 class="font-title-md font-bold text-on-surface">@Loc["Upgrade_Sop_Step4_Title"]</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                            @Loc["Upgrade_Sop_Step4_Desc"]
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- IDENTITY AUDIT INTAKE & CHECKOUT MODAL -->
@if (showUpgradeModal && targetPlan != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-surface-container-low rounded-xl shadow-2xl border border-surface-container-high/40 max-w-xl w-full p-space-md md:p-space-lg space-y-space-md text-on-surface max-h-[92vh] overflow-y-auto">

            <!-- Modal Header -->
            <div class="flex items-start justify-between border-b border-surface-container-high/30 pb-3">
                <div>
                    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400">
                        Identity Verification Audit
                    </span>
                    <h3 class="font-title-lg font-bold text-on-surface mt-0.5">
                        Upgrade to @targetPlan.PlanName
                    </h3>
                </div>
                <button type="button" @onclick="CloseUpgradeModal" aria-label="@Loc["Common_Close"]" class="text-on-surface-variant hover:text-on-surface text-xl leading-none cursor-pointer">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="p-space-sm bg-error/10 border border-error/30 text-error font-body-sm text-body-sm rounded-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-base shrink-0">error</span>
                    <span>@modalError</span>
                </div>
            }

            <form @onsubmit="SubmitUpgradeApplicationAsync" class="space-y-4 font-body-sm text-body-sm">

                <!-- Plan Summary Box -->
                <div class="p-3 rounded-lg bg-surface-container border border-surface-container-high/30 flex items-center justify-between">
                    <div>
                        <p class="font-title-md font-bold text-on-surface">@targetPlan.PlanName</p>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@Loc["Upgrade_Modal_Duration", targetPlan.DurationDays, targetPlan.BillingInterval]</p>
                    </div>
                    <div class="text-right">
                        <p class="font-title-lg font-mono font-bold text-[#0A1B2E] dark:text-white flex items-center justify-end gap-1.5">
                            <LinkDropIcon Class="w-4 h-4 shrink-0" />
                            <span>@Loc["Upgrade_Modal_DropsCost", targetPlan.LinkDropCost.ToString("N0")]</span>
                        </p>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@Loc["Upgrade_Modal_EscrowDeposit"]</p>
                    </div>
                </div>

                <!-- Legal Full Name -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        @Loc["Upgrade_Modal_LegalNameLabel"].Value.TrimEnd('*', ' ') <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <input type="text" required placeholder="Enter full legal name" @bind="inputLegalName"
                           class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors" />
                </div>

                <!-- Location (Mandatory) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        Location <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <input type="text" required placeholder="e.g. Yangon, Myanmar" @bind="inputLocation"
                           class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors" />
                </div>

                <!-- Skills & Competencies (Mandatory) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        Skills &amp; Competencies <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <input type="text" required placeholder="e.g. C# .NET, UI/UX Design" @bind="inputSkills"
                           class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors" />
                    <p class="text-xs text-[#557392] dark:text-[#8FA3BC]">Separate skills with commas. These will be verified and displayed on your verified profile.</p>
                </div>

                <!-- Professional Credentials / Links -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                            @Loc["Upgrade_Modal_WorkEmailLabel"]
                        </label>
                        <input type="email" placeholder="name@company.com" @bind="inputWorkEmail"
                               class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                            @Loc["Upgrade_Modal_PortfolioUrlLabel"]
                        </label>
                        <input type="url" placeholder="https://linkedin.com/in/..." @bind="inputProfessionalUrl"
                               class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors" />
                    </div>
                </div>

                <!-- Guaranteed Response SLA Dropdown -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        @Loc["Upgrade_Modal_ResponseSlaLabel"].Value.TrimEnd('*', ' ') <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <select @bind="selectedResponseSla"
                            class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-blue-500 outline-none transition-colors">
                        <option value="Replies within 12 hours">@Loc["Upgrade_Modal_Sla_12"]</option>
                        <option value="Replies within 24 hours">@Loc["Upgrade_Modal_Sla_24"]</option>
                        <option value="Replies within 36 hours">@Loc["Upgrade_Modal_Sla_36"]</option>
                        <option value="Replies within 48 hours">@Loc["Upgrade_Modal_Sla_48"]</option>
                    </select>
                    <p class="text-xs text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_ResponseSlaHint"]</p>
                </div>

                <!-- Identity Card Upload (Front) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        @Loc["Upgrade_Modal_IdFrontLabel"].Value.TrimEnd('*', ' ') <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <div class="p-3 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container space-y-2 text-left">
                        <InputFile OnChange="HandleFrontIdUpload" accept=".jpg,.jpeg,.png,.webp" class="w-full text-xs text-slate-500 dark:text-[#94A3B8] file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#1E3A8A] dark:file:text-white hover:file:bg-[#153252] dark:hover:file:bg-[#2563EB] cursor-pointer transition-colors" />
                        <p class="text-xs text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_IdFrontHint"]</p>
                        @if (!string.IsNullOrEmpty(frontIdPreviewUrl))
                        {
                            <div class="flex items-start gap-4 p-3 rounded-lg bg-surface-container-lowest border border-slate-200 dark:border-surface-container-high/40">
                                <div class="relative group cursor-pointer shrink-0 rounded-lg overflow-hidden border border-slate-300 dark:border-surface-container-high shadow-xs bg-slate-900/60"
                                     @onclick="() => OpenEnlargedImage(frontIdPreviewUrl, frontIdFileName)" title="Click to enlarge">
                                    <img src="@frontIdPreviewUrl" alt="Front ID Preview" class="w-48 h-32 sm:w-56 sm:h-36 object-contain p-1 rounded-lg transition duration-150 group-hover:scale-105" />
                                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-white text-xs font-semibold gap-1">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
                                        <span>Click to Enlarge</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0 space-y-1.5 pt-0.5">
                                    <button type="button" @onclick="() => OpenEnlargedImage(frontIdPreviewUrl, frontIdFileName)" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1.5 cursor-pointer">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
                                        <span>View Full Size Preview</span>
                                    </button>
                                    <p class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate" title="@frontIdFileName">@frontIdFileName</p>
                                    <div>
                                        <button type="button" @onclick="ClearFrontId" class="text-xs text-rose-500 hover:text-rose-600 hover:underline cursor-pointer font-medium inline-flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                            <span>Remove Photo</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Identity Card Upload (Back - Optional) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1]">
                        @Loc["Upgrade_Modal_IdBackLabel"].Value.TrimEnd('*', ' ') <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <div class="p-3 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container space-y-2 text-left">
                        <InputFile OnChange="HandleBackIdUpload" accept=".jpg,.jpeg,.png,.webp" class="w-full text-xs text-slate-500 dark:text-[#94A3B8] file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#1E3A8A] dark:file:text-white hover:file:bg-[#153252] dark:hover:file:bg-[#2563EB] cursor-pointer transition-colors" />
                        <p class="text-xs text-[#557392] dark:text-[#8FA3BC]">Optional reverse side for National Registration Card or Driver's License</p>
                        @if (!string.IsNullOrEmpty(backIdPreviewUrl))
                        {
                            <div class="flex items-start gap-4 p-3 rounded-lg bg-surface-container-lowest border border-slate-200 dark:border-surface-container-high/40">
                                <div class="relative group cursor-pointer shrink-0 rounded-lg overflow-hidden border border-slate-300 dark:border-surface-container-high shadow-xs bg-slate-900/60"
                                     @onclick="() => OpenEnlargedImage(backIdPreviewUrl, backIdFileName)" title="Click to enlarge">
                                    <img src="@backIdPreviewUrl" alt="Back ID Preview" class="w-48 h-32 sm:w-56 sm:h-36 object-contain p-1 rounded-lg transition duration-150 group-hover:scale-105" />
                                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-white text-xs font-semibold gap-1">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
                                        <span>Click to Enlarge</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0 space-y-1.5 pt-0.5">
                                    <button type="button" @onclick="() => OpenEnlargedImage(backIdPreviewUrl, backIdFileName)" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1.5 cursor-pointer">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
                                        <span>View Full Size Preview</span>
                                    </button>
                                    <p class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate" title="@backIdFileName">@backIdFileName</p>
                                    <div>
                                        <button type="button" @onclick="ClearBackId" class="text-xs text-rose-500 hover:text-rose-600 hover:underline cursor-pointer font-medium inline-flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                            <span>Remove Photo</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Certificate File Upload (Multiple Files Supported) -->
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1] flex items-center justify-between">
                        <span>Certificates &amp; Credentials</span>
                        <span class="text-[11px] font-normal text-[#557392] dark:text-[#8FA3BC]">(multiple uploads supported)</span>
                    </label>
                    <div class="p-3 rounded-lg border border-slate-300 dark:border-surface-container-high/60 bg-surface-container space-y-2 text-left">
                        <InputFile OnChange="HandleCertificatesUpload" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" class="w-full text-xs text-slate-500 dark:text-[#94A3B8] file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#1E3A8A] dark:file:text-white hover:file:bg-[#153252] dark:hover:file:bg-[#2563EB] cursor-pointer transition-colors" />
                        <p class="text-xs text-[#557392] dark:text-[#8FA3BC]">Upload degree diplomas, professional certifications, or licenses (PDF, JPG, PNG)</p>
                        @if (uploadedCertificates.Count > 0)
                        {
                            <div class="mt-2 space-y-1.5 text-left max-h-40 overflow-y-auto">
                                @for (int i = 0; i < uploadedCertificates.Count; i++)
                                {
                                    var index = i;
                                    var cert = uploadedCertificates[i];
                                    <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-lowest border border-surface-container-high/40 text-on-surface font-body-sm">
                                        <div class="flex items-center gap-2 truncate">
                                            <span class="material-symbols-outlined text-base text-[#0A1B2E] dark:text-blue-400">description</span>
                                            <span class="truncate font-medium text-xs">@cert.FileName</span>
                                            <span class="text-xs text-on-surface-variant shrink-0">(@FormatCertificateSize(cert.Bytes.Length))</span>
                                        </div>
                                        <button type="button" @onclick="() => RemoveCertificate(index)" class="text-rose-500 hover:text-rose-600 text-xs px-2 py-0.5 rounded cursor-pointer shrink-0 font-bold">
                                            ✕ Remove
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- LinkDrop Escrow Breakdown -->
                <div class="p-3 rounded-lg border border-slate-200 dark:border-surface-container-high/40 bg-surface-container space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded flex items-center justify-center font-bold text-xs"><LinkDropIcon Class="w-6 h-6 shrink-0" /></span>
                            <div>
                                <p class="text-xs font-bold text-on-surface">@Loc["Upgrade_Modal_EscrowPayment"]</p>
                                <p class="text-[11px] text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_EscrowDeducted"]</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-0.5 rounded text-[11px] font-bold @(userWalletDrops >= targetPlan.LinkDropCost ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 border border-rose-500/20 dark:bg-rose-950/40 dark:text-rose-400")">
                            @(userWalletDrops >= targetPlan.LinkDropCost ? Loc["Upgrade_Modal_SufficientBalance"] : Loc["Upgrade_Modal_InsufficientDrops"])
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 pt-2 border-t border-surface-container-high/30 text-center">
                        <div class="p-2 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="text-[11px] font-medium text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_Required"]</p>
                            <p class="font-mono font-bold text-xs text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@targetPlan.LinkDropCost.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-2 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="text-[11px] font-medium text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_YourBalance"]</p>
                            <p class="font-mono font-bold text-xs text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@userWalletDrops.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-2 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="text-[11px] font-medium text-[#557392] dark:text-[#8FA3BC]">@Loc["Upgrade_Modal_Remaining"]</p>
                            @if (userWalletDrops >= targetPlan.LinkDropCost)
                            {
                                <p class="font-mono font-bold text-xs text-emerald-600 mt-0.5 flex items-center justify-center gap-1.5">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    <span>@((userWalletDrops - targetPlan.LinkDropCost).ToString("N0"))</span>
                                </p>
                            }
                            else
                            {
                                <p class="font-mono font-bold text-xs text-rose-500 mt-0.5 flex items-center justify-center gap-1.5">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    <span>-@((targetPlan.LinkDropCost - userWalletDrops).ToString("N0"))</span>
                                </p>
                            }
                        </div>
                    </div>

                    @if (userWalletDrops < targetPlan.LinkDropCost)
                    {
                        <div class="p-2.5 rounded-lg bg-rose-500/10 border border-rose-500/20 dark:bg-rose-950/30 flex items-center justify-between gap-2 text-xs">
                            <span class="text-rose-700 dark:text-rose-300">@((MarkupString)string.Format(Loc["Upgrade_Modal_NeedMoreDrops"], $"<strong>{(targetPlan.LinkDropCost - userWalletDrops).ToString("N0")}</strong>"))</span>
                            <a href="linkdrops" target="_blank" class="px-3 py-1 rounded-lg bg-[#0A1B2E] hover:bg-[#153252] text-white dark:bg-[#1E3A8A] dark:hover:bg-[#2563EB] font-bold shrink-0 transition">@Loc["Upgrade_Modal_TopUpBtn"]</a>
                        </div>
                    }

                    <p class="text-xs text-[#557392] dark:text-[#8FA3BC] leading-relaxed flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm text-blue-600 dark:text-blue-400">shield</span>
                        <span><strong>@Loc["Upgrade_Modal_EscrowProtectionLabel"]</strong> @((MarkupString)string.Format(Loc["Upgrade_Modal_EscrowProtectionDesc"], targetPlan.LinkDropCost.ToString("N0")))</span>
                    </p>
                </div>

                <!-- Modal Actions -->
                <div class="flex items-center justify-end gap-space-sm pt-space-sm border-t border-surface-container-high/30">
                    <button type="button" @onclick="CloseUpgradeModal" class="px-3.5 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-surface-container-high text-on-surface-variant hover:bg-surface-container transition cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isSubmittingApplication" class="px-5 py-2.5 rounded-lg font-bold text-xs text-white bg-[#0A1B2E] hover:bg-[#153252] dark:bg-[#1E3A8A] dark:hover:bg-[#2563EB] dark:text-white shadow-sm transition flex items-center gap-2 cursor-pointer border border-[#0A1B2E] dark:border-[#2563EB]/40 disabled:opacity-50">
                        @if (isSubmittingApplication)
                        {
                            <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                            <span>@Loc["Upgrade_Modal_Submitting"]</span>
                        }
                        else
                        {
                            <span>@Loc["Upgrade_Modal_SubmitBtn", targetPlan.LinkDropCost.ToString("N0")]</span>
                            <span>&rarr;</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (isLightboxOpen && !string.IsNullOrEmpty(lightboxImageUrl))
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-md transition-opacity"
         @onclick="CloseLightbox">
        <div class="relative w-[90vw] md:w-[80vw] max-w-4xl max-h-[85vh] bg-white dark:bg-[#111622] border border-slate-200 dark:border-slate-700/60 rounded-2xl shadow-2xl overflow-hidden flex flex-col my-auto"
             @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="w-full flex items-center justify-between px-4 py-2.5 sm:px-5 sm:py-3 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#151B28] shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="material-symbols-outlined text-blue-600 dark:text-blue-400 text-base sm:text-lg shrink-0">visibility</span>
                    <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate">
                        @(string.IsNullOrEmpty(lightboxTitle) ? "Document Preview" : lightboxTitle)
                    </span>
                </div>
                <button type="button" @onclick="CloseLightbox" class="flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 transition cursor-pointer shrink-0">
                    <span>Close</span>
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <!-- Image View -->
            <div class="flex-1 overflow-auto p-3 sm:p-5 flex items-center justify-center bg-slate-950/80 max-h-[85vh]">
                <img src="@lightboxImageUrl" alt="Document Preview" class="w-full h-auto max-h-[75vh] object-contain rounded-lg shadow-lg block" />
            </div>
        </div>
    </div>
}

@code {
    private List<SubscriptionPlanDto>? plans;
    private UserSubscriptionStatusDto? myStatus;
    private long userWalletDrops = 0;
    private bool isAnnual = false;

    // Modal State
    private bool showUpgradeModal = false;
    private SubscriptionPlanDto? targetPlan;
    private bool isSubmittingApplication = false;
    private string? modalError;

    // Intake Form inputs
    private string inputLegalName = "";
    private string inputLocation = "";
    private string inputSkills = "";
    private string inputWorkEmail = "";
    private string inputProfessionalUrl = "";
    private string selectedPaymentMethod = "LinkDropPoints";
    private string selectedResponseSla = "Replies within 24 hours";

    private byte[]? frontIdBytes;
    private string? frontIdFileName;
    private string? frontIdPreviewUrl;
    private byte[]? backIdBytes;
    private string? backIdFileName;
    private string? backIdPreviewUrl;
    private bool isLightboxOpen = false;
    private string? lightboxImageUrl;
    private string? lightboxTitle;
    private List<CertificateUploadItem> uploadedCertificates = new();

    public record CertificateUploadItem(string FileName, byte[] Bytes, string ContentType);

    private SubscriptionPlanDto? SelectedDomainProPlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO");

    private SubscriptionPlanDto? SelectedPublicFigurePlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                       ?? user.FindFirst("role")?.Value 
                       ?? string.Empty;
            bool isAdmin = user.HasClaim("is_admin", "true") ||
                           user.IsInRole("ADMIN") ||
                           user.IsInRole("SYSTEM_ADMIN") ||
                           user.IsInRole("SYSTEMADMIN") ||
                           user.IsInRole("SUPERADMIN") ||
                           string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(role, "SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(role, "SYSTEMADMIN", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(role, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

            if (isAdmin)
            {
                Navigation.NavigateTo("/admin/dashboard", replace: true);
                return;
            }
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var plansRes = await PlanApi.GetActivePlansAsync();
        if (plansRes.IsSuccess && plansRes.Data != null)
        {
            plans = plansRes.Data.ToList();
        }

        var statusRes = await UpgradeApi.GetMyStatusAsync();
        if (statusRes.IsSuccess && statusRes.Data != null)
        {
            myStatus = statusRes.Data;
        }

        var walletRes = await LinkDropApi.GetUserWalletAsync();
        if (walletRes.IsSuccess && walletRes.Data != null)
        {
            userWalletDrops = walletRes.Data.Balance;
        }
    }

    private void OpenUpgradeModal(SubscriptionPlanDto? plan)
    {
        if (plan == null) return;
        targetPlan = plan;
        inputLegalName = "";
        inputLocation = "";
        inputSkills = "";
        inputWorkEmail = "";
        inputProfessionalUrl = "";
        selectedPaymentMethod = "LinkDropPoints";
        selectedResponseSla = "Replies within 24 hours";
        frontIdBytes = null;
        frontIdFileName = null;
        frontIdPreviewUrl = null;
        backIdBytes = null;
        backIdFileName = null;
        backIdPreviewUrl = null;
        isLightboxOpen = false;
        lightboxImageUrl = null;
        lightboxTitle = null;
        uploadedCertificates.Clear();
        modalError = null;
        showUpgradeModal = true;
    }

    private void CloseUpgradeModal()
    {
        showUpgradeModal = false;
        modalError = null;
    }

    private static string FormatCertificateSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):0.#} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):0.#} KB";
        return $"{bytes} B";
    }

    private async Task HandleCertificatesUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var files = e.GetMultipleFiles(maximumFileCount: 10);
        foreach (var file in files)
        {
            if (file.Size > 15 * 1024 * 1024)
            {
                modalError = $"File '{file.Name}' exceeds the maximum allowed size of 15MB.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(15 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                uploadedCertificates.Add(new CertificateUploadItem(file.Name, ms.ToArray(), file.ContentType));
            }
            catch (Exception ex)
            {
                modalError = $"Failed to read file '{file.Name}': {ex.Message}";
            }
        }
    }

    private void RemoveCertificate(int index)
    {
        if (index >= 0 && index < uploadedCertificates.Count)
        {
            uploadedCertificates.RemoveAt(index);
        }
    }

    private void ClearFrontId()
    {
        frontIdBytes = null;
        frontIdFileName = null;
        frontIdPreviewUrl = null;
    }

    private void ClearBackId()
    {
        backIdBytes = null;
        backIdFileName = null;
        backIdPreviewUrl = null;
    }

    private void OpenEnlargedImage(string url, string? title = null)
    {
        lightboxImageUrl = url;
        lightboxTitle = title ?? "Document Preview";
        isLightboxOpen = true;
    }

    private void CloseLightbox()
    {
        isLightboxOpen = false;
        lightboxImageUrl = null;
    }

    private async Task HandleFrontIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = Loc["Upgrade_Error_FrontIdSize"];
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            frontIdBytes = ms.ToArray();
            frontIdFileName = file.Name;

            try
            {
                var format = file.ContentType;
                if (string.IsNullOrWhiteSpace(format) || !format.StartsWith("image/"))
                {
                    format = "image/jpeg";
                }
                var resized = await file.RequestImageFileAsync(format, 1200, 1200);
                using var pStream = resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var pMs = new MemoryStream();
                await pStream.CopyToAsync(pMs);
                frontIdPreviewUrl = $"data:{format};base64,{Convert.ToBase64String(pMs.ToArray())}";
            }
            catch
            {
                frontIdPreviewUrl = null;
            }
        }
    }

    private async Task HandleBackIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = Loc["Upgrade_Error_BackIdSize"];
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            backIdBytes = ms.ToArray();
            backIdFileName = file.Name;

            try
            {
                var format = file.ContentType;
                if (string.IsNullOrWhiteSpace(format) || !format.StartsWith("image/"))
                {
                    format = "image/jpeg";
                }
                var resized = await file.RequestImageFileAsync(format, 1200, 1200);
                using var pStream = resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var pMs = new MemoryStream();
                await pStream.CopyToAsync(pMs);
                backIdPreviewUrl = $"data:{format};base64,{Convert.ToBase64String(pMs.ToArray())}";
            }
            catch
            {
                backIdPreviewUrl = null;
            }
        }
    }

    private async Task SubmitUpgradeApplicationAsync()
    {
        modalError = null;
        if (targetPlan == null) return;

        if (string.IsNullOrWhiteSpace(inputLegalName))
        {
            modalError = Loc["Upgrade_Error_LegalNameRequired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(inputLocation))
        {
            modalError = "Location is mandatory for verification.";
            return;
        }

        if (string.IsNullOrWhiteSpace(inputSkills))
        {
            modalError = "Skills & Competencies are mandatory for verification.";
            return;
        }

        if (frontIdBytes == null || string.IsNullOrWhiteSpace(frontIdFileName))
        {
            modalError = Loc["Upgrade_Error_FrontIdRequired"];
            return;
        }

        if (targetPlan.LinkDropCost > 0 && userWalletDrops < targetPlan.LinkDropCost)
        {
            modalError = string.Format(Loc["Upgrade_Error_InsufficientDrops"], (targetPlan.LinkDropCost - userWalletDrops).ToString("N0"));
            return;
        }

        isSubmittingApplication = true;
        var certPayload = uploadedCertificates
            .Select(c => (c.Bytes, c.FileName, c.ContentType))
            .ToList();

        var res = await UpgradeApi.ApplyForUpgradeAsync(
            planId: targetPlan.PlanId,
            fullLegalName: inputLegalName.Trim(),
            workEmail: inputWorkEmail,
            professionalUrl: inputProfessionalUrl,
            paymentMethod: selectedPaymentMethod,
            idCardFrontBytes: frontIdBytes,
            idCardFrontFileName: frontIdFileName,
            idCardBackBytes: backIdBytes,
            idCardBackFileName: backIdFileName,
            responseSlaText: selectedResponseSla,
            skills: inputSkills.Trim(),
            location: inputLocation.Trim(),
            certificates: certPayload
        );
        isSubmittingApplication = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["Upgrade_Success_Submitted"]);
            showUpgradeModal = false;
            await LoadDataAsync();
        }
        else
        {
            modalError = !string.IsNullOrWhiteSpace(res.Message) ? res.Message : string.Format(Loc["Upgrade_Error_Failed"], "Unknown error");
        }
    }
}
