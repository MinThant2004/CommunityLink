                    <div>
                        <p class="font-title-md font-bold text-on-surface">@targetPlan.PlanName</p>
                        <p class="font-label-sm text-on-surface-variant">@Loc["Upgrade_Modal_Duration", targetPlan.DurationDays, targetPlan.BillingInterval]</p>
                    </div>
                    <div class="text-right">
                        <p class="font-title-lg font-mono font-bold text-[#0A1B2E] dark:text-[#D4AF37] flex items-center justify-end gap-1.5">
                            <LinkDropIcon Class="w-4 h-4 shrink-0" />
                            <span>@Loc["Upgrade_Modal_DropsCost", targetPlan.LinkDropCost.ToString("N0")]</span>
                        </p>
                        <p class="font-label-sm text-on-surface-variant">@Loc["Upgrade_Modal_EscrowDeposit"]</p>
                    </div>
                </div>

                <!-- Legal Full Name -->
                <div class="space-y-1">
                    <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                        @Loc["Upgrade_Modal_LegalNameLabel"] <span class="text-error font-bold">*</span>
                    </label>
                    <input type="text" required placeholder="@Loc["Upgrade_Modal_LegalNamePlaceholder"]" @bind="inputLegalName"
                           class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-[#D4AF37] outline-none" />
                </div>

                <!-- Location (Mandatory) -->
