<!-- IDENTITY AUDIT INTAKE & CHECKOUT MODAL -->
@if (showUpgradeModal && targetPlan != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-surface-container-low rounded-xl shadow-2xl border border-surface-container-high/40 max-w-xl w-full p-space-md md:p-space-lg space-y-space-md text-on-surface max-h-[92vh] overflow-y-auto">

            <!-- Modal Header -->
            <div class="flex items-start justify-between border-b border-surface-container-high/30 pb-space-sm">
                <div>
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-[#0A1B2E] dark:text-[#D4AF37] font-bold">
                        Identity Verification Audit
                    </span>
                    <h3 class="font-title-lg font-bold text-on-surface mt-0.5">
                        Upgrade to @targetPlan.PlanName
                    </h3>
                </div>
                <button type="button" @onclick="CloseUpgradeModal" class="text-on-surface-variant hover:text-on-surface text-xl leading-none cursor-pointer">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="p-space-sm bg-error/10 border border-error/30 text-error font-body-sm text-body-sm rounded-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-base shrink-0">error</span>
                    <span>@modalError</span>
                </div>
            }

            <form @onsubmit="SubmitUpgradeApplicationAsync" class="space-y-4 font-body-sm text-body-sm">

                <!-- Plan Summary Box -->
                <div class="p-space-sm rounded-lg bg-surface-container border border-surface-container-high/30 flex items-center justify-between">
                    <div>
                        <p class="font-title-md font-bold text-on-surface">@targetPlan.PlanName</p>
                        <p class="font-label-sm text-on-surface-variant">Duration: @targetPlan.DurationDays Days &bull; @targetPlan.BillingInterval</p>
                    </div>
                    <div class="text-right">
                        <p class="font-title-lg font-mono font-bold text-[#0A1B2E] dark:text-[#D4AF37] flex items-center justify-end gap-1.5">
                            <LinkDropIcon Class="w-4 h-4 shrink-0" />
                            <span>@targetPlan.LinkDropCost.ToString("N0") Drops</span>
                        </p>
                        <p class="font-label-sm text-on-surface-variant">Escrow Deposit</p>
                    </div>
                </div>

                <!-- Legal Full Name -->
                <div class="space-y-1">
                    <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                        Full Legal Name (matching Identity Card) *
                    </label>
                    <input type="text" required placeholder="e.g. Elena Rostova" @bind="inputLegalName"
                           class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-[#D4AF37] outline-none" />
                </div>

                <!-- Professional Credentials / Links -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
                    <div class="space-y-1">
                        <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                            Work Email (Optional)
                        </label>
                        <input type="email" placeholder="elena@company.com" @bind="inputWorkEmail"
                               class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-[#D4AF37] outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                            LinkedIn / GitHub / Portfolio URL
                        </label>
                        <input type="url" placeholder="https://linkedin.com/in/elena" @bind="inputProfessionalUrl"
                               class="w-full px-3 py-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest text-on-surface font-body-sm focus:border-[#0A1B2E] dark:focus:border-[#D4AF37] outline-none" />
                    </div>
                </div>

                <!-- Identity Card Upload (Front) -->
                <div class="space-y-1">
                    <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                        Identity Card / Government ID (Front) *
                    </label>
                    <div class="p-space-sm rounded-lg border border-dashed border-outline-variant/60 bg-surface-container text-center space-y-1.5">
                        <InputFile OnChange="HandleFrontIdUpload" accept=".jpg,.jpeg,.png,.webp" class="font-body-sm file:mr-3 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:font-label-sm file:font-bold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#D4AF37] dark:file:text-[#0A0D14] hover:file:opacity-90 cursor-pointer" />
                        <p class="font-label-sm text-on-surface-variant">National Registration Card, Passport, or Driver's License (JPG, PNG, max 10MB)</p>
                        @if (!string.IsNullOrEmpty(frontIdFileName))
                        {
                            <p class="font-body-sm text-emerald-600 font-bold">✓ Selected: @frontIdFileName</p>
                        }
                    </div>
                </div>

                <!-- Identity Card Upload (Back - Optional) -->
                <div class="space-y-1">
                    <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">
                        Identity Card (Back - Optional)
                    </label>
                    <div class="p-space-sm rounded-lg border border-dashed border-outline-variant/60 bg-surface-container text-center space-y-1.5">
                        <InputFile OnChange="HandleBackIdUpload" accept=".jpg,.jpeg,.png,.webp" class="font-body-sm file:mr-3 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:font-label-sm file:font-bold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#D4AF37] dark:file:text-[#0A0D14] hover:file:opacity-90 cursor-pointer" />
                        @if (!string.IsNullOrEmpty(backIdFileName))
                        {
                            <p class="font-body-sm text-emerald-600 font-bold">✓ Selected: @backIdFileName</p>
                        }
                    </div>
                </div>

                <!-- LinkDrop Escrow Breakdown -->
                <div class="p-space-sm rounded-lg border @(userWalletDrops >= targetPlan.LinkDropCost ? "border-[#0A1B2E]/20 dark:border-[#D4AF37]/30 bg-surface-container" : "border-amber-500/20 bg-amber-500/5") space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded flex items-center justify-center font-bold text-xs"><LinkDropIcon Class="w-6 h-6 shrink-0" /></span>
                            <div>
                                <p class="font-label-md text-label-md font-bold text-on-surface">LinkDrop Escrow Payment</p>
                                <p class="font-label-sm text-on-surface-variant">Deducted on submission &amp; held in escrow</p>
                            </div>
                        </div>
                        <span class="px-space-sm py-0.5 rounded font-label-sm text-label-sm uppercase tracking-wider font-bold @(userWalletDrops >= targetPlan.LinkDropCost ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-amber-500/10 text-amber-600 border border-amber-500/20")">
                            @(userWalletDrops >= targetPlan.LinkDropCost ? "Sufficient Balance" : "Insufficient Drops")
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 pt-2 border-t border-surface-container-high/30 text-center">
                        <div class="p-1.5 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="font-label-sm text-on-surface-variant uppercase">Required</p>
                            <p class="font-mono font-bold font-body-sm text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@targetPlan.LinkDropCost.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-1.5 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="font-label-sm text-on-surface-variant uppercase">Your Balance</p>
                            <p class="font-mono font-bold font-body-sm text-on-surface mt-0.5 flex items-center justify-center gap-1.5">
                                <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                <span>@userWalletDrops.ToString("N0")</span>
                            </p>
                        </div>
                        <div class="p-1.5 rounded bg-surface-container-lowest border border-surface-container-high/30">
                            <p class="font-label-sm text-on-surface-variant uppercase">Remaining</p>
                            @if (userWalletDrops >= targetPlan.LinkDropCost)
                            {
                                <p class="font-mono font-bold font-body-sm text-emerald-600 mt-0.5 flex items-center justify-center gap-1.5">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    <span>@((userWalletDrops - targetPlan.LinkDropCost).ToString("N0"))</span>
                                </p>
                            }
                            else
                            {
                                <p class="font-mono font-bold font-body-sm text-error mt-0.5 flex items-center justify-center gap-1.5">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    <span>-@((targetPlan.LinkDropCost - userWalletDrops).ToString("N0"))</span>
                                </p>
                            }
                        </div>
                    </div>

                    @if (userWalletDrops < targetPlan.LinkDropCost)
                    {
                        <div class="p-2 rounded bg-amber-500/10 border border-amber-500/20 flex items-center justify-between gap-2 font-body-sm">
                            <span class="text-amber-700 dark:text-amber-300">Need <strong>@((targetPlan.LinkDropCost - userWalletDrops).ToString("N0"))</strong> more LinkDrops to apply.</span>
                            <a href="linkdrops" target="_blank" class="px-2.5 py-1 rounded bg-amber-600 hover:bg-amber-700 text-white font-bold shrink-0 font-label-sm transition">Top Up &rarr;</a>
                        </div>
                    }

                    <p class="font-label-sm text-on-surface-variant leading-relaxed flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs text-[#0A1B2E] dark:text-[#D4AF37]">shield</span>
                        <span><strong>Escrow Protection:</strong> Drops are held during SecOps audit. If rejected, your @targetPlan.LinkDropCost.ToString("N0") Drops are automatically refunded to your wallet.</span>
                    </p>
                </div>

                <!-- Modal Actions -->
                <div class="flex items-center justify-end gap-space-sm pt-space-sm border-t border-surface-container-high/30">
                    <button type="button" @onclick="CloseUpgradeModal" class="px-3.5 py-2 rounded-lg font-label-md text-label-md font-semibold border border-outline-variant/60 text-on-surface-variant hover:bg-surface-container transition">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isSubmittingApplication" class="upgrade-btn-primary px-5 py-2 rounded-lg font-label-md text-label-md font-bold text-white dark:text-[#0A0D14] bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#D4AF37] dark:hover:bg-[#F2CA50] shadow-sm transition flex items-center gap-2 cursor-pointer">
                        @if (isSubmittingApplication)
                        {
                            <span class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white dark:border-[#0A0D14] border-t-transparent"></span>
                            <span>Submitting Application...</span>
                        }
                        else
                        {
                            <span>Submit for Verification Audit (@targetPlan.LinkDropCost.ToString("N0") Drops)</span>
                            <span>&rarr;</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private List<SubscriptionPlanDto>? plans;
    private UserSubscriptionStatusDto? myStatus;
    private long userWalletDrops = 0;
    private bool isAnnual = false;

    // Modal State
    private bool showUpgradeModal = false;
    private SubscriptionPlanDto? targetPlan;
    private bool isSubmittingApplication = false;
    private string? modalError;

    // Intake Form inputs
    private string inputLegalName = "";
    private string inputWorkEmail = "";
    private string inputProfessionalUrl = "";
    private string selectedPaymentMethod = "LinkDropPoints";

    private byte[]? frontIdBytes;
    private string? frontIdFileName;
    private byte[]? backIdBytes;
    private string? backIdFileName;

    private SubscriptionPlanDto? SelectedDomainProPlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO");

    private SubscriptionPlanDto? SelectedPublicFigurePlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE");

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var plansRes = await PlanApi.GetActivePlansAsync();
        if (plansRes.IsSuccess && plansRes.Data != null)
        {
            plans = plansRes.Data.ToList();
        }

        var statusRes = await UpgradeApi.GetMyStatusAsync();
        if (statusRes.IsSuccess && statusRes.Data != null)
        {
            myStatus = statusRes.Data;
        }

        var walletRes = await LinkDropApi.GetUserWalletAsync();
        if (walletRes.IsSuccess && walletRes.Data != null)
        {
            userWalletDrops = walletRes.Data.Balance;
        }
    }

    private void OpenUpgradeModal(SubscriptionPlanDto? plan)
    {
        if (plan == null) return;
        targetPlan = plan;
        inputLegalName = "";
        inputWorkEmail = "";
        inputProfessionalUrl = "";
        selectedPaymentMethod = "LinkDropPoints";
        frontIdBytes = null;
        frontIdFileName = null;
        backIdBytes = null;
        backIdFileName = null;
        modalError = null;
        showUpgradeModal = true;
    }

    private void CloseUpgradeModal()
    {
        showUpgradeModal = false;
        modalError = null;
    }

    private async Task HandleFrontIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = "Identity Card file size cannot exceed 10MB.";
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            frontIdBytes = ms.ToArray();
            frontIdFileName = file.Name;
        }
    }

    private async Task HandleBackIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = "Back of Identity Card file size cannot exceed 10MB.";
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            backIdBytes = ms.ToArray();
            backIdFileName = file.Name;
        }
    }

    private async Task SubmitUpgradeApplicationAsync()
    {
        modalError = null;
        if (targetPlan == null) return;

        if (string.IsNullOrWhiteSpace(inputLegalName))
        {
            modalError = "Full Legal Name is required.";
            return;
        }

        if (frontIdBytes == null || string.IsNullOrWhiteSpace(frontIdFileName))
        {
            modalError = "Please upload the front image of your Identity Card.";
            return;
        }

        if (targetPlan.LinkDropCost > 0 && userWalletDrops < targetPlan.LinkDropCost)
        {
            modalError = $"Insufficient LinkDrop balance. You need {(targetPlan.LinkDropCost - userWalletDrops):N0} more Drops to apply.";
            return;
        }

        isSubmittingApplication = true;
        var res = await UpgradeApi.ApplyForUpgradeAsync(
            planId: targetPlan.PlanId,
            fullLegalName: inputLegalName.Trim(),
            workEmail: inputWorkEmail,
            professionalUrl: inputProfessionalUrl,
            paymentMethod: selectedPaymentMethod,
            idCardFrontBytes: frontIdBytes,
            idCardFrontFileName: frontIdFileName,
            idCardBackBytes: backIdBytes,
            idCardBackFileName: backIdFileName
        );
        isSubmittingApplication = false;

        if (res.IsSuccess)
        {
            Toast.Success("Application submitted! Your Identity Verification Audit is now in progress.");
            showUpgradeModal = false;
            await LoadDataAsync();
        }
        else
        {
            modalError = res.Message;
        }
    }
}
