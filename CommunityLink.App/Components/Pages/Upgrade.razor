                    <label class="block font-label-sm text-label-sm font-bold text-on-surface-variant uppercase tracking-wider flex items-center justify-between">
                        <span>Certificates &amp; Credentials</span>
                        <span class="text-[11px] font-normal text-on-surface-variant lowercase">(multiple uploads supported)</span>
                    </label>
                    <div class="p-space-sm rounded-lg border border-dashed border-outline-variant/60 bg-surface-container text-center space-y-2">
                        <InputFile OnChange="HandleCertificatesUpload" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" class="font-body-sm file:mr-3 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:font-label-sm file:font-bold file:bg-[#0A1B2E] file:text-white dark:file:bg-[#D4AF37] dark:file:text-[#0A0D14] hover:file:opacity-90 cursor-pointer" />
