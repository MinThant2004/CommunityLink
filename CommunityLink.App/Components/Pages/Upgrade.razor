@page "/upgrade"
@page "/membership"
@attribute [Authorize]
@inject SubscriptionPlanApiService PlanApi
@inject PremiumUpgradeApiService UpgradeApi
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Elevate Your Authority — CommunityLink</PageTitle>

<div class="max-w-7xl mx-auto space-y-16 py-8 px-4 sm:px-6">

    <!-- Top Hero Section -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-bold tracking-wider uppercase bg-amber-500/10 text-amber-500 border border-amber-500/30">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>VERIFIED REPUTATION &amp; MONETIZATION | TIER UPGRADE</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">
            Elevate Your Authority. <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Monetize Your Expertise.</span>
        </h1>

        <p class="text-sm sm:text-base text-[#557392] dark:text-[#C4D2E1] max-w-2xl mx-auto leading-relaxed">
            Unlock verified credential badges, accept paid 1-on-1 consultations with built-in escrow, collect peer ratings, and command sovereign sub-communities on CommunityLink.
        </p>

        <!-- Billing Interval Toggle -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <div class="inline-flex items-center p-1 rounded-xl bg-[#F1F5F9] dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] shadow-inner">
                <button type="button" @onclick='() => isAnnual = false'
                        class="px-4 py-2 rounded-lg text-xs font-bold transition @(!isAnnual ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E]")">
                    Monthly Billing
                </button>
                <button type="button" @onclick='() => isAnnual = true'
                        class="px-4 py-2 rounded-lg text-xs font-bold transition @(isAnnual ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E]")">
                    Annual Billing
                </button>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>Save up to 20% &bull; Expedited 24h Audit</span>
            </span>
        </div>
    </div>

    <!-- Active Subscription Notice (if member already upgraded) -->
    @if (myStatus?.HasActiveSubscription == true)
    {
        <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 text-emerald-900 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div>
                    <h3 class="font-bold text-base">Active Membership: @myStatus.TierName</h3>
                    <p class="text-xs text-emerald-700">Valid until @(myStatus.ExpiresAtUtc?.ToString("MMMM dd, yyyy")) (@myStatus.DaysRemaining days remaining).</p>
                </div>
            </div>
            <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-600 text-white shadow-sm">
                Verified Identity Active
            </span>
        </div>
    }
    else if (myStatus?.PendingVerification != null)
    {
        <div class="p-6 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 text-amber-900 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0 animate-pulse">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                    <h3 class="font-bold text-base">SecOps Verification In Progress</h3>
                    <p class="text-xs text-amber-700">Your application for <strong>@myStatus.PendingVerification.PlanName</strong> is currently being audited by administrators. Identity documents under review.</p>
                </div>
            </div>
            <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-amber-500 text-white shadow-sm">
                PENDING REVIEW
            </span>
        </div>
    }

    <!-- 3-TIER PRICING CARDS -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">

        <!-- 1. Normal User (Current Plan) -->
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] p-8 flex flex-col justify-between shadow-sm relative">
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-slate-100 dark:bg-[#1B3B5A] text-slate-700 dark:text-slate-300">
                        CURRENT PLAN
                    </span>
                    <svg class="w-5 h-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>

                <div>
                    <h3 class="text-xl font-bold text-[#0A1B2E] dark:text-white">Normal User</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Foundational access for curious learners and active discussion participants.</p>
                </div>

                <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-extrabold text-[#0A1B2E] dark:text-white font-mono">$0</span>
                    <span class="text-xs text-[#7A8CA6]">/ forever</span>
                </div>

                <ul class="space-y-3 text-xs text-[#334155] dark:text-[#C4D2E1] pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                    <li class="flex items-start gap-2.5">
                        <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                        <span>Discover feeds, posts, and public discussions</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                        <span>Join instant &amp; approval-required communities</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                        <span>Create articles, links, and poll votes</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                        <span>Direct messaging (1-on-1 networking)</span>
                    </li>
                    <li class="flex items-start gap-2.5 text-slate-400">
                        <span class="text-slate-300">✕</span>
                        <span>No paid 1-on-1 consultations</span>
                    </li>
                    <li class="flex items-start gap-2.5 text-slate-400">
                        <span class="text-slate-300">✕</span>
                        <span>No verified identity badge</span>
                    </li>
                </ul>
            </div>

            <div class="pt-8">
                <button disabled class="w-full py-3 rounded-xl text-xs font-bold text-slate-500 bg-slate-100 dark:bg-[#1B3B5A] cursor-not-allowed">
                    Current Active Tier
                </button>
            </div>
        </div>

        <!-- 2. Domain Professional (PRO) -->
        @{
            var proPlan = SelectedDomainProPlan;
        }
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border-2 border-amber-400 dark:border-amber-500 p-8 flex flex-col justify-between shadow-xl relative overflow-hidden">
            <div class="absolute -top-3 right-6 bg-gradient-to-r from-amber-500 to-amber-600 text-white font-mono text-[9px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md flex items-center gap-1">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <span>RECOMMENDED FOR PRACTITIONERS</span>
            </div>

            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span>DOMAIN PROFESSIONAL &bull; PRO</span>
                    </span>
                    <span class="text-xs font-mono text-emerald-600 font-bold">Audit Pass Rate: 91%</span>
                </div>

                <div>
                    <h3 class="text-2xl font-bold text-[#0A1B2E] dark:text-white">Domain Professional</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Official verified badge on all feeds, comments, and profile hero.</p>
                </div>

                <div class="p-4 rounded-xl bg-amber-50/50 dark:bg-[#1B3B5A]/60 border border-amber-200/60 dark:border-amber-500/20 space-y-1">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-extrabold text-[#0A1B2E] dark:text-white font-mono">
                            $@(proPlan != null ? proPlan.PriceAmount.ToString("F0") : "39")
                        </span>
                        <span class="text-xs text-[#7A8CA6]">/ @(isAnnual ? "year (billed annually)" : "month")</span>
                    </div>
                    @if (proPlan?.LinkDropCost > 0)
                    {
                        <p class="text-xs text-blue-600 dark:text-blue-400 font-semibold flex items-center gap-1 font-mono">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                            <span>@proPlan.LinkDropCost.ToString("N0") LinkDrop Points balance equivalent</span>
                        </p>
                    }
                </div>

                <ul class="space-y-3 text-xs text-[#334155] dark:text-[#C4D2E1] pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span><strong>1-on-1 Paid Advisory Engine:</strong> Set custom hourly consultation rates ($100-$1,000/hr) with automated escrow.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span><strong>Public Peer Rating &amp; Review Card:</strong> Showcase validated peer reviews (1-on-1 rating engine) on your profile.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span><strong>Priority Sub-Community Ownership:</strong> Create up to 5 sovereign sub-groups with custom entry criteria.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <span><strong>Credential Verification:</strong> GitHub, LinkedIn, domain-accredited patents, or corporate email verification.</span>
                    </li>
                </ul>
            </div>

            <div class="pt-8 space-y-2">
                <button type="button" @onclick="() => OpenUpgradeModal(proPlan)"
                        class="w-full py-3.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 shadow-lg shadow-amber-500/20 transition flex items-center justify-center gap-2 cursor-pointer">
                    <span>Upgrade to Domain Pro</span>
                    <span>&rarr;</span>
                </button>
                <p class="text-[10px] text-center text-[#7A8CA6] font-mono">Includes 5-day expedited audit turnaround</p>
            </div>
        </div>

        <!-- 3. Public Figure VIP (VIP) -->
        @{
            var vipPlan = SelectedPublicFigurePlan;
        }
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border-2 border-purple-500 dark:border-purple-600 p-8 flex flex-col justify-between shadow-xl relative overflow-hidden">
            <div class="absolute -top-3 right-6 bg-gradient-to-r from-purple-600 to-indigo-700 text-white font-mono text-[9px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md flex items-center gap-1">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                <span>INDUSTRY LUMINARIES &amp; LEADERS</span>
            </div>

            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                        <span>PUBLIC FIGURE &bull; VIP</span>
                    </span>
                    <span class="text-xs font-mono text-purple-600 font-bold">Tier 1 Compliant</span>
                </div>

                <div>
                    <h3 class="text-2xl font-bold text-[#0A1B2E] dark:text-white">Public Figure VIP</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Unlock sovereign VIP badge and home shelf discovery placement.</p>
                </div>

                <div class="p-4 rounded-xl bg-purple-50/50 dark:bg-[#1B3B5A]/60 border border-purple-200/60 dark:border-purple-500/20 space-y-1">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-extrabold text-[#0A1B2E] dark:text-white font-mono">
                            $@(vipPlan != null ? vipPlan.PriceAmount.ToString("F0") : "119")
                        </span>
                        <span class="text-xs text-[#7A8CA6]">/ @(isAnnual ? "year (billed annually)" : "month")</span>
                    </div>
                    @if (vipPlan?.LinkDropCost > 0)
                    {
                        <p class="text-xs text-blue-600 dark:text-blue-400 font-semibold flex items-center gap-1 font-mono">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                            <span>@vipPlan.LinkDropCost.ToString("N0") LinkDrop Points balance equivalent</span>
                        </p>
                    }
                </div>

                <ul class="space-y-3 text-xs text-[#334155] dark:text-[#C4D2E1] pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-purple-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                        <span><strong>Discovery Shelf Priority:</strong> Guaranteed rotating feature spot in 'Verified Public Figures' on the Home Dashboard.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-purple-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                        <span><strong>Unlimited Sovereign Communities:</strong> Manage private working groups with custom criteria and token-gating.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-purple-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                        <span><strong>0% Platform Fees:</strong> 0% commission on your first $10,000 of paid advisory bookings each year.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <svg class="w-3.5 h-3.5 text-purple-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V9M19 21V9M9 21V9M15 21V9M2 9l10-6 10 6"/></svg>
                        <span><strong>Dedicated Admin Concierge:</strong> Direct channel with SecOps and 12-hour turnaround for audits.</span>
                    </li>
                </ul>
            </div>

            <div class="pt-8 space-y-2">
                <button type="button" @onclick="() => OpenUpgradeModal(vipPlan)"
                        class="w-full py-3.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-purple-600 to-indigo-700 hover:from-purple-700 hover:to-indigo-800 shadow-lg shadow-purple-600/20 transition flex items-center justify-center gap-2 cursor-pointer">
                    <span>Apply for Public Figure VIP</span>
                    <span>&rarr;</span>
                </button>
                <p class="text-[10px] text-center text-[#7A8CA6] font-mono">Requires Government ID / Identity Card verification</p>
            </div>
        </div>

    </div>

    <!-- HOW THE VERIFICATION AUDIT WORKS (4-STEP PROGRESS) -->
    <div class="space-y-8 pt-6">
        <div class="text-center space-y-2 max-w-xl mx-auto">
            <span class="text-[10px] font-mono font-bold tracking-widest text-indigo-600 dark:text-indigo-400 uppercase">
                STANDARD OPERATING PROCEDURE
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">
                How the Verification Audit Works
            </h2>
            <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">
                CommunityLink is an audited trust network. We maintain high signal by thoroughly screening identity and credentials before badge deployment.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.12)] space-y-3 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-300">01</span>
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
                <h4 class="font-bold text-sm text-[#0A1B2E] dark:text-white">Select &amp; Checkout</h4>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Pick your tier. Verification audit fee is held in escrow until audit conclusion. Fully refunded if verification cannot be concluded.</p>
            </div>

            <div class="bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.12)] space-y-3 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-amber-50 dark:bg-amber-900/40 text-amber-600 dark:text-amber-300">02</span>
                    <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="8" cy="10" r="2"/><path d="M14 9h4M14 13h4M6 16c0-1.5 1.5-2 3-2s3 .5 3 2"/></svg>
                </div>
                <h4 class="font-bold text-sm text-[#0A1B2E] dark:text-white">Submit Credentials</h4>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Upload your government Identity Card front/back, work email, GitHub, LinkedIn, or domain portfolio proof for audit examination.</p>
            </div>

            <div class="bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.12)] space-y-3 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-300">03</span>
                    <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h4 class="font-bold text-sm text-[#0A1B2E] dark:text-white">SecOps Review</h4>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Dedicated administrative review team cross-examines submissions against public registries. The review action is logged.</p>
            </div>

