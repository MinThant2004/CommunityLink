@code {
    private List<SubscriptionPlanDto>? plans;
    private UserSubscriptionStatusDto? myStatus;
    private long userWalletDrops = 0;
    private bool isAnnual = false;
    private int openFaqIndex = 0;

    // Modal State
    private bool showUpgradeModal = false;
    private SubscriptionPlanDto? targetPlan;
    private bool isSubmittingApplication = false;
    private string? modalError;

    // Intake Form inputs
    private string inputLegalName = "";
    private string inputWorkEmail = "";
    private string inputProfessionalUrl = "";
    private string selectedPaymentMethod = "LinkDropPoints";

    private byte[]? frontIdBytes;
    private string? frontIdFileName;
    private byte[]? backIdBytes;
    private string? backIdFileName;

    private SubscriptionPlanDto? SelectedDomainProPlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "DOMAIN_PRO");

    private SubscriptionPlanDto? SelectedPublicFigurePlan =>
        plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE" && (isAnnual ? p.BillingInterval == "Annual" : p.BillingInterval == "Monthly"))
        ?? plans?.FirstOrDefault(p => p.TargetRoleCode == "PUBLIC_FIGURE");

    private sealed record FaqItem(string Question, string Answer);

    private readonly List<FaqItem> faqItems =
    [
        new("What happens if my verification audit is rejected?", "If the SecOps team cannot verify your credentials or if your Identity Card documentation is illegible, your application will be marked as Rejected with specific feedback. Any LinkDrop points held in escrow are immediately and automatically refunded to your wallet."),
        new("How do 1-on-1 advisory bookings and client payouts work?", "Once verified as a Domain Professional or Public Figure, you can set your own advisory rates and connect your payout method. Clients book 1-on-1 consultations directly through your profile with built-in platform escrow."),
        new("Can I upgrade from Domain Pro to Public Figure VIP later?", "Yes. You can upgrade to Public Figure VIP at any time. Your remaining credit from your Domain Pro plan will be prorated towards your VIP subscription."),
        new("How do public peer ratings maintain integrity against spam?", "Only users who have confirmed verified interactions, consultations, or project collaborations with you can submit a rating. Ratings undergo cryptographic tamper checks and anomaly detection.")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var plansRes = await PlanApi.GetActivePlansAsync();
        if (plansRes.IsSuccess && plansRes.Data != null)
        {
            plans = plansRes.Data.ToList();
        }

        var statusRes = await UpgradeApi.GetMyStatusAsync();
        if (statusRes.IsSuccess && statusRes.Data != null)
        {
            myStatus = statusRes.Data;
        }

        var walletRes = await LinkDropApi.GetUserWalletAsync();
        if (walletRes.IsSuccess && walletRes.Data != null)
        {
            userWalletDrops = walletRes.Data.Balance;
        }
    }

    private void ToggleFaq(int index)
    {
        openFaqIndex = openFaqIndex == index ? -1 : index;
    }

    private void OpenUpgradeModal(SubscriptionPlanDto? plan)
    {
        if (plan == null) return;
        targetPlan = plan;
        inputLegalName = "";
        inputWorkEmail = "";
        inputProfessionalUrl = "";
        selectedPaymentMethod = "LinkDropPoints";
        frontIdBytes = null;
        frontIdFileName = null;
        backIdBytes = null;
        backIdFileName = null;
        modalError = null;
        showUpgradeModal = true;
    }

    private void CloseUpgradeModal()
    {
        showUpgradeModal = false;
        modalError = null;
    }

    private async Task HandleFrontIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = "Identity Card file size cannot exceed 10MB.";
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            frontIdBytes = ms.ToArray();
            frontIdFileName = file.Name;
        }
    }

    private async Task HandleBackIdUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                modalError = "Back of Identity Card file size cannot exceed 10MB.";
                return;
            }
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            backIdBytes = ms.ToArray();
            backIdFileName = file.Name;
        }
    }

    private async Task SubmitUpgradeApplicationAsync()
    {
        modalError = null;
        if (targetPlan == null) return;

        if (string.IsNullOrWhiteSpace(inputLegalName))
        {
            modalError = "Full Legal Name is required.";
            return;
        }

        if (frontIdBytes == null || string.IsNullOrWhiteSpace(frontIdFileName))
        {
            modalError = "Please upload the front image of your Identity Card.";
            return;
        }

        isSubmittingApplication = true;
        var res = await UpgradeApi.ApplyForUpgradeAsync(
            planId: targetPlan.PlanId,
            fullLegalName: inputLegalName.Trim(),
            workEmail: inputWorkEmail,
            professionalUrl: inputProfessionalUrl,
            paymentMethod: selectedPaymentMethod,
            idCardFrontBytes: frontIdBytes,
            idCardFrontFileName: frontIdFileName,
            idCardBackBytes: backIdBytes,
            idCardBackFileName: backIdFileName
        );
        isSubmittingApplication = false;

        if (res.IsSuccess)
        {
            Toast.Success("Application submitted! Your Identity Verification Audit is now in progress.");
            showUpgradeModal = false;
            await LoadDataAsync();
        }
        else
        {
            modalError = res.Message;
        }
    }
}
