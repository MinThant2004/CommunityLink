<div class="px-4 sm:px-6 py-3.5 bg-white border-b border-slate-200 flex items-center justify-between gap-4 shrink-0 shadow-2xs">
    <div class="flex items-center gap-3 min-w-0">
        <!-- Back Navigation Link -->
        <a href="/chat-groups" class="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-slate-200 rounded-xl transition shrink-0" title="Back to Chat Groups">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </a>

        <!-- Group Avatar & Title (Clicking opens info modal) -->
        <div @onclick="OnToggleInfo" class="flex items-center gap-3 min-w-0 cursor-pointer group">
            <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 text-indigo-600 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                @if (!string.IsNullOrWhiteSpace(Group.AvatarUrl))
                {
                    <img src="@Group.AvatarUrl" alt="@Group.Name" class="w-full h-full object-cover" />
                }
                else
                {
                    <span>@(Group.Name.Substring(0, 1).ToUpper())</span>
                }
            </div>

            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h2 class="font-bold text-slate-900 text-base truncate group-hover:text-indigo-600 transition">
                        @Group.Name
                    </h2>
                    @if (Group.ChatType == "PAID")
                    {
                        <span class="px-2 py-0.5 bg-amber-50 border border-amber-200 text-amber-700 font-semibold text-[11px] rounded-md flex items-center gap-0.5">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 bg-emerald-50 border border-emerald-200 text-emerald-700 font-semibold text-[11px] rounded-md flex items-center gap-0.5">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            Free
                        </span>
                    }
                </div>
                <div class="text-xs text-slate-500 truncate flex items-center gap-2 mt-0.5">
                    <span class="flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                        @Group.MemberCount @(Group.MemberCount == 1 ? "member" : "members")
                    </span>
                    @if (Group.IsJoined)
                    {
                        <span class="text-emerald-600 font-semibold flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            Joined (@Group.UserRole)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 shrink-0">
        @if (!string.IsNullOrWhiteSpace(SignalRStatus))
        {
            <div class="px-2.5 py-1 text-[11px] font-semibold rounded-lg border flex items-center gap-1.5 shadow-2xs @GetStatusClass(SignalRStatus)">
                <span class="w-1.5 h-1.5 rounded-full @GetDotClass(SignalRStatus)"></span>
                <span>@SignalRStatus</span>
            </div>
        }

        <button type="button" @onclick="OnToggleInfo" title="Group Info & Members"
                class="px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-xl transition cursor-pointer flex items-center gap-1.5 text-xs font-semibold shadow-2xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
            <span class="hidden sm:inline">Group Info</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public required ChatGroupModel Group { get; set; }
    [Parameter] public EventCallback OnToggleInfo { get; set; }
    [Parameter] public string SignalRStatus { get; set; } = "Live";

    private string GetStatusClass(string status) => status switch
    {
        "Live" or "Connected" => "bg-emerald-50 border-emerald-200 text-emerald-700",
        "Reconnecting..." => "bg-amber-50 border-amber-200 text-amber-700 animate-pulse",
        _ => "bg-rose-50 border-rose-200 text-rose-700"
    };

    private string GetDotClass(string status) => status switch
    {
        "Live" or "Connected" => "bg-emerald-500",
        "Reconnecting..." => "bg-amber-500",
        _ => "bg-rose-500"
    };
}