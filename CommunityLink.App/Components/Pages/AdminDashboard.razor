@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Admin Control Center — CommunityLink</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-600/10 border border-amber-500/30 text-amber-500">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                        Admin Executive Command
                    </h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-0.5">Ecosystem telemetry, community governance, and LinkDrop financial health.</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="LoadDashboardAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>Refresh Live Telemetry</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-16 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-3 text-sm font-medium">Aggregating platform intelligence & telemetry...</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/50 rounded-2xl text-red-700 dark:text-rose-300 flex items-center justify-between">
            <span>Failed to load admin metrics.</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-700 transition">Retry</button>
        </div>
    }
    else
    {
        <!-- Primary Executive Overview Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- 1. Total Users (Clickable -> User Report) -->
            <div @onclick='() => Navigation.NavigateTo("/reports/users")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-indigo-500/60 dark:hover:border-indigo-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider font-mono">Platform Members</span>
                    <span class="p-2.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">
                        @model.Stats.TotalUsers.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">Total Registered Users</span>
                        <span class="font-semibold text-indigo-600 dark:text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            User Report &rarr;
                        </span>
                    </div>
                </div>
            </div>

            <!-- 2. Communities (Clickable -> Community Report) -->
            <div @onclick='() => Navigation.NavigateTo("/reports/communities")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider font-mono">Hubs &amp; Syndicates</span>
                    <span class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">
                        @model.Stats.TotalCommunities.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">Chartered Communities</span>
                        <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            Community Report &rarr;
                        </span>
                    </div>
                </div>
            </div>

            <!-- 3. LinkDrop Economy (Current Month Sold -> Platform Finance) -->
            <div @onclick='() => Navigation.NavigateTo("/admin/finance")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-amber-500/60 dark:hover:border-amber-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-amber-500/10 dark:bg-amber-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider font-mono">LinkDrop Economy</span>
                    <span class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">
                        @FormatCompact(model.Stats.CurrentMonthLinkDropSold) <span class="text-xs font-bold text-amber-500">LD</span>
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">Sold in @(string.IsNullOrWhiteSpace(model.Stats.CurrentMonthName) ? "Current Month" : model.Stats.CurrentMonthName)</span>
                        <span class="font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            Platform Finance &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ecosystem Secondary Signals Strip -->
        <div class="grid grid-cols-1 gap-4">
            <!-- Working Rooms/Groups -->
            <div @onclick='() => Navigation.NavigateTo("/groups")'
                 class="p-4 rounded-xl bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-white/20 transition cursor-pointer flex items-center justify-between">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase font-mono tracking-wider">Working Rooms</div>
                    <div class="text-xl font-black text-[#0A1B2E] dark:text-white mt-0.5">@model.Stats.TotalGroups.ToString("N0")</div>
                    <div class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-0.5">Active Collaborative Groups</div>
                </div>
                <div class="w-9 h-9 rounded-lg bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
                </div>
            </div>
        </div>

        <!-- Telemetry Graphs Section (User Growth & LinkDrop Volume) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Chart 1: Platform User Acquisition Velocity -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 animate-pulse"></span>
                            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                                User Growth Velocity (30 Days)
                            </h2>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-0.5">Daily registered member onboarding trajectory.</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                        +@model.Trends.Sum(t => t.NewUsers) New Members
                    </span>
                </div>

                <!-- Custom SVG Area Sparkline Chart -->
                <div class="relative w-full h-48">
                    @if (model.Trends.Any())
                    {
                        <svg class="w-full h-full overflow-visible" viewBox="0 0 500 150" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="userGrowthGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#6366F1" stop-opacity="0.45" />
                                    <stop offset="100%" stop-color="#6366F1" stop-opacity="0.0" />
                                </linearGradient>
                            </defs>

                            <!-- Horizontal Grid lines -->
                            <line x1="0" y1="30" x2="500" y2="30" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                            <line x1="0" y1="75" x2="500" y2="75" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                            <line x1="0" y1="120" x2="500" y2="120" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />

                            <!-- Area fill -->
                            <path d="@BuildSvgAreaPath(model.Trends.Select(t => (double)t.NewUsers).ToList(), 500, 140, 10)" fill="url(#userGrowthGrad)" />
                            
                            <!-- Stroke line -->
                            <path d="@BuildSvgLinePath(model.Trends.Select(t => (double)t.NewUsers).ToList(), 500, 140, 10)" fill="none" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                            <!-- Interactive/Highlight dots for peak days -->
                            @for (int i = 0; i < model.Trends.Count; i++)
                            {
                                var val = (double)model.Trends[i].NewUsers;
                                var max = Math.Max(1.0, model.Trends.Max(t => (double)t.NewUsers));
                                var x = (500.0 / Math.Max(1, model.Trends.Count - 1)) * i;
                                var y = 140.0 - (val / max) * 120.0;
                                if (i == model.Trends.Count - 1 || val == max)
                                {
                                    <circle cx="@x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="4" fill="#6366F1" stroke="#ffffff" stroke-width="2" />
                                }
                            }
                        </svg>

                        <!-- Chart Dates Axis -->
                        <div class="flex items-center justify-between text-[10px] font-mono text-[#7A8CA6] mt-2">
                            <span>@model.Trends.First().Date.ToString("MMM dd")</span>
                            <span>@model.Trends[model.Trends.Count / 2].Date.ToString("MMM dd")</span>
                            <span>Today (@model.Trends.Last().Date.ToString("MMM dd"))</span>
                        </div>
                    }
                    else
                    {
                        <div class="h-full flex items-center justify-center text-xs text-[#7A8CA6]">No user onboarding trend data recorded yet.</div>
                    }
                </div>
            </div>

            <!-- Chart 2: LinkDrop Economy Transaction Velocity -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                                LinkDrop Transaction Volume
                            </h2>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-0.5">30-day point liquidity &amp; peer-to-peer / purchase volume.</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                        @FormatCompact(model.Trends.Sum(t => t.LinkDropVolume)) LD Moved
                    </span>
                </div>

                <!-- Custom SVG Bar / Area Sparkline Chart -->
                <div class="relative w-full h-48">
                    @if (model.Trends.Any())
                    {
                        <svg class="w-full h-full overflow-visible" viewBox="0 0 500 150" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="ldVolumeGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.45" />
                                    <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.0" />
                                </linearGradient>
                            </defs>

                            <!-- Horizontal Grid lines -->
                            <line x1="0" y1="30" x2="500" y2="30" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                            <line x1="0" y1="75" x2="500" y2="75" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                            <line x1="0" y1="120" x2="500" y2="120" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />

                            <!-- Area fill -->
                            <path d="@BuildSvgAreaPath(model.Trends.Select(t => (double)t.LinkDropVolume).ToList(), 500, 140, 10)" fill="url(#ldVolumeGrad)" />
                            
                            <!-- Stroke line -->
                            <path d="@BuildSvgLinePath(model.Trends.Select(t => (double)t.LinkDropVolume).ToList(), 500, 140, 10)" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                            @for (int i = 0; i < model.Trends.Count; i++)
                            {
                                var val = (double)model.Trends[i].LinkDropVolume;
                                var max = Math.Max(1.0, model.Trends.Max(t => (double)t.LinkDropVolume));
                                var x = (500.0 / Math.Max(1, model.Trends.Count - 1)) * i;
                                var y = 140.0 - (val / max) * 120.0;
                                if (i == model.Trends.Count - 1 || (val == max && val > 0))
                                {
                                    <circle cx="@x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="4" fill="#F59E0B" stroke="#ffffff" stroke-width="2" />
                                }
                            }
                        </svg>

                        <!-- Chart Dates Axis -->
                        <div class="flex items-center justify-between text-[10px] font-mono text-[#7A8CA6] mt-2">
                            <span>@model.Trends.First().Date.ToString("MMM dd")</span>
                            <span>@model.Trends[model.Trends.Count / 2].Date.ToString("MMM dd")</span>
                            <span>Today (@model.Trends.Last().Date.ToString("MMM dd"))</span>
                        </div>
                    }
                    else
                    {
                        <div class="h-full flex items-center justify-center text-xs text-[#7A8CA6]">No LinkDrop transaction telemetry recorded yet.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Moderation & Fast Administrative Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Pending Community Join Requests Moderation Queue -->
            <div class="lg:col-span-2 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            <span>Community Moderation Queue</span>
                        </h2>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Pending membership admissions requiring admin sign-off.</p>
                    </div>
                    <a href="admin/communities" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Manage All &rarr;</a>
                </div>

                @if (!model.PendingJoinRequests.Any())
                {
                    <div class="py-12 text-center text-[#7A8CA6]">
                        <div class="w-10 h-10 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center mb-2">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <p class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">All clear!</p>
                        <p class="text-[11px] text-[#7A8CA6] mt-0.5">No pending community admission requests at this moment.</p>
                    </div>
                }
                else
                {
                    <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                        @foreach (var req in model.PendingJoinRequests.Take(5))
                        {
                            <div class="py-3 flex items-center justify-between gap-4 text-xs">
                                <div>
                                    <div class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</div>
                                    <div class="text-[#557392] dark:text-[#C4D2E1] mt-0.5">
                                        Applying to: <span class="font-semibold text-emerald-600 dark:text-emerald-400">@req.CommunityName</span>
                                    </div>
                                    <div class="text-[10px] text-[#7A8CA6] mt-0.5 font-mono">@req.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition text-[11px] cursor-pointer shadow-xs">
                                        Approve
                                    </button>
                                    <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-500 transition text-[11px] cursor-pointer shadow-xs">
                                        Reject
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Quick Access Directory Links -->
