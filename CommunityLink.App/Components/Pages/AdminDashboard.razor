@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject ToastService Toast

<PageTitle>Admin Control Center — CommunityLink</PageTitle>

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">🛡️ Admin Control Center</h1>
            <p class="text-sm text-[#557392]">Real-time stats, moderation queue, and system telemetry.</p>
        </div>
        <button @onclick="LoadDashboardAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-white text-[#557392] border border-[#CBD5E1] hover:border-[#0A1B2E] hover:text-[#0A1B2E] transition shadow-sm">
            🔄 Refresh Metrics
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] bg-white rounded-2xl border border-[#E2E8F0]">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Fetching real-time control metrics...</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-red-50 border border-red-200 rounded-2xl text-red-700 flex items-center justify-between">
            <span>Failed to load admin metrics.</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-700 transition">Retry</button>
        </div>
    }
    else
    {
        <!-- Metrics Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Total Users</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalUsers</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Communities</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalCommunities</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Total Posts</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalPosts</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Active Polls</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalPolls</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Conversations</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.ActiveConversations</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] hover:border-[#0A1B2E]/20 hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Audit Logs</div>
                <div class="text-2xl font-black text-[#0A1B2E] mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalAuditLogs</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- 30-Day Activity Trends Summary -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0]">
                    <div>
                        <h2 class="text-base font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">📈 30-Day Activity Summary</h2>
                        <p class="text-xs text-[#557392]">Platform user growth and daily engagement velocity.</p>
                    </div>
                </div>

                @if (!model.Trends.Any())
                {
                    <p class="text-xs text-[#7A8CA6] py-4">No activity trend data recorded yet.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-[#F1F5F9] text-[#7A8CA6] uppercase font-semibold border-b border-[#E2E8F0]" style="font-family:'JetBrains Mono',monospace">
                                    <th class="py-2.5 px-3">Date</th>
                                    <th class="py-2.5 px-3 text-right">New Users</th>
                                    <th class="py-2.5 px-3 text-right">New Posts</th>
                                    <th class="py-2.5 px-3 text-right">Active Users</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E2E8F0]">
                                @foreach (var t in model.Trends.Take(7))
                                {
                                    <tr class="hover:bg-[#F8FAFC] transition">
                                        <td class="py-2 px-3 font-medium text-[#0A1B2E] font-mono">@t.Date.ToString("MMM dd, yyyy")</td>
                                        <td class="py-2 px-3 text-right font-bold text-emerald-600 font-mono">+@t.NewUsers</td>
                                        <td class="py-2 px-3 text-right font-bold text-[#557392] font-mono">+@t.NewPosts</td>
                                        <td class="py-2 px-3 text-right font-bold text-[#0A1B2E] font-mono">@t.ActiveUsers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Pending Join Requests Quick Moderation -->
            <div class="bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0]">
                        <h2 class="text-base font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">🏛️ Moderation Queue</h2>
                        <a href="admin/communities" class="text-xs font-semibold text-[#557392] hover:text-[#0A1B2E] transition">View All &rarr;</a>
                    </div>

                    @if (!model.PendingJoinRequests.Any())
                    {
                        <div class="py-8 text-center text-[#7A8CA6]">
                            <span class="text-2xl">✅</span>
                            <p class="text-xs mt-1">No pending join requests.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var req in model.PendingJoinRequests.Take(4))
                            {
                                <div class="p-3 bg-[#F8FAFC] rounded-lg border border-[#E2E8F0] text-xs hover:border-[#CBD5E1] transition">
                                    <div class="font-bold text-[#0A1B2E]">@req.UserName</div>
                                    <div class="text-[#557392] mt-0.5">Requesting: <span class="font-semibold text-[#0A1B2E]">@req.CommunityName</span></div>
                                    <div class="mt-2.5 flex items-center justify-end gap-2">
                                        <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded-full bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition text-[11px]">Approve</button>
                                        <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded-full bg-red-600 text-white font-semibold hover:bg-red-500 transition text-[11px]">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-t border-[#E2E8F0] flex gap-2">
                    <a href="admin/users" class="flex-1 text-center py-2 px-3 bg-[#F1F5F9] hover:bg-[#E2E8F0] text-[#557392] hover:text-[#0A1B2E] rounded-lg text-xs font-semibold transition border border-[#E2E8F0]">
                        👥 User Directory
                    </a>
                    <a href="admin/audits" class="flex-1 text-center py-2 px-3 bg-[#F1F5F9] hover:bg-[#E2E8F0] text-[#557392] hover:text-[#0A1B2E] rounded-lg text-xs font-semibold transition border border-[#E2E8F0]">
                        📜 System Audits
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetDashboardAsync();
        if (res.IsSuccess) model = res.Data;
        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Approved join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Rejected join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject.");
        }
    }
}