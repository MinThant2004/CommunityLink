@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject ToastService Toast

<PageTitle>Admin Control Center — CommunityLink</PageTitle>

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">🛡️ Admin Control Center</h1>
            <p class="text-sm text-slate-500">Real-time stats, moderation queue, and system telemetry.</p>
        </div>
        <button @onclick="LoadDashboardAsync" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 transition shadow-sm">
            🔄 Refresh Metrics
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-500 bg-white rounded-xl shadow-sm border border-slate-200">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Fetching real-time control metrics...</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 flex items-center justify-between">
            <span>Failed to load admin metrics.</span>
            <button @onclick="LoadDashboardAsync" class="px-3 py-1.5 bg-rose-600 text-white text-xs font-semibold rounded-lg hover:bg-rose-700">Retry</button>
        </div>
    }
    else
    {
        <!-- Metrics Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Users</div>
                <div class="text-2xl font-black text-indigo-600 mt-1">@model.Stats.TotalUsers</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Communities</div>
                <div class="text-2xl font-black text-emerald-600 mt-1">@model.Stats.TotalCommunities</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Posts</div>
                <div class="text-2xl font-black text-sky-600 mt-1">@model.Stats.TotalPosts</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Polls</div>
                <div class="text-2xl font-black text-amber-600 mt-1">@model.Stats.TotalPolls</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Conversations</div>
                <div class="text-2xl font-black text-purple-600 mt-1">@model.Stats.ActiveConversations</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Audit Logs</div>
                <div class="text-2xl font-black text-slate-700 mt-1">@model.Stats.TotalAuditLogs</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- 30-Day Activity Trends Summary -->
            <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                    <div>
                        <h2 class="text-base font-bold text-slate-900">📈 30-Day Activity Summary</h2>
                        <p class="text-xs text-slate-500">Platform user growth and daily engagement velocity.</p>
                    </div>
                </div>

                @if (!model.Trends.Any())
                {
                    <p class="text-xs text-slate-500 py-4">No activity trend data recorded yet.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-200">
                                    <th class="py-2.5 px-3">Date</th>
                                    <th class="py-2.5 px-3 text-right">New Users</th>
                                    <th class="py-2.5 px-3 text-right">New Posts</th>
                                    <th class="py-2.5 px-3 text-right">Active Users</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var t in model.Trends.Take(7))
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="py-2 px-3 font-medium text-slate-700">@t.Date.ToString("MMM dd, yyyy")</td>
                                        <td class="py-2 px-3 text-right font-bold text-indigo-600">+@t.NewUsers</td>
                                        <td class="py-2 px-3 text-right font-bold text-emerald-600">+@t.NewPosts</td>
                                        <td class="py-2 px-3 text-right font-bold text-slate-800">@t.ActiveUsers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Pending Join Requests Quick Moderation -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                        <h2 class="text-base font-bold text-slate-900">🏛️ Moderation Queue</h2>
                        <a href="admin/communities" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">View All &rarr;</a>
                    </div>

                    @if (!model.PendingJoinRequests.Any())
                    {
                        <div class="py-8 text-center text-slate-400">
                            <span class="text-2xl">✅</span>
                            <p class="text-xs mt-1">No pending join requests.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var req in model.PendingJoinRequests.Take(4))
                            {
                                <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs">
                                    <div class="font-bold text-slate-900">@req.UserName</div>
                                    <div class="text-slate-500 mt-0.5">Requesting: <span class="font-semibold text-indigo-600">@req.CommunityName</span></div>
                                    <div class="mt-2.5 flex items-center justify-end gap-2">
                                        <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition">Approve</button>
                                        <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded bg-rose-600 text-white font-semibold hover:bg-rose-700 transition">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-t border-slate-100 flex gap-2">
                    <a href="admin/users" class="flex-1 text-center py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition">
                        👥 User Directory
                    </a>
                    <a href="admin/audits" class="flex-1 text-center py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition">
                        📜 System Audits
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetDashboardAsync();
        if (res.IsSuccess) model = res.Data;
        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Approved join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Rejected join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject.");
        }
    }
}