@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject ToastService Toast

<PageTitle>Admin Control Center — CommunityLink</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2.5" style="font-family:'Manrope',sans-serif">
                <svg class="w-6 h-6 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Admin Control Center</span>
            </h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1]">Real-time stats, moderation queue, and system telemetry.</p>
        </div>
        <button @onclick="LoadDashboardAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-sm cursor-pointer">
            <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>Refresh Metrics</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-2 text-sm font-medium">Fetching real-time control metrics...</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/50 rounded-2xl text-red-700 dark:text-rose-300 flex items-center justify-between">
            <span>Failed to load admin metrics.</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-700 transition">Retry</button>
        </div>
    }
    else
    {
        <!-- Metrics Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Total Users</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalUsers</div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Communities</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalCommunities</div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Total Posts</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalPosts</div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Active Polls</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalPolls</div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Conversations</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.ActiveConversations</div>
            </div>
            <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] hover:-translate-y-0.5 hover:shadow-md transition-all">
                <div class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Audit Logs</div>
                <div class="text-2xl font-black text-[#0A1B2E] dark:text-white mt-1" style="font-family:'Manrope',sans-serif">@model.Stats.TotalAuditLogs</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- 30-Day Activity Trends Summary -->
            <div class="lg:col-span-2 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                            <span>30-Day Activity Summary</span>
                        </h2>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Platform user growth and daily engagement velocity.</p>
                    </div>
                </div>

                @if (!model.Trends.Any())
                {
                    <p class="text-xs text-[#7A8CA6] py-4">No activity trend data recorded yet.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-[#F1F5F9] dark:bg-[#0A1B2E] text-[#7A8CA6] uppercase font-semibold border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]" style="font-family:'JetBrains Mono',monospace">
                                    <th class="py-2.5 px-3">Date</th>
                                    <th class="py-2.5 px-3 text-right">New Users</th>
                                    <th class="py-2.5 px-3 text-right">New Posts</th>
                                    <th class="py-2.5 px-3 text-right">Active Users</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                                @foreach (var t in model.Trends.Take(7))
                                {
                                    <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/40 transition">
                                        <td class="py-2 px-3 font-medium text-[#0A1B2E] dark:text-[#E1E8F0] font-mono">@t.Date.ToString("MMM dd, yyyy")</td>
                                        <td class="py-2 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400 font-mono">+@t.NewUsers</td>
                                        <td class="py-2 px-3 text-right font-bold text-[#557392] dark:text-[#C4D2E1] font-mono">+@t.NewPosts</td>
                                        <td class="py-2 px-3 text-right font-bold text-[#0A1B2E] dark:text-[#E1E8F0] font-mono">@t.ActiveUsers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Pending Join Requests Quick Moderation -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                            <svg class="w-4 h-4 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            <span>Moderation Queue</span>
                        </h2>
                        <a href="admin/communities" class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">View All &rarr;</a>
                    </div>

                    @if (!model.PendingJoinRequests.Any())
                    {
                        <div class="py-8 text-center text-[#7A8CA6]">
                            <svg class="w-8 h-8 mx-auto text-emerald-500 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            <p class="text-xs mt-1">No pending join requests.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var req in model.PendingJoinRequests.Take(4))
                            {
                                <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-xs hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.30)] transition">
                                    <div class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</div>
                                    <div class="text-[#557392] dark:text-[#C4D2E1] mt-0.5">Requesting: <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.CommunityName</span></div>
                                    <div class="mt-2.5 flex items-center justify-end gap-2">
                                        <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded-full bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition text-[11px] cursor-pointer">Approve</button>
                                        <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-2.5 py-1 rounded-full bg-red-600 text-white font-semibold hover:bg-red-500 transition text-[11px] cursor-pointer">Reject</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex gap-2">
                    <a href="admin/users" class="flex-1 text-center py-2 px-3 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg text-xs font-semibold transition border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>User Directory</span>
                    </a>
                    <a href="admin/audits" class="flex-1 text-center py-2 px-3 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg text-xs font-semibold transition border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>System Audits</span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetDashboardAsync();
        if (res.IsSuccess) model = res.Data;
        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Approved join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Rejected join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject.");
        }
    }
}