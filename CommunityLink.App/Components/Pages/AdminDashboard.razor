@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.Shared.Features.Finance
@inject AdministrationApiService AdminApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Admin_Dashboard_PageTitle"]</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-600/10 border border-amber-500/30 text-amber-500">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                        @Loc["Admin_Dashboard_Title"]
                    </h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1.5">@Loc["Admin_Dashboard_Subtitle"]</p>
                </div>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (lastUpdated.HasValue)
            {
                <span class="text-[11px] font-mono text-[#7A8CA6] dark:text-[#8FA3BC] mr-1">
                    @string.Format(Loc["Admin_Dashboard_LastUpdated"].Value, lastUpdated.Value.ToString("HH:mm:ss"))
                </span>
            }
            <div class="inline-flex rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] overflow-hidden">
                @foreach (var days in new[] { 7, 30 })
                {
                    var selected = rangeDays == days;
                    <button type="button" @onclick="() => rangeDays = days"
                            class="px-3 py-2 text-[11px] font-semibold transition cursor-pointer @(selected ? "bg-[#0A1B2E] text-white dark:bg-[#D4AF37] dark:text-[#0A0D14]" : "bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A]")">
                        @(days == 7 ? Loc["Admin_Dashboard_Range7"].Value : Loc["Admin_Dashboard_Range30"].Value)
                    </button>
                }
            </div>
            <button @onclick="() => LoadDashboardAsync(true)" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>@Loc["Admin_Dashboard_RefreshTelemetry"]</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-16 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-3 text-sm font-medium">@Loc["Admin_Dashboard_LoadingTelemetry"]</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/50 rounded-2xl text-red-700 dark:text-rose-300 flex items-center justify-between">
            <span>@Loc["Admin_Dashboard_LoadError"]</span>
            <button @onclick="() => LoadDashboardAsync(true)" class="px-4 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-700 transition">@Loc["Common_Reload"]</button>
        </div>
    }
    else
    {
        <!-- Primary Executive Overview Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- 1. Total Users (Clickable -> User Report) -->
            <button type="button" @onclick='() => Go("/reports/users")'
                    class="group relative w-full text-left bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-indigo-500/60 dark:hover:border-indigo-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_PlatformMembers"]</span>
                    <span class="p-2.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @model.Stats.TotalUsers.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_TotalRegisteredUsers"]</span>
                        <span class="font-semibold text-indigo-600 dark:text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_UserReport"] &rarr;
                        </span>
                    </div>
                </div>
            </button>

            <!-- 2. Communities (Clickable -> Community Report) -->
            <button type="button" @onclick='() => Go("/reports/communities")'
                    class="group relative w-full text-left bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_HubsSyndicates"]</span>
                    <span class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @model.Stats.TotalCommunities.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_CharteredCommunities"]</span>
                        <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_CommunityReport"] &rarr;
                        </span>
                    </div>
                </div>
            </button>

            <!-- 3. LinkDrop Economy (Current Month Sold -> Platform Finance) -->
            <button type="button" @onclick='() => Go("/admin/finance")'
                    class="group relative w-full text-left bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-amber-500/60 dark:hover:border-amber-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-amber-500/10 dark:bg-amber-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_LinkDropEconomy"]</span>
                    <span class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @FormatCompact(model.Stats.CurrentMonthLinkDropSold) <span class="text-xs font-bold text-amber-500">LD</span>
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@string.Format(Loc["Admin_Dashboard_SoldInMonth"].Value, string.IsNullOrWhiteSpace(model.Stats.CurrentMonthName) ? Loc["Admin_Dashboard_CurrentMonth"].Value : model.Stats.CurrentMonthName)</span>
                        <span class="font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_PlatformFinance"] &rarr;
                        </span>
                    </div>
                </div>
            </button>
        </div>

        <!-- Moderation Queue & Pending Reviews -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Pending Community Join Requests Moderation Queue -->
            <div class="lg:col-span-2 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2 font-display">
                            <svg class="w-4 h-4 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            <span>@Loc["Admin_Dashboard_ModQueueTitle"]</span>
                            @if (model.PendingJoinRequests.Count > 0)
                            {
                                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">@model.PendingJoinRequests.Count</span>
                            }
                        </h2>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_ModQueueDesc"]</p>
                    </div>
                    <button type="button" @onclick='() => Go("/admin/communities")' class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">@Loc["Admin_Dashboard_ManageAll"] &rarr;</button>
                </div>

                @if (!model.PendingJoinRequests.Any())
                {
                    <div class="py-12 text-center text-[#7A8CA6]">
                        <div class="w-10 h-10 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center mb-2">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <p class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_AllClear"]</p>
                        <p class="text-[11px] text-[#7A8CA6] mt-0.5">@Loc["Admin_Dashboard_NoPendingRequests"]</p>
                    </div>
                }
                else
                {
                    <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                        @foreach (var req in model.PendingJoinRequests.Take(5))
                        {
                            <div class="py-3 flex items-center justify-between gap-4 text-xs">
                                <div>
                                    <div class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</div>
                                    <div class="text-[#557392] dark:text-[#C4D2E1] mt-0.5">
                                        @Loc["Admin_Dashboard_ApplyingTo"] <span class="font-semibold text-emerald-600 dark:text-emerald-400">@req.CommunityName</span>
                                    </div>
                                    <div class="text-[10px] text-[#7A8CA6] mt-0.5 font-mono">@req.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition text-[11px] cursor-pointer shadow-xs">
                                        @Loc["Admin_Dashboard_Approve"]
                                    </button>
                                    <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-500 transition text-[11px] cursor-pointer shadow-xs">
                                        @Loc["Admin_Dashboard_Reject"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Pending Review Queues -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1 font-display">@Loc["Admin_Dashboard_ActionQueueTitle"]</h2>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mb-4">@Loc["Admin_Dashboard_ActionQueueDesc"]</p>

                <div class="space-y-2.5">
                    <button type="button" @onclick='() => Go("/admin/content-moderation?tab=posts")'
                            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-rose-500/50 transition text-left cursor-pointer">
                        <span class="flex items-center gap-2.5">
                            <span class="p-2 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            </span>
                            <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_PendingReports"]</span>
                        </span>
                        <span class="text-sm font-black font-mono @(PendingReportsCount > 0 ? "text-rose-600 dark:text-rose-400" : "text-[#7A8CA6]")">@PendingReportsCount</span>
                    </button>

                    <button type="button" @onclick='() => Go("/admin/verifications")'
                            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-indigo-500/50 transition text-left cursor-pointer">
                        <span class="flex items-center gap-2.5">
                            <span class="p-2 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
                            </span>
                            <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_PendingVerifications"]</span>
                        </span>
                        <span class="text-sm font-black font-mono @(model.Stats.TotalVerificationsPending > 0 ? "text-indigo-600 dark:text-indigo-400" : "text-[#7A8CA6]")">@model.Stats.TotalVerificationsPending</span>
                    </button>

                    <button type="button" @onclick='() => Go("/admin/payouts")'
                            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-amber-500/50 transition text-left cursor-pointer">
                        <span class="flex items-center gap-2.5">
                            <span class="p-2 rounded-lg bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                            </span>
                            <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_PendingPayouts"]</span>
                        </span>
                        <span class="text-sm font-black font-mono @(model.Stats.TotalCreatorPayoutsPending > 0 ? "text-amber-600 dark:text-amber-400" : "text-[#7A8CA6]")">@model.Stats.TotalCreatorPayoutsPending</span>
                    </button>

                    <button type="button" @onclick='() => Go("/admin/communities")'
                            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-emerald-500/50 transition text-left cursor-pointer">
                        <span class="flex items-center gap-2.5">
                            <span class="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </span>
                            <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_PendingJoins"]</span>
                        </span>
                        <span class="text-sm font-black font-mono @(model.PendingJoinRequests.Count > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-[#7A8CA6]")">@model.PendingJoinRequests.Count</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Telemetry Graphs Section: User Growth & LinkDrop Volume Inline -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Chart 1: Platform User & Post Acquisition -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-start justify-between gap-3 mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                                @Loc["Admin_Dashboard_UserGrowthTitle"]
                            </h2>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1.5">@Loc["Admin_Dashboard_UserGrowthDesc"]</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 whitespace-nowrap">
                        @string.Format(Loc["Admin_Dashboard_NewMembersCount"].Value, TrendWindow.Sum(t => t.NewUsers))
                    </span>
                </div>

                <GroupedBarChart Title="@Loc["Admin_Dashboard_UserGrowthTitle"].Value"
                                 Labels="GrowthLabels"
                                 Series="GrowthSeries"
                                 EmptyText="@Loc["Admin_Dashboard_NoTrendData"].Value"
                                 ValueSuffix="" />
            </div>

            <!-- Chart 2: LinkDrop Volume (Inline with User Growth Chart) -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-start justify-between gap-3 mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                                @Loc["Admin_Dashboard_LdVolumeTitle"]
                            </h2>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1.5">@Loc["Admin_Dashboard_LdVolumeDesc"]</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800 whitespace-nowrap">
                        @string.Format(Loc["Admin_Dashboard_LdMoved"].Value, FormatCompact(TrendWindow.Sum(t => t.LinkDropVolume)))
                    </span>
                </div>

                <GroupedBarChart Title="@Loc["Admin_Dashboard_LdVolumeTitle"].Value"
                                 Labels="GrowthLabels"
                                 Series="LdSeries"
                                 EmptyText="@Loc["Admin_Dashboard_NoLdTrendData"].Value"
                                 ValueSuffix=" LD" />
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;
    private IReadOnlyList<ContentReportModel>? pendingReports;
    private DateTime? lastUpdated;
    private int rangeDays = 30;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync(bool notify = false)
    {
        isLoading = true;
        try
        {
            var dashTask = AdminApi.GetDashboardAsync();
            var reportsTask = AdminApi.GetContentReportsAsync("PENDING");

            await Task.WhenAll(dashTask, reportsTask);

            var dashRes = await dashTask;
            var reportsRes = await reportsTask;

            if (dashRes.IsSuccess) model = dashRes.Data;
            pendingReports = reportsRes.IsSuccess ? reportsRes.Data : null;

            if (dashRes.IsSuccess)
            {
                lastUpdated = DateTime.Now;
                if (notify) Toast.Success(Loc["Admin_Dashboard_UpdatedToast"].Value);
            }
            else
            {
                Toast.Error(dashRes.Message ?? Loc["Admin_Dashboard_LoadFailedToast"].Value);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private IReadOnlyList<TrendPointModel> TrendWindow =>
        model is null
            ? Array.Empty<TrendPointModel>()
            : rangeDays == 7
                ? model.Trends.Skip(Math.Max(0, model.Trends.Count - 7)).ToList()
                : model.Trends;

    private List<string> GrowthLabels =>
        TrendWindow.Select(t => t.Date.ToString("MMM dd")).ToList();

    private List<GroupedBarChart.BarSeries> GrowthSeries => new()
    {
        new(Loc["Admin_Dashboard_NewUsersLabel"].Value, TrendWindow.Select(t => (double)t.NewUsers).ToList(), "#6366F1"),
        new(Loc["Admin_Dashboard_NewPostsLabel"].Value, TrendWindow.Select(t => (double)t.NewPosts).ToList(), "#10B981")
    };

    private List<GroupedBarChart.BarSeries> LdSeries => new()
    {
        new(Loc["Admin_Dashboard_LdVolumeSeries"].Value, TrendWindow.Select(t => (double)t.LinkDropVolume).ToList(), "#F59E0B")
    };

    private int PendingReportsCount => pendingReports?.Count ?? 0;

    private void Go(string url) => Navigation.NavigateTo(url);

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success(Loc["Admin_Dashboard_Toast_ApprovedJoin"]);
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Dashboard_Toast_ApproveFailed"].Value);
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success(Loc["Admin_Dashboard_Toast_RejectedJoin"]);
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Dashboard_Toast_RejectFailed"].Value);
        }
    }

    private static string FormatCompact(long val)
    {
        if (val >= 1_000_000) return $"{val / 1_000_000.0:0.#}M";
        if (val >= 1_000) return $"{val / 1_000.0:0.#}K";
        return val.ToString("N0");
    }
}