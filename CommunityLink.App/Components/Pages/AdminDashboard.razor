@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Admin_Dashboard_PageTitle"]</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-600/10 border border-amber-500/30 text-amber-500">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                        @Loc["Admin_Dashboard_Title"]
                    </h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1.5">@Loc["Admin_Dashboard_Subtitle"]</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="LoadDashboardAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>@Loc["Admin_Dashboard_RefreshTelemetry"]</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-16 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-3 text-sm font-medium">@Loc["Admin_Dashboard_LoadingTelemetry"]</p>
        </div>
    }
    else if (model == null)
    {
        <div class="p-6 bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/50 rounded-2xl text-red-700 dark:text-rose-300 flex items-center justify-between">
            <span>@Loc["Admin_Dashboard_LoadError"]</span>
            <button @onclick="LoadDashboardAsync" class="px-4 py-1.5 bg-red-600 text-white text-xs font-semibold rounded-full hover:bg-red-700 transition">@Loc["Common_Reload"]</button>
        </div>
    }
    else
    {
        <!-- Primary Executive Overview Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- 1. Total Users (Clickable -> User Report) -->
            <div @onclick='() => Navigation.NavigateTo("/reports/users")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-indigo-500/60 dark:hover:border-indigo-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_PlatformMembers"]</span>
                    <span class="p-2.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @model.Stats.TotalUsers.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_TotalRegisteredUsers"]</span>
                        <span class="font-semibold text-indigo-600 dark:text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_UserReport"] &rarr;
                        </span>
                    </div>
                </div>
            </div>

            <!-- 2. Communities (Clickable -> Community Report) -->
            <div @onclick='() => Navigation.NavigateTo("/reports/communities")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_HubsSyndicates"]</span>
                    <span class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @model.Stats.TotalCommunities.ToString("N0")
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_CharteredCommunities"]</span>
                        <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_CommunityReport"] &rarr;
                        </span>
                    </div>
                </div>
            </div>

            <!-- 3. LinkDrop Economy (Current Month Sold -> Platform Finance) -->
            <div @onclick='() => Navigation.NavigateTo("/admin/finance")'
                 class="group relative bg-white dark:bg-[#112A46] p-6 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-amber-500/60 dark:hover:border-amber-400/60 hover:-translate-y-1 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-amber-500/10 dark:bg-amber-500/15 rounded-full blur-xl group-hover:scale-125 transition-transform duration-300 pointer-events-none"></div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider font-mono">@Loc["Admin_Dashboard_LinkDropEconomy"]</span>
                    <span class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </span>
                </div>
                <div class="mt-4">
                    <div class="text-3xl font-black text-[#0A1B2E] dark:text-white font-display">
                        @FormatCompact(model.Stats.CurrentMonthLinkDropSold) <span class="text-xs font-bold text-amber-500">LD</span>
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-[#557392] dark:text-[#C4D2E1]">@string.Format(Loc["Admin_Dashboard_SoldInMonth"], string.IsNullOrWhiteSpace(model.Stats.CurrentMonthName) ? Loc["Admin_Dashboard_CurrentMonth"].Value : model.Stats.CurrentMonthName)</span>
                        <span class="font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            @Loc["Admin_Dashboard_PlatformFinance"] &rarr;
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ecosystem Secondary Signals Strip -->
        <div class="grid grid-cols-1 gap-4">
            <!-- Working Rooms/Groups -->
            <div @onclick='() => Navigation.NavigateTo("/groups")'
                 class="p-4 rounded-xl bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-white/20 transition cursor-pointer flex items-center justify-between">
                <div>
                    <div class="text-[10px] font-bold text-[#7A8CA6] uppercase font-mono tracking-wider">@Loc["Admin_Dashboard_WorkingRooms"]</div>
                    <div class="text-xl font-black text-[#0A1B2E] dark:text-white mt-0.5">@model.Stats.TotalGroups.ToString("N0")</div>
                    <div class="text-[11px] text-[#557392] dark:text-[#C4D2E1] mt-0.5">@Loc["Admin_Dashboard_ActiveGroups"]</div>
                </div>
                <div class="w-9 h-9 rounded-lg bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>
                </div>
            </div>
        </div>

        <!-- Telemetry Graphs Filter Bar: Day-Month-Year Date Range Selector (Under WORKING ROOMS box) -->
        <div class="bg-white dark:bg-[#112A46] p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-xs space-y-3">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-[#0A1B2E] dark:text-[#CBD5E1]">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                            <line x1="16" x2="16" y1="2" y2="6"/>
                            <line x1="8" x2="8" y1="2" y2="6"/>
                            <line x1="3" x2="21" y1="10" y2="10"/>
                        </svg>
                    </span>
                    <div>
                        <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                            @Loc["Admin_Dashboard_FilterPeriodTitle"]
                        </div>
                        <div class="text-[11px] text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5 mt-0.5">
                            <span>@string.Format(Loc["Admin_Dashboard_ShowingRange"], (filterEndDate - filterStartDate).Days + 1, filterStartDate.ToString("dd-MM-yyyy"), filterEndDate.ToString("dd-MM-yyyy"))</span>
                            @if (isDefault7Days)
                            {
                                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50">@Loc["Admin_Dashboard_Default7Days"]</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Date Range Selection Controls -->
                <div class="flex flex-wrap items-center gap-2.5">
                    <div class="inline-flex items-center bg-[#F8FAFC] dark:bg-[#0A1B2E] px-3 py-1.5 rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] shadow-2xs gap-2 text-xs font-semibold font-mono text-[#0A1B2E] dark:text-[#E1E8F0]">
                        <span class="text-[#7A8CA6] font-bold text-[11px]">@Loc["Admin_Dashboard_StartDate"]:</span>
                        <input type="date"
                               min="@minAllowedDateStr"
                               max="@maxAllowedDateStr"
                               @bind="tempStartDate"
                               class="bg-transparent border-0 focus:outline-none focus:ring-1 focus:ring-amber-500 cursor-pointer text-xs font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" />

                        <span class="text-[#7A8CA6] font-bold">-</span>

                        <span class="text-[#7A8CA6] font-bold text-[11px]">@Loc["Admin_Dashboard_EndDate"]:</span>
                        <input type="date"
                               min="@minAllowedDateStr"
                               max="@maxAllowedDateStr"
                               @bind="tempEndDate"
                               class="bg-transparent border-0 focus:outline-none focus:ring-1 focus:ring-amber-500 cursor-pointer text-xs font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" />
                    </div>

                    <button @onclick="ApplyDateRangeAsync"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold text-white bg-amber-600 hover:bg-amber-500 transition cursor-pointer shadow-xs">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        <span>@Loc["Admin_Dashboard_ApplyRange"]</span>
                    </button>

                    <div class="flex items-center gap-1 bg-[#F1F5F9] dark:bg-[#0A1B2E] p-1 rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <button @onclick="() => SetPresetDaysAsync(7)"
                                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold transition cursor-pointer @(isDefault7Days ? "bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-white shadow-2xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                            7 @Loc["Admin_Dashboard_Days"]
                        </button>
                        <button @onclick="() => SetPresetDaysAsync(14)"
                                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold transition cursor-pointer @((filterEndDate - filterStartDate).Days + 1 == 14 ? "bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-white shadow-2xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                            14 @Loc["Admin_Dashboard_Days"]
                        </button>
                        <button @onclick="() => SetPresetDaysAsync(30)"
                                class="px-2.5 py-1 rounded-lg text-[11px] font-semibold transition cursor-pointer @((filterEndDate - filterStartDate).Days + 1 == 30 ? "bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-white shadow-2xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                            30 @Loc["Admin_Dashboard_Days"]
                        </button>
                    </div>

                    @if (!isDefault7Days)
                    {
                        <button @onclick="ResetToDefault7DaysAsync"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700/60 hover:bg-amber-100 dark:hover:bg-amber-900/60 transition cursor-pointer shadow-2xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                            <span>@Loc["Admin_Dashboard_ResetDefault"]</span>
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(rangeValidationError))
            {
                <div class="px-3.5 py-2 rounded-xl bg-red-50 dark:bg-rose-950/40 border border-red-200 dark:border-rose-900/60 text-red-700 dark:text-rose-300 text-xs flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>@rangeValidationError</span>
                </div>
            }
        </div>

        <!-- Telemetry Graphs Section: User Onboarding Frequency (Bar Chart) & LinkDrop Transaction Volume (Line Chart) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Chart 1 (User Part): Intraday Onboarding & Verification Frequency Style (Bar Chart) -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <!-- Header -->
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="p-1 rounded-md bg-[#0A1B2E]/10 dark:bg-[#CBD5E1]/15 text-[#0A1B2E] dark:text-[#CBD5E1]">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <line x1="18" y1="20" x2="18" y2="10"/>
                                        <line x1="12" y1="20" x2="12" y2="4"/>
                                        <line x1="6" y1="20" x2="6" y2="14"/>
                                    </svg>
                                </span>
                                <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                                    @Loc["Admin_Dashboard_UserGrowthTitle"]
                                </h2>
                            </div>
                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1.5">@Loc["Admin_Dashboard_UserGrowthDesc"]</p>
                        </div>
                        <!-- Legend Indicator matching Intraday style from image -->
                        <div class="flex items-center gap-3 text-[11px] font-medium">
                            <span class="flex items-center gap-1.5 text-[#0A1B2E] dark:text-[#CBD5E1]">
                                <span class="w-2.5 h-2.5 rounded-xs bg-[#0A1B2E] dark:bg-[#CBD5E1] inline-block"></span>
                                <span>@Loc["Admin_Dashboard_NewUsers"]</span>
                            </span>
                            <span class="flex items-center gap-1.5 text-[#557392] dark:text-[#7A8CA6]">
                                <span class="w-2.5 h-2.5 rounded-xs bg-[#0A1B2E]/40 dark:bg-[#CBD5E1]/40 inline-block"></span>
                                <span>@Loc["Admin_Dashboard_ActiveUsers"]</span>
                            </span>
                        </div>
                    </div>

                    <!-- Custom SVG Bar / Column Chart -->
                    <div class="relative w-full h-48 select-none" @onmouseleave="() => hoveredUserIndex = null">
                        @if (model.Trends.Any())
                        {
                            <!-- Floating Tooltip Card (Date ONLY, no 'Show Date') -->
                            @if (hoveredUserIndex.HasValue && hoveredUserIndex.Value >= 0 && hoveredUserIndex.Value < model.Trends.Count)
                            {
                                var p = model.Trends[hoveredUserIndex.Value];
                                var slotW = 500.0 / model.Trends.Count;
                                var xPercent = ((hoveredUserIndex.Value + 0.5) / (double)model.Trends.Count) * 100.0;
                                var transformStyle = xPercent > 65 ? "transform: translateX(-105%);" : "transform: translateX(12px);";
                                <div class="absolute top-1 z-30 pointer-events-none p-3 rounded-xl bg-white/95 dark:bg-[#112A46]/95 backdrop-blur-md border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.25)] shadow-xl text-xs min-w-[200px] transition-all duration-75"
                                     style="left: @(xPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; @transformStyle">
                                    <div class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] font-mono pb-1 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                        @p.Date.ToString("dd-MM-yyyy")
                                    </div>
                                    <div class="mt-2 space-y-1">
                                        <div class="flex items-center justify-between gap-3 text-[#0A1B2E] dark:text-[#E1E8F0]">
                                            <span class="flex items-center gap-1.5 text-xs text-[#557392] dark:text-[#C4D2E1]">
                                                <span class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-[#CBD5E1] inline-block border border-slate-300 dark:border-slate-600"></span>
                                                <span>New Users :</span>
                                            </span>
                                            <span class="font-bold font-mono text-[#0A1B2E] dark:text-white">@p.NewUsers.ToString("N0")</span>
                                        </div>
                                        <div class="flex items-center justify-between gap-3 text-[#0A1B2E] dark:text-[#E1E8F0]">
                                            <span class="flex items-center gap-1.5 text-xs text-[#557392] dark:text-[#C4D2E1]">
                                                <span class="w-2 h-2 rounded-full bg-[#0A1B2E]/40 dark:bg-[#CBD5E1]/40 inline-block border border-slate-300 dark:border-slate-600"></span>
                                                <span>Current Active User :</span>
                                            </span>
                                            <span class="font-bold font-mono text-[#0A1B2E] dark:text-white">@p.ActiveUsers.ToString("N0")</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <svg class="w-full h-full overflow-visible" viewBox="0 0 500 150" preserveAspectRatio="none">
                                <!-- Horizontal Grid lines -->
                                <line x1="0" y1="30" x2="500" y2="30" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                                <line x1="0" y1="75" x2="500" y2="75" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                                <line x1="0" y1="120" x2="500" y2="120" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />

                                @{
                                    var trendCount = model.Trends.Count;
                                    var slotWidth = 500.0 / Math.Max(1, trendCount);
                                    var colWidth = Math.Max(3.0, slotWidth * 0.65);
                                    var maxUsers = Math.Max(1.0, model.Trends.Max(t => (double)Math.Max(t.NewUsers, t.ActiveUsers)));
                                }

                                <!-- Secondary / Active User stacked bars (upper/backdrop) -->
                                @for (int i = 0; i < trendCount; i++)
                                {
                                    var activeVal = (double)model.Trends[i].ActiveUsers;
                                    var barHeight = activeVal > 0 ? Math.Max(4.0, (activeVal / maxUsers) * 120.0) : 0;
                                    var x = i * slotWidth + (slotWidth - colWidth) / 2.0;
                                    var y = 140.0 - barHeight;

                                    if (barHeight > 0)
                                    {
                                        <rect x="@x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                              y="@y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                              width="@colWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                              height="@barHeight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                              rx="2.5"
                                              class="fill-[#0A1B2E]/25 dark:fill-[#CBD5E1]/30 pointer-events-none" />
                                    }
                                }

                                <!-- Primary / New Users Bar (front): Silver in dark theme, Black in white theme -->
                                @for (int i = 0; i < trendCount; i++)
                                {
                                    var val = (double)model.Trends[i].NewUsers;
                                    var barHeight = val > 0 ? Math.Max(4.0, (val / maxUsers) * 120.0) : 0;
                                    var x = i * slotWidth + (slotWidth - colWidth) / 2.0;
                                    var y = 140.0 - barHeight;
                                    var isHovered = hoveredUserIndex == i;

                                    <rect x="@x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y="@y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          width="@colWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          height="@barHeight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          rx="2.5"
                                          class="fill-[#0A1B2E] dark:fill-[#CBD5E1] pointer-events-none transition-opacity @(isHovered ? "opacity-100" : "opacity-85")" />
                                }

                                <!-- Hover guideline and small bullet point at mouse reach (NO outer ring/shadow) -->
                                @if (hoveredUserIndex.HasValue)
                                {
                                    var hIdx = hoveredUserIndex.Value;
                                    var val = (double)model.Trends[hIdx].NewUsers;
                                    var barHeight = val > 0 ? Math.Max(4.0, (val / maxUsers) * 120.0) : 0;
                                    var hBulletX = hIdx * slotWidth + slotWidth / 2.0;
                                    var hBulletY = 140.0 - barHeight;

                                    <!-- Vertical guideline -->
                                    <line x1="@hBulletX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y1="0"
                                          x2="@hBulletX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y2="140"
                                          stroke="currentColor"
                                          stroke-width="1.5"
                                          stroke-dasharray="3 3"
                                          class="text-[#0A1B2E] dark:text-[#CBD5E1] opacity-70 pointer-events-none" />

                                    <!-- Bullet point at mouse reach: Small r=2.8, NO outer ring, NO light or shadow around it -->
                                    <circle cx="@hBulletX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@hBulletY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="2.8"
                                            class="fill-[#0A1B2E] dark:fill-[#CBD5E1] stroke-white dark:stroke-[#112A46] pointer-events-none"
                                            stroke-width="1.5" />
                                }

                                <!-- Transparent Hit Zones for smooth hover detection -->
                                @for (int i = 0; i < trendCount; i++)
                                {
                                    var stripX = i * slotWidth;
                                    var localIndex = i;
                                    <rect x="@stripX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y="0"
                                          width="@slotWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          height="150"
                                          fill="transparent"
                                          class="cursor-pointer"
                                          @onmouseenter="() => hoveredUserIndex = localIndex" />
                                }
                            </svg>

                            <!-- Chart Dates Axis -->
                            <div class="flex items-center justify-between text-[10px] font-mono text-[#7A8CA6] mt-2">
                                <span>@model.Trends.First().Date.ToString("dd-MM-yyyy")</span>
                                <span>@model.Trends[model.Trends.Count / 2].Date.ToString("dd-MM-yyyy")</span>
                                <span>@model.Trends.Last().Date.ToString("dd-MM-yyyy")</span>
                            </div>
                        }
                        else
                        {
                            <div class="h-full flex items-center justify-center text-xs text-[#7A8CA6]">@Loc["Admin_Dashboard_NoTrendData"]</div>
                        }
                    </div>
                </div>

                <!-- Footer Summary Strip matching 'Intraday Onboarding & Verification Frequency' -->
                @if (model.Trends.Any())
                {
                    <div class="mt-4 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-[11px] font-mono">
                        <div class="flex items-center gap-1.5 text-[#557392] dark:text-[#C4D2E1]">
                            <span>@Loc["Admin_Dashboard_MonthlyNewUsers"]:</span>
                            <span class="font-bold text-[#0A1B2E] dark:text-white">@model.Trends.Sum(t => t.NewUsers).ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Chart 2 (Link Drop Part): User Growth Velocity Style (Line Chart) -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <!-- Header: Subtitle and LD Moved badge removed per user request -->
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div class="flex items-center gap-2">
                            <span class="p-1 rounded-md bg-[#0A1B2E]/10 dark:bg-[#CBD5E1]/15 text-[#0A1B2E] dark:text-[#CBD5E1]">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <path d="M3 17l6-6 4 4 8-8"/>
                                </svg>
                            </span>
                            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] font-display">
                                @Loc["Admin_Dashboard_LdVolumeTitle"]
                            </h2>
                        </div>
                    </div>

                    <!-- Custom SVG Smooth Line & Area Chart -->
                    <div class="relative w-full h-48 select-none" @onmouseleave="() => hoveredLdIndex = null">
                        @if (model.Trends.Any())
                        {
                            <!-- Floating Tooltip Card (Date ONLY, no 'Show Date') -->
                            @if (hoveredLdIndex.HasValue && hoveredLdIndex.Value >= 0 && hoveredLdIndex.Value < model.Trends.Count)
                            {
                                var p = model.Trends[hoveredLdIndex.Value];
                                var xPercent = (hoveredLdIndex.Value / (double)Math.Max(1, model.Trends.Count - 1)) * 100.0;
                                var transformStyle = xPercent > 65 ? "transform: translateX(-105%);" : "transform: translateX(12px);";
                                <div class="absolute top-1 z-30 pointer-events-none p-3 rounded-xl bg-white/95 dark:bg-[#112A46]/95 backdrop-blur-md border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.25)] shadow-xl text-xs min-w-[210px] transition-all duration-75"
                                     style="left: @(xPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; @transformStyle">
                                    <div class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] font-mono pb-1 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                        @p.Date.ToString("dd-MM-yyyy")
                                    </div>
                                    <div class="mt-2 space-y-1">
                                        <div class="flex items-center justify-between gap-3 text-[#0A1B2E] dark:text-[#E1E8F0]">
                                            <span class="flex items-center gap-1.5 text-xs text-[#557392] dark:text-[#C4D2E1]">
                                                <span class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-[#CBD5E1] inline-block border border-slate-300 dark:border-slate-600"></span>
                                                <span>Link Drop Purchase Amount :</span>
                                            </span>
                                            <span class="font-bold font-mono text-[#0A1B2E] dark:text-white">@p.LinkDropVolume.ToString() LD</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <svg class="w-full h-full overflow-visible" viewBox="0 0 500 150" preserveAspectRatio="none">
                                <defs>
                                    <!-- Light theme: Black area gradient -->
                                    <linearGradient id="ldVolumeGradLight" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#0A1B2E" stop-opacity="0.16" />
                                        <stop offset="100%" stop-color="#0A1B2E" stop-opacity="0.0" />
                                    </linearGradient>
                                    <!-- Dark theme: Silver area gradient -->
                                    <linearGradient id="ldVolumeGradDark" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#E2E8F0" stop-opacity="0.20" />
                                        <stop offset="100%" stop-color="#E2E8F0" stop-opacity="0.0" />
                                    </linearGradient>
                                </defs>

                                <!-- Horizontal Grid lines -->
                                <line x1="0" y1="30" x2="500" y2="30" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                                <line x1="0" y1="75" x2="500" y2="75" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
                                <line x1="0" y1="120" x2="500" y2="120" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />

                                <!-- Area fill: Black in light mode, Silver in dark mode -->
                                <path class="block dark:hidden" d="@BuildSvgSmoothAreaPath(model.Trends.Select(t => (double)t.LinkDropVolume).ToList(), 500, 140, 10)" fill="url(#ldVolumeGradLight)" />
                                <path class="hidden dark:block" d="@BuildSvgSmoothAreaPath(model.Trends.Select(t => (double)t.LinkDropVolume).ToList(), 500, 140, 10)" fill="url(#ldVolumeGradDark)" />

                                <!-- Smooth Line: Thinned to 1.5, Neon-silver in dark mode, Black in light mode, NO glow/shadow -->
                                <path d="@BuildSvgSmoothLinePath(model.Trends.Select(t => (double)t.LinkDropVolume).ToList(), 500, 140, 10)"
                                      fill="none"
                                      class="stroke-[#0A1B2E] dark:stroke-[#E2E8F0]"
                                      stroke-width="1.5"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />

                                <!-- Hover guideline and bullet point: Only rendered when mouse hovers over a point -->
                                @if (hoveredLdIndex.HasValue)
                                {
                                    var hIdx = hoveredLdIndex.Value;
                                    var hX = (500.0 / Math.Max(1, model.Trends.Count - 1)) * hIdx;
                                    var val = (double)model.Trends[hIdx].LinkDropVolume;
                                    var max = Math.Max(1.0, model.Trends.Max(t => (double)t.LinkDropVolume));
                                    var hY = 140.0 - (val / max) * 120.0;

                                    <line x1="@hX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y1="0"
                                          x2="@hX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y2="140"
                                          stroke="currentColor"
                                          stroke-width="1.5"
                                          stroke-dasharray="3 3"
                                          class="text-[#0A1B2E] dark:text-[#CBD5E1] opacity-70 pointer-events-none" />

                                    <!-- Bullet point at mouse reach: Small r=2.8, NO outer ring, NO light or shadow around it -->
                                    <circle cx="@hX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@hY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="2.8"
                                            class="fill-[#0A1B2E] dark:fill-[#FFFFFF] stroke-white dark:stroke-[#0A1B2E] pointer-events-none"
                                            stroke-width="1.5" />
                                }

                                <!-- Transparent Hit Zones for smooth hover detection -->
                                @for (int i = 0; i < model.Trends.Count; i++)
                                {
                                    var stripWidth = 500.0 / Math.Max(1, model.Trends.Count);
                                    var stripX = i * stripWidth;
                                    var localIndex = i;
                                    <rect x="@stripX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          y="0"
                                          width="@stripWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                          height="150"
                                          fill="transparent"
                                          class="cursor-pointer"
                                          @onmouseenter="() => hoveredLdIndex = localIndex" />
                                }
                            </svg>

                            <!-- Chart Dates Axis -->
                            <div class="flex items-center justify-between text-[10px] font-mono text-[#7A8CA6] mt-2">
                                <span>@model.Trends.First().Date.ToString("dd-MM-yyyy")</span>
                                <span>@model.Trends[model.Trends.Count / 2].Date.ToString("dd-MM-yyyy")</span>
                                <span>@model.Trends.Last().Date.ToString("dd-MM-yyyy")</span>
                            </div>
                        }
                        else
                        {
                            <div class="h-full flex items-center justify-center text-xs text-[#7A8CA6]">@Loc["Admin_Dashboard_NoLdTrendData"]</div>
                        }
                    </div>
                </div>

                <!-- Footer Summary Strip: Exact integer LD volume (e.g. 285200 LD), Daily Average removed per user request -->
                @if (model.Trends.Any())
                {
                    <div class="mt-4 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-[11px] font-mono">
                        <div class="flex items-center gap-1.5 text-[#557392] dark:text-[#C4D2E1]">
                            <span>@Loc["Admin_Dashboard_MonthlyTotalVolume"]:</span>
                            <span class="font-bold text-[#0A1B2E] dark:text-white">@model.Trends.Sum(t => t.LinkDropVolume) LD</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Moderation & Fast Administrative Quick Actions -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Pending Community Join Requests Moderation Queue -->
            <div class="lg:col-span-2 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div>
                        <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2 font-display">
                            <svg class="w-4 h-4 text-[#D4AF37] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            <span>@Loc["Admin_Dashboard_ModQueueTitle"]</span>
                        </h2>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_ModQueueDesc"]</p>
                    </div>
                    <a href="admin/communities" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">@Loc["Admin_Dashboard_ManageAll"] &rarr;</a>
                </div>

                @if (!model.PendingJoinRequests.Any())
                {
                    <div class="py-12 text-center text-[#7A8CA6]">
                        <div class="w-10 h-10 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center mb-2">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <p class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_AllClear"]</p>
                        <p class="text-[11px] text-[#7A8CA6] mt-0.5">@Loc["Admin_Dashboard_NoPendingRequests"]</p>
                    </div>
                }
                else
                {
                    <div class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                        @foreach (var req in model.PendingJoinRequests.Take(5))
                        {
                            <div class="py-3 flex items-center justify-between gap-4 text-xs">
                                <div>
                                    <div class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</div>
                                    <div class="text-[#557392] dark:text-[#C4D2E1] mt-0.5">
                                        @Loc["Admin_Dashboard_ApplyingTo"] <span class="font-semibold text-emerald-600 dark:text-emerald-400">@req.CommunityName</span>
                                    </div>
                                    <div class="text-[10px] text-[#7A8CA6] mt-0.5 font-mono">@req.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition text-[11px] cursor-pointer shadow-xs">
                                        @Loc["Admin_Dashboard_Approve"]
                                    </button>
                                    <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-3 py-1.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-500 transition text-[11px] cursor-pointer shadow-xs">
                                        @Loc["Admin_Dashboard_Reject"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Quick Access Directory Links -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] mb-4 pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] font-display">
                        @Loc["Admin_Dashboard_PortalsTitle"]
                    </h2>

                    <div class="space-y-2.5">
                        <a href="/reports/users" class="group flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-indigo-500/50 transition">
                            <div class="flex items-center gap-2.5">
                                <span class="p-2 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                </span>
                                <div>
                                    <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_UserPopReport"]</div>
                                    <div class="text-[10px] text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_UserPopReportDesc"]</div>
                                </div>
                            </div>
                            <span class="text-xs text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                        </a>

                        <a href="/reports/communities" class="group flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-emerald-500/50 transition">
                            <div class="flex items-center gap-2.5">
                                <span class="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.333A12.062 12.062 0 0 0 12 9c-2.485 0-4.81.75-6.75 2.033V21m15 0H3"/></svg>
                                </span>
                                <div>
                                    <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_CommHierarchyReport"]</div>
                                    <div class="text-[10px] text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_CommHierarchyReportDesc"]</div>
                                </div>
                            </div>
                            <span class="text-xs text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                        </a>

                        <a href="/linkdrops" class="group flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-amber-500/50 transition">
                            <div class="flex items-center gap-2.5">
                                <span class="p-2 rounded-lg bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                </span>
                                <div>
                                    <div class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Admin_Dashboard_LdFinancialControl"]</div>
                                    <div class="text-[10px] text-[#557392] dark:text-[#C4D2E1]">@Loc["Admin_Dashboard_LdFinancialControlDesc"]</div>
                                </div>
                            </div>
                            <span class="text-xs text-amber-600 dark:text-amber-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
                        </a>

                        <a href="admin/users" class="group flex items-center justify-between p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/40 dark:hover:border-white/30 transition">
                            <div class="flex items-center gap-2.5">
