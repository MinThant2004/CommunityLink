@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetDashboardAsync();
        if (res.IsSuccess) model = res.Data;
        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Approved join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Rejected join request.");
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject.");
        }
    }

    private static string FormatCompact(long val)
    {
        if (val >= 1_000_000) return $"{val / 1_000_000.0:0.#}M";
        if (val >= 1_000) return $"{val / 1_000.0:0.#}K";
        return val.ToString("N0");
    }

    private static string FormatRevenue(decimal val)
    {
        if (val >= 1_000_000) return $"{val / 1_000_000m:0.##}M MMK";
        if (val >= 1_000) return $"{val / 1_000m:0.#}K MMK";
        return $"{val:N0} MMK";
    }

    private static string BuildSvgLinePath(IReadOnlyList<double> values, double width, double height, double topMargin)
    {
        if (values == null || values.Count == 0) return string.Empty;
        var max = Math.Max(1.0, values.Max());
        var stepX = width / Math.Max(1, values.Count - 1);
        var sb = new System.Text.StringBuilder();

        for (int i = 0; i < values.Count; i++)
        {
            var x = i * stepX;
            var y = height - (values[i] / max) * (height - topMargin);
            var xStr = x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            var yStr = y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

            if (i == 0)
                sb.Append($"M {xStr} {yStr}");
            else
                sb.Append($" L {xStr} {yStr}");
        }

        return sb.ToString();
    }

    private static string BuildSvgAreaPath(IReadOnlyList<double> values, double width, double height, double topMargin)
    {
        if (values == null || values.Count == 0) return string.Empty;
        var line = BuildSvgLinePath(values, width, height, topMargin);
        var widthStr = width.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        var heightStr = height.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        return $"{line} L {widthStr} {heightStr} L 0 {heightStr} Z";
    }
}