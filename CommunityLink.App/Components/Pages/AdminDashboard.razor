@code {
    private bool isLoading = true;
    private AdminDashboardModel? model;
    private int? hoveredUserIndex;
    private int? hoveredLdIndex;

    private DateTime filterStartDate = DateTime.UtcNow.Date.AddDays(-6);
    private DateTime filterEndDate = DateTime.UtcNow.Date;
    private DateTime tempStartDate = DateTime.UtcNow.Date.AddDays(-6);
    private DateTime tempEndDate = DateTime.UtcNow.Date;
    private string? rangeValidationError = null;

    private int currentYear => DateTime.UtcNow.Year;
    private string minAllowedDateStr => $"{currentYear}-01-01";
    private string maxAllowedDateStr => DateTime.UtcNow.ToString("yyyy-MM-dd");

    private bool isDefault7Days =>
        filterEndDate.Date == DateTime.UtcNow.Date &&
        filterStartDate.Date == DateTime.UtcNow.Date.AddDays(-6);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task ApplyDateRangeAsync()
    {
        var today = DateTime.UtcNow.Date;
        if (tempStartDate.Year != currentYear || tempEndDate.Year != currentYear)
        {
            rangeValidationError = string.Format(Loc["Admin_Dashboard_YearWarning"], currentYear);
            return;
        }

        if (tempEndDate.Date > today)
        {
            rangeValidationError = "End date cannot be in the future.";
            return;
        }

        if (tempStartDate.Date > tempEndDate.Date)
        {
            rangeValidationError = "Start date must be before or equal to End date.";
            return;
        }

        var daySpan = (tempEndDate.Date - tempStartDate.Date).Days + 1;
        if (daySpan < 7)
        {
            rangeValidationError = Loc["Admin_Dashboard_MinRangeWarning"].Value;
            return;
        }

        if (daySpan > 30)
        {
            rangeValidationError = Loc["Admin_Dashboard_MaxRangeWarning"].Value;
            return;
        }

        rangeValidationError = null;
        filterStartDate = tempStartDate.Date;
        filterEndDate = tempEndDate.Date;
        await LoadDashboardAsync();
    }

    private async Task ResetToDefault7DaysAsync()
    {
        var today = DateTime.UtcNow.Date;
        tempStartDate = today.AddDays(-6);
        tempEndDate = today;
        filterStartDate = tempStartDate;
        filterEndDate = tempEndDate;
        rangeValidationError = null;
        await LoadDashboardAsync();
    }

    private async Task SetPresetDaysAsync(int days)
    {
        var today = DateTime.UtcNow.Date;
        tempStartDate = today.AddDays(-(days - 1));
        tempEndDate = today;
        filterStartDate = tempStartDate;
        filterEndDate = tempEndDate;
        rangeValidationError = null;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        hoveredUserIndex = null;
        hoveredLdIndex = null;
        var res = await AdminApi.GetDashboardAsync(fromDate: filterStartDate, toDate: filterEndDate);
        if (res.IsSuccess) model = res.Data;
        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success(Loc["Admin_Dashboard_Toast_ApprovedJoin"]);
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Dashboard_Toast_ApproveFailed"].Value);
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success(Loc["Admin_Dashboard_Toast_RejectedJoin"]);
            await LoadDashboardAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Dashboard_Toast_RejectFailed"].Value);
        }
    }

    private static string FormatCompact(long val)
    {
        if (val >= 1_000_000) return $"{val / 1_000_000.0:0.#}M";
        if (val >= 1_000) return $"{val / 1_000.0:0.#}K";
        return val.ToString("N0");
    }

    private static string FormatRevenue(decimal val)
    {
        if (val >= 1_000_000) return $"{val / 1_000_000m:0.##}M MMK";
        if (val >= 1_000) return $"{val / 1_000m:0.#}K MMK";
        return $"{val:N0} MMK";
    }

    private static (List<double> X, List<double> Y) GetSvgPoints(IReadOnlyList<double> values, double width, double height, double topMargin)
    {
        var xs = new List<double>();
        var ys = new List<double>();
        if (values == null || values.Count == 0) return (xs, ys);

        var max = Math.Max(1.0, values.Max());
        var count = values.Count;
        var stepX = count <= 1 ? 0.0 : width / (count - 1);

        for (int i = 0; i < count; i++)
        {
            var x = count <= 1 ? width / 2.0 : i * stepX;
            var y = height - (values[i] / max) * (height - topMargin);
            xs.Add(x);
            ys.Add(y);
        }

        return (xs, ys);
    }

    private static string BuildSvgSmoothLinePath(IReadOnlyList<double> values, double width, double height, double topMargin)
    {
        if (values == null || values.Count == 0) return string.Empty;
        var (xs, ys) = GetSvgPoints(values, width, height, topMargin);
        var n = xs.Count;
        if (n == 1) return $"M {xs[0]:F1} {ys[0]:F1}";
        if (n == 2) return $"M {xs[0]:F1} {ys[0]:F1} L {xs[1]:F1} {ys[1]:F1}";

        var sb = new System.Text.StringBuilder();
        sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {xs[0]:F1} {ys[0]:F1}");

        const double tension = 0.2;
        for (int i = 0; i < n - 1; i++)
        {
            var p0X = xs[i];
            var p0Y = ys[i];
            var p1X = xs[i + 1];
            var p1Y = ys[i + 1];

            var prevX = i > 0 ? xs[i - 1] : p0X;
            var prevY = i > 0 ? ys[i - 1] : p0Y;

            var nextX = i + 2 < n ? xs[i + 2] : p1X;
            var nextY = i + 2 < n ? ys[i + 2] : p1Y;

            var cp1X = p0X + (p1X - prevX) * tension;
            var cp1Y = Math.Clamp(p0Y + (p1Y - prevY) * tension, topMargin, height);

            var cp2X = p1X - (nextX - p0X) * tension;
            var cp2Y = Math.Clamp(p1Y - (nextY - p0Y) * tension, topMargin, height);

            sb.Append(System.Globalization.CultureInfo.InvariantCulture,
                $" C {cp1X:F1} {cp1Y:F1}, {cp2X:F1} {cp2Y:F1}, {p1X:F1} {p1Y:F1}");
        }

        return sb.ToString();
    }

    private static string BuildSvgSmoothAreaPath(IReadOnlyList<double> values, double width, double height, double topMargin)
    {
        if (values == null || values.Count == 0) return string.Empty;
        var line = BuildSvgSmoothLinePath(values, width, height, topMargin);
        var widthStr = width.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        var heightStr = height.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        return $"{line} L {widthStr} {heightStr} L 0 {heightStr} Z";
    }
}
