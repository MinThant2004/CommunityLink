@page "/admin/audits"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.SystemAuditView)]
@inject AdministrationApiService AdminApi

<PageTitle>System Audit Logs — Admin Control Panel</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">📜 System Audit Trail</h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1]">Audit log tracking role creations, permission modifications, user role assignments, and account setup.</p>
        </div>
    </div>

    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
        <div class="p-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition" placeholder="Search action or entity..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-[#7A8CA6] font-mono">
                Showing page @pageNumber of @totalPages (@totalCount log records)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading audit trail...</p>
            </div>
        }
        else if (logs == null || !logs.Any())
        {
            <div class="p-8 text-center text-[#7A8CA6] dark:text-[#C4D2E1]">
                <p class="text-sm font-medium">No audit log records found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#F1F5F9] dark:bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                            <th class="px-4 py-3">No.</th>
                            <th class="px-4 py-3">Type</th>
                            <th class="px-4 py-3">Action</th>
                            <th class="px-4 py-3">Old Value</th>
                            <th class="px-4 py-3">New Value</th>
                            <th class="px-4 py-3">Modified By</th>
                            <th class="px-4 py-3">Changed Columns</th>
                            <th class="px-4 py-3">Updated At</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)] text-xs">
                        @{
                            var rowNum = (pageNumber - 1) * pageSize;
                        }
                        @foreach (var l in logs)
                        {
                            rowNum++;
                            <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/40 transition">
                                <td class="px-4 py-3 font-mono text-xs text-[#7A8CA6]">@rowNum</td>
                                <td class="px-4 py-3 font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-[#E2E8F0] dark:bg-[#1E3A5F] text-[#0A1B2E] dark:text-[#E1E8F0]">
                                        @l.EntityName
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider
                                        @(l.Action == "CREATE" ? "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300" :
                                          l.Action == "DELETE" ? "bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-300" :
                                          "bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300")">
                                        @l.Action
                                    </span>
                                </td>
                                <td class="px-4 py-3 max-w-xs break-words text-[#557392] dark:text-[#94A3B8]">
                                    @(string.IsNullOrWhiteSpace(l.OldValues) ? "—" : l.OldValues)
                                </td>
                                <td class="px-4 py-3 max-w-xs break-words font-medium text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    @(string.IsNullOrWhiteSpace(l.NewValues) ? "—" : l.NewValues)
                                </td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0]">@(l.UserName ?? "System")</div>
                                    <div class="text-[10px] text-[#7A8CA6]">@(l.ActorType ?? "User")</div>
                                </td>
                                <td class="px-4 py-3 font-mono text-[11px] text-[#557392] dark:text-[#94A3B8]">
                                    @(string.IsNullOrWhiteSpace(l.ChangedColumns) ? "—" : l.ChangedColumns)
                                </td>
                                <td class="px-4 py-3 text-[11px] text-[#7A8CA6] font-mono whitespace-nowrap">
                                    @((l.UpdatedAt ?? l.CreatedAt).ToString("yyyy-MM-dd HH:mm:ss"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-xs text-[#7A8CA6] bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] font-medium hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white disabled:opacity-50 transition cursor-pointer">
                    &larr; Previous
                </button>
                <span class="font-mono">Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] font-medium hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white disabled:opacity-50 transition cursor-pointer">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<AuditLogModel>? logs;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetAuditLogsPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            logs = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadLogsAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadLogsAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadLogsAsync();
        }
    }
}
