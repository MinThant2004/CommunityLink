@page "/admin/audits"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi

<PageTitle>System Audit Logs — Admin Control Panel</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">📜 System Audit Trail</h1>
            <p class="text-sm text-[#557392]">System audit records, administrative operations, and security event logs.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-[#E2E8F0] overflow-hidden shadow-sm">
        <div class="p-4 border-b border-[#E2E8F0] bg-[#F8FAFC] flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm bg-white text-[#0A1B2E] placeholder-[#7A8CA6] border border-[#CBD5E1] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 focus:border-[#0A1B2E] transition" placeholder="Search action or entity..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-[#7A8CA6] font-mono">
                Showing page @pageNumber of @totalPages (@totalCount log records)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-[#557392]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading audit trail...</p>
            </div>
        }
        else if (logs == null || !logs.Any())
        {
            <div class="p-8 text-center text-[#7A8CA6]">
                <p class="text-sm font-medium">No audit log records found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#F1F5F9] border-b border-[#E2E8F0] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                            <th class="px-6 py-3">Log ID</th>
                            <th class="px-6 py-3">Actor</th>
                            <th class="px-6 py-3">Action</th>
                            <th class="px-6 py-3">Target Entity</th>
                            <th class="px-6 py-3">IP Address</th>
                            <th class="px-6 py-3">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] text-sm">
                        @foreach (var l in logs)
                        {
                            <tr class="hover:bg-[#F8FAFC] transition">
                                <td class="px-6 py-4 font-mono text-xs text-[#7A8CA6]">#@l.AuditLogId</td>
                                <td class="px-6 py-4">
                                    <div class="font-medium text-[#0A1B2E]">@(l.UserName ?? "System")</div>
                                    <div class="text-xs text-[#7A8CA6] font-mono">@(l.UserId != null ? $"User #{l.UserId}" : "System Actor")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0]">
                                        @l.Action
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-[#0A1B2E] font-medium">
                                    @l.EntityName @(l.EntityId != null ? $"({l.EntityId})" : "")
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-[#7A8CA6]">
                                    @(l.IpAddress ?? "Localhost")
                                </td>
                                <td class="px-6 py-4 text-xs text-[#7A8CA6] font-mono">@l.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs text-[#7A8CA6] bg-[#F8FAFC]">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] bg-white text-[#557392] font-medium hover:border-[#0A1B2E] hover:text-[#0A1B2E] disabled:opacity-50 transition">
                    &larr; Previous
                </button>
                <span class="font-mono">Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] bg-white text-[#557392] font-medium hover:border-[#0A1B2E] hover:text-[#0A1B2E] disabled:opacity-50 transition">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<AuditLogModel>? logs;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetAuditLogsPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            logs = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadLogsAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadLogsAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadLogsAsync();
        }
    }
}
