@page "/admin/audits"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi

<PageTitle>System Audit Logs — Admin Control Panel</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">📜 System Audit Trail</h1>
            <p class="text-sm text-slate-500">System audit records, administrative operations, and security event logs.</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-200 bg-slate-50/50 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Search action or entity..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-slate-500">
                Showing page @pageNumber of @totalPages (@totalCount log records)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading audit trail...</p>
            </div>
        }
        else if (logs == null || !logs.Any())
        {
            <div class="p-8 text-center text-slate-500">
                <p class="text-sm font-medium">No audit log records found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="px-6 py-3">Log ID</th>
                            <th class="px-6 py-3">Actor</th>
                            <th class="px-6 py-3">Action</th>
                            <th class="px-6 py-3">Target Entity</th>
                            <th class="px-6 py-3">IP Address</th>
                            <th class="px-6 py-3">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 text-sm">
                        @foreach (var l in logs)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">#@l.AuditLogId</td>
                                <td class="px-6 py-4">
                                    <div class="font-medium text-slate-900">@(l.UserName ?? "System")</div>
                                    <div class="text-xs text-slate-400">@(l.UserId != null ? $"User #{l.UserId}" : "System Actor")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200">
                                        @l.Action
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-700 font-medium">
                                    @l.EntityName @(l.EntityId != null ? $"({l.EntityId})" : "")
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-slate-500">
                                    @(l.IpAddress ?? "Localhost")
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500">@l.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white font-medium hover:bg-slate-50 disabled:opacity-50 transition">
                    &larr; Previous
                </button>
                <span>Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white font-medium hover:bg-slate-50 disabled:opacity-50 transition">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<AuditLogModel>? logs;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetAuditLogsPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            logs = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadLogsAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadLogsAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadLogsAsync();
        }
    }
}
