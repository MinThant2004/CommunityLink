@page "/admin/verifications"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserManage)]
@inject PremiumUpgradeApiService UpgradeApi
@inject ToastService Toast
@rendermode InteractiveServer

<PageTitle>Identity Verification Audits — Admin Control Panel</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">🛡️ Identity Verification Audits</h1>
            <p class="text-sm text-[#557392]">Inspect official government credentials, legal identities, and LinkDrop payments submitted for premium badge upgrades.</p>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="LoadVerificationsAsync" class="px-3.5 py-2 rounded-lg text-xs font-semibold text-[#0A1B2E] bg-white border border-[#CBD5E1] hover:bg-slate-50 transition flex items-center gap-2 cursor-pointer shadow-sm">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                <span>Refresh List</span>
            </button>
        </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="flex items-center gap-2 border-b border-[#E2E8F0] pb-3 text-xs font-semibold">
        <button @onclick='() => statusFilter = "PENDING"' class="px-3 py-1.5 rounded-lg transition @(statusFilter == "PENDING" ? "bg-amber-600 text-white shadow-sm" : "bg-white text-[#557392] hover:bg-[#F1F5F9]")">
            ⏳ Pending Review (@(allList?.Count(v => v.Status == "PENDING") ?? 0))
        </button>
        <button @onclick='() => statusFilter = "APPROVED"' class="px-3 py-1.5 rounded-lg transition @(statusFilter == "APPROVED" ? "bg-emerald-600 text-white shadow-sm" : "bg-white text-[#557392] hover:bg-[#F1F5F9]")">
            ✅ Approved (@(allList?.Count(v => v.Status == "APPROVED") ?? 0))
        </button>
        <button @onclick='() => statusFilter = "REJECTED"' class="px-3 py-1.5 rounded-lg transition @(statusFilter == "REJECTED" ? "bg-rose-600 text-white shadow-sm" : "bg-white text-[#557392] hover:bg-[#F1F5F9]")">
            ❌ Rejected (@(allList?.Count(v => v.Status == "REJECTED") ?? 0))
        </button>
        <button @onclick='() => statusFilter = "ALL"' class="px-3 py-1.5 rounded-lg transition @(statusFilter == "ALL" ? "bg-[#0A1B2E] text-white shadow-sm" : "bg-white text-[#557392] hover:bg-[#F1F5F9]")">
            All Records (@(allList?.Count ?? 0))
        </button>
    </div>

    <!-- Main Content Area -->
    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] bg-white rounded-xl border border-[#E2E8F0] shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
            <p class="mt-3 text-xs font-medium">Loading identity audits...</p>
        </div>
    }
    else if (FilteredList.Count == 0)
    {
        <div class="p-12 text-center bg-white rounded-xl border border-dashed border-[#CBD5E1] text-[#7A8CA6] space-y-3">
            <span class="text-3xl">📭</span>
            <h4 class="font-bold text-sm text-[#0A1B2E]">No Applications Found</h4>
            <p class="text-xs max-w-sm mx-auto">There are no verification requests matching your selected filter at this time.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl border border-[#E2E8F0] shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700">
                    <thead class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-[#E2E8F0]">
                        <tr>
                            <th class="p-4">Applicant</th>
                            <th class="p-4">Target Tier</th>
                            <th class="p-4">Legal Name</th>
                            <th class="p-4">Payment</th>
                            <th class="p-4">Submitted At</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0]">
                        @foreach (var item in FilteredList)
                        {
                            var isPending = item.Status == "PENDING";
                            var isApproved = item.Status == "APPROVED";
                            var isRejected = item.Status == "REJECTED";

                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="p-4">
                                    <div class="font-bold text-slate-900">@item.UserName</div>
                                    <div class="text-[11px] text-slate-400">@item.UserEmail</div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-1.5">
                                        @if (item.TargetRoleCode == "PUBLIC_FIGURE")
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">
                                                VIP Figure
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                                Domain Pro
                                            </span>
                                        }
                                        <span class="font-medium text-slate-600">@item.PlanName</span>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="font-semibold text-slate-900">@item.FullLegalName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.WorkEmail))
                                    {
                                        <div class="text-[11px] text-slate-500">✉️ @item.WorkEmail</div>
                                    }
                                </td>
                                <td class="p-4">
                                    @if (item.LinkDropPointsDeducted > 0)
                                    {
                                        <span class="inline-flex items-center gap-1 font-semibold text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200">
                                            💧 @item.LinkDropPointsDeducted.ToString("N0") LD
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 font-medium">@(item.PaymentMethod ?? "Direct")</span>
                                    }
                                </td>
                                <td class="p-4 text-slate-500">
                                    <div>@item.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-[10px] text-slate-400">@item.CreatedAtUtc.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>
                                <td class="p-4">
                                    @if (isPending)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                            ⏳ Pending Audit
                                        </span>
                                    }
                                    else if (isApproved)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                            ✅ Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                            ❌ Rejected
                                        </span>
                                    }
                                </td>
                                <td class="p-4 text-right">
                                    <button @onclick="() => InspectVerification(item)" class="px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-[#0A1B2E] hover:bg-[#112A46] transition cursor-pointer shadow-sm">
                                        Inspect ID
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Inspection Drawer / Modal -->
@if (selectedItem != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-2xl w-full border border-slate-200 shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="text-xl">🪪</span>
                    <div>
                        <h3 class="font-bold text-base">Identity Audit: @selectedItem.FullLegalName</h3>
                        <p class="text-xs text-slate-300">Applying for @selectedItem.PlanName (@selectedItem.TargetRoleCode)</p>
                    </div>
                </div>
                <button @onclick="CloseModal" class="text-slate-400 hover:text-white p-1 rounded-md text-lg">✕</button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto">
                <!-- Applicant Metadata Card -->
                <div class="grid grid-cols-2 gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs">
                    <div>
                        <span class="text-slate-400 font-medium block">Account Username</span>
                        <span class="font-bold text-slate-800 text-sm">@selectedItem.UserName</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Submission Date</span>
                        <span class="font-semibold text-slate-700">@selectedItem.CreatedAtUtc.ToLocalTime().ToString("f")</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Work / Corporate Email</span>
                        <span class="font-semibold text-slate-700">@(string.IsNullOrWhiteSpace(selectedItem.WorkEmail) ? "None specified" : selectedItem.WorkEmail)</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Professional Profile URL</span>
                        @if (!string.IsNullOrWhiteSpace(selectedItem.ProfessionalUrl))
                        {
                            <a href="@selectedItem.ProfessionalUrl" target="_blank" class="font-bold text-indigo-600 hover:underline truncate block">
                                @selectedItem.ProfessionalUrl
                            </a>
                        }
                        else
                        {
                            <span class="text-slate-400">Not provided</span>
                        }
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">LinkDrop Escrow Paid</span>
                        <span class="font-bold text-sky-700">@selectedItem.LinkDropPointsDeducted.ToString("N0") LD Points</span>
                    </div>
                    <div>
                        <span class="text-slate-400 font-medium block">Review Status</span>
                        <span class="font-bold @(selectedItem.Status == "APPROVED" ? "text-emerald-600" : selectedItem.Status == "REJECTED" ? "text-rose-600" : "text-amber-600")">
                            @selectedItem.Status
                        </span>
                    </div>
                </div>

                <!-- Identity Card Images -->
                <div class="space-y-4">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Government Identity Card Credentials</h4>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Front Card -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white space-y-2">
                            <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
                                <span>Front Face View</span>
                                <a href="@selectedItem.IdCardFrontUrl" target="_blank" class="text-indigo-600 hover:underline text-[11px]">Open Full ↗</a>
                            </div>
                            <div class="aspect-[1.586/1] bg-slate-100 rounded-lg overflow-hidden border border-slate-200 flex items-center justify-center">
                                <img src="@selectedItem.IdCardFrontUrl" alt="Identity Card Front" class="w-full h-full object-contain cursor-zoom-in" @onclick='() => previewImageUrl = selectedItem.IdCardFrontUrl' />
                            </div>
                        </div>

                        <!-- Back Card -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white space-y-2">
                            <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
                                <span>Back Face View</span>
                                @if (!string.IsNullOrWhiteSpace(selectedItem.IdCardBackUrl))
                                {
                                    <a href="@selectedItem.IdCardBackUrl" target="_blank" class="text-indigo-600 hover:underline text-[11px]">Open Full ↗</a>
                                }
                            </div>
                            <div class="aspect-[1.586/1] bg-slate-100 rounded-lg overflow-hidden border border-slate-200 flex items-center justify-center">
                                @if (!string.IsNullOrWhiteSpace(selectedItem.IdCardBackUrl))
                                {
                                    <img src="@selectedItem.IdCardBackUrl" alt="Identity Card Back" class="w-full h-full object-contain cursor-zoom-in" @onclick='() => previewImageUrl = selectedItem.IdCardBackUrl' />
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">No back-side image uploaded</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Action Notes / Decision Record -->
                @if (selectedItem.Status != "PENDING")
                {
                    <div class="p-4 rounded-xl border @(selectedItem.Status == "APPROVED" ? "border-emerald-200 bg-emerald-50/50" : "border-rose-200 bg-rose-50/50") text-xs">
                        <div class="font-bold text-slate-800 mb-1">Audit Record (@selectedItem.Status)</div>
                        @if (!string.IsNullOrWhiteSpace(selectedItem.ReviewNotes))
                        {
                            <p class="text-slate-600"><strong>Notes:</strong> @selectedItem.ReviewNotes</p>
                        }
                        @if (selectedItem.ReviewedAtUtc.HasValue)
                        {
                            <p class="text-[10px] text-slate-400 mt-2">Processed on @selectedItem.ReviewedAtUtc.Value.ToLocalTime().ToString("f")</p>
                        }
                    </div>
                }
                else
                {
                    <!-- Review Actions Form -->
                    <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 space-y-3 text-xs">
                        <h5 class="font-bold text-slate-800">Admin Audit Action</h5>
                        <div>
                            <label class="block font-medium text-slate-600 mb-1">Optional Notes / Reason</label>
                            <input type="text" @bind="adminNotesInput" placeholder="e.g. Identity verified against government database or reason if declining..." class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-none focus:border-indigo-600" />
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                <button @onclick="CloseModal" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 transition">
                    Close
                </button>
                
                @if (selectedItem.Status == "PENDING")
                {
                    <div class="flex items-center gap-3">
                        <button @onclick="RejectSelectedAsync" disabled="@isProcessing" class="px-4 py-2 rounded-lg text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition disabled:opacity-50 flex items-center gap-1.5">
                            <span>❌</span> Reject Application
                        </button>
                        <button @onclick="ApproveSelectedAsync" disabled="@isProcessing" class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition disabled:opacity-50 flex items-center gap-1.5">
                            <span>✅</span> Approve &amp; Issue Badge
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Image Zoom Lightbox -->
@if (!string.IsNullOrWhiteSpace(previewImageUrl))
{
    <div class="fixed inset-0 z-60 bg-black/80 flex items-center justify-center p-6" @onclick='() => previewImageUrl = null'>
        <div class="relative max-w-4xl max-h-[90vh]">
            <img src="@previewImageUrl" alt="Enlarged view" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl object-contain" />
            <div class="text-center text-white text-xs mt-3 font-semibold">Click anywhere to close</div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<IdentityVerificationDetailDto>? allList;
    private string statusFilter = "PENDING";
    private bool isLoading = true;
    private bool isProcessing = false;
    private IdentityVerificationDetailDto? selectedItem;
    private string? adminNotesInput;
    private string? previewImageUrl;

    private IReadOnlyList<IdentityVerificationDetailDto> FilteredList =>
        allList == null ? Array.Empty<IdentityVerificationDetailDto>() :
        statusFilter == "ALL" ? allList :
        allList.Where(v => v.Status == statusFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadVerificationsAsync();
    }

    private async Task LoadVerificationsAsync()
    {
        isLoading = true;
        try
        {
            var res = await UpgradeApi.GetAllVerificationsAdminAsync();
            if (res.IsSuccess && res.Data != null)
            {
                allList = res.Data;
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to fetch verification audits.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InspectVerification(IdentityVerificationDetailDto item)
    {
        selectedItem = item;
        adminNotesInput = null;
    }

    private void CloseModal()
    {
        selectedItem = null;
        adminNotesInput = null;
    }

    private async Task ApproveSelectedAsync()
    {
        if (selectedItem == null) return;
        isProcessing = true;
        try
        {
            var res = await UpgradeApi.ApproveVerificationAsync(selectedItem.VerificationId, adminNotesInput);
            if (res.IsSuccess)
            {
                Toast.Success($"Verification for {selectedItem.FullLegalName} successfully approved! Badge issued.");
                CloseModal();
                await LoadVerificationsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to approve verification.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectSelectedAsync()
    {
        if (selectedItem == null) return;
        if (string.IsNullOrWhiteSpace(adminNotesInput))
        {
            Toast.Warning("Please provide a reason in the notes field before rejecting.");
            return;
        }

        isProcessing = true;
        try
        {
            var res = await UpgradeApi.RejectVerificationAsync(selectedItem.VerificationId, adminNotesInput);
            if (res.IsSuccess)
            {
                Toast.Success($"Verification for {selectedItem.FullLegalName} rejected and points refunded.");
                CloseModal();
                await LoadVerificationsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to reject verification.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
