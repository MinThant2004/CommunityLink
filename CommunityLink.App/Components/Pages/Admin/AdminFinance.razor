@page "/admin/finance"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Finance
@using CommunityLink.Shared.Security
@inject AdminFinanceApiService FinanceApi
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Platform Finance &amp; Revenue — Admin Control Panel</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs transition-all duration-200 hover:shadow-md hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)]">
        <div>
            <h1 class="text-2xl font-bold text-[#0F172A] dark:text-[#E1E8F0] flex items-center gap-2.5" style="font-family:'Plus Jakarta Sans',sans-serif">
                <svg class="w-6 h-6 text-[#0A1B2E] dark:text-[#E1E8F0] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span>Platform Finance &amp; Revenue</span>
            </h1>
            <p class="text-sm text-[#475569] dark:text-[#94A3B8] mt-1">Platform-wide financial revenue, commission aggregation, and payout summary.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" @onclick="ExportCsv" disabled="@isExporting"
                    class="px-4 py-2 bg-[#0F172A] hover:bg-[#1E293B] text-white dark:bg-[#E1E8F0] dark:hover:bg-white dark:text-[#0A1B2E] rounded-lg text-xs font-bold transition-all duration-150 shadow-xs active:scale-[0.98] flex items-center gap-2 disabled:opacity-50 cursor-pointer">
                @if (isExporting)
                {
                    <span class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white dark:border-[#0A1B2E] border-t-transparent"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span>Export CSV</span>
                }
            </button>
            <button type="button" @onclick="LoadAllData" class="px-4 py-2 bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] text-[#475569] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#F8FAFC] dark:hover:bg-[#182030] hover:text-[#0F172A] dark:hover:text-white transition-all duration-150 shadow-xs active:scale-[0.98] flex items-center gap-2 cursor-pointer">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>Refresh Data</span>
            </button>
        </div>
    </div>

    <!-- DATE FILTER BAR -->
    <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-3 transition-all duration-200 hover:shadow-md hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)]">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-3">
            <h2 class="text-xs font-bold font-mono text-[#475569] dark:text-[#E1E8F0] uppercase tracking-wider">Financial Date Filter</h2>
            @if (fromDateInput.HasValue || toDateInput.HasValue)
            {
                <span class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] rounded-md px-2.5 py-0.5">
                    Active Period Filter
                </span>
            }
            else
            {
                <span class="text-xs font-medium text-[#64748B]">Showing All-Time Overall Totals</span>
            }
        </div>

        <div class="flex flex-col sm:flex-row items-end gap-4">
            <div class="w-full sm:w-auto flex-1">
                <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8] mb-1">From Date</label>
                <input type="date" @bind="fromDateInput"
                       class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg px-3 py-2 text-xs text-[#0F172A] dark:text-[#E1E8F0] focus:bg-white dark:focus:bg-[#111622] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none" />
            </div>

            <div class="w-full sm:w-auto flex-1">
                <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8] mb-1">To Date</label>
                <input type="date" @bind="toDateInput"
                       class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg px-3 py-2 text-xs text-[#0F172A] dark:text-[#E1E8F0] focus:bg-white dark:focus:bg-[#111622] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="button" @onclick="ApplyDateFilter" class="px-4 py-2 bg-[#0A1B2E] hover:bg-[#112A46] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] dark:hover:bg-white rounded-lg text-xs font-semibold transition shadow-xs cursor-pointer">
                    Apply Filter
                </button>
                <button type="button" @onclick="ResetDateFilter" class="px-3.5 py-2 bg-[#F1F5F9] dark:bg-[#191B23] text-[#475569] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg text-xs font-semibold hover:bg-[#E2E8F0] dark:hover:bg-[#1E2638] transition cursor-pointer">
                    Reset
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-12 text-center shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent mb-4"></div>
            <p class="text-sm font-medium text-[#475569] dark:text-[#94A3B8]">Loading financial summary data...</p>
        </div>
    }
    else if (isForbidden)
    {
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl p-8 text-rose-800 dark:text-rose-200 shadow-xs text-center space-y-3">
            <svg class="w-12 h-12 text-rose-500 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            <h3 class="text-lg font-bold text-rose-900 dark:text-white" style="font-family:'Plus Jakarta Sans',sans-serif">Access Denied</h3>
            <p class="text-sm text-rose-700 dark:text-rose-300 max-w-md mx-auto">Administrator privileges are required to access platform financial metrics.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl p-6 text-rose-800 dark:text-rose-200 shadow-xs flex items-start gap-4">
            <div class="flex-1">
                <h3 class="font-bold text-rose-900 dark:text-white" style="font-family:'Plus Jakarta Sans',sans-serif">Error Loading Financial Data</h3>
                <p class="text-sm text-rose-700 dark:text-rose-300 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadAllData" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition cursor-pointer">
                    Retry
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- SUMMARY CARDS GRID (4 Clean Financial Pillars) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 1. Total Platform Revenue -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-3 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-emerald-500/40 dark:hover:bg-[#182030] dark:hover:border-emerald-400/40">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-bold font-mono uppercase tracking-wider">Total Revenue</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 text-emerald-700 dark:text-emerald-400 flex items-center justify-center shadow-xs">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M14.8 9A2 2 0 0 0 13 8h-2a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-1.8-1"/><path d="M12 6v12"/></svg>
                    </span>
                </div>
                <div>
                    <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                        @(summary?.GrossChatGroupRevenueLinkDrops ?? 0) <span class="text-xs font-normal text-[#64748B]">LD</span>
                    </div>
                    <div class="text-[11px] font-mono font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 rounded px-1.5 py-0.5 inline-block mt-1">
                        ≈ @(((summary?.GrossChatGroupRevenueLinkDrops ?? 0) * 100m).ToString("N0")) MMK
                    </div>
                </div>
                <!-- Breakdown sub-details -->
                <div class="border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pt-2 space-y-1 text-xs">
                    <div class="flex justify-between text-[#475569] dark:text-[#C4D2E1]">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span> Group Joins:
                        </span>
                        <span class="font-bold font-mono text-[#0F172A] dark:text-white">@(summary?.GroupRevenueLinkDrops ?? 0) LD <span class="text-[10px] text-[#64748B]">(@(summary?.GroupTxCount ?? 0))</span></span>
                    </div>
                    <div class="flex justify-between text-[#475569] dark:text-[#C4D2E1]">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-purple-500"></span> Private Chats:
                        </span>
                        <span class="font-bold font-mono text-[#0F172A] dark:text-white">@(summary?.PrivateChatRevenueLinkDrops ?? 0) LD <span class="text-[10px] text-[#64748B]">(@(summary?.PrivateChatTxCount ?? 0))</span></span>
                    </div>
                </div>
            </div>

            <!-- 2. Platform Commission -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-3 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:bg-[#112A46] dark:hover:border-[rgba(196,210,225,0.30)]">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-bold font-mono uppercase tracking-wider">Platform Cut</span>
                    <span class="w-8 h-8 rounded-lg bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center shadow-xs">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                    </span>
                </div>
                <div>
                    <div class="text-2xl font-extrabold font-mono text-[#0A1B2E] dark:text-[#E1E8F0]">
                        @(summary?.PlatformCommissionLinkDrops ?? 0) <span class="text-xs font-normal text-[#64748B]">LD</span>
                    </div>
                    <div class="text-[11px] font-mono font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] rounded px-1.5 py-0.5 inline-block mt-1">
                        ≈ @(((summary?.PlatformCommissionLinkDrops ?? 0) * 100m).ToString("N0")) MMK
                    </div>
                </div>
                <div class="border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pt-2 text-xs text-[#64748B] flex items-center justify-between">
                    <span>Net Platform Earnings</span>
                    <span class="font-bold font-mono text-[#0A1B2E] dark:text-[#E1E8F0]">@(summary != null && summary.GrossChatGroupRevenueLinkDrops > 0 ? $"{(summary.PlatformCommissionLinkDrops * 100.0 / summary.GrossChatGroupRevenueLinkDrops):F0}%" : "0%")</span>
                </div>
            </div>

            <!-- 3. Creator Net Earnings -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-3 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:bg-[#112A46] dark:hover:border-[rgba(196,210,225,0.30)]">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-bold font-mono uppercase tracking-wider">Creator Earnings</span>
                    <span class="w-8 h-8 rounded-lg bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center shadow-xs">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </span>
                </div>
                <div>
                    <div class="text-2xl font-extrabold font-mono text-[#0F172A] dark:text-white">
                        @(summary?.CreatorNetEarningsLinkDrops ?? 0) <span class="text-xs font-normal text-[#64748B]">LD</span>
                    </div>
                    <div class="text-[11px] font-mono font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] rounded px-1.5 py-0.5 inline-block mt-1">
                        ≈ @(((summary?.CreatorNetEarningsLinkDrops ?? 0) * 100m).ToString("N0")) MMK
                    </div>
                </div>
                <div class="border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pt-2 text-xs text-[#64748B] flex items-center justify-between">
                    <span>Credited to Creators</span>
                    <span class="font-bold font-mono text-[#0A1B2E] dark:text-[#E1E8F0]">@(summary != null && summary.GrossChatGroupRevenueLinkDrops > 0 ? $"{(summary.CreatorNetEarningsLinkDrops * 100.0 / summary.GrossChatGroupRevenueLinkDrops):F0}%" : "0%")</span>
                </div>
            </div>

            <!-- 4. Creator Cash-Out Payouts -->
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-5 shadow-xs space-y-3 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-teal-500/40 dark:hover:bg-[#182030] dark:hover:border-teal-400/40">
                <div class="flex items-center justify-between text-[#64748B]">
                    <span class="text-xs font-bold font-mono uppercase tracking-wider">Creator Payouts</span>
                    <span class="w-8 h-8 rounded-lg bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/40 text-teal-700 dark:text-teal-400 flex items-center justify-center shadow-xs">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                </div>
                <div>
                    <div class="text-2xl font-extrabold font-mono text-teal-900 dark:text-teal-300">
                        @(summary?.CompletedCreatorPayoutsLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500 dark:text-slate-400">LD</span>
                    </div>
                    <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        @(summary?.CompletedPayoutCount ?? 0) completed cash-outs
                    </div>
                </div>
                <div class="border-t border-slate-100 dark:border-[rgba(196,210,225,0.08)] pt-2 text-xs flex items-center justify-between">
                    @if ((summary?.PendingPayoutCount ?? 0) > 0)
                    {
                        <span class="font-semibold text-amber-700 dark:text-amber-400 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                            @(summary?.PendingPayoutCount ?? 0) pending review
                        </span>
                        <span class="font-bold text-amber-700 dark:text-amber-400">@(summary?.PendingCreatorPayoutsLinkDrops ?? 0) LD</span>
                    }
                    else
                    {
                        <span class="text-slate-400">No pending payouts</span>
                        <span class="text-emerald-600 dark:text-emerald-400 font-semibold">✓ Clear</span>
                    }
                </div>
            </div>
        </div>

        <!-- REVENUE BREAKDOWN SECTION (Tabbed: Group Chat & Private Chat) -->
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-5 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-4">
                <div>
                    <h2 class="text-base font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Revenue Stream Breakdown</h2>
                    <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Inspect revenue generated by Chat Groups vs. 1-on-1 Private Chats</p>
                </div>
                <div class="flex items-center gap-2">
                    <!-- Tab Switcher -->
                    <div class="inline-flex rounded p-1 bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <button type="button" @onclick="() => activeBreakdownTab = BreakdownTab.GroupChat"
                                class="px-3 py-1.5 rounded text-xs font-semibold transition cursor-pointer @(activeBreakdownTab == BreakdownTab.GroupChat ? "bg-[#0A1B2E] text-white dark:bg-[#112A46] dark:text-[#E1E8F0] dark:border dark:border-[rgba(196,210,225,0.20)] shadow-xs" : "text-[#475569] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC]")">
                            Chat Groups (@groups.Count)
                        </button>
                        <button type="button" @onclick="() => activeBreakdownTab = BreakdownTab.PrivateChat"
                                class="px-3 py-1.5 rounded text-xs font-semibold transition cursor-pointer @(activeBreakdownTab == BreakdownTab.PrivateChat ? "bg-white dark:bg-[#111622] text-purple-600 dark:text-purple-300 shadow-xs" : "text-[#475569] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC]")">
                            Private Chats (@privateChats.Count)
                        </button>
                    </div>

                    @if (selectedChatGroupId.HasValue && selectedChatGroupId.Value > 0)
                    {
                        <button type="button" @onclick="ClearGroupFilter" class="px-2.5 py-1.5 bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 rounded text-xs font-semibold hover:bg-amber-500/20 transition cursor-pointer flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                            <span>Clear Filter</span>
                        </button>
                    }
                </div>
            </div>

            @if (activeBreakdownTab == BreakdownTab.GroupChat)
            {
                <!-- Group Chat Table -->
                @if (groups.Count == 0)
                {
                    <div class="py-8 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg">
                        <p class="text-xs font-medium text-[#64748B] dark:text-[#94A3B8]">No completed group financial data for the selected period.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                            <thead>
                                <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono">
                                    <th class="py-3 px-4">Chat Group</th>
                                    <th class="py-3 px-4 text-right">Gross Revenue (LD)</th>
                                    <th class="py-3 px-4 text-right">Commission (LD)</th>
                                    <th class="py-3 px-4 text-right">Creator Net (LD)</th>
                                    <th class="py-3 px-4 text-center">Paid Joins</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                                @foreach (var g in groups)
                                {
                                    bool isSelected = selectedChatGroupId == g.ChatGroupId;
                                    <tr @onclick="() => SelectGroupFilter(g.ChatGroupId)"
                                        class="cursor-pointer transition-colors duration-150 @(isSelected ? "bg-[#0A1B2E]/5 dark:bg-[#112A46] border-l-2 border-l-[#0A1B2E] dark:border-l-[#E1E8F0] font-medium" : "hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60")">
                                        <td class="py-3 px-4 font-semibold text-[#0F172A] dark:text-[#E1E2EC]">
                                             @g.ChatGroupName
                                            @if (isSelected)
                                            {
                                                <span class="ml-2 text-[10px] bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] px-2 py-0.5 rounded-full uppercase tracking-wider font-mono font-bold">Filtered</span>
                                            }
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">
                                            @g.GrossRevenueLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                            @g.PlatformCommissionLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-emerald-600 dark:text-[#34D399]">
                                            @g.CreatorNetEarningsLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-center font-mono text-[#64748B] dark:text-[#94A3B8]">
                                            @g.CompletedTransactionCount
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <!-- Private Chat Table -->
                @if (privateChats.Count == 0)
                {
                    <div class="py-8 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg">
                        <p class="text-xs font-medium text-[#64748B] dark:text-[#94A3B8]">No private chat revenue data for the selected period.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                            <thead>
                                <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono">
                                    <th class="py-3 px-4">Creator</th>
                                    <th class="py-3 px-4 text-right">Gross Revenue (LD)</th>
                                    <th class="py-3 px-4 text-right">Commission (LD)</th>
                                    <th class="py-3 px-4 text-right">Creator Net (LD)</th>
                                    <th class="py-3 px-4 text-center">Unlocked Chats</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                                @foreach (var p in privateChats)
                                {
                                    <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                        <td class="py-3 px-4 font-semibold text-[#0F172A] dark:text-[#E1E2EC] flex items-center gap-2">
                                            <span class="w-6 h-6 rounded-full bg-purple-500/10 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300 border border-purple-500/20 text-[11px] flex items-center justify-center font-bold">
                                                @(string.IsNullOrEmpty(p.CreatorName) ? "C" : p.CreatorName[0].ToString().ToUpper())
                                            </span>
                                            <span>@p.CreatorName</span>
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">
                                            @p.GrossRevenueLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-purple-600 dark:text-purple-400">
                                            @p.PlatformCommissionLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-right font-mono font-bold text-emerald-600 dark:text-[#34D399]">
                                            @p.CreatorNetEarningsLinkDrops.ToString("N0") LD
                                        </td>
                                        <td class="py-3 px-4 text-center font-mono text-[#64748B] dark:text-[#94A3B8]">
                                            @p.CompletedTransactionCount
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        <!-- TRANSACTIONS LIST & FILTERS -->
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-5 shadow-xs space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-4">
                <div>
                    <h2 class="text-base font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Financial Transactions History</h2>
                    <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Audit log of Group Joins, Private Chats, and Creator Cash-Outs</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Transaction Type Dropdown -->
                    <select @bind="selectedTransactionType" @bind:after="ApplyTransactionFilters"
                            class="bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-xs text-[#0F172A] dark:text-[#E1E2EC] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors">
                        <option value="">All Transaction Types</option>
                        <option value="CHAT_GROUP_JOIN">Group Join (CHAT_GROUP_JOIN)</option>
                        <option value="PRIVATE_CHAT_UNLOCK">Private Chat (PRIVATE_CHAT_UNLOCK)</option>
                        <option value="CREATOR_PAYOUT">Creator Payout (CREATOR_PAYOUT)</option>
                    </select>

                    <!-- Status Dropdown -->
                    <select @bind="selectedStatus" @bind:after="ApplyTransactionFilters"
                            class="bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-xs text-[#0F172A] dark:text-[#E1E2EC] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors">
                        <option value="">All Statuses</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="PENDING">Pending</option>
                        <option value="REJECTED">Rejected</option>
                    </select>

                    <!-- Page Size Dropdown -->
                    <select @onchange="OnPageSizeChanged" value="@pageSize"
                            class="bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-xs text-[#0F172A] dark:text-[#E1E2EC] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors">
                        <option value="10">10 rows</option>
                        <option value="25">25 rows</option>
                        <option value="50">50 rows</option>
                        <option value="100">100 rows</option>
                    </select>

                    <button type="button" @onclick="ClearTransactionFilters" class="px-3 py-1.5 bg-white dark:bg-[#191B23] hover:bg-slate-100 dark:hover:bg-[#1D263B] text-[#475569] dark:text-[#94A3B8] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded text-xs font-medium transition cursor-pointer">
                        Clear Filters
                    </button>
                </div>
            </div>

            @if (selectedChatGroupId.HasValue && selectedChatGroupId.Value > 0)
            {
                <div class="bg-[#0A1B2E]/5 dark:bg-[#112A46] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] rounded-lg px-4 py-2.5 text-xs text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-between">
                    <span>Active Group Filter: <strong>Group #@selectedChatGroupId.Value</strong></span>
                    <button type="button" @onclick="ClearGroupFilter" class="font-bold hover:underline text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-1">
                        <span>Clear Group Filter</span>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                </div>
            }

            @if (transactions.Count == 0)
            {
                <div class="py-12 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg space-y-2">
                    <p class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]">No financial transactions found for the selected filters.</p>
                    <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">Try clearing transaction filters or adjusting the date range.</p>
                </div>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="hidden md:block overflow-x-auto rounded border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                    <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                        <thead>
                            <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono">
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4">Type</th>
                                <th class="py-3 px-4">User / Creator</th>
                                <th class="py-3 px-4">Chat Group</th>
                                <th class="py-3 px-4 text-right">Gross (LD)</th>
                                <th class="py-3 px-4 text-right">Commission (LD)</th>
                                <th class="py-3 px-4 text-right">Net (LD)</th>
                                <th class="py-3 px-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                            @foreach (var tx in transactions)
                            {
                                <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                    <td class="py-3 px-4 font-mono text-xs text-[#64748B] dark:text-[#94A3B8]">
                                        @tx.Date.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                     <td class="py-3 px-4">
                                        @if (tx.TransactionType == "CHAT_GROUP_JOIN")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)]">
                                                Group Join
                                            </span>
                                        }
                                        else if (tx.TransactionType == "PRIVATE_CHAT_UNLOCK")
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">
                                                Private Chat
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-[#34D399] border border-emerald-500/20">
                                                Creator Payout
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 font-semibold text-[#0F172A] dark:text-[#E1E2EC]">
                                        @tx.CreatorOrUserName
                                    </td>
                                    <td class="py-3 px-4 text-xs text-[#64748B] dark:text-[#94A3B8]">
                                        @(string.IsNullOrWhiteSpace(tx.ChatGroupName) ? "-" : tx.ChatGroupName)
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">
                                        @tx.GrossAmountLinkDrops.ToString("N0") LD
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                        @tx.CommissionAmountLinkDrops.ToString("N0") LD
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-emerald-600 dark:text-[#34D399]">
                                        @tx.NetAmountLinkDrops.ToString("N0") LD
                                    </td>
                                    <td class="py-3 px-4 text-center">
                                        @if (tx.Status == "COMPLETED" || tx.Status == "APPROVED")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-[#34D399] border border-emerald-500/20">
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                                                <span>Completed</span>
                                            </span>
                                        }
                                        else if (tx.Status == "PENDING")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
                                                <svg class="w-3 h-3 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                                <span>Pending</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/10 text-rose-700 dark:text-[#FFB4AB] border border-rose-500/20">
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                                <span>@tx.Status</span>
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Stacked Cards View (No Horizontal Scroll/Overflow) -->
                <div class="block md:hidden space-y-3">
                    @foreach (var tx in transactions)
                    {
                        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-4 space-y-2 shadow-xs">
                            <div class="flex items-center justify-between text-xs border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-2">
                                <span class="font-mono text-[#64748B] dark:text-[#94A3B8]">@tx.Date.ToString("MMM dd, yyyy HH:mm")</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold @(tx.Status == "COMPLETED" || tx.Status == "APPROVED" ? "bg-emerald-500/10 text-emerald-700 dark:text-[#34D399] border border-emerald-500/20" : tx.Status == "PENDING" ? "bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20" : "bg-rose-500/10 text-rose-700 dark:text-[#FFB4AB] border border-rose-500/20")">
                                    @tx.Status
                                </span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-[#0F172A] dark:text-[#E1E2EC]">@tx.CreatorOrUserName</span>
                                @if (tx.TransactionType == "CHAT_GROUP_JOIN")
                                {
                                    <span class="text-[11px] px-2 py-0.5 rounded font-semibold bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)]">
                                        Group Join
                                    </span>
                                }
                                else if (tx.TransactionType == "PRIVATE_CHAT_UNLOCK")
                                {
                                    <span class="text-[11px] px-2 py-0.5 rounded font-semibold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20">
                                        Private Chat
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[11px] px-2 py-0.5 rounded font-semibold bg-emerald-500/10 text-emerald-700 dark:text-[#34D399] border border-emerald-500/20">
                                        Creator Payout
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tx.ChatGroupName))
                            {
                                <div class="text-xs text-[#64748B] dark:text-[#94A3B8]"><span class="font-semibold text-[#0F172A] dark:text-[#E1E2EC]">Group:</span> @tx.ChatGroupName</div>
                            }
                            <div class="bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded p-2.5 space-y-1 text-xs">
                                <div class="flex justify-between">
                                    <span class="text-[#64748B] dark:text-[#94A3B8]">Gross:</span>
                                    <span class="font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">@tx.GrossAmountLinkDrops.ToString("N0") LD</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-[#64748B] dark:text-[#94A3B8]">Commission:</span>
                                    <span class="font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@tx.CommissionAmountLinkDrops.ToString("N0") LD</span>
                                </div>
                                <div class="flex justify-between border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pt-1 mt-1">
                                    <span class="text-[#0F172A] dark:text-[#E1E2EC] font-semibold">Net:</span>
                                    <span class="font-mono font-bold text-emerald-600 dark:text-[#34D399]">@tx.NetAmountLinkDrops.ToString("N0") LD</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Modern Pagination Bar (SystemUI_UX.md compliant) -->
                <div class="px-5 py-3 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs bg-[#F8FAFC] dark:bg-[#191B23] rounded-b-lg">
                    <!-- Item Range Stats -->
                    <div class="text-[#64748B] dark:text-[#94A3B8] font-mono text-[11px]">
                        @if (totalCount > 0)
                        {
                            var startItem = (currentPage - 1) * pageSize + 1;
                            var endItem = Math.Min(currentPage * pageSize, totalCount);
                            <span>Showing <strong class="text-[#0F172A] dark:text-[#E1E2EC]">@startItem</strong> to <strong class="text-[#0F172A] dark:text-[#E1E2EC]">@endItem</strong> of <strong class="text-[#0F172A] dark:text-[#E1E2EC]">@totalCount</strong> records</span>
                        }
                        else
                        {
                            <span>No transaction records available</span>
                        }
                    </div>

                    <!-- Pagination Navigation Controls -->
                    <div class="flex items-center gap-1.5 font-mono text-xs">
                        <button type="button" @onclick="GoToFirstPage" disabled="@(currentPage <= 1 || isLoading)" title="First Page"
                                class="px-2.5 py-1 rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#64748B] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] hover:bg-slate-50 dark:hover:bg-[#1D263B] disabled:opacity-40 transition cursor-pointer">
                            &laquo; First
                        </button>
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1 || isLoading)" title="Previous Page"
                                class="px-2.5 py-1 rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#64748B] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] hover:bg-slate-50 dark:hover:bg-[#1D263B] disabled:opacity-40 transition cursor-pointer">
                            &larr; Prev
                        </button>
                        
                        <span class="px-3 py-1 rounded bg-[#F1F5F9] dark:bg-[#191B23] text-[#0F172A] dark:text-[#E1E2EC] font-bold">
                            Page @currentPage of @(totalPages == 0 ? 1 : totalPages)
                        </span>

                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages || totalPages == 0 || isLoading)" title="Next Page"
                                class="px-2.5 py-1 rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#64748B] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] hover:bg-slate-50 dark:hover:bg-[#1D263B] disabled:opacity-40 transition cursor-pointer">
                            Next &rarr;
                        </button>
                        <button type="button" @onclick="GoToLastPage" disabled="@(currentPage >= totalPages || totalPages == 0 || isLoading)" title="Last Page"
                                class="px-2.5 py-1 rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#111622] text-[#64748B] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] hover:bg-slate-50 dark:hover:bg-[#1D263B] disabled:opacity-40 transition cursor-pointer">
                            Last &raquo;
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isForbidden = false;
    private bool isExporting = false;
    private string? errorMessage;

    private DateTime? fromDateInput;
    private DateTime? toDateInput;

    private string selectedTransactionType = "";
    private string selectedStatus = "";
    private int? selectedChatGroupId;

    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages = 0;

    private enum BreakdownTab { GroupChat, PrivateChat }
    private BreakdownTab activeBreakdownTab = BreakdownTab.GroupChat;

    private AdminFinanceSummaryModel? summary;
    private List<AdminFinanceGroupBreakdownModel> groups = new();
    private List<AdminFinancePrivateChatBreakdownModel> privateChats = new();
    private List<AdminFinanceTransactionModel> transactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        isLoading = true;
        isForbidden = false;
        errorMessage = null;

        try
        {
            var summaryRes = await FinanceApi.GetSummaryAsync(fromDateInput, toDateInput);
            if (!summaryRes.IsSuccess)
            {
                if (summaryRes.Status == ResultStatus.Forbidden)
                {
                    isForbidden = true;
                    isLoading = false;
                    return;
                }
                errorMessage = summaryRes.Message ?? "Failed to load finance summary.";
            }
            else
            {
                summary = summaryRes.Data;
            }

            var groupsRes = await FinanceApi.GetGroupsAsync(fromDateInput, toDateInput);
            if (groupsRes.IsSuccess && groupsRes.Data != null)
            {
                groups = groupsRes.Data.ToList();
            }

            var privateChatsRes = await FinanceApi.GetPrivateChatsAsync(fromDateInput, toDateInput);
            if (privateChatsRes.IsSuccess && privateChatsRes.Data != null)
            {
                privateChats = privateChatsRes.Data.ToList();
            }

            await LoadTransactionsOnly();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private async Task LoadTransactionsOnly()
    {
        try
        {
            var txRes = await FinanceApi.GetTransactionsAsync(
                fromDateInput,
                toDateInput,
                selectedTransactionType,
                selectedStatus,
                selectedChatGroupId,
                currentPage,
                pageSize
            );

            if (txRes.IsSuccess && txRes.Data != null)
            {
                transactions = txRes.Data.Items.ToList();
                currentPage = txRes.Data.Page;
                pageSize = txRes.Data.PageSize;
                totalCount = txRes.Data.TotalCount;
                totalPages = txRes.Data.TotalPages;
            }
            else if (txRes.Status == ResultStatus.Forbidden)
            {
                isForbidden = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ApplyDateFilter()
    {
        currentPage = 1;
        await LoadAllData();
    }

    private async Task ResetDateFilter()
    {
        currentPage = 1;
        fromDateInput = null;
        toDateInput = null;
        await LoadAllData();
    }

    private async Task SelectGroupFilter(int groupId)
    {
        currentPage = 1;
        if (selectedChatGroupId == groupId)
        {
            selectedChatGroupId = null;
        }
        else
        {
            selectedChatGroupId = groupId;
        }
        await LoadTransactionsOnly();
    }

    private async Task ClearGroupFilter()
    {
        currentPage = 1;
        selectedChatGroupId = null;
        await LoadTransactionsOnly();
    }

    private async Task ApplyTransactionFilters()
    {
        currentPage = 1;
        await LoadTransactionsOnly();
    }

    private async Task ClearTransactionFilters()
    {
        currentPage = 1;
        selectedTransactionType = "";
        selectedStatus = "";
        selectedChatGroupId = null;
        await LoadTransactionsOnly();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            currentPage = 1;
            await LoadTransactionsOnly();
        }
    }

    private async Task GoToFirstPage()
    {
        if (currentPage > 1)
        {
            currentPage = 1;
            await LoadTransactionsOnly();
        }
    }

    private async Task GoToLastPage()
    {
        if (currentPage < totalPages)
        {
            currentPage = totalPages;
            await LoadTransactionsOnly();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadTransactionsOnly();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadTransactionsOnly();
        }
    }

    private async Task ExportCsv()
    {
        isExporting = true;
        try
        {
            var res = await FinanceApi.GetExportCsvBytesAsync(
                fromDateInput,
                toDateInput,
                selectedTransactionType,
                selectedStatus,
                selectedChatGroupId
            );

            if (!res.IsSuccess)
            {
                if (res.Status == ResultStatus.Forbidden)
                {
                    isForbidden = true;
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to export CSV report.");
                }
                isExporting = false;
                return;
            }

            if (res.Data == null || res.Data.Length == 0)
            {
                Toast.Warning("No transaction data available for export.");
                isExporting = false;
                return;
            }

            var fileName = $"communitylink-finance-report-{DateTime.UtcNow:yyyy-MM-dd}.csv";
            var base64 = Convert.ToBase64String(res.Data);
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = '{fileName}'; a.click();");
            Toast.Success("Finance report exported successfully.");
        }
        catch (Exception)
        {
            Toast.Error("Failed to export finance report.");
        }
        finally
        {
            isExporting = false;
        }
    }
}
