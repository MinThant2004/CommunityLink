@page "/admin/finance"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Finance
@using CommunityLink.Shared.Security
@inject AdminFinanceApiService FinanceApi
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Platform Finance &amp; Revenue — Admin Control Panel</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">💰 Platform Finance &amp; Revenue</h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">Platform-wide financial revenue, commission aggregation, and payout summary.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" @onclick="ExportCsv" disabled="@isExporting"
                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 transition flex items-center gap-2 disabled:opacity-50">
                @if (isExporting)
                {
                    <span class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white border-t-transparent"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <span>📥</span>
                    <span>Export CSV</span>
                }
            </button>
            <button type="button" @onclick="LoadAllData" class="px-4 py-2 bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#557392] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition flex items-center gap-2">
                <span>🔄</span> Refresh Data
            </button>
        </div>
    </div>

    <!-- DATE FILTER BAR -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Financial Date Filter</h2>
            @if (fromDateInput.HasValue || toDateInput.HasValue)
            {
                <span class="text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-md px-2.5 py-0.5">
                    Active Period Filter
                </span>
            }
            else
            {
                <span class="text-xs font-medium text-slate-500">Showing All-Time Overall Totals</span>
            }
        </div>

        <div class="flex flex-col sm:flex-row items-end gap-4">
            <div class="w-full sm:w-auto flex-1">
                <label class="block text-xs font-semibold text-slate-600 mb-1">From Date</label>
                <input type="date" @bind="fromDateInput"
                       class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:bg-white focus:border-indigo-600 focus:outline-none" />
            </div>

            <div class="w-full sm:w-auto flex-1">
                <label class="block text-xs font-semibold text-slate-600 mb-1">To Date</label>
                <input type="date" @bind="toDateInput"
                       class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:bg-white focus:border-indigo-600 focus:outline-none" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="button" @onclick="ApplyDateFilter" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 transition">
                    Apply Filter
                </button>
                <button type="button" @onclick="ResetDateFilter" class="px-3.5 py-2 bg-slate-100 text-slate-700 border border-slate-300 rounded-lg text-xs font-semibold hover:bg-slate-200 transition">
                    Reset
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-200 border-t-indigo-600 mb-4"></div>
            <p class="text-sm font-medium text-slate-600">Loading financial summary data...</p>
        </div>
    }
    else if (isForbidden)
    {
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-8 text-rose-800 shadow-sm text-center space-y-3">
            <div class="text-3xl font-bold">🚫</div>
            <h3 class="text-lg font-bold text-rose-900">Access Denied</h3>
            <p class="text-sm text-rose-700 max-w-md mx-auto">Administrator privileges are required to access platform financial metrics.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-6 text-rose-800 shadow-sm flex items-start gap-4">
            <div class="flex-1">
                <h3 class="font-bold text-rose-900">Error Loading Financial Data</h3>
                <p class="text-sm text-rose-700 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadAllData" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition">
                    Retry
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- SUMMARY CARDS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Gross Revenue -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Gross Revenue</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center text-sm font-bold">💰</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @(summary?.GrossChatGroupRevenueLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500">Link Drops</span>
                </div>
                <div class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-md px-2 py-0.5 inline-block">
                    ≈ @(((summary?.GrossChatGroupRevenueLinkDrops ?? 0) * 100m).ToString("N0")) MMK
                </div>
            </div>

            <!-- Platform Commission -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Platform Commission</span>
                    <span class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 flex items-center justify-center text-sm font-bold">🏛️</span>
                </div>
                <div class="text-2xl font-extrabold text-indigo-900">
                    @(summary?.PlatformCommissionLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Net platform revenue</p>
            </div>

            <!-- Creator Net Earnings -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Creator Net Earnings</span>
                    <span class="w-8 h-8 rounded-lg bg-blue-50 border border-blue-200 text-blue-700 flex items-center justify-center text-sm font-bold">👤</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @(summary?.CreatorNetEarningsLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Earned by creators</p>
            </div>

            <!-- Completed Creator Payouts -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Completed Payouts</span>
                    <span class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-200 text-teal-700 flex items-center justify-center text-sm font-bold">✅</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @(summary?.CompletedCreatorPayoutsLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Cashed out by creators</p>
            </div>

            <!-- Pending Creator Payouts -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Pending Payouts</span>
                    <span class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center text-sm font-bold">⏳</span>
                </div>
                <div class="text-2xl font-extrabold text-amber-900">
                    @(summary?.PendingCreatorPayoutsLinkDrops ?? 0) <span class="text-xs font-normal text-slate-500">Link Drops</span>
                </div>
                <p class="text-xs text-slate-500">Awaiting admin review</p>
            </div>

            <!-- Completed Revenue Tx Count -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Revenue Tx Count</span>
                    <span class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-300 text-slate-700 flex items-center justify-center text-sm font-bold">📊</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @(summary?.GrossTransactionCount ?? 0)
                </div>
                <p class="text-xs text-slate-500">Paid group joins</p>
            </div>

            <!-- Completed Payout Count -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Completed Payout Count</span>
                    <span class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-300 text-slate-700 flex items-center justify-center text-sm font-bold">💸</span>
                </div>
                <div class="text-2xl font-extrabold text-slate-900">
                    @(summary?.CompletedPayoutCount ?? 0)
                </div>
                <p class="text-xs text-slate-500">Processed cash-outs</p>
            </div>

            <!-- Pending Payout Count -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-2">
                <div class="flex items-center justify-between text-slate-500">
                    <span class="text-xs font-bold uppercase tracking-wider">Pending Payout Count</span>
                    <span class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-300 text-slate-700 flex items-center justify-center text-sm font-bold">📝</span>
                </div>
                <div class="text-2xl font-extrabold text-amber-800">
                    @(summary?.PendingPayoutCount ?? 0)
                </div>
                <p class="text-xs text-slate-500">Pending reviews</p>
            </div>
        </div>

        <!-- GROUP FINANCE BREAKDOWN TABLE -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900">Chat Group Finance Breakdown</h2>
                    <p class="text-xs text-slate-500">Group revenue metrics (click a row to filter transaction history table below)</p>
                </div>
                @if (selectedChatGroupId.HasValue && selectedChatGroupId.Value > 0)
                {
                    <button type="button" @onclick="ClearGroupFilter" class="px-3 py-1 bg-amber-50 text-amber-800 border border-amber-200 rounded-lg text-xs font-semibold hover:bg-amber-100 transition">
                        ✕ Clear Selected Group Filter
                    </button>
                }
            </div>

            @if (groups.Count == 0)
            {
                <div class="py-8 text-center bg-slate-50 border border-slate-200 rounded-xl">
                    <p class="text-xs font-semibold text-slate-600">No completed group financial data for the selected period.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500 tracking-wider">
                                <th class="py-3 px-4">Chat Group</th>
                                <th class="py-3 px-4 text-right">Gross Revenue (LD)</th>
                                <th class="py-3 px-4 text-right">Commission (LD)</th>
                                <th class="py-3 px-4 text-right">Creator Net (LD)</th>
                                <th class="py-3 px-4 text-center">Transactions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var g in groups)
                            {
                                bool isSelected = selectedChatGroupId == g.ChatGroupId;
                                <tr @onclick="() => SelectGroupFilter(g.ChatGroupId)"
                                    class="cursor-pointer transition @(isSelected ? "bg-indigo-50/90 font-medium border-l-4 border-l-indigo-600" : "hover:bg-slate-50")">
                                    <td class="py-3.5 px-4 font-semibold text-slate-900">
                                        @g.ChatGroupName
                                        @if (isSelected)
                                        {
                                            <span class="ml-2 text-[10px] bg-indigo-600 text-white px-2 py-0.5 rounded-full uppercase tracking-wider font-bold">Filtered</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-extrabold text-slate-900">
                                        @g.GrossRevenueLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-indigo-700">
                                        @g.PlatformCommissionLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-slate-800">
                                        @g.CreatorNetEarningsLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-center font-semibold text-slate-700">
                                        @g.CompletedTransactionCount
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TRANSACTIONS LIST & FILTERS -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900">Financial Transactions History</h2>
                    <p class="text-xs text-slate-500">Platform financial events and payout requests</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Transaction Type Dropdown -->
                    <select @bind="selectedTransactionType" @bind:after="ApplyTransactionFilters"
                            class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-xs text-slate-800 focus:bg-white focus:border-indigo-600 focus:outline-none">
                        <option value="">All Transaction Types</option>
                        <option value="CHAT_GROUP_JOIN">Group Join Revenue</option>
                        <option value="CREATOR_PAYOUT">Creator Payout Cash-out</option>
                    </select>

                    <!-- Status Dropdown -->
                    <select @bind="selectedStatus" @bind:after="ApplyTransactionFilters"
                            class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-xs text-slate-800 focus:bg-white focus:border-indigo-600 focus:outline-none">
                        <option value="">All Statuses</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="PENDING">Pending</option>
                        <option value="REJECTED">Rejected</option>
                    </select>

                    <button type="button" @onclick="ClearTransactionFilters" class="px-3 py-1.5 bg-slate-100 text-slate-700 border border-slate-300 rounded-lg text-xs font-semibold hover:bg-slate-200 transition">
                        Clear Filters
                    </button>
                </div>
            </div>

            @if (selectedChatGroupId.HasValue && selectedChatGroupId.Value > 0)
            {
                <div class="bg-indigo-50 border border-indigo-200 rounded-lg px-4 py-2.5 text-xs text-indigo-900 flex items-center justify-between">
                    <span>Active Group Filter: <strong>Group #@selectedChatGroupId.Value</strong></span>
                    <button type="button" @onclick="ClearGroupFilter" class="font-bold hover:underline text-indigo-700">
                        Clear Group Filter ✕
                    </button>
                </div>
            }

            @if (transactions.Count == 0)
            {
                <div class="py-12 text-center bg-slate-50 border border-slate-200 rounded-xl space-y-2">
                    <p class="text-sm font-bold text-slate-700">No financial transactions found for the selected filters.</p>
                    <p class="text-xs text-slate-500">Try clearing transaction filters or adjusting the date range.</p>
                </div>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500 tracking-wider">
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4">Type</th>
                                <th class="py-3 px-4">User / Creator</th>
                                <th class="py-3 px-4">Chat Group</th>
                                <th class="py-3 px-4 text-right">Gross (LD)</th>
                                <th class="py-3 px-4 text-right">Commission (LD)</th>
                                <th class="py-3 px-4 text-right">Net (LD)</th>
                                <th class="py-3 px-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var tx in transactions)
                            {
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="py-3.5 px-4 font-mono text-xs text-slate-600">
                                        @tx.Date.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4">
                                        @if (tx.TransactionType == "CHAT_GROUP_JOIN")
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800">
                                                Group Join
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded text-xs font-semibold bg-indigo-50 border border-indigo-200 text-indigo-800">
                                                Creator Payout
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 font-semibold text-slate-900">
                                        @tx.CreatorOrUserName
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-slate-600">
                                        @(string.IsNullOrWhiteSpace(tx.ChatGroupName) ? "-" : tx.ChatGroupName)
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-extrabold text-slate-900">
                                        @tx.GrossAmountLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-indigo-700">
                                        @tx.CommissionAmountLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-slate-800">
                                        @tx.NetAmountLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (tx.Status == "COMPLETED" || tx.Status == "APPROVED")
                                        {
                                            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800">
                                                Completed
                                            </span>
                                        }
                                        else if (tx.Status == "PENDING")
                                        {
                                            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-800">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-rose-50 border border-rose-200 text-rose-800">
                                                @tx.Status
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Stacked Cards View (No Horizontal Scroll/Overflow) -->
                <div class="block md:hidden space-y-3">
                    @foreach (var tx in transactions)
                    {
                        <div class="bg-white border border-slate-200 rounded-xl p-4 space-y-2 shadow-sm">
                            <div class="flex items-center justify-between text-xs border-b border-slate-100 pb-2">
                                <span class="font-mono text-slate-500">@tx.Date.ToString("MMM dd, yyyy HH:mm")</span>
                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold @(tx.Status == "COMPLETED" || tx.Status == "APPROVED" ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : tx.Status == "PENDING" ? "bg-amber-50 text-amber-800 border border-amber-200" : "bg-rose-50 text-rose-800 border border-rose-200")">
                                    @tx.Status
                                </span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-800">@tx.CreatorOrUserName</span>
                                <span class="text-xs px-2 py-0.5 rounded font-semibold bg-slate-100 border border-slate-200 text-slate-700">
                                    @tx.TransactionType
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tx.ChatGroupName))
                            {
                                <div class="text-xs text-slate-600"><span class="font-semibold text-slate-700">Group:</span> @tx.ChatGroupName</div>
                            }
                            <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5 space-y-1 text-xs">
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Gross:</span>
                                    <span class="font-extrabold text-slate-900">@tx.GrossAmountLinkDrops LD</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-500">Commission:</span>
                                    <span class="font-bold text-indigo-700">@tx.CommissionAmountLinkDrops LD</span>
                                </div>
                                <div class="flex justify-between border-t border-slate-200 pt-1 mt-1">
                                    <span class="text-slate-700 font-bold">Net:</span>
                                    <span class="font-extrabold text-slate-900">@tx.NetAmountLinkDrops LD</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Controls (Compact for Mobile) -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-100">
                    <div class="text-xs text-slate-500 font-medium">
                        @if (totalCount > 0)
                        {
                            var start = (currentPage - 1) * pageSize + 1;
                            var end = Math.Min(currentPage * pageSize, totalCount);
                            <span>Showing @start–@end of @totalCount</span>
                        }
                        else
                        {
                            <span>Showing 0 of 0</span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1 || isLoading)"
                                class="px-3 py-1.5 bg-slate-100 border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-200 transition disabled:opacity-40 disabled:cursor-not-allowed">
                            Previous
                        </button>
                        <span class="text-xs font-semibold text-slate-700 px-2">
                            Page @currentPage of @(totalPages == 0 ? 1 : totalPages)
                        </span>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages || totalPages == 0 || isLoading)"
                                class="px-3 py-1.5 bg-slate-100 border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-200 transition disabled:opacity-40 disabled:cursor-not-allowed">
                            Next
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isForbidden = false;
    private bool isExporting = false;
    private string? errorMessage;

    private DateTime? fromDateInput;
    private DateTime? toDateInput;

    private string selectedTransactionType = "";
    private string selectedStatus = "";
    private int? selectedChatGroupId;

    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages = 0;

    private AdminFinanceSummaryModel? summary;
    private List<AdminFinanceGroupBreakdownModel> groups = new();
    private List<AdminFinanceTransactionModel> transactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        isLoading = true;
        isForbidden = false;
        errorMessage = null;

        try
        {
            var summaryRes = await FinanceApi.GetSummaryAsync(fromDateInput, toDateInput);
            if (!summaryRes.IsSuccess)
            {
                if (summaryRes.Status == ResultStatus.Forbidden)
                {
                    isForbidden = true;
                    isLoading = false;
                    return;
                }
                errorMessage = summaryRes.Message ?? "Failed to load finance summary.";
            }
            else
            {
                summary = summaryRes.Data;
            }

            var groupsRes = await FinanceApi.GetGroupsAsync(fromDateInput, toDateInput);
            if (groupsRes.IsSuccess && groupsRes.Data != null)
            {
                groups = groupsRes.Data.ToList();
            }

            await LoadTransactionsOnly();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private async Task LoadTransactionsOnly()
    {
        try
        {
            var txRes = await FinanceApi.GetTransactionsAsync(
                fromDateInput,
                toDateInput,
                selectedTransactionType,
                selectedStatus,
                selectedChatGroupId,
                currentPage,
                pageSize
            );

            if (txRes.IsSuccess && txRes.Data != null)
            {
                transactions = txRes.Data.Items.ToList();
                currentPage = txRes.Data.Page;
                pageSize = txRes.Data.PageSize;
                totalCount = txRes.Data.TotalCount;
                totalPages = txRes.Data.TotalPages;
            }
            else if (txRes.Status == ResultStatus.Forbidden)
            {
                isForbidden = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ApplyDateFilter()
    {
        currentPage = 1;
        await LoadAllData();
    }

    private async Task ResetDateFilter()
    {
        currentPage = 1;
        fromDateInput = null;
        toDateInput = null;
        await LoadAllData();
    }

    private async Task SelectGroupFilter(int groupId)
    {
        currentPage = 1;
        if (selectedChatGroupId == groupId)
        {
            selectedChatGroupId = null;
        }
        else
        {
            selectedChatGroupId = groupId;
        }
        await LoadTransactionsOnly();
    }

    private async Task ClearGroupFilter()
    {
        currentPage = 1;
        selectedChatGroupId = null;
        await LoadTransactionsOnly();
    }

    private async Task ApplyTransactionFilters()
    {
        currentPage = 1;
        await LoadTransactionsOnly();
    }

    private async Task ClearTransactionFilters()
    {
        currentPage = 1;
        selectedTransactionType = "";
        selectedStatus = "";
        selectedChatGroupId = null;
        await LoadTransactionsOnly();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadTransactionsOnly();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadTransactionsOnly();
        }
    }

    private async Task ExportCsv()
    {
        isExporting = true;
        try
        {
            var res = await FinanceApi.GetExportCsvBytesAsync(
                fromDateInput,
                toDateInput,
                selectedTransactionType,
                selectedStatus,
                selectedChatGroupId
            );

            if (!res.IsSuccess)
            {
                if (res.Status == ResultStatus.Forbidden)
                {
                    isForbidden = true;
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to export CSV report.");
                }
                isExporting = false;
                return;
            }

            if (res.Data == null || res.Data.Length == 0)
            {
                Toast.Warning("No transaction data available for export.");
                isExporting = false;
                return;
            }

            var fileName = $"communitylink-finance-report-{DateTime.UtcNow:yyyy-MM-dd}.csv";
            var base64 = Convert.ToBase64String(res.Data);
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = '{fileName}'; a.click();");
            Toast.Success("Finance report exported successfully.");
        }
        catch (Exception)
        {
            Toast.Error("Failed to export finance report.");
        }
        finally
        {
            isExporting = false;
        }
    }
}
