@page "/admin/payouts"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Payout
@using CommunityLink.Shared.Security
@inject CreatorPayoutApiService PayoutApi
@inject ToastService Toast
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Admin_Payouts_PageTitle"]</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs transition-all duration-200 hover:shadow-md hover:border-slate-300 dark:hover:border-[rgba(255,255,255,0.16)]">
        <div>
            <h1 class="text-2xl font-bold text-[#0F172A] dark:text-[#E1E8F0] flex items-center gap-2.5" style="font-family:'Plus Jakarta Sans',sans-serif">
                <svg class="w-6 h-6 text-[#0A1B2E] dark:text-[#E1E8F0] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span>@Loc["Admin_Payouts_Heading"]</span>
            </h1>
            <p class="text-sm text-[#475569] dark:text-[#94A3B8] mt-1">@Loc["Admin_Payouts_Subtitle"]</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" @onclick='() => SetStatusFilter("")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 border cursor-pointer @(activeStatus == "" ? "bg-[#0F172A] hover:bg-[#1E293B] text-white dark:bg-[#112A46] dark:hover:bg-[#1B3B5A] dark:text-[#E1E8F0] border-transparent dark:border-[rgba(196,210,225,0.20)] shadow-xs" : "bg-white dark:bg-[#111622] text-[#475569] dark:text-[#C4D2E1] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] hover:bg-[#F8FAFC] dark:hover:bg-[#182030]")">
                @Loc["Admin_Payouts_AllRequests"]
            </button>
            <button type="button" @onclick='() => SetStatusFilter("PENDING")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 border cursor-pointer @(activeStatus == "PENDING" ? "bg-amber-600 text-white border-amber-600 shadow-xs" : "bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-900/50 hover:bg-amber-100 dark:hover:bg-amber-900/40")">
                @Loc["Admin_Payouts_Pending"]
            </button>
            <button type="button" @onclick='() => SetStatusFilter("COMPLETED")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 border cursor-pointer @(activeStatus == "COMPLETED" ? "bg-emerald-600 text-white border-emerald-600 shadow-xs" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/40")">
                @Loc["Admin_Payouts_Completed"]
            </button>
            <button type="button" @onclick='() => SetStatusFilter("REJECTED")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 border cursor-pointer @(activeStatus == "REJECTED" ? "bg-rose-600 text-white border-rose-600 shadow-xs" : "bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-900/50 hover:bg-rose-100 dark:hover:bg-rose-900/40")">
                @Loc["Admin_Payouts_Rejected"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-12 text-center shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent mb-4"></div>
            <p class="text-sm font-medium text-[#475569] dark:text-[#94A3B8]">@Loc["Admin_Payouts_Loading"]</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-xl p-6 text-rose-800 dark:text-rose-200 shadow-xs flex items-start gap-4">
            <div class="flex-1">
                <h3 class="font-bold text-rose-900 dark:text-rose-100">@Loc["Admin_Payouts_ErrorTitle"]</h3>
                <p class="text-sm text-rose-700 dark:text-rose-300 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadPayouts" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition cursor-pointer">
                    @Loc["Common_TryAgain"]
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-4">
                <h2 class="text-base font-bold text-[#0F172A] dark:text-[#E1E8F0]" style="font-family:'Plus Jakarta Sans',sans-serif">@string.Format(Loc["Admin_Payouts_RequestsCount"], payouts.Count)</h2>
                <button type="button" @onclick="LoadPayouts" class="px-3.5 py-1.5 bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] text-[#475569] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#F8FAFC] dark:hover:bg-[#182030] hover:text-[#0F172A] dark:hover:text-white transition cursor-pointer">
                    @Loc["Common_Refresh"]
                </button>
            </div>

            @if (payouts.Count == 0)
            {
                <div class="py-12 px-4 text-center bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl space-y-2">
                    <p class="text-sm font-bold text-[#0F172A] dark:text-[#E1E8F0]">@Loc["Admin_Payouts_NoRequests"]</p>
                    <p class="text-xs text-[#64748B] dark:text-[#94A3B8]">@Loc["Admin_Payouts_NoRequestsDesc"]</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-[#F8FAFC] dark:bg-[#191B23] border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em]">
                                <th class="py-3 px-4">@Loc["Admin_Payouts_ColCreator"]</th>
                                <th class="py-3 px-4 text-right">@Loc["Admin_Payouts_ColAmountLd"]</th>
                                <th class="py-3 px-4 text-right">@Loc["Admin_Payouts_ColEstMmk"]</th>
                                <th class="py-3 px-4">@Loc["Admin_Payouts_ColPaymentMethod"]</th>
                                <th class="py-3 px-4">@Loc["Admin_Payouts_ColAccountDetails"]</th>
                                <th class="py-3 px-4">@Loc["Admin_Payouts_ColDate"]</th>
                                <th class="py-3 px-4 text-center">@Loc["Admin_Payouts_ColStatus"]</th>
                                <th class="py-3 px-4 text-right">@Loc["Admin_Payouts_ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                            @foreach (var p in payouts)
                            {
                                <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                    <td class="py-3.5 px-4">
                                        <div class="font-bold text-[#0F172A] dark:text-[#E1E8F0]">@p.CreatorName</div>
                                        <div class="text-xs text-[#64748B] dark:text-[#94A3B8]">@p.CreatorEmail</div>
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-extrabold text-[#0F172A] dark:text-[#E1E8F0]">
                                        @p.AmountLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">
                                        @p.AmountMMK.ToString("N0") MMK
                                    </td>
                                    <td class="py-3.5 px-4 font-semibold text-[#0F172A] dark:text-[#E1E8F0]">
                                        @p.PaymentMethod
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-[#475569] dark:text-[#C4D2E1]">
                                        <div><span class="font-medium text-[#0F172A] dark:text-[#E1E8F0]">@p.PaymentAccountName</span></div>
                                        <div class="font-mono text-[#64748B]">@p.PaymentAccountNumber</div>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono text-xs text-[#64748B] dark:text-[#94A3B8]">
                                        @p.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (p.Status == "PENDING")
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 text-amber-700 dark:text-amber-300">
                                                @Loc["Admin_Payouts_StatusPendingReview"]
                                            </span>
                                        }
                                        else if (p.Status == "COMPLETED" || p.Status == "APPROVED")
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300">
                                                @Loc["Admin_Payouts_Completed"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
                                                @p.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        @if (p.Status == "PENDING")
                                        {
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" @onclick="() => OpenConfirmation(p, true)"
                                                        class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition-all duration-150 shadow-xs active:scale-[0.98] cursor-pointer">
                                                    @Loc["Admin_Payouts_ApproveBtn"]
                                                </button>
                                                <button type="button" @onclick="() => OpenConfirmation(p, false)"
                                                        class="px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold transition-all duration-150 shadow-xs active:scale-[0.98] cursor-pointer">
                                                    @Loc["Admin_Payouts_RejectBtn"]
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-[#64748B] italic">@Loc["Admin_Payouts_StatusReviewed"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- CONFIRMATION MODAL FOR APPROVAL / REJECTION -->
@if (selectedPayout != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 dark:bg-black/70 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-5 text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-3">
                <h3 class="text-base font-bold text-[#0F172A] dark:text-[#E1E8F0]" style="font-family:'Plus Jakarta Sans',sans-serif">
                    @(isApprovingAction ? Loc["Admin_Payouts_ModalApproveTitle"] : Loc["Admin_Payouts_ModalRejectTitle"])
                </h3>
                <button type="button" @onclick="CloseModal" class="text-[#64748B] hover:text-[#0F172A] dark:hover:white p-1 rounded-lg transition cursor-pointer" aria-label="@Loc["Admin_Payouts_ModalCloseAria"]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="bg-[#F8FAFC] dark:bg-[#191B23] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-xl p-4 space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-[#64748B]">@Loc["Admin_Payouts_ModalCreator"]</span>
                    <span class="font-bold text-[#0F172A] dark:text-[#E1E8F0]">@selectedPayout.CreatorName (@selectedPayout.CreatorEmail)</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#64748B]">@Loc["Admin_Payouts_ModalAmount"]</span>
                    <span class="font-extrabold font-mono text-[#0F172A] dark:text-[#E1E8F0] text-sm">@selectedPayout.AmountLinkDrops LD</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#64748B]">@Loc["Admin_Payouts_ModalMmkValue"]</span>
                    <span class="font-bold font-mono text-emerald-600 dark:text-emerald-400 text-sm">@selectedPayout.AmountMMK.ToString("N0") MMK</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#64748B]">@Loc["Admin_Payouts_ModalPaymentAccount"]</span>
                    <span class="font-semibold text-[#0F172A] dark:text-[#E1E8F0]">@selectedPayout.PaymentMethod - @selectedPayout.PaymentAccountName (<span class="font-mono">@selectedPayout.PaymentAccountNumber</span>)</span>
                </div>
            </div>

            @if (isApprovingAction)
            {
                <p class="text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-lg p-3 text-emerald-800 dark:text-emerald-200 font-medium">
                    @((MarkupString)string.Format(Loc["Admin_Payouts_ModalApproveWarning"], $"<strong class=\"font-mono\">{selectedPayout.AmountLinkDrops} Link Drops</strong>"))
                </p>
            }
            else
            {
                <p class="text-xs bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-lg p-3 text-rose-800 dark:text-rose-200 font-medium">
                    @Loc["Admin_Payouts_ModalRejectWarning"]
                </p>
            }

            <div>
                <label class="block text-xs font-bold font-mono text-[#475569] dark:text-[#94A3B8] uppercase tracking-wider mb-1">@Loc["Admin_Payouts_AdminNoteLabel"]</label>
                <textarea rows="3" placeholder="@Loc["Admin_Payouts_AdminNotePlaceholder"]" @bind="adminNoteInput"
                          class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg p-3 text-xs text-[#0F172A] dark:text-[#E1E8F0] focus:ring-2 focus:ring-[#0A1B2E]/20 focus:border-[#0A1B2E] focus:outline-none"></textarea>
            </div>

            <div class="pt-3 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] flex items-center justify-end gap-3">
                <button type="button" @onclick="CloseModal" class="px-4 py-2 bg-[#F1F5F9] dark:bg-[#191B23] text-[#475569] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded-lg text-xs font-semibold hover:bg-[#E2E8F0] dark:hover:bg-[#1E2638] transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="ProcessAction" disabled="@isProcessing"
                        class="px-5 py-2 text-white rounded-lg text-xs font-bold transition-all duration-150 shadow-xs active:scale-[0.98] disabled:opacity-50 cursor-pointer @(isApprovingAction ? "bg-emerald-600 hover:bg-emerald-700" : "bg-rose-600 hover:bg-rose-700")">
                    @(isProcessing ? Loc["Common_Processing"] : (isApprovingAction ? Loc["Admin_Payouts_ConfirmApproval"] : Loc["Admin_Payouts_ConfirmRejection"]))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private string activeStatus = "";
    private string? errorMessage;

    private List<AdminPayoutModel> payouts = new();
    private AdminPayoutModel? selectedPayout;
    private bool isApprovingAction;
    private string adminNoteInput = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPayouts();
    }

    private async Task SetStatusFilter(string status)
    {
        activeStatus = status;
        await LoadPayouts();
    }

    private async Task LoadPayouts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await PayoutApi.GetAdminPayoutsAsync(activeStatus);
            if (res.IsSuccess && res.Data != null)
            {
                payouts = res.Data.ToList();
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load admin payouts.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private void OpenConfirmation(AdminPayoutModel payout, bool isApprove)
    {
        selectedPayout = payout;
        isApprovingAction = isApprove;
        adminNoteInput = "";
    }

    private void CloseModal()
    {
        selectedPayout = null;
    }

    private async Task ProcessAction()
    {
        if (selectedPayout == null || isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            Result<AdminPayoutModel> res;

            if (isApprovingAction)
            {
                res = await PayoutApi.ApprovePayoutAsync(selectedPayout.CreatorPayoutRequestId, adminNoteInput);
            }
            else
            {
                res = await PayoutApi.RejectPayoutAsync(selectedPayout.CreatorPayoutRequestId, adminNoteInput);
            }

            if (res.IsSuccess)
            {
                Toast.Success(res.Message ?? (isApprovingAction ? Loc["Admin_Payouts_Toast_ApproveSuccess"] : Loc["Admin_Payouts_Toast_RejectSuccess"]));
                selectedPayout = null;
                await LoadPayouts();
            }
            else
            {
                Toast.Error(res.Message ?? Loc["Admin_Payouts_Toast_ActionFailed"]);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["Admin_Payouts_Toast_UnexpectedError"], ex.Message));
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
