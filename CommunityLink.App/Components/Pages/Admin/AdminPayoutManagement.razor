@page "/admin/payouts"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Payout
@using CommunityLink.Shared.Security
@inject CreatorPayoutApiService PayoutApi
@inject ToastService Toast

<PageTitle>Creator Payout Management — Admin Control Panel</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">💸 Creator Payout Management</h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">Review, approve, and process creator cash-out and withdrawal requests.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" @onclick='() => SetStatusFilter("")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition border @(activeStatus == "" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] border-transparent" : "bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] hover:bg-[#F1F5F9] dark:hover:bg-[#182030]")">
                All Requests
            </button>
            <button type="button" @onclick='() => SetStatusFilter("PENDING")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition border @(activeStatus == "PENDING" ? "bg-amber-600 text-white border-amber-600" : "bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-900/50 hover:bg-amber-100")">
                Pending
            </button>
            <button type="button" @onclick='() => SetStatusFilter("COMPLETED")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition border @(activeStatus == "COMPLETED" ? "bg-emerald-600 text-white border-emerald-600" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100")">
                Completed
            </button>
            <button type="button" @onclick='() => SetStatusFilter("REJECTED")'
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition border @(activeStatus == "REJECTED" ? "bg-rose-600 text-white border-rose-600" : "bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-900/50 hover:bg-rose-100")">
                Rejected
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-12 text-center shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent mb-4"></div>
            <p class="text-sm font-medium text-[#557392] dark:text-[#C4D2E1]">Loading payout requests...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-2xl p-6 text-rose-800 dark:text-rose-200 shadow-sm flex items-start gap-4">
            <div class="flex-1">
                <h3 class="font-bold text-rose-900 dark:text-rose-100">Error loading payouts</h3>
                <p class="text-sm text-rose-700 dark:text-rose-300 mt-1">@errorMessage</p>
                <button type="button" @onclick="LoadPayouts" class="mt-3 px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition">
                    Retry
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-4">
                <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Payout Requests (@payouts.Count)</h2>
                <button type="button" @onclick="LoadPayouts" class="px-3.5 py-1.5 bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#557392] dark:text-[#C4D2E1] rounded-lg text-xs font-semibold hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition">
                    Refresh
                </button>
            </div>

            @if (payouts.Count == 0)
            {
                <div class="py-12 px-4 text-center bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-xl space-y-2">
                    <p class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">No payout requests found.</p>
                    <p class="text-xs text-[#7A8CA6] dark:text-[#C4D2E1]">No creator withdrawal requests match the selected status filter.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-[#F1F5F9] dark:bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[10px] uppercase font-bold text-[#7A8CA6] tracking-wider" style="font-family:'JetBrains Mono',monospace">
                                <th class="py-3 px-4">Creator</th>
                                <th class="py-3 px-4 text-right">Amount (LD)</th>
                                <th class="py-3 px-4 text-right">Est. MMK</th>
                                <th class="py-3 px-4">Payment Method</th>
                                <th class="py-3 px-4">Account Details</th>
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4 text-center">Status</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)]">
                            @foreach (var p in payouts)
                            {
                                <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#0A1B2E]/60 transition">
                                    <td class="py-3.5 px-4">
                                        <div class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@p.CreatorName</div>
                                        <div class="text-xs text-[#7A8CA6] dark:text-[#C4D2E1]">@p.CreatorEmail</div>
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-extrabold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                        @p.AmountLinkDrops LD
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-emerald-600 dark:text-emerald-400">
                                        @p.AmountMMK.ToString("N0") MMK
                                    </td>
                                    <td class="py-3.5 px-4 font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                        @p.PaymentMethod
                                    </td>
                                    <td class="py-3.5 px-4 text-xs text-[#557392] dark:text-[#C4D2E1]">
                                        <div><span class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0]">@p.PaymentAccountName</span></div>
                                        <div class="font-mono text-[#7A8CA6]">@p.PaymentAccountNumber</div>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono text-xs text-[#7A8CA6] dark:text-[#C4D2E1]">
                                        @p.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        @if (p.Status == "PENDING")
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 text-amber-700 dark:text-amber-300">
                                                Pending Review
                                            </span>
                                        }
                                        else if (p.Status == "COMPLETED" || p.Status == "APPROVED")
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300">
                                                @p.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        @if (p.Status == "PENDING")
                                        {
                                            <div class="flex items-center justify-end gap-2">
                                                <button type="button" @onclick="() => OpenConfirmation(p, true)"
                                                        class="px-3 py-1 bg-emerald-600 text-white rounded-lg text-xs font-semibold hover:bg-emerald-700 transition">
                                                    Approve
                                                </button>
                                                <button type="button" @onclick="() => OpenConfirmation(p, false)"
                                                        class="px-3 py-1 bg-rose-600 text-white rounded-lg text-xs font-semibold hover:bg-rose-700 transition">
                                                    Reject
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-[#7A8CA6] italic">Reviewed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- CONFIRMATION MODAL FOR APPROVAL / REJECTION -->
@if (selectedPayout != null)
{
    <div class="fixed inset-0 z-50 bg-[#0A1B2E]/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-5 text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-3">
                <h3 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                    @(isApprovingAction ? "Approve Payout Request" : "Reject Payout Request")
                </h3>
                <button type="button" @onclick="CloseModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white font-bold text-lg">
                    &times;
                </button>
            </div>

            <div class="bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-xl p-4 space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-[#7A8CA6]">Creator:</span>
                    <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@selectedPayout.CreatorName (@selectedPayout.CreatorEmail)</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#7A8CA6]">Amount:</span>
                    <span class="font-extrabold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">@selectedPayout.AmountLinkDrops LD</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#7A8CA6]">MMK Value:</span>
                    <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">@selectedPayout.AmountMMK.ToString("N0") MMK</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-[#7A8CA6]">Payment Account:</span>
                    <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@selectedPayout.PaymentMethod - @selectedPayout.PaymentAccountName (@selectedPayout.PaymentAccountNumber)</span>
                </div>
            </div>

            @if (isApprovingAction)
            {
                <p class="text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-lg p-3 text-emerald-800 dark:text-emerald-200 font-medium">
                    Approving this request will immediately deduct <strong>@selectedPayout.AmountLinkDrops Link Drops</strong> from the creator's EarnedBalance and record a CREATOR_PAYOUT audit ledger transaction.
                </p>
            }
            else
            {
                <p class="text-xs bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 rounded-lg p-3 text-rose-800 dark:text-rose-200 font-medium">
                    Rejecting this request will NOT deduct any Link Drops from the creator's wallet.
                </p>
            }

            <div>
                <label class="block text-xs font-bold text-[#7A8CA6] dark:text-[#C4D2E1] uppercase tracking-wider mb-1">Admin Note (Optional)</label>
                <textarea rows="3" placeholder="e.g. Transaction ID / Reference code / Rejection reason" @bind="adminNoteInput"
                          class="w-full bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] rounded-lg p-3 text-xs text-[#0A1B2E] dark:text-[#E1E8F0] focus:ring-2 focus:ring-[#0A1B2E]/20 focus:outline-none"></textarea>
            </div>

            <div class="pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-3">
                <button type="button" @onclick="CloseModal" class="px-4 py-2 bg-white dark:bg-[#0A1B2E] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] rounded-lg text-xs font-semibold hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition">
                    Cancel
                </button>
                <button type="button" @onclick="ProcessAction" disabled="@isProcessing"
                        class="px-5 py-2 text-white rounded-lg text-xs font-semibold transition disabled:opacity-50 @(isApprovingAction ? "bg-emerald-600 hover:bg-emerald-700" : "bg-rose-600 hover:bg-rose-700")">
                    @(isProcessing ? "Processing..." : (isApprovingAction ? "Confirm Approval" : "Confirm Rejection"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private string activeStatus = "";
    private string? errorMessage;

    private List<AdminPayoutModel> payouts = new();
    private AdminPayoutModel? selectedPayout;
    private bool isApprovingAction;
    private string adminNoteInput = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPayouts();
    }

    private async Task SetStatusFilter(string status)
    {
        activeStatus = status;
        await LoadPayouts();
    }

    private async Task LoadPayouts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await PayoutApi.GetAdminPayoutsAsync(activeStatus);
            if (res.IsSuccess && res.Data != null)
            {
                payouts = res.Data.ToList();
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load admin payouts.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;
    }

    private void OpenConfirmation(AdminPayoutModel payout, bool isApprove)
    {
        selectedPayout = payout;
        isApprovingAction = isApprove;
        adminNoteInput = "";
    }

    private void CloseModal()
    {
        selectedPayout = null;
    }

    private async Task ProcessAction()
    {
        if (selectedPayout == null || isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            Result<AdminPayoutModel> res;

            if (isApprovingAction)
            {
                res = await PayoutApi.ApprovePayoutAsync(selectedPayout.CreatorPayoutRequestId, adminNoteInput);
            }
            else
            {
                res = await PayoutApi.RejectPayoutAsync(selectedPayout.CreatorPayoutRequestId, adminNoteInput);
            }

            if (res.IsSuccess)
            {
                Toast.Success(res.Message ?? (isApprovingAction ? "Payout approved successfully!" : "Payout rejected."));
                selectedPayout = null;
                await LoadPayouts();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to process payout action.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Unexpected error processing payout: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
