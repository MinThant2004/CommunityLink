@page "/admin/portal-entry/login"
@rendermode InteractiveServer
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Admin Sign In - CommunityLink</PageTitle>

@if (showForgotPasswordModal)
{
    <ForgotPasswordModal IsAdmin="true" OnClose="CloseForgotPassword" />
}

<AuthSplitScreen IsAdmin="true" LogoText="ADM" Eyebrow="ADMINISTRATOR SECURE GATEWAY" Title="Platform governance & oversight."
                 Subtitle="High-assurance operator terminal for member verification, community moderation, and audit compliance.">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <!-- Security Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#BA1A1A] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    <span>RESTRICTED ACCESS</span>
                </span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] px-2 py-0.5 rounded">CONSOLE LEVEL 03</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Operator Authentication</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">Cryptographically verified operator credentials required.</p>
        </div>

        <form method="post" action="/account/admin/login" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <span class="mt-0.5">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="admin-email" class="@AuthClasses.Label">Admin email</label>
                <input id="admin-email" name="email" type="email" required autofocus autocomplete="email"
                       placeholder="admin@example.com" class="@AuthClasses.InputAdmin" />
            </div>

            <div class="space-y-1.5">
                <label for="admin-password" class="@AuthClasses.Label">Password</label>
                <div class="relative">
                    <input id="admin-password" name="password" type="password" required
                           autocomplete="current-password" placeholder="••••••••" class="@AuthClasses.InputAdmin pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle password visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-between pt-1">
                <label for="admin-remember" class="flex items-center gap-2 text-xs text-[#557392] dark:text-[#C4D2E1] cursor-pointer">
                    <input type="hidden" name="rememberMe" value="false" />
                    <input id="admin-remember" name="rememberMe" type="checkbox" value="true" class="@AuthClasses.CheckboxAdmin" />
                    <span>Maintain operator session</span>
                </label>
                <button type="button" @onclick="OpenForgotPassword" class="font-mono text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">Forgot password?</button>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButtonAdmin mt-2">
                <span>Authenticate Operator</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-xs text-[#557392] dark:text-[#C4D2E1]">
            <span>Need to provision an operator?</span>
            <a href="/admin/portal-entry/register" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline transition">Register with Invite &rarr;</a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private bool showForgotPasswordModal;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
        }
    }

    private void OpenForgotPassword() => showForgotPasswordModal = true;
    private void CloseForgotPassword() => showForgotPasswordModal = false;
}