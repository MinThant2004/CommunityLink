@page "/admin/portal-entry/login"
@page "/admin/login"
@rendermode InteractiveServer
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>Admin Sign In - CommunityLink</PageTitle>

@if (showForgotPasswordModal)
{
    <ForgotPasswordModal IsAdmin="true" OnClose="CloseForgotPassword" />
}

<AuthSplitScreen IsAdmin="true" LogoText="ADM" Eyebrow="Admin Portal" Title="System Administration"
                 Subtitle="Secure portal access for platform administrators and system operators.">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <!-- Brand / Header -->
        <div class="mb-5 pb-5 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#D4AF37] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
                    <span>Admin Portal</span>
                </span>
            </div>
            <h2 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Sign In as Admin</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">Enter your administrative credentials to manage the platform.</p>
        </div>

        <form method="post" action="/account/admin/login" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="admin-email" class="@AuthClasses.Label">@Loc["Auth_AdminEmail"]</label>
                <input id="admin-email" name="email" type="email" required autofocus autocomplete="email"
                       value="@adminEmail" @oninput="(e) => adminEmail = e.Value?.ToString() ?? string.Empty"
                       placeholder="admin@example.com" class="@AuthClasses.InputAdmin" />
            </div>

            <div class="space-y-1.5">
                <label for="admin-password" class="@AuthClasses.Label">@Loc["Auth_Password"]</label>
                <div class="relative">
                    <input id="admin-password" name="password" type="password" required
                           autocomplete="current-password" value="@adminPassword" @oninput="(e) => adminPassword = e.Value?.ToString() ?? string.Empty"
                           placeholder="••••••••" class="@AuthClasses.InputAdmin pr-12" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="@Loc["Auth_TogglePasswordVisibility"]">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-between pt-1">
                <label for="admin-remember" class="flex items-center gap-2 text-xs text-[#557392] dark:text-[#C4D2E1] cursor-pointer">
                    <input id="admin-remember" name="rememberMe" type="checkbox" value="true" class="@AuthClasses.CheckboxAdmin" />
                    <span>Remember me</span>
                </label>
                <button type="button" @onclick="OpenForgotPassword" class="font-mono text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">@Loc["Auth_ForgotPassword"]</button>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButtonAdmin mt-2">
                <span>Sign In as Admin</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-right text-xs text-[#7A8CA6] italic">
            <span>Authorized personnel only</span>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private bool showForgotPasswordModal;
    private string? errorMessage;
    private string adminEmail = string.Empty;
    private string adminPassword = string.Empty;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
            adminEmail = query["email"] ?? string.Empty;
        }
    }

    private void OpenForgotPassword() => showForgotPasswordModal = true;
    private void CloseForgotPassword() => showForgotPasswordModal = false;
}
