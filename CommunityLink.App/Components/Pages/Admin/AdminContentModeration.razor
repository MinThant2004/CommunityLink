@page "/admin/content-moderation"
@page "/admin/content"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Administration
@using CommunityLink.Shared.Security
@inject AdministrationApiService AdminApi
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@(currentSection == "groups" ? Loc["Admin_Mod_PageTitleGroup"] : (currentSection == "members" ? Loc["Admin_Mod_PageTitleMember"] : Loc["Admin_Mod_PageTitlePost"]))</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-gradient-to-br from-rose-500/20 to-rose-600/10 border border-rose-500/30 text-rose-500">
                    @if (currentSection == "groups")
                    {
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    }
                    else if (currentSection == "members")
                    {
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6m0 3h.01"/></svg>
                    }
                    else
                    {
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/></svg>
                    }
                </span>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                        @(currentSection == "groups" ? Loc["Admin_Mod_HeadingGroups"] : (currentSection == "members" ? Loc["Admin_Mod_HeadingMembers"] : Loc["Admin_Mod_HeadingPosts"]))
                    </h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-0.5">
                        @(currentSection == "groups"
                            ? Loc["Admin_Mod_SubtitleGroups"]
                            : (currentSection == "members" ? Loc["Admin_Mod_SubtitleMembers"] : Loc["Admin_Mod_SubtitlePosts"]))
                    </p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="LoadDataAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 @(isLoading ? "animate-spin" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span>@Loc["Admin_Mod_RefreshFeed"]</span>
            </button>
        </div>
    </div>

    <!-- Sub-navigation & Controls for Current Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            @if (currentSection != "members")
            {
                <button type="button" @onclick='() => subTab = "directory"'
                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 cursor-pointer @(subTab == "directory" ? "bg-[#0A1B2E]/10 dark:bg-white/10 text-[#0A1B2E] dark:text-white font-extrabold" : "text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A]")">
                    <span>@(currentSection == "posts" ? Loc["Admin_Mod_TabPostsPollsList"] : Loc["Admin_Mod_TabGroupsList"])</span>
                    @if (currentSection == "posts" && contentItems.Any(c => !c.IsActive))
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">
                            @string.Format(Loc["Admin_Mod_CountBanned"], contentItems.Count(c => !c.IsActive))
                        </span>
                    }
                    else if (currentSection == "groups" && groups.Any(g => !g.IsActive))
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300">
                            @string.Format(Loc["Admin_Mod_CountInactive"], groups.Count(g => !g.IsActive))
                        </span>
                    }
                </button>

                <button type="button" @onclick='() => subTab = "reports"'
                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 cursor-pointer @(subTab == "reports" ? "bg-[#0A1B2E]/10 dark:bg-white/10 text-[#0A1B2E] dark:text-white font-extrabold" : "text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A]")">
                    <span>@Loc["Admin_Mod_TabPendingReports"]</span>
                    @{
                        var count = currentSection == "posts" ? postPendingReportCount : groupPendingReportCount;
                    }
                    @if (count > 0)
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500 text-white">
                            @count
                        </span>
                    }
                </button>
            }
            else
            {
                <button type="button" @onclick='() => subTab = "reports"'
                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 cursor-pointer bg-[#0A1B2E]/10 dark:bg-white/10 text-[#0A1B2E] dark:text-white font-extrabold">
                    <svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>@Loc["Admin_Mod_TabPendingReports"]</span>
                    @if (memberPendingReportCount > 0)
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500 text-white">
                            @memberPendingReportCount
                        </span>
                    }
                </button>
                <a href="admin/users" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center gap-1.5 no-underline">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <span>@Loc["Nav_AdminUserDirectory"]</span>
                    <svg class="w-3 h-3 text-[#7A8CA6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
            }
        </div>

        @if (subTab == "directory" && currentSection != "members")
        {
            <!-- Active / Inactive Status Filter -->
            <div class="flex items-center gap-1 bg-[#F1F5F9] dark:bg-[#1B3B5A]/60 p-1 rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] text-xs font-semibold">
                <span class="px-2 text-[10px] font-mono uppercase text-[#7A8CA6]">@Loc["Admin_Mod_FilterStatusLabel"]</span>
                <button type="button" @onclick='() => selectedStatusFilter = "ALL"'
                        class="px-2.5 py-1 rounded-lg transition cursor-pointer @(selectedStatusFilter == "ALL" ? "bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-white shadow-xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E]")">
                    @Loc["Admin_Mod_FilterAll"]
                </button>
                <button type="button" @onclick='() => selectedStatusFilter = "ACTIVE"'
                        class="px-2.5 py-1 rounded-lg transition cursor-pointer flex items-center gap-1 @(selectedStatusFilter == "ACTIVE" ? "bg-white dark:bg-[#0A1B2E] text-emerald-600 dark:text-emerald-400 shadow-xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-emerald-600")">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
                    <span>@Loc["Admin_Mod_FilterActive"]</span>
                </button>
                <button type="button" @onclick='() => selectedStatusFilter = "INACTIVE"'
                        class="px-2.5 py-1 rounded-lg transition cursor-pointer flex items-center gap-1 @(selectedStatusFilter == "INACTIVE" ? "bg-white dark:bg-[#0A1B2E] text-rose-600 dark:text-rose-400 shadow-xs font-bold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-rose-600")">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 inline-block"></span>
                    <span>@(currentSection == "groups" ? Loc["Admin_Mod_FilterInactive"] : Loc["Admin_Mod_FilterBanned"])</span>
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="p-16 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-3 text-xs font-medium">@Loc["Admin_Mod_LoadingQueue"]</p>
        </div>
    }
    else if (subTab == "reports")
    {
        <!-- Pending Reports List (Scoped to currentSection) -->
        var scopedReports = currentSection switch
        {
            "groups" => reports.Where(r => r.ContentType == "GROUP").ToList(),
            "members" => reports.Where(r => r.ContentType == "USER").ToList(),
            _ => reports.Where(r => r.ContentType == "POST" || r.ContentType == "POLL").ToList()
        };

        if (scopedReports.Count == 0)
        {
            <div class="p-12 text-center bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="w-12 h-12 mx-auto rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <h3 class="text-base font-bold text-[#0A1B2E] dark:text-white">@Loc["Admin_Mod_QueueClearTitle"]</h3>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1 max-w-sm mx-auto">@(currentSection == "groups" ? Loc["Admin_Mod_QueueClearDescGroup"] : (currentSection == "members" ? Loc["Admin_Mod_QueueClearDescMember"] : Loc["Admin_Mod_QueueClearDescPost"]))</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var rep in scopedReports)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl p-5 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-xs transition hover:shadow-md">
                        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                            <!-- Report details -->
                            <div class="space-y-3 flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider @(rep.ContentType == "POST" ? "bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300" : (rep.ContentType == "GROUP" ? "bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300" : (rep.ContentType == "USER" ? "bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300" : "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")))">
                                        @(rep.ContentType == "USER" ? "MEMBER / SLA" : rep.ContentType)
                                    </span>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 dark:bg-rose-950 dark:text-rose-300 border border-rose-200 dark:border-rose-900/50">
                                        @FormatReason(rep.ReasonCategory)
                                    </span>
                                    <span class="text-xs text-[#7A8CA6]">@string.Format(Loc["Admin_Mod_ReportedAt"], rep.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt"))</span>
                                </div>

                                <!-- Reporter & Message -->
                                <div class="bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 rounded-xl p-3 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                                    <div class="text-[11px] font-semibold text-[#557392] dark:text-[#C4D2E1]">
                                        @string.Format(Loc["Admin_Mod_ReportedBy"], rep.ReporterName)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rep.Details))
                                    {
                                        <p class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] mt-1 italic">
                                            "@rep.Details"
                                        </p>
                                    }
                                </div>

                                <!-- Content Preview Card -->
                                <div class="p-3.5 rounded-xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] space-y-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-[#0A1B2E] dark:text-white">@rep.ContentAuthorName</span>
                                            @if (!string.IsNullOrWhiteSpace(rep.CommunityName))
                                            {
                                                <span class="text-[10px] text-[#7A8CA6] font-mono">• @rep.CommunityName</span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            @if (rep.IsContentPrivate)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">@Loc["Admin_Mod_BadgePrivateMode"]</span>
                                            }
                                            @if (!rep.IsContentActive)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                                                    @(rep.ContentType == "GROUP" ? Loc["Admin_Mod_FilterInactive"] : Loc["Admin_Mod_FilterBanned"])
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] line-clamp-3 leading-relaxed">
                                        @rep.ContentSummary
                                    </p>
                                </div>
                            </div>

                            <!-- Action Controls -->
                            <div class="flex sm:flex-col items-center gap-2 shrink-0">
                                @if (rep.ContentType == "GROUP")
                                {
                                    @if (rep.IsContentActive)
                                    {
                                        <button type="button" @onclick='() => OpenActionModal(rep, "DEACTIVATE")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 transition cursor-pointer flex items-center justify-center gap-1.5"
                                                title="@Loc["Admin_Mod_TooltipMakeGroupInactive"]">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                            <span>@Loc["Admin_Mod_DeactivateGroup"]</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick='() => ExecuteDirectAction("GROUP", rep.ContentId, "ACTIVATE")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 transition cursor-pointer flex items-center justify-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                            <span>@Loc["Admin_Mod_ActivateGroup"]</span>
                                        </button>
                                    }
                                }
                                else if (rep.ContentType == "USER")
                                {
                                    @if (rep.IsContentActive)
                                    {
                                        <button type="button" @onclick='() => OpenActionModal(rep, "DEACTIVATE")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/30 transition cursor-pointer flex items-center justify-center gap-1.5"
                                                title="Deactivate Member Account">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                            <span>Deactivate Member</span>
                                        </button>
                                        <button type="button" @onclick='() => OpenActionModal(rep, "WARN")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 transition cursor-pointer flex items-center justify-center gap-1.5"
                                                title="Issue Warning Notification">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                            <span>Issue Warning</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick='() => ExecuteDirectAction("USER", rep.ContentId, "ACTIVATE")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 transition cursor-pointer flex items-center justify-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                            <span>Reactivate Member</span>
                                        </button>
                                    }
                                }
                                else
                                {
                                    @if (rep.IsContentActive)
                                    {
                                        <button type="button" @onclick='() => OpenActionModal(rep, "BAN")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition cursor-pointer flex items-center justify-center gap-1.5"
                                                title="@Loc["Admin_Mod_TooltipBanPost"]">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                            <span>@Loc["Admin_Mod_BanContent"]</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick='() => ExecuteDirectAction(rep.ContentType, rep.ContentId, "UNBAN")'
                                                class="w-full px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 transition cursor-pointer flex items-center justify-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                            <span>@Loc["Admin_Mod_RestoreContent"]</span>
                                        </button>
                                    }
                                }

                                <button type="button" @onclick='() => DismissReport(rep.ContentReportId)'
                                        class="w-full px-3.5 py-2 rounded-xl text-xs font-semibold text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer flex items-center justify-center gap-1.5">
                                    <span>@Loc["Admin_Mod_DismissReport"]</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (currentSection == "groups")
    {
        <!-- Groups Directory Tab -->
        <div class="space-y-4">
            <!-- Group Search Box -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7A8CA6]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" @bind="groupSearchTerm" @bind:event="oninput"
                       placeholder="@Loc["Admin_Mod_SearchGroupsPlaceholder"]"
                       class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] rounded-xl text-xs text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-white/20 shadow-xs" />
                @if (!string.IsNullOrWhiteSpace(groupSearchTerm))
                {
                    <button type="button" @onclick='() => groupSearchTerm = ""'
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white text-xs font-bold">
                        &times;
                    </button>
                }
            </div>

            @{
                var filteredGroups = groups
                    .Where(g => selectedStatusFilter switch
                    {
                        "ACTIVE" => g.IsActive,
                        "INACTIVE" => !g.IsActive,
                        _ => true
                    })
                    .Where(g => string.IsNullOrWhiteSpace(groupSearchTerm) ||
                                g.Name.Contains(groupSearchTerm, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            @if (filteredGroups.Count == 0)
            {
                <div class="p-12 text-center bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@string.Format(Loc["Admin_Mod_NoGroupsFound"], selectedStatusFilter, string.IsNullOrWhiteSpace(groupSearchTerm) ? "" : string.Format(Loc["Admin_Mod_AndSearch"], groupSearchTerm))</p>
                </div>
            }
            else
            {
                @foreach (var grp in filteredGroups)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl p-5 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-xs flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                        <div class="space-y-2 flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                                    GROUP
                                </span>

                                @if (grp.IsActive)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
                                        <span>@Loc["Admin_Mod_StatusActive"]</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 inline-block"></span>
                                        <span>@Loc["Admin_Mod_StatusInactivePostingLocked"]</span>
                                    </span>
                                }

                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                    @grp.Visibility
                                </span>

                                @if (grp.ReportCount > 0)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500 text-white">
                                        @string.Format(grp.ReportCount == 1 ? Loc["Admin_Mod_ReportCountSingular"] : Loc["Admin_Mod_ReportCountPlural"], grp.ReportCount)
                                    </span>
                                }

                                <span class="text-xs text-[#7A8CA6]">@grp.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                            </div>

                            <div class="flex items-center gap-2">
                                <h3 class="text-base font-bold text-[#0A1B2E] dark:text-white">@grp.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(grp.SubCommunityName))
                                {
                                    <span class="text-xs text-[#7A8CA6]">@string.Format(Loc["Admin_Mod_InSubCommunity"], grp.SubCommunityName)</span>
                                }
                            </div>

                            <div class="text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] flex items-center gap-3">
                                <span>@Loc["Admin_Mod_CreatorLabel"]: <strong class="text-[#0A1B2E] dark:text-white">@grp.CreatorName</strong></span>
                                <span>•</span>
                                <span>@string.Format(Loc["Chat_MemberCount"], grp.MemberCount)</span>
                                <span>•</span>
                                <span>@string.Format(Loc["Admin_Mod_PostCount"], grp.PostCount)</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(grp.Description))
                            {
                                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] leading-relaxed line-clamp-2">
                                    @grp.Description
                                </p>
                            }

                            @if (!grp.IsActive && !string.IsNullOrWhiteSpace(grp.ModerationReason))
                            {
                                <div class="text-[11px] text-amber-700 dark:text-amber-300 bg-amber-500/10 p-2.5 rounded-xl border border-amber-500/20 font-mono">
                                    <strong>@Loc["Admin_Mod_DeactivationNoticeLabel"]:</strong> @grp.ModerationReason
                                </div>
                            }
                        </div>

                        <!-- Group Moderation Controls -->
                        <div class="flex sm:flex-col items-center gap-2 shrink-0">
                            <a href="group/@grp.GroupId" target="_blank"
                               class="w-full px-3.5 py-1.5 rounded-xl text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center justify-center gap-1">
                                <span>@Loc["Admin_Mod_ViewGroupBtn"]</span>
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>

                            @if (grp.IsActive)
                            {
                                <button type="button" @onclick='() => OpenGroupActionModal(grp, "DEACTIVATE")'
                                        class="w-full px-3.5 py-1.5 rounded-xl text-xs font-bold bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 transition cursor-pointer flex items-center justify-center gap-1.5"
                                        title="@Loc["Admin_Mod_TooltipSetGroupInactive"]">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                    <span>@Loc["Admin_Mod_ActionMakeInactive"]</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick='() => ExecuteDirectAction("GROUP", grp.GroupId, "ACTIVATE")'
                                        class="w-full px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 transition cursor-pointer flex items-center justify-center gap-1.5"
                                        title="@Loc["Admin_Mod_TooltipReactivateGroup"]">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>@Loc["Admin_Mod_ActionMakeActive"]</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <!-- Posts or Polls Directory -->
        <div class="space-y-4">
            <!-- Post & Poll Search Box -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7A8CA6]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" @bind="postSearchTerm" @bind:event="oninput"
                       placeholder="@Loc["Admin_Mod_SearchPostsPlaceholder"]"
                       class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] rounded-xl text-xs text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-white/20 shadow-xs" />
                @if (!string.IsNullOrWhiteSpace(postSearchTerm))
                {
                    <button type="button" @onclick='() => postSearchTerm = ""'
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white text-xs font-bold">
                        &times;
                    </button>
                }
            </div>

            @{
                var filteredItems = contentItems
                    .Where(i => selectedStatusFilter switch
                    {
                        "ACTIVE" => i.IsActive,
                        "INACTIVE" => !i.IsActive,
                        _ => true
                    })
                    .Where(i => string.IsNullOrWhiteSpace(postSearchTerm) ||
                                (i.AuthorName != null && i.AuthorName.Contains(postSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                (i.Content != null && i.Content.Contains(postSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                (i.Question != null && i.Question.Contains(postSearchTerm, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
            }
            @if (filteredItems.Count == 0)
            {
                <div class="p-12 text-center bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@string.Format(Loc["Admin_Mod_NoContentFound"], selectedStatusFilter, string.IsNullOrWhiteSpace(postSearchTerm) ? "" : string.Format(Loc["Admin_Mod_AndSearch"], postSearchTerm))</p>
                </div>
            }
            else
            {
                @foreach (var item in filteredItems)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl p-5 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-xs flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                        <div class="space-y-2 flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider @(item.ContentType == "POST" ? "bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300" : "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                                    @item.ContentType
                                </span>

                                @if (!item.IsActive)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 flex items-center gap-1">
                                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                        <span>@Loc["Admin_Mod_StatusBanned"]</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                                        @Loc["Admin_Mod_StatusActive"]
                                    </span>
                                }

                                @if (item.ReportCount > 0)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500 text-white">
                                        @string.Format(item.ReportCount == 1 ? Loc["Admin_Mod_ReportCountSingular"] : Loc["Admin_Mod_ReportCountPlural"], item.ReportCount)
                                    </span>
                                }
                                <span class="text-xs text-[#7A8CA6]">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                            </div>

                            <div class="text-xs font-semibold text-[#0A1B2E] dark:text-white">
                                @Loc["Admin_Mod_AuthorLabel"] <span class="font-bold">@item.AuthorName</span>
                                @if (!string.IsNullOrWhiteSpace(item.CommunityName))
                                {
                                    <span class="text-[#7A8CA6]"> • @Loc["Admin_Mod_HubLabel"] @item.CommunityName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.GroupName))
                                {
                                    <span class="text-[#7A8CA6]"> • @Loc["Admin_Mod_GroupLabel"] @item.GroupName</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Question))
                            {
                                <div class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    Q: @item.Question
                                </div>
                            }

                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] leading-relaxed line-clamp-3">
                                @item.Content
                            </p>

                            @if (item.ImageUrls != null && item.ImageUrls.Count > 0)
                            {
                                <div class="flex items-center gap-1.5 pt-1">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        <span>@string.Format(item.ImageUrls.Count == 1 ? Loc["Admin_Mod_ImageCountSingular"] : Loc["Admin_Mod_ImageCountPlural"], item.ImageUrls.Count)</span>
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.CodeSnippet))
                            {
                                <div class="flex items-center gap-1.5 pt-0.5">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                                        <span>@(string.IsNullOrWhiteSpace(item.CodeFileName) ? Loc["Admin_Mod_AttachedFile"] : item.CodeFileName)</span>
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.ModerationReason))
                            {
                                <div class="text-[11px] text-rose-600 dark:text-rose-400 bg-rose-500/10 p-2.5 rounded-xl border border-rose-500/20 font-mono">
                                    <strong>@Loc["Admin_Mod_BanReasonLabel"]:</strong> @item.ModerationReason
                                </div>
                            }
                        </div>

                        <!-- Moderation Controls (View and Ban/Unban) -->
                        <div class="flex sm:flex-col items-center gap-2 shrink-0">
                            <button type="button" @onclick="() => OpenDetailModal(item)"
                                    class="w-full px-3.5 py-1.5 rounded-xl text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center justify-center gap-1.5 cursor-pointer">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <span>@(item.ContentType == "POLL" ? Loc["Admin_Mod_ViewPoll"] : Loc["Admin_Mod_ViewPost"])</span>
                            </button>

                            @if (item.IsActive)
                            {
                                <button type="button" @onclick='() => OpenDirectActionModal(item, "BAN")'
                                        class="w-full px-4 py-2 rounded-xl text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition cursor-pointer flex items-center justify-center gap-1.5 shadow-xs"
                                        title="@Loc["Admin_Mod_TooltipBanPostOnlyAuthorAdmin"]">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                    <span>@Loc["Admin_Mod_ActionBan"]</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick='() => ExecuteDirectAction(item.ContentType, item.Id, "UNBAN")'
                                        class="w-full px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition cursor-pointer flex items-center justify-center gap-1.5 shadow-xs"
                                        title="@Loc["Admin_Mod_TooltipUnbanPost"]">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>@Loc["Admin_Mod_ActionUnban"]</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<!-- Moderation Action Modal (For setting reason when Banning or Deactivating) -->
@if (showActionModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="text-base font-bold text-[#0A1B2E] dark:text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-rose-500">security</span>
                    <span>@string.Format(Loc["Admin_Mod_ConfirmModalTitle"], selectedAction == "BAN" ? Loc["Admin_Mod_BanContent"] : (selectedAction == "DEACTIVATE" ? Loc["Admin_Mod_DeactivateGroup"] : Loc["Admin_Mod_ActionGeneric"]))</span>
                </h3>
                <button type="button" @onclick="CloseActionModal" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">
                    @Loc["Admin_Mod_ActionLabel"] <span class="font-bold text-rose-500 uppercase">@(selectedAction == "DEACTIVATE" ? Loc["Admin_Mod_ActionMakeInactive"] : selectedAction)</span>
                </p>
                <p class="text-xs text-[#7A8CA6] mt-1">
                    @Loc["Admin_Mod_ActionNoticeDesc"]
                </p>
            </div>

            <!-- Ready reason presets -->
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] uppercase tracking-wider">@Loc["Admin_Mod_SelectPresetReasonLabel"]</label>
                <div class="grid grid-cols-1 gap-1.5">
                    @foreach (var reason in standardReasons)
                    {
                        <button type="button" @onclick="() => selectedReasonPreset = reason"
                                class="text-left px-3 py-2 rounded-xl text-xs font-semibold border transition cursor-pointer @(selectedReasonPreset == reason ? "bg-rose-50 dark:bg-rose-950/40 border-rose-500 text-rose-600 dark:text-rose-300" : "bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[#0A1B2E] dark:text-[#E1E8F0]")">
                            @reason
                        </button>
                    }
                </div>
            </div>

            <!-- Custom message input -->
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] uppercase tracking-wider">@Loc["Admin_Mod_CustomSetupNoteLabel"]</label>
                <textarea @bind="customReasonNote" rows="2" placeholder="@Loc["Admin_Mod_CustomReasonPlaceholder"]"
                          class="w-full text-xs p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white placeholder-[#7A8CA6] focus:outline-none focus:ring-2 focus:ring-rose-500/30"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button type="button" @onclick="CloseActionModal" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="ConfirmActionAsync" disabled="@isSubmitting"
                        class="px-4 py-2 rounded-xl text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition shadow-sm cursor-pointer disabled:opacity-50 flex items-center gap-1.5">
                    @if (isSubmitting)
                    {
                        <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    }
                    <span>@Loc["Admin_Mod_ApplyModerationBtn"]</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Content Detail Modal (View Post / View Poll) -->
@if (showDetailModal && selectedDetailItem != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-3 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider @(selectedDetailItem.ContentType == "POST" ? "bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300" : "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                        @string.Format(Loc["Admin_Mod_ContentTypeDetails"], selectedDetailItem.ContentType)
                    </span>
                    @if (!selectedDetailItem.IsActive)
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30">
                            @Loc["Admin_Mod_StatusBanned"]
                        </span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                            @Loc["Admin_Mod_StatusActive"]
                        </span>
                    }
                </div>
                <button type="button" @onclick="CloseDetailModal" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Author & Metadata header -->
            <div class="flex items-center gap-3 p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)]">
                @if (!string.IsNullOrWhiteSpace(selectedDetailItem.AuthorAvatar))
                {
                    <img src="@selectedDetailItem.AuthorAvatar" alt="@selectedDetailItem.AuthorName" class="w-10 h-10 rounded-full object-cover" />
                }
                else
                {
                    <div class="w-10 h-10 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] font-bold text-sm flex items-center justify-center font-mono">
                        @(string.IsNullOrWhiteSpace(selectedDetailItem.AuthorName) ? "U" : selectedDetailItem.AuthorName.Substring(0, 1).ToUpper())
                    </div>
                }
                <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-[#0A1B2E] dark:text-white">@selectedDetailItem.AuthorName</h4>
                    <p class="text-[11px] text-[#7A8CA6]">
                        @if (!string.IsNullOrWhiteSpace(selectedDetailItem.CommunityName))
                        {
                            <span>@string.Format(Loc["Admin_Mod_HubPrefix"], selectedDetailItem.CommunityName) • </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedDetailItem.GroupName))
                        {
                            <span>@string.Format(Loc["Admin_Mod_GroupPrefix"], selectedDetailItem.GroupName) • </span>
                        }
                        <span>@string.Format(Loc["Admin_Mod_PostedAt"], selectedDetailItem.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt"))</span>
                    </p>
                </div>
            </div>

            <!-- Poll Question & Options if Poll -->
            @if (!string.IsNullOrWhiteSpace(selectedDetailItem.Question))
            {
                <div class="p-3.5 rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900/40 space-y-2">
                    <span class="text-[10px] font-mono uppercase tracking-wider font-bold text-blue-700 dark:text-blue-300">@Loc["Admin_Mod_PollQuestionLabel"]</span>
                    <p class="text-sm font-bold text-[#0A1B2E] dark:text-white">@selectedDetailItem.Question</p>
                    @if (selectedDetailItem.PollOptions != null && selectedDetailItem.PollOptions.Count > 0)
                    {
                        <div class="space-y-1.5 pt-1">
                            @foreach (var opt in selectedDetailItem.PollOptions)
                            {
                                <div class="p-2 rounded-lg bg-white dark:bg-[#112A46] border border-blue-100 dark:border-blue-900/30 text-xs font-semibold text-[#0A1B2E] dark:text-white flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-blue-500 inline-block"></span>
                                    <span>@opt</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Post Content text -->
            @if (!string.IsNullOrWhiteSpace(selectedDetailItem.Content))
            {
                <div class="space-y-1.5">
                    <span class="text-[10px] font-mono uppercase tracking-wider font-bold text-[#7A8CA6]">@Loc["Admin_Mod_ContentLabel"]</span>
                    <div class="p-3.5 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.10)] text-xs text-[#0A1B2E] dark:text-[#E1E8F0] leading-relaxed whitespace-pre-wrap max-h-48 overflow-y-auto">
                        @selectedDetailItem.Content
                    </div>
                </div>
            }

            <!-- Attached Images if present -->
            @if (selectedDetailItem.ImageUrls != null && selectedDetailItem.ImageUrls.Count > 0)
            {
                <div class="space-y-1.5">
                    <span class="text-[10px] font-mono uppercase tracking-wider font-bold text-[#7A8CA6]">@string.Format(Loc["Admin_Mod_AttachedImagesCount"], selectedDetailItem.ImageUrls.Count)</span>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        @foreach (var imgUrl in selectedDetailItem.ImageUrls)
                        {
                            <a href="@imgUrl" target="_blank" class="block aspect-video rounded-xl overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:opacity-90 transition bg-black/5">
                                <img src="@imgUrl" alt="Attached image" class="w-full h-full object-cover" />
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Attached File / Code Snippet if present -->
            @if (!string.IsNullOrWhiteSpace(selectedDetailItem.CodeSnippet))
            {
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider font-bold text-[#7A8CA6]">
                        <span>@string.Format(Loc["Admin_Mod_AttachedFileCode"], string.IsNullOrWhiteSpace(selectedDetailItem.CodeFileName) ? "snippet.txt" : selectedDetailItem.CodeFileName)</span>
                    </div>
                    <pre class="p-3 rounded-xl bg-slate-900 text-slate-100 text-xs font-mono max-h-48 overflow-y-auto whitespace-pre-wrap">@selectedDetailItem.CodeSnippet</pre>
                </div>
            }

            <!-- Ban Reason notice if currently banned -->
            @if (!selectedDetailItem.IsActive && !string.IsNullOrWhiteSpace(selectedDetailItem.ModerationReason))
            {
                <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/40 text-xs text-rose-700 dark:text-rose-300 font-mono">
                    <strong>@Loc["Admin_Mod_ModerationNoticeLabel"]:</strong> @selectedDetailItem.ModerationReason
                </div>
            }

            <!-- Modal footer buttons -->
            <div class="flex items-center justify-between pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div>
                    @if (selectedDetailItem.IsActive)
                    {
                        <button type="button" @onclick='() => { CloseDetailModal(); OpenDirectActionModal(selectedDetailItem, "BAN"); }'
                                class="px-4 py-2 rounded-xl text-xs font-bold bg-rose-500 hover:bg-rose-600 text-white transition cursor-pointer flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                            <span>@string.Format(Loc["Admin_Mod_BanContentType"], selectedDetailItem.ContentType)</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick='async () => { CloseDetailModal(); await ExecuteDirectAction(selectedDetailItem.ContentType, selectedDetailItem.Id, "UNBAN"); }'
                                class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition cursor-pointer flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>@string.Format(Loc["Admin_Mod_UnbanContentType"], selectedDetailItem.ContentType)</span>
                        </button>
                    }
                </div>
                <button type="button" @onclick="CloseDetailModal" class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] hover:opacity-90 transition cursor-pointer">
                    @Loc["Common_Close"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string currentSection = "posts"; // "posts" or "groups"
    private string subTab = "directory"; // "directory" or "reports"
    private string selectedStatusFilter = "ALL"; // "ALL", "ACTIVE", "INACTIVE"
    private string postSearchTerm = "";
    private string groupSearchTerm = "";
    private bool isLoading = true;
    private bool isSubmitting = false;

    private List<ContentReportModel> reports = [];
    private List<ContentItemAdminModel> contentItems = [];
    private List<GroupItemAdminModel> groups = [];
    private int postPendingReportCount => reports.Count(r => r.Status == "PENDING" && (r.ContentType == "POST" || r.ContentType == "POLL"));
    private int groupPendingReportCount => reports.Count(r => r.Status == "PENDING" && r.ContentType == "GROUP");
    private int memberPendingReportCount => reports.Count(r => r.Status == "PENDING" && r.ContentType == "USER");

    // Detail modal state
    private bool showDetailModal = false;
    private ContentItemAdminModel? selectedDetailItem = null;

    private void OpenDetailModal(ContentItemAdminModel item)
    {
        selectedDetailItem = item;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedDetailItem = null;
    }

    // Modal state
    private bool showActionModal = false;
    private string selectedAction = "";
    private int? targetReportId = null;
    private string targetContentType = "";
    private int targetContentId = 0;
    private string selectedReasonPreset = "Inappropriate content";
    private string customReasonNote = "";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private readonly string[] standardReasons =
    [
        "Inappropriate content",
        "Misinformation message",
        "Misleading direction",
        "Spam or promotional abuse",
        "Harassment or safety policy violation"
    ];

    private string? _previousSection = null;
    private string? _previousSubTab = null;

    protected override async Task OnParametersSetAsync()
    {
        var sectionChanged = false;

        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            var tabStr = TabQuery.Trim().ToLowerInvariant();
            var targetSection = (tabStr == "groups" || tabStr == "group") ? "groups" 
                              : (tabStr == "members" || tabStr == "member" || tabStr == "users" || tabStr == "user" || tabStr == "sla") ? "members" 
                              : "posts";
            if (currentSection != targetSection)
            {
                currentSection = targetSection;
                sectionChanged = true;
                if (currentSection == "members")
                {
                    subTab = "reports";
                }
            }
        }

        if (!string.IsNullOrWhiteSpace(ViewQuery))
        {
            var viewStr = ViewQuery.Trim().ToLowerInvariant();
            var targetSubTab = (viewStr == "reports" || viewStr == "report") ? "reports" : "directory";
            if (subTab != targetSubTab)
            {
                subTab = targetSubTab;
                sectionChanged = true;
            }
        }

        if (sectionChanged || _previousSection != currentSection || _previousSubTab != subTab)
        {
            _previousSection = currentSection;
            _previousSubTab = subTab;
            await LoadDataAsync();
        }
    }

    private async Task SetSection(string section)
    {
        currentSection = section;
        selectedStatusFilter = "ALL";
        Navigation.NavigateTo($"admin/content-moderation?tab={section}");
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            // Always fetch reports so badges and report views are accurate
            var repRes = await AdminApi.GetContentReportsAsync("PENDING");
            if (repRes.IsSuccess && repRes.Data != null)
            {
                reports = repRes.Data.ToList();
            }

            if (currentSection == "posts")
            {
                // Load both posts and polls (excluding group-bound content)
                var res = await AdminApi.GetModeratedContentListAsync("ALL");
                if (res.IsSuccess && res.Data != null)
                {
                    contentItems = res.Data.ToList();
                }
            }
            else if (currentSection == "groups")
            {
                var res = await AdminApi.GetModeratedGroupsListAsync();
                if (res.IsSuccess && res.Data != null)
                {
                    groups = res.Data.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["Admin_Mod_Toast_LoadQueueError"], ex.Message));
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatReason(string reason) => reason switch
    {
        "INAPPROPRIATE_CONTENT" => Loc["ReportContent_ReasonInappropriate_Title"],
        "MISINFORMATION" => Loc["Admin_Mod_ReasonMisinformation"],
        "MISLEADING" => Loc["Admin_Mod_ReasonMisleading"],
        "SPAM" => Loc["Admin_Mod_ReasonSpam"],
        "HARASSMENT" => Loc["Admin_Mod_ReasonHarassment"],
        "SLA_BREACH" => Loc["ReportContent_ReasonSlaBreach_Title"],
        "UNRESPONSIVE" => Loc["ReportContent_ReasonUnresponsive_Title"],
        "SPAM_SCAM" => Loc["ReportContent_ReasonSpamScam_Title"],
        _ => reason
    };

    private void OpenActionModal(ContentReportModel rep, string action)
    {
        selectedAction = action;
        targetReportId = rep.ContentReportId;
        targetContentType = rep.ContentType;
        targetContentId = rep.ContentId;
        selectedReasonPreset = standardReasons[0];
        customReasonNote = "";
        showActionModal = true;
    }

    private void OpenDirectActionModal(ContentItemAdminModel item, string action)
    {
        selectedAction = action;
        targetReportId = null;
        targetContentType = item.ContentType;
        targetContentId = item.Id;
        selectedReasonPreset = standardReasons[0];
        customReasonNote = "";
        showActionModal = true;
    }

    private void OpenGroupActionModal(GroupItemAdminModel grp, string action)
    {
        selectedAction = action;
        targetReportId = null;
        targetContentType = "GROUP";
        targetContentId = grp.GroupId;
        selectedReasonPreset = standardReasons[0];
        customReasonNote = "";
        showActionModal = true;
    }

    private void CloseActionModal()
    {
        showActionModal = false;
    }

    private async Task DismissReport(int reportId)
    {
        var req = new ModerateContentRequestModel("DISMISS", null, "Report dismissed by admin", reportId);
        var res = await AdminApi.ModerateContentAsync(req);
        if (res.IsSuccess)
        {
            Toast.Success(Loc["Admin_Mod_Toast_ReportDismissed"]);
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Mod_Toast_DismissFailed"]);
        }
    }

    private async Task ExecuteDirectAction(string contentType, int contentId, string action)
    {
        var req = new ModerateContentRequestModel(action, null, null, null, contentType, contentId);
        var res = await AdminApi.ModerateContentAsync(req);

        if (res.IsSuccess)
        {
            Toast.Success(string.Format(Loc["Admin_Mod_Toast_ActionApplied"], action));
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Admin_Mod_Toast_ActionFailed"]);
        }
    }

    private async Task ConfirmActionAsync()
    {
        isSubmitting = true;
        try
        {
            var note = string.IsNullOrWhiteSpace(customReasonNote) ? selectedReasonPreset : $"{selectedReasonPreset}: {customReasonNote.Trim()}";

            var req = new ModerateContentRequestModel(
                selectedAction,
                selectedReasonPreset,
                note,
                targetReportId,
                targetContentType,
                targetContentId);

            var res = await AdminApi.ModerateContentAsync(req);
            if (res.IsSuccess)
            {
                Toast.Success(string.Format(Loc["Admin_Mod_Toast_ActionUpdated"], selectedAction));
                showActionModal = false;
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? Loc["Admin_Mod_Toast_ModerationFailed"]);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["Admin_Mod_Toast_GenericError"], ex.Message));
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
            }
            else
            {
                <button type="button" @onclick='() => subTab = "reports"'
                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 cursor-pointer bg-[#0A1B2E]/10 dark:bg-white/10 text-[#0A1B2E] dark:text-white font-extrabold">
                    <svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>@Loc["Admin_Mod_TabPendingReports"]</span>
                    @if (memberPendingReportCount > 0)
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500 text-white">
                            @memberPendingReportCount
                        </span>
                    }
                </button>
                <a href="admin/users" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center gap-1.5 no-underline">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <span>@Loc["Nav_AdminUserDirectory"]</span>
                    <svg class="w-3 h-3 text-[#7A8CA6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
            }

