@page "/admin/portal-entry/setup-password"
@rendermode InteractiveServer
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@using CommunityLink.Shared.Features.Administration
@using Microsoft.Extensions.Localization
@inject AdministrationApiService AdminApi
@inject NavigationManager Navigation
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Auth_AdminPasswordSetupPageTitle"]</PageTitle>

<AuthSplitScreen IsAdmin="true" LogoText="ADM" Eyebrow="@Loc["Auth_AdminOnboarding"]" Title="@Loc["Auth_AdminSetupTitle"]"
                 Subtitle="@Loc["Auth_AdminSetupSubtitle"]">
    <div class="bg-white border border-[#E2E8F0] rounded-lg p-8 shadow-sm">
        <!-- Security Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#0A1B2E] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>@Loc["Auth_InvitationAuthenticated"]</span>
                </span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] bg-[#F1F5F9] border border-[#E2E8F0] px-2 py-0.5 rounded">@Loc["Auth_15MinToken"]</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">@Loc["Auth_SetUpPasswordHeading"]</h2>
            <p class="mt-1 text-xs text-[#557392]" style="font-family:'Inter',sans-serif">@Loc["Auth_SetUpPasswordSubheading"]</p>
        </div>

        @if (isCheckingToken)
        {
            <div class="py-12 text-center text-[#557392]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                <p class="mt-3 text-sm font-medium">@Loc["Auth_ValidatingInvitationToken"]</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(tokenError))
        {
            <div class="space-y-4">
                <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs flex items-start gap-2.5">
                    <svg class="w-4 h-4 shrink-0 text-red-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <div>
                        <p class="font-bold">@Loc["Auth_InvalidOrExpiredLink"]</p>
                        <p class="mt-1">@tokenError</p>
                    </div>
                </div>
                <div class="text-center pt-2">
                    <a href="/admin/portal-entry/login" class="inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs font-bold text-[#0A1B2E] bg-[#F1F5F9] hover:bg-[#E2E8F0] transition no-underline">
                        @Loc["Auth_ReturnToAdminLogin"]
                    </a>
                </div>
            </div>
        }
        else if (isSuccess)
        {
            <div class="space-y-4 text-center py-4">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-xl">
                    ✓
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[#0A1B2E]">@Loc["Auth_PasswordConfigured"]</h3>
                    <p class="text-xs text-[#557392] mt-1">@Loc["Auth_AdminAccountActive"]</p>
                </div>
                <div class="pt-2">
                    <a href="/admin/portal-entry/login" class="@AuthClasses.PrimaryButtonAdmin text-center inline-block no-underline">
                        @Loc["Auth_GoToAdminSignIn"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="mb-5 p-3 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] text-xs">
                <div class="flex justify-between items-center text-[#557392] mb-1">
                    <span>@Loc["Auth_ProvisioningEmail"]</span>
                    <strong class="text-[#0A1B2E] font-mono">@inviteInfo?.Email</strong>
                </div>
                <div class="flex justify-between items-center text-[#557392]">
                    <span>@Loc["Auth_AdministratorType"]</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono @(inviteInfo?.IsSuperAdmin == true ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-blue-50 text-blue-700 border border-blue-200")">
                        @(inviteInfo?.IsSuperAdmin == true ? "SYSTEMADMIN" : "ADMIN")
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="@AuthClasses.ErrorAlert mb-4">
                    <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>@formError</span>
                </div>
            }

            <form @onsubmit="HandleSubmit" class="space-y-4">
                <div class="space-y-1.5">
                    <label for="new-pw" class="@AuthClasses.Label">@Loc["Auth_EnterAPassword"]</label>
                    <div class="relative">
                        <input id="new-pw" type="password" required autofocus @bind="newPassword" placeholder="@Loc["Auth_NewPasswordAtLeast8Placeholder"]" class="@AuthClasses.InputAdmin pr-12" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="confirm-pw" class="@AuthClasses.Label">@Loc["Auth_ConfirmAPassword"]</label>
                    <div class="relative">
                        <input id="confirm-pw" type="password" required @bind="confirmPassword" placeholder="@Loc["Auth_ConfirmNewPasswordPlaceholder"]" class="@AuthClasses.InputAdmin pr-12" />
                    </div>
                </div>

                <button type="submit" disabled="@isSubmitting" class="@AuthClasses.PrimaryButtonAdmin mt-2 flex items-center justify-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
                        <span>@Loc["Auth_SavingPassword"]</span>
                    }
                    else
                    {
                        <span>@Loc["Auth_CompleteSetupActivate"]</span>
                        <span aria-hidden="true">&rarr;</span>
                    }
                </button>
            </form>
        }
    </div>
</AuthSplitScreen>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isCheckingToken = true;
    private string? tokenError;
    private VerifyAdminInviteResponseModel? inviteInfo;

    private string newPassword = "";
    private string confirmPassword = "";
    private string? formError;
    private bool isSubmitting;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            tokenError = Loc["Auth_MissingInvitationToken"];
            isCheckingToken = false;
            return;
        }

        var verifyResult = await AdminApi.VerifyAdminInviteTokenAsync(Token);
        if (!verifyResult.IsSuccess || verifyResult.Data == null)
        {
            tokenError = verifyResult.Message;
        }
        else
        {
            inviteInfo = verifyResult.Data;
        }

        isCheckingToken = false;
    }

    private async Task HandleSubmit()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            formError = Loc["Auth_Validation_PasswordMinLength"];
            return;
        }

        if (newPassword != confirmPassword)
        {
            formError = Loc["Auth_Validation_PasswordsDoNotMatch"];
            return;
        }

        isSubmitting = true;
        var result = await AdminApi.SetupAdminPasswordAsync(new SetupAdminPasswordRequestModel(Token!, newPassword, confirmPassword));
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            formError = result.Message;
        }
        else
        {
            isSuccess = true;
        }
    }
}
