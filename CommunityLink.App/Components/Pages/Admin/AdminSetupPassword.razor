@page "/admin/portal-entry/setup-password"
@rendermode InteractiveServer
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@using CommunityLink.Shared.Features.Administration
@inject AdministrationApiService AdminApi
@inject NavigationManager Navigation

<PageTitle>Admin Password Setup — CommunityLink</PageTitle>

<AuthSplitScreen IsAdmin="true" LogoText="ADM" Eyebrow="ADMINISTRATOR ONBOARDING" Title="Initialize your administrator credentials."
                 Subtitle="Configure your secure operator access credentials. Your invitation link was authenticated for 15 minutes.">
    <div class="bg-white border border-[#E2E8F0] rounded-lg p-8 shadow-sm">
        <!-- Security Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#0A1B2E] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>INVITATION AUTHENTICATED</span>
                </span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] bg-[#F1F5F9] border border-[#E2E8F0] px-2 py-0.5 rounded">15-MIN TOKEN</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">Set Up Password</h2>
            <p class="mt-1 text-xs text-[#557392]" style="font-family:'Inter',sans-serif">Establish your administrator password to activate your access.</p>
        </div>

        @if (isCheckingToken)
        {
            <div class="py-12 text-center text-[#557392]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                <p class="mt-3 text-sm font-medium">Validating 15-minute invitation token...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(tokenError))
        {
            <div class="space-y-4">
                <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs flex items-start gap-2.5">
                    <span class="text-base leading-none">⚠️</span>
                    <div>
                        <p class="font-bold">Invalid or Expired Link</p>
                        <p class="mt-1">@tokenError</p>
                    </div>
                </div>
                <div class="text-center pt-2">
                    <a href="/admin/portal-entry/login" class="inline-flex items-center gap-1.5 px-4 py-2 rounded text-xs font-bold text-[#0A1B2E] bg-[#F1F5F9] hover:bg-[#E2E8F0] transition no-underline">
                        Return to Admin Login &rarr;
                    </a>
                </div>
            </div>
        }
        else if (isSuccess)
        {
            <div class="space-y-4 text-center py-4">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-xl">
                    ✓
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[#0A1B2E]">Password Configured!</h3>
                    <p class="text-xs text-[#557392] mt-1">Your administrator account is now active. You may log in immediately.</p>
                </div>
                <div class="pt-2">
                    <a href="/admin/portal-entry/login" class="@AuthClasses.PrimaryButtonAdmin text-center inline-block no-underline">
                        Go to Admin Sign In &rarr;
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="mb-5 p-3 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] text-xs">
                <div class="flex justify-between items-center text-[#557392] mb-1">
                    <span>Provisioning Email:</span>
                    <strong class="text-[#0A1B2E] font-mono">@inviteInfo?.Email</strong>
                </div>
                <div class="flex justify-between items-center text-[#557392]">
                    <span>Administrator Type:</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono @(inviteInfo?.IsSuperAdmin == true ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-blue-50 text-blue-700 border border-blue-200")">
                        @(inviteInfo?.IsSuperAdmin == true ? "SYSTEMADMIN" : "ADMIN")
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="@AuthClasses.ErrorAlert mb-4">
                    <span class="mt-0.5">⚠️</span>
                    <span>@formError</span>
                </div>
            }

            <form @onsubmit="HandleSubmit" class="space-y-4">
                <div class="space-y-1.5">
                    <label for="new-pw" class="@AuthClasses.Label">Enter A Password</label>
                    <div class="relative">
                        <input id="new-pw" type="password" required autofocus @bind="newPassword" placeholder="Minimum 8 characters" class="@AuthClasses.InputAdmin pr-12" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="confirm-pw" class="@AuthClasses.Label">Confirm A Password</label>
                    <div class="relative">
                        <input id="confirm-pw" type="password" required @bind="confirmPassword" placeholder="Re-enter password" class="@AuthClasses.InputAdmin pr-12" />
                    </div>
                </div>

                <button type="submit" disabled="@isSubmitting" class="@AuthClasses.PrimaryButtonAdmin mt-2 flex items-center justify-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
                        <span>Saving Password...</span>
                    }
                    else
                    {
                        <span>Complete Setup &amp; Activate Account</span>
                        <span aria-hidden="true">&rarr;</span>
                    }
                </button>
            </form>
        }
    </div>
</AuthSplitScreen>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isCheckingToken = true;
    private string? tokenError;
    private VerifyAdminInviteResponseModel? inviteInfo;

    private string newPassword = "";
    private string confirmPassword = "";
    private string? formError;
    private bool isSubmitting;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            tokenError = "Missing invitation token in link.";
            isCheckingToken = false;
            return;
        }

        var verifyResult = await AdminApi.VerifyAdminInviteTokenAsync(Token);
        if (!verifyResult.IsSuccess || verifyResult.Data == null)
        {
            tokenError = verifyResult.Message;
        }
        else
        {
            inviteInfo = verifyResult.Data;
        }

        isCheckingToken = false;
    }

    private async Task HandleSubmit()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            formError = "Password must be at least 8 characters long.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            formError = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        var result = await AdminApi.SetupAdminPasswordAsync(new SetupAdminPasswordRequestModel(Token!, newPassword, confirmPassword));
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            formError = result.Message;
        }
        else
        {
            isSuccess = true;
        }
    }
}
