@page "/admin/users"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast

<PageTitle>User Management — Admin Control Panel</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">👥 Platform User Directory</h1>
            <p class="text-sm text-[#557392]">Manage registered users, roles, and account statuses across the platform.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-[#E2E8F0] overflow-hidden shadow-sm">
        <div class="p-4 border-b border-[#E2E8F0] bg-[#F8FAFC] flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm bg-white text-[#0A1B2E] placeholder-[#7A8CA6] border border-[#CBD5E1] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 focus:border-[#0A1B2E] transition" placeholder="Search by name, username, or email..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-[#7A8CA6] font-mono">
                Showing page @pageNumber of @totalPages (@totalCount total users)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-[#557392]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading user records...</p>
            </div>
        }
        else if (users == null || !users.Any())
        {
            <div class="p-8 text-center text-[#7A8CA6]">
                <p class="text-sm font-medium">No users found matching query.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#F1F5F9] border-b border-[#E2E8F0] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                            <th class="px-6 py-3">ID</th>
                            <th class="px-6 py-3">Display Name</th>
                            <th class="px-6 py-3">Username</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3">Assigned Role</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Registered Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] text-sm">
                        @foreach (var u in users)
                        {
                            <tr class="hover:bg-[#F8FAFC] transition">
                                <td class="px-6 py-4 font-mono text-xs text-[#7A8CA6]">#@u.UserId</td>
                                <td class="px-6 py-4 font-semibold text-[#0A1B2E]">@u.DisplayName</td>
                                <td class="px-6 py-4 text-[#557392] font-medium font-mono">@@@u.UserName</td>
                                <td class="px-6 py-4 text-[#557392]">@u.Email</td>
                                <td class="px-6 py-4">
                                    <select value="@u.RoleId" @onchange="(e) => OnRoleSelected(u.UserId, e)" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600">
                                        @if (availableRoles != null)
                                        {
                                            @if (!availableRoles.Any(r => r.RoleId == u.RoleId))
                                            {
                                                <option value="@u.RoleId" disabled selected>@u.RoleCode (Default)</option>
                                            }
                                            @foreach (var r in availableRoles)
                                            {
                                                <option value="@r.RoleId">@r.Name (@r.Code)</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="@u.RoleId">@u.RoleCode</option>
                                        }
                                    </select>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @(u.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-[#F1F5F9] text-[#7A8CA6] border border-[#E2E8F0]")">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs text-[#7A8CA6] font-mono">@u.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-[#E2E8F0] flex items-center justify-between text-xs text-[#7A8CA6] bg-[#F8FAFC]">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] bg-white text-[#557392] font-medium hover:border-[#0A1B2E] hover:text-[#0A1B2E] disabled:opacity-50 transition">
                    &larr; Previous
                </button>
                <span class="font-mono">Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] bg-white text-[#557392] font-medium hover:border-[#0A1B2E] hover:text-[#0A1B2E] disabled:opacity-50 transition">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<UserInfoModel>? users;
    private IReadOnlyList<CommunityLink.Shared.Features.RoleAndPermission.RoleModel>? availableRoles;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
        await LoadUsersAsync();
    }

    private async Task LoadRolesAsync()
    {
        var res = await RoleApi.GetRolesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            // Per requirements: Remove default 'User' role (and 'Member') so admins only assign Domain Professional, Public Figure, etc.
            availableRoles = res.Data
                .Where(r => !r.Code.Equals("USER", StringComparison.OrdinalIgnoreCase)
                         && !r.Code.Equals("MEMBER", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetUsersPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            users = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private async Task OnRoleSelected(int userId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var roleId))
        {
            var res = await AdminApi.AssignUserRoleAsync(new CommunityLink.Shared.Features.Authentication.AssignUserRoleRequestModel(userId, roleId));
            if (res.IsSuccess)
            {
                Toast.Success("Role updated successfully!");
                await LoadUsersAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadUsersAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadUsersAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadUsersAsync();
        }
    }
}
