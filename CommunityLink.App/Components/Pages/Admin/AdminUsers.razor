@page "/admin/users"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi

<PageTitle>User Management — Admin Control Panel</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">👥 Platform User Directory</h1>
            <p class="text-sm text-slate-500">Manage registered users, roles, and account statuses across the platform.</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-200 bg-slate-50/50 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Search by name, username, or email..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-slate-500">
                Showing page @pageNumber of @totalPages (@totalCount total users)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading user records...</p>
            </div>
        }
        else if (users == null || !users.Any())
        {
            <div class="p-8 text-center text-slate-500">
                <p class="text-sm font-medium">No users found matching query.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="px-6 py-3">ID</th>
                            <th class="px-6 py-3">Display Name</th>
                            <th class="px-6 py-3">Username</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3">Role</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Registered Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 text-sm">
                        @foreach (var u in users)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">#@u.UserId</td>
                                <td class="px-6 py-4 font-semibold text-slate-900">@u.DisplayName</td>
                                <td class="px-6 py-4 text-indigo-600 font-medium">@@@u.UserName</td>
                                <td class="px-6 py-4 text-slate-600">@u.Email</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @(u.RoleCode == "ADMIN" || u.RoleCode == "SUPERADMIN" ? "bg-rose-50 text-rose-700 border border-rose-200" : "bg-indigo-50 text-indigo-700 border border-indigo-200")">
                                        @u.RoleCode
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @(u.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-300")">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500">@u.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white font-medium hover:bg-slate-50 disabled:opacity-50 transition">
                    &larr; Previous
                </button>
                <span>Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white font-medium hover:bg-slate-50 disabled:opacity-50 transition">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<UserInfoModel>? users;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetUsersPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            users = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadUsersAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadUsersAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadUsersAsync();
        }
    }
}
