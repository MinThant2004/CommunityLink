@page "/admin/users"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@inject AdministrationApiService AdminApi
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast

<PageTitle>User Management — Admin Control Panel</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">👥 Platform User Directory</h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1]">Manage registered users, roles, and account statuses across the platform.</p>
        </div>
    </div>

    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
        <div class="p-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-80">
                <input type="text" class="w-full px-3.5 py-2 rounded-lg text-sm bg-white dark:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition" placeholder="Search by name, username, or email..." @bind="searchFilter" @bind:after="OnSearchChanged" />
            </div>
            <div class="text-xs text-[#7A8CA6] font-mono">
                Showing page @pageNumber of @totalPages (@totalCount total users)
            </div>
        </div>

        @if (isLoading)
        {
            <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                <p class="mt-2 text-sm font-medium">Loading user records...</p>
            </div>
        }
        else if (users == null || !users.Any())
        {
            <div class="p-8 text-center text-[#7A8CA6] dark:text-[#C4D2E1]">
                <p class="text-sm font-medium">No users found matching query.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#F1F5F9] dark:bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                            <th class="px-6 py-3">ID</th>
                            <th class="px-6 py-3">Display Name</th>
                            <th class="px-6 py-3">Username</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3">Assigned Role</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Registered Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)] text-sm">
                        @foreach (var u in users)
                        {
                            <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/40 transition">
                                <td class="px-6 py-4 font-mono text-xs text-[#7A8CA6]">#@u.UserId</td>
                                <td class="px-6 py-4 font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@u.DisplayName</td>
                                <td class="px-6 py-4 text-[#557392] dark:text-[#C4D2E1] font-medium font-mono">@@@u.UserName</td>
                                <td class="px-6 py-4 text-[#557392] dark:text-[#C4D2E1]">@u.Email</td>
                                <td class="px-6 py-4">
                                    <select value="@u.RoleId" @onchange="(e) => PromptRoleChange(u, e)" class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600">
                                        @if (availableRoles != null)
                                        {
                                            @if (!availableRoles.Any(r => r.RoleId == u.RoleId))
                                            {
                                                <option value="@u.RoleId" disabled selected>@u.RoleCode (Default)</option>
                                            }
                                            @foreach (var r in availableRoles)
                                            {
                                                <option value="@r.RoleId">@r.Name (@r.Code)</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="@u.RoleId">@u.RoleCode</option>
                                        }
                                    </select>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @(u.IsActive ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50" : "bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#7A8CA6] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]")">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs text-[#7A8CA6] font-mono">@u.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="px-6 py-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-xs text-[#7A8CA6] bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                <button @onclick="PreviousPage" disabled="@(pageNumber <= 1)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] font-medium hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white disabled:opacity-50 transition cursor-pointer">
                    &larr; Previous
                </button>
                <span class="font-mono">Page @pageNumber of @totalPages</span>
                <button @onclick="NextPage" disabled="@(pageNumber >= totalPages)" class="px-3 py-1.5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] font-medium hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white disabled:opacity-50 transition cursor-pointer">
                    Next &rarr;
                </button>
            </div>
        }
    </div>
</div>

@if (showConfirmModal && pendingUser != null && pendingRole != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 text-left space-y-4">
            <div class="flex items-center gap-3 text-amber-500">
                <div class="p-2 rounded-xl bg-amber-100 dark:bg-amber-900/30">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Confirm Role Assignment</h3>
            </div>
            
            <p class="text-sm text-slate-600 dark:text-slate-300">
                Are you sure you want to change the role of <strong>@pendingUser.DisplayName</strong> (@@@pendingUser.UserName)?
            </p>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-xs space-y-1">
                <div class="flex justify-between">
                    <span class="text-slate-500">Current Role:</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200">@pendingUser.RoleCode</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">New Role:</span>
                    <span class="font-bold text-indigo-600 dark:text-indigo-400">@pendingRole.Name (@pendingRole.Code)</span>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" @onclick="CancelRoleChange" class="px-4 py-2 text-sm font-semibold rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmRoleChange" disabled="@isAssigning" class="px-4 py-2 text-sm font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-sm cursor-pointer disabled:opacity-50">
                    @(isAssigning ? "Updating..." : "Yes, Update Role")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isAssigning = false;
    private bool showConfirmModal = false;
    private UserInfoModel? pendingUser;
    private CommunityLink.Shared.Features.RoleAndPermission.RoleModel? pendingRole;
    private IReadOnlyList<UserInfoModel>? users;
    private IReadOnlyList<CommunityLink.Shared.Features.RoleAndPermission.RoleModel>? availableRoles;
    private string searchFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
        await LoadUsersAsync();
    }

    private async Task LoadRolesAsync()
    {
        var res = await RoleApi.GetRolesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            // Per requirements: Remove default 'User' role (and 'Member') so admins only assign Domain Professional, Public Figure, etc.
            availableRoles = res.Data
                .Where(r => !r.Code.Equals("USER", StringComparison.OrdinalIgnoreCase)
                         && !r.Code.Equals("MEMBER", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        var res = await AdminApi.GetUsersPageAsync(pageNumber, pageSize, searchFilter);
        if (res.IsSuccess && res.Data != null)
        {
            users = res.Data.Items;
            totalCount = res.Data.TotalCount;
        }
        isLoading = false;
    }

    private void PromptRoleChange(UserInfoModel user, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var roleId) && availableRoles != null)
        {
            var targetRole = availableRoles.FirstOrDefault(r => r.RoleId == roleId);
            if (targetRole != null && targetRole.RoleId != user.RoleId)
            {
                pendingUser = user;
                pendingRole = targetRole;
                showConfirmModal = true;
                return;
            }
        }
        StateHasChanged();
    }

    private void CancelRoleChange()
    {
        showConfirmModal = false;
        pendingUser = null;
        pendingRole = null;
    }

    private async Task ConfirmRoleChange()
    {
        if (pendingUser == null || pendingRole == null) return;

        isAssigning = true;
        var res = await AdminApi.AssignUserRoleAsync(new CommunityLink.Shared.Features.Authentication.AssignUserRoleRequestModel(pendingUser.UserId, pendingRole.RoleId));
        isAssigning = false;
        showConfirmModal = false;

        if (res.IsSuccess)
        {
            Toast.Success("Role updated successfully!");
            await LoadUsersAsync();
        }
        else
        {
            Toast.Error(res.Message);
        }

        pendingUser = null;
        pendingRole = null;
    }

    private async Task OnSearchChanged()
    {
        pageNumber = 1;
        await LoadUsersAsync();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadUsersAsync();
        }
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadUsersAsync();
        }
    }
}
