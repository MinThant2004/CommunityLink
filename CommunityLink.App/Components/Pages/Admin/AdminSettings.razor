@page "/admin/settings"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.Shared.Features.Admin
@using CommunityLink.Shared.Security
@inject AdministrationApiService AdminApi
@inject ToastService Toast

<PageTitle>Platform Settings — Admin Control Panel</PageTitle>

<div class="max-w-4xl mx-auto space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                <svg class="w-6 h-6 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                <span>Platform Settings</span>
            </h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1]">Manage global system parameters and platform financial commission rates.</p>
        </div>
        <button @onclick="LoadCommissionAsync" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            <span>Refresh Settings</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-8 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="mt-2 text-xs font-medium">Loading platform settings...</p>
        </div>
    }
    else
    {
        <!-- Platform Commission Card -->
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-6 space-y-4">
            <div class="flex items-start justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] pb-4">
                <div>
                    <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        <span>Platform Commission</span>
                    </h2>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">
                        Configure the platform commission percentage applied to paid group chats and monetization transactions.
                    </p>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#F1F5F9] dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)]">
                    Current: @settingDto.CommissionPercentage.ToString("F2")%
                </span>
            </div>

            <!-- Form & Controls -->
            <div class="space-y-4 pt-2">
                <div class="max-w-xs space-y-1.5">
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Platform Commission Percentage</label>
                    <div class="relative flex items-center">
                        <input type="number" step="0.01" min="0" max="100"
                               @bind="commissionInput"
                               @bind:event="oninput"
                               @onchange="ValidateCommissionInput"
                               class="w-full bg-[#F8FAFC] dark:bg-[#0A1B2E] border @(string.IsNullOrEmpty(errorMessage) ? "border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0]" : "border-rose-400 focus:border-rose-500 bg-rose-50/30") rounded-lg pl-3.5 pr-8 py-2 text-sm text-[#0A1B2E] dark:text-[#E1E8F0] font-medium focus:ring-2 focus:ring-[#0A1B2E]/20 transition" />
                        <span class="absolute right-3 text-sm font-bold text-[#7A8CA6] pointer-events-none">%</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="text-xs font-semibold text-rose-600 dark:text-rose-400 flex items-center gap-1.5 bg-rose-50 dark:bg-rose-950/40 p-2.5 rounded-lg border border-rose-200 dark:border-rose-900/50 max-w-md">
                        <svg class="w-4 h-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                        <span>@errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 bg-emerald-50 dark:bg-emerald-950/40 p-2.5 rounded-lg border border-emerald-200 dark:border-emerald-800 max-w-md">
                        <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        <span>@successMessage</span>
                    </div>
                }

                <div class="flex items-center gap-3 pt-2">
                    <button @onclick="SaveCommissionAsync"
                            disabled="@(isSaving || !string.IsNullOrEmpty(errorMessage))"
                            class="px-5 py-2 rounded-lg text-xs font-bold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                        @(isSaving ? "Saving..." : "Save Commission")
                    </button>
                </div>

                @if (settingDto.UpdatedAt.HasValue)
                {
                    <p class="text-[11px] text-[#7A8CA6] pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        Last Updated: <span class="font-medium text-[#557392] dark:text-[#C4D2E1]">@settingDto.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm:ss") UTC</span>
                        @(settingDto.UpdatedBy.HasValue ? $" (Admin ID: #{settingDto.UpdatedBy})" : "")
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private PlatformCommissionSettingDto settingDto = new();
    private string commissionInput = "10.00";
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCommissionAsync();
    }

    private async Task LoadCommissionAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        var res = await AdminApi.GetPlatformCommissionAsync();
        if (res.IsSuccess && res.Data != null)
        {
            settingDto = res.Data;
            commissionInput = settingDto.CommissionPercentage.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to load commission settings.");
        }
        isLoading = false;
    }

    private void ValidateCommissionInput()
    {
        successMessage = null;
        if (string.IsNullOrWhiteSpace(commissionInput))
        {
            errorMessage = "Commission percentage is required.";
            return;
        }

        if (!decimal.TryParse(commissionInput, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            errorMessage = "Please enter a valid numeric percentage.";
            return;
        }

        if (val < 0)
        {
            errorMessage = "Commission percentage cannot be negative (Min: 0%).";
            return;
        }

        if (val > 100)
        {
            errorMessage = "Commission percentage cannot exceed 100%.";
            return;
        }

        errorMessage = null;
    }

    private async Task SaveCommissionAsync()
    {
        ValidateCommissionInput();
        if (!string.IsNullOrEmpty(errorMessage)) return;

        if (!decimal.TryParse(commissionInput, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
            return;

        isSaving = true;
        successMessage = null;

        var request = new UpdateCommissionSettingRequestDto { CommissionPercentage = val };
        var res = await AdminApi.UpdatePlatformCommissionAsync(request);

        if (res.IsSuccess && res.Data != null)
        {
            settingDto = res.Data;
            commissionInput = settingDto.CommissionPercentage.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            successMessage = res.Message ?? "Platform commission percentage updated successfully.";
            Toast.Success(successMessage);
        }
        else
        {
            errorMessage = res.Message ?? "Failed to update platform commission.";
            Toast.Error(errorMessage);
        }

        isSaving = false;
    }
}
