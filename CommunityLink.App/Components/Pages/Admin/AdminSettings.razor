@page "/admin/settings"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminUserView)]
@using CommunityLink.Shared.Features.Admin
@inject AdministrationApiService AdminApi
@inject ToastService Toast

<PageTitle>Platform Settings — Admin Portal</PageTitle>

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">⚙️ Platform Settings</h1>
            <p class="text-sm text-slate-500">Manage global system parameters and platform financial commission rates.</p>
        </div>
        <button @onclick="LoadCommissionAsync" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 transition shadow-sm">
            🔄 Refresh Settings
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-8 text-center text-slate-500 bg-white rounded-xl shadow-sm border border-slate-200">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-indigo-600 border-t-transparent"></div>
            <p class="mt-2 text-xs font-medium">Loading platform settings...</p>
        </div>
    }
    else
    {
        <!-- Platform Commission Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
            <div class="flex items-start justify-between border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span>💰</span> Platform Commission
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        Configure the platform commission percentage applied to paid group chats and monetization transactions.
                    </p>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    Current: @settingDto.CommissionPercentage.ToString("F2")%
                </span>
            </div>

            <!-- Form & Controls -->
            <div class="space-y-4 pt-2">
                <div class="max-w-xs space-y-1.5">
                    <label class="block text-xs font-semibold text-slate-700">Platform Commission Percentage</label>
                    <div class="relative flex items-center">
                        <input type="number" step="0.01" min="0" max="100"
                               @bind="commissionInput"
                               @bind:event="oninput"
                               @onchange="ValidateCommissionInput"
                               class="w-full bg-slate-50 border @(string.IsNullOrEmpty(errorMessage) ? "border-slate-300 focus:border-indigo-500" : "border-rose-400 focus:border-rose-500 bg-rose-50/30") rounded-lg pl-3.5 pr-8 py-2 text-sm text-slate-900 font-medium focus:ring-2 focus:ring-indigo-200 transition" />
                        <span class="absolute right-3 text-sm font-bold text-slate-400 pointer-events-none">%</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="text-xs font-semibold text-rose-600 flex items-center gap-1.5 bg-rose-50 p-2.5 rounded-lg border border-rose-200 max-w-md">
                        <span>⚠️</span> @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="text-xs font-semibold text-emerald-600 flex items-center gap-1.5 bg-emerald-50 p-2.5 rounded-lg border border-emerald-200 max-w-md">
                        <span>✅</span> @successMessage
                    </div>
                }

                <div class="flex items-center gap-3 pt-2">
                    <button @onclick="SaveCommissionAsync"
                            disabled="@(isSaving || !string.IsNullOrEmpty(errorMessage))"
                            class="px-5 py-2 rounded-lg text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                        @(isSaving ? "Saving..." : "Save Commission")
                    </button>
                </div>

                @if (settingDto.UpdatedAt.HasValue)
                {
                    <p class="text-[11px] text-slate-400 pt-2 border-t border-slate-100">
                        Last Updated: <span class="font-medium text-slate-600">@settingDto.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm:ss") UTC</span>
                        @(settingDto.UpdatedBy.HasValue ? $" (Admin ID: #{settingDto.UpdatedBy})" : "")
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private PlatformCommissionSettingDto settingDto = new();
    private string commissionInput = "10.00";
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCommissionAsync();
    }

    private async Task LoadCommissionAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        var res = await AdminApi.GetPlatformCommissionAsync();
        if (res.IsSuccess && res.Data != null)
        {
            settingDto = res.Data;
            commissionInput = settingDto.CommissionPercentage.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to load commission settings.");
        }
        isLoading = false;
    }

    private void ValidateCommissionInput()
    {
        successMessage = null;
        if (string.IsNullOrWhiteSpace(commissionInput))
        {
            errorMessage = "Commission percentage is required.";
            return;
        }

        if (!decimal.TryParse(commissionInput, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            errorMessage = "Please enter a valid numeric percentage.";
            return;
        }

        if (val < 0)
        {
            errorMessage = "Commission percentage cannot be negative (Min: 0%).";
            return;
        }

        if (val > 100)
        {
            errorMessage = "Commission percentage cannot exceed 100%.";
            return;
        }

        errorMessage = null;
    }

    private async Task SaveCommissionAsync()
    {
        ValidateCommissionInput();
        if (!string.IsNullOrEmpty(errorMessage)) return;

        if (!decimal.TryParse(commissionInput, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
            return;

        isSaving = true;
        successMessage = null;

        var request = new UpdateCommissionSettingRequestDto { CommissionPercentage = val };
        var res = await AdminApi.UpdatePlatformCommissionAsync(request);

        if (res.IsSuccess && res.Data != null)
        {
            settingDto = res.Data;
            commissionInput = settingDto.CommissionPercentage.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            successMessage = res.Message ?? "Platform commission percentage updated successfully.";
            Toast.Success(successMessage);
        }
        else
        {
            errorMessage = res.Message ?? "Failed to update platform commission.";
            Toast.Error(errorMessage);
        }

        isSaving = false;
    }
}
