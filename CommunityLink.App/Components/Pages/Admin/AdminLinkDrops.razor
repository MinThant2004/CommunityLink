@code {
    private string activeTab = "pending";

    private List<PurchaseResponseDto> pendingList = new();
    private List<LinkDropPackageDto> packagesList = new();
    private List<PaymentMethodDto> methodsList = new();

    private bool isLoadingPending = true;

    // Modals
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private bool showProofModal = false;
    private PurchaseResponseDto? targetPurchase;
    private string approveNotes = string.Empty;
    private string rejectReason = string.Empty;
    private string previewProofUrl = string.Empty;

    // Package creation state
    private string newPkgName = string.Empty;
    private long newPkgDrops = 100;
    private long newPkgBonus = 0;
    private decimal newPkgPrice = 1000.00m;

    // Payment Method creation state
    private string newMethodName = string.Empty;
    private string newAccountName = string.Empty;
    private string newAccountNumber = string.Empty;
    private string newInstructions = string.Empty;
    private IBrowserFile? newQrFile;
    private string? newQrPreviewUrl;
    private IBrowserFile? newLogoFile;
    private string? newLogoPreviewUrl;

    // Edit modals
    private bool showEditPackageModal = false;
    private LinkDropPackageDto? editPackage;
    private bool showEditMethodModal = false;
    private PaymentMethodDto? editMethod;
    private IBrowserFile? editQrFile;
    private string? editQrPreviewUrl;
    private IBrowserFile? editLogoFile;
    private string? editLogoPreviewUrl;

    // Exchange Rates state
    private bool isLoadingRates = false;
    private bool isSavingRates = false;
    private decimal rateMmk = 1.0m;
    private decimal rateUsd = 0.0003m;
    private decimal rateCny = 0.0022m;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    private async Task RefreshAllAsync()
    {
        await LoadPendingAsync();
        await LoadPackagesAsync();
        await LoadMethodsAsync();
        await LoadRatesAsync();
    }

    private async Task LoadRatesAsync()
    {
        isLoadingRates = true;
        var res = await LinkDropApi.GetExchangeRatesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            rateMmk = res.Data.MmkPerLinkDrop;
            rateUsd = res.Data.UsdPerLinkDrop;
            rateCny = res.Data.CnyPerLinkDrop;
        }
        isLoadingRates = false;
    }

    private async Task SaveExchangeRatesAsync()
    {
        if (rateMmk <= 0)
        {
            Toast.Error("MMK rate must be greater than zero.");
            return;
        }

        isSavingRates = true;
        var req = new UpdateExchangeRateSettingRequestDto
        {
            MmkPerLinkDrop = rateMmk,
            UsdPerLinkDrop = rateUsd,
            CnyPerLinkDrop = rateCny
        };
        var res = await LinkDropApi.UpdateExchangeRatesAsync(req);
        if (res.IsSuccess)
        {
            Toast.Success("Exchange rates updated successfully!");
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update exchange rates.");
        }
        isSavingRates = false;
    }

    private async Task LoadPendingAsync()
    {
        isLoadingPending = true;
        var res = await LinkDropApi.GetPendingPurchasesAsync();
        if (res.IsSuccess && res.Data != null)
            pendingList = res.Data.ToList();
        isLoadingPending = false;
    }

    private async Task LoadPackagesAsync()
    {
        var res = await LinkDropApi.GetAllPackagesAsync();
        if (res.IsSuccess && res.Data != null)
            packagesList = res.Data.ToList();
    }

    private async Task LoadMethodsAsync()
    {
        var res = await LinkDropApi.GetAllPaymentMethodsAsync();
        if (res.IsSuccess && res.Data != null)
            methodsList = res.Data.ToList();
    }

    private void OpenProofModal(string url)
    {
        previewProofUrl = BuildFileUrl(url);
        showProofModal = true;
    }

    private string BuildFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var apiBase = Configuration["CommunityApi:BaseUrl"] ?? "https://localhost:56536";
        return $"{apiBase.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    private void OpenApproveModal(PurchaseResponseDto p)
    {
        targetPurchase = p;
        approveNotes = string.Empty;
        showApproveModal = true;
    }

    private void OpenRejectModal(PurchaseResponseDto p)
    {
        targetPurchase = p;
        rejectReason = string.Empty;
        showRejectModal = true;
    }

    private async Task ConfirmApproveAsync()
    {
        if (targetPurchase == null) return;
        var res = await LinkDropApi.ApprovePurchaseAsync(targetPurchase.PurchaseId, approveNotes);
        if (res.IsSuccess)
        {
            Toast.Success($"Purchase #{targetPurchase.PurchaseNumber} approved successfully.");
            showApproveModal = false;
            await RefreshAllAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve purchase.");
        }
    }

    private async Task ConfirmRejectAsync()
    {
        if (targetPurchase == null) return;
        if (string.IsNullOrWhiteSpace(rejectReason))
        {
            Toast.Error("Please enter a reason for rejection.");
            return;
        }

        var res = await LinkDropApi.RejectPurchaseAsync(targetPurchase.PurchaseId, rejectReason);
        if (res.IsSuccess)
        {
            Toast.Success($"Purchase #{targetPurchase.PurchaseNumber} rejected.");
            showRejectModal = false;
            await RefreshAllAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject purchase.");
        }
    }

    private async Task CreatePackageAsync()
    {
        if (string.IsNullOrWhiteSpace(newPkgName)) return;
        var request = new CreatePackageRequestDto
        {
            PackageName = newPkgName,
            LinkDropAmount = newPkgDrops,
            BonusAmount = newPkgBonus,
            RealMoneyAmount = newPkgPrice,
            Currency = "MMK"
        };
        var res = await LinkDropApi.CreatePackageAsync(request);
        if (res.IsSuccess)
        {
            Toast.Success("Package created successfully.");
            newPkgName = string.Empty;
            await LoadPackagesAsync();
        }
    }

    private void OpenEditPackageModal(LinkDropPackageDto pkg)
    {
        editPackage = new LinkDropPackageDto
        {
            PackageId = pkg.PackageId,
            PackageName = pkg.PackageName,
            Description = pkg.Description,
            LinkDropAmount = pkg.LinkDropAmount,
            BonusAmount = pkg.BonusAmount,
            RealMoneyAmount = pkg.RealMoneyAmount,
            Currency = pkg.Currency,
            DisplayOrder = pkg.DisplayOrder,
            IsActive = pkg.IsActive
        };
        showEditPackageModal = true;
    }

    private async Task SavePackageAsync()
    {
        if (editPackage == null) return;
        var res = await LinkDropApi.UpdatePackageAsync(editPackage.PackageId, new UpdatePackageRequestDto
        {
            PackageName = editPackage.PackageName,
            Description = editPackage.Description,
            LinkDropAmount = editPackage.LinkDropAmount,
            BonusAmount = editPackage.BonusAmount,
            RealMoneyAmount = editPackage.RealMoneyAmount,
            Currency = editPackage.Currency,
            DisplayOrder = editPackage.DisplayOrder,
            IsActive = editPackage.IsActive
        });
        if (res.IsSuccess)
        {
            Toast.Success("Package updated successfully.");
            showEditPackageModal = false;
            await LoadPackagesAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update package.");
        }
    }

    private async Task TogglePackageStatusAsync(int packageId)
    {
        var res = await LinkDropApi.TogglePackageStatusAsync(packageId);
        if (res.IsSuccess)
        {
            Toast.Success("Package status updated.");
            await LoadPackagesAsync();
        }
    }

    private async Task OnNewQrFileSelected(InputFileChangeEventArgs e)
    {
        newQrFile = e.File;
        if (newQrFile != null)
        {
            using var stream = newQrFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            newQrPreviewUrl = $"data:{newQrFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
    }

    private async Task OnNewLogoFileSelected(InputFileChangeEventArgs e)
    {
        newLogoFile = e.File;
        if (newLogoFile != null)
        {
            using var stream = newLogoFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            newLogoPreviewUrl = $"data:{newLogoFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
    }

    private async Task OnEditQrFileSelected(InputFileChangeEventArgs e)
    {
        editQrFile = e.File;
        if (editQrFile != null)
        {
            using var stream = editQrFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            editQrPreviewUrl = $"data:{editQrFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
    }

    private async Task OnEditLogoFileSelected(InputFileChangeEventArgs e)
    {
        editLogoFile = e.File;
        if (editLogoFile != null)
        {
            using var stream = editLogoFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            editLogoPreviewUrl = $"data:{editLogoFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
    }

    private async Task CreatePaymentMethodAsync()
    {
        if (string.IsNullOrWhiteSpace(newMethodName)) return;
        var request = new CreatePaymentMethodRequestDto
        {
            MethodName = newMethodName,
            AccountName = newAccountName,
            AccountNumber = newAccountNumber,
            Instructions = string.IsNullOrWhiteSpace(newInstructions) ? null : newInstructions.Trim()
        };
        var res = await LinkDropApi.CreatePaymentMethodAsync(request, newQrFile, newLogoFile);
        if (res.IsSuccess)
        {
            Toast.Success("Payment method created successfully.");
            newMethodName = string.Empty;
            newAccountName = string.Empty;
            newAccountNumber = string.Empty;
            newInstructions = string.Empty;
            newQrFile = null;
            newQrPreviewUrl = null;
            newLogoFile = null;
            newLogoPreviewUrl = null;
            await LoadMethodsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create payment method.");
        }
    }

    private void OpenEditMethodModal(PaymentMethodDto m)
    {
        editMethod = new PaymentMethodDto
        {
            PaymentMethodId = m.PaymentMethodId,
            MethodName = m.MethodName,
            AccountName = m.AccountName,
            AccountNumber = m.AccountNumber,
            QrCodeImageUrl = m.QrCodeImageUrl,
            PaymentLogoUrl = m.PaymentLogoUrl,
            Instructions = m.Instructions,
            DisplayOrder = m.DisplayOrder,
            IsActive = m.IsActive
        };
        editQrFile = null;
        editQrPreviewUrl = null;
        editLogoFile = null;
        editLogoPreviewUrl = null;
        showEditMethodModal = true;
    }

    private async Task SaveMethodAsync()
    {
        if (editMethod == null) return;
        var res = await LinkDropApi.UpdatePaymentMethodAsync(editMethod.PaymentMethodId, new UpdatePaymentMethodRequestDto
        {
            MethodName = editMethod.MethodName,
            AccountName = editMethod.AccountName,
            AccountNumber = editMethod.AccountNumber,
            QrCodeImageUrl = string.IsNullOrWhiteSpace(editMethod.QrCodeImageUrl) ? null : editMethod.QrCodeImageUrl.Trim(),
            PaymentLogoUrl = string.IsNullOrWhiteSpace(editMethod.PaymentLogoUrl) ? null : editMethod.PaymentLogoUrl.Trim(),
            Instructions = string.IsNullOrWhiteSpace(editMethod.Instructions) ? null : editMethod.Instructions.Trim(),
            DisplayOrder = editMethod.DisplayOrder,
            IsActive = editMethod.IsActive
        }, editQrFile, editLogoFile);
        if (res.IsSuccess)
        {
            Toast.Success("Payment channel updated successfully.");
            showEditMethodModal = false;
            editQrFile = null;
            editQrPreviewUrl = null;
            editLogoFile = null;
            editLogoPreviewUrl = null;
            await LoadMethodsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update channel.");
        }
    }

    private async Task TogglePaymentMethodStatusAsync(int methodId)
    {
        var res = await LinkDropApi.TogglePaymentMethodStatusAsync(methodId);
        if (res.IsSuccess)
        {
            Toast.Success("Payment method status updated.");
            await LoadMethodsAsync();
        }
    }
}
