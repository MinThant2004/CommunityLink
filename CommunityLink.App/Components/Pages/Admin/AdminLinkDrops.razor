@page "/admin/linkdrops"
@page "/admin/link-drops"
@attribute [Authorize]
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject IConfiguration Configuration

<PageTitle>Link Drops Verification - Admin Portal</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Compact Admin Header Card -->
    <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xs">
        <div>
            <div class="flex items-center gap-2 text-[#0A1B2E] dark:text-[#E1E8F0] font-mono font-bold text-[10px] uppercase tracking-wider mb-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
                <span>Administrative Portal</span>
            </div>
            <h1 class="text-xl md:text-2xl font-bold text-[#0F172A] dark:text-[#E1E2EC] tracking-tight" style="font-family:'Plus Jakarta Sans',sans-serif">Link Drops Review &amp; Catalog</h1>
            <p class="text-[#475569] dark:text-[#94A3B8] text-xs mt-0.5">Review pending user payment receipts, approve token wallet allocations, and manage purchase packages.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] font-mono font-bold px-3 py-1.5 rounded-full text-xs border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)]">
                @pendingList.Count Pending Review
            </span>
            <button @onclick="RefreshAllAsync" class="bg-white dark:bg-[#191B23] hover:bg-slate-100 dark:hover:bg-[#1D263B] text-[#475569] dark:text-[#94A3B8] p-2 rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] transition cursor-pointer" title="Refresh">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] space-x-2 overflow-x-auto">
        <button @onclick='() => activeTab = "pending"'
                class="@(activeTab == "pending" ? "border-[#0A1B2E] dark:border-[#E1E8F0] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold" : "border-transparent text-[#475569] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] font-medium") py-3 px-5 text-xs border-b-2 transition flex items-center gap-2 shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <span>Pending Queue (@pendingList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "packages"'
                class="@(activeTab == "packages" ? "border-[#0A1B2E] dark:border-[#E1E8F0] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold" : "border-transparent text-[#475569] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] font-medium") py-3 px-5 text-xs border-b-2 transition flex items-center gap-2 shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>
            <span>Packages Catalog (@packagesList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "methods"'
                class="@(activeTab == "methods" ? "border-[#0A1B2E] dark:border-[#E1E8F0] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold" : "border-transparent text-[#475569] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] font-medium") py-3 px-5 text-xs border-b-2 transition flex items-center gap-2 shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z"/></svg>
            <span>Payment Methods (@methodsList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "rates"'
                class="@(activeTab == "rates" ? "border-[#0A1B2E] dark:border-[#E1E8F0] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold" : "border-transparent text-[#475569] dark:text-[#94A3B8] hover:text-[#0A1B2E] dark:hover:text-[#E1E2EC] font-medium") py-3 px-5 text-xs border-b-2 transition flex items-center gap-2 shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <span>Exchange Rates &amp; Currencies</span>
        </button>
    </div>

    <!-- TAB 1: PENDING QUEUE -->
    @if (activeTab == "pending")
    {
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg overflow-hidden shadow-xs">
            <div class="p-5 border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] flex items-center justify-between">
                <h2 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Pending Payment Verification Requests</h2>
            </div>

            @if (isLoadingPending)
            {
                <div class="p-12 text-center text-xs text-[#64748B] dark:text-[#94A3B8]">Loading pending verification queue...</div>
            }
            else if (!pendingList.Any())
            {
                <div class="p-12 text-center text-emerald-600 dark:text-[#34D399] font-semibold text-xs flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    <span>All purchase requests have been reviewed!</span>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                        <thead class="bg-[#F8FAFC] dark:bg-[#191B23] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                            <tr>
                                <th class="py-3 px-4">Purchase #</th>
                                <th class="py-3 px-4">Buyer</th>
                                <th class="py-3 px-4">Package / Type</th>
                                <th class="py-3 px-4">Real Money</th>
                                <th class="py-3 px-4">Drops Granted</th>
                                <th class="py-3 px-4">Channel & Ref No.</th>
                                <th class="py-3 px-4">Proof Receipt</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                            @foreach (var p in pendingList)
                            {
                                <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                    <td class="py-3.5 px-4 font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@p.PurchaseNumber</td>
                                    <td class="py-3.5 px-4 font-semibold text-[#0F172A] dark:text-[#E1E2EC]">@p.UserName</td>
                                    <td class="py-3.5 px-4 text-[#475569] dark:text-[#94A3B8]">@(p.PackageName ?? "Custom Purchase")</td>
                                    <td class="py-3.5 px-4 font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">@p.SnapshotRealMoneyAmount.ToString("N0") @p.SnapshotCurrency</td>
                                    <td class="py-3.5 px-4 font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-1.5">
                                        <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                        <span>@p.SnapshotLinkDropAmount.ToString("N0")</span>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(p.PaymentMethodLogoUrl))
                                            {
                                                <img src="@BuildFileUrl(p.PaymentMethodLogoUrl)" alt="@p.PaymentMethodName" class="w-6 h-6 object-contain rounded bg-white border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] p-0.5 shrink-0" />
                                            }
                                            <div>
                                                <div class="font-medium text-[#0F172A] dark:text-[#E1E2EC]">@p.PaymentMethodName</div>
                                                <div class="font-mono text-[11px] text-[#64748B] dark:text-[#94A3B8]">Ref: @p.TransactionReferenceNo</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        @if (p.Proof != null && !string.IsNullOrWhiteSpace(p.Proof.FileUrl))
                                        {
                                            <button @onclick="() => OpenProofModal(p.Proof.FileUrl)"
                                                    class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline flex items-center gap-1 font-semibold cursor-pointer">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
                                                <span>View Receipt</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-[#64748B] dark:text-[#94A3B8]">No image</span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-2">
                                            <button @onclick="() => OpenApproveModal(p)"
                                                    class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-2.5 py-1.5 rounded transition cursor-pointer">
                                                Approve
                                            </button>
                                            <button @onclick="() => OpenRejectModal(p)"
                                                    class="bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold px-2.5 py-1.5 rounded transition cursor-pointer">
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- TAB 2: PACKAGES CATALOG -->
    @if (activeTab == "packages")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-5 space-y-4 shadow-xs">
                <h2 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Create New Package</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Package Name</label>
                        <input type="text" @bind="newPkgName" placeholder="e.g. 100 Link Drops" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Link Drops Amount</label>
                        <input type="number" @bind="newPkgDrops" placeholder="e.g. 100" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs font-mono focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Bonus Drops</label>
                        <input type="number" @bind="newPkgBonus" placeholder="e.g. 0" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs font-mono focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Price (MMK)</label>
                        <input type="number" step="100" @bind="newPkgPrice" placeholder="e.g. 1000" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs font-mono focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                </div>
                <div class="flex justify-end">
                    <button @onclick="CreatePackageAsync" class="bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#E1E8F0] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-bold px-4 py-2 rounded transition cursor-pointer shadow-xs active:scale-[0.98]">
                        + Add Package
                    </button>
                </div>
            </div>

            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg overflow-hidden shadow-xs">
                <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                    <thead class="bg-[#F8FAFC] dark:bg-[#191B23] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <tr>
                            <th class="py-3 px-4">Package</th>
                            <th class="py-3 px-4">Drops</th>
                            <th class="py-3 px-4">Bonus</th>
                            <th class="py-3 px-4">Price</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4 text-center">Edit</th>
                            <th class="py-3 px-4 text-center">Status Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                        @foreach (var pkg in packagesList)
                        {
                            <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                <td class="py-3.5 px-4 font-bold text-[#0F172A] dark:text-[#E1E2EC]">@pkg.PackageName</td>
                                <td class="py-3.5 px-4 font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-1.5">
                                    <LinkDropIcon Class="w-3.5 h-3.5 shrink-0" />
                                    <span>@pkg.LinkDropAmount.ToString("N0")</span>
                                </td>
                                <td class="py-3.5 px-4 font-mono font-semibold text-emerald-600 dark:text-[#34D399]">+@pkg.BonusAmount.ToString("N0")</td>
                                <td class="py-3.5 px-4 font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">@pkg.RealMoneyAmount.ToString("N0") @pkg.Currency</td>
                                <td class="py-3.5 px-4">
                                    <span class="@(pkg.IsActive ? "text-emerald-700 dark:text-[#34D399] bg-emerald-500/10 border-emerald-500/20" : "text-[#64748B] dark:text-[#94A3B8] bg-slate-100 dark:bg-[#191B23] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.08)]") text-[11px] font-semibold px-2 py-0.5 rounded-full border">
                                        @(pkg.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <button @onclick="() => OpenEditPackageModal(pkg)"
                                            class="px-2.5 py-1 text-xs font-semibold text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-500/10 rounded border border-sky-200 dark:border-sky-500/30 transition cursor-pointer">
                                        Edit
                                    </button>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (pkg.IsActive)
                                    {
                                        <button @onclick="() => TogglePackageStatusAsync(pkg.PackageId)"
                                                class="px-2.5 py-1 text-xs font-semibold text-rose-600 dark:text-[#FFB4AB] hover:bg-rose-50 dark:hover:bg-rose-500/10 rounded border border-rose-200 dark:border-rose-500/30 transition cursor-pointer">
                                            Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => TogglePackageStatusAsync(pkg.PackageId)"
                                                class="px-2.5 py-1 text-xs font-semibold text-emerald-600 dark:text-[#34D399] hover:bg-emerald-50 dark:hover:bg-emerald-500/10 rounded border border-emerald-200 dark:border-emerald-500/30 transition cursor-pointer">
                                            Enable
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 3: PAYMENT METHODS -->
    @if (activeTab == "methods")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-5 space-y-4 shadow-xs">
                <h2 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Add New Payment Channel</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Channel Name</label>
                        <input type="text" @bind="newMethodName" placeholder="e.g. KBZ Pay, AYA Pay" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Account Holder Name</label>
                        <input type="text" @bind="newAccountName" placeholder="Account Holder Name" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    <div class="space-y-1 md:col-span-2">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Account / Phone Number</label>
                        <input type="text" @bind="newAccountNumber" placeholder="Account or Phone Number" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs font-mono focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
                    </div>
                    
                    <!-- Image Upload: Payment Type Logo -->
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Payment Type Logo</label>
                        <div class="flex items-center gap-3">
                            <InputFile OnChange="OnNewLogoFileSelected" accept=".jpg,.jpeg,.png,.webp,.svg"
                                       class="w-full text-xs text-[#64748B] dark:text-[#94A3B8] file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-slate-100 dark:file:bg-[#191B23] file:text-[#0F172A] dark:file:text-[#E1E2EC] hover:file:bg-slate-200 cursor-pointer" />
                            @if (!string.IsNullOrWhiteSpace(newLogoPreviewUrl))
                            {
                                <img src="@newLogoPreviewUrl" alt="Logo preview" class="w-8 h-8 object-contain rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] p-0.5 bg-white shrink-0" />
                            }
                        </div>
                    </div>

                    <!-- Image Upload: QR Code Image -->
                    <div class="space-y-1 md:col-span-2">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">QR Code Image</label>
                        <div class="flex items-center gap-3">
                            <InputFile OnChange="OnNewQrFileSelected" accept=".jpg,.jpeg,.png,.webp"
                                       class="w-full text-xs text-[#64748B] dark:text-[#94A3B8] file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-slate-100 dark:file:bg-[#191B23] file:text-[#0F172A] dark:file:text-[#E1E2EC] hover:file:bg-slate-200 cursor-pointer" />
                            @if (!string.IsNullOrWhiteSpace(newQrPreviewUrl))
                            {
                                <img src="@newQrPreviewUrl" alt="QR code preview" class="w-10 h-10 object-contain rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] p-0.5 bg-white shrink-0" />
                            }
                        </div>
                    </div>

                    <div class="space-y-1 md:col-span-2">
                        <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Transfer Instructions (Optional)</label>
                        <textarea @bind="newInstructions" rows="2" placeholder="Payment instructions shown to buyers" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors"></textarea>
                    </div>
                </div>
                <div class="flex justify-end">
                    <button @onclick="CreatePaymentMethodAsync" class="bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#E1E8F0] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-bold px-4 py-2 rounded transition cursor-pointer shadow-xs active:scale-[0.98]">
                        + Add Channel
                    </button>
                </div>
            </div>

            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg overflow-hidden shadow-xs">
                <table class="w-full text-left text-xs text-[#0F172A] dark:text-[#E1E2EC] border-collapse">
                    <thead class="bg-[#F8FAFC] dark:bg-[#191B23] text-[10px] uppercase font-bold text-[#64748B] tracking-[0.06em] font-mono border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <tr>
                            <th class="py-3 px-4">Channel & Logo</th>
                            <th class="py-3 px-4">QR Code</th>
                            <th class="py-3 px-4">Account Holder</th>
                            <th class="py-3 px-4">Account Number</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4 text-center">Edit</th>
                            <th class="py-3 px-4 text-center">Status Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(255,255,255,0.08)]">
                        @foreach (var m in methodsList)
                        {
                            <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1D263B]/60 transition-colors duration-150">
                                <td class="py-3.5 px-4 font-bold text-[#0F172A] dark:text-[#E1E2EC]">
                                    <div class="flex items-center gap-2.5">
                                        @if (!string.IsNullOrWhiteSpace(m.PaymentLogoUrl))
                                        {
                                            <img src="@BuildFileUrl(m.PaymentLogoUrl)" alt="@m.MethodName" class="w-7 h-7 object-contain rounded bg-white border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] p-0.5 shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-7 h-7 rounded bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] font-mono font-bold flex items-center justify-center text-[10px] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] shrink-0">
                                                @(string.IsNullOrWhiteSpace(m.MethodName) ? "PAY" : m.MethodName.Substring(0, Math.Min(2, m.MethodName.Length)).ToUpper())
                                            </div>
                                        }
                                        <span>@m.MethodName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrWhiteSpace(m.QrCodeImageUrl))
                                    {
                                        <button type="button" @onclick="() => OpenProofModal(m.QrCodeImageUrl)" class="inline-flex items-center gap-1.5 text-xs text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold hover:underline cursor-pointer">
                                            <img src="@BuildFileUrl(m.QrCodeImageUrl)" alt="QR" class="w-5 h-5 object-contain rounded border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white p-0.5" />
                                            <span>View QR</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-[#64748B] dark:text-[#94A3B8]">None</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-[#475569] dark:text-[#E1E2EC]">@m.AccountName</td>
                                <td class="py-3.5 px-4 font-mono font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@m.AccountNumber</td>
                                <td class="py-3.5 px-4">
                                    <span class="@(m.IsActive ? "text-emerald-700 dark:text-[#34D399] bg-emerald-500/10 border-emerald-500/20" : "text-[#64748B] dark:text-[#94A3B8] bg-slate-100 dark:bg-[#191B23] border-[#CBD5E1] dark:border-[rgba(255,255,255,0.08)]") text-[11px] font-semibold px-2 py-0.5 rounded-full border">
                                        @(m.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <button @onclick="() => OpenEditMethodModal(m)"
                                            class="px-2.5 py-1 text-xs font-semibold text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-500/10 rounded border border-sky-200 dark:border-sky-500/30 transition cursor-pointer">
                                        Edit
                                    </button>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (m.IsActive)
                                    {
                                        <button @onclick="() => TogglePaymentMethodStatusAsync(m.PaymentMethodId)"
                                                class="px-2.5 py-1 text-xs font-semibold text-rose-600 dark:text-[#FFB4AB] hover:bg-rose-50 dark:hover:bg-rose-500/10 rounded border border-rose-200 dark:border-rose-500/30 transition cursor-pointer">
                                            Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => TogglePaymentMethodStatusAsync(m.PaymentMethodId)"
                                                class="px-2.5 py-1 text-xs font-semibold text-emerald-600 dark:text-[#34D399] hover:bg-emerald-50 dark:hover:bg-emerald-500/10 rounded border border-emerald-200 dark:border-emerald-500/30 transition cursor-pointer">
                                            Enable
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 4: EXCHANGE RATES & CURRENCIES -->
    @if (activeTab == "rates")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] rounded-lg p-6 space-y-6 shadow-xs">
                <div>
                    <h2 class="text-base font-bold text-[#0F172A] dark:text-[#E1E2EC] flex items-center gap-2" style="font-family:'Plus Jakarta Sans',sans-serif">
                        <svg class="w-4 h-4 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        <span>Link Drop Exchange Rate Settings</span>
                    </h2>
                    <p class="text-[#475569] dark:text-[#94A3B8] text-xs mt-1">
                        Configure the exact conversion pricing for 1 Link Drop across supported currencies. When buyers purchase tokens or choose their currency in the wallet, prices calculate automatically using these live rates.
                    </p>
                </div>

                @if (isLoadingRates)
                {
                    <div class="py-8 text-center text-xs text-[#64748B] dark:text-[#94A3B8]">Loading exchange rates...</div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <!-- MMK Card (Primary) -->
                        <div class="p-5 rounded-lg border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] bg-[#0A1B2E]/5 dark:bg-[#112A46]/50 space-y-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-[#0A1B2E]/10 text-[#0A1B2E] dark:bg-[#112A46] dark:text-[#E1E8F0] border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)]">Primary Currency</span>
                                <span class="text-base font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">MMK (Ks)</span>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">1 Link Drop = (MMK)</label>
                                <div class="relative">
                                    <input type="number" step="0.01" min="0.01" @bind="rateMmk" class="w-full bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-2 text-[#0F172A] dark:text-[#E1E2EC] text-sm font-mono font-bold focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition-colors" />
                                    <span class="absolute right-3 top-2 text-xs text-[#64748B] dark:text-[#94A3B8] font-mono font-bold">MMK</span>
                                </div>
                            </div>
                            <div class="text-xs text-[#64748B] dark:text-[#94A3B8] font-mono text-[11px]">
                                Example: 100 Link Drops = <strong class="text-[#0F172A] dark:text-[#E1E2EC]">@((100 * rateMmk).ToString("N0")) MMK</strong>
                            </div>
                        </div>

                        <!-- USD Card -->
                        <div class="p-5 rounded-lg border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-[#F8FAFC]/70 dark:bg-[#191B23]/50 space-y-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:border-[rgba(196,210,225,0.30)]">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-slate-100 dark:bg-[#111622] text-[#475569] dark:text-[#94A3B8] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.08)]">International</span>
                                <span class="text-base font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">USD ($)</span>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">1 Link Drop = (USD)</label>
                                <div class="relative">
                                    <input type="number" step="0.0001" min="0.00001" @bind="rateUsd" class="w-full bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-2 text-[#0F172A] dark:text-[#E1E2EC] text-sm font-mono font-bold focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition-colors" />
                                    <span class="absolute right-3 top-2 text-xs text-[#64748B] dark:text-[#94A3B8] font-mono font-bold">USD</span>
                                </div>
                            </div>
                            <div class="text-xs text-[#64748B] dark:text-[#94A3B8] font-mono text-[11px]">
                                Example: 1,000 Link Drops = <strong class="text-[#0F172A] dark:text-[#E1E2EC]">$@((1000 * rateUsd).ToString("N2")) USD</strong>
                            </div>
                        </div>

                        <!-- CNY Card -->
                        <div class="p-5 rounded-lg border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-[#F8FAFC]/70 dark:bg-[#191B23]/50 space-y-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-[#0A1B2E]/40 dark:hover:border-[rgba(196,210,225,0.30)]">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono font-bold tracking-wider uppercase px-2 py-0.5 rounded-full bg-slate-100 dark:bg-[#111622] text-[#475569] dark:text-[#94A3B8] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.08)]">Regional</span>
                                <span class="text-base font-mono font-bold text-[#0F172A] dark:text-[#E1E2EC]">CNY (¥)</span>
                            </div>
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">1 Link Drop = (CNY)</label>
                                <div class="relative">
                                    <input type="number" step="0.0001" min="0.00001" @bind="rateCny" class="w-full bg-white dark:bg-[#111622] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-2 text-[#0F172A] dark:text-[#E1E2EC] text-sm font-mono font-bold focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] transition-colors" />
                                    <span class="absolute right-3 top-2 text-xs text-[#64748B] dark:text-[#94A3B8] font-mono font-bold">CNY</span>
                                </div>
                            </div>
                            <div class="text-xs text-[#64748B] dark:text-[#94A3B8] font-mono text-[11px]">
                                Example: 1,000 Link Drops = <strong class="text-[#0F172A] dark:text-[#E1E2EC]">¥@((1000 * rateCny).ToString("N2")) CNY</strong>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                        <div class="text-xs text-[#64748B] dark:text-[#94A3B8]">
                            Rates update instantly across the entire platform upon saving.
                        </div>
                        <button @onclick="SaveExchangeRatesAsync" disabled="@isSavingRates" class="w-full sm:w-auto bg-[#0F172A] hover:bg-[#1E293B] dark:bg-[#E1E8F0] dark:hover:bg-white disabled:opacity-50 text-white dark:text-[#0A1B2E] font-bold text-xs px-6 py-2.5 rounded transition shadow-xs flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]">
                            @if (isSavingRates)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                                <span>Save Exchange Rates</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- Approve Confirmation Modal -->
@if (showApproveModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#0A0D14]/80 backdrop-blur-md">
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.12)] rounded-xl max-w-md w-full p-6 space-y-4 shadow-xl">
            <h3 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Approve Purchase Request #@targetPurchase?.PurchaseNumber</h3>
            <p class="text-xs text-[#475569] dark:text-[#94A3B8]">
                This will credit <strong class="text-[#0A1B2E] dark:text-[#E1E8F0] font-mono font-bold">@targetPurchase?.SnapshotLinkDropAmount.ToString("N0") Drops</strong> to user <strong class="text-[#0F172A] dark:text-[#E1E2EC]">@targetPurchase?.UserName</strong>.
            </p>
            <input type="text" @bind="approveNotes" placeholder="Optional audit notes..." class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-2 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
            <div class="flex justify-end gap-2.5 pt-2">
                <button @onclick="() => showApproveModal = false" class="px-3.5 py-1.5 text-xs text-[#475569] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] transition cursor-pointer">Cancel</button>
                <button @onclick="ConfirmApproveAsync" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded shadow-xs transition cursor-pointer">Confirm & Credit Wallet</button>
            </div>
        </div>
    </div>
}

<!-- Reject Confirmation Modal -->
@if (showRejectModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#0A0D14]/80 backdrop-blur-md">
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.12)] rounded-xl max-w-md w-full p-6 space-y-4 shadow-xl">
            <h3 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Reject Purchase Request #@targetPurchase?.PurchaseNumber</h3>
            <p class="text-xs text-[#475569] dark:text-[#94A3B8]">Enter the reason for rejection (visible to buyer):</p>
            <input type="text" @bind="rejectReason" placeholder="Reason (e.g. Unverified ref number, invalid slip photo)" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-2 text-[#0F172A] dark:text-[#E1E2EC] text-xs focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
            <div class="flex justify-end gap-2.5 pt-2">
                <button @onclick="() => showRejectModal = false" class="px-3.5 py-1.5 text-xs text-[#475569] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] transition cursor-pointer">Cancel</button>
                <button @onclick="ConfirmRejectAsync" class="px-4 py-1.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded shadow-xs transition cursor-pointer">Confirm Rejection</button>
            </div>
        </div>
    </div>
}

<!-- Proof Image Viewer Modal -->
@if (showProofModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#0A0D14]/80 backdrop-blur-md">
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.12)] rounded-xl max-w-2xl w-full p-5 space-y-4 shadow-xl relative">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-3">
                <h3 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Payment Receipt Proof</h3>
                <button @onclick="() => showProofModal = false" class="text-[#64748B] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] transition cursor-pointer p-1">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="max-h-[70vh] overflow-y-auto flex justify-center bg-[#F8FAFC] dark:bg-[#191B23] rounded p-2 border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)]">
                <img src="@previewProofUrl" alt="Receipt proof" class="max-w-full h-auto rounded object-contain" />
            </div>
        </div>
    </div>
}

<!-- Edit Package Modal -->
@if (showEditPackageModal && editPackage != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 dark:bg-[#0A0D14]/80 backdrop-blur-md">
        <div class="bg-white dark:bg-[#111622] border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.12)] rounded-xl max-w-lg w-full p-6 space-y-4 shadow-xl">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] pb-3">
                <h3 class="text-sm font-bold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">Edit Package</h3>
                <button @onclick="() => showEditPackageModal = false" class="text-[#64748B] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] transition cursor-pointer p-1">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="space-y-3">
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-[#475569] dark:text-[#94A3B8]">Package Name</label>
