                <label class="flex items-center gap-2 text-xs text-[#475569] dark:text-[#94A3B8] cursor-pointer">
                    <input type="checkbox" @bind="editPackage.IsActive" class="accent-[#0A1B2E] dark:accent-[#E1E8F0]" />
                    <span>Active (visible for purchase)</span>
