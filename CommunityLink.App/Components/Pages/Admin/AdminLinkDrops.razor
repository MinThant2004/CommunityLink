@page "/admin/linkdrops"
@page "/admin/link-drops"
@attribute [Authorize]
@inject LinkDropApiService LinkDropApi
@inject ToastService Toast
@inject IConfiguration Configuration

<PageTitle>Link Drops Verification - Admin Portal</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Admin Header Banner -->
    <div class="bg-gradient-to-r from-amber-500/10 via-slate-50 to-indigo-500/10 dark:from-amber-950/80 dark:via-[#0A1B2E] dark:to-indigo-950/80 border border-amber-500/30 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-sm dark:shadow-xl">
        <div>
            <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-xs uppercase tracking-wider mb-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
                <span>Administrative Portal</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-[#E1E8F0] tracking-tight">Link Drops Review & Catalog</h1>
            <p class="text-slate-600 dark:text-[#C4D2E1] text-sm mt-1">Review pending user payment receipts, approve token wallet allocations, and manage purchase packages.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300 font-extrabold px-4 py-2 rounded-xl text-sm border border-amber-300 dark:border-amber-500/30">
                @pendingList.Count Pending Review
            </span>
            <button @onclick="RefreshAllAsync" class="bg-white dark:bg-[#1B3B5A] hover:bg-slate-100 dark:hover:bg-[#1B3B5A]/80 text-slate-700 dark:text-[#E1E8F0] p-2.5 rounded-xl border border-slate-200 dark:border-[rgba(196,210,225,0.12)] transition" title="Refresh">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)] space-x-2">
        <button @onclick='() => activeTab = "pending"'
                class="@(activeTab == "pending" ? "border-amber-500 text-amber-600 dark:text-amber-400 font-bold" : "border-transparent text-slate-500 hover:text-slate-800 dark:text-[#C4D2E1] dark:hover:text-[#E1E8F0] font-medium") py-3 px-5 text-sm border-b-2 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <span>Pending Queue (@pendingList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "packages"'
                class="@(activeTab == "packages" ? "border-amber-500 text-amber-600 dark:text-amber-400 font-bold" : "border-transparent text-slate-500 hover:text-slate-800 dark:text-[#C4D2E1] dark:hover:text-[#E1E8F0] font-medium") py-3 px-5 text-sm border-b-2 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>
            <span>Packages Catalog (@packagesList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "methods"'
                class="@(activeTab == "methods" ? "border-amber-500 text-amber-600 dark:text-amber-400 font-bold" : "border-transparent text-slate-500 hover:text-slate-800 dark:text-[#C4D2E1] dark:hover:text-[#E1E8F0] font-medium") py-3 px-5 text-sm border-b-2 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z"/></svg>
            <span>Payment Methods (@methodsList.Count)</span>
        </button>
        <button @onclick='() => activeTab = "rates"'
                class="@(activeTab == "rates" ? "border-amber-500 text-amber-600 dark:text-amber-400 font-bold" : "border-transparent text-slate-500 hover:text-slate-800 dark:text-[#C4D2E1] dark:hover:text-[#E1E8F0] font-medium") py-3 px-5 text-sm border-b-2 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <span>Exchange Rates & Currencies</span>
        </button>
    </div>

    <!-- TAB 1: PENDING QUEUE -->
    @if (activeTab == "pending")
    {
        <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl overflow-hidden shadow-sm dark:shadow-xl">
            <div class="p-6 border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between">
                <h2 class="text-lg font-bold text-slate-900 dark:text-[#E1E8F0]">Pending Payment Verification Requests</h2>
            </div>

            @if (isLoadingPending)
            {
                <div class="p-12 text-center text-slate-500 dark:text-[#C4D2E1]">Loading pending verification queue...</div>
            }
            else if (!pendingList.Any())
            {
                <div class="p-12 text-center text-emerald-600 dark:text-emerald-400 font-semibold flex items-center justify-center gap-2">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    <span>All purchase requests have been reviewed!</span>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-700 dark:text-[#C4D2E1]">
                        <thead class="bg-slate-50 dark:bg-[#0A1B2E] text-xs uppercase text-slate-500 dark:text-[#C4D2E1] border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)]">
                            <tr>
                                <th class="py-3.5 px-6">Purchase #</th>
                                <th class="py-3.5 px-6">Buyer</th>
                                <th class="py-3.5 px-6">Package / Type</th>
                                <th class="py-3.5 px-6">Real Money</th>
                                <th class="py-3.5 px-6">Drops Granted</th>
                                <th class="py-3.5 px-6">Channel & Ref No.</th>
                                <th class="py-3.5 px-6">Proof Receipt</th>
                                <th class="py-3.5 px-6">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-[rgba(196,210,225,0.12)]">
                            @foreach (var p in pendingList)
                            {
                                <tr class="hover:bg-slate-50/80 dark:hover:bg-[#1B3B5A]/40 transition">
                                    <td class="py-4 px-6 font-mono font-bold text-indigo-600 dark:text-indigo-400">@p.PurchaseNumber</td>
                                    <td class="py-4 px-6 font-semibold text-slate-900 dark:text-[#E1E8F0]">@p.UserName</td>
                                    <td class="py-4 px-6 text-slate-600 dark:text-[#C4D2E1]">@(p.PackageName ?? "Custom Purchase")</td>
                                    <td class="py-4 px-6 font-bold text-slate-900 dark:text-[#E1E8F0]">@p.SnapshotRealMoneyAmount.ToString("N0") @p.SnapshotCurrency</td>
                                    <td class="py-4 px-6 font-extrabold text-amber-600 dark:text-amber-400 flex items-center gap-1.5">
                                        <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                        <span>@p.SnapshotLinkDropAmount.ToString("N0")</span>
                                    </td>
                                    <td class="py-4 px-6">
                                        <div class="font-medium text-slate-800 dark:text-[#E1E8F0]">@p.PaymentMethodName</div>
                                        <div class="font-mono text-xs text-slate-500 dark:text-[#C4D2E1]">Ref: @p.TransactionReferenceNo</div>
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (p.Proof != null && !string.IsNullOrWhiteSpace(p.Proof.FileUrl))
                                        {
                                            <button @onclick="() => OpenProofModal(p.Proof.FileUrl)"
                                                    class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 font-semibold">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
                                                <span>View Receipt</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">No image</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-2">
                                            <button @onclick="() => OpenApproveModal(p)"
                                                    class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition">
                                                Approve
                                            </button>
                                            <button @onclick="() => OpenRejectModal(p)"
                                                    class="bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition">
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- TAB 2: PACKAGES CATALOG -->
    @if (activeTab == "packages")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 space-y-4 shadow-sm">
                <h2 class="text-lg font-bold text-slate-900 dark:text-[#E1E8F0]">Create New Package</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <input type="text" @bind="newPkgName" placeholder="Package Name (e.g. 100 Link Drops)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="number" @bind="newPkgDrops" placeholder="Link Drops (e.g. 100)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="number" @bind="newPkgBonus" placeholder="Bonus Drops (e.g. 0)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="number" step="100" @bind="newPkgPrice" placeholder="Price (MMK)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                </div>
                <div class="flex justify-end">
                    <button @onclick="CreatePackageAsync" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-5 py-2 rounded-xl transition">
                        + Add Package
                    </button>
                </div>
            </div>

            <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl overflow-hidden shadow-sm">
                <table class="w-full text-left text-sm text-slate-700 dark:text-[#C4D2E1]">
                    <thead class="bg-slate-50 dark:bg-[#0A1B2E] text-xs uppercase text-slate-500 dark:text-[#C4D2E1] border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)]">
                        <tr>
                            <th class="py-3 px-6">Package</th>
                            <th class="py-3 px-6">Drops</th>
                            <th class="py-3 px-6">Bonus</th>
                            <th class="py-3 px-6">Price</th>
                            <th class="py-3 px-6">Status</th>
                            <th class="py-3 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-[rgba(196,210,225,0.12)]">
                        @foreach (var pkg in packagesList)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-[#1B3B5A]/40 transition">
                                <td class="py-4 px-6 font-bold text-slate-900 dark:text-[#E1E8F0]">@pkg.PackageName</td>
                                <td class="py-4 px-6 font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1.5">
                                    <LinkDropIcon Class="w-4 h-4 shrink-0" />
                                    <span>@pkg.LinkDropAmount.ToString("N0")</span>
                                </td>
                                <td class="py-4 px-6 text-amber-600 dark:text-amber-300">+@pkg.BonusAmount.ToString("N0")</td>
                                <td class="py-4 px-6 font-bold text-slate-900 dark:text-[#E1E8F0]">@pkg.RealMoneyAmount.ToString("N0") @pkg.Currency</td>
                                <td class="py-4 px-6">
                                    <span class="@(pkg.IsActive ? "text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/30" : "text-slate-500 dark:text-[#C4D2E1] bg-slate-100 dark:bg-[#1B3B5A] border-slate-200 dark:border-[rgba(196,210,225,0.12)]") text-xs font-bold px-2 py-0.5 rounded-md border">
                                        @(pkg.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center justify-end gap-3">
                                        <button @onclick="() => OpenEditPackageModal(pkg)" class="text-xs text-sky-600 dark:text-sky-400 hover:underline font-semibold">Edit</button>
                                        <button @onclick="() => TogglePackageStatusAsync(pkg.PackageId)" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">Toggle Status</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 3: PAYMENT METHODS -->
    @if (activeTab == "methods")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 space-y-4 shadow-sm">
                <h2 class="text-lg font-bold text-slate-900 dark:text-[#E1E8F0]">Add New Payment Channel</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="text" @bind="newMethodName" placeholder="Channel Name (e.g. KPAY)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="text" @bind="newAccountName" placeholder="Account Holder Name" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="text" @bind="newAccountNumber" placeholder="Account / Phone Number" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <input type="text" @bind="newQrUrl" placeholder="QR Code Image URL (optional)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm" />
                    <textarea @bind="newInstructions" rows="2" placeholder="Payment instructions shown to buyers (optional)" class="bg-slate-50 dark:bg-[#0A1B2E] border border-slate-300 dark:border-[rgba(196,210,225,0.12)] rounded-xl px-4 py-2 text-slate-900 dark:text-[#E1E8F0] text-sm md:col-span-2"></textarea>
                </div>
                <div class="flex justify-end">
                    <button @onclick="CreatePaymentMethodAsync" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-5 py-2 rounded-xl transition">
                        + Add Channel
                    </button>
                </div>
            </div>

            <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl overflow-hidden shadow-sm">
                <table class="w-full text-left text-sm text-slate-700 dark:text-[#C4D2E1]">
                    <thead class="bg-slate-50 dark:bg-[#0A1B2E] text-xs uppercase text-slate-500 dark:text-[#C4D2E1] border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)]">
                        <tr>
                            <th class="py-3 px-6">Channel</th>
                            <th class="py-3 px-6">Account Holder</th>
                            <th class="py-3 px-6">Account Number</th>
                            <th class="py-3 px-6">Status</th>
                            <th class="py-3 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-[rgba(196,210,225,0.12)]">
                        @foreach (var m in methodsList)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-[#1B3B5A]/40 transition">
                                <td class="py-4 px-6 font-bold text-slate-900 dark:text-[#E1E8F0]">@m.MethodName</td>
                                <td class="py-4 px-6 text-slate-700 dark:text-[#E1E8F0]">@m.AccountName</td>
                                <td class="py-4 px-6 font-mono font-bold text-amber-600 dark:text-amber-400">@m.AccountNumber</td>
                                <td class="py-4 px-6">
                                    <span class="@(m.IsActive ? "text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/30" : "text-slate-500 dark:text-[#C4D2E1] bg-slate-100 dark:bg-[#1B3B5A] border-slate-200 dark:border-[rgba(196,210,225,0.12)]") text-xs font-bold px-2 py-0.5 rounded-md border">
                                        @(m.IsActive ? "Active" : "Disabled")
                                    </span>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center justify-end gap-3">
                                        <button @onclick="() => OpenEditMethodModal(m)" class="text-xs text-sky-600 dark:text-sky-400 hover:underline font-semibold">Edit</button>
                                        <button @onclick="() => TogglePaymentMethodStatusAsync(m.PaymentMethodId)" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">Toggle Status</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 4: EXCHANGE RATES & CURRENCIES -->
    @if (activeTab == "rates")
    {
        <div class="space-y-6">
            <div class="bg-white dark:bg-[#112A46] border border-slate-200 dark:border-[rgba(196,210,225,0.12)] rounded-2xl p-6 md:p-8 space-y-6 shadow-sm">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-[#E1E8F0] flex items-center gap-2">
                        <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        <span>Link Drop Exchange Rate Settings</span>
                    </h2>
                    <p class="text-slate-600 dark:text-[#C4D2E1] text-sm mt-1">
                        Configure the exact conversion pricing for 1 Link Drop across supported currencies. When buyers purchase tokens or choose their currency in the wallet, prices calculate automatically using these live rates.
                    </p>
                </div>

                @if (isLoadingRates)
                {
                    <div class="py-8 text-center text-slate-500 dark:text-[#C4D2E1]">Loading exchange rates...</div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- MMK Card (Primary) -->
                        <div class="p-5 rounded-2xl border-2 border-amber-500/40 bg-gradient-to-b from-amber-500/10 to-transparent dark:from-amber-500/5 space-y-4">
                            <div class="flex items-center justify-between">
