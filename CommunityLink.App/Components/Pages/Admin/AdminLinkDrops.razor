                        <input type="number" @bind="editPackage.DisplayOrder" placeholder="1" class="w-full bg-[#F8FAFC] dark:bg-[#191B23] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] rounded px-3 py-1.5 text-[#0F172A] dark:text-[#E1E2EC] text-xs font-mono focus:border-[#0A1B2E] dark:focus:border-[#E1E8F0] focus:outline-none transition-colors" />
