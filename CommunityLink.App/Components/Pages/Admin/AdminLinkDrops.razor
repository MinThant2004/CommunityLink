            <div class="flex justify-end gap-2.5 pt-2">
                <button @onclick="() => showEditPackageModal = false" class="px-3.5 py-1.5 text-xs text-[#475569] dark:text-[#94A3B8] hover:text-[#0F172A] dark:hover:text-[#E1E2EC] transition cursor-pointer">Cancel</button>
                <button @onclick="SavePackageAsync" class="px-4 py-1.5 bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#E1E8F0] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-bold rounded shadow-xs transition cursor-pointer">Save Package</button>
            </div>
        </div>
    </div>
}

