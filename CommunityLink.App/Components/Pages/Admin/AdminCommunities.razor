@page "/admin/communities"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.CommunityModerate)]
@inject AdministrationApiService AdminApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast

@using AdminJoinRequestModel = CommunityLink.Shared.Features.Administration.JoinRequestModel

<PageTitle>Hub Moderation — CommunityLink Admin</PageTitle>

<div class="space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">🏛️ Community Hub Moderation</h1>
            <p class="text-sm text-[#557392] dark:text-[#C4D2E1]">Manage pending community join requests and oversee hub governance.</p>
        </div>
        <button @onclick="LoadDataAsync" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:border-[#0A1B2E] dark:hover:border-[#E1E8F0] hover:text-[#0A1B2E] dark:hover:text-white transition shadow-sm cursor-pointer">
            🔄 Refresh
        </button>
    </div>

    <!-- Pending Join Requests Queue -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between bg-[#F8FAFC] dark:bg-[#0A1B2E]">
            <div>
                <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Pending Join Requests</h2>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Review member applications waiting for administrator approval.</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50">
                @(joinRequests?.Count ?? 0) Pending
            </span>
        </div>

        @if (isLoading)
        {
            <div class="p-8 text-center text-[#557392] dark:text-[#C4D2E1]">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                <p class="mt-2 text-sm">Loading moderation queue...</p>
            </div>
        }
        else if (joinRequests == null || !joinRequests.Any())
        {
            <div class="p-8 text-center text-[#7A8CA6] dark:text-[#C4D2E1]">
                <span class="text-3xl block mb-2">🎉</span>
                <p class="text-sm font-medium">No pending join requests! Queue is empty.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#F1F5F9] dark:bg-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                            <th class="px-6 py-3">User</th>
                            <th class="px-6 py-3">Target Hub</th>
                            <th class="px-6 py-3">Requested Date</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)] text-sm">
                        @foreach (var req in joinRequests)
                        {
                            <tr class="hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/40 transition">
                                <td class="px-6 py-4">
                                    <div class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0]">@req.UserName</div>
                                    <div class="text-xs text-[#7A8CA6]">@req.UserEmail</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-semibold text-[#557392] dark:text-[#C4D2E1]">@req.CommunityName</span>
                                </td>
                                <td class="px-6 py-4 text-xs text-[#7A8CA6] font-mono">
                                    @req.CreatedAt.ToString("g")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50">
                                        @req.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm cursor-pointer">
                                        Approve
                                    </button>
                                    <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-3 py-1 rounded-full text-xs font-semibold bg-red-600 hover:bg-red-500 text-white transition shadow-sm cursor-pointer">
                                        Reject
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Active Community Directory -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden shadow-sm">
        <div class="px-6 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E]">
            <h2 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Active Communities Directory</h2>
            <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Overview of active platform hubs.</p>
        </div>
        @if (communities != null && communities.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-6">
                @foreach (var c in communities)
                {
                    <div class="p-4 rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.30)] hover:-translate-y-0.5 hover:shadow-sm transition-all">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-base" style="font-family:'Manrope',sans-serif">@c.Name</h3>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-[0.06em] bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">@c.Visibility</span>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] line-clamp-2 mb-3">@c.Description</p>
                        <div class="flex items-center justify-between text-xs text-[#7A8CA6] pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] font-mono">
                            <span>👥 @c.MemberCount members</span>
                            <span>📝 @c.PostCount posts</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<AdminJoinRequestModel>? joinRequests;
    private IReadOnlyList<CommunityModel>? communities;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        var reqRes = await AdminApi.GetPendingJoinRequestsAsync();
        if (reqRes.IsSuccess) joinRequests = reqRes.Data;

        var commRes = await CommunityApi.GetCommunitiesAsync();
        if (commRes.IsSuccess) communities = commRes.Data;

        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Join request approved successfully.");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve join request.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Join request rejected.");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject join request.");
        }
    }
}
