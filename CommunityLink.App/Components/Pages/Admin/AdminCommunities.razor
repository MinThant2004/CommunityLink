@page "/admin/communities"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.CommunityModerate)]
@inject AdministrationApiService AdminApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast

@using AdminJoinRequestModel = CommunityLink.Shared.Features.Administration.JoinRequestModel

<PageTitle>Hub Moderation — CommunityLink Admin</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">🏛️ Community Hub Moderation</h1>
            <p class="text-sm text-slate-500">Manage pending community join requests and oversee hub governance.</p>
        </div>
        <button @onclick="LoadDataAsync" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 transition shadow-sm">
            🔄 Refresh
        </button>
    </div>

    <!-- Pending Join Requests Queue -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-900">Pending Join Requests</h2>
                <p class="text-xs text-slate-500">Review member applications waiting for administrator approval.</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
                @(joinRequests?.Count ?? 0) Pending
            </span>
        </div>

        @if (isLoading)
        {
            <div class="p-8 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
                <p class="mt-2 text-sm">Loading moderation queue...</p>
            </div>
        }
        else if (joinRequests == null || !joinRequests.Any())
        {
            <div class="p-8 text-center text-slate-500">
                <span class="text-3xl d-block mb-2">🎉</span>
                <p class="text-sm font-medium">No pending join requests! Queue is empty.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="px-6 py-3">User</th>
                            <th class="px-6 py-3">Target Hub</th>
                            <th class="px-6 py-3">Requested Date</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 text-sm">
                        @foreach (var req in joinRequests)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="px-6 py-4">
                                    <div class="font-medium text-slate-900">@req.UserName</div>
                                    <div class="text-xs text-slate-400">@req.UserEmail</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-semibold text-indigo-600">@req.CommunityName</span>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500">
                                    @req.CreatedAt.ToString("g")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                        @req.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button @onclick="() => ApproveRequestAsync(req.RequestId)" class="px-3 py-1 rounded-md text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition shadow-sm">
                                        Approve
                                    </button>
                                    <button @onclick="() => RejectRequestAsync(req.RequestId)" class="px-3 py-1 rounded-md text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition shadow-sm">
                                        Reject
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Active Community Directory -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
            <h2 class="text-base font-bold text-slate-900">Active Communities Directory</h2>
            <p class="text-xs text-slate-500">Overview of active platform hubs.</p>
        </div>
        @if (communities != null && communities.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-6">
                @foreach (var c in communities)
                {
                    <div class="p-4 rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-white hover:shadow-md transition">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-bold text-slate-900 text-base">@c.Name</h3>
                            <span class="px-2 py-0.5 rounded text-xs font-semibold bg-indigo-100 text-indigo-700">@c.Visibility</span>
                        </div>
                        <p class="text-xs text-slate-600 line-clamp-2 mb-3">@c.Description</p>
                        <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-200">
                            <span>👥 @c.MemberCount members</span>
                            <span>📝 @c.PostCount posts</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private IReadOnlyList<AdminJoinRequestModel>? joinRequests;
    private IReadOnlyList<CommunityModel>? communities;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        var reqRes = await AdminApi.GetPendingJoinRequestsAsync();
        if (reqRes.IsSuccess) joinRequests = reqRes.Data;

        var commRes = await CommunityApi.GetCommunitiesAsync();
        if (commRes.IsSuccess) communities = commRes.Data;

        isLoading = false;
    }

    private async Task ApproveRequestAsync(int id)
    {
        var res = await AdminApi.ApproveJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Join request approved successfully.");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to approve join request.");
        }
    }

    private async Task RejectRequestAsync(int id)
    {
        var res = await AdminApi.RejectJoinRequestAsync(id);
        if (res.IsSuccess)
        {
            Toast.Success("Join request rejected.");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to reject join request.");
        }
    }
}
