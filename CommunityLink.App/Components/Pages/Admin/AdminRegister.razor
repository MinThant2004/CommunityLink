@page "/admin/portal-entry/register"
@layout AuthLayout
@using CommunityLink.App.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Admin Registration - CommunityLink</PageTitle>

<AuthSplitScreen IsAdmin="true" LogoText="ADM" Eyebrow="ADMINISTRATOR PROVISIONING" Title="Operator credential onboarding."
                 Subtitle="Register authorized administrative node access using a cryptographic invite code. Authorized personnel only.">
    <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-lg p-8 shadow-sm">
        <!-- Security Header -->
        <div class="mb-6 pb-6 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#BA1A1A] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    <span>RESTRICTED PROVISIONING</span>
                </span>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] px-2 py-0.5 rounded">INVITE VERIFICATION</span>
            </div>
            <h2 class="mt-3 text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Register Admin Node</h2>
            <p class="mt-1 text-xs text-[#557392] dark:text-[#C4D2E1]" style="font-family:'Inter',sans-serif">A valid administrator invite token is required to establish credentials.</p>
        </div>

        <form method="post" action="/account/admin/register" class="space-y-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@AuthClasses.ErrorAlert">
                    <span class="mt-0.5">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="space-y-1.5">
                <label for="admin-fullname" class="@AuthClasses.Label">Full name</label>
                <input id="admin-fullname" name="fullName" type="text" required autocomplete="name"
                       placeholder="Operator Name" class="@AuthClasses.InputAdmin" />
            </div>

            <div class="space-y-1.5">
                <label for="admin-email" class="@AuthClasses.Label">Admin email</label>
                <input id="admin-email" name="email" type="email" required autocomplete="email"
                       placeholder="admin@example.com" class="@AuthClasses.InputAdmin" />
            </div>

            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <label for="admin-invite" class="@AuthClasses.Label mb-0">Admin invite code</label>
                    <span class="font-mono text-[10px] text-[#BA1A1A]">TOKEN REQUIRED</span>
                </div>
                <div class="relative">
                    <input id="admin-invite" name="adminInviteCode" type="password" required
                           placeholder="••••••••" class="@AuthClasses.InputAdmin pr-12 font-mono" />
                    <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                            class="absolute inset-y-0 right-3 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle invite code visibility">
                        <EyeIcon IsVisible="false" />
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <label for="admin-password" class="@AuthClasses.Label">Password</label>
                    <div class="relative">
                        <input id="admin-password" name="password" type="password" required
                               autocomplete="new-password" placeholder="••••••••" class="@AuthClasses.InputAdmin pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="admin-confirm" class="@AuthClasses.Label">Confirm</label>
                    <div class="relative">
                        <input id="admin-confirm" name="confirmPassword" type="password" required autocomplete="new-password"
                               placeholder="••••••••" class="@AuthClasses.InputAdmin pr-10" />
                        <button type="button" onclick="togglePasswordVisibility(this)" tabindex="-1"
                                class="absolute inset-y-0 right-2.5 flex items-center text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white transition" aria-label="Toggle confirm password visibility">
                            <EyeIcon IsVisible="false" />
                        </button>
                    </div>
                </div>
            </div>

            <AntiforgeryToken />

            <button type="submit" class="@AuthClasses.PrimaryButtonAdmin mt-2">
                <span>Provision Operator Credentials</span>
                <span aria-hidden="true">&rarr;</span>
            </button>
        </form>

        <div class="mt-6 pt-5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-xs text-[#557392] dark:text-[#C4D2E1]">
            <span>Already registered?</span>
            <a href="/admin/portal-entry/login" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline transition">Sign in here &rarr;</a>
        </div>
    </div>
</AuthSplitScreen>

@code {
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        if (uri.Query.Length > 0)
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            errorMessage = query["error"];
        }
    }
}