@page "/admin/rbac"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminRbacManage)]
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast

<PageTitle>Role Permissions — CommunityLink Admin</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">🔐 Role & Permission Matrix</h1>
            <p class="text-sm text-slate-500">Manage dynamic database-driven authorization permissions per role in real time.</p>
        </div>
        @if (matrix != null)
        {
            <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition disabled:opacity-50" @onclick="SaveChanges" disabled="@isSaving">
                @(isSaving ? "Saving..." : "💾 Save Changes")
            </button>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Role Selection Sidebar -->
        <div class="space-y-2">
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wider px-1 mb-2">Select Role</h2>
            @if (roles != null)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden divide-y divide-slate-100">
                    @foreach (var r in roles)
                    {
                        <button class="w-full text-left p-4 transition flex items-center justify-between @(selectedRoleId == r.RoleId ? "bg-indigo-50/80 border-l-4 border-indigo-600" : "hover:bg-slate-50")"
                                @onclick="() => SelectRole(r.RoleId)">
                            <div>
                                <div class="font-bold text-sm @(selectedRoleId == r.RoleId ? "text-indigo-900" : "text-slate-800")">@r.Name</div>
                                <div class="text-xs text-slate-400 font-mono mt-0.5">@r.Code</div>
                            </div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                @r.UserCount users
                            </span>
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Permission Matrix Grid -->
        <div class="lg:col-span-3">
            @if (isLoading)
            {
                <div class="p-12 text-center text-slate-500 bg-white rounded-xl shadow-sm border border-slate-200">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-600 border-t-transparent"></div>
                    <p class="mt-2 text-sm font-medium">Loading permissions matrix...</p>
                </div>
            }
            else if (matrix != null)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/50 flex items-center justify-between">
                        <div class="font-bold text-slate-900 text-sm">
                            Permissions for: <span class="text-indigo-600">@matrix.RoleName (@matrix.RoleCode)</span>
                        </div>
                        <span class="text-xs text-slate-500">
                            @grantedCodes.Count of @matrix.Permissions.Count granted
                        </span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                    <th class="w-16 px-6 py-3 text-center">Grant</th>
                                    <th class="px-6 py-3">Permission Code</th>
                                    <th class="px-6 py-3">Name</th>
                                    <th class="px-6 py-3">Module</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 text-sm">
                                @foreach (var p in matrix.Permissions)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="px-6 py-4 text-center">
                                            <input type="checkbox" class="w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 cursor-pointer"
                                                   checked="@grantedCodes.Contains(p.Code)"
                                                   @onchange="(e) => TogglePermission(p.Code, (bool)(e.Value ?? false))" />
                                        </td>
                                        <td class="px-6 py-4 font-mono text-xs text-indigo-600 font-semibold">@p.Code</td>
                                        <td class="px-6 py-4 font-medium text-slate-800">@p.Name</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                                @p.Module
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<RoleModel>? roles;
    private RolePermissionMatrixResponseModel? matrix;
    private int selectedRoleId = 1;
    private HashSet<string> grantedCodes = new(StringComparer.OrdinalIgnoreCase);
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        var res = await RoleApi.GetRolesAsync();
        if (res.IsSuccess && res.Data?.Count > 0)
        {
            roles = res.Data;
            selectedRoleId = roles[0].RoleId;
            await SelectRole(selectedRoleId);
        }
    }

    private async Task SelectRole(int roleId)
    {
        selectedRoleId = roleId;
        isLoading = true;
        var res = await RoleApi.GetRolePermissionsAsync(roleId);
        if (res.IsSuccess && res.Data != null)
        {
            matrix = res.Data;
            grantedCodes = new HashSet<string>(matrix.Permissions.Where(p => p.IsGranted).Select(p => p.Code), StringComparer.OrdinalIgnoreCase);
        }
        isLoading = false;
    }

    private void TogglePermission(string code, bool grant)
    {
        if (grant) grantedCodes.Add(code);
        else grantedCodes.Remove(code);
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        var req = new UpdateRolePermissionsRequestModel(selectedRoleId, grantedCodes.ToList());
        var res = await RoleApi.UpdateRolePermissionsAsync(req);
        isSaving = false;
        if (res.IsSuccess)
        {
            Toast.Success("Permissions saved successfully!");
            await SelectRole(selectedRoleId);
        }
        else Toast.Error(res.Message ?? "Failed to save permissions.");
    }
}