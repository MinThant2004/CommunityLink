@page "/admin/rbac"
@page "/admin/roles"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.AdminRbacManage)]
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast

<PageTitle>Role Permissions — CommunityLink Admin</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">🔐 Role &amp; Permission Matrix</h1>
            <p class="text-sm text-[#557392]">Manage database-driven authorization permissions per role in real time.</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-white border border-[#CBD5E1] text-[#0A1B2E] hover:bg-[#F8FAFC] shadow-sm transition active:scale-[0.98]"
                    @onclick="OpenCreateRoleModal">
                <span>➕</span> Add New Role
            </button>
            @if (matrix != null)
            {
                if (IsSelectedRoleAdmin)
                {
                    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#E2E8F0] text-[#475569] border border-[#CBD5E1]">
                        🔒 Fixed System Permissions
                    </span>
                }
                else
                {
                    <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-[#0A1B2E] hover:bg-[#112A46] text-white shadow-sm transition disabled:opacity-50 active:scale-[0.98]"
                            @onclick="SaveChanges" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "💾 Save Changes")
                    </button>
                }
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Role Selection Sidebar -->
        <div class="space-y-2">
            <div class="flex items-center justify-between px-1 mb-2">
                <h2 class="text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">Select Role</h2>
                <span class="text-[11px] text-[#557392] font-semibold">@(roles?.Count ?? 0) Roles</span>
            </div>

            @if (roles != null)
            {
                <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.08)] shadow-sm">
                    @foreach (var r in roles)
                    {
                        var isSel = selectedRoleId == r.RoleId;
                        <div class="w-full text-left p-4 transition flex items-center justify-between group @(isSel ? "bg-[#F1F5F9] border-l-4 border-l-[#0A1B2E]" : "hover:bg-[#F8FAFC]") cursor-pointer"
                             @onclick="() => SelectRole(r.RoleId)">
                            <div class="min-w-0 pr-2">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-bold text-sm truncate @(isSel ? "text-[#0A1B2E]" : "text-[#334155]")">@r.Name</span>
                                    @if (r.IsSystemRole)
                                    {
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase tracking-wider bg-slate-200 text-slate-700 shrink-0">System</span>
                                    }
                                </div>
                                <div class="text-xs text-[#7A8CA6] font-mono mt-0.5 truncate">@r.Code</div>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-[#F1F5F9] text-[#557392] border border-[#E2E8F0]">
                                    @r.UserCount users
                                </span>
                                @if (!r.IsSystemRole && !string.Equals(r.Code, "ADMIN", StringComparison.OrdinalIgnoreCase) && !string.Equals(r.Code, "USER", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="p-1 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition"
                                            title="Delete Role"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => PromptDeleteRole(r)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Permission Matrix Grid -->
        <div class="lg:col-span-3">
            @if (isLoading)
            {
                <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                    <p class="mt-2 text-sm font-medium">Loading permissions matrix...</p>
                </div>
            }
            else if (matrix != null)
            {
                <div class="bg-white rounded-2xl border border-[#E2E8F0] overflow-hidden shadow-sm">
                    <div class="px-6 py-4 border-b border-[#E2E8F0] bg-[#F8FAFC] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-[#0A1B2E] text-sm" style="font-family:'Manrope',sans-serif">
                                Permissions for: <span class="text-[#557392]">@matrix.RoleName (@matrix.RoleCode)</span>
                            </span>
                            @if (IsSelectedRoleAdmin)
                            {
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">
                                    ★ ALL GRANTED (READ-ONLY)
                                </span>
                            }
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="text-xs text-[#7A8CA6] font-mono">
                                @(IsSelectedRoleAdmin ? matrix.Permissions.Count : grantedCodes.Count) of @matrix.Permissions.Count granted
                            </span>
                            @if (!IsSelectedRoleSystem)
                            {
                                <button class="text-xs font-semibold text-rose-600 hover:text-rose-800 flex items-center gap-1 transition"
                                        @onclick="() => PromptDeleteRole(CurrentSelectedRole)">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    Delete Role
                                </button>
                            }
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-[#F1F5F9] border-b border-[#E2E8F0] text-[10px] font-bold text-[#7A8CA6] uppercase tracking-[0.06em]" style="font-family:'JetBrains Mono',monospace">
                                    <th class="w-16 px-6 py-3 text-center">
                                        @(IsSelectedRoleAdmin ? "No." : "Grant")
                                    </th>
                                    <th class="px-6 py-3">Permission Code</th>
                                    <th class="px-6 py-3">Name</th>
                                    <th class="px-6 py-3">Module</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#E2E8F0] text-sm">
                                @for (int i = 0; i < matrix.Permissions.Count; i++)
                                {
                                    var p = matrix.Permissions[i];
                                    var rowNumber = i + 1;
                                    <tr class="hover:bg-[#F8FAFC] transition">
                                        <td class="px-6 py-4 text-center">
                                            @if (IsSelectedRoleAdmin)
                                            {
                                                <span class="font-mono text-xs font-bold text-[#64748B]">@rowNumber</span>
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="w-[18px] h-[18px] rounded cursor-pointer accent-[#0A1B2E]"
                                                       checked="@grantedCodes.Contains(p.Code)"
                                                       @onchange="(e) => TogglePermission(p.Code, (bool)(e.Value ?? false))" />
                                            }
                                        </td>
                                        <td class="px-6 py-4 font-mono text-xs text-[#557392] dark:text-[#C4D2E1] font-semibold">@p.Code</td>
                                        <td class="px-6 py-4 font-medium text-[#0A1B2E] dark:text-white">@p.Name</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                                @p.Module
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- CREATE ROLE MODAL -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm animate-fadeIn">
        <div class="bg-white rounded-2xl shadow-2xl border border-[#CBD5E1] max-w-md w-full p-6 space-y-5 text-[#0A1B2E]">
            <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🛡️</span>
                    <h3 class="font-bold text-base text-[#0A1B2E]" style="font-family:'Manrope',sans-serif">Create New Role</h3>
                </div>
                <button @onclick="CloseCreateRoleModal" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>

            @if (!showCreateConfirm)
            {
                <div class="space-y-4 text-xs">
                    <div>
                        <label class="block font-bold text-[#64748B] uppercase tracking-wider mb-1">Role Code *</label>
                        <input type="text"
                               placeholder="e.g. AUDITOR"
                               @bind="createModel.RoleCode"
                               class="w-full px-3.5 py-2 rounded-lg border border-[#CBD5E1] font-mono uppercase text-xs focus:border-[#0A1B2E] outline-none" />
                        <p class="text-[11px] text-[#7A8CA6] mt-1">Unique uppercase system code.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-[#64748B] uppercase tracking-wider mb-1">Role Name *</label>
                        <input type="text"
                               placeholder="e.g. Compliance Auditor"
                               @bind="createModel.RoleName"
                               class="w-full px-3.5 py-2 rounded-lg border border-[#CBD5E1] text-xs focus:border-[#0A1B2E] outline-none" />
                        <p class="text-[11px] text-[#7A8CA6] mt-1">Friendly display name.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-[#64748B] uppercase tracking-wider mb-1">Description *</label>
                        <textarea rows="3"
                                  placeholder="Describe the responsibilities and scope of this role..."
                                  @bind="createModel.Description"
                                  class="w-full px-3.5 py-2 rounded-lg border border-[#CBD5E1] text-xs focus:border-[#0A1B2E] outline-none resize-none"></textarea>
                    </div>

                    <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg text-blue-800 text-[11px] flex items-center gap-2">
                        <span>ℹ️</span>
                        <span>This role will automatically receive default permissions identical to standard <strong>USER</strong> role upon creation.</span>
                    </div>

                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg">
                            @createErrorMessage
                        </div>
                    }
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                    <button @onclick="CloseCreateRoleModal" class="px-4 py-2 rounded-lg text-xs font-semibold border border-[#CBD5E1] text-slate-700 hover:bg-slate-100 transition">
                        Cancel
                    </button>
                    <button @onclick="ProceedToCreateConfirm" class="px-4 py-2 rounded-lg text-xs font-semibold bg-[#0A1B2E] text-white hover:bg-[#112A46] transition">
                        Continue &gt;
                    </button>
                </div>
            }
            else
            {
                <!-- Confirmation Prompt In Middle -->
                <div class="py-4 text-center space-y-3">
                    <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-700 mx-auto flex items-center justify-center text-xl font-bold">
                        ❓
                    </div>
                    <h4 class="font-bold text-sm text-[#0A1B2E]">Are you sure you are going to add this new role?</h4>
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-left text-xs space-y-1 font-mono">
                        <div><strong>Code:</strong> @createModel.RoleCode?.Trim().ToUpperInvariant()</div>
                        <div><strong>Name:</strong> @createModel.RoleName?.Trim()</div>
                        <div class="text-[11px] text-slate-500 font-sans mt-1">@createModel.Description</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(createErrorMessage))
                {
                    <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg">
                        @createErrorMessage
                    </div>
                }

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E2E8F0]">
                    <button @onclick="() => showCreateConfirm = false" class="px-4 py-2 rounded-lg text-xs font-semibold border border-[#CBD5E1] text-slate-700 hover:bg-slate-100 transition" disabled="@isSubmittingCreate">
                        Back
                    </button>
                    <button @onclick="SubmitCreateRoleAsync" disabled="@isSubmittingCreate" class="px-5 py-2 rounded-lg text-xs font-semibold bg-[#0A1B2E] text-white hover:bg-[#112A46] transition flex items-center gap-1.5">
                        @if (isSubmittingCreate)
                        {
                            <span class="animate-spin text-xs">⌛</span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Confirm &amp; Create</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL (Centered in Middle) -->
@if (showDeleteModal && roleToDelete != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#0A1B2E]/60 backdrop-blur-sm animate-fadeIn">
        <div class="bg-white rounded-2xl shadow-2xl border border-rose-200 max-w-md w-full p-6 space-y-4 text-center text-[#0A1B2E]">
            <div class="w-14 h-14 rounded-full bg-rose-100 text-rose-600 mx-auto flex items-center justify-center text-2xl font-bold">
                ⚠️
            </div>

            <div class="space-y-1">
                <h3 class="font-bold text-base text-[#0A1B2E]">Are you sure you are going to delete this role?</h3>
                <p class="text-xs text-[#557392]">
                    Role to remove: <strong class="text-[#0A1B2E]">@roleToDelete.Name (@roleToDelete.Code)</strong>
                </p>
            </div>

            <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-900 text-left text-xs leading-relaxed">
                <strong>Notice:</strong> Any user currently assigned to this role will automatically turn into the default <strong>'USER'</strong> role.
            </div>

            @if (!string.IsNullOrEmpty(deleteErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg text-left">
                    @deleteErrorMessage
                </div>
            }

            <div class="flex items-center justify-center gap-3 pt-2">
                <button @onclick="CloseDeleteModal" class="px-4 py-2 rounded-lg text-xs font-semibold border border-[#CBD5E1] text-slate-700 hover:bg-slate-100 transition" disabled="@isSubmittingDelete">
                    Cancel
                </button>
                <button @onclick="ConfirmDeleteRoleAsync" disabled="@isSubmittingDelete" class="px-5 py-2 rounded-lg text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 transition flex items-center gap-1.5">
                    @if (isSubmittingDelete)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Yes, Delete Role</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<RoleModel>? roles;
    private RolePermissionMatrixResponseModel? matrix;
    private int selectedRoleId = 1;
    private HashSet<string> grantedCodes = new(StringComparer.OrdinalIgnoreCase);
    private bool isLoading = true;
    private bool isSaving;

    // Create Modal state
    private bool showCreateModal;
    private bool showCreateConfirm;
    private bool isSubmittingCreate;
    private string? createErrorMessage;
    private CreateRoleModelForm createModel = new();

    // Delete Modal state
    private bool showDeleteModal;
    private bool isSubmittingDelete;
    private string? deleteErrorMessage;
    private RoleModel? roleToDelete;

    private bool IsSelectedRoleAdmin => matrix != null && string.Equals(matrix.RoleCode, "ADMIN", StringComparison.OrdinalIgnoreCase);
    private RoleModel? CurrentSelectedRole => roles?.FirstOrDefault(r => r.RoleId == selectedRoleId);
    private bool IsSelectedRoleSystem => CurrentSelectedRole?.IsSystemRole ?? (IsSelectedRoleAdmin || string.Equals(matrix?.RoleCode, "USER", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAndSelectFirstAsync();
    }

    private async Task LoadRolesAndSelectFirstAsync()
    {
        var res = await RoleApi.GetRolesAsync();
        if (res.IsSuccess && res.Data?.Count > 0)
        {
            roles = res.Data;
            if (!roles.Any(r => r.RoleId == selectedRoleId))
            {
                selectedRoleId = roles[0].RoleId;
            }
            await SelectRole(selectedRoleId);
        }
        else
        {
            roles = [];
            isLoading = false;
        }
    }

    private async Task SelectRole(int roleId)
    {
        selectedRoleId = roleId;
        isLoading = true;
        var res = await RoleApi.GetRolePermissionsAsync(roleId);
        if (res.IsSuccess && res.Data != null)
        {
            matrix = res.Data;
            grantedCodes = new HashSet<string>(matrix.Permissions.Where(p => p.IsGranted).Select(p => p.Code), StringComparer.OrdinalIgnoreCase);
        }
        isLoading = false;
    }

    private void TogglePermission(string code, bool grant)
    {
        if (IsSelectedRoleAdmin) return;
        if (grant) grantedCodes.Add(code);
        else grantedCodes.Remove(code);
    }

    private async Task SaveChanges()
    {
        if (IsSelectedRoleAdmin)
        {
            Toast.Info("ADMIN permissions are permanent and cannot be modified.");
            return;
        }

        isSaving = true;
        var req = new UpdateRolePermissionsRequestModel(selectedRoleId, grantedCodes.ToList());
        var res = await RoleApi.UpdateRolePermissionsAsync(req);
        isSaving = false;
        if (res.IsSuccess)
        {
            Toast.Success("Permissions saved successfully!");
            await SelectRole(selectedRoleId);
        }
        else Toast.Error(res.Message ?? "Failed to save permissions.");
    }

    // CREATE ROLE
    private void OpenCreateRoleModal()
    {
        createModel = new CreateRoleModelForm();
        createErrorMessage = null;
        showCreateConfirm = false;
        showCreateModal = true;
    }

    private void CloseCreateRoleModal()
    {
        showCreateModal = false;
        showCreateConfirm = false;
        createErrorMessage = null;
    }

    private void ProceedToCreateConfirm()
    {
        createErrorMessage = null;
        if (string.IsNullOrWhiteSpace(createModel.RoleCode))
        {
            createErrorMessage = "Role Code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(createModel.RoleName))
        {
            createErrorMessage = "Role Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(createModel.Description))
        {
            createErrorMessage = "Role Description is required.";
            return;
        }

        var normalizedCode = createModel.RoleCode.Trim().ToUpperInvariant();
        var normalizedName = createModel.RoleName.Trim();
        var normalizedDesc = createModel.Description.Trim();

        if (roles != null)
        {
            if (roles.Any(r => r.Code.Equals(normalizedCode, StringComparison.OrdinalIgnoreCase)))
            {
                createErrorMessage = $"Role Code '{normalizedCode}' already exists.";
                return;
            }
            if (roles.Any(r => r.Name.Equals(normalizedName, StringComparison.OrdinalIgnoreCase)))
            {
                createErrorMessage = $"Role Name '{normalizedName}' already exists.";
                return;
            }
            if (roles.Any(r => !string.IsNullOrEmpty(r.Description) && r.Description.Equals(normalizedDesc, StringComparison.OrdinalIgnoreCase)))
            {
                createErrorMessage = $"Role Description '{normalizedDesc}' is already in use by another role.";
                return;
            }
        }

        showCreateConfirm = true;
    }

    private async Task SubmitCreateRoleAsync()
    {
        isSubmittingCreate = true;
        createErrorMessage = null;
        try
        {
            var req = new CreateRoleRequestModel(createModel.RoleCode.Trim().ToUpperInvariant(), createModel.RoleName.Trim(), createModel.Description?.Trim());
            var res = await RoleApi.CreateRoleAsync(req);
            if (res.IsSuccess && res.Data != null)
            {
                Toast.Success(res.Message ?? "Role created successfully!");
                showCreateModal = false;
                selectedRoleId = res.Data.RoleId;
                await LoadRolesAndSelectFirstAsync();
                await SelectRole(res.Data.RoleId);
            }
            else
            {
                createErrorMessage = res.Message ?? "Failed to create role.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingCreate = false;
        }
    }

    // DELETE ROLE
    private void PromptDeleteRole(RoleModel? role)
    {
        if (role == null) return;
        if (role.IsSystemRole || string.Equals(role.Code, "ADMIN", StringComparison.OrdinalIgnoreCase) || string.Equals(role.Code, "USER", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error("System roles (ADMIN and USER) cannot be deleted.");
            return;
        }

        roleToDelete = role;
        deleteErrorMessage = null;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        roleToDelete = null;
        deleteErrorMessage = null;
    }

    private async Task ConfirmDeleteRoleAsync()
    {
        if (roleToDelete == null) return;
        isSubmittingDelete = true;
        deleteErrorMessage = null;
        try
        {
            var res = await RoleApi.DeleteRoleAsync(roleToDelete.RoleId);
            if (res.IsSuccess)
            {
                Toast.Success(res.Message ?? $"Role '{roleToDelete.Name}' deleted.");
                showDeleteModal = false;
                roleToDelete = null;
                await LoadRolesAndSelectFirstAsync();
            }
            else
            {
                deleteErrorMessage = res.Message ?? "Failed to delete role.";
            }
        }
        catch (Exception ex)
        {
            deleteErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingDelete = false;
        }
    }

    private sealed class CreateRoleModelForm
    {
        public string RoleCode { get; set; } = string.Empty;
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}