@page "/feed"
@page "/postupload"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@inject PostApiService PostApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Environment
@inject NavigationManager NavManager

<PageTitle>Post Upload & Feed - CommunityLink</PageTitle>

<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Top Header & Upload Trigger -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-5 mb-6 transition-colors duration-150">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-xl font-bold shadow-sm">
                    ✍️
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-[#0A1B2E] dark:text-[#E1E8F0] tracking-tight" style="font-family:'Manrope',sans-serif">Post Sharing &amp; Upload</h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Create posts with images in your favorite community and interact with members.</p>
                </div>
            </div>
            <div>
                <button type="button" @onclick="OpenCreatePostModal"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-sm rounded-full shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Upload Post</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Feed Content -->
    @if (isLoadingFeed)
    {
        <div class="flex justify-center items-center py-16">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
        </div>
    }
    else if (posts == null || posts.Count == 0)
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="text-4xl mb-3">📭</div>
            <h3 class="text-base font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No posts available yet</h3>
            <p class="text-sm mt-1">Be the first to share an update or image by clicking "Upload Post" above.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var post in posts)
            {
                <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] overflow-hidden transition duration-200">
                    <!-- Post Header -->
                    <div class="p-4 sm:p-5 flex items-start justify-between">
                        <div class="flex items-center gap-3">
                            <a href="u/@post.AuthorId" class="shrink-0">
                                @if (!string.IsNullOrEmpty(post.AuthorAvatar))
                                {
                                    <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-10 h-10 rounded-full object-cover border border-slate-200 hover:ring-2 hover:ring-blue-500 transition" />
                                }
                                else
                                {
                                    <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-slate-700 text-sm hover:bg-slate-200 transition">
                                        @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </a>
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="u/@post.AuthorId" class="text-sm font-semibold text-slate-900 hover:text-blue-600 transition">@post.AuthorName</a>
                                    @if (!string.IsNullOrEmpty(post.CommunityName))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                                            @post.CommunityName
                                        </span>
                                    }
                                </div>
                                <span class="text-xs text-[#7A8CA6]">@post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                            </div>
                        </div>

                        <!-- Self-post Options (Edit & Delete only for Author) -->
                        @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                        {
                            <div class="flex items-center gap-1">
                                <button type="button" @onclick="() => OpenEditPostModal(post)"
                                        title="Edit your post"
                                        class="p-1.5 text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </button>
                                <button type="button" @onclick="() => ConfirmDeletePost(post.PostId)"
                                        title="Delete your post"
                                        class="p-1.5 text-[#7A8CA6] hover:text-red-600 dark:hover:text-rose-400 rounded-lg hover:bg-red-50 dark:hover:bg-rose-950/40 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Post Body Text -->
                    <div class="px-4 sm:px-5 pb-3">
                        <p class="text-sm text-[#0A1B2E] dark:text-[#E1E8F0] whitespace-pre-line leading-relaxed">@post.Content</p>
                    </div>

                    <!-- Post Images -->
                    @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                    {
                        <div class="border-t border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                            @if (post.ImageUrls.Count == 1)
                            {
                                <div class="max-h-[480px] overflow-hidden flex items-center justify-center bg-[#F1F5F9] dark:bg-[#0A1B2E]">
                                    <img src="@post.ImageUrls[0]" alt="Post attachment" class="w-full h-auto max-h-[480px] object-contain" />
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-2 gap-1 p-1 bg-[#F1F5F9] dark:bg-[#0A1B2E]">
                                    @foreach (var img in post.ImageUrls)
                                    {
                                        <div class="h-60 overflow-hidden bg-[#E2E8F0] dark:bg-[#112A46] flex items-center justify-center">
                                            <img src="@img" alt="Post attachment" class="w-full h-full object-cover" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Metrics / Counter Strip -->
                    <div class="px-4 sm:px-5 py-2 flex items-center justify-between text-xs text-[#7A8CA6] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div class="flex items-center gap-1 font-mono">
                            <span class="inline-flex items-center justify-center w-4 h-4 text-red-500 text-[10px]">❤️</span>
                            <span>@post.LikeCount @(post.LikeCount == 1 ? "Like" : "Likes")</span>
                        </div>
                        <div class="flex items-center gap-3 font-mono">
                            <span>@post.CommentCount comments</span>
                            <span>•</span>
                            <span>@post.ShareCount shares</span>
                        </div>
                    </div>

                    <!-- Action Buttons: Like, Comment, Share -->
                    <div class="px-4 py-1.5 flex items-center justify-between text-sm font-medium text-[#557392] dark:text-[#C4D2E1] bg-[#F8FAFC] dark:bg-[#0A1B2E]/40">
                        <!-- Like Button with Self-like supported & Like Count badge -->
                        <button type="button" @onclick="() => ToggleLike(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(post.IsLikedByCurrentUser ? "text-rose-600 dark:text-rose-400 font-semibold" : "")">
                            <svg class="w-5 h-5 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                            <span>Like</span>
                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0]">@post.LikeCount</span>
                        </button>

                        <!-- Comment Button -->
                        <button type="button" @onclick="() => ToggleCommentBox(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                            <span>Comment</span>
                        </button>

                        <!-- Share Button -->
                        <button type="button" @onclick="() => OpenShareModal(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                            </svg>
                            <span>Share</span>
                        </button>
                    </div>

                    <!-- Comment Drawer Section -->
                    @if (openCommentPostIds.Contains(post.PostId))
                    {
                        <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 space-y-4">
                            <!-- New Comment Input -->
                            <div class="flex items-start gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                                    💬
                                </div>
                                <div class="flex-1 flex gap-2">
                                    <input type="text" @bind="commentInputs[post.PostId]"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(post.PostId); })"
                                           placeholder="Write a public comment..."
                                           class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 shadow-sm" />
                                    <button type="button" @onclick="() => SubmitComment(post.PostId)"
                                            class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold shadow-sm transition">
                                        Post
                                    </button>
                                </div>
                            </div>

                            <!-- Comment List -->
                            @if (commentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                            {
                                if (commentList.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] text-center py-2">No comments yet. Start the conversation!</p>
                                }
                                else
                                {
                                    <div class="space-y-3 pt-2">
                                        @foreach (var comment in commentList)
                                        {
                                            <div class="flex items-start gap-2.5 text-xs">
                                                <div class="w-7 h-7 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0">
                                                    @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                </div>
                                                <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-2xs">
                                                    <div class="flex items-center justify-between gap-2 mb-1">
                                                        <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@comment.AuthorName</span>
                                                        <span class="text-[10px] text-[#7A8CA6] font-mono">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                    </div>
                                                    <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE POST MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📸</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Create New Post</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-5 space-y-4">
                <!-- Community Dropdown (Mandatory) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Select Community <span class="text-red-500">*</span></label>
                    <select class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"
                            value="@selectedParentCommunityId"
                            @onchange="OnParentCommunityChanged">
                        <option value="0">-- Select a Community --</option>
                        @foreach (var c in mainCommunities)
                        {
                            <option value="@c.CommunityId">@c.Name</option>
                        }
                    </select>
                </div>

                <!-- Sub-community Dropdown -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">
                        Select Sub-community
                        @if (filteredSubCommunities.Count == 0 && selectedParentCommunityId > 0)
                        {
                            <span class="text-[#7A8CA6] font-normal">(No sub-communities found)</span>
                        }
                    </label>
                    <select class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 disabled:opacity-50"
                            disabled="@(selectedParentCommunityId == 0 || filteredSubCommunities.Count == 0)"
                            @bind="selectedSubCommunityId">
                        <option value="0">-- (Optional) Use Main Community or Pick Sub-community --</option>
                        @foreach (var sc in filteredSubCommunities)
                        {
                            <option value="@sc.CommunityId">@sc.Name</option>
                        }
                    </select>
                </div>

                <!-- Post Text Content (Mandatory) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Content <span class="text-red-500">*</span></label>
                    <textarea @bind="newPostText" rows="4"
                              placeholder="What's happening in this community? Share thoughts, updates, or details..."
                              class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"></textarea>
                </div>

                <!-- Image Upload (Computer file picker) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Attach Image</label>
                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="w-full text-xs text-[#557392] dark:text-[#C4D2E1] file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#E2E8F0] dark:file:bg-[#1B3B5A] file:text-[#0A1B2E] dark:file:text-[#E1E8F0] hover:file:bg-[#CBD5E1] cursor-pointer" />

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 text-xs text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> Uploading image to storage...
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="modal-image-preview-container mt-3 relative rounded-xl overflow-hidden border border-slate-200 w-full bg-slate-950 flex items-center justify-center" style="height: 140px; max-height: 140px; width: 100%;">
                            <img src="@uploadedImageUrl" alt="Preview" class="modal-image-preview-img object-contain" style="max-height: 140px; max-width: 100%; height: auto; width: auto; display: block; margin: 0 auto;" />
                            <button type="button" @onclick="RemoveUploadedImage"
                                    class="absolute top-2 right-2 bg-red-600 text-white rounded-full p-1 shadow hover:bg-red-700 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-2 text-sm text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-medium rounded-xl hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitCreatePost" disabled="@isSubmitting"
                        class="px-5 py-2 text-sm bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold rounded-xl shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Posting...</span>
                    }
                    else
                    {
                        <span>Publish</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= EDIT POST MODAL ================= -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">✏️</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Edit Your Post</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Content <span class="text-red-500">*</span></label>
                    <textarea @bind="editPostText" rows="4"
                              class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">Change / Update Image</label>
                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="w-full text-xs text-[#557392] dark:text-[#C4D2E1] file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#E2E8F0] dark:file:bg-[#1B3B5A] file:text-[#0A1B2E] dark:file:text-[#E1E8F0] hover:file:bg-[#CBD5E1] cursor-pointer" />

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 text-xs text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> Uploading image...
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="modal-image-preview-container mt-3 relative rounded-xl overflow-hidden border border-slate-200 w-full bg-slate-950 flex items-center justify-center" style="height: 140px; max-height: 140px; width: 100%;">
                            <img src="@uploadedImageUrl" alt="Preview" class="modal-image-preview-img object-contain" style="max-height: 140px; max-width: 100%; height: auto; width: auto; display: block; margin: 0 auto;" />
                            <button type="button" @onclick="RemoveUploadedImage"
                                    class="absolute top-2 right-2 bg-red-600 text-white rounded-full p-1 shadow hover:bg-red-700 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-2 text-sm text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-medium rounded-xl hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitUpdatePost" disabled="@isSubmitting"
                        class="px-5 py-2 text-sm bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold rounded-xl shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

