@code {
    private string FormatTimeAgo(DateTime dt)
    {
        var utcDt = dt.Kind == DateTimeKind.Utc 
            ? dt 
            : (dt.Kind == DateTimeKind.Local
                ? dt.ToUniversalTime()
                : DateTime.SpecifyKind(dt, DateTimeKind.Utc));
        var span = DateTime.UtcNow - utcDt;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;

        if (span.TotalSeconds < 60) return Loc["GroupDetail_Time_JustNow"];
        if (span.TotalMinutes < 60) return string.Format(CultureInfo.CurrentCulture, Loc["GroupDetail_Time_MinutesAgo"], Math.Max(1, (int)span.TotalMinutes));
        if (span.TotalHours < 24) return string.Format(CultureInfo.CurrentCulture, Loc["GroupDetail_Time_HoursAgo"], Math.Max(1, (int)span.TotalHours));
        return utcDt.ToLocalTime().ToString("dd-MM-yyyy");
    }

    private IReadOnlyList<PostModel>? posts;
    private List<CommunityModel> allCommunities = [];
    private List<CommunityModel> mainCommunities = [];
    private List<CommunityModel> filteredSubCommunities = [];

    // Report modal state
    private bool showReportModal = false;
    private string reportContentType = "POST";
    private int reportContentId = 0;
    private int? openPostMenuId = null;

    // Banned reason modal state
    private bool showBannedReasonModal = false;
    private PostModel? bannedPostTarget = null;

    private void OpenBannedReasonModal(PostModel post)
    {
        bannedPostTarget = post;
        showBannedReasonModal = true;
    }

    private void CloseBannedReasonModal()
    {
        showBannedReasonModal = false;
        bannedPostTarget = null;
    }

    private async Task TogglePostPrivacyAsync(PostModel post)
    {
        openPostMenuId = null;
        var res = await PostApi.TogglePostPrivacyAsync(post.PostId);
        if (res.IsSuccess)
        {
            post.IsPrivate = !post.IsPrivate;
            Toast.Success(post.IsPrivate ? Loc["PostUpload_Toast_PrivateMode"] : Loc["PostUpload_Toast_PublicMode"]);
            StateHasChanged();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_PrivacyToggleFailed"]);
        }
    }

    private void TogglePostMenu(int postId)
    {
        openPostMenuId = (openPostMenuId == postId) ? null : postId;
    }

    private void OpenReportModal(int id, string type)
    {
        openPostMenuId = null;
        reportContentId = id;
        reportContentType = type;
        showReportModal = true;
    }

    private int? currentUserId;
    private bool isLoadingFeed = true;
    private bool isSubmitting;
    private bool isUploadingImage;

    // Create Modal state
    private bool showCreateModal;
    private int selectedParentCommunityId;
    private int selectedSubCommunityId;
