@page "/feed"
@page "/postupload"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.IO
@using System.Text.Json
@using System.Globalization
@inject PostApiService PostApi
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject RoleAndPermissionApiService RoleApi
@inject IWebHostEnvironment Environment
@inject NavigationManager NavManager
@inject IStringLocalizer<AppResources> Loc
@inject IJSRuntime JS

<PageTitle>@Loc["PostUpload_PageTitle"] - CommunityLink</PageTitle>

<style>
    .prof-code-block {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
        font-size: 11px;
        border-radius: 0.5rem;
        border: 1px solid #30363d;
    }
</style>

<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Top Header & Upload Trigger -->
    <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-5 mb-6 transition-colors duration-150">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-[#0A1B2E] dark:text-[#E1E8F0] tracking-tight" style="font-family:'Manrope',sans-serif">@Loc["PostUpload_Header_Title"]</h1>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@Loc["PostUpload_Header_Subtitle"]</p>
                </div>
            </div>
            @if (canCreatePost)
            {
                <div>
                    <button type="button" @onclick="OpenCreatePostModal"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-sm rounded-full shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span>@Loc["PostUpload_Header_UploadBtn"]</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Feed Content -->
    @if (isLoadingFeed)
    {
        <div class="flex justify-center items-center py-16">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
        </div>
    }
    else if (posts == null || posts.Count == 0)
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
            </div>
            <h3 class="text-base font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">@Loc["PostUpload_Feed_EmptyTitle"]</h3>
            <p class="text-sm mt-1">@Loc["PostUpload_Feed_EmptySubtitle"]</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var post in posts)
            {
                <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#0A1B2E]/20 dark:hover:border-[rgba(196,210,225,0.35)] overflow-hidden transition duration-200">
                    @if (!post.IsActive && currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                    {
                        <!-- Post Banned Banner for Author -->
                        <div @onclick="() => OpenBannedReasonModal(post)"
                             class="cursor-pointer bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border-b border-red-500/30 px-4 py-2.5 flex items-center justify-between text-xs font-bold transition">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                <span>@Loc["PostUpload_Post_BannedTitle"]</span>
                            </div>
                            <span class="text-[11px] underline font-semibold flex items-center gap-1">
                                <span>@Loc["PostUpload_Post_ViewReason"]</span>
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            </span>
                        </div>
                    }
                    <!-- Post Header -->
                    <div class="p-4 sm:p-5 flex items-start justify-between">
                        <div class="flex items-center gap-3">
                            <a href="u/@post.AuthorId" class="shrink-0">
                                <UserAvatar Url="@post.AuthorAvatar"
                                            Name="@post.AuthorName"
                                            Size="w-10 h-10"
                                            RingClass="border border-slate-200 hover:ring-2 hover:ring-blue-500 transition"
                                            BgClass="bg-slate-100"
                                            ColorClass="text-slate-700"
                                            TextClass="text-sm" />
                            </a>
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="u/@post.AuthorId" class="text-sm font-semibold text-slate-900 hover:text-blue-600 transition">@post.AuthorName</a>
                                    @if (!string.IsNullOrEmpty(post.CommunityName))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                                            @post.CommunityName
                                        </span>
                                    }
                                </div>
                                <span class="text-xs text-[#7A8CA6]">@FormatTimeAgo(post.CreatedAt)</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-1.5">
                            @if (post.IsPrivate)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    <span>@Loc["PostUpload_Post_BadgePrivate"]</span>
                                </span>
                            }

                            <!-- Three Dots Dropdown -->
                            <div class="relative">
                                <button type="button" @onclick="() => TogglePostMenu(post.PostId)"
                                        title="@Loc["PostUpload_Post_OptionsTooltip"]"
                                        class="p-1.5 text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                                </button>

                                @if (openPostMenuId == post.PostId)
                                {
                                    <div class="absolute right-0 top-full mt-1 w-44 bg-white dark:bg-[#112A46] rounded-xl shadow-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-1 z-30 space-y-0.5">
                                        <button type="button" @onclick='() => OpenReportModal(post.PostId, "POST")'
                                                class="w-full text-left px-3 py-2 rounded-lg text-xs font-bold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition flex items-center gap-2 cursor-pointer">
                                            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                                            <span>@Loc["PostUpload_Post_Report"]</span>
                                        </button>

                                        @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                        {
                                            <button type="button" @onclick="() => TogglePostPrivacyAsync(post)"
                                                    class="w-full text-left px-3 py-1.5 rounded-lg text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center gap-2 cursor-pointer">
                                                <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                <span>@(post.IsPrivate ? Loc["PostUpload_Post_MakePublic"] : Loc["PostUpload_Post_MakePrivate"])</span>
                                            </button>
                                            <button type="button" @onclick="() => OpenEditPostModal(post)"
                                                    class="w-full text-left px-3 py-1.5 rounded-lg text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition flex items-center gap-2 cursor-pointer">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                <span>@Loc["PostUpload_Post_Edit"]</span>
                                            </button>
                                            <button type="button" @onclick="() => PromptRecyclePost(post.PostId)"
                                                    class="w-full text-left px-3 py-1.5 rounded-lg text-xs font-semibold text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/40 transition flex items-center gap-2 cursor-pointer">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                <span>@Loc["PostUpload_Post_Recycle"]</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Post Body Text -->
                    <div class="px-4 sm:px-5 pb-3">
                        <p class="text-sm text-[#0A1B2E] dark:text-[#E1E8F0] whitespace-pre-line leading-relaxed">@post.Content</p>
                    </div>

                    <!-- Attached Files Component -->
                    @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                    {
                        var textFiles = ParsePostUploadTextFiles(post.CodeSnippet, post.CodeFileName);
                        @foreach (var tf in textFiles)
                        {
                            <div class="px-4 sm:px-5 pb-3">
                                <div class="prof-code-block p-2.5 space-y-1 text-xs">
                                    <div class="flex items-center justify-between pb-1 border-b border-gray-800 text-[10px] text-gray-400">
                                        <div class="flex items-center gap-1.5 font-mono min-w-0">
                                            <span class="font-bold text-emerald-400 truncate">📄 @tf.FileName</span>
                                            @if (tf.FileSizeBytes.HasValue)
                                            {
                                                <span class="text-gray-500 shrink-0">(@FormatFileSize(tf.FileSizeBytes.Value))</span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 shrink-0 ml-2">
                                            @if (!string.IsNullOrWhiteSpace(tf.FileUrl))
                                            {
                                                <a href="@tf.FileUrl" download="@tf.FileName" target="_blank"
                                                   class="flex items-center gap-1 text-[10px] text-gray-400 hover:text-white transition-colors cursor-pointer"
                                                   title="Download file">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                                    <span>Download</span>
                                                </a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(tf.Content))
                                            {
                                                <button type="button" class="flex items-center gap-1 text-[10px] text-gray-400 hover:text-white transition-colors cursor-pointer"
                                                        @onclick="() => CopyPostUploadSnippetAsync(tf.Content)"
                                                        title="Copy content">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                    <span>Copy</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tf.Content))
                                    {
                                        <div class="overflow-x-auto overflow-y-auto max-h-56 text-[11px] leading-relaxed select-text p-2">
                                            <pre class="whitespace-pre font-mono text-tertiary"><code>@tf.Content</code></pre>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Post Images -->
                    @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                    {
                        <div class="border-t border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                            @if (post.ImageUrls.Count == 1)
                            {
                                <div class="max-h-[480px] overflow-hidden flex items-center justify-center bg-[#F1F5F9] dark:bg-[#0A1B2E]">
                                    <img src="@post.ImageUrls[0]" alt="@Loc["PostUpload_Post_AttachmentAlt"]" class="w-full h-auto max-h-[480px] object-contain" />
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-2 gap-1 p-1 bg-[#F1F5F9] dark:bg-[#0A1B2E]">
                                    @foreach (var img in post.ImageUrls)
                                    {
                                        <div class="h-60 overflow-hidden bg-[#E2E8F0] dark:bg-[#112A46] flex items-center justify-center">
                                            <img src="@img" alt="@Loc["PostUpload_Post_AttachmentAlt"]" class="w-full h-full object-cover" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Metrics / Counter Strip -->
                    <div class="px-4 sm:px-5 py-2 flex items-center justify-between text-xs text-[#7A8CA6] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                        <div class="flex items-center gap-1 font-mono">
                            <svg class="w-3.5 h-3.5 text-rose-500 fill-rose-500 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                            <span>@(post.LikeCount == 1 ? Loc["PostUpload_Post_Likes_Single", post.LikeCount] : Loc["PostUpload_Post_Likes_Plural", post.LikeCount])</span>
                        </div>
                        <div class="flex items-center gap-3 font-mono">
                            <span>@Loc["PostUpload_Post_CommentsCount", post.CommentCount]</span>
                            <span>•</span>
                            <span>@Loc["PostUpload_Post_SharesCount", post.ShareCount]</span>
                        </div>
                    </div>

                    <!-- Action Buttons: Like, Comment, Share -->
                    <div class="px-4 py-1.5 flex items-center justify-between text-sm font-medium text-[#557392] dark:text-[#C4D2E1] bg-[#F8FAFC] dark:bg-[#0A1B2E]/40">
                        <!-- Like Button with Self-like supported & Like Count badge -->
                        <button type="button" @onclick="() => ToggleLike(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(post.IsLikedByCurrentUser ? "text-rose-600 dark:text-rose-400 font-semibold" : "")">
                            <svg class="w-5 h-5 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                            <span>@Loc["PostUpload_Post_LikeBtn"]</span>
                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0]">@post.LikeCount</span>
                        </button>

                        <!-- Comment Button -->
                        <button type="button" @onclick="() => ToggleCommentBox(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                            <span>@Loc["PostUpload_Post_CommentBtn"]</span>
                        </button>

                        <!-- Share Button -->
                        <button type="button" @onclick="() => OpenShareModal(post.PostId)"
                                class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                            </svg>
                            <span>@Loc["PostUpload_Post_ShareBtn"]</span>
                        </button>
                    </div>

                    <!-- Comment Drawer Section -->
                    @if (openCommentPostIds.Contains(post.PostId))
                    {
                        <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 space-y-4">
                            <!-- New Comment Input -->
                            <div class="flex items-start gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                </div>
                                <div class="flex-1 flex gap-2">
                                    <input type="text" @bind="commentInputs[post.PostId]"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(post.PostId); })"
                                           placeholder="@Loc["PostUpload_Comment_InputPlaceholder"]"
                                           class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 shadow-sm" />
                                    <button type="button" @onclick="() => SubmitComment(post.PostId)"
                                            class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold shadow-sm transition">
                                        @Loc["PostUpload_Comment_SubmitBtn"]
                                    </button>
                                </div>
                            </div>

                            <!-- Comment List -->
                            @if (commentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                            {
                                if (commentList.Count == 0)
                                {
                                    <p class="text-xs text-[#7A8CA6] text-center py-2">@Loc["PostUpload_Comment_Empty"]</p>
                                }
                                else
                                {
                                    <div class="space-y-3 pt-2">
                                        @foreach (var comment in commentList)
                                        {
                                            <div class="flex items-start gap-2.5 text-xs">
                                                <div class="w-7 h-7 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0">
                                                    @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                </div>
                                                <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-2xs">
                                                    <div class="flex items-center justify-between gap-2 mb-1">
                                                        <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@comment.AuthorName</span>
                                                        <span class="text-[10px] text-[#7A8CA6] font-mono">@FormatTimeAgo(comment.CreatedAt)</span>
                                                    </div>
                                                    <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ================= CREATE POST MODAL ================= -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📸</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">@Loc["PostUpload_Create_Title"]</h3>
                </div>
                <button type="button" @onclick="CloseModals" class="text-[#7A8CA6] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded-lg hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Form Body -->
            <div class="p-5 space-y-4">
                <!-- Free Public Post Note / Optional Community Selection -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">
                        @Loc["PostUpload_Create_CommunityLabel"] <span class="text-[#7A8CA6] font-normal">@Loc["PostUpload_Create_CommunityOptionalHint"]</span>
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <select class="w-full text-xs bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20"
                                value="@selectedParentCommunityId"
                                @onchange="OnParentCommunityChanged">
                            <option value="0">@Loc["PostUpload_Create_CommunityFreePublic"]</option>
                            @foreach (var c in mainCommunities)
                            {
                                <option value="@c.CommunityId">@c.Name</option>
                            }
                        </select>

                        <select class="w-full text-xs bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 disabled:opacity-50"
                                disabled="@(selectedParentCommunityId == 0 || filteredSubCommunities.Count == 0)"
                                @bind="selectedSubCommunityId">
                            <option value="0">@Loc["PostUpload_Create_SubCommunityOptional"]</option>
                            @foreach (var sc in filteredSubCommunities)
                            {
                                <option value="@sc.CommunityId">@sc.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Post Text Content (Mandatory) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">@Loc["PostUpload_Create_ContentLabel"] <span class="text-red-500">*</span></label>
                    <textarea @bind="newPostText" rows="4"
                              placeholder="@Loc["PostUpload_Create_ContentPlaceholder"]"
                              class="w-full text-sm bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20"></textarea>
                </div>

                <!-- Text File (.txt) Attachment -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">
                            @Loc["PostUpload_Create_AttachTextFileLabel"] <span class="text-[#7A8CA6] font-normal">@Loc["PostUpload_Create_AttachTextFileHint"]</span>
                        </label>
                        @if (!string.IsNullOrEmpty(uploadedCodeSnippet))
                        {
                            <button type="button" @onclick="RemoveUploadedCodeFile" class="text-xs text-rose-500 hover:underline">
                                @Loc["PostUpload_Create_RemoveFile"]
                            </button>
                        }
                    </div>
                    <InputFile OnChange="HandleTextFileSelected" accept=".txt" class="w-full text-xs text-[#557392] dark:text-[#C4D2E1] file:mr-4 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#E2E8F0] dark:file:bg-[#1B3B5A] file:text-[#0A1B2E] dark:file:text-[#E1E8F0] hover:file:bg-[#CBD5E1] cursor-pointer" />

                    @if (isReadingTextFile)
                    {
                        <div class="mt-2 text-xs text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> @Loc["PostUpload_Create_ScanningTextFile"]
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadedCodeSnippet))
                    {
                        var previewFiles = ParsePostUploadTextFiles(uploadedCodeSnippet, uploadedCodeFileName);
                        var firstFile = previewFiles.FirstOrDefault();
                        <div class="mt-2 prof-code-block p-3 space-y-1.5">
                            <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                <span class="font-bold text-emerald-400 font-mono">📄 @(firstFile?.FileName ?? uploadedCodeFileName ?? "attached")</span>
                                <span class="font-mono">@(firstFile?.FileSizeBytes.HasValue == true ? FormatFileSize(firstFile.FileSizeBytes.Value) : Loc["PostUpload_Create_TextFileBadge"])</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(firstFile?.Content))
                            {
                                <div class="overflow-x-auto overflow-y-auto max-h-48 text-[11px] leading-relaxed">
                                    <pre class="whitespace-pre font-mono"><code>@firstFile.Content</code></pre>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Image Upload (Computer file picker) -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">@Loc["PostUpload_Create_AttachImageLabel"]</label>
                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="w-full text-xs text-[#557392] dark:text-[#C4D2E1] file:mr-4 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#E2E8F0] dark:file:bg-[#1B3B5A] file:text-[#0A1B2E] dark:file:text-[#E1E8F0] hover:file:bg-[#CBD5E1] cursor-pointer" />

                    @if (isUploadingImage)
                    {
                        <div class="mt-2 text-xs text-[#557392] dark:text-[#C4D2E1] flex items-center gap-1.5">
                            <span class="animate-spin">🌀</span> @Loc["PostUpload_Create_UploadingImage"]
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="modal-image-preview-container mt-3 relative rounded-xl overflow-hidden border border-slate-200 w-full bg-slate-950 flex items-center justify-center" style="height: 140px; max-height: 140px; width: 100%;">
                            <img src="@uploadedImageUrl" alt="@Loc["PostUpload_Create_ImagePreviewAlt"]" class="modal-image-preview-img object-contain" style="max-height: 140px; max-width: 100%; height: auto; width: auto; display: block; margin: 0 auto;" />
                            <button type="button" @onclick="RemoveUploadedImage"
                                    class="absolute top-2 right-2 bg-red-600 text-white rounded-full p-1 shadow hover:bg-red-700 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseModals"
                        class="px-4 py-2 text-sm text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white font-medium rounded-xl hover:bg-[#E2E8F0] dark:hover:bg-[#1B3B5A] transition">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitCreatePost" disabled="@isSubmitting"
                        class="px-5 py-2 text-sm bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold rounded-xl shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["PostUpload_Create_SubmittingBtn"]</span>
                    }
                    else
                    {
                        <span>@Loc["PostUpload_Create_PublishBtn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

