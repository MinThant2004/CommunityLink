    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        var isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);
        if (isAdmin)
        {
            canCreatePost = true;
        }
        else
        {
            try
            {
                var permRes = await RoleApi.GetMyPermissionsAsync();
                if (permRes.IsSuccess && permRes.Data != null)
                {
                    canCreatePost = permRes.Data.Any(p => p.Equals(PermissionCatalog.PostCreate, StringComparison.OrdinalIgnoreCase));
                }
            }
            catch { }
        }

        await Task.WhenAll(LoadCommunities(), LoadFeed());
    }

    private async Task LoadCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            allCommunities = res.Data.ToList();
            // Main communities have no ParentCommunityId
            mainCommunities = allCommunities.Where(c => !c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private void OnParentCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parentId))
        {
            selectedParentCommunityId = parentId;
            selectedSubCommunityId = 0;

            if (parentId > 0)
            {
                filteredSubCommunities = allCommunities
                    .Where(c => c.ParentCommunityId == parentId)
                    .OrderBy(c => c.Name)
                    .ToList();
            }
            else
            {
                filteredSubCommunities.Clear();
            }
        }
    }

    private async Task LoadFeed()
    {
        isLoadingFeed = true;
        var res = await PostApi.GetFeedAsync();
        if (res.IsSuccess)
        {
            posts = res.Data;
            foreach (var p in posts ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
        isLoadingFeed = false;
    }

    private void OpenCreatePostModal()
    {
        newPostText = "";
        uploadedImageUrl = null;
        uploadedCodeSnippet = null;
        uploadedCodeFileName = null;
        selectedParentCommunityId = 0; // Default to free public post
