@code {
    private IReadOnlyList<PostModel>? posts;
    private List<CommunityModel> allCommunities = [];
    private List<CommunityModel> mainCommunities = [];
    private List<CommunityModel> filteredSubCommunities = [];

    private int? currentUserId;
    private bool isLoadingFeed = true;
    private bool isSubmitting;
    private bool isUploadingImage;

    // Create Modal state
    private bool showCreateModal;
    private int selectedParentCommunityId;
    private int selectedSubCommunityId;
    private string newPostText = "";
    private string? uploadedImageUrl;

    // Edit Modal state
    private bool showEditModal;
    private int editingPostId;
    private string editPostText = "";

    // Share Modal state
    private bool showShareModal;
    private int sharingPostId;
    private string shareNoteText = "";

    // Comment State
    private HashSet<int> openCommentPostIds = [];
    private Dictionary<int, string> commentInputs = [];
    private Dictionary<int, IReadOnlyList<CommentModel>> commentsByPost = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        await Task.WhenAll(LoadCommunities(), LoadFeed());
    }

    private async Task LoadCommunities()
    {
        var res = await CommunityApi.GetCommunitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            allCommunities = res.Data.ToList();
            // Main communities have no ParentCommunityId
            mainCommunities = allCommunities.Where(c => !c.ParentCommunityId.HasValue).OrderBy(c => c.Name).ToList();
        }
    }

    private void OnParentCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parentId))
        {
            selectedParentCommunityId = parentId;
            selectedSubCommunityId = 0;

            if (parentId > 0)
            {
                filteredSubCommunities = allCommunities
                    .Where(c => c.ParentCommunityId == parentId)
                    .OrderBy(c => c.Name)
                    .ToList();
            }
            else
            {
                filteredSubCommunities.Clear();
            }
        }
    }

    private async Task LoadFeed()
    {
        isLoadingFeed = true;
        var res = await PostApi.GetFeedAsync();
        if (res.IsSuccess)
        {
            posts = res.Data;
            foreach (var p in posts ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
        isLoadingFeed = false;
    }

    private void OpenCreatePostModal()
    {
        newPostText = "";
        uploadedImageUrl = null;
        selectedParentCommunityId = mainCommunities.FirstOrDefault()?.CommunityId ?? 0;
        if (selectedParentCommunityId > 0)
        {
            filteredSubCommunities = allCommunities.Where(c => c.ParentCommunityId == selectedParentCommunityId).OrderBy(c => c.Name).ToList();
        }
        else
        {
            filteredSubCommunities.Clear();
        }
        selectedSubCommunityId = 0;
        showCreateModal = true;
    }

    private void OpenEditPostModal(PostModel post)
    {
        editingPostId = post.PostId;
        editPostText = post.Content;
        uploadedImageUrl = post.ImageUrls.FirstOrDefault();
        showEditModal = true;
    }

    private void OpenShareModal(int postId)
    {
        sharingPostId = postId;
        shareNoteText = "";
        showShareModal = true;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showEditModal = false;
        showShareModal = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            // Target upload directory: wwwroot/uploads
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            // Limit file size to 10MB
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedImageUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Image uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to process image: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveUploadedImage()
    {
        uploadedImageUrl = null;
    }

    private async Task SubmitCreatePost()
    {
        if (selectedParentCommunityId == 0)
        {
            Toast.Warning("Please select a community for your post.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newPostText))
        {
            Toast.Warning("Post text content cannot be empty.");
            return;
        }

        isSubmitting = true;
        // Priority to sub-community if chosen, otherwise main community
        var targetCommunityId = selectedSubCommunityId > 0 ? selectedSubCommunityId : selectedParentCommunityId;
        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };

        var res = await PostApi.CreatePostAsync(new CreatePostRequestModel(targetCommunityId, newPostText, images));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Post published successfully!");
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create post.");
        }
    }

    private async Task SubmitUpdatePost()
    {
        if (string.IsNullOrWhiteSpace(editPostText))
        {
            Toast.Warning("Post content cannot be empty.");
            return;
        }

        isSubmitting = true;
        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };
        var res = await PostApi.UpdatePostAsync(editingPostId, new UpdatePostRequestModel(editPostText, images));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Post updated successfully!");
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update post.");
        }
    }

    private async Task ConfirmDeletePost(int postId)
    {
        var res = await PostApi.DeletePostAsync(postId);
        if (res.IsSuccess)
        {
            Toast.Success("Post deleted successfully.");
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete post.");
        }
    }

    private async Task ToggleLike(int postId)
    {
        var res = await PostApi.LikePostAsync(postId);
        if (res.IsSuccess)
        {
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update like.");
        }
    }

    private async Task SubmitSharePost()
    {
        isSubmitting = true;
        var res = await PostApi.SharePostAsync(sharingPostId, new SharePostRequestModel(shareNoteText));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Post shared!");
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to share post.");
        }
    }

    private async Task ToggleCommentBox(int postId)
    {
        if (openCommentPostIds.Contains(postId))
        {
            openCommentPostIds.Remove(postId);
        }
        else
        {
            openCommentPostIds.Add(postId);
            await LoadComments(postId);
        }
    }

    private async Task LoadComments(int postId)
    {
        var res = await PostApi.GetCommentsAsync(postId);
        if (res.IsSuccess && res.Data != null)
        {
            commentsByPost[postId] = res.Data;
        }
    }

    private async Task SubmitComment(int postId)
    {
        if (!commentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var res = await PostApi.AddCommentAsync(new CreateCommentRequestModel(postId, content));
        if (res.IsSuccess)
        {
            commentInputs[postId] = "";
            await LoadComments(postId);
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to post comment.");
        }
    }
}
