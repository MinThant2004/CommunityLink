    private async Task SubmitSharePost()
    {
        isSubmitting = true;
        var res = await PostApi.SharePostAsync(sharingPostId, new SharePostRequestModel(shareNoteText));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["PostUpload_Toast_PostShared"]);
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_ShareFailed"]);
        }
    }

    private async Task ToggleCommentBox(int postId)
    {
        if (openCommentPostIds.Contains(postId))
        {
            openCommentPostIds.Remove(postId);
        }
        else
        {
            openCommentPostIds.Add(postId);
            await LoadComments(postId);
        }
    }

    private async Task LoadComments(int postId)
    {
        var res = await PostApi.GetCommentsAsync(postId);
        if (res.IsSuccess && res.Data != null)
        {
            commentsByPost[postId] = res.Data;
        }
    }

    private async Task SubmitComment(int postId)
    {
        if (!commentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var res = await PostApi.AddCommentAsync(new CreateCommentRequestModel(postId, content));
        if (res.IsSuccess)
        {
            commentInputs[postId] = "";
            await LoadComments(postId);
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_CommentFailed"]);
        }
    }

    public sealed record AttachedTextFileItem(string FileName, string Content, string? FileUrl = null, long? FileSizeBytes = null);

    private static List<AttachedTextFileItem> ParsePostUploadTextFiles(string codeSnippet, string? codeFileName)
    {
        var list = new List<AttachedTextFileItem>();
        if (string.IsNullOrWhiteSpace(codeSnippet)) return list;

        if (codeSnippet.TrimStart().StartsWith("[") && codeSnippet.Contains("\"FileName\""))
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<AttachedTextFileItem>>(codeSnippet, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (parsed != null && parsed.Count > 0)
                {
                    return parsed;
                }
            }
            catch { }
        }

        list.Add(new AttachedTextFileItem(string.IsNullOrWhiteSpace(codeFileName) ? "attachment.txt" : codeFileName, codeSnippet));
        return list;
    }

    private static string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue || bytes <= 0) return string.Empty;
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes.Value / 1024.0:F1} KB";
        return $"{bytes.Value / (1024.0 * 1024.0):F1} MB";
    }

    private async Task CopyPostUploadSnippetAsync(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success("Copied to clipboard!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to copy: {ex.Message}");
        }
    }

    private bool showTextModal = false;
    private string viewingFileName = "";
    private string viewingFileContent = "";

    private void OpenTextFileModal(string fileName, string content)
    {
        viewingFileName = fileName;
        viewingFileContent = content;
        showTextModal = true;
    }

    private void CloseTextFileModal()
    {
        showTextModal = false;
        viewingFileName = "";
        viewingFileContent = "";
    }
}
