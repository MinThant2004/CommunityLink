    private async Task SubmitCreatePost()
    {
        if (string.IsNullOrWhiteSpace(newPostText) && string.IsNullOrWhiteSpace(uploadedCodeSnippet) && string.IsNullOrWhiteSpace(uploadedImageUrl))
        {
            Toast.Warning(Loc["PostUpload_Val_ContentRequired"]);
            return;
        }

        isSubmitting = true;
        // Optional community: null if 0 (Free public post)
        int? targetCommunityId = null;
        if (selectedSubCommunityId > 0)
        {
            targetCommunityId = selectedSubCommunityId;
        }
        else if (selectedParentCommunityId > 0)
        {
            targetCommunityId = selectedParentCommunityId;
        }

        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };

        var req = new CreatePostRequestModel(
            targetCommunityId,
            newPostText?.Trim() ?? string.Empty,
            images,
            GroupId: null,
            CodeSnippet: uploadedCodeSnippet,
            CodeFileName: uploadedCodeFileName,
            CodeLanguage: !string.IsNullOrWhiteSpace(uploadedCodeSnippet) ? "FILE" : null);

        var res = await PostApi.CreatePostAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["PostUpload_Toast_PostPublished"]);
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_PostCreateFailed"]);
        }
    }

    private async Task SubmitUpdatePost()
    {
        if (string.IsNullOrWhiteSpace(editPostText) && string.IsNullOrWhiteSpace(editCodeSnippet) && string.IsNullOrWhiteSpace(uploadedImageUrl))
        {
            Toast.Warning(Loc["PostUpload_Val_ContentRequired"]);
            return;
        }

        isSubmitting = true;
        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };
        var req = new UpdatePostRequestModel(
            editPostText?.Trim() ?? string.Empty,
            images,
            CodeSnippet: editCodeSnippet,
            CodeFileName: editCodeFileName,
            CodeLanguage: !string.IsNullOrWhiteSpace(editCodeSnippet) ? "FILE" : null);

        var res = await PostApi.UpdatePostAsync(editingPostId, req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["PostUpload_Toast_PostUpdated"]);
            CloseModals();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_PostUpdateFailed"]);
        }
    }

    private void PromptRecyclePost(int postId)
    {
        pendingRecyclePostId = postId;
        showRecycleModal = true;
    }

    private void CloseRecycleModal()
    {
        showRecycleModal = false;
        pendingRecyclePostId = null;
        isRecyclingPost = false;
    }

    private async Task ConfirmRecyclePostAsync()
    {
        if (!pendingRecyclePostId.HasValue) return;

        isRecyclingPost = true;
        var res = await PostApi.DeletePostAsync(pendingRecyclePostId.Value);
        isRecyclingPost = false;

        if (res.IsSuccess)
        {
            Toast.Success(Loc["PostUpload_Toast_PostRecycled"]);
            CloseRecycleModal();
            await LoadFeed();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["PostUpload_Toast_PostRecycleFailed"]);
        }
    }

