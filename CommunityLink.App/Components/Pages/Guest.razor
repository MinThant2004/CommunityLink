@page "/guest"
@page "/welcome"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Loc
@inject IJSRuntime JS

<PageTitle>@Loc["Guest_PageTitle"]</PageTitle>

@* ===== Navbar ===== *@
<nav class="cl-navbar">
    <div class="cl-nav-inner">
        <a href="guest" class="cl-logo">
            <span class="cl-logo-mark">CL</span>
            <span class="cl-logo-text">Community<span class="cl-logo-accent">Link</span></span>
            <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#557392] dark:text-[#C4D2E1] px-2 py-0.5 rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-[#F1F5F9] dark:bg-[#1B3B5A] hidden sm:inline-block">@Loc["Guest_Nav_VerifiedNodeProtocol"]</span>
        </a>

        <div class="cl-nav-links">
            <a href="#features" class="cl-nav-link">@Loc["Guest_Nav_Features"]</a>
            <a href="#how-it-works" class="cl-nav-link">@Loc["Guest_Nav_HowItWorks"]</a>
        </div>

        <div class="cl-nav-actions">
            <LanguageSelector />
            <button class="w-8 h-8 rounded-full flex items-center justify-center text-[#557392] hover:text-[#0A1B2E] dark:text-[#C4D2E1] dark:hover:text-white hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition" @onclick="ToggleTheme" title="@Loc["Guest_Nav_ToggleTheme"]" aria-label="@Loc["Guest_Nav_ToggleTheme"]">
                <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                <svg class="w-4 h-4 hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </button>
            <AuthorizeView>
                <Authorized>
                    <a href="" class="cl-btn cl-btn-primary">@Loc["Guest_Nav_EnterDashboard"]</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="cl-btn cl-btn-ghost">@Loc["Guest_Nav_LogIn"]</a>
                    <a href="register" class="cl-btn cl-btn-primary">@Loc["Guest_Nav_SignUpFree"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@* ===== Hero Section with Three.js Globe ===== *@
<section class="cl-hero">
    <div class="cl-hero-inner">
        <div class="cl-hero-content">
            <div class="cl-hero-badge">
                <span class="cl-badge-dot"></span>
                <span>@Loc["Guest_Hero_Badge"]</span>
            </div>
            <h1 class="cl-hero-title">
                @Loc["Guest_Hero_Title"]<br />
                <span class="cl-hero-title-accent">@Loc["Guest_Hero_TitleAccent"]</span>
            </h1>
            <p class="cl-hero-subtitle">
                @Loc["Guest_Hero_Subtitle"]
            </p>
            <div class="cl-hero-cta">
                <AuthorizeView>
                    <Authorized>
                        <a href="" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            @Loc["Guest_Hero_EnterNodeDashboard"]
                        </a>
                        <a href="communities" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            @Loc["Guest_Hero_ExploreCommunities"]
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            @Loc["Guest_Hero_ProvisionAccount"]
                        </a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            @Loc["Guest_Hero_Authenticate"]
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="cl-hero-stats">
                <div class="cl-stat">
                    <span class="cl-stat-number">27</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatGlobalHubs"]</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">52+</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatActiveNodes"]</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">6</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatContinents"]</span>
                </div>
            </div>
        </div>

        <div class="cl-hero-visual">
            <div class="cl-hero-glow"></div>
            <div id="globe-canvas"></div>
        </div>
    </div>

    <div class="cl-hero-scroll-hint">
        <span>@Loc["Guest_Hero_ScrollToExplore"]</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
</section>

@* ===== Features Section ===== *@
<section class="cl-features" id="features">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">@Loc["Guest_Features_Tag"]</span>
            <h2 class="cl-section-title">@Loc["Guest_Features_Title"]</h2>
            <p class="cl-section-desc">@Loc["Guest_Features_Desc"]</p>
        </div>

        <div class="cl-features-grid">
            <div class="cl-feature-card cl-feature-card-large">
                <div>
                    <div class="cl-feature-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <h3>@Loc["Guest_Feature_Messaging_Title"]</h3>
                    <p>@Loc["Guest_Feature_Messaging_Desc"]</p>
                </div>
                <div class="cl-feature-visual">
                    <div class="cl-chat-bubble cl-chat-left">
                        <div class="cl-chat-avatar">CL</div>
                        <div class="cl-chat-text">@Loc["Guest_Feature_Messaging_DemoLeft"]</div>
                    </div>
                    <div class="cl-chat-bubble cl-chat-right">
                        <div class="cl-chat-text">@Loc["Guest_Feature_Messaging_DemoRight"]</div>
                        <div class="cl-chat-avatar cl-chat-avatar-gold">EV</div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <h3>@Loc["Guest_Feature_Polls_Title"]</h3>
                <p>@Loc["Guest_Feature_Polls_Desc"]</p>
                <div class="cl-poll-visual">
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill" style="width: 72%">
                            <span>@Loc["Guest_Feature_Polls_DemoUpgrade"]</span>
                        </div>
                    </div>
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill cl-poll-fill-secondary" style="width: 28%">
                            <span>@Loc["Guest_Feature_Polls_DemoDeferred"]</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>@Loc["Guest_Feature_Hubs_Title"]</h3>
                <p>@Loc["Guest_Feature_Hubs_Desc"]</p>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                </div>
                <h3>@Loc["Guest_Feature_Broadcast_Title"]</h3>
                <p>@Loc["Guest_Feature_Broadcast_Desc"]</p>
            </div>
        </div>
    </div>
</section>

@* ===== How It Works Section ===== *@
<section class="cl-how" id="how-it-works">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">@Loc["Guest_How_Tag"]</span>
            <h2 class="cl-section-title">@Loc["Guest_How_Title"]</h2>
            <p class="cl-section-desc">@Loc["Guest_How_Desc"]</p>
        </div>

        <div class="cl-steps">
            <div class="cl-step">
                <div class="cl-step-number">01</div>
                <div class="cl-step-content">
                    <h3>@Loc["Guest_How_Step1_Title"]</h3>
                    <p>@Loc["Guest_How_Step1_Desc"]</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">02</div>
                <div class="cl-step-content">
                    <h3>@Loc["Guest_How_Step2_Title"]</h3>
                    <p>@Loc["Guest_How_Step2_Desc"]</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">03</div>
                <div class="cl-step-content">
                    <h3>@Loc["Guest_How_Step3_Title"]</h3>
                    <p>@Loc["Guest_How_Step3_Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== CTA Section ===== *@
<section class="cl-cta">
    <div class="cl-section-inner">
        <div class="cl-cta-box">
            <h2>@Loc["Guest_Cta_Title"]</h2>
            <p>@Loc["Guest_Cta_Subtitle"]</p>
            <div class="cl-cta-actions">
                <AuthorizeView>
                    <Authorized>
                        <a href="" class="cl-btn cl-btn-primary cl-btn-lg">@Loc["Guest_Cta_EnterHomeHub"]</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">@Loc["Guest_Cta_ProvisionFreeNode"]</a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg">@Loc["Guest_Cta_AuthenticateExisting"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</section>

@* ===== Footer ===== *@
<footer class="cl-footer">
    <div class="cl-footer-inner">
        <div class="cl-footer-brand">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">Community<span class="text-[#38BDF8]">Link</span></span>
                <span class="font-mono text-[9px] font-semibold text-[#7A8CA6] dark:text-[#8899A6] px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">@Loc["Guest_Footer_StandardV2"]</span>
            </div>
            <p>@Loc["Guest_Footer_Tagline"]</p>
        </div>
        <div class="cl-footer-meta">
            <span>@Loc["Guest_Footer_BlazorNet10"]</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>@Loc["Guest_Footer_SignalR"]</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>@Loc["Guest_Footer_EnterpriseRbac"]</span>
        </div>
    </div>
</footer>

@code {
    private bool _globeInitialized;

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("themeManager.toggleTheme");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_globeInitialized)
        {
            _globeInitialized = true;
            await JS.InvokeVoidAsync("initGlobe");
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
        }
    }
}
