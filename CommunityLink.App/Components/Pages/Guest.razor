@page "/guest"
@page "/welcome"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Welcome to CommunityLink — Verified Global Community Network</PageTitle>

@* ===== Navbar ===== *@
<nav class="cl-navbar">
    <div class="cl-nav-inner">
        <a href="guest" class="cl-logo">
            <span class="cl-logo-mark">CL</span>
            <span class="cl-logo-text">Community<span class="cl-logo-accent">Link</span></span>
            <span class="font-mono text-[9px] font-semibold uppercase tracking-wider text-[#557392] dark:text-[#C4D2E1] px-2 py-0.5 rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] bg-[#F1F5F9] dark:bg-[#1B3B5A] hidden sm:inline-block">VERIFIED NODE PROTOCOL</span>
        </a>

        <div class="cl-nav-links">
            <a href="#features" class="cl-nav-link">Features</a>
            <a href="#how-it-works" class="cl-nav-link">How It Works</a>
        </div>

        <div class="cl-nav-actions">
            <button class="w-8 h-8 rounded-full flex items-center justify-center text-[#557392] hover:text-[#0A1B2E] dark:text-[#C4D2E1] dark:hover:text-white hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition" @onclick="ToggleTheme" title="Toggle Theme" aria-label="Toggle Theme">
                <span class="dark:hidden text-sm">🌙</span>
                <span class="hidden dark:inline text-sm">☀️</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <a href="" class="cl-btn cl-btn-primary">Enter Dashboard</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="cl-btn cl-btn-ghost">Log In</a>
                    <a href="register" class="cl-btn cl-btn-primary">Sign Up Free</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@* ===== Hero Section with Three.js Globe ===== *@
<section class="cl-hero">
    <div class="cl-hero-inner">
        <div class="cl-hero-content">
            <div class="cl-hero-badge">
                <span class="cl-badge-dot"></span>
                <span>VERIFIED GLOBAL HUBS · ENCRYPTED SIGNALR</span>
            </div>
            <h1 class="cl-hero-title">
                One Platform.<br />
                <span class="cl-hero-title-accent">Every Community.</span>
            </h1>
            <p class="cl-hero-subtitle">
                Connect, collaborate, and exchange ideas with verified peers across global hubs.
                Real-time messaging, consensus polls, and institutional workspaces in a unified interface.
            </p>
            <div class="cl-hero-cta">
                <AuthorizeView>
                    <Authorized>
                        <a href="" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Enter Node Dashboard
                        </a>
                        <a href="communities" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Explore Communities
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            Provision Account
                        </a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            Authenticate
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="cl-hero-stats">
                <div class="cl-stat">
                    <span class="cl-stat-number">27</span>
                    <span class="cl-stat-label">Global Hubs</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">52+</span>
                    <span class="cl-stat-label">Active Nodes</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">6</span>
                    <span class="cl-stat-label">Continents</span>
                </div>
            </div>
        </div>

        <div class="cl-hero-visual">
            <div class="cl-hero-glow"></div>
            <div id="globe-canvas"></div>
        </div>
    </div>

    <div class="cl-hero-scroll-hint">
        <span>SCROLL TO EXPLORE</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
</section>

@* ===== Features Section ===== *@
<section class="cl-features" id="features">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">COLLABORATIVE ARCHITECTURE</span>
            <h2 class="cl-section-title">Institutional Features for Global Hubs</h2>
            <p class="cl-section-desc">From encrypted real-time messaging to democratic consensus voting — engineered for sovereign communities.</p>
        </div>

        <div class="cl-features-grid">
            <div class="cl-feature-card cl-feature-card-large">
                <div>
                    <div class="cl-feature-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <h3>Real-Time Encrypted Messaging</h3>
                    <p>Sub-second SignalR direct messaging and threaded room conversations. Zero latency, peer-verified protocol with instant synchronization.</p>
                </div>
                <div class="cl-feature-visual">
                    <div class="cl-chat-bubble cl-chat-left">
                        <div class="cl-chat-avatar">CL</div>
                        <div class="cl-chat-text">Frontier Intelligence forum session scheduled for 15:00 UTC.</div>
                    </div>
                    <div class="cl-chat-bubble cl-chat-right">
                        <div class="cl-chat-text">Node attendance confirmed. Syncing briefing payload.</div>
                        <div class="cl-chat-avatar cl-chat-avatar-gold">EV</div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <h3>Consensus Polls &amp; Ballots</h3>
                <p>Execute real-time community polls with single or ranked voting. Live telemetry visualizes voter distribution instantly.</p>
                <div class="cl-poll-visual">
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill" style="width: 72%">
                            <span>PROTOCOL UPGRADE 72%</span>
                        </div>
                    </div>
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill cl-poll-fill-secondary" style="width: 28%">
                            <span>DEFERRED 28%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Tiered Community Hubs</h3>
                <p>Structured hierarchies for parent hubs and specialized sub-communities with granular RBAC permissions.</p>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                </div>
                <h3>Synchronized Broadcast Feeds</h3>
                <p>Broadcast updates, rich media, and announcements directly to connected node feeds with comment governance.</p>
            </div>
        </div>
    </div>
</section>

@* ===== How It Works Section ===== *@
<section class="cl-how" id="how-it-works">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">ONBOARDING PROTOCOL</span>
            <h2 class="cl-section-title">Establish Your Node in 3 Steps</h2>
            <p class="cl-section-desc">Get connected to the verified network seamlessly without friction.</p>
        </div>

        <div class="cl-steps">
            <div class="cl-step">
                <div class="cl-step-number">01</div>
                <div class="cl-step-content">
                    <h3>Provision Identity</h3>
                    <p>Create your verified member account with email validation and cryptographic node profile.</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">02</div>
                <div class="cl-step-content">
                    <h3>Join Hubs &amp; Spaces</h3>
                    <p>Select from curated global hubs, specialized interest groups, and verified circles.</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">03</div>
                <div class="cl-step-content">
                    <h3>Engage &amp; Collaborate</h3>
                    <p>Participate in encrypted discussions, cast votes in consensus polls, and build your reputation.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== CTA Section ===== *@
<section class="cl-cta">
    <div class="cl-section-inner">
        <div class="cl-cta-box">
            <h2>Ready to Connect to the Protocol?</h2>
            <p>Join thousands of professionals, researchers, and creators across 27 global hubs.</p>
            <div class="cl-cta-actions">
                <AuthorizeView>
                    <Authorized>
                        <a href="" class="cl-btn cl-btn-primary cl-btn-lg">Enter Home Hub &rarr;</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">Provision Free Node &rarr;</a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg">Authenticate Existing Node</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</section>

@* ===== Footer ===== *@
<footer class="cl-footer">
    <div class="cl-footer-inner">
        <div class="cl-footer-brand">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-[#0A1B2E] dark:text-white" style="font-family:'Manrope',sans-serif">Community<span class="text-[#38BDF8]">Link</span></span>
                <span class="font-mono text-[9px] font-semibold text-[#7A8CA6] dark:text-[#8899A6] px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">STANDARD V2.0</span>
            </div>
            <p>Connecting verified global communities with institutional precision.</p>
        </div>
        <div class="cl-footer-meta">
            <span>BLAZOR &amp; .NET 10</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>SIGNALR REAL-TIME</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>ENTERPRISE RBAC</span>
        </div>
    </div>
</footer>

@code {
    private bool _globeInitialized;

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("themeManager.toggleTheme");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_globeInitialized)
        {
            _globeInitialized = true;
            await JS.InvokeVoidAsync("initGlobe");
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
        }
    }
}
