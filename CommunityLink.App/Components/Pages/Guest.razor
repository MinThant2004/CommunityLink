@page "/guest"
@page "/welcome"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Loc
@inject IJSRuntime JS

<PageTitle>@Loc["Guest_PageTitle"]</PageTitle>

<style>
    /* Strictly lock Guest Page to Dark Mode */
    html, body, .landing-page {
        background-color: #0A1B2E !important;
        color: #FFFFFF !important;
    }
    .landing-page {
        --cl-bg: #0A1B2E !important;
        --cl-bg-elevated: #112A46 !important;
        --cl-bg-card: #112A46 !important;
        --cl-surface: #153252 !important;
        --cl-border: rgba(196, 210, 225, 0.14) !important;
        --cl-border-subtle: rgba(196, 210, 225, 0.08) !important;
        --cl-text: #FFFFFF !important;
        --cl-text-secondary: #C4D2E1 !important;
        --cl-text-muted: #8899A6 !important;
        --cl-primary: #38BDF8 !important;
    }
    .cl-navbar {
        background: rgba(10, 27, 46, 0.88) !important;
        backdrop-filter: blur(16px) saturate(1.4) !important;
        -webkit-backdrop-filter: blur(16px) saturate(1.4) !important;
        border-bottom-color: rgba(196, 210, 225, 0.12) !important;
    }
    .cl-hero {
        background: radial-gradient(circle at 85% 40%, rgba(27, 59, 90, 0.45) 0%, transparent 60%),
                    radial-gradient(circle at 15% 20%, rgba(56, 189, 248, 0.12) 0%, transparent 50%),
                    #0A1B2E !important;
    }
    .cl-features, .cl-how, .cl-cta, .cl-footer {
        background: #0A1B2E !important;
    }
    .cl-feature-card {
        background: #112A46 !important;
        border-color: rgba(196, 210, 225, 0.12) !important;
        transition: all 0.25s ease;
    }
    .cl-feature-card:hover {
        border-color: rgba(56, 189, 248, 0.35) !important;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.5), 0 0 16px rgba(56, 189, 248, 0.08) !important;
        transform: translateY(-2px);
    }
    .cl-cta-box {
        background: linear-gradient(180deg, #132E4D 0%, #0F243E 100%) !important;
        border: 1px solid rgba(56, 189, 248, 0.25) !important;
        box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.5), 0 0 30px rgba(56, 189, 248, 0.06) !important;
    }
</style>

@* ===== Navbar ===== *@
<nav class="cl-navbar">
    <div class="cl-nav-inner">
        <a href="guest" class="cl-logo">
            <span class="cl-logo-mark bg-gradient-to-br from-sky-400 via-blue-500 to-indigo-600 shadow-md shadow-sky-500/20 text-white font-black text-sm rounded-lg flex items-center justify-center">CL</span>
            <span class="cl-logo-text text-white">Community<span class="bg-gradient-to-r from-sky-400 to-cyan-300 bg-clip-text text-transparent">Link</span></span>
            <span class="font-mono text-[9px] font-bold uppercase tracking-wider text-sky-300 px-2.5 py-1 rounded-full border border-sky-500/30 bg-sky-500/10 shadow-xs hidden sm:inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                @Loc["Guest_Nav_VerifiedNodeProtocol"]
            </span>
        </a>

        <div class="cl-nav-links">
            <a href="#features" class="cl-nav-link text-slate-300 hover:text-white">@Loc["Guest_Nav_Features"]</a>
            <a href="#how-it-works" class="cl-nav-link text-slate-300 hover:text-white">@Loc["Guest_Nav_HowItWorks"]</a>
        </div>

        <div class="cl-nav-actions">
            <LanguageSelector />
            <AuthorizeView>
                <Authorized>
                    <a href="" class="cl-btn cl-btn-primary bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold border-0 shadow-md shadow-sky-500/20">@Loc["Guest_Nav_EnterDashboard"]</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="cl-btn cl-btn-ghost text-slate-300 hover:text-white hover:bg-slate-800/50">@Loc["Guest_Nav_LogIn"]</a>
                    <a href="register" class="cl-btn cl-btn-primary bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold border-0 shadow-md shadow-sky-500/20">@Loc["Guest_Nav_SignUpFree"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@* ===== Hero Section with Three.js Globe ===== *@
<section class="cl-hero">
    <div class="cl-hero-inner">
        <div class="cl-hero-content">
            <div class="cl-hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-gradient-to-r from-sky-500/10 via-indigo-500/10 to-purple-500/10 text-sky-300 font-mono text-[11px] font-semibold tracking-wider shadow-sm backdrop-blur-sm">
                <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_#38bdf8] animate-pulse"></span>
                <span>@Loc["Guest_Hero_Badge"]</span>
            </div>
            <h1 class="cl-hero-title">
                @Loc["Guest_Hero_Title"]<br />
                <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-teal-300 bg-clip-text text-transparent">@Loc["Guest_Hero_TitleAccent"]</span>
            </h1>
            <p class="cl-hero-subtitle text-[#94A3B8]">
                @Loc["Guest_Hero_Subtitle"]
            </p>
            <div class="cl-hero-cta">
                <AuthorizeView>
                    <Authorized>
                        <a href="" class="cl-btn cl-btn-primary cl-btn-lg bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold shadow-lg shadow-sky-500/25 border-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
@Loc["Guest_Hero_EnterNodeDashboard"]
                        </a>
                        <a href="communities" class="cl-btn cl-btn-outline cl-btn-lg border-slate-700 hover:border-sky-500/50 text-slate-200 hover:text-white bg-slate-900/60 backdrop-blur-sm">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            @Loc["Guest_Hero_ExploreCommunities"]
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold shadow-lg shadow-sky-500/25 border-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
@Loc["Guest_Hero_ProvisionAccount"]
                        </a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg border-slate-700 hover:border-sky-500/50 text-slate-200 hover:text-white bg-slate-900/60 backdrop-blur-sm">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
@Loc["Guest_Hero_Authenticate"]
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="cl-hero-stats">
                <div class="cl-stat">
                    <span class="cl-stat-number">27</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatGlobalHubs"]</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">52+</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatActiveNodes"]</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">6</span>
                    <span class="cl-stat-label">@Loc["Guest_Hero_StatContinents"]</span>
                </div>
            </div>
        </div>

        <div class="cl-hero-visual">
            <div class="cl-hero-glow"></div>
            <div id="globe-canvas"></div>
        </div>
    </div>

    <div class="cl-hero-scroll-hint text-slate-400">
        <span>@Loc["Guest_Hero_ScrollToExplore"]</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
</section>

@* ===== Features Section ===== *@
<section class="cl-features" id="features">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold uppercase tracking-widest text-sky-400 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/25">@Loc["Guest_Features_Tag"]</span>
            <h2 class="cl-section-title text-2xl sm:text-3xl font-extrabold text-white mt-3 mb-2">@Loc["Guest_Features_Title"]</h2>
            <p class="cl-section-subtitle text-[#94A3B8] text-sm max-w-xl mx-auto">@Loc["Guest_Features_Subtitle"]</p>
        </div>

        <div class="cl-features-grid">
            <div class="cl-feature-card cl-feature-card-large">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-sky-500/20 to-blue-600/20 border border-sky-500/30 text-sky-400 flex items-center justify-center shadow-sm mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <h3 class="text-white text-lg font-bold mb-2">@Loc["Guest_Feature_Messaging_Title"]</h3>
                    <p class="text-[#94A3B8] text-sm leading-relaxed">@Loc["Guest_Feature_Messaging_Desc"]</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/25">1-on-1 Direct Chat</span>
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-500/10 text-blue-300 border border-blue-500/25">Group Chat Rooms</span>
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/25">Real-Time Presence</span>
                    </div>
                </div>
                <div class="cl-feature-visual mt-6 sm:mt-0">
                    <div class="cl-chat-bubble cl-chat-left mb-3">
                        <div class="cl-chat-avatar bg-sky-500/20 text-sky-300 border border-sky-500/30 font-bold">CL</div>
                        <div class="cl-chat-text bg-slate-800/80 border border-slate-700/80 text-slate-200">
                            @Loc["Guest_Feature_Messaging_DemoLeft"]
                        </div>
                    </div>
                    <div class="cl-chat-bubble cl-chat-right">
                        <div class="cl-chat-text bg-gradient-to-r from-sky-600 to-blue-600 border border-sky-500/40 text-white shadow-sm">
                            @Loc["Guest_Feature_Messaging_DemoRight"]
                        </div>
                        <div class="cl-chat-avatar bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold">MK</div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-orange-600/20 border border-amber-500/30 text-amber-400 flex items-center justify-center shadow-sm mb-4">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <h3 class="text-white text-base font-bold mb-2">@Loc["Guest_Feature_Polls_Title"]</h3>
                <p class="text-[#94A3B8] text-sm leading-relaxed">@Loc["Guest_Feature_Polls_Desc"]</p>
                <div class="mt-4 flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/25">Live Community Voting</span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/25">Instant Percentage Tally</span>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-indigo-600/20 border border-purple-500/30 text-purple-400 flex items-center justify-center shadow-sm mb-4">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3 class="text-white text-base font-bold mb-2">@Loc["Guest_Feature_Hubs_Title"]</h3>
                <p class="text-[#94A3B8] text-sm leading-relaxed">@Loc["Guest_Feature_Hubs_Desc"]</p>
                <div class="mt-4 flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-500/10 text-purple-300 border border-purple-500/25">Parent &amp; Sub-Spaces</span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/25">Role Governance</span>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-teal-600/20 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shadow-sm mb-4">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                </div>
                <h3 class="text-white text-base font-bold mb-2">@Loc["Guest_Feature_Broadcast_Title"]</h3>
                <p class="text-[#94A3B8] text-sm leading-relaxed">@Loc["Guest_Feature_Broadcast_Desc"]</p>
                <div class="mt-4 flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/25">Rich Media &amp; Photos</span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/25">Threaded Comments</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== How It Works Section ===== *@
<section class="cl-how" id="how-it-works">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold uppercase tracking-widest text-indigo-400 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/25">@Loc["Guest_How_Tag"]</span>
            <h2 class="cl-section-title text-2xl sm:text-3xl font-extrabold text-white mt-3 mb-2">@Loc["Guest_How_Title"]</h2>
            <p class="cl-section-subtitle text-[#94A3B8] text-sm max-w-xl mx-auto">@Loc["Guest_How_Subtitle"]</p>
        </div>

        <div class="cl-steps">
            <div class="cl-step">
                <div class="cl-step-number bg-gradient-to-br from-sky-400 to-blue-500 bg-clip-text text-transparent font-extrabold text-3xl mb-2">01</div>
                <div class="cl-step-content">
                    <h3 class="text-white font-bold text-base mb-1">@Loc["Guest_How_Step1_Title"]</h3>
                    <p class="text-[#94A3B8] text-xs leading-relaxed">@Loc["Guest_How_Step1_Desc"]</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number bg-gradient-to-br from-indigo-400 to-purple-500 bg-clip-text text-transparent font-extrabold text-3xl mb-2">02</div>
                <div class="cl-step-content">
                    <h3 class="text-white font-bold text-base mb-1">@Loc["Guest_How_Step2_Title"]</h3>
                    <p class="text-[#94A3B8] text-xs leading-relaxed">@Loc["Guest_How_Step2_Desc"]</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number bg-gradient-to-br from-emerald-400 to-teal-500 bg-clip-text text-transparent font-extrabold text-3xl mb-2">03</div>
                <div class="cl-step-content">
                    <h3 class="text-white font-bold text-base mb-1">@Loc["Guest_How_Step3_Title"]</h3>
                    <p class="text-[#94A3B8] text-xs leading-relaxed">@Loc["Guest_How_Step3_Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== CTA Section ===== *@
<section class="cl-cta">
    <div class="cl-section-inner">
        <div class="cl-cta-box rounded-2xl p-8 sm:p-12 text-center relative overflow-hidden">
            <div class="absolute -top-24 -left-24 w-72 h-72 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">@Loc["Guest_Cta_Title"]</h2>
            <p class="text-[#94A3B8] text-sm max-w-xl mx-auto mb-6 leading-relaxed">@Loc["Guest_Cta_Subtitle"]</p>
            <div class="cl-cta-actions flex flex-wrap items-center justify-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <a href="communities" class="cl-btn cl-btn-primary cl-btn-lg bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold shadow-lg shadow-sky-500/25 border-0">
                            @Loc["Guest_Cta_EnterHomeHub"] &rarr;
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold shadow-lg shadow-sky-500/25 border-0">
                            @Loc["Guest_Cta_ProvisionFreeNode"] &rarr;
                        </a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg border-slate-700 hover:border-sky-500/50 text-slate-200 hover:text-white bg-slate-900/60 backdrop-blur-sm">
                            @Loc["Guest_Cta_AuthenticateExisting"]
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</section>

@* ===== Footer ===== *@
<footer class="cl-footer">
    <div class="cl-footer-inner">
        <div class="cl-footer-brand">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-white" style="font-family:'Manrope',sans-serif">Community<span class="text-[#38BDF8]">Link</span></span>
                <span class="font-mono text-[9px] font-bold text-sky-300 px-2 py-0.5 rounded-full bg-sky-500/10 border border-sky-500/25">@Loc["Guest_Footer_StandardV2"]</span>
            </div>
            <p class="text-[#8899A6] text-xs mt-1">@Loc["Guest_Footer_Tagline"]</p>
        </div>
        <div class="cl-footer-meta font-mono text-[10px] text-[#8899A6] flex items-center gap-2 flex-wrap">
            <span class="text-sky-300 font-semibold">@Loc["Guest_Footer_BlazorNet10"]</span>
            <span class="cl-footer-dot text-slate-600">&middot;</span>
            <span class="text-emerald-300 font-semibold">@Loc["Guest_Footer_SignalR"]</span>
            <span class="cl-footer-dot text-slate-600">&middot;</span>
            <span class="text-purple-300 font-semibold">@Loc["Guest_Footer_EnterpriseRbac"]</span>
        </div>
    </div>
</footer>

@code {
    private bool _globeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Enforce dark mode on the document element for the guest page
            try
            {
                await JS.InvokeVoidAsync("document.documentElement.classList.add", "dark");
            }
            catch { }

            if (!_globeInitialized)
            {
                _globeInitialized = true;
                await JS.InvokeVoidAsync("initGlobe");
            }
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
        }
    }
}
