@page "/activity"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Activity — CommunityLink</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div>
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
            Activity
        </h1>
        <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">A running log of your interactions across the ecosystem.</p>
    </div>

    <!-- Placeholder -->
    <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm">
        <span class="w-12 h-12 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1] mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </span>
        <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Not developed yet</h3>
        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1 max-w-sm text-center leading-relaxed">
            The activity log is coming soon. Once live, it will show your posts, joins, likes, and other updates in one place.
        </p>
        <span class="mt-4 px-2.5 py-1 rounded font-mono text-[10px] uppercase tracking-wider text-[#557392] dark:text-[#C4D2E1] bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">
            status — planned
        </span>
    </div>
</div>