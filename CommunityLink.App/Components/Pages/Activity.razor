@page "/activity"
@rendermode InteractiveServer
@attribute [Authorize]
@using CommunityLink.App.Apis
@using CommunityLink.Shared.Features.Activity
@inject UserActivityApiService ActivityApi
@inject ToastService Toast

<PageTitle>Activity — CommunityLink</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                Activity Log
            </h1>
            <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">A running chronological record of your likes, comments, shares, and group activities.</p>
        </div>
        <button type="button" @onclick="LoadActivitiesAsync" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-[#112A46] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition shadow-sm cursor-pointer">
            🔄 Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-[#557392] dark:text-[#C4D2E1] bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent mb-3"></div>
            <p class="text-xs font-medium">Loading your activity history...</p>
        </div>
    }
    else if (activities == null || !activities.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm text-center px-4">
            <span class="w-12 h-12 rounded-2xl bg-[#F1F5F9] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1] mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </span>
            <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No activities recorded yet</h3>
            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1 max-w-sm leading-relaxed">
                When you like posts, leave comments, share posts, or manage groups, your audit logs will appear here.
            </p>
        </div>
    }
    else
    {
        <!-- Activities List Grouped by Date -->
        <div class="space-y-6">
            @foreach (var dateGroup in GroupedActivities)
            {
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#7A8CA6] font-mono">@dateGroup.Key</span>
                        <div class="flex-1 h-px bg-[#E2E8F0] dark:bg-[rgba(196,210,225,0.12)]"></div>
                    </div>

                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] shadow-sm divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.12)] overflow-hidden">
                        @foreach (var act in dateGroup.Value)
                        {
                            <div class="p-4 flex items-center justify-between gap-4 hover:bg-[#F8FAFC] dark:hover:bg-[#0A1B2E]/50 transition">
                                <div class="flex items-center gap-3.5 min-w-0">
                                    <span class="w-9 h-9 rounded-xl flex items-center justify-center text-sm shrink-0 @GetBadgeClass(act.ActivityType)">
                                        @GetIcon(act.ActivityType)
                                    </span>
                                    <div class="min-w-0">
                                        <p class="text-xs sm:text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] truncate">
                                            @act.Description
                                        </p>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-[11px] text-[#7A8CA6] font-mono">
                                                @act.CreatedAt.ToString("hh:mm tt")
                                            </span>
                                            <span class="text-[10px] text-[#7A8CA6]">&bull;</span>
                                            <span class="text-[10px] uppercase font-mono font-bold text-[#557392] dark:text-[#C4D2E1]">
                                                @act.ActivityType
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="shrink-0">
                                    <button type="button" @onclick="() => PromptDelete(act)"
                                            class="px-2.5 py-1 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-transparent hover:border-rose-200 dark:hover:border-rose-900/50 rounded-lg transition cursor-pointer flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- DELETE CONFIRMATION MODAL -->
@if (activityToDelete != null)
{
    <div class="fixed inset-0 z-50 bg-[#0A1B2E]/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-2xl max-w-sm w-full p-6 shadow-2xl space-y-4 text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg shrink-0">
                    🗑️
                </span>
                <div>
                    <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Delete Activity Log</h3>
                    <p class="text-xs text-[#7A8CA6] mt-0.5">Remove this item from your timeline?</p>
                </div>
            </div>

            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] rounded-xl p-3 leading-relaxed">
                "@activityToDelete.Description"
                <br />
                <span class="text-[10px] text-[#7A8CA6] mt-1 block">Note: This only removes the activity log record; it does not undo or unlike the underlying post or group.</span>
            </p>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" @onclick="CancelDelete" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-[#0A1B2E] text-[#557392] dark:text-[#C4D2E1] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F1F5F9] dark:hover:bg-[#182030] transition">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDeleteAsync" disabled="@isDeleting" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 disabled:opacity-50 transition">
                    @(isDeleting ? "Deleting..." : "Delete Record")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isDeleting = false;
    private List<UserActivityModel> activities = new();
    private UserActivityModel? activityToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadActivitiesAsync();
    }

    private async Task LoadActivitiesAsync()
    {
        isLoading = true;
        var res = await ActivityApi.GetMyActivitiesAsync();
        if (res.IsSuccess && res.Data != null)
        {
            activities = res.Data.ToList();
        }
        else
        {
            activities = new();
        }
        isLoading = false;
    }

    private IEnumerable<KeyValuePair<string, List<UserActivityModel>>> GroupedActivities =>
        activities
            .GroupBy(a => a.CreatedAt.Date == DateTime.UtcNow.Date ? "Today" :
                          a.CreatedAt.Date == DateTime.UtcNow.Date.AddDays(-1) ? "Yesterday" :
                          a.CreatedAt.ToString("MMM dd, yyyy"))
            .Select(g => new KeyValuePair<string, List<UserActivityModel>>(g.Key, g.ToList()));

    private void PromptDelete(UserActivityModel act)
    {
        activityToDelete = act;
    }

    private void CancelDelete()
    {
        activityToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (activityToDelete == null) return;
        isDeleting = true;

        var res = await ActivityApi.DeleteActivityAsync(activityToDelete.ActivityId);
        if (res.IsSuccess)
        {
            activities.RemoveAll(a => a.ActivityId == activityToDelete.ActivityId);
            Toast.Show("Activity log removed.");
        }
        else
        {
            Toast.Show(res.Message ?? "Failed to delete activity log.", ToastLevel.Error);
        }

        activityToDelete = null;
        isDeleting = false;
    }

    private static string GetIcon(string type) => type?.ToUpperInvariant() switch
    {
        "LIKE" => "❤️",
        "COMMENT" => "💬",
        "SHARE" => "🔁",
        "GROUP_CREATE" => "👥",
        "GROUP_JOIN_REVIEW" => "🛡️",
        _ => "⚡"
    };

    private static string GetBadgeClass(string type) => type?.ToUpperInvariant() switch
    {
        "LIKE" => "bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/40",
        "COMMENT" => "bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/40",
        "SHARE" => "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40",
        "GROUP_CREATE" => "bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/40",
        "GROUP_JOIN_REVIEW" => "bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-900/40",
        _ => "bg-slate-100 dark:bg-[#0A1B2E] text-slate-700 dark:text-slate-300 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)]"
    };
}