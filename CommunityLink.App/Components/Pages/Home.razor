    private async Task HandleComposerMultipleTextFilesSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(maximumFileCount: 10);
        if (files == null || files.Count == 0) return;

        try
        {
            isReadingTextFile = true;
            foreach (var file in files)
            {
                if (!file.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                {
                    Toast.Error($"'{file.Name}' skipped: Only plain text (.txt) files are allowed.");
                    continue;
                }

                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                composerTextFiles.Add(new AttachedTextFileItem(file.Name, content));
            }
            Toast.Success($"{composerTextFiles.Count} text file(s) attached.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to read text file(s): {ex.Message}");
        }
        finally
        {
            isReadingTextFile = false;
        }
    }

