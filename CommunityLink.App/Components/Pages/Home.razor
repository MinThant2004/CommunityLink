                                    <span>Broadcast Post</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Section: Cross-Ecosystem Broadcasts (Activity Stream) -->
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                            <h2 class="exec-display text-base font-bold text-[#0A1B2E]">Cross-Ecosystem Broadcasts</h2>
                        </div>
                        <span class="exec-badge-standard">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            Live Stream
                        </span>
                    </div>

                    @if (!dashboard.RecentPosts.Any())
                    {
                        <div class="exec-card p-10 text-center space-y-2">
                            <span class="w-12 h-12 rounded-[0.5rem] bg-[#E3EFFF] border border-[#C4D2E1] text-[#34506D] flex items-center justify-center mx-auto">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                            </span>
                            <h3 class="exec-display font-bold text-sm text-[#0A1B2E]">No broadcasts published yet</h3>
