                                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                            </span>
                            <p class="text-sm font-medium text-[#557392]">You have not joined any community hubs yet.</p>
                            <a href="communities" class="exec-btn-primary text-xs">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <span>Discover Communities</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var community in dashboard.JoinedCommunities.Take(2))
                            {
                                <div class="exec-card p-5 space-y-4 flex flex-col justify-between">
                                    <div class="space-y-2.5">
                                        <div class="flex items-center justify-between">
                                            <span class="exec-badge-blue">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#34506D]"></span>
                                                TIER 1 HUB
                                            </span>
                                            <span class="exec-mono text-[11px] text-[#7A8CA6] inline-flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                                <span>@community.MemberCount members</span>
                                            </span>
                                        </div>

                                        <h3 class="exec-display text-base font-bold text-[#0A1B2E] tracking-tight">@community.Name</h3>
                                        <p class="text-xs text-[#557392] line-clamp-2 leading-relaxed">
