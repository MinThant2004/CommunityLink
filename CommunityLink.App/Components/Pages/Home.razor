@page "/"
@page "/home"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.IO
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserDashboardApiService DashboardApi
@inject PostApiService PostApi
@inject GroupApiService GroupApi
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast
@inject IWebHostEnvironment Environment

<PageTitle>Home — CommunityLink</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">
                Home
            </h1>
            <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-1">
                @(dashboard?.Profile != null ? $"Welcome back, {dashboard.Profile.DisplayName}." : "Welcome back.")
                Post updates, connect with people, and explore groups.
            </p>
        </div>
    </div>

    <!-- Posts / People / Groups Tabs -->
    <div class="inline-flex items-center gap-0.5 p-1 rounded bg-[#F1F5F9] dark:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
        <button type="button" @onclick='() => SetTab("posts")'
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold transition @(activeTab == "posts" ? "bg-[#0A1B2E] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            <span>Posts</span>
            <span class="px-1.5 py-0.5 rounded font-mono text-[10px] font-bold @(activeTab == "posts" ? "bg-white/20 dark:bg-[#0A1B2E]/10" : "bg-[#E2E8F0] dark:bg-[#1B3B5A]")">@(dashboard?.RecentPosts.Count ?? 0)</span>
        </button>
        <button type="button" @onclick='() => SetTab("people")'
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold transition @(activeTab == "people" ? "bg-[#0A1B2E] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>People</span>
            <span class="px-1.5 py-0.5 rounded font-mono text-[10px] font-bold @(activeTab == "people" ? "bg-white/20 dark:bg-[#0A1B2E]/10" : "bg-[#E2E8F0] dark:bg-[#1B3B5A]")">@(dashboard?.People.Count ?? 0)</span>
        </button>
        <button type="button" @onclick='() => SetTab("groups")'
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded text-xs font-semibold transition @(activeTab == "groups" ? "bg-[#0A1B2E] text-white dark:bg-[#E1E8F0] dark:text-[#0A1B2E] shadow-sm" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Groups</span>
            <span class="px-1.5 py-0.5 rounded font-mono text-[10px] font-bold @(activeTab == "groups" ? "bg-white/20 dark:bg-[#0A1B2E]/10" : "bg-[#E2E8F0] dark:bg-[#1B3B5A]")">@(groups?.Count ?? 0)</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
            <div class="animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-3 font-medium">Loading home...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="p-4 rounded bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300 text-xs">@errorMessage</div>
    }
    else if (activeTab == "posts")
    {
        <!-- ============ POSTS TAB ============ -->
        <div class="max-w-2xl mx-auto space-y-4">
            <!-- Quick Composer -->
            <div id="quick-composer" class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 space-y-3 shadow-sm">
                <div class="flex items-start gap-3">
                    <span class="w-9 h-9 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1] shrink-0">
                        @if (!string.IsNullOrEmpty(dashboard?.Profile.AvatarUrl))
                        {
                            <img src="@dashboard.Profile.AvatarUrl" alt="You" class="w-full h-full rounded-lg object-cover" />
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        }
                    </span>
                    <textarea rows="2" @bind="newPostContent"
                              placeholder="Share an update with your ecosystem..."
                              class="flex-1 text-xs bg-transparent text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] outline-none resize-none leading-relaxed border border-transparent focus:border-[#CBD5E1] dark:focus:border-[rgba(196,210,225,0.20)] rounded p-2 transition"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(uploadedImageUrl))
                {
                    <div class="relative inline-block rounded overflow-hidden border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                        <img src="@uploadedImageUrl" alt="Attachment" class="max-h-52 object-cover rounded" />
                        <button type="button" @onclick="RemoveUploadedImage"
                                class="absolute top-1 right-1 bg-rose-600 text-white rounded-full p-1 shadow hover:bg-rose-700 transition">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                }

                <div class="flex items-center justify-between gap-2 pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div class="flex items-center gap-2">
                        <select @bind="composerCommunityId" class="text-[11px] bg-white dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15">
                            <option value="0">Public — Standalone</option>
                            @if (dashboard?.JoinedCommunities != null)
                            {
                                @foreach (var community in dashboard.JoinedCommunities)
                                {
                                    <option value="@community.CommunityId">@community.Name</option>
                                }
                            }
                        </select>
                        <InputFile id="postImageInput" OnChange="HandleFileSelected" accept="image/*" class="hidden" />
                        <label for="postImageInput"
                               title="Attach image"
                               class="p-1.5 rounded bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] text-[#557392] dark:text-[#C4D2E1] transition cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (isUploadingImage)
                        {
                            <span class="text-[10px] text-[#7A8CA6]">Uploading...</span>
                        }
                        <button type="button" @onclick="PublishPostAsync" disabled="@(isPublishingPost || string.IsNullOrWhiteSpace(newPostContent))"
                                class="px-4 py-1.5 text-xs font-semibold rounded text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition shadow-sm disabled:opacity-40 disabled:cursor-not-allowed">
                            @(isPublishingPost ? "Publishing..." : "Post")
                        </button>
                    </div>
                </div>
            </div>

            <!-- Feed -->
            @if (dashboard?.RecentPosts == null || dashboard.RecentPosts.Count == 0)
            {
                <div class="text-center py-14 bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)]">
                    <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center mx-auto mb-3">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                    </span>
                    <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No recent posts</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Start the conversation with your first update above.</p>
                </div>
            }
            else
            {
                @foreach (var post in dashboard.RecentPosts)
                {
                    var isOwner = currentUserId.HasValue && post.AuthorId == currentUserId.Value;
                    <article class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 shadow-sm">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                @if (!string.IsNullOrEmpty(post.AuthorAvatar))
                                {
                                    <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-8 h-8 rounded-lg object-cover border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]" />
                                }
                                else
                                {
                                    <span class="w-8 h-8 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1] text-xs font-bold">@(string.IsNullOrWhiteSpace(post.AuthorName) ? "?" : post.AuthorName.Substring(0, 1).ToUpper())</span>
                                }
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5">
                                        <a href="/u/@post.AuthorName" class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-[#557392] dark:hover:text-white truncate transition">@post.AuthorName</a>
                                        @if (post.IsAuthorVerified)
                                        {
                                            <svg class="w-3 h-3 text-blue-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 2.4 3.4-.5 1 3.3 3.2 1.2-.8 3.3 2.2 2.6-2.6 2.2.6 3.4-3.3 1-1.5 3.1-3.2-1.2L12 23l-2.9-2.4L6 21.7 5 18.3l-3-1.2.8-3.3L0 11.2l2.6-2.2-1-3.3 3.3-1 .8-3.2L9.1 2.6 12 0z"/><path d="M10.5 12.6l-2-2-1.6 1.6 3.6 3.6 6.4-6.4-1.6-1.6z" fill="#fff"/></svg>
                                        }
                                    </div>
                                    <span class="text-[10px] text-[#7A8CA6] font-mono">@post.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                </div>
                            </div>
                            @if (isOwner)
                            {
                                <div class="relative shrink-0">
                                    <button type="button" @onclick="() => TogglePostMenu(post.PostId)" class="p-1.5 rounded text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition cursor-pointer">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                                    </button>
                                    @if (activeMenuPostId == post.PostId)
                                    {
                                        <div class="absolute right-0 top-9 z-20 w-40 bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] shadow-lg overflow-hidden">
                                            <button type="button" @onclick="() => OpenEditPost(post)" class="w-full text-left px-3 py-2 text-xs text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] transition">Edit</button>
                                            <button type="button" @onclick="() => DeletePost(post.PostId)" class="w-full text-left px-3 py-2 text-xs text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition">Delete</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <p class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] mt-3 whitespace-pre-wrap leading-relaxed">@post.Content</p>

                        @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                        {
                            <div class="mt-3 grid grid-cols-1 @(post.ImageUrls.Count > 1 ? "sm:grid-cols-2" : "") gap-2">
                                @foreach (var imageUrl in post.ImageUrls)
                                {
                                    <img src="@imageUrl" alt="Post attachment" class="rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] max-h-64 w-full object-cover" />
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(post.CommunityName))
                        {
                            <div class="mt-2">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                                    @post.CommunityName
                                </span>
                            </div>
                        }

                        <div class="mt-3 pt-2.5 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-4 text-[#7A8CA6]">
                            <button type="button" @onclick="() => ToggleLikeAsync(post.PostId)"
                                    class="inline-flex items-center gap-1.5 text-[11px] @(post.IsLikedByCurrentUser ? "text-rose-600 dark:text-rose-400" : "hover:text-[#0A1B2E] dark:hover:text-white") transition cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="@(post.IsLikedByCurrentUser ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                @post.LikeCount
                            </button>
                            <span class="inline-flex items-center gap-1.5 text-[11px]">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                @post.CommentCount
                            </span>
                            <button type="button" @onclick="() => ToggleSavePost(post.PostId)"
                                    class="inline-flex items-center gap-1.5 text-[11px] @(post.IsSavedByCurrentUser ? "text-amber-500" : "hover:text-[#0A1B2E] dark:hover:text-white") ml-auto transition cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="@(post.IsSavedByCurrentUser ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                Save
                            </button>
                        </div>
                    </article>
                }
            }
        </div>
    }
    else if (activeTab == "people")
    {
        <!-- ============ PEOPLE TAB ============ -->
        @if (dashboard?.People == null || dashboard.People.Count == 0)
        {
            <div class="text-center py-14 bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)]">
                <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center mx-auto mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No people found</h3>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Members of your ecosystem will appear here.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var person in dashboard.People)
                {
                    <a href="/u/@person.UserName" class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.30)] p-5 shadow-sm hover:shadow-md transition-all duration-150 block">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(person.AvatarUrl))
                            {
                                <img src="@person.AvatarUrl" alt="@person.DisplayName" class="w-11 h-11 rounded-lg object-cover border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]" />
                            }
                            else
                            {
                                <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center text-[#557392] dark:text-[#C4D2E1] font-bold">@(string.IsNullOrWhiteSpace(person.DisplayName) ? "?" : person.DisplayName.Substring(0, 1).ToUpper())</span>
                            }
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] truncate" style="font-family:'Manrope',sans-serif">@person.DisplayName</span>
                                    @if (person.IsVerified)
                                    {
                                        <svg class="w-3.5 h-3.5 text-blue-500 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 2.4 3.4-.5 1 3.3 3.2 1.2-.8 3.3 2.2 2.6-2.6 2.2.6 3.4-3.3 1-1.5 3.1-3.2-1.2L12 23l-2.9-2.4L6 21.7 5 18.3l-3-1.2.8-3.3L0 11.2l2.6-2.2-1-3.3 3.3-1 .8-3.2L9.1 2.6 12 0z"/><path d="M10.5 12.6l-2-2-1.6 1.6 3.6 3.6 6.4-6.4-1.6-1.6z" fill="#fff"/></svg>
                                    }
                                </div>
                                <span class="text-[11px] text-[#7A8CA6] font-mono">@@@person.UserName</span>
                            </div>
                        </div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-3 line-clamp-2 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(person.Bio) ? "No bio provided." : person.Bio)
                        </p>
                        <div class="mt-3 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center gap-4 text-[11px] text-[#7A8CA6] font-mono">
                            <span class="inline-flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                @person.JoinedCommunitiesCount communities
                            </span>
                            <span class="inline-flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                @person.PostsCount posts
                            </span>
                            @if (person.AverageRating.HasValue)
                            {
                                <span class="inline-flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    @person.AverageRating.Value.ToString("0.0")
                                </span>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <!-- ============ GROUPS TAB ============ -->
        @if (groups == null || groups.Count == 0)
        {
            <div class="text-center py-14 bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)]">
                <span class="w-11 h-11 rounded-lg bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center mx-auto mb-3">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">No groups yet</h3>
                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">Groups created across the ecosystem will appear here.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var grp in groups)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.30)] p-5 shadow-sm hover:shadow-md transition-all duration-150 flex flex-col justify-between">
                        <div>
                            <a href="/group/@grp.GroupId" class="block text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] leading-snug truncate hover:text-[#557392] dark:hover:text-white transition" style="font-family:'Manrope',sans-serif">@grp.Name</a>
                            @if (!string.IsNullOrEmpty(grp.SubCommunityName))
                            {
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 mt-1.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)]">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                                    @grp.SubCommunityName
                                </span>
                            }
                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-2 line-clamp-2 leading-relaxed">
                                @(string.IsNullOrWhiteSpace(grp.Description) ? "No description provided." : grp.Description)
                            </p>
                            <div class="mt-3 flex items-center gap-3 text-xs text-[#7A8CA6] font-mono">
                                <span class="inline-flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    @grp.MemberCount
                                </span>
                                <span class="inline-flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                    @grp.PostCount
                                </span>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between">
                            <span class="text-[11px] text-[#7A8CA6] font-mono truncate">By @grp.CreatorName</span>
                            <div class="flex items-center gap-2 shrink-0">
                                <a href="/group/@grp.GroupId"
                                   class="px-3 py-1.5 rounded text-[11px] font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition">
                                    View
                                </a>
                                @if (grp.IsJoined)
                                {
                                    <button type="button" @onclick="() => LeaveGroup(grp)"
                                            class="px-3 py-1.5 rounded text-[11px] font-semibold text-rose-600 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-950/60 border border-rose-200 dark:border-rose-900/50 transition cursor-pointer">
                                        Leave
                                    </button>
                                }
                                else if (grp.UserJoinStatus == "PENDING")
                                {
                                    <span class="px-3 py-1.5 rounded text-[11px] font-semibold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50">Pending</span>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => JoinGroup(grp)"
                                            class="px-3 py-1.5 rounded text-[11px] font-semibold text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition cursor-pointer">
                                        @(grp.JoinPolicy == "APPROVAL_REQUIRED" || grp.Visibility == "PRIVATE" ? "Request Join" : "Join")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Edit Post Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[#0A1B2E]/50 dark:bg-black/70 backdrop-blur-sm p-4">
        <div class="relative bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] w-full max-w-lg overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">Edit Post</h3>
                <button type="button" @onclick="CloseEditModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="p-5">
                <textarea rows="4" @bind="editingPostContent"
                          class="w-full text-xs bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] rounded p-3 focus:outline-none focus:ring-2 focus:ring-[#4F46E5]/15 leading-relaxed"></textarea>
            </div>
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseEditModal" class="px-3.5 py-1.5 text-xs font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition rounded">Cancel</button>
                <button type="button" @onclick="SaveEditPostAsync" disabled="@(isSavingEdit || string.IsNullOrWhiteSpace(editingPostContent))"
                        class="px-4 py-1.5 text-xs font-semibold rounded text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition shadow-sm disabled:opacity-50">
                    @(isSavingEdit ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? dashboard;
    private IReadOnlyList<GroupModel>? groups;

    private bool canPostStandalone = false;
    private int? currentUserId = null;
    private string activeTab = "posts";

    // Composer
    private string newPostContent = string.Empty;
    private int composerCommunityId = 0;
    private bool isPublishingPost;
    private string? uploadedImageUrl;
    private bool isUploadingImage;

    // Post menu / edit state
    private int? activeMenuPostId = null;
    private bool showEditModal = false;
    private int? editingPostId = null;
    private string editingPostContent = string.Empty;
    private bool isSavingEdit = false;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/guest", replace: true);
            return;
        }

        var subClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(subClaim, out var parsedId))
        {
            currentUserId = parsedId;
        }

        try
        {
            var permRes = await RoleApi.GetMyPermissionsAsync(_cts.Token);
            if (permRes.IsSuccess && permRes.Data != null)
            {
                canPostStandalone = permRes.Data.Any(p => p.Equals("POST.STANDALONE.CREATE", StringComparison.OrdinalIgnoreCase));
            }
        }
        catch { }

        await LoadDataAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var dashboardTask = DashboardApi.GetUserDashboardAsync(_cts.Token);
            var groupsTask = GroupApi.GetGroupsAsync(null, null, _cts.Token);

            await Task.WhenAll(dashboardTask, groupsTask);

            var dashRes = dashboardTask.Result;
            var groupsRes = groupsTask.Result;

            if (dashRes.IsSuccess && dashRes.Data != null)
            {
                dashboard = dashRes.Data;
            }
            else
            {
                errorMessage = dashRes.Message ?? "Failed to load home data.";
            }

            if (groupsRes.IsSuccess)
            {
                groups = groupsRes.Data;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedImageUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Image attached!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to process image: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveUploadedImage()
    {
        uploadedImageUrl = null;
    }

    private async Task PublishPostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostContent)) return;

        if (composerCommunityId == 0 && !canPostStandalone)
        {
            Toast.Warning("Select a community to post to, or request the Standalone Post permission.");
            return;
        }

        isPublishingPost = true;
        try
        {
            var images = !string.IsNullOrWhiteSpace(uploadedImageUrl)
                ? new[] { uploadedImageUrl }
                : null;

            var req = new CreatePostRequestModel(
                composerCommunityId > 0 ? composerCommunityId : null,
                newPostContent.Trim(),
                images
            );

            var res = await PostApi.CreatePostAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post published!");
                newPostContent = string.Empty;
                uploadedImageUrl = null;
                composerCommunityId = 0;
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to publish post.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to publish: {ex.Message}");
        }
        finally
        {
            isPublishingPost = false;
        }
    }

    private async Task ToggleLikeAsync(int postId)
    {
        try
        {
            var res = await PostApi.LikePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to like post.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void TogglePostMenu(int postId)
    {
        activeMenuPostId = activeMenuPostId == postId ? null : postId;
    }

    private async Task ToggleSavePost(int postId)
    {
        activeMenuPostId = null;
        try
        {
            var res = await PostApi.ToggleSavePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                var isSaved = res.Data;
                Toast.Success(isSaved ? "Post saved to your profile." : "Post removed from saved.");
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to update saved posts.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void OpenEditPost(PostModel post)
    {
        activeMenuPostId = null;
        editingPostId = post.PostId;
        editingPostContent = post.Content;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingPostId = null;
        editingPostContent = string.Empty;
    }

    private async Task SaveEditPostAsync()
    {
        if (!editingPostId.HasValue || string.IsNullOrWhiteSpace(editingPostContent)) return;

        isSavingEdit = true;
        try
        {
            var req = new UpdatePostRequestModel(editingPostContent.Trim(), null);
            var res = await PostApi.UpdatePostAsync(editingPostId.Value, req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post updated.");
                CloseEditModal();
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to update post.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to update post: {ex.Message}");
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task DeletePost(int postId)
    {
        activeMenuPostId = null;
        try
        {
            var res = await PostApi.DeletePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post deleted.");
                await LoadDataAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to delete post.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to delete post: {ex.Message}");
        }
    }

    private async Task JoinGroup(GroupModel grp)
    {
        var res = await GroupApi.JoinGroupAsync(grp.GroupId, null, _cts.Token);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined group!");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join group.");
        }
    }

    private async Task LeaveGroup(GroupModel grp)
    {
        var res = await GroupApi.LeaveGroupAsync(grp.GroupId, _cts.Token);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Left group.");
            await LoadDataAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to leave group.");
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}