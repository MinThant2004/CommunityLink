@page "/"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>CommunityLink — Where Communities Connect</PageTitle>

@* ===== Navbar ===== *@
<nav class="cl-navbar">
    <div class="cl-nav-inner">
        <a href="/" class="cl-logo">
            <span class="cl-logo-icon">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                    <circle cx="14" cy="14" r="13" stroke="#38bdf8" stroke-width="1.5" opacity="0.6"/>
                    <circle cx="14" cy="14" r="5" fill="#38bdf8" opacity="0.9"/>
                    <line x1="14" y1="1" x2="14" y2="9" stroke="#38bdf8" stroke-width="1.2" opacity="0.5"/>
                    <line x1="14" y1="19" x2="14" y2="27" stroke="#38bdf8" stroke-width="1.2" opacity="0.5"/>
                    <line x1="1" y1="14" x2="9" y2="14" stroke="#38bdf8" stroke-width="1.2" opacity="0.5"/>
                    <line x1="19" y1="14" x2="27" y2="14" stroke="#38bdf8" stroke-width="1.2" opacity="0.5"/>
                    <line x1="4.8" y1="4.8" x2="10.4" y2="10.4" stroke="#38bdf8" stroke-width="1" opacity="0.35"/>
                    <line x1="17.6" y1="17.6" x2="23.2" y2="23.2" stroke="#38bdf8" stroke-width="1" opacity="0.35"/>
                    <line x1="23.2" y1="4.8" x2="17.6" y2="10.4" stroke="#38bdf8" stroke-width="1" opacity="0.35"/>
                    <line x1="10.4" y1="17.6" x2="4.8" y2="23.2" stroke="#38bdf8" stroke-width="1" opacity="0.35"/>
                </svg>
            </span>
            <span class="cl-logo-text">Community<span class="cl-logo-accent">Link</span></span>
        </a>

        <div class="cl-nav-links">
            <a href="#features" class="cl-nav-link">Features</a>
            <a href="#how-it-works" class="cl-nav-link">How It Works</a>
        </div>

        <div class="cl-nav-actions">
            <a href="login" class="cl-btn cl-btn-ghost">Log In</a>
            <a href="register" class="cl-btn cl-btn-primary">Sign Up Free</a>
        </div>
    </div>
</nav>

@* ===== Hero Section with Globe ===== *@
<section class="cl-hero">
    <div class="cl-hero-inner">
        <div class="cl-hero-content">
            <div class="cl-hero-badge">
                <span class="cl-badge-dot"></span>
                Trusted by communities worldwide
            </div>
            <h1 class="cl-hero-title">
                One Platform.<br/>
                <span class="cl-hero-title-accent">Every Community.</span>
            </h1>
            <p class="cl-hero-subtitle">
                Connect, communicate, and collaborate with people who share your passions.
                Real-time messaging, live polls, and rich feeds — all in one place.
            </p>
            <div class="cl-hero-cta">
                <AuthorizeView>
                    <Authorized>
                        <a href="feed" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Go to Feed
                        </a>
                        <a href="communities" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Explore Communities
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            Create Free Account
                        </a>
                        <a href="login" class="cl-btn cl-btn-outline cl-btn-lg">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            Log In
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="cl-hero-stats">
                <div class="cl-stat">
                    <span class="cl-stat-number">27</span>
                    <span class="cl-stat-label">Global Hubs</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">52+</span>
                    <span class="cl-stat-label">Connections</span>
                </div>
                <div class="cl-stat-divider"></div>
                <div class="cl-stat">
                    <span class="cl-stat-number">6</span>
                    <span class="cl-stat-label">Continents</span>
                </div>
            </div>
        </div>

        <div class="cl-hero-visual">
            <div class="cl-hero-glow"></div>
            <div id="globe-canvas"></div>
        </div>
    </div>

    <div class="cl-hero-scroll-hint">
        <span>Scroll to explore</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
</section>

@* ===== Features Section ===== *@
<section class="cl-features" id="features">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">Built for Connection</span>
            <h2 class="cl-section-title">Everything Your Community Needs</h2>
            <p class="cl-section-desc">From real-time conversations to community decisions — all the tools to keep your people connected and engaged.</p>
        </div>

        <div class="cl-features-grid">
            <div class="cl-feature-card cl-feature-card-large">
                <div class="cl-feature-icon cl-feature-icon-blue">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <h3>Real-Time Messaging</h3>
                <p>Direct messages and threaded conversations that keep your community talking, anytime, anywhere. No delays, no barriers.</p>
                <div class="cl-feature-visual">
                    <div class="cl-chat-bubble cl-chat-left">
                        <div class="cl-chat-avatar"></div>
                        <div class="cl-chat-text">Hey! Anyone up for a meetup this weekend?</div>
                    </div>
                    <div class="cl-chat-bubble cl-chat-right">
                        <div class="cl-chat-text">Count me in! Let's do Saturday</div>
                        <div class="cl-chat-avatar cl-chat-avatar-gold"></div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon cl-feature-icon-gold">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <h3>Live Polls & Voting</h3>
                <p>Make group decisions instantly with real-time polls. Single or multiple choice — results update as votes come in.</p>
                <div class="cl-poll-visual">
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill" style="width: 72%">
                            <span>Saturday 72%</span>
                        </div>
                    </div>
                    <div class="cl-poll-bar">
                        <div class="cl-poll-fill cl-poll-fill-secondary" style="width: 28%">
                            <span>Sunday 28%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon cl-feature-icon-cyan">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Community Hubs</h3>
                <p>Join topic-based communities, manage memberships, and find your people across the globe.</p>
            </div>

            <div class="cl-feature-card">
                <div class="cl-feature-icon cl-feature-icon-purple">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                </div>
                <h3>Rich Content Feeds</h3>
                <p>Share updates, articles, and media with your communities. Like, comment, and spark meaningful conversations.</p>
            </div>
        </div>
    </div>
</section>

@* ===== How It Works Section ===== *@
<section class="cl-how" id="how-it-works">
    <div class="cl-section-inner">
        <div class="cl-section-header">
            <span class="cl-section-tag">Simple & Intuitive</span>
            <h2 class="cl-section-title">Start Connecting in Minutes</h2>
        </div>

        <div class="cl-steps">
            <div class="cl-step">
                <div class="cl-step-number">1</div>
                <div class="cl-step-content">
                    <h3>Create Your Account</h3>
                    <p>Sign up for free in seconds. Add your interests and bio to help communities find you.</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">2</div>
                <div class="cl-step-content">
                    <h3>Join Communities</h3>
                    <p>Browse and join communities that match your interests. From tech to arts — there's a hub for everyone.</p>
                </div>
            </div>
            <div class="cl-step-connector"></div>
            <div class="cl-step">
                <div class="cl-step-number">3</div>
                <div class="cl-step-content">
                    <h3>Start Talking</h3>
                    <p>Jump into conversations, vote in polls, and share content. Your voice matters here.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== CTA Section ===== *@
<section class="cl-cta">
    <div class="cl-section-inner">
        <div class="cl-cta-box">
            <h2>Ready to Join the Conversation?</h2>
            <p>Be part of a growing global network. Your community is waiting.</p>
            <div class="cl-cta-actions">
                <AuthorizeView>
                    <Authorized>
                        <a href="feed" class="cl-btn cl-btn-primary cl-btn-lg">Go to Feed</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="register" class="cl-btn cl-btn-primary cl-btn-lg">Sign Up Free</a>
                        <a href="login" class="cl-btn cl-btn-ghost cl-btn-lg">Log In</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</section>

@* ===== Footer ===== *@
<footer class="cl-footer">
    <div class="cl-footer-inner">
        <div class="cl-footer-brand">
            <span class="cl-logo-text">Community<span class="cl-logo-accent">Link</span></span>
            <p>Connecting communities worldwide.</p>
        </div>
        <div class="cl-footer-meta">
            <span>Built with Blazor &amp; .NET 10</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>Real-time by SignalR</span>
            <span class="cl-footer-dot">&middot;</span>
            <span>Enterprise RBAC</span>
        </div>
    </div>
</footer>

@code {
    private bool _globeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_globeInitialized)
        {
            _globeInitialized = true;
            await JS.InvokeVoidAsync("initGlobe");
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
        }
    }
}
