            <p class="text-xs text-[#557392] bg-[#F2F6FB] p-3 rounded-lg border border-[#E1E8F0] leading-relaxed">
                This post will be hidden from the feed and community stream immediately. Posts kept in the Recycle Bin for more than 10 days will be permanently erased.
            </p>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="CloseRecycleModal" class="exec-btn-secondary text-xs" disabled="@isRecyclingPost">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmRecyclePostAsync" class="exec-btn-primary !bg-amber-600 hover:!bg-amber-700 !border-amber-600 text-xs" disabled="@isRecyclingPost">
                    @if (isRecyclingPost)
                    {
                        <span class="inline-block w-3 h-3 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Moving...</span>
                    }
                    else
                    {
                        <span>Move to Recycle Bin</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isCheckingAuth = true;
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? dashboard;

    // Permissions & User
    private bool canPostStandalone = false;
    private int? currentUserId = null;

    // Top Feed Tabs: "posts" | "people" | "groups"
    private string activeFeedTab = "posts";

    // Quick Composer
    private string newPostContent = string.Empty;
    private int selectedCommunityId = 0;
    private bool isPublishingPost;
    private string? uploadedImageUrl;
    private bool isUploadingImage;
    private string? composerCodeSnippet;
    private string? composerCodeFileName;
    private bool isReadingTextFile = false;

    // Inline Comments & Shares
    private readonly HashSet<int> openHomeCommentPostIds = new();
    private readonly Dictionary<int, string> homeCommentInputs = new();
    private readonly Dictionary<int, IReadOnlyList<CommentModel>> homeCommentsByPost = new();

    private bool showHomeShareModal = false;
    private int? homeSharingPostId = null;
    private string homeShareNoteText = string.Empty;
    private bool isSharingPost = false;

    // Post Options Menu & Modal State
    private int? activeMenuPostId = null;
    private bool showEditModal = false;
    private int? editingPostId = null;
    private string editingPostContent = string.Empty;
    private bool isSavingEdit = false;

    // Recycle Post Modal State
    private bool showRecycleModal = false;
    private int? pendingRecyclePostId = null;
    private bool isRecyclingPost = false;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/guest", replace: true);
            return;
        }

        var subClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(subClaim, out var parsedId))
        {
            currentUserId = parsedId;
        }

        isCheckingAuth = false;

        // Check Permissions
        try
        {
            var permRes = await RoleApi.GetMyPermissionsAsync(_cts.Token);
            if (permRes.IsSuccess && permRes.Data != null)
            {
                canPostStandalone = permRes.Data.Any(p => p.Equals("POST.STANDALONE.CREATE", StringComparison.OrdinalIgnoreCase));
            }
        }
        catch { }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                dashboard = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedImageUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Image attached!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to process image: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private void RemoveUploadedImage()
    {
        uploadedImageUrl = null;
    }

    private async Task HandleComposerTextFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error("Only plain text (.txt) files are allowed.");
            return;
        }

        try
        {
            isReadingTextFile = true;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            composerCodeSnippet = await reader.ReadToEndAsync();
            composerCodeFileName = file.Name;
            Toast.Success($"Text file '{file.Name}' read successfully.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to read text file: {ex.Message}");
        }
        finally
        {
            isReadingTextFile = false;
        }
    }

    private void RemoveComposerCodeFile()
    {
        composerCodeSnippet = null;
        composerCodeFileName = null;
    }

    private async Task PublishPostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostContent) && string.IsNullOrWhiteSpace(composerCodeSnippet)) return;

        isPublishingPost = true;
        try
        {
            var images = !string.IsNullOrWhiteSpace(uploadedImageUrl)
                ? new[] { uploadedImageUrl }
                : null;

            var req = new CreatePostRequestModel(
                selectedCommunityId > 0 ? selectedCommunityId : null,
                newPostContent.Trim(),
                images,
                CodeSnippet: composerCodeSnippet,
                CodeFileName: composerCodeFileName,
                CodeLanguage: !string.IsNullOrWhiteSpace(composerCodeSnippet) ? "TEXT" : null
            );

            var res = await PostApi.CreatePostAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Broadcast published successfully!");
                newPostContent = string.Empty;
                uploadedImageUrl = null;
                composerCodeSnippet = null;
                composerCodeFileName = null;
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to publish: {ex.Message}");
        }
        finally
        {
            isPublishingPost = false;
        }
    }

    private async Task ToggleLikeAsync(int postId)
    {
        try
        {
            var res = await PostApi.LikePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                await LoadDashboardAsync();
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void TogglePostMenu(int postId)
    {
        if (activeMenuPostId == postId)
        {
            activeMenuPostId = null;
        }
        else
        {
            activeMenuPostId = postId;
        }
    }

    private async Task ToggleSavePost(int postId)
    {
        activeMenuPostId = null;
        try
        {
            var res = await PostApi.ToggleSavePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                var isSaved = res.Data;
                Toast.Success(isSaved ? "Post saved to your profile!" : "Post removed from saved.");
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void OpenEditPost(PostModel post)
    {
        activeMenuPostId = null;
        editingPostId = post.PostId;
        editingPostContent = post.Content;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingPostId = null;
        editingPostContent = string.Empty;
    }

    private async Task SaveEditPostAsync()
    {
        if (!editingPostId.HasValue || string.IsNullOrWhiteSpace(editingPostContent)) return;

        isSavingEdit = true;
        try
        {
            var req = new UpdatePostRequestModel(editingPostContent.Trim(), null);
            var res = await PostApi.UpdatePostAsync(editingPostId.Value, req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post updated successfully!");
                CloseEditModal();
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to update post: {ex.Message}");
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private void PromptRecyclePost(int postId)
    {
        activeMenuPostId = null;
        pendingRecyclePostId = postId;
        showRecycleModal = true;
    }

    private void CloseRecycleModal()
    {
        showRecycleModal = false;
        pendingRecyclePostId = null;
        isRecyclingPost = false;
    }

    private async Task ConfirmRecyclePostAsync()
    {
        if (!pendingRecyclePostId.HasValue) return;

        isRecyclingPost = true;
        try
        {
            var res = await PostApi.DeletePostAsync(pendingRecyclePostId.Value, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post moved to Recycle Bin.");
                CloseRecycleModal();
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to recycle post: {ex.Message}");
        }
        finally
        {
            isRecyclingPost = false;
        }
    }

    private async Task ToggleFollowPersonAsync(int targetUserId)
    {
        try
        {
            var res = await ProfileApi.ToggleFollowUserAsync(targetUserId, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success(res.Data ? "Following member!" : "Unfollowed member.");
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Follow action failed: {ex.Message}");
        }
    }

    private async Task JoinGroupFromHomeAsync(int groupId)
    {
        try
        {
            var res = await GroupApi.JoinGroupAsync(groupId, cancellationToken: _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Joined group successfully!");
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Join group failed: {ex.Message}");
        }
    }

    private async Task ToggleHomeCommentBox(int postId)
    {
        if (openHomeCommentPostIds.Contains(postId))
        {
            openHomeCommentPostIds.Remove(postId);
            return;
        }

        openHomeCommentPostIds.Add(postId);
        if (!homeCommentInputs.ContainsKey(postId))
        {
            homeCommentInputs[postId] = string.Empty;
        }

        if (!homeCommentsByPost.ContainsKey(postId))
        {
            try
            {
                var res = await PostApi.GetCommentsAsync(postId, _cts.Token);
                if (res.IsSuccess && res.Data != null)
                {
                    homeCommentsByPost[postId] = res.Data;
                }
            }
            catch { }
        }
    }

    private async Task SubmitHomeCommentAsync(int postId)
    {
        if (!homeCommentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        try
        {
            var req = new CreateCommentRequestModel(postId, content.Trim());
            var res = await PostApi.AddCommentAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                homeCommentInputs[postId] = string.Empty;
                var commentsRes = await PostApi.GetCommentsAsync(postId, _cts.Token);
                if (commentsRes.IsSuccess && commentsRes.Data != null)
                {
                    homeCommentsByPost[postId] = commentsRes.Data;
                }
                Toast.Success("Comment posted!");
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to post comment: {ex.Message}");
        }
    }

    private void OpenHomeShareModal(int postId)
    {
        homeSharingPostId = postId;
        homeShareNoteText = string.Empty;
        showHomeShareModal = true;
    }

    private void CloseHomeShareModal()
    {
        showHomeShareModal = false;
        homeSharingPostId = null;
        homeShareNoteText = string.Empty;
    }

    private async Task SubmitHomeSharePostAsync()
    {
        if (!homeSharingPostId.HasValue) return;

        isSharingPost = true;
        try
        {
            var req = new SharePostRequestModel(
                string.IsNullOrWhiteSpace(homeShareNoteText) ? null : homeShareNoteText.Trim(),
                null
            );

            var res = await PostApi.SharePostAsync(homeSharingPostId.Value, req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post shared successfully!");
                CloseHomeShareModal();
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to share post: {ex.Message}");
        }
        finally
        {
            isSharingPost = false;
        }
    }

    private async Task VotePollFromHomeAsync(int pollId, int optionId)
    {
        try
        {
            var req = new VoteRequestModel(pollId, new[] { optionId });
            var res = await PollApi.VoteAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Vote cast successfully!");
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to vote: {ex.Message}");
        }
    }

    private async Task ScrollToComposer()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('quick-composer')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}