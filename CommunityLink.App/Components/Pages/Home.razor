    private async Task PublishPostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostContent) && composerTextFiles.Count == 0 && uploadedImageUrls.Count == 0) return;

        isPublishingPost = true;
        try
        {
            var images = uploadedImageUrls.Count > 0 ? uploadedImageUrls.ToList() : null;

            string? snippet = null;
            string? fileName = null;
            string? lang = null;

            if (composerTextFiles.Count == 1)
            {
                snippet = composerTextFiles[0].Content;
                fileName = composerTextFiles[0].FileName;
                lang = "TEXT";
            }
            else if (composerTextFiles.Count > 1)
            {
                snippet = JsonSerializer.Serialize(composerTextFiles);
                fileName = $"{composerTextFiles.Count} text files";
                lang = "TEXT";
            }

            var req = new CreatePostRequestModel(
                selectedCommunityId > 0 ? selectedCommunityId : null,
                newPostContent.Trim(),
                images,
                CodeSnippet: snippet,
                CodeFileName: fileName,
                CodeLanguage: lang
            );

            var res = await PostApi.CreatePostAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Broadcast published successfully!");
                newPostContent = string.Empty;
                uploadedImageUrls.Clear();
                composerTextFiles.Clear();
                showCreatePostModal = false;
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to publish: {ex.Message}");
        }
        finally
        {
            isPublishingPost = false;
        }
    }

    private async Task SubmitStandalonePollAsync()
    {
        if (string.IsNullOrWhiteSpace(newPollQuestion))
        {
            Toast.Warning("Please specify a poll question.");
            return;
        }

        var validOptions = pollOptionsList.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Toast.Warning("A poll must contain at least 2 non-empty options.");
            return;
        }

        DateTime? expiresAt = null;
        var totalMinutes = (pollDurationDays * 24 * 60) + (pollDurationHours * 60) + pollDurationMinutes;
        if (totalMinutes > 0)
        {
            expiresAt = DateTime.UtcNow.AddMinutes(totalMinutes);
        }

        isSubmittingPoll = true;
        try
        {
            var desc = string.IsNullOrWhiteSpace(newPollDescription) ? newPollQuestion : newPollDescription;
            var req = new CreatePollRequestModel(null, desc, newPollQuestion.Trim(), pollIsMultipleChoice, expiresAt, validOptions, null);

            var res = await PollApi.CreatePollAsync(req);
            if (res.IsSuccess)
            {
                Toast.Success("Public poll created successfully!");
                showCreatePollModal = false;
                newPollQuestion = string.Empty;
                newPollDescription = string.Empty;
                pollOptionsList = new() { string.Empty, string.Empty };
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to create poll.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to create poll: {ex.Message}");
        }
        finally
        {
            isSubmittingPoll = false;
        }
    }

