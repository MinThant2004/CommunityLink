                                    </div>
                                    <p class="text-[11px] text-[#557392] line-clamp-2 leading-relaxed">
                                        @(string.IsNullOrWhiteSpace(rec.Description) ? "Recommended community hub based on your network activity." : rec.Description)
                                    </p>
                                    <div class="pt-1 flex items-center justify-end">
                                        <a href="communities" class="exec-btn-secondary text-xs !py-1 !px-2.5">
                                            <span>Join Hub</span> &rarr;
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Widget 3: Quick Direct Messaging -->
                <div class="exec-card p-5 space-y-4">
                    <div class="flex items-center justify-between border-b border-[#E1E8F0] pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                            <h3 class="exec-label-md !text-[#0A1B2E]">Real-Time Messaging</h3>
                        </div>
                        <a href="chat" class="exec-mono text-[11px] text-[#34506D] hover:text-[#0A1B2E] font-medium">MESSAGES &rarr;</a>
                    </div>

                    <div class="p-5 bg-[#E3EFFF] rounded-[0.375rem] border border-[#C4D2E1] text-center space-y-2.5">
                        <span class="w-12 h-12 rounded-[0.5rem] bg-[#0A1B2E] text-white flex items-center justify-center mx-auto">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        </span>
                        <p class="text-xs text-[#557392]">Connect 1-on-1 with community members, leaders, and peers.</p>
                        <a href="chat" class="exec-btn-secondary text-xs !py-1.5 !px-4">
                            Open Messenger
                        </a>
                    </div>
                </div>

            </div>

        </div>

    </div>
}
</div>

@code {
    private bool isCheckingAuth = true;
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? dashboard;

    // Quick Composer
    private string newPostContent = string.Empty;
    private int selectedCommunityId = 0;
    private bool isPublishingPost;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/guest", replace: true);
            return;
        }

        isCheckingAuth = false;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                dashboard = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PublishPostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostContent)) return;

        isPublishingPost = true;
        try
        {
            var req = new CreatePostRequestModel(
                selectedCommunityId > 0 ? selectedCommunityId : null,
                newPostContent.Trim(),
                null
            );

            var res = await PostApi.CreatePostAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Broadcast published successfully!");
                newPostContent = string.Empty;
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to publish: {ex.Message}");
        }
        finally
        {
            isPublishingPost = false;
        }
    }

    private async Task ToggleLikeAsync(int postId)
    {
        try
        {
            var res = await PostApi.LikePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                await LoadDashboardAsync();
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private async Task ScrollToComposer()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('quick-composer')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}