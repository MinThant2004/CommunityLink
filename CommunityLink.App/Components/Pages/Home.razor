@page "/"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>CommunityLink — Connect Communities Worldwide</PageTitle>

@* ===== Globe Frame ===== *@
<div class="globe-frame">

    @* --- Header Bar --- *@
    <div class="frame-header">
        <div class="frame-header-left">
            <div class="frame-dots">
                <span></span><span></span><span></span>
            </div>
            <span class="frame-title">
                <span class="frame-title-highlight">COMMUNITYLINK</span> GLOBAL NETWORK GRID • LIVE
            </span>
        </div>
        <div class="frame-header-routes">
            <span class="frame-route">🌐 San Francisco <span class="route-arrow">⟷</span> London</span>
            <span class="frame-route">Singapore <span class="route-arrow">⟷</span> Tokyo <span class="route-arrow">⟷</span> Yangon</span>
        </div>
    </div>

    @* --- Interaction Hint --- *@
    <div class="frame-hint">
        <span class="hint-icon">✦</span> Click & Drag to Rotate 3D Globe • Scroll to Zoom
    </div>

    @* --- Globe Viewport --- *@
    <div class="globe-viewport">
        <div id="globe-canvas"></div>

        @* Floating Status Panel — Left *@
        <div class="globe-panel globe-panel-left">
            <div class="panel-label">
                <span class="panel-dot"></span> NETWORK STATUS
            </div>
            <div class="panel-stat">27 <span class="stat-accent">Hubs</span></div>
            <div class="panel-desc">Global nodes active across 6 continents</div>
            <span class="panel-badge panel-badge-cyan">ALL SYSTEMS ONLINE</span>
        </div>

        @* Floating Status Panel — Right *@
        <div class="globe-panel globe-panel-right">
            <div class="panel-label">
                <span class="panel-dot"></span> LIVE CONNECTIONS
            </div>
            <div class="panel-stat">52 <span class="stat-accent">Routes</span></div>
            <div class="panel-desc">Fiber links transmitting across the network</div>
            <span class="panel-badge panel-badge-gold">SYNCHRONIZED</span>
        </div>
    </div>

    @* --- Footer Bar --- *@
    <div class="frame-footer">
        <span>Powered by</span>
        <span class="footer-accent">.NET 10</span>
        <span class="footer-dot">•</span>
        <span>Blazor Server</span>
        <span class="footer-dot">•</span>
        <span>Dynamic RBAC</span>
        <span class="footer-dot">•</span>
        <span class="footer-accent">Enterprise Grade</span>
    </div>
</div>

@* ===== Hero Section (below frame) ===== *@
<div class="hero-section">
    <span class="hero-badge">✦ Community Platform</span>
    <h1>CommunityLink</h1>
    <p class="hero-tagline">
        A modern, scalable platform connecting people across the globe.
        Build communities, share ideas, and engage through <strong>real-time messaging</strong>,
        <strong>live polls</strong>, and <strong>rich content feeds</strong>.
    </p>
    <AuthorizeView>
        <Authorized>
            <div class="hero-actions">
                <a class="btn-glow btn-glow-primary" href="feed">
                    📰 Go to Public Feed
                </a>
                <a class="btn-glow btn-glow-outline" href="communities">
                    👥 Explore Communities
                </a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="hero-actions">
                <a class="btn-glow btn-glow-primary" href="login">
                    🔑 Login to your account
                </a>
                <a class="btn-glow btn-glow-gold" href="register">
                    📝 Create a new account
                </a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@* ===== Feature Cards ===== *@
<div class="feature-strip">
    <div class="feature-card">
        <span class="feature-icon">👥</span>
        <h3>Communities & Hubs</h3>
        <p>Join topical groups, manage memberships, and participate in community discussions.</p>
    </div>
    <div class="feature-card">
        <span class="feature-icon">📊</span>
        <h3>Live Polls & Voting</h3>
        <p>Create polls with single or multiple choice questions and instant results.</p>
    </div>
    <div class="feature-card">
        <span class="feature-icon">💬</span>
        <h3>Real-Time Messaging</h3>
        <p>Direct messaging and threaded conversations between community members.</p>
    </div>
</div>

@code {
    private bool _globeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_globeInitialized)
        {
            _globeInitialized = true;
            await JS.InvokeVoidAsync("initGlobe");
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
            // JS interop may fail during circuit disconnect — safe to ignore
        }
    }
}