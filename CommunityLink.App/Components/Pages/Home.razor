                                                <svg class="w-4 h-4" fill="@(post.IsLikedByCurrentUser ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                                                <span class="exec-mono text-xs">@post.LikeCount Likes</span>
                                            </button>
                                            <a href="feed" class="flex items-center gap-1.5 font-medium text-[#557392] hover:text-[#0A1B2E] transition">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                                <span class="exec-mono text-xs">@post.CommentCount Comments</span>
                                            </a>
                                        </div>

                                        <a href="feed" class="exec-btn-ghost text-xs">
                                            View Discussion &rarr;
                                        </a>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                </div>

            </div>

            <!-- RIGHT COLUMN (1 Column): Widgets (Live Polls, Discovery, Messenger) -->
            <div class="space-y-6">

                <!-- Widget 1: Active Live Polls -->
                <div class="exec-card p-5 space-y-4">
                    <div class="flex items-center justify-between border-b border-[#E1E8F0] pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                            <h3 class="exec-label-md !text-[#0A1B2E]">Active Live Polls</h3>
                        </div>
                        <a href="polls" class="exec-mono text-[11px] text-[#34506D] hover:text-[#0A1B2E] font-medium">ALL POLLS &rarr;</a>
                    </div>

                    @if (!dashboard.ActivePolls.Any())
                    {
                        <p class="text-xs text-[#7A8CA6] text-center py-4">No active polls running.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var poll in dashboard.ActivePolls.Take(2))
                            {
                                <div class="p-4 bg-[#E3EFFF] rounded-[0.375rem] border border-[#C4D2E1] space-y-3">
                                    <div class="font-semibold text-xs text-[#0A1B2E] leading-snug">@poll.Question</div>

                                    <div class="space-y-2">
                                        @foreach (var opt in poll.Options)
                                        {
                                            <div class="space-y-1">
                                                <div class="flex items-center justify-between text-xs text-[#112A46]">
                                                    <span class="text-[11px]">@opt.Text</span>
                                                    <span class="exec-mono text-[10px] font-semibold text-[#557392]">@opt.VoteCount votes</span>
                                                </div>
                                                <div class="w-full h-1.5 bg-[#E1E8F0] rounded-full overflow-hidden">
                                                    <div class="h-full bg-[#0A1B2E] rounded-full" style="width: @(poll.TotalVotes > 0 ? (opt.VoteCount * 100 / poll.TotalVotes) : 0)%"></div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="flex items-center justify-between pt-1 text-[11px] text-[#7A8CA6]">
                                        <span class="exec-mono text-[10px]">Total: @poll.TotalVotes votes</span>
                                        <a href="polls" class="exec-mono text-[11px] font-semibold text-[#0A1B2E] hover:underline">Vote &rarr;</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Widget 2: Ecosystem Discovery / Recommended Hubs -->
                @if (dashboard.RecommendedCommunities.Any())
                {
                    <div class="exec-card p-5 space-y-4">
                        <div class="flex items-center justify-between border-b border-[#E1E8F0] pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#34506D]"></span>
                                <h3 class="exec-label-md !text-[#0A1B2E]">Ecosystem Discovery</h3>
                            </div>
                            <a href="communities" class="exec-mono text-[11px] text-[#34506D] hover:text-[#0A1B2E] font-medium">EXPLORE &rarr;</a>
