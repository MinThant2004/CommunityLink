@page "/"
@page "/home"
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserDashboardApiService DashboardApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@inject GroupApiService GroupApi
@inject UserProfileApiService ProfileApi
@inject LinkDropApiService LinkDropApi
@using System.IO
@using System.Text.Json

<PageTitle>Ecosystem Home — CommunityLink</PageTitle>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Plus+Jakarta+Sans:wght@100..900&family=JetBrains+Mono:wght@400;500;600&display=swap" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200');
    @@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap');
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Plus+Jakarta+Sans:wght@100..900&family=JetBrains+Mono:wght@400;500;600&display=swap');

    .material-symbols-outlined {
        font-family: 'Material Symbols Outlined' !important;
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-smoothing: antialiased;
    }

    /* Executive Dual Theme System (Light & Dark Mode) */
    :root {
        --bg-background: #F8FAFC;
        --bg-surface: #FFFFFF;
        --bg-surface-dim: #F1F5F9;
        --bg-surface-bright: #FFFFFF;
        --bg-surface-variant: #E2E8F0;
        --bg-surface-container-lowest: #FFFFFF;
        --bg-surface-container-low: #F8FAFC;
        --bg-surface-container: #F1F5F9;
        --bg-surface-container-high: #E2E8F0;
        --bg-surface-container-highest: #CBD5E1;
        --primary: #B38F24;
        --primary-container: #D4AF37;
        --primary-fixed: #FFE088;
        --on-primary: #FFFFFF;
        --on-primary-container: #241A00;
        --secondary: #4F46E5;
        --secondary-container: #EEF2FF;
        --tertiary: #0F766E;
        --tertiary-container: #CCFBF1;
        --on-surface: #0A1B2E;
        --on-surface-variant: #557392;
        --outline: #94A3B8;
        --outline-variant: #E2E8F0;
        --error: #BE1A1A;
        --card-border: rgba(10, 27, 46, 0.08);
    }

    html.dark, :root.dark {
        --bg-background: #10131a;
        --bg-surface: #10131a;
        --bg-surface-dim: #10131a;
        --bg-surface-bright: #363941;
        --bg-surface-variant: #32353d;
        --bg-surface-container-lowest: #0b0e15;
        --bg-surface-container-low: #191b23;
        --bg-surface-container: #1d1f27;
        --bg-surface-container-high: #272a32;
        --bg-surface-container-highest: #32353d;
        --primary: #f2ca50;
        --primary-container: #d4af37;
        --primary-fixed: #ffe088;
        --on-primary: #3c2f00;
        --on-primary-container: #554300;
        --secondary: #c0c1ff;
        --secondary-container: #3131c0;
        --tertiary: #c0d0e6;
        --tertiary-container: #a5b4ca;
        --on-surface: #e1e2ec;
        --on-surface-variant: #d0c5af;
        --outline: #99907c;
        --outline-variant: #4d4635;
        --error: #ffb4ab;
        --card-border: rgba(255, 255, 255, 0.05);
    }

    .border-white\/5, .border-white\/10 { border-color: var(--card-border) !important; }

    .bg-background { background-color: var(--bg-background) !important; }
    .bg-surface { background-color: var(--bg-surface) !important; }
    .bg-surface-dim { background-color: var(--bg-surface-dim) !important; }
    .bg-surface-bright { background-color: var(--bg-surface-bright) !important; }
    .bg-surface-variant { background-color: var(--bg-surface-variant) !important; }
    .bg-surface-container-lowest { background-color: var(--bg-surface-container-lowest) !important; }
    .bg-surface-container-low { background-color: var(--bg-surface-container-low) !important; }
    .bg-surface-container { background-color: var(--bg-surface-container) !important; }
    .bg-surface-container-high { background-color: var(--bg-surface-container-high) !important; }
    .bg-surface-container-highest { background-color: var(--bg-surface-container-highest) !important; }
    .bg-primary { background-color: var(--primary) !important; }
    .bg-primary-container { background-color: var(--primary-container) !important; }
    .bg-secondary { background-color: var(--secondary) !important; }
    .bg-secondary-container { background-color: var(--secondary-container) !important; }
    .bg-tertiary { background-color: var(--tertiary) !important; }
    
    .text-primary { color: var(--primary) !important; }
    .text-on-primary { color: var(--on-primary) !important; }
    .text-on-primary-container { color: var(--on-primary-container) !important; }
    .text-secondary { color: var(--secondary) !important; }
    .text-tertiary { color: var(--tertiary) !important; }
    .text-on-surface { color: var(--on-surface) !important; }
    .text-on-surface-variant { color: var(--on-surface-variant) !important; }
    .text-outline { color: var(--outline) !important; }
    .text-error { color: var(--error) !important; }

    /* Layout Spacing (Compact Executive Hierarchy) */
    .p-space-xs { padding: 0.25rem !important; }
    .p-space-sm { padding: 0.5rem !important; }
    .p-space-md { padding: 0.75rem !important; }
    .p-space-lg { padding: 1rem !important; }
    .p-space-xl { padding: 1.25rem !important; }
    .px-space-xs { padding-left: 0.25rem !important; padding-right: 0.25rem !important; }
    .px-space-sm { padding-left: 0.5rem !important; padding-right: 0.5rem !important; }
    .px-space-md { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
    .px-space-lg { padding-left: 1rem !important; padding-right: 1rem !important; }
    .py-space-xs { padding-top: 0.25rem !important; padding-bottom: 0.25rem !important; }
    .py-space-sm { padding-top: 0.375rem !important; padding-bottom: 0.375rem !important; }
    .py-space-md { padding-top: 0.75rem !important; padding-bottom: 0.75rem !important; }
    .py-space-lg { padding-top: 1rem !important; padding-bottom: 1rem !important; }
    .gap-space-xs { gap: 0.25rem !important; }
    .gap-space-sm { gap: 0.5rem !important; }
    .gap-space-md { gap: 0.75rem !important; }
    .px-gutter { padding-left: 0 !important; padding-right: 0 !important; }
    .px-margin { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
    .gap-gutter-desktop { gap: 1rem !important; }
    .mb-space-lg { margin-bottom: 0.75rem !important; }
    .mb-space-md { margin-bottom: 0.5rem !important; }
    .mb-space-sm { margin-bottom: 0.25rem !important; }
    .mb-space-xl { margin-bottom: 1rem !important; }
    .mt-space-md { margin-top: 0.5rem !important; }
    .mt-space-sm { margin-top: 0.25rem !important; }
    .mt-space-lg { margin-top: 0.75rem !important; }
    .mt-space-xl { margin-top: 1rem !important; }
    .-mx-space-lg { margin-left: -1rem !important; margin-right: -1rem !important; }
    .-mb-space-lg { margin-bottom: -1rem !important; }

    /* Typography Classes (Executive Minimalist Scale) */
    .font-headline-lg { font-family: 'Plus Jakarta Sans', sans-serif !important; font-size: 18px !important; line-height: 24px !important; font-weight: 700 !important; }
    .font-headline-md { font-family: 'Plus Jakarta Sans', sans-serif !important; font-size: 15px !important; line-height: 20px !important; font-weight: 600 !important; }
    .font-title-lg { font-family: 'Inter', sans-serif !important; font-size: 13.5px !important; line-height: 18px !important; font-weight: 600 !important; }
    .font-title-md { font-family: 'Inter', sans-serif !important; font-size: 12.5px !important; line-height: 17px !important; font-weight: 600 !important; }
    .font-body-lg { font-family: 'Inter', sans-serif !important; font-size: 13px !important; line-height: 19px !important; font-weight: 400 !important; }
    .font-body-md { font-family: 'Inter', sans-serif !important; font-size: 12px !important; line-height: 17px !important; font-weight: 400 !important; }
    .font-body-sm { font-family: 'Inter', sans-serif !important; font-size: 11px !important; line-height: 15px !important; font-weight: 400 !important; }
    .font-label-lg { font-family: 'Inter', sans-serif !important; font-size: 11.5px !important; line-height: 15px !important; font-weight: 600 !important; }
    .font-label-md { font-family: 'Inter', sans-serif !important; font-size: 10.5px !important; line-height: 13px !important; font-weight: 600 !important; }
    .font-label-sm { font-family: 'Inter', sans-serif !important; font-size: 9.5px !important; line-height: 12px !important; font-weight: 700 !important; }
    .font-display-md { font-family: 'Plus Jakarta Sans', sans-serif !important; font-size: 20px !important; line-height: 26px !important; font-weight: 700 !important; }

    .exec-home {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--on-surface);
        background-color: var(--bg-background);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .exec-display {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: -0.025em;
    }

    .exec-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .exec-card {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .exec-card:hover {
        border-color: #C4D2E1;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.07), 0 2px 6px -1px rgba(10, 27, 46, 0.03);
    }

    .exec-card-static {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
    }

    .exec-btn-primary {
        background-color: #0A1B2E;
        color: #ffffff !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.01em;
        border: 1px solid #0A1B2E;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-primary:hover:not(:disabled) {
        background-color: #112A46;
        border-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(10, 27, 46, 0.18);
    }

    .exec-btn-primary:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .exec-btn-secondary {
        background-color: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #112A46 !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-secondary:hover {
        background-color: #D9EAFF;
        border-color: #A1B2C4;
        color: #0A1B2E !important;
    }

    .exec-btn-ghost {
        background-color: transparent;
        color: #34506D !important;
        border: 1px solid transparent;
        border-radius: 0.25rem;
        padding: 0.4rem 0.75rem;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.15s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-ghost:hover {
        background-color: #F2F6FB;
        color: #0A1B2E !important;
    }

    .exec-badge-standard {
        background: #F2F6FB;
        border: 1px solid #E1E8F0;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-active {
        background: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-label-md {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #7A8CA6;
    }

    .exec-input {
        background: #ffffff;
        border: 1px solid #C4D2E1;
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        font-size: 13px;
        color: #0A1B2E;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .exec-input::placeholder {
        color: #A1B2C4;
    }

    .exec-input:focus {
        border-color: #1B3B5A;
        box-shadow: 0 0 0 3px rgba(27, 59, 90, 0.12);
    }

    .prof-code-block {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
        font-size: 11px;
        border-radius: 0.5rem;
        border: 1px solid #30363d;
    }

    .exec-badge-blue {
        background: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-live {
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #047857;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-card-tinted {
        background: #EDF4FF;
        border-color: #C4D2E1;
    }

    /* ---------- Feed Tab Switcher (Post | People | Group) ---------- */
    .feed-tabs {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem;
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px 0 rgba(10, 27, 46, 0.05), 0 1px 1px 0 rgba(10, 27, 46, 0.02);
    }

    .feed-tab {
        position: relative;
        flex: 1 1 0%;
        min-width: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem 0.5rem;
        border: 0;
        border-radius: 0.5rem;
        background: transparent;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        line-height: 1.25rem;
        color: #557392;
        cursor: pointer;
        transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
    }

    .feed-tab:hover {
        background: #F2F6FB;
        color: #0A1B2E;
    }

    .feed-tab:active {
        transform: scale(0.985);
    }

    .feed-tab:focus-visible {
        outline: 2px solid #1B3B5A;
        outline-offset: 2px;
    }

    .feed-tab__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 0.375rem;
        flex-shrink: 0;
        transition: background-color 0.18s ease, color 0.18s ease;
    }

    .feed-tab__label {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .feed-tab__count {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 1px 6px;
        border-radius: 999px;
        background: #F2F6FB;
        border: 1px solid #E1E8F0;
        color: #7A8CA6;
        flex-shrink: 0;
        transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    }

    .feed-tab.is-active {
        background: #0A1B2E;
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 2px 6px -1px rgba(10, 27, 46, 0.28);
    }

    .feed-tab.is-active:hover {
        background: #112A46;
        color: #ffffff;
    }

    .feed-tab.is-active .feed-tab__icon {
        background: rgba(255, 255, 255, 0.14);
        color: #D4AF37;
    }

    .feed-tab.is-active .feed-tab__count {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.24);
        color: #ffffff;
    }

    /* ---------- Compact Horizontal Group Row ---------- */
    .group-row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.625rem 0.875rem;
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .group-row:hover {
        border-color: #C4D2E1;
        box-shadow: 0 6px 18px -6px rgba(10, 27, 46, 0.14);
        transform: translateY(-1px);
    }

    .group-row__thumb {
        position: relative;
        width: 3.25rem;
        height: 3.25rem;
        flex-shrink: 0;
        border-radius: 0.625rem;
        overflow: hidden;
        background: linear-gradient(135deg, #E3EFFF 0%, #F2F6FB 100%);
        box-shadow: inset 0 0 0 1px rgba(10, 27, 46, 0.06);
    }

    .group-row__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .group-row:hover .group-row__thumb img {
        transform: scale(1.07);
    }

    @@media (min-width: 640px) {
        .group-row {
            gap: 1rem;
            padding: 0.75rem 1rem;
        }

        .group-row__thumb {
            width: 3.75rem;
            height: 3.75rem;
        }
    }

    /* Nocturne Executive Dark Mode Rules */
    .dark .exec-home {
        color: var(--on-surface);
        background-color: var(--bg-background);
    }

    .dark .exec-card {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card:hover {
        border-color: rgba(196, 210, 225, 0.28);
        box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.45);
    }

    .dark .exec-card-static {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card-tinted {
        background: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.20);
    }

    .dark .exec-btn-primary {
        background-color: #E1E8F0;
        color: #0A1B2E !important;
        border: 1px solid #E1E8F0;
    }

    .dark .exec-btn-primary:hover:not(:disabled) {
        background-color: #FFFFFF;
        border-color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(225, 232, 240, 0.20);
    }

    .dark .exec-btn-secondary {
        background-color: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0 !important;
    }

    .dark .exec-btn-secondary:hover {
        background-color: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.35);
        color: #FFFFFF !important;
    }

    .dark .exec-btn-ghost {
        color: #C4D2E1 !important;
    }

    .dark .exec-btn-ghost:hover {
        background-color: #1B3B5A;
        color: #FFFFFF !important;
    }

    .dark .exec-badge-standard {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.15);
        color: #C4D2E1;
    }

    .dark .exec-badge-active {
        background: #E1E8F0;
        border: 1px solid #E1E8F0;
        color: #0A1B2E;
    }

    .dark .exec-badge-blue {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-badge-live {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.30);
        color: #34D399;
    }

    .dark .exec-label-md {
        color: #7A8CA6;
    }

    .dark .exec-input {
        background: #0A1B2E;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-input::placeholder {
        color: #7A8CA6;
    }

    .dark .exec-input:focus {
        border-color: rgba(196, 210, 225, 0.35);
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.05);
    }

    .dark .feed-tabs {
        background: #112A46;
        border-color: rgba(196, 210, 225, 0.15);
        box-shadow: none;
    }

    .dark .feed-tab {
        color: #C4D2E1;
    }

    .dark .feed-tab:hover {
        background: #1B3B5A;
        color: #FFFFFF;
    }

    .dark .feed-tab__count {
        background: #0A1B2E;
        border-color: rgba(196, 210, 225, 0.15);
        color: #7A8CA6;
    }

    .dark .feed-tab:focus-visible {
        outline-color: #E1E8F0;
    }

    .dark .feed-tab.is-active {
        background: #E1E8F0;
        color: #0A1B2E;
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.55);
    }

    .dark .feed-tab.is-active:hover {
        background: #FFFFFF;
        color: #0A1B2E;
    }

    .dark .feed-tab.is-active .feed-tab__icon {
        background: rgba(10, 27, 46, 0.10);
        color: #8A6D1F;
    }

    .dark .feed-tab.is-active .feed-tab__count {
        background: rgba(10, 27, 46, 0.12);
        border-color: rgba(10, 27, 46, 0.20);
        color: #112A46;
    }

    .dark .group-row {
        background: #112A46;
        border-color: rgba(196, 210, 225, 0.12);
    }

    .dark .group-row:hover {
        border-color: rgba(196, 210, 225, 0.30);
        box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.60);
    }

    .dark .group-row__thumb {
        background: linear-gradient(135deg, #1B3B5A 0%, #0A1B2E 100%);
        box-shadow: inset 0 0 0 1px rgba(196, 210, 225, 0.14);
    }

    /* Scoped Dark Utility Maps for Home Component */
    .dark .exec-home .text-\[\#0A1B2E\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#557392\] { color: #C4D2E1; }
    .dark .exec-home .text-\[\#112A46\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#34506D\] { color: #C4D2E1; }
    .dark .exec-home .border-\[\#E1E8F0\] { border-color: rgba(196, 210, 225, 0.12); }
    .dark .exec-home .border-\[\#F2F6FB\] { border-color: rgba(196, 210, 225, 0.08); }
    .dark .exec-home .border-\[\#C4D2E1\] { border-color: rgba(196, 210, 225, 0.20); }
    .dark .exec-home .bg-\[\#E3EFFF\] { background-color: #1B3B5A; }
    .dark .exec-home .bg-\[\#F2F6FB\] { background-color: #0A1B2E; }
    .dark .exec-home .bg-\[\#0A1B2E\]:not(button):not(.exec-badge-active) { background-color: #1B3B5A; color: #E1E8F0; }
</style>

<div class="w-full max-w-[1240px] mx-auto exec-home text-on-surface font-body-md antialiased pb-12">
@if (isCheckingAuth || (isLoading && dashboard == null))
{
    <div class="bg-surface-container-low p-12 text-center my-6 max-w-lg mx-auto rounded-xl shadow-md border border-white/5">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-primary border-t-transparent"></div>
        <h3 class="font-title-lg text-title-lg text-on-surface font-bold mt-4">Synchronizing Workspace</h3>
        <p class="font-body-sm text-body-sm text-outline mt-1">Loading ecosystem feeds, community channels, and updates...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="p-4 bg-error-container/30 border border-error/30 rounded-xl text-error flex flex-col md:flex-row items-center justify-between gap-3 max-w-3xl mx-auto my-4 shadow-md">
        <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-error/10 text-error flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">warning</span>
            </span>
            <div>
                <h3 class="font-title-md text-title-md font-bold text-error">Unable to synchronize workspace</h3>
                <p class="font-body-sm text-body-sm text-error/80 mt-0.5">@errorMessage</p>
            </div>
        </div>
        <button @onclick="LoadDashboardAsync" class="px-space-md py-1 rounded-lg bg-primary-container text-on-primary-container font-label-md text-label-md font-bold hover:opacity-95 shadow-xs">
            Retry Sync
        </button>
    </div>
}
else if (dashboard != null)
{
    <!-- Ambient Backdrop Light -->
    <div class="relative w-full overflow-hidden pointer-events-none">
        <div class="absolute -top-16 left-1/4 w-72 h-72 rounded-full bg-primary/5 blur-[96px] pointer-events-none"></div>
        <div class="absolute top-8 right-1/6 w-60 h-60 rounded-full bg-secondary-container/10 blur-[80px] pointer-events-none"></div>
    </div>

    <!-- Primary Desktop Viewport Container -->
    <div class="w-full flex flex-col gap-3.5">
        <!-- Sub-Header Ecosystem Ribbon (Tabs & Community Meta) -->
        <div class="w-full bg-surface-container-lowest/90 backdrop-blur-md px-3.5 py-2 rounded-xl mb-1 border border-white/5 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <!-- Tabs Switcher -->
                <div class="flex items-center gap-1 p-0.5 bg-surface-container-low rounded-lg">
                    <button type="button" id="tab-posts" @onclick='() => SetFeedTab("posts")'
                            class="px-3 py-1 rounded-md text-xs font-semibold @(activeFeedTab == "posts" ? "bg-surface-container-high text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all flex items-center gap-1.5 cursor-pointer">
                        <span>Posts</span>
                        <span class="px-1.5 py-0.2 rounded-full @(activeFeedTab == "posts" ? "bg-primary-container/20 text-primary font-bold" : "bg-surface-container text-outline") text-[10px]">@FeedPostCount</span>
                    </button>
                    <button type="button" id="tab-people" @onclick='() => SetFeedTab("people")'
                            class="px-3 py-1 rounded-md text-xs font-semibold @(activeFeedTab == "people" ? "bg-surface-container-high text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all flex items-center gap-1.5 cursor-pointer">
                        <span>People</span>
                        <span class="px-1.5 py-0.2 rounded-full @(activeFeedTab == "people" ? "bg-primary-container/20 text-primary font-bold" : "bg-surface-container text-outline") text-[10px]">@FeedPeopleCount</span>
                    </button>
                    <button type="button" id="tab-groups" @onclick='() => SetFeedTab("groups")'
                            class="px-3 py-1 rounded-md text-xs font-semibold @(activeFeedTab == "groups" ? "bg-surface-container-high text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all flex items-center gap-1.5 cursor-pointer">
                        <span>Groups</span>
                        <span class="px-1.5 py-0.2 rounded-full @(activeFeedTab == "groups" ? "bg-primary-container/20 text-primary font-bold" : "bg-surface-container text-outline") text-[10px]">@FeedGroupCount</span>
                    </button>
                </div>
                <!-- Community Status Indicator -->
                <div class="flex items-center gap-3.5 flex-wrap text-xs text-on-surface-variant">
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="font-mono text-[10.5px] uppercase tracking-wider">Synchronized</span>
                    </div>
                    <div class="hidden sm:flex items-center gap-1 font-mono text-[10.5px]">
                        <span class="material-symbols-outlined text-[14px] text-primary">verified_user</span>
                        <span>Audited Network</span>
                    </div>
                </div>
            </div>
        </div>

        @if (activeFeedTab == "posts")
        {
            <!-- MAIN GRID ARCHITECTURE (Feed Center + Intelligence Sidebar) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg w-full items-start">
                
                <!-- PRIMARY CONTENT COLUMN (Span 8) -->
                <div class="lg:col-span-8 flex flex-col gap-space-md">
                    
                    <!-- 2. QUICK DISPATCH & POLL COMPOSER -->
                    @if (canPostStandalone || currentUserIsAdmin)
                    {
                        <div id="quick-composer" class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-3 border border-white/5">
                            <div class="flex items-center gap-3">
                                <div class="relative flex-shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(dashboard.Profile?.AvatarUrl))
                                    {
                                        <img src="@dashboard.Profile.AvatarUrl" alt="Your profile" class="w-9 h-9 rounded-full object-cover ring-1 ring-white/10" />
                                    }
                                    else
                                    {
                                        <div class="w-9 h-9 rounded-full bg-surface-container-highest text-primary font-bold text-xs flex items-center justify-center shadow-xs">
                                            @(string.IsNullOrWhiteSpace(dashboard.Profile?.DisplayName) ? "U" : dashboard.Profile.DisplayName[..1].ToUpperInvariant())
                                        </div>
                                    }
                                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-primary-container ring-1 ring-surface-container-low flex items-center justify-center">
                                    </span>
                                </div>
                                <div class="flex-1 bg-surface-container-lowest hover:bg-surface-container px-3.5 py-2 rounded-lg cursor-pointer transition-colors shadow-2xs flex items-center justify-between border border-white/5"
                                     @onclick="OpenCreatePostModal">
                                    <span class="text-xs text-outline select-none">Share an update, technical insight, or question...</span>
                                    <span class="material-symbols-outlined text-outline text-[16px]">edit_note</span>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-1 border-t border-white/5">
                                <div class="flex items-center gap-1.5">
                                    <button type="button" @onclick="OpenCreatePostModal"
                                            class="flex items-center gap-1 px-2.5 py-1 rounded-md bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface text-xs font-medium transition-all shadow-2xs cursor-pointer">
                                        <span class="material-symbols-outlined text-primary text-[15px]">draw</span>
                                        <span>Post</span>
                                    </button>
                                    <button type="button" @onclick="OpenCreatePollModal"
                                            class="flex items-center gap-1 px-2.5 py-1 rounded-md bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface text-xs font-medium transition-all shadow-2xs cursor-pointer">
                                        <span class="material-symbols-outlined text-secondary text-[15px]">poll</span>
                                        <span>Poll</span>
                                    </button>
                                </div>
                                <button type="button" @onclick="OpenCreatePostModal"
                                        class="px-3 py-1 rounded-md bg-primary-container text-on-primary-container text-xs font-semibold tracking-wide hover:opacity-95 shadow-xs flex items-center gap-1 transition-transform active:scale-95 cursor-pointer">
                                    <span>Create</span>
                                    <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- 3. LIVE COMMUNITY POLL CARDS -->
                    @if (dashboard.ActivePolls != null && dashboard.ActivePolls.Any())
                    {
                        @foreach (var poll in dashboard.ActivePolls.Take(2))
                        {
                            <div class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-2.5 relative overflow-hidden border border-white/5">
                                <div class="absolute top-0 right-0 w-48 h-24 bg-primary/5 rounded-bl-full pointer-events-none"></div>
                                <!-- Poll Header -->
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex flex-col gap-0.5">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-surface-container-highest text-primary font-mono text-[10px] uppercase tracking-wider font-bold">
                                                <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
                                                Active Ballot
                                            </span>
                                            <span class="text-outline font-mono text-[10px]">#@poll.PollId</span>
                                        </div>
                                        <h2 class="text-sm sm:text-base text-on-surface font-bold mt-1">
                                            @poll.Question
                                        </h2>
                                    </div>
                                    <a href="polls" class="text-outline hover:text-on-surface p-1 rounded-md transition-colors" title="View poll details">
                                        <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                                    </a>
                                </div>

                                <!-- Originator Subtext -->
                                <div class="flex items-center gap-2 text-on-surface-variant text-xs flex-wrap">
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-4 h-4 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-[9px]">
                                            @(string.IsNullOrWhiteSpace(poll.AuthorName) ? "S" : poll.AuthorName[..1].ToUpperInvariant())
                                        </div>
                                        <span class="text-on-surface font-semibold text-xs">@poll.AuthorName</span>
                                    </div>
                                    <span>•</span>
                                    <span>@(poll.TotalVotes) votes</span>
                                    <span>•</span>
                                    <span class="text-primary font-medium">@(poll.IsExpired ? "Closed" : "Open")</span>
                                </div>

                                <!-- Interactive Voting Bars -->
                                <div class="flex flex-col gap-1.5 pt-0.5" id="poll-container">
                                    @for (int optIdx = 0; optIdx < poll.Options.Count; optIdx++)
                                    {
                                        var opt = poll.Options[optIdx];
                                        var letter = (char)('A' + (optIdx % 26));
                                        var hasUserVotedThis = opt.IsVotedByCurrentUser;
                                        var canVote = !poll.HasVoted && !poll.IsExpired;

                                        <div class="cursor-pointer group relative p-2 sm:p-2.5 rounded-lg bg-surface-container-lowest hover:bg-surface-container overflow-hidden transition-all duration-200 border border-white/5"
                                             @onclick="async () => { if (canVote) await VotePollFromHomeAsync(poll.PollId, opt.OptionId); }">
                                            <!-- Progress fill -->
                                            <div class="absolute inset-y-0 left-0 @(hasUserVotedThis ? "bg-primary/25" : "bg-primary/15") rounded-lg transition-all duration-500" style="width: @(opt.Percentage)%;"></div>
                                            <div class="relative flex items-center justify-between z-10 gap-2">
                                                <div class="flex items-center gap-2 min-w-0">
                                                    @if (hasUserVotedThis)
                                                    {
                                                        <div class="w-4 h-4 rounded-full bg-primary text-on-primary flex items-center justify-center text-[10px] shadow-xs shrink-0">
                                                            <span class="material-symbols-outlined text-[12px]">check</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="w-4 h-4 rounded-full bg-surface-container text-outline flex items-center justify-center text-[10px] shrink-0 font-bold">
                                                            @letter
                                                        </div>
                                                    }
                                                    <span class="text-xs sm:text-[13px] text-on-surface font-medium group-hover:text-primary transition-colors truncate">
                                                        @opt.Text
                                                    </span>
                                                </div>
                                                <div class="flex items-center gap-2 shrink-0">
                                                    <span class="text-[11px] text-outline">@opt.VoteCount votes</span>
                                                    <span class="text-xs @(hasUserVotedThis ? "text-primary" : "text-on-surface-variant") font-bold">@opt.Percentage%</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Poll Footer -->
                                <div class="flex items-center justify-between pt-1 text-outline text-[11px]">
                                    <span class="flex items-center gap-1 text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[14px] text-primary">verified</span>
                                        Verified tally (@poll.TotalVotes total ballots)
                                    </span>
                                    <a href="polls" class="text-primary hover:underline font-semibold">Audit Ballot →</a>
                                </div>
                            </div>
                        }
                    }

                    <!-- 4. EXECUTIVE BROADCAST STREAM (POSTS FEED) -->
                    <div class="flex flex-col gap-3.5" id="feed-stream">
                        @if (!feedPosts.Any())
                        {
                            <div class="bg-surface-container-low p-6 sm:p-8 rounded-xl text-center flex flex-col items-center gap-2 shadow-xs border border-white/5">
                                <span class="w-10 h-10 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[20px]">terminal</span>
                                </span>
                                <h3 class="text-sm font-bold text-on-surface">No broadcasts published yet</h3>
                                <p class="text-xs text-outline max-w-sm">Publish your first dispatch above to start the discussion.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var post in feedPosts)
                            {
                                <article class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-2.5 border border-white/5 relative">
                                    <!-- Post Header -->
                                    <div class="flex items-start justify-between">
                                        <div class="flex items-center gap-2.5">
                                            <div class="relative shrink-0">
                                                @if (!string.IsNullOrWhiteSpace(post.AuthorAvatar))
                                                {
                                                    <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-9 h-9 rounded-full object-cover ring-1 ring-white/10" />
                                                }
                                                else
                                                {
                                                    <div class="w-9 h-9 rounded-full bg-surface-container text-primary font-bold text-xs flex items-center justify-center ring-1 ring-white/10">
                                                        @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName[..1].ToUpperInvariant())
                                                    </div>
                                                }
                                                @if (post.IsAuthorVerified)
                                                {
                                                    <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-primary-container ring-1 ring-surface-container-low flex items-center justify-center">
                                                        <span class="material-symbols-outlined text-[8px] text-on-primary-container font-black">check</span>
                                                    </span>
                                                }
                                            </div>

                                            <div class="flex flex-col">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <a href="u/@post.AuthorName" class="text-xs sm:text-sm font-bold text-on-surface hover:text-primary transition-colors">
                                                        @post.AuthorName
                                                    </a>
                                                    @if (post.AuthorRoleCode == "PUBLIC_FIGURE")
                                                    {
                                                        <span class="px-1.5 py-0.2 rounded-full bg-primary-container text-on-primary-container font-mono text-[9px] uppercase font-bold">Lead</span>
                                                    }
                                                    else if (post.AuthorRoleCode == "DOMAIN_PROFESSIONAL")
                                                    {
                                                        <span class="px-1.5 py-0.2 rounded-full bg-primary-container text-on-primary-container font-mono text-[9px] uppercase font-bold">Pro</span>
                                                    }
                                                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-highest text-secondary font-mono text-[9px] font-semibold">Author</span>

                                                    @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                                    {
                                                        <span class="px-2 py-0.2 rounded-full bg-surface-container text-on-surface-variant text-[10px] font-semibold">@post.CommunityName</span>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(post.GroupName))
                                                    {
                                                        <span class="px-2 py-0.2 rounded-full bg-surface-container text-on-surface-variant text-[10px] font-semibold">@post.GroupName</span>
                                                    }
                                                </div>
                                                <span class="text-[11px] text-outline">
                                                    @(string.IsNullOrWhiteSpace(post.CommunityName) ? "Network Broadcast" : post.CommunityName) • @GetRelativeTime(post.CreatedAt)
                                                </span>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-0.5 relative">
                                            <button type="button" @onclick="() => ToggleSavePost(post.PostId)"
                                                    class="p-1 text-outline hover:text-on-surface rounded-md transition-colors cursor-pointer"
                                                    title="@(post.IsSavedByCurrentUser ? "Unsave" : "Save")">
                                                <span class="material-symbols-outlined text-[17px] @(post.IsSavedByCurrentUser ? "text-primary" : "")">
                                                    @(post.IsSavedByCurrentUser ? "bookmark" : "bookmark_border")
                                                </span>
                                            </button>

                                            <button type="button" @onclick="() => TogglePostMenu(post.PostId)"
                                                    class="p-1 text-outline hover:text-on-surface rounded-md cursor-pointer">
                                                <span class="material-symbols-outlined text-[18px]">more_vert</span>
                                            </button>

                                            @if (activeMenuPostId == post.PostId)
                                            {
                                                <div class="absolute right-0 top-7 w-40 bg-surface-container-high rounded-lg shadow-xl border border-white/10 py-1 z-30">
                                                    <button type="button" @onclick="() => ToggleSavePost(post.PostId)" class="w-full text-left px-3 py-1.5 text-xs font-medium text-on-surface hover:bg-surface-container flex items-center gap-2 transition cursor-pointer">
                                                        <span>@(post.IsSavedByCurrentUser ? "★" : "☆")</span>
                                                        <span>@(post.IsSavedByCurrentUser ? "Unsave Post" : "Save Post")</span>
                                                    </button>
                                                    @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                                    {
                                                        <button type="button" @onclick="() => OpenEditPost(post)" class="w-full text-left px-3 py-1.5 text-xs font-medium text-on-surface hover:bg-surface-container flex items-center gap-2 transition cursor-pointer">
                                                            <span class="material-symbols-outlined text-[13px]">edit</span>
                                                            <span>Edit Post</span>
                                                        </button>
                                                        <div class="border-t border-white/10 my-0.5"></div>
                                                        <button type="button" @onclick="() => PromptRecyclePost(post.PostId)" class="w-full text-left px-3 py-1.5 text-xs font-medium text-error hover:bg-error-container/30 flex items-center gap-2 transition cursor-pointer">
                                                            <span class="material-symbols-outlined text-[13px]">delete</span>
                                                            <span>Move to Trash</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Post Body -->
                                    <p class="text-xs sm:text-[13px] text-on-surface leading-relaxed whitespace-pre-line">
                                        @post.Content
                                    </p>

                                    <!-- Code Block Component -->
                                    @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                    {
                                        <div class="bg-surface-container-lowest rounded-lg overflow-hidden shadow-xs flex flex-col border border-white/5">
                                            <div class="bg-surface-container-high px-3 py-1.5 flex items-center justify-between">
                                                <div class="flex items-center gap-1.5 font-mono text-[11px] text-on-surface-variant">
                                                    <span class="material-symbols-outlined text-primary text-[14px]">data_object</span>
                                                    <span>@(string.IsNullOrWhiteSpace(post.CodeFileName) ? "snippet.cs" : post.CodeFileName)</span>
                                                </div>
                                                <button type="button" class="flex items-center gap-1 text-[11px] text-outline hover:text-on-surface transition-colors cursor-pointer"
                                                        @onclick="() => CopyCodeSnippetAsync(post.CodeSnippet)">
                                                    <span class="material-symbols-outlined text-[13px]">content_copy</span>
                                                    <span>Copy</span>
                                                </button>
                                            </div>
                                            <pre class="p-3 font-mono text-xs text-tertiary overflow-x-auto leading-5 max-h-56"><code>@post.CodeSnippet</code></pre>
                                        </div>
                                    }

                                    <!-- Gallery Carousel -->
                                    @if (post.ImageUrls != null && post.ImageUrls.Any())
                                    {
                                        var imgCount = post.ImageUrls.Count;
                                        var activeIdx = Math.Clamp(GetActiveImageIndex(post.PostId), 0, imgCount - 1);
                                        var currentImage = post.ImageUrls[activeIdx];

                                        <div class="relative w-full rounded-lg overflow-hidden bg-surface-container-lowest group border border-white/5">
                                            <!-- Carousel Images Track -->
                                            <div class="w-full h-48 sm:h-60 flex transition-transform duration-500 ease-out">
                                                <div class="w-full h-full flex-shrink-0 relative">
                                                    <img class="w-full h-full object-cover" src="@currentImage" alt="Media attachment @(activeIdx + 1)" />
                                                    <div class="absolute bottom-2.5 left-3 bg-surface-dim/80 backdrop-blur-md px-2 py-0.5 rounded text-[11px] text-on-surface">
                                                        @(activeIdx + 1) of @imgCount
                                                    </div>
                                                </div>
                                            </div>

                                            @if (imgCount > 1)
                                            {
                                                <!-- Pill Counter Badge -->
                                                <div class="absolute top-2.5 right-2.5 bg-surface-dim/80 backdrop-blur-md px-2 py-0.5 rounded-full text-[10px] text-on-surface font-mono shadow-xs">
                                                    @(activeIdx + 1) / @imgCount
                                                </div>

                                                <!-- Carousel Controls -->
                                                @if (activeIdx > 0)
                                                {
                                                    <button type="button" @onclick="() => PrevImage(post.PostId, imgCount)"
                                                            class="absolute left-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-surface-dim/80 text-on-surface flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md hover:bg-surface-container cursor-pointer z-10">
                                                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                                    </button>
                                                }

                                                @if (activeIdx < imgCount - 1)
                                                {
                                                    <button type="button" @onclick="() => NextImage(post.PostId, imgCount)"
                                                            class="absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-surface-dim/80 text-on-surface flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md hover:bg-surface-container cursor-pointer z-10">
                                                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                                    </button>
                                                }

                                                <!-- Pagination Indicator Dots -->
                                                <div class="absolute bottom-2.5 right-3 flex items-center gap-1 z-10">
                                                    @for (int dotIdx = 0; dotIdx < imgCount; dotIdx++)
                                                    {
                                                        var targetIdx = dotIdx;
                                                        <button type="button" @onclick="() => SetActiveImage(post.PostId, targetIdx)"
                                                                class="@(dotIdx == activeIdx ? "w-2 h-2 rounded-full bg-primary transition-all" : "w-1.5 h-1.5 rounded-full bg-on-surface-variant/50 transition-all") cursor-pointer"></button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Engagement Strip -->
                                    <div class="flex items-center justify-between pt-1 border-t border-white/5">
                                        <div class="flex items-center gap-4">
                                            <button type="button" @onclick="() => ToggleLikeAsync(post.PostId)"
                                                    class="flex items-center gap-1 text-xs @(post.IsLikedByCurrentUser ? "text-error" : "text-on-surface-variant hover:text-error") transition-colors cursor-pointer">
                                                <span class="material-symbols-outlined text-[17px] @(post.IsLikedByCurrentUser ? "text-error" : "")">favorite</span>
                                                <span>@post.LikeCount</span>
                                            </button>
                                            <button type="button" @onclick="() => ToggleHomeCommentBox(post.PostId)"
                                                    class="flex items-center gap-1 text-xs text-on-surface-variant hover:text-primary transition-colors cursor-pointer">
                                                <span class="material-symbols-outlined text-[17px]">chat_bubble</span>
                                                <span>@post.CommentCount</span>
                                            </button>
                                            <button type="button" @onclick="() => OpenHomeShareModal(post.PostId)"
                                                    class="flex items-center gap-1 text-xs text-on-surface-variant hover:text-secondary transition-colors cursor-pointer">
                                                <span class="material-symbols-outlined text-[17px]">cached</span>
                                                <span>@post.ShareCount</span>
                                            </button>
                                        </div>

                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center gap-1 text-outline text-[11px]">
                                                <span class="material-symbols-outlined text-[14px]">visibility</span>
                                                <span>@(post.LikeCount + post.CommentCount + post.ShareCount) signals</span>
                                            </div>
                                            <button type="button" @onclick="() => ToggleSavePost(post.PostId)"
                                                    class="text-outline hover:text-on-surface cursor-pointer"
                                                    title="@(post.IsSavedByCurrentUser ? "Unsave" : "Save")">
                                                <span class="material-symbols-outlined text-[16px] @(post.IsSavedByCurrentUser ? "text-primary" : "")">
                                                    @(post.IsSavedByCurrentUser ? "bookmark" : "bookmark_border")
                                                </span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Comments Drawer -->
                                    @if (openHomeCommentPostIds.Contains(post.PostId))
                                    {
                                        <div class="comments-drawer flex flex-col gap-2 pt-2 border-t border-white/5">
                                            <div class="flex items-center gap-2 bg-surface-container-lowest p-2 rounded-lg border border-white/5">
                                                <input type="text" @bind="homeCommentInputs[post.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitHomeCommentAsync(post.PostId); })"
                                                       placeholder="Add a comment or technical inquiry..."
                                                       class="bg-transparent text-on-surface text-xs w-full focus:outline-none placeholder:text-outline" />
                                                <button type="button" @onclick="() => SubmitHomeCommentAsync(post.PostId)"
                                                        class="px-2.5 py-1 bg-primary text-on-primary text-xs rounded-md font-semibold cursor-pointer">Post</button>
                                            </div>

                                            @if (homeCommentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                            {
                                                @if (commentList.Count == 0)
                                                {
                                                    <p class="text-xs text-outline text-center py-1">No comments recorded yet.</p>
                                                }
                                                else
                                                {
                                                    @foreach (var c in commentList)
                                                    {
                                                        <div class="flex items-start gap-2 pt-1.5">
                                                            <div class="w-6 h-6 rounded-full bg-surface-container-highest text-primary flex items-center justify-center font-bold text-[10px] shrink-0">
                                                                @(string.IsNullOrWhiteSpace(c.AuthorName) ? "U" : c.AuthorName[..1].ToUpperInvariant())
                                                            </div>
                                                            <div class="bg-surface-container p-2 rounded-lg flex-1 border border-white/5">
                                                                <div class="flex items-center justify-between mb-0.5">
                                                                    <span class="text-xs font-semibold text-on-surface">@c.AuthorName</span>
                                                                    <span class="text-outline text-[10px]">@GetRelativeTime(c.CreatedAt)</span>
                                                                </div>
                                                                <p class="text-on-surface-variant text-xs">@c.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                </article>
                            }

                            <!-- Infinite Scroll Loading Indicator & Sentinel -->
                            @if (isLoadingMoreFeed)
                            {
                                <div class="py-4 flex items-center justify-center gap-2 text-on-surface-variant text-xs font-medium">
                                    <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-primary border-t-transparent"></div>
                                    <span>Loading more posts...</span>
                                </div>
                            }
                            else if (!hasMoreFeedPosts && feedPosts.Count > 0)
                            {
                                <div class="py-4 text-center">
                                    <span class="font-mono text-[11px] text-outline">You've reached the end of the feed</span>
                                </div>
                            }

                            <!-- Invisible Sentinel Element Observed for Infinite Scroll -->
                            <div id="feed-infinite-sentinel" class="h-2 w-full"></div>
                        }
                    </div>
                </div>

                <!-- SECONDARY SIDEBAR / DIRECTORY & GUILDS (Span 4) -->
                <aside class="lg:col-span-4 flex flex-col gap-3.5">
                    <!-- 5. PEOPLE / EXECUTIVE DIRECTORY PREVIEW WIDGET -->
                    <div class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-2.5 border border-white/5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-primary text-[17px]">verified_user</span>
                                <h3 class="text-xs sm:text-sm font-bold text-on-surface">Vetted People</h3>
                            </div>
                            <button type="button" @onclick='() => SetFeedTab("people")' class="text-xs text-primary hover:underline font-semibold cursor-pointer">
                                See all (@(dashboard.People?.Count ?? 0))
                            </button>
                        </div>

                        <div class="flex flex-col gap-2">
                            @if (dashboard.People != null && dashboard.People.Any())
                            {
                                @foreach (var person in dashboard.People.Take(2))
                                {
                                    <div class="p-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high transition-all flex flex-col gap-2 shadow-xs group border border-white/5">
                                        <div class="flex items-start justify-between">
                                            <div class="flex items-center gap-2">
                                                <div class="relative shrink-0">
                                                    @if (!string.IsNullOrWhiteSpace(person.AvatarUrl))
                                                    {
                                                        <img src="@person.AvatarUrl" alt="@person.DisplayName" class="w-8 h-8 rounded-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-8 h-8 rounded-full bg-surface-container-lowest text-primary font-bold text-xs flex items-center justify-center">
                                                            @GetPersonInitials(person)
                                                        </div>
                                                    }
                                                    <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center text-[8px] ring-1 ring-surface-container">
                                                        ★
                                                    </span>
                                                </div>
                                                <div class="flex flex-col min-w-0">
                                                    <a href="u/@person.UserName" class="text-xs font-bold text-on-surface group-hover:text-primary transition-colors truncate">
                                                        @(string.IsNullOrWhiteSpace(person.DisplayName) ? person.UserName : person.DisplayName)
                                                    </a>
                                                    <span class="text-[11px] text-outline truncate">
                                                        @(string.IsNullOrWhiteSpace(person.Headline) ? GetRoleBadgeText(person) : person.Headline)
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="flex items-center text-primary text-[10px] font-bold bg-surface-container-highest px-1.5 py-0.2 rounded shrink-0">
                                                ★ @(person.AverageRating.HasValue && person.AverageRating.Value > 0 ? person.AverageRating.Value.ToString("F1") : "New")
                                            </div>
                                        </div>

                                        <!-- Skill Pills -->
                                        @if (person.Skills != null && person.Skills.Any())
                                        {
                                            <div class="flex items-center gap-1 flex-wrap">
                                                @foreach (var sk in person.Skills.Take(3))
                                                {
                                                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-lowest text-on-surface-variant text-[10px]">@sk</span>
                                                }
                                            </div>
                                        }

                                        <div class="flex items-center justify-between pt-0.5">
                                            <span class="text-outline text-[10px]">@(person.IsVerified ? "Verified Member" : "Active Member")</span>
                                            <a href="u/@person.UserName" class="px-2.5 py-0.5 rounded-md bg-surface-container-highest hover:bg-primary hover:text-on-primary text-on-surface text-xs font-semibold transition-colors">
                                                Connect
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- 6. COLLABORATIVE GROUPS / GUILDS PREVIEW WIDGET -->
                    <div class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-2.5 border border-white/5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-secondary text-[17px]">groups</span>
                                <h3 class="text-xs sm:text-sm font-bold text-on-surface">Collaborative Groups</h3>
                            </div>
                            <button type="button" @onclick='() => SetFeedTab("groups")' class="text-xs text-primary hover:underline font-semibold cursor-pointer">
                                Explore (@(dashboard.Groups?.Count ?? 0))
                            </button>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            @if (dashboard.Groups != null && dashboard.Groups.Any())
                            {
                                @foreach (var g in dashboard.Groups.Take(3))
                                {
                                    <div class="p-2 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors flex items-center justify-between gap-2 relative overflow-hidden group border border-white/5">
                                        <div class="absolute left-0 inset-y-0 w-0.5 bg-primary"></div>
                                        <div class="flex items-center gap-2 pl-1.5 min-w-0">
                                            <div class="w-8 h-8 rounded-md bg-surface-container-highest flex items-center justify-center text-primary flex-shrink-0 font-bold">
                                                <span class="material-symbols-outlined text-[17px]">@GetGroupIcon(g)</span>
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="text-xs text-on-surface font-semibold truncate group-hover:text-primary transition-colors">@g.Name</span>
                                                <span class="text-[10px] text-outline truncate">@(g.MemberCount) members • @g.PostCount posts</span>
                                            </div>
                                        </div>
                                        <a href="group/@g.GroupId" class="px-2 py-0.5 rounded bg-surface-container-lowest text-primary text-xs font-bold flex items-center gap-0.5 hover:bg-primary hover:text-on-primary transition-colors flex-shrink-0">
                                            <span>Enter</span>
                                            <span class="text-[11px]">→</span>
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-outline p-2 text-center">No collaborative groups joined yet.</p>
                            }
                        </div>
                    </div>

                    <!-- 7. NETWORK LIQUIDITY & TREASURY MINI-MONITOR -->
                    <div class="bg-surface-container-low p-3.5 sm:p-4 rounded-xl shadow-xs flex flex-col gap-2.5 border border-white/5">
                        <div class="flex items-center justify-between">
                            <span class="font-mono text-[10px] uppercase tracking-wider text-outline font-bold">LinkDrop Vault</span>
                            <span class="font-mono text-[10px] text-primary font-bold">LIVE STAKING</span>
                        </div>
                        <div class="flex items-baseline justify-between">
                            <div>
                                <span class="text-xl sm:text-2xl text-on-surface font-bold tracking-tight">@((userLinkDropBalance + (dashboard?.People?.Count ?? 0) * 500).ToString("N0"))</span>
                                <span class="text-xs text-outline ml-1">$LNK</span>
                            </div>
                            <div class="flex items-center text-primary text-xs font-semibold gap-1">
                                <span class="material-symbols-outlined text-[13px]">account_balance_wallet</span>
                                @userLinkDropBalance.ToString("N0")
                            </div>
                        </div>
                        <!-- Inline Progress Sparkline Visualization -->
                        <div class="w-full bg-surface-container-lowest rounded-full h-1.5 overflow-hidden flex border border-white/5">
                            <div class="bg-primary h-full rounded-full" style="width: 60%;"></div>
                            <div class="bg-secondary h-full" style="width: 25%;"></div>
                            <div class="bg-tertiary h-full" style="width: 15%;"></div>
                        </div>
                        <div class="flex items-center justify-between text-outline text-[10px] pt-0.5">
                            <div class="flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                <span>Peers (60%)</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                <span>Guilds (25%)</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                                <span>Vault (15%)</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        }
        else if (activeFeedTab == "people")
        {
            <!-- Search & Filter Controls Matrix -->
            <section class="w-full bg-surface-container-low rounded-xl p-3 sm:p-3.5 mb-3.5 shadow-xs border border-white/5">
                <div class="flex flex-col md:flex-row items-center gap-2.5">
                    <!-- Search Input -->
                    <div class="relative flex-1 w-full">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">manage_search</span>
                        <input class="w-full bg-surface-container-lowest text-on-surface placeholder:text-outline text-xs pl-9 pr-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary transition-all border border-white/5"
                               id="member-search"
                               placeholder="Search @(dashboard?.People?.Count ?? 0) verified members, architects, core leads..."
                               type="text"
                               @bind="peopleSearchQuery"
                               @bind:event="oninput" />
                        <span class="hidden sm:inline-block absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-outline px-1.5 py-0.2 bg-surface-container rounded border border-white/5">⌘K</span>
                    </div>
                    <!-- Sort & View Controls -->
                    <div class="flex items-center gap-2 w-full md:w-auto justify-between md:justify-end">
                        <div class="relative flex-1 md:flex-initial">
                            <select @bind="peopleSortOption"
                                    class="w-full appearance-none bg-surface-container-lowest text-on-surface text-xs pl-3 pr-8 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer transition-all border border-white/5">
                                <option value="reputation">Highest Reputation (★)</option>
                                <option value="recent">Recently Active</option>
                                <option value="sla">Response Time</option>
                                <option value="followed">Followed Members</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">unfold_more</span>
                        </div>
                        <!-- View Switcher -->
                        <div class="flex items-center bg-surface-container-lowest p-0.5 rounded-lg border border-white/5">
                            <button type="button" @onclick="() => isPeopleGridView = true"
                                    class="p-1 rounded-md @(isPeopleGridView ? "bg-surface-container-high text-primary shadow-xs" : "text-outline hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer"
                                    id="view-grid" title="Grid View">
                                <span class="material-symbols-outlined text-[17px] block">grid_view</span>
                            </button>
                            <button type="button" @onclick="() => isPeopleGridView = false"
                                    class="p-1 rounded-md @(!isPeopleGridView ? "bg-surface-container-high text-primary shadow-xs" : "text-outline hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer"
                                    id="view-list" title="List View">
                                <span class="material-symbols-outlined text-[17px] block">format_list_bulleted</span>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Filter Pills Row -->
                <div class="flex items-center gap-1.5 mt-2.5 overflow-x-auto pb-0.5 scrollbar-none">
                    <button type="button" @onclick='() => SetPeopleRoleFilter("ALL")'
                            class="px-2.5 py-1 rounded-full text-xs font-medium uppercase tracking-wider @(selectedPeopleRoleFilter == "ALL" ? "bg-primary-container text-on-primary-container font-semibold shadow-xs" : "bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high") transition-all flex-shrink-0 cursor-pointer">
                        All (@PeopleCountAll)
                    </button>
                    <button type="button" @onclick='() => SetPeopleRoleFilter("PUBLIC_FIGURE")'
                            class="px-2.5 py-1 rounded-full text-xs font-medium uppercase tracking-wider @(selectedPeopleRoleFilter == "PUBLIC_FIGURE" ? "bg-primary-container text-on-primary-container font-semibold shadow-xs" : "bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high") transition-all flex-shrink-0 cursor-pointer">
                        Public Figures (@PeopleCountPublicFigure)
                    </button>
                    <button type="button" @onclick='() => SetPeopleRoleFilter("DOMAIN_PROFESSIONAL")'
                            class="px-2.5 py-1 rounded-full text-xs font-medium uppercase tracking-wider @(selectedPeopleRoleFilter == "DOMAIN_PROFESSIONAL" ? "bg-primary-container text-on-primary-container font-semibold shadow-xs" : "bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high") transition-all flex-shrink-0 cursor-pointer">
                        Professionals (@PeopleCountDomainPro)
                    </button>
                    <button type="button" @onclick='() => SetPeopleRoleFilter("FOUNDER")'
                            class="px-2.5 py-1 rounded-full text-xs font-medium uppercase tracking-wider @(selectedPeopleRoleFilter == "FOUNDER" ? "bg-primary-container text-on-primary-container font-semibold shadow-xs" : "bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high") transition-all flex-shrink-0 cursor-pointer">
                        Founders (@PeopleCountFounders)
                    </button>
                    <button type="button" @onclick='() => SetPeopleRoleFilter("CORE_LEAD")'
                            class="px-2.5 py-1 rounded-full text-xs font-medium uppercase tracking-wider @(selectedPeopleRoleFilter == "CORE_LEAD" ? "bg-primary-container text-on-primary-container font-semibold shadow-xs" : "bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high") transition-all flex-shrink-0 cursor-pointer">
                        Core Leads (@PeopleCountCoreLeads)
                    </button>
                </div>
            </section>

            <!-- Advisory Spotlight Ribbon (Hero Cards) -->
            @if (SpotlightPeople.Any())
            {
                <section class="w-full mb-4">
                    <div class="flex items-center justify-between mb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px]">stars</span>
                            <h2 class="text-sm sm:text-base text-on-surface font-bold">Advisory Spotlight</h2>
                            <span class="px-2 py-0.2 bg-primary/10 text-primary rounded-full text-[10px] font-semibold tracking-wide uppercase border border-primary/20">Featured</span>
                        </div>
                        <div class="flex items-center gap-1 text-outline text-xs">
                            <span>Curated Members</span>
                            <span class="material-symbols-outlined text-[14px] text-primary">verified</span>
                        </div>
                    </div>
                    <!-- Spotlight Cards Carousel Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        @foreach (var spotlight in SpotlightPeople)
                        {
                            <div class="bg-gradient-to-b from-surface-container-high to-surface-container-low rounded-xl p-3.5 sm:p-4 flex flex-col justify-between relative overflow-hidden group shadow-xs hover:shadow-md transition-all border border-white/5">
                                <div class="absolute -right-8 -top-8 w-24 h-24 bg-primary/10 rounded-full blur-xl pointer-events-none group-hover:bg-primary/20 transition-all"></div>
                                <div>
                                    <div class="flex items-start justify-between gap-2 mb-2.5">
                                        <div class="relative">
                                            @if (!string.IsNullOrWhiteSpace(spotlight.AvatarUrl))
                                            {
                                                <img class="w-11 h-11 rounded-lg object-cover shadow-xs" src="@spotlight.AvatarUrl" alt="@spotlight.DisplayName" />
                                            }
                                            else
                                            {
                                                <div class="w-11 h-11 rounded-lg bg-surface-container-highest text-primary font-bold text-sm flex items-center justify-center border border-white/10 shadow-xs">
                                                    @GetPersonInitials(spotlight)
                                                </div>
                                            }
                                            <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-primary text-background rounded-full flex items-center justify-center text-[8px] font-bold ring-1 ring-surface-container-high" title="Online & Available">✓</span>
                                        </div>
                                        <div class="flex flex-col items-end">
                                            <span class="px-1.5 py-0.2 rounded bg-primary-container text-on-primary-container font-mono text-[9px] font-bold uppercase tracking-wider flex items-center gap-0.5 shadow-xs">
                                                <span class="material-symbols-outlined text-[11px]">workspace_premium</span>
                                                @GetRoleBadgeText(spotlight)
                                            </span>
                                            <span class="text-xs text-primary mt-0.5 flex items-center gap-0.5 font-bold">
                                                <span class="material-symbols-outlined text-[13px]">star</span>
                                                @((spotlight.AverageRating.HasValue && spotlight.AverageRating.Value > 0 ? spotlight.AverageRating.Value.ToString("F1") : "5.0"))
                                                @if (spotlight.RatingCount > 0)
                                                {
                                                    <span class="text-outline text-[10px]">(@spotlight.RatingCount)</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <a href="u/@spotlight.UserName">
                                        <h3 class="text-xs sm:text-sm text-on-surface group-hover:text-primary transition-colors font-bold truncate">
                                            @(string.IsNullOrWhiteSpace(spotlight.DisplayName) ? spotlight.UserName : spotlight.DisplayName)
                                        </h3>
                                    </a>
                                    <p class="text-[11px] text-outline mb-1 truncate">@@@spotlight.UserName @(!string.IsNullOrWhiteSpace(spotlight.Headline) ? $"· {spotlight.Headline}" : "")</p>
                                    <p class="text-xs text-on-surface-variant line-clamp-2 mb-2.5">
                                        @(string.IsNullOrWhiteSpace(spotlight.Bio) ? (spotlight.Headline ?? GetRoleBadgeText(spotlight)) : spotlight.Bio)
                                    </p>
                                    @if (spotlight.Skills != null && spotlight.Skills.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mb-2.5">
                                            @foreach (var sk in spotlight.Skills.Take(3))
                                            {
                                                <span class="px-1.5 py-0.2 bg-surface-container-lowest text-tertiary text-[10px] rounded border border-white/5">@sk</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="pt-2.5 mt-1 border-t border-white/5 bg-surface-container-lowest/60 -mx-3.5 -mb-3.5 sm:-mx-4 sm:-mb-4 p-3 rounded-b-xl flex items-center justify-between">
                                    <div class="flex flex-col">
                                        <span class="text-[10px] text-outline uppercase tracking-wider">Rate</span>
                                        <span class="text-xs text-primary font-bold">@(spotlight.RoleCode == "PUBLIC_FIGURE" ? "250 Drops" : "150 Drops") <span class="text-[10px] text-on-surface-variant font-normal">/ session</span></span>
                                    </div>
                                    <a href="u/@spotlight.UserName" class="px-3 py-1 bg-primary text-on-primary rounded-md text-xs font-semibold hover:bg-primary-fixed transition-colors flex items-center gap-1 shadow-xs">
                                        <span>Connect</span>
                                        <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- Main Split Architecture: Directory Grid + Right Ecosystem Sidebar -->
            <div class="grid grid-cols-1 xl:grid-cols-12 gap-4 items-start">
                <!-- Left Column: Member Card Directory Grid (8 Cols on xl) -->
                <div class="xl:col-span-8 flex flex-col gap-3.5">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm sm:text-base text-on-surface flex items-center gap-1.5 font-bold">
                            <span>Verified Network Fellows</span>
                            <span class="text-outline text-xs font-normal">(@PagedPeople.Count() of @FilteredPeople.Count)</span>
                        </h2>
                        <span class="text-xs text-on-surface-variant uppercase tracking-wider hidden sm:inline">Consensus Roster</span>
                    </div>

                    <!-- Member Grid Container -->
                    @if (!FilteredPeople.Any())
                    {
                        <div class="bg-surface-container-low rounded-xl p-8 text-center border border-white/5 space-y-2">
                            <span class="material-symbols-outlined text-3xl text-outline">search_off</span>
                            <p class="text-sm font-semibold text-on-surface">No verified fellows found matching your filters.</p>
                            <p class="text-xs text-outline">Try clearing the search query or selecting "All".</p>
                            <button type="button" @onclick='() => { peopleSearchQuery = string.Empty; selectedPeopleRoleFilter = "ALL"; }' class="px-3 py-1 bg-primary text-on-primary rounded-md text-xs font-semibold hover:bg-primary-fixed transition-colors cursor-pointer">
                                Clear Filters
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="@(isPeopleGridView ? "grid grid-cols-1 md:grid-cols-2 gap-3" : "flex flex-col gap-3")" id="directory-grid-container">
                            @foreach (var person in PagedPeople)
                            {
                                <div class="bg-surface-container-low hover:bg-surface-container rounded-xl p-3 sm:p-3.5 flex flex-col justify-between shadow-xs hover:shadow-sm transition-all group border border-white/5">
                                    <div>
                                        <div class="flex items-start justify-between gap-2 mb-2">
                                            <div class="flex items-center gap-2.5">
                                                <div class="relative flex-shrink-0">
                                                    @if (!string.IsNullOrWhiteSpace(person.AvatarUrl))
                                                    {
                                                        <img class="w-9 h-9 rounded-lg object-cover" src="@person.AvatarUrl" alt="@person.DisplayName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-9 h-9 rounded-lg bg-surface-container-highest text-primary font-bold text-xs flex items-center justify-center border border-white/5">
                                                            @GetPersonInitials(person)
                                                        </div>
                                                    }
                                                    <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full @(person.AvailabilityStatus?.ToLower().Contains("busy") == true ? "bg-amber-400" : "bg-emerald-500") ring-1 ring-surface-container-low" title="@(person.AvailabilityStatus ?? "Available")"></span>
                                                </div>
                                                <div class="min-w-0">
                                                    <a href="u/@person.UserName" class="text-xs sm:text-sm text-on-surface group-hover:text-primary transition-colors flex items-center gap-1 font-bold truncate">
                                                        @(string.IsNullOrWhiteSpace(person.DisplayName) ? person.UserName : person.DisplayName)
                                                    </a>
                                                    <p class="text-[11px] text-outline truncate">@@@person.UserName</p>
                                                </div>
                                            </div>
                                            <span class="px-1.5 py-0.2 rounded @(person.RoleCode == "PUBLIC_FIGURE" ? "bg-primary-container text-on-primary-container" : person.RoleCode == "DOMAIN_PROFESSIONAL" ? "bg-secondary-container/30 text-secondary" : "bg-surface-container text-tertiary") font-mono text-[9px] uppercase tracking-wider font-semibold flex items-center gap-0.5 shrink-0">
                                                <span class="material-symbols-outlined text-[10px]">@(person.RoleCode == "PUBLIC_FIGURE" ? "workspace_premium" : person.RoleCode == "DOMAIN_PROFESSIONAL" ? "military_tech" : "verified")</span>
                                                @GetRoleBadgeText(person)
                                            </span>
                                        </div>

                                        <p class="text-xs text-on-surface-variant line-clamp-2 mb-2 leading-relaxed">
                                            @(string.IsNullOrWhiteSpace(person.Headline) ? (!string.IsNullOrWhiteSpace(person.Bio) ? person.Bio : "Network participant and active ecosystem contributor.") : person.Headline)
                                        </p>

                                        <div class="flex items-center gap-3 mb-2 text-on-surface-variant text-xs">
                                            <div class="flex items-center gap-0.5 text-primary">
                                                <span class="material-symbols-outlined text-[13px]">star</span>
                                                <span class="font-bold">@((person.AverageRating.HasValue && person.AverageRating.Value > 0 ? person.AverageRating.Value.ToString("F1") : "5.0"))</span>
                                                @if (person.RatingCount > 0)
                                                {
                                                    <span class="text-outline text-[10px]">(@person.RatingCount)</span>
                                                }
                                            </div>
                                            <div class="flex items-center gap-1 text-outline">
                                                <span class="material-symbols-outlined text-[13px]">timer</span>
                                                <span class="text-[11px]">@(string.IsNullOrWhiteSpace(person.ResponseSlaText) ? "Active" : person.ResponseSlaText)</span>
                                            </div>
                                            <span class="@(person.AvailabilityStatus?.ToLower().Contains("busy") == true ? "text-amber-400" : "text-emerald-400") text-[10px] uppercase font-semibold">
                                                @(string.IsNullOrWhiteSpace(person.AvailabilityStatus) ? "Available" : person.AvailabilityStatus)
                                            </span>
                                        </div>

                                        <!-- Skills Row -->
                                        @if (person.Skills != null && person.Skills.Any())
                                        {
                                            <div class="flex flex-wrap gap-1 mb-2">
                                                @foreach (var skill in person.Skills.Take(3))
                                                {
                                                    <span class="px-1.5 py-0.2 bg-surface-container-lowest text-outline text-[10px] rounded border border-white/5">@skill</span>
                                                }
                                            </div>
                                        }

                                        <!-- Live Metrics Strip -->
                                        <div class="bg-surface-container-lowest/80 rounded-lg p-1.5 flex items-center justify-between text-outline text-[11px] mb-2 border border-white/5">
                                            <div class="text-center flex-1">
                                                <span class="block text-xs text-on-surface font-semibold">@person.PostsCount</span>
                                                <span class="text-[9px] uppercase">Posts</span>
                                            </div>
                                            <div class="w-px h-5 bg-surface-container-high"></div>
                                            <div class="text-center flex-1">
                                                <span class="block text-xs text-on-surface font-semibold">@person.JoinedCommunitiesCount</span>
                                                <span class="text-[9px] uppercase">Groups</span>
                                            </div>
                                            <div class="w-px h-5 bg-surface-container-high"></div>
                                            <div class="text-center flex-1">
                                                <span class="block text-xs text-primary font-semibold">@person.PostsCount</span>
                                                <span class="text-[9px] uppercase">Signals</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex items-center gap-2 pt-1 border-t border-white/5">
                                        <a href="u/@person.UserName" class="flex-1 py-1 bg-primary text-on-primary text-xs font-semibold rounded-md hover:bg-primary-fixed transition-colors flex items-center justify-center gap-1 shadow-xs">
                                            <span>Connect</span>
                                            <span class="text-[10px] opacity-80">(@(person.RoleCode == "PUBLIC_FIGURE" ? "100" : "50") $LNK)</span>
                                        </a>
                                        <button type="button" @onclick="() => ToggleFollowPersonAsync(person.UserId)"
                                                class="px-2.5 py-1 @(person.IsFollowedByCurrentUser ? "bg-primary-container/20 text-primary font-semibold flex items-center gap-1 border border-primary/30" : "bg-surface-container-highest text-on-surface-variant hover:text-on-surface border border-white/5") text-xs rounded-md transition-colors cursor-pointer">
                                            @if (person.IsFollowedByCurrentUser)
                                            {
                                                <span class="material-symbols-outlined text-[13px]">check</span>
                                                <span>Following</span>
                                            }
                                            else
                                            {
                                                <span>Follow</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination Bar -->
                        <div class="w-full bg-surface-container-low rounded-xl p-2.5 flex flex-col sm:flex-row items-center justify-between gap-2.5 border border-white/5">
                            <span class="text-xs text-outline">
                                Showing @(FilteredPeople.Any() ? (peopleCurrentPage - 1) * peoplePageSize + 1 : 0) to @(Math.Min(peopleCurrentPage * peoplePageSize, FilteredPeople.Count)) of @FilteredPeople.Count members
                            </span>
                            <div class="flex items-center gap-1">
                                <button type="button" disabled="@(peopleCurrentPage <= 1)" @onclick="() => peopleCurrentPage--"
                                        class="px-2.5 py-1 rounded-md bg-surface-container text-outline hover:text-on-surface transition-colors text-xs disabled:opacity-40 cursor-pointer">
                                    Previous
                                </button>
                                @for (int p = 1; p <= TotalPeoplePages; p++)
                                {
                                    var pageNum = p;
                                    <button type="button" @onclick="() => peopleCurrentPage = pageNum"
                                            class="w-6 h-6 rounded-md @(peopleCurrentPage == pageNum ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container text-on-surface-variant hover:bg-surface-container-high") text-xs flex items-center justify-center cursor-pointer">
                                        @pageNum
                                    </button>
                                }
                                <button type="button" disabled="@(peopleCurrentPage >= TotalPeoplePages)" @onclick="() => peopleCurrentPage++"
                                        class="px-2.5 py-1 rounded-md bg-surface-container text-on-surface-variant hover:text-on-surface transition-colors text-xs disabled:opacity-40 cursor-pointer">
                                    Next
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Column: Sidebar / Quotas & Leaderboard (4 Cols on xl) -->
                <aside class="xl:col-span-4 flex flex-col gap-3.5 w-full">
                    <!-- Connection Quota & Pass Balance -->
                    <div class="bg-gradient-to-b from-surface-container-high to-surface-container-low rounded-xl p-3.5 sm:p-4 relative overflow-hidden shadow-xs border border-white/5">
                        <div class="absolute top-0 right-0 w-20 h-20 bg-primary/10 rounded-full blur-xl pointer-events-none"></div>
                        <div class="flex items-center justify-between mb-2.5">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-primary text-[17px]">token</span>
                                <h3 class="text-xs sm:text-sm font-bold text-on-surface">Connection Passes</h3>
                            </div>
                            <span class="font-mono text-[9px] uppercase px-1.5 py-0.2 rounded bg-primary-container/20 text-primary font-bold border border-primary/20">Active</span>
                        </div>
                        <p class="text-xs text-on-surface-variant mb-2.5">
                            Monthly direct connect quota resets in <span class="text-on-surface font-semibold">14 days</span>.
                        </p>
                        <!-- Pass Meter Gauge -->
                        <div class="bg-surface-container-lowest p-2.5 rounded-lg mb-2.5 border border-white/5">
                            <div class="flex items-center justify-between text-xs mb-1.5">
                                <span class="text-on-surface-variant">Monthly Passes</span>
                                <span class="text-primary font-bold">3 / 5 Used</span>
                            </div>
                            <div class="w-full h-1.5 rounded-full bg-surface-container overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-primary to-primary-fixed rounded-full w-3/5 transition-all duration-500"></div>
                            </div>
                            <div class="flex justify-between items-center mt-2 pt-1 text-outline text-[11px]">
                                <span>Balance:</span>
                                <span class="text-primary font-bold">@userLinkDropBalance.ToString("N0") Drops</span>
                            </div>
                        </div>
                        <a href="linkdrops" class="w-full py-1.5 bg-primary text-on-primary text-xs font-semibold rounded-md hover:bg-primary-fixed transition-colors shadow-xs flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-[15px]">upgrade</span>
                            <span>Get More Drops</span>
                        </a>
                    </div>

                    <!-- Top Rated Advisory Network Leaderboard -->
                    <div class="bg-surface-container-low rounded-xl p-3.5 sm:p-4 shadow-xs border border-white/5">
                        <div class="flex items-center justify-between mb-2.5">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-secondary text-[17px]">leaderboard</span>
                                <h3 class="text-xs sm:text-sm font-bold text-on-surface">Top Responders</h3>
                            </div>
                            <span class="text-[10px] text-outline uppercase tracking-wider font-mono">This Week</span>
                        </div>
                        <div class="flex flex-col gap-2">
                            @if (TopRespondersPeople.Any())
                            {
                                int rank = 1;
                                foreach (var leader in TopRespondersPeople)
                                {
                                    <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors border border-white/5">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="text-xs @(rank == 1 ? "text-primary font-bold" : rank == 2 ? "text-secondary font-bold" : "text-outline font-bold") w-4">@rank.ToString("D2")</span>
                                            <div class="w-7 h-7 rounded-md bg-surface-container-highest overflow-hidden flex-shrink-0 border border-white/5">
                                                @if (!string.IsNullOrWhiteSpace(leader.AvatarUrl))
                                                {
                                                    <img class="w-full h-full object-cover" src="@leader.AvatarUrl" alt="@leader.DisplayName" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center font-bold text-[10px] text-primary">@GetPersonInitials(leader)</div>
                                                }
                                            </div>
                                            <div class="min-w-0 truncate">
                                                <a href="u/@leader.UserName" class="text-xs text-on-surface hover:text-primary transition-colors truncate block font-medium">
                                                    @(string.IsNullOrWhiteSpace(leader.DisplayName) ? leader.UserName : leader.DisplayName)
                                                </a>
                                                <span class="text-[10px] text-outline truncate block">
                                                    @(leader.Headline ?? $"@{leader.UserName}")@(!string.IsNullOrWhiteSpace(leader.ResponseSlaText) ? $" · {leader.ResponseSlaText}" : "")
                                                </span>
                                            </div>
                                        </div>
                                        <span class="text-xs @(rank == 1 ? "text-primary" : rank == 2 ? "text-secondary" : "text-on-surface-variant") font-bold shrink-0 ml-1.5">@((leader.AverageRating ?? 5.0m).ToString("F1")) ★</span>
                                    </div>
                                    rank++;
                                }
                            }
                            else
                            {
                                <p class="text-xs text-outline">No responders tracked this week.</p>
                            }
                        </div>
                    </div>

                    <!-- Network Discovery Insights & Metrics -->
                    <div class="bg-surface-container-low rounded-xl p-3.5 sm:p-4 shadow-xs border border-white/5">
                        <h3 class="text-xs sm:text-sm text-on-surface mb-1 flex items-center gap-1.5 font-bold">
                            <span class="material-symbols-outlined text-outline text-[17px]">insights</span>
                            <span>Network Telemetry</span>
                        </h3>
                        <p class="text-xs text-outline mb-2.5">
                            Verified consensus across core network peers.
                        </p>
                        <!-- Inline Telemetry SVG Graph -->
                        <div class="w-full h-20 mb-2.5 bg-surface-container-lowest rounded-lg p-2 flex flex-col justify-end border border-white/5">
                            <div class="flex justify-between items-center mb-0.5 text-[9px] text-outline font-mono">
                                <span>Activity Timeline (7d)</span>
                                <span class="text-primary font-bold">Telemetry Live</span>
                            </div>
                            <svg class="w-full h-10 text-primary" fill="none" preserveAspectRatio="none" viewBox="0 0 300 60">
                                <path d="M0 45 Q 40 30, 80 40 T 160 20 T 240 28 T 300 12 L 300 60 L 0 60 Z" fill="currentColor" fill-opacity="0.12"></path>
                                <path d="M0 45 Q 40 30, 80 40 T 160 20 T 240 28 T 300 12" stroke="currentColor" stroke-linecap="round" stroke-width="2.5" vector-effect="non-scaling-stroke"></path>
                            </svg>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div class="bg-surface-container-lowest p-2 rounded-lg border border-white/5">
                                <span class="text-[9px] font-mono text-outline uppercase block">Network Peers</span>
                                <span class="text-xs font-bold text-on-surface">@(dashboard?.People?.Count ?? 0) Active</span>
                            </div>
                            <div class="bg-surface-container-lowest p-2 rounded-lg border border-white/5">
                                <span class="text-[9px] font-mono text-outline uppercase block">SLA Rate</span>
                                <span class="text-xs font-bold text-primary">Active</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        }
        else if (activeFeedTab == "groups")
        {
            <!-- Interactive Top Anchor / Category Flow Matrix -->
            <section class="w-full pt-1 pb-3 flex flex-col gap-2.5">
                <!-- Editorial Title & Manifest Deck -->
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 pt-1">
                    <div class="max-w-2xl">
                        <div class="flex items-center gap-1.5 font-mono text-[10px] text-primary uppercase tracking-wider mb-1">
                            <span class="material-symbols-outlined text-[13px]">shield_person</span>
                            <span>Sub-Communities</span>
                            <span class="text-outline">/</span>
                            <span class="text-on-surface-variant">Working Groups</span>
                        </div>
                        <h1 class="text-base sm:text-lg text-on-surface tracking-tight font-bold">
                            Collaborative Groups &amp; Sub-Communities
                        </h1>
                        <p class="text-xs text-on-surface-variant mt-0.5">
                            Join domain working groups, research circles, and community teams.
                        </p>
                    </div>
                    <!-- Live Search & Filtering Input -->
                    <div class="w-full md:w-80 flex-shrink-0">
                        <div class="relative w-full">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[16px]">search</span>
                            <input @bind="groupSearchQuery" @bind:event="oninput"
                                   class="w-full bg-surface-container-low text-on-surface placeholder:text-outline text-xs pl-8 pr-3 py-2 rounded-lg shadow-xs focus:outline-none focus:bg-surface-container transition-all border border-white/5"
                                   placeholder="Search groups by topic or name..."
                                   type="text" />
                            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-outline bg-surface-container-high px-1.5 py-0.2 rounded border border-white/5">⌘K</span>
                        </div>
                    </div>
                </div>

                <!-- Category Filter Segment Navigation -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 text-nowrap scrollbar-none">
                    <button type="button" @onclick='() => SetGroupFilter("ALL")'
                            class="px-2.5 py-1 rounded-full text-xs @(selectedGroupFilter == "ALL" ? "bg-surface-container-highest text-primary font-semibold shadow-xs" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer">
                        All (@GroupCountAll)
                    </button>
                    <button type="button" @onclick='() => SetGroupFilter("JOINED")'
                            class="px-2.5 py-1 rounded-full text-xs @(selectedGroupFilter == "JOINED" ? "bg-surface-container-highest text-primary font-semibold shadow-xs" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer">
                        Joined (@GroupCountJoined)
                    </button>
                    <button type="button" @onclick='() => SetGroupFilter("TECHNICAL")'
                            class="px-2.5 py-1 rounded-full text-xs @(selectedGroupFilter == "TECHNICAL" ? "bg-surface-container-highest text-primary font-semibold shadow-xs" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer">
                        Technical (@GroupCountTechnical)
                    </button>
                    <button type="button" @onclick='() => SetGroupFilter("SYNDICATE")'
                            class="px-2.5 py-1 rounded-full text-xs @(selectedGroupFilter == "SYNDICATE" ? "bg-surface-container-highest text-primary font-semibold shadow-xs" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer">
                        Syndicates (@GroupCountSyndicate)
                    </button>
                    <button type="button" @onclick='() => SetGroupFilter("GOVERNANCE")'
                            class="px-2.5 py-1 rounded-full text-xs @(selectedGroupFilter == "GOVERNANCE" ? "bg-surface-container-highest text-primary font-semibold shadow-xs" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container") transition-all cursor-pointer">
                        Governance (@GroupCountGovernance)
                    </button>
                </div>
            </section>

            <!-- Premier Guild Spotlight Banner -->
            @if (PremierGroup != null)
            {
                <section class="w-full mb-4">
                    <div class="relative w-full rounded-xl bg-surface-container overflow-hidden shadow-xs border border-white/5">
                        <!-- Ambient Visual Background Plate -->
                        <div class="absolute inset-0 bg-cover bg-center opacity-20 mix-blend-luminosity"
                             style="background-image: url('@(!string.IsNullOrWhiteSpace(PremierGroup.BannerUrl) ? PremierGroup.BannerUrl : "https://lh3.googleusercontent.com/aida-public/AB6AXuA1979gsaE5FEgxWJUp9baVMIdiVMpzUFpZhQMsNS5d-Y33ucKnhLRTkX_gWfqv4U3Jb2wJpq-ITonZchIFVFVTOaIG30blrzlG50BmcJ11KK9WSpffjkMALiQzp884lemH9i5oDfKVOn5yO7MUTdl5mh2my3dqm7ZypI1EoHiyuYqbseImHa2kkOdV1jI5uc6YG0e2HjAkkZfKaLXLOqzFs5p6GZGuFSBz52EZb6O_QBK1mq_rMU4")')"></div>
                        <div class="absolute inset-0 bg-gradient-to-r from-surface-dim via-surface-container/95 to-surface-container-high/85"></div>
                        <div class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-primary via-secondary to-primary-container"></div>
                        <!-- Banner Content Grid -->
                        <div class="relative p-4 sm:p-5 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
                            <div class="flex flex-col gap-2 max-w-2xl">
                                <!-- Spotlight Meta Labels -->
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary-container/20 text-primary font-mono text-[9px] font-bold uppercase tracking-wider border border-primary/20">
                                        <span class="material-symbols-outlined text-[11px]" style="font-variation-settings: 'FILL' 1;">stars</span>
                                        Premier Group
                                    </span>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-surface-container-highest text-on-surface-variant text-[10px] border border-white/5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                        @(string.IsNullOrWhiteSpace(PremierGroup.SubCommunityName) ? "Active Working Group" : PremierGroup.SubCommunityName)
                                    </span>
                                    <span class="inline-flex items-center gap-0.5 text-primary text-xs font-semibold">
                                        <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">grade</span>
                                        @((PremierGroup.AverageRating.HasValue && PremierGroup.AverageRating.Value > 0 ? PremierGroup.AverageRating.Value.ToString("F1") : "5.0")) Rating
                                    </span>
                                </div>
                                <!-- Title & Narrative -->
                                <div>
                                    <h2 class="text-base sm:text-lg text-on-surface font-bold tracking-tight">
                                        <a href="group/@PremierGroup.GroupId" class="hover:text-primary transition-colors">@PremierGroup.Name</a>
                                    </h2>
                                    <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed line-clamp-2">
                                        @(string.IsNullOrWhiteSpace(PremierGroup.Description) ? "Collaborative working group and sovereign research circle." : PremierGroup.Description)
                                    </p>
                                </div>
                                <!-- Guild Metadata Chips & Stewards Preview -->
                                <div class="flex flex-wrap items-center gap-y-2 gap-x-4 pt-1">
                                    <div class="flex items-center gap-1.5 text-xs text-on-surface">
                                        <span class="material-symbols-outlined text-[15px] text-primary">groups</span>
                                        <span class="font-semibold text-on-surface">@PremierGroup.MemberCount</span>
                                        <span class="text-outline">Members</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-on-surface">
                                        <span class="material-symbols-outlined text-[15px] text-secondary">forum</span>
                                        <span class="font-semibold text-on-surface">@PremierGroup.PostCount</span>
                                        <span class="text-outline">Dispatches</span>
                                    </div>
                                    <!-- Lead Stewards Overlap Pile -->
                                    @if (dashboard?.People != null && dashboard.People.Any())
                                    {
                                        <div class="flex items-center gap-1.5 pl-1">
                                            <span class="text-[10px] text-outline uppercase">Leads:</span>
                                            <div class="flex -space-x-1.5">
                                                @foreach (var lead in dashboard.People.Take(3))
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(lead.AvatarUrl))
                                                    {
                                                        <img class="w-5 h-5 rounded-full object-cover ring-1 ring-surface-container" src="@lead.AvatarUrl" alt="@lead.DisplayName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-5 h-5 rounded-full bg-surface-container-highest text-primary font-bold text-[8px] flex items-center justify-center ring-1 ring-surface-container">
                                                            @GetPersonInitials(lead)
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <!-- Banner Action Module -->
                            <div class="flex flex-col sm:flex-row lg:flex-col gap-2 w-full lg:w-48 flex-shrink-0">
                                @if (PremierGroup.IsJoined)
                                {
                                    <a href="group/@PremierGroup.GroupId" class="w-full flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-on-primary text-xs font-semibold hover:bg-primary-fixed transition-all text-center shadow-xs">
                                        <span>Enter Group</span>
                                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                    </a>
                                }
                                else if (PremierGroup.UserJoinStatus == "PENDING")
                                {
                                    <a href="group/@PremierGroup.GroupId" class="w-full flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-highest text-on-surface text-xs font-semibold transition-all text-center">
                                        <span>Pending Approval</span>
                                        <span class="material-symbols-outlined text-[14px]">lock_clock</span>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => JoinGroupFromHomeAsync(PremierGroup.GroupId)" class="w-full flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-on-primary text-xs font-semibold hover:bg-primary-fixed transition-all text-center cursor-pointer shadow-xs">
                                        <span>Join Group</span>
                                        <span class="material-symbols-outlined text-[16px]">add</span>
                                    </button>
                                }
                                <a href="groups" class="w-full flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-bright text-xs font-medium transition-all text-center border border-white/5">
                                    <span class="material-symbols-outlined text-[15px] text-outline">description</span>
                                    <span>All Groups</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <!-- Main Asymmetric Workspace Layout: 8-Column Directory + 4-Column Context Rail -->
            <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
                <!-- Left Column: Guilds Directory Grid (8 Cols) -->
                <div class="lg:col-span-8 flex flex-col gap-3.5">
                    <!-- Section Sub-Header -->
                    <div class="flex items-center justify-between pb-0.5">
                        <div class="flex items-center gap-2">
                            <span class="text-xs sm:text-sm font-bold text-on-surface">Consortium Catalog</span>
                            <span class="px-2 py-0.2 rounded-md bg-surface-container-high text-on-surface-variant text-[10px]">@FilteredGroups.Count Accessible</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-outline text-xs">
                            <span>Sort:</span>
                            <select @bind="groupSortOption" class="bg-surface-container-lowest text-on-surface font-semibold focus:outline-none cursor-pointer rounded px-2 py-0.5 text-xs border border-white/5">
                                <option value="activity">Activity</option>
                                <option value="members">Members</option>
                                <option value="rating">Rating</option>
                            </select>
                        </div>
                    </div>

                    <!-- Guild Cards Collection -->
                    @if (!FilteredGroups.Any())
                    {
                        <div class="rounded-xl bg-surface-container p-8 text-center border border-white/5 space-y-2">
                            <span class="material-symbols-outlined text-3xl text-outline">groups</span>
                            <p class="text-sm font-semibold text-on-surface">No groups match your current filter.</p>
                            <p class="text-xs text-outline">Try searching with different keywords or choosing "All".</p>
                            <button type="button" @onclick='() => { groupSearchQuery = string.Empty; selectedGroupFilter = "ALL"; }' class="px-3 py-1 bg-primary text-on-primary rounded-md text-xs font-semibold hover:bg-primary-fixed transition-colors cursor-pointer">
                                Reset Filters
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            @foreach (var grp in FilteredGroups)
                            {
                                <div class="group relative rounded-xl bg-surface-container hover:bg-surface-container-high transition-all p-3 sm:p-3.5 flex flex-col justify-between gap-3 shadow-xs border border-white/5">
                                    <div class="w-full">
                                        <!-- Top Meta & Membership Pill -->
                                        <div class="flex items-start justify-between gap-2 mb-2">
                                            <div class="w-9 h-9 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary shadow-inner border border-white/5">
                                                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">@GetGroupIcon(grp)</span>
                                            </div>
                                            @if (grp.IsJoined)
                                            {
                                                <div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-secondary/10 text-secondary text-[10px] font-semibold border border-secondary/20">
                                                    <span class="material-symbols-outlined text-[11px]">check_circle</span>
                                                    <span>Joined</span>
                                                </div>
                                            }
                                            else if (grp.UserJoinStatus == "PENDING")
                                            {
                                                <div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-semibold border border-primary/20">
                                                    <span class="material-symbols-outlined text-[11px]">pending</span>
                                                    <span>In Review</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant text-[10px] border border-white/5">
                                                    <span>@(grp.Visibility ?? "Public")</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Content -->
                                        <div class="flex items-center gap-1.5 text-outline text-[10px] uppercase tracking-wide">
                                            <span>@(string.IsNullOrWhiteSpace(grp.SubCommunityName) ? "Domain Group" : grp.SubCommunityName)</span>
                                            <span>•</span>
                                            <span class="text-primary font-semibold">★ @((grp.AverageRating.HasValue && grp.AverageRating.Value > 0 ? grp.AverageRating.Value.ToString("F1") : "5.0"))</span>
                                        </div>
                                        <h3 class="text-xs sm:text-sm font-bold text-on-surface mt-0.5 group-hover:text-primary transition-colors truncate">
                                            <a href="group/@grp.GroupId">@grp.Name</a>
                                        </h3>
                                        <p class="text-xs text-on-surface-variant mt-1 line-clamp-2 leading-relaxed">
                                            @(string.IsNullOrWhiteSpace(grp.Description) ? "Collaborative working group." : grp.Description)
                                        </p>
                                    </div>

                                    <!-- Bottom Metric & Action -->
                                    <div class="pt-2 flex items-center justify-between gap-2 border-t border-white/5">
                                        <div class="flex flex-col">
                                            <span class="text-[9px] text-outline uppercase font-mono">Scale</span>
                                            <span class="text-xs text-on-surface font-semibold">@grp.MemberCount members • @grp.PostCount posts</span>
                                        </div>
                                        @if (grp.IsJoined)
                                        {
                                            <a href="group/@grp.GroupId" class="px-2.5 py-1 rounded-md bg-surface-container-highest hover:bg-primary hover:text-on-primary text-on-surface text-xs font-semibold transition-all flex items-center gap-1">
                                                <span>Enter</span>
                                                <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                            </a>
                                        }
                                        else if (grp.UserJoinStatus == "PENDING")
                                        {
                                            <button class="px-2.5 py-1 rounded-md bg-surface-container-low text-outline text-xs font-semibold cursor-not-allowed flex items-center gap-1" disabled>
                                                <span class="material-symbols-outlined text-[13px]">lock_clock</span>
                                                <span>Pending</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => JoinGroupFromHomeAsync(grp.GroupId)" class="px-2.5 py-1 rounded-md bg-surface-container-highest hover:bg-primary hover:text-on-primary text-on-surface text-xs font-semibold transition-all flex items-center gap-1 cursor-pointer">
                                                <span>Join</span>
                                                <span class="material-symbols-outlined text-[13px]">add</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Historical Quorum Archive Link Banner -->
                    <div class="w-full p-3 rounded-xl bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 border border-white/5">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-outline text-[20px]">archive</span>
                            <div>
                                <div class="text-xs font-semibold text-on-surface">Looking for concluded working groups?</div>
                                <div class="text-[11px] text-outline">Access ballots, RFC transcripts, and ratified standards.</div>
                            </div>
                        </div>
                        <a href="groups" class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high text-xs font-semibold transition-all flex-shrink-0 border border-white/5">
                            View Archive
                        </a>
                    </div>
                </div>

                <!-- Right Column: Context Ecosystem Rail & Treasury Metrics (4 Cols) -->
                <div class="lg:col-span-4 flex flex-col gap-3.5">
                    <!-- My Guild Activity Monitor Card -->
                    <div class="rounded-xl bg-surface-container p-3 sm:p-3.5 flex flex-col gap-2 shadow-xs border border-white/5">
                        <div class="flex items-center justify-between pb-1.5 border-b border-white/5">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-primary text-[17px]">badge</span>
                                <span class="text-xs sm:text-sm font-bold text-on-surface">My Standing</span>
                            </div>
                            <span class="px-1.5 py-0.2 rounded-full bg-secondary-container/30 text-secondary-fixed-dim text-[10px] font-bold border border-secondary/20">
                                Active
                            </span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 pt-0.5">
                            <div class="p-2 rounded-lg bg-surface-container-lowest flex flex-col border border-white/5">
                                <span class="text-sm font-bold text-primary">@(dashboard?.Groups?.Count(g => g.IsJoined) ?? 0)</span>
                                <span class="text-[9px] text-outline uppercase font-mono">Memberships</span>
                            </div>
                            <div class="p-2 rounded-lg bg-surface-container-lowest flex flex-col border border-white/5">
                                <span class="text-sm font-bold text-on-surface">@(dashboard?.Groups?.Count(g => g.UserJoinStatus == "PENDING") ?? 0)</span>
                                <span class="text-[9px] text-outline uppercase font-mono">Applications</span>
                            </div>
                        </div>
                    </div>

                    <!-- Guild Treasury & Grants Pool (High Contrast Rich Data Plate) -->
                    <div class="rounded-xl bg-surface-container p-3 sm:p-3.5 flex flex-col gap-2 shadow-xs relative overflow-hidden border border-white/5">
                        <div class="flex items-center justify-between pb-0.5">
                            <span class="font-mono text-[9px] text-primary uppercase tracking-wider font-bold">Grant Treasury</span>
                            <span class="text-[10px] text-outline">Q2</span>
                        </div>
                        <div>
                            <div class="text-base sm:text-lg text-on-surface font-bold tracking-tight">@(((dashboard?.Groups?.Count ?? 0) * 15000 + userLinkDropBalance).ToString("N0")) $LNK</div>
                            <p class="text-[11px] text-outline mt-0.5">Allocated for group research grants and tooling bounties.</p>
                        </div>
                        <!-- Dynamic Treasury Distribution Bar Chart -->
                        @{
                            int totalGrps = GroupCountAll > 0 ? GroupCountAll : 1;
                            int techPct = Math.Clamp((int)Math.Round((double)GroupCountTechnical / totalGrps * 100), 10, 80);
                            int synPct = Math.Clamp((int)Math.Round((double)GroupCountSyndicate / totalGrps * 100), 10, 80 - techPct);
                            int govPct = Math.Max(5, 100 - techPct - synPct);
                        }
                        <div class="w-full flex flex-col gap-1 py-1">
                            <div class="w-full h-1.5 rounded-full bg-surface-container-lowest overflow-hidden flex border border-white/5">
                                <div class="h-full bg-primary" style="width: @(techPct)%;"></div>
                                <div class="h-full bg-secondary" style="width: @(synPct)%;"></div>
                                <div class="h-full bg-tertiary" style="width: @(govPct)%;"></div>
                            </div>
                            <div class="flex items-center justify-between text-[10px] text-outline">
                                <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>Tech (@techPct%)</span>
                                <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>Syndicates (@synPct%)</span>
                                <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>Gov (@govPct%)</span>
                            </div>
                        </div>
                        <a href="linkdrops" class="w-full mt-0.5 flex items-center justify-center gap-1.5 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-bright text-on-surface text-xs font-semibold transition-all border border-white/5">
                            <span class="material-symbols-outlined text-[15px] text-primary">request_quote</span>
                            <span>Grant Proposals</span>
                        </a>
                    </div>

                    <!-- Upcoming Guild Quorum Meetings Widget -->
                    <div class="rounded-xl bg-surface-container p-3 sm:p-3.5 flex flex-col gap-2.5 shadow-xs border border-white/5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-secondary text-[17px]">calendar_today</span>
                                <span class="text-xs sm:text-sm text-on-surface font-bold">Upcoming Quorums</span>
                            </div>
                            <span class="text-[10px] text-outline font-mono">UTC</span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            @if (dashboard?.Groups != null && dashboard.Groups.Any())
                            {
                                int qIdx = 0;
                                foreach (var qGroup in dashboard.Groups.Take(3))
                                {
                                    var dayLabel = qIdx == 0 ? "TOM" : qIdx == 1 ? "FRI" : "MON";
                                    var dayNum = (DateTime.UtcNow.Day + qIdx + 1).ToString();
                                    var timeHour = 14 + qIdx * 2;
                                    <div class="p-2 rounded-lg bg-surface-container-low flex items-start gap-2 hover:bg-surface-container-high transition-colors border border-white/5">
                                        <div class="flex flex-col items-center justify-center w-8 h-8 rounded-lg bg-surface-container-highest text-primary font-bold border border-white/5 shrink-0">
                                            <span class="text-[9px] leading-tight uppercase font-mono">@dayLabel</span>
                                            <span class="text-xs leading-tight">@dayNum</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <a href="group/@qGroup.GroupId" class="text-xs text-on-surface font-semibold truncate hover:text-primary transition-colors block">
                                                @qGroup.Name
                                            </a>
                                            <div class="text-[10px] text-outline flex items-center gap-1 mt-0.5">
                                                <span class="material-symbols-outlined text-[12px]">schedule</span>
                                                <span>@(timeHour):00 UTC • @qGroup.MemberCount Members</span>
                                            </div>
                                        </div>
                                        <a href="group/@qGroup.GroupId" aria-label="View group" class="text-outline hover:text-primary transition-colors p-0.5">
                                            <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                                        </a>
                                    </div>
                                    qIdx++;
                                }
                            }
                            else
                            {
                                <p class="text-xs text-outline p-2 text-center">No upcoming quorums scheduled.</p>
                            }
                        </div>
                    </div>

                    <!-- Guild Governance Charter Notice -->
                    <div class="p-3 rounded-lg bg-surface-container-lowest text-on-surface-variant flex flex-col gap-1.5 border border-white/5">
                        <div class="flex items-center gap-1.5 font-mono text-[10px] text-primary font-bold uppercase tracking-wider">
                            <span class="material-symbols-outlined text-[14px]">verified</span>
                            <span>Community Charter</span>
                        </div>
                        <p class="text-[11px] leading-relaxed text-outline">
                            All group dispatches conform to the CommunityLink Charter and member guidelines.
                        </p>
                        <a class="text-[11px] text-primary hover:underline flex items-center gap-1 font-semibold" href="groups">
                            <span>Read Community Guidelines</span>
                            <span class="material-symbols-outlined text-[12px]">open_in_new</span>
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
}
</div>

<!-- Floating Scroll to Top Button -->
<button type="button" @onclick="ScrollToTopAsync"
        id="btn-scroll-to-top"
        class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 flex items-center justify-center cursor-pointer border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.25)] opacity-0 pointer-events-none"
        title="Scroll to top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
</button>

<!-- Share Post Modal -->
@if (showHomeShareModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white dark:bg-[#112A46] rounded-xl max-w-md w-full p-6 shadow-2xl border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.15)] space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="exec-display font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-base flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#1B3B5A] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                    <span>Share Post</span>
                </h3>
                <button type="button" @onclick="CloseHomeShareModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white text-lg font-bold">&times;</button>
            </div>

            <div class="space-y-1.5">
                <label class="exec-mono text-xs text-[#557392] dark:text-[#C4D2E1]">ADD A NOTE (OPTIONAL)</label>
                <textarea @bind="homeShareNoteText" rows="3" class="exec-input w-full resize-none leading-relaxed text-xs" placeholder="What are your thoughts on this post?"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button type="button" @onclick="CloseHomeShareModal" class="exec-btn-secondary text-xs">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitHomeSharePostAsync" disabled="@isSharingPost" class="exec-btn-primary text-xs">
                    @if (isSharingPost)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Sharing...</span>
                    }
                    else
                    {
                        <span>Share Now</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Post Description Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white dark:bg-[#112A46] rounded-xl max-w-lg w-full p-6 shadow-2xl border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.15)] space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="exec-display font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-base flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#1B3B5A] dark:text-[#C4D2E1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    <span>Edit Post Description</span>
                </h3>
                <button type="button" @onclick="CloseEditModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white text-lg font-bold">&times;</button>
            </div>

            <div class="space-y-1.5">
                <label class="exec-mono text-xs text-[#557392] dark:text-[#C4D2E1]">POST CONTENT</label>
                <textarea @bind="editingPostContent" rows="5" class="exec-input w-full resize-none leading-relaxed" placeholder="Update your post description..."></textarea>
                <p class="text-[11px] text-[#7A8CA6]">Note: Post image attachments cannot be modified.</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button type="button" @onclick="CloseEditModal" class="exec-btn-secondary text-xs">
                    Cancel
                </button>
                <button type="button" @onclick="SaveEditPostAsync" disabled="@(isSavingEdit || string.IsNullOrWhiteSpace(editingPostContent))" class="exec-btn-primary text-xs">
                    @if (isSavingEdit)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Recycle Post Confirmation Modal -->
@if (showRecycleModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white dark:bg-[#112A46] rounded-xl max-w-md w-full p-6 shadow-2xl border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.15)] space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800/40 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </div>
                <div>
                    <h3 class="exec-display font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-base">Move Post to Recycle Bin?</h3>
                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-0.5">You can restore this post anytime within 10 days from your profile.</p>
                </div>
            </div>

            <p class="text-xs text-[#557392] dark:text-[#C4D2E1] bg-[#F2F6FB] dark:bg-[#0A1B2E] p-3 rounded-lg border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.15)] leading-relaxed">
                This post will be hidden from the feed and community stream immediately. Posts kept in the Recycle Bin for more than 10 days will be permanently erased.
            </p>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="CloseRecycleModal" class="exec-btn-secondary text-xs" disabled="@isRecyclingPost">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmRecyclePostAsync" class="exec-btn-primary !bg-amber-600 hover:!bg-amber-700 !border-amber-600 text-xs" disabled="@isRecyclingPost">
                    @if (isRecyclingPost)
                    {
                        <span class="inline-block w-3 h-3 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Moving...</span>
                    }
                    else
                    {
                        <span>Move to Recycle Bin</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: CREATE STANDALONE POST ================= -->
@if (showCreatePostModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-xl shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0] animate-in fade-in duration-200">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">✍️</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">Create Public Broadcast</h3>
                </div>
                <button type="button" @onclick="CloseCreatePostModal" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white font-bold text-sm cursor-pointer">&times;</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">What's on your mind? *</label>
                    <textarea @bind="newPostContent" rows="4" placeholder="Share thoughts, discussions, updates, or code with everyone..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-xl p-3 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>

                <!-- Text Files Attachment Section -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Attach Text Files (.txt) (Multiple allowed)</label>
                        @if (composerTextFiles.Count > 0)
                        {
                            <button type="button" @onclick="ClearComposerTextFiles" class="text-xs text-rose-500 hover:underline">Clear all files</button>
                        }
                    </div>

                    <label class="cursor-pointer border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded-xl p-3 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center gap-2">
                        <span class="text-base">📄</span>
                        <span class="text-xs font-medium text-[#1B3B5A] dark:text-[#E1E8F0]">@(isReadingTextFile ? "Scanning text file(s)..." : "Attach .txt files (Choose multiple)")</span>
                        <InputFile OnChange="HandleComposerMultipleTextFilesSelected" accept=".txt" multiple class="hidden" disabled="@isReadingTextFile" />
                    </label>

                    @if (composerTextFiles.Count > 0)
                    {
                        <div class="space-y-2 mt-2.5">
                            @for (int i = 0; i < composerTextFiles.Count; i++)
                            {
                                var fileIdx = i;
                                var tf = composerTextFiles[fileIdx];
                                <div class="flex items-center justify-between p-2.5 rounded-xl border border-gray-800 bg-[#0d1117] text-gray-200 text-xs">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="text-emerald-400 font-bold font-mono text-sm">📄</span>
                                        <div class="truncate">
                                            <p class="font-mono text-xs font-bold text-emerald-400 truncate">@tf.FileName</p>
                                            <p class="font-mono text-[10px] text-gray-500">@(tf.Content.Length) chars</p>
                                        </div>
                                    </div>
                                    <button type="button" @onclick="() => RemoveComposerTextFile(fileIdx)" class="text-rose-400 hover:text-rose-300 text-xs font-bold px-2 py-1 cursor-pointer">
                                        &times; Remove
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Multiple Images Attachment Section -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Attach Images (Multiple allowed)</label>
                        <span class="text-[10px] text-[#7A8CA6]">PNG, JPG, WebP</span>
                    </div>

                    <label class="cursor-pointer border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded-xl p-3 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center gap-2">
                        <span class="text-base">🖼️</span>
                        <span class="text-xs font-medium text-[#1B3B5A] dark:text-[#E1E8F0]">@(isUploadingImage ? "Uploading image(s)..." : "Upload images (Choose multiple)")</span>
                        <InputFile OnChange="HandleMultipleImagesSelected" accept="image/*" multiple class="hidden" disabled="@isUploadingImage" />
                    </label>

                    @if (uploadedImageUrls.Count > 0)
                    {
                        <div class="grid grid-cols-3 gap-2 mt-2.5">
                            @for (int i = 0; i < uploadedImageUrls.Count; i++)
                            {
                                var imgIndex = i;
                                var imgUrl = uploadedImageUrls[imgIndex];
                                <div class="relative rounded-lg overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] bg-slate-900 group aspect-video">
                                    <img src="@imgUrl" alt="Thumbnail" class="w-full h-full object-cover" />
                                    <button type="button" @onclick="() => RemoveUploadedImage(imgIndex)"
                                            class="absolute top-1 right-1 bg-rose-600 hover:bg-rose-700 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold shadow cursor-pointer transition">
                                        &times;
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="px-5 py-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2.5">
                <button type="button" @onclick="CloseCreatePostModal" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg transition cursor-pointer">Cancel</button>
                <button type="button" @onclick="PublishPostAsync" disabled="@(isPublishingPost || isUploadingImage || isReadingTextFile || (string.IsNullOrWhiteSpace(newPostContent) && composerTextFiles.Count == 0 && uploadedImageUrls.Count == 0))"
                        class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-lg shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isPublishingPost)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span>Publish Post</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: CREATE STANDALONE POLL ================= -->
@if (showCreatePollModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-xl shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0] animate-in fade-in duration-200">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">📊</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">Create Public Poll</h3>
                </div>
                <button type="button" @onclick="CloseCreatePollModal" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white font-bold text-sm cursor-pointer">&times;</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Question *</label>
                    <input type="text" @bind="newPollQuestion" placeholder="e.g. Which ecosystem initiative should we fund first?"
                           class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-lg px-3 py-2.5 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Details / Context (Optional)</label>
                    <textarea @bind="newPollDescription" rows="2" placeholder="Add extra context or instructions for participants..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-lg p-2.5 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>

                <!-- Duration Picker -->
                <div class="p-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] space-y-2">
                    <span class="block text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Poll Duration</span>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Days</label>
                            <input type="number" min="0" max="365" @bind="pollDurationDays"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Hours</label>
                            <input type="number" min="0" max="23" @bind="pollDurationHours"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Minutes</label>
                            <input type="number" min="0" max="59" @bind="pollDurationMinutes"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- Dynamic Poll Options -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Poll Options * (Min 2, Max 10)</label>
                        @if (pollOptionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddHomePollOption" class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline cursor-pointer">
                                + Add Option
                            </button>
                        }
                    </div>

                    <div class="space-y-2">
                        @for (int i = 0; i < pollOptionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold text-xs flex items-center justify-center shrink-0 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       value="@pollOptionsList[index]"
                                       @onchange="(e) => pollOptionsList[index] = e.Value?.ToString() ?? string.Empty"
                                       placeholder="@($"Option {labelChar}")"
                                       class="flex-1 text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-lg px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                @if (pollOptionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemoveHomePollOption(index)"
                                            class="w-7 h-7 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center text-xs font-bold transition cursor-pointer" title="Remove Option">
                                        &times;
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Multi-Choice Toggle -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="pollMultiChoice" @bind="pollIsMultipleChoice" class="rounded border-[#CBD5E1] text-[#0A1B2E] focus:ring-0 cursor-pointer" />
                    <label for="pollMultiChoice" class="text-xs text-[#557392] dark:text-[#C4D2E1] cursor-pointer">Allow voters to select multiple options</label>
                </div>
            </div>
            <div class="px-5 py-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2.5">
                <button type="button" @onclick="CloseCreatePollModal" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg transition cursor-pointer">Cancel</button>
                <button type="button" @onclick="SubmitStandalonePollAsync" disabled="@(isSubmittingPoll || string.IsNullOrWhiteSpace(newPollQuestion))"
                        class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-lg shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmittingPoll)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: FULL TEXT FILE READER ================= -->
@if (showTextFileModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/75 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.18)] w-full max-w-2xl max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-xl">📄</span>
                    <div class="min-w-0">
                        <h3 class="font-mono text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] truncate">@textFileModalTitle</h3>
                        <p class="font-mono text-[11px] text-[#7A8CA6]">Plain Text Document • @(textFileModalContent?.Length ?? 0) characters</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseTextFileModal" class="p-2 text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] text-sm font-bold cursor-pointer transition">
                    ✕
                </button>
            </div>

            <!-- Modal Content with larger, readable font and comfortable padding -->
            <div class="p-6 overflow-y-auto flex-1 bg-slate-950 text-slate-100">
                <pre class="font-mono text-xs sm:text-sm leading-relaxed whitespace-pre-wrap select-text break-words"><code>@textFileModalContent</code></pre>
            </div>

            <!-- Modal Footer -->
