    private async Task ToggleHomeCommentBox(int postId)
    {
        if (openHomeCommentPostIds.Contains(postId))
        {
            openHomeCommentPostIds.Remove(postId);
            return;
        }

        openHomeCommentPostIds.Add(postId);
        if (!homeCommentInputs.ContainsKey(postId))
        {
            homeCommentInputs[postId] = string.Empty;
        }

        if (!homeCommentsByPost.ContainsKey(postId))
        {
            try
            {
                var res = await PostApi.GetCommentsAsync(postId, _cts.Token);
                if (res.IsSuccess && res.Data != null)
                {
                    homeCommentsByPost[postId] = res.Data;
                }
            }
            catch { }
        }
    }

    private async Task SubmitHomeCommentAsync(int postId)
    {
        if (!homeCommentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
