                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Details / Context (Optional)</label>
                    <textarea @bind="newPollDescription" rows="2" placeholder="Add extra context or instructions for participants..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-lg p-2.5 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>

                <!-- Duration Picker -->
                <div class="p-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] space-y-2">
                    <span class="block text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Poll Duration</span>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Days</label>
                            <input type="number" min="0" max="365" @bind="pollDurationDays"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Hours</label>
                            <input type="number" min="0" max="23" @bind="pollDurationHours"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Minutes</label>
                            <input type="number" min="0" max="59" @bind="pollDurationMinutes"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- Dynamic Poll Options -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Poll Options * (Min 2, Max 10)</label>
                        @if (pollOptionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddHomePollOption" class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline cursor-pointer">
                                + Add Option
                            </button>
                        }
                    </div>

                    <div class="space-y-2">
                        @for (int i = 0; i < pollOptionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold text-xs flex items-center justify-center shrink-0 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       value="@pollOptionsList[index]"
                                       @onchange="(e) => pollOptionsList[index] = e.Value?.ToString() ?? string.Empty"
                                       placeholder="@($"Option {labelChar}")"
                                       class="flex-1 text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-lg px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                @if (pollOptionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemoveHomePollOption(index)"
                                            class="w-7 h-7 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center justify-center text-xs font-bold transition cursor-pointer" title="Remove Option">
                                        &times;
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Multi-Choice Toggle -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="pollMultiChoice" @bind="pollIsMultipleChoice" class="rounded border-[#CBD5E1] text-[#0A1B2E] focus:ring-0 cursor-pointer" />
                    <label for="pollMultiChoice" class="text-xs text-[#557392] dark:text-[#C4D2E1] cursor-pointer">Allow voters to select multiple options</label>
                </div>
            </div>
            <div class="px-5 py-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2.5">
                <button type="button" @onclick="CloseCreatePollModal" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg transition cursor-pointer">Cancel</button>
                <button type="button" @onclick="SubmitStandalonePollAsync" disabled="@(isSubmittingPoll || string.IsNullOrWhiteSpace(newPollQuestion))"
                        class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-lg shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmittingPoll)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isCheckingAuth = true;
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? dashboard;

    // Permissions & User
    private bool canPostStandalone = false;
    private bool currentUserIsAdmin = false;
    private int? currentUserId = null;
    private HashSet<int> savedPostIds = new();

    private bool IsPostSaved(PostModel post) =>
        post.IsSavedByCurrentUser || savedPostIds.Contains(post.PostId);

    private bool IsPollSaved(PollModel poll) =>
        savedPostIds.Contains(poll.PostId);

    private Task ToggleSavePoll(PollModel poll) =>
        ToggleSavePost(poll.PostId);

    // Top Feed Tabs: "posts" | "people"
    private string activeFeedTab = "posts";

    private int FeedPostCount => dashboard?.RecentPosts?.Count ?? 0;
    private int FeedPeopleCount => dashboard?.People?.Count ?? 0;

    private void SetFeedTab(string tab)
    {
        activeFeedTab = tab == "people" ? "people" : "posts";
    }

    // People Tab State & Filtering
    private string _peopleSearchQuery = string.Empty;
    private string peopleSearchQuery
    {
        get => _peopleSearchQuery;
        set
        {
            if (_peopleSearchQuery != value)
            {
                _peopleSearchQuery = value;
                peopleVisibleCount = 12;
            }
        }
    }

    private string _peopleSortOption = "all";
    private string peopleSortOption
    {
        get => _peopleSortOption;
        set
        {
            if (_peopleSortOption != value)
            {
                _peopleSortOption = value;
                peopleVisibleCount = 12;
            }
        }
    }

    private string selectedPeopleRoleFilter = "ALL";
    private int peopleVisibleCount = 12;
    private long userLinkDropBalance = 1450;

    private int PeopleCountAll => dashboard?.People?.Count ?? 0;
    private int PeopleCountPublicFigure => dashboard?.People?.Count(p => p.RoleCode == "PUBLIC_FIGURE") ?? 0;
    private int PeopleCountDomainPro => dashboard?.People?.Count(p => p.RoleCode == "DOMAIN_PROFESSIONAL") ?? 0;

    private void SetPeopleRoleFilter(string filter)
    {
        selectedPeopleRoleFilter = filter;
        peopleVisibleCount = 12;
    }

    private void LoadMorePeople()
    {
        peopleVisibleCount += 12;
    }

    private IReadOnlyList<DirectoryPersonModel> FilteredPeople
    {
        get
        {
            if (dashboard?.People == null) return Array.Empty<DirectoryPersonModel>();

            var list = dashboard.People.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(peopleSearchQuery))
            {
                var q = peopleSearchQuery.Trim();
                list = list.Where(p =>
                    (!string.IsNullOrWhiteSpace(p.DisplayName) && p.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(p.UserName) && p.UserName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(p.Headline) && p.Headline.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(p.Bio) && p.Bio.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Skills != null && p.Skills.Any(s => s.Contains(q, StringComparison.OrdinalIgnoreCase)))
                );
            }

            if (selectedPeopleRoleFilter == "PUBLIC_FIGURE")
            {
                list = list.Where(p => p.RoleCode == "PUBLIC_FIGURE");
            }
            else if (selectedPeopleRoleFilter == "DOMAIN_PROFESSIONAL")
            {
                list = list.Where(p => p.RoleCode == "DOMAIN_PROFESSIONAL");
            }

            if (peopleSortOption == "followed")
            {
                list = list.Where(p => p.IsFollowedByCurrentUser);
            }
            else if (peopleSortOption == "active")
            {
                list = list.Where(p => p.AvailabilityStatus == null || !p.AvailabilityStatus.Contains("busy", StringComparison.OrdinalIgnoreCase))
                           .OrderByDescending(p => p.PostsCount)
                           .ThenByDescending(p => p.AverageRating ?? 0);
            }
            else
            {
                list = list.OrderByDescending(p => p.AverageRating ?? 0).ThenByDescending(p => p.RatingCount);
            }

            return list.ToList();
        }
    }

    private IEnumerable<DirectoryPersonModel> VisiblePeople =>
        FilteredPeople.Take(peopleVisibleCount);



    // Quick Composer & Modals
    private bool showCreatePostModal = false;
    private bool showCreatePollModal = false;
    private string newPostContent = string.Empty;
    private int selectedCommunityId = 0;
    private bool isPublishingPost;
    private readonly List<string> uploadedImageUrls = new();
    private bool isUploadingImage;
    private string? composerCodeSnippet;
    private string? composerCodeFileName;
    private bool isReadingTextFile = false;

    // Create Poll State
    private string newPollQuestion = string.Empty;
    private string newPollDescription = string.Empty;
    private int pollDurationDays = 1;
    private int pollDurationHours = 0;
    private int pollDurationMinutes = 0;
    private bool pollIsMultipleChoice = false;
    private List<string> pollOptionsList = new() { string.Empty, string.Empty };
    private bool isSubmittingPoll = false;

    // Inline Comments & Shares
    private readonly HashSet<int> openHomeCommentPostIds = new();
    private readonly Dictionary<int, string> homeCommentInputs = new();
    private readonly Dictionary<int, IReadOnlyList<CommentModel>> homeCommentsByPost = new();
    private readonly Dictionary<int, int> postActiveImageIndex = new();

    private int GetActiveImageIndex(int postId) => postActiveImageIndex.TryGetValue(postId, out var idx) ? idx : 0;
    private void PrevImage(int postId, int count)
    {
        var current = GetActiveImageIndex(postId);
        postActiveImageIndex[postId] = (current - 1 + count) % count;
    }
    private void NextImage(int postId, int count)
    {
        var current = GetActiveImageIndex(postId);
        postActiveImageIndex[postId] = (current + 1) % count;
    }
    private void SetActiveImage(int postId, int index)
    {
        postActiveImageIndex[postId] = index;
    }

