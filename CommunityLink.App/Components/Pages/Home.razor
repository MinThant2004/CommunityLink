@page "/"
@page "/home"
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserDashboardApiService DashboardApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Ecosystem Home — CommunityLink</PageTitle>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap');

    .exec-home {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0A1B2E;
        background-color: #F2F6FB;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .exec-display {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: -0.025em;
    }

    .exec-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .exec-card {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .exec-card:hover {
        border-color: #C4D2E1;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.07), 0 2px 6px -1px rgba(10, 27, 46, 0.03);
    }

    .exec-card-static {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
    }

    .exec-btn-primary {
        background-color: #0A1B2E;
        color: #ffffff !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.01em;
        border: 1px solid #0A1B2E;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-primary:hover:not(:disabled) {
        background-color: #112A46;
        border-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(10, 27, 46, 0.18);
    }

    .exec-btn-primary:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .exec-btn-secondary {
        background-color: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #112A46 !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-secondary:hover {
        background-color: #D9EAFF;
        border-color: #A1B2C4;
        color: #0A1B2E !important;
    }

    .exec-btn-ghost {
        background-color: transparent;
        color: #34506D !important;
        border: 1px solid transparent;
        border-radius: 0.25rem;
        padding: 0.4rem 0.75rem;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.15s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-ghost:hover {
        background-color: #F2F6FB;
        color: #0A1B2E !important;
    }

    .exec-badge-standard {
        background: #F2F6FB;
        border: 1px solid #E1E8F0;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-active {
        background: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-label-md {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #7A8CA6;
    }

    .exec-input {
        background: #ffffff;
        border: 1px solid #C4D2E1;
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        font-size: 13px;
        color: #0A1B2E;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .exec-input::placeholder {
        color: #A1B2C4;
    }

    .exec-input:focus {
        border-color: #1B3B5A;
        box-shadow: 0 0 0 3px rgba(27, 59, 90, 0.12);
    }

    .exec-badge-blue {
        background: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-live {
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #047857;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-card-tinted {
        background: #EDF4FF;
        border-color: #C4D2E1;
    }

    /* Nocturne Executive Dark Mode Rules */
    .dark .exec-home {
        color: #E1E8F0;
        background-color: #0A1B2E;
    }

    .dark .exec-card {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card:hover {
        border-color: rgba(196, 210, 225, 0.28);
        box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.45);
    }

    .dark .exec-card-static {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card-tinted {
        background: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.20);
    }

    .dark .exec-btn-primary {
        background-color: #E1E8F0;
        color: #0A1B2E !important;
        border: 1px solid #E1E8F0;
    }

    .dark .exec-btn-primary:hover:not(:disabled) {
        background-color: #FFFFFF;
        border-color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(225, 232, 240, 0.20);
    }

    .dark .exec-btn-secondary {
        background-color: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0 !important;
    }

    .dark .exec-btn-secondary:hover {
        background-color: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.35);
        color: #FFFFFF !important;
    }

    .dark .exec-btn-ghost {
        color: #C4D2E1 !important;
    }

    .dark .exec-btn-ghost:hover {
        background-color: #1B3B5A;
        color: #FFFFFF !important;
    }

    .dark .exec-badge-standard {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.15);
        color: #C4D2E1;
    }

    .dark .exec-badge-active {
        background: #E1E8F0;
        border: 1px solid #E1E8F0;
        color: #0A1B2E;
    }

    .dark .exec-badge-blue {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-badge-live {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.30);
        color: #34D399;
    }

    .dark .exec-label-md {
        color: #7A8CA6;
    }

    .dark .exec-input {
        background: #0A1B2E;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-input::placeholder {
        color: #7A8CA6;
    }

    .dark .exec-input:focus {
        border-color: rgba(196, 210, 225, 0.35);
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.05);
    }

    /* Scoped Dark Utility Maps for Home Component */
    .dark .exec-home .text-\[\#0A1B2E\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#557392\] { color: #C4D2E1; }
    .dark .exec-home .text-\[\#112A46\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#34506D\] { color: #C4D2E1; }
    .dark .exec-home .border-\[\#E1E8F0\] { border-color: rgba(196, 210, 225, 0.12); }
    .dark .exec-home .border-\[\#F2F6FB\] { border-color: rgba(196, 210, 225, 0.08); }
    .dark .exec-home .border-\[\#C4D2E1\] { border-color: rgba(196, 210, 225, 0.20); }
    .dark .exec-home .bg-\[\#E3EFFF\] { background-color: #1B3B5A; }
    .dark .exec-home .bg-\[\#F2F6FB\] { background-color: #0A1B2E; }
    .dark .exec-home .bg-\[\#0A1B2E\]:not(button):not(.exec-badge-active) { background-color: #1B3B5A; color: #E1E8F0; }
</style>

<div class="-m-6 p-6 md:p-8 min-h-[calc(100vh-4rem)] exec-home bg-[#F2F6FB] dark:bg-[#0A1B2E]">
@if (isCheckingAuth || (isLoading && dashboard == null))
{
    <div class="exec-card-static p-16 text-center my-8 max-w-xl mx-auto">
        <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] border-t-transparent"></div>
        <h3 class="exec-display mt-5 text-base font-bold text-[#0A1B2E]">Synchronizing Executive Workspace</h3>
        <p class="mt-1 text-xs text-[#557392]">Loading ecosystem feeds, real-time channels, and analytical metrics...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="p-6 bg-[#ffdad6]/40 border border-[#ba1a1a]/30 rounded-lg text-[#93000a] flex flex-col md:flex-row items-center justify-between gap-4 max-w-4xl mx-auto my-6 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-[0.375rem] bg-[#93000a]/10 text-[#93000a] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
            <div>
                <h3 class="exec-display font-bold text-sm text-[#93000a]">Unable to synchronize workspace</h3>
                <p class="text-xs text-[#ba1a1a] mt-0.5">@errorMessage</p>
            </div>
        </div>
        <button @onclick="LoadDashboardAsync" class="exec-btn-primary text-xs">
            Retry Sync
        </button>
    </div>
}
else if (dashboard != null)
{
    <div class="space-y-6 max-w-[1440px] mx-auto pb-16">

        <!-- Top Relational Breadcrumb & Status Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#E1E8F0]">
            <div class="flex flex-wrap items-center gap-2">
                <span class="exec-badge-blue">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34506D]"></span>
                    COMMUNITY LINK
                </span>
                <span class="text-[#A1B2C4] font-semibold text-xs">&rsaquo;</span>
                <span class="exec-badge-standard">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#34506D]"></span>
                    ACTIVE ECOSYSTEM
                </span>
                <span class="text-[#A1B2C4] font-semibold text-xs">&rsaquo;</span>
                <span class="exec-badge-active">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    MEMBER WORKSPACE
                </span>
            </div>

            <div class="flex items-center gap-3">
                <span class="hidden md:inline-flex items-center gap-2 px-3 py-1 rounded-[0.25rem] bg-[#ECFDF5] text-[#047857] text-xs font-medium border border-[#A7F3D0] shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="exec-mono text-[11px] uppercase tracking-wider">Live SignalR Synced</span>
                </span>
                <button @onclick="ScrollToComposer" class="exec-btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>New Broadcast</span>
                </button>
            </div>
        </div>

        <!-- Executive Welcome Briefing Section -->
        <div class="exec-card exec-card-tinted p-6 md:p-8">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="relative shrink-0">
                        @if (!string.IsNullOrWhiteSpace(dashboard.Profile?.AvatarUrl))
                        {
                            <img src="@dashboard.Profile.AvatarUrl" alt="@dashboard.Profile.DisplayName" class="w-18 h-18 sm:w-20 sm:h-20 rounded-full object-cover ring-2 ring-[#C4D2E1] shadow-sm" />
                        }
                        else
                        {
                            <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#0A1B2E] text-[#ffffff] font-bold text-2xl sm:text-3xl flex items-center justify-center ring-2 ring-[#C4D2E1] shadow-sm">
                                @(dashboard.Profile?.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                        }
                        <div class="absolute bottom-0 right-0 bg-emerald-500 w-4 h-4 rounded-full ring-2 ring-white" title="Active Online"></div>
                    </div>

                    <div class="space-y-1.5">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="exec-label-md">EXECUTIVE BRIEFING</span>
                            <span class="exec-badge-standard">
                                @(dashboard.Profile?.RoleCode ?? "MEMBER")
                            </span>
                        </div>
                        <h1 class="exec-display text-2xl sm:text-3xl font-bold text-[#0A1B2E]">
                            Welcome back, @(dashboard.Profile?.DisplayName ?? "Member")
                        </h1>
                        <p class="text-xs sm:text-sm text-[#557392] max-w-3xl leading-relaxed">
                            Overview of institutional activity across <strong class="text-[#0A1B2E] font-semibold">@dashboard.JoinedCommunities.Count communities</strong>, <strong class="text-[#0A1B2E] font-semibold">@dashboard.RecentPosts.Count active discussions</strong>, and real-time member operations today.
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <a href="communities" class="exec-btn-secondary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                        <span>Explore Hubs</span>
                    </a>
                    <a href="profile" class="exec-btn-primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>My Profile</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Analytical Metric KPI Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Card 1: My Communities -->
            <div class="exec-card p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 border-b border-[#F2F6FB]">
                    <span class="exec-label-md">My Communities</span>
                    <span class="w-8 h-8 rounded-[0.375rem] bg-[#0A1B2E] text-white flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                    </span>
                </div>
                <div class="mt-4 flex items-baseline justify-between">
                    <div class="exec-display text-2xl sm:text-3xl font-bold text-[#0A1B2E]">
                        @dashboard.JoinedCommunities.Count <span class="text-xs font-normal text-[#557392]">Active</span>
                    </div>
                    <span class="exec-badge-blue">
                        Joined
                    </span>
                </div>
            </div>

            <!-- Card 2: Discussions & Feed -->
            <div class="exec-card p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 border-b border-[#F2F6FB]">
                    <span class="exec-label-md">Discussions &amp; Posts</span>
                    <span class="w-8 h-8 rounded-[0.375rem] bg-[#0A1B2E] text-white flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 18h-5"></path><path d="M18 14h-8"></path><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path><rect width="8" height="4" x="10" y="6" rx="1"></rect></svg>
                    </span>
                </div>
                <div class="mt-4 flex items-baseline justify-between">
                    <div class="exec-display text-2xl sm:text-3xl font-bold text-[#0A1B2E]">
                        @dashboard.RecentPosts.Count <span class="text-xs font-normal text-[#557392]">Items</span>
                    </div>
                    <span class="exec-badge-live">
                        Live Feed
                    </span>
                </div>
            </div>

            <!-- Card 3: Active Polls -->
            <div class="exec-card p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 border-b border-[#F2F6FB]">
                    <span class="exec-label-md">Active Live Polls</span>
                    <span class="w-8 h-8 rounded-[0.375rem] bg-[#0A1B2E] text-white flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    </span>
                </div>
                <div class="mt-4 flex items-baseline justify-between">
                    <div class="exec-display text-2xl sm:text-3xl font-bold text-[#0A1B2E]">
                        @dashboard.ActivePolls.Count <span class="text-xs font-normal text-[#557392]">Voting</span>
                    </div>
                    <span class="exec-badge-live">
                        Active
                    </span>
                </div>
            </div>

            <!-- Card 4: Direct Messages -->
            <div class="exec-card p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-3 border-b border-[#F2F6FB]">
                    <span class="exec-label-md">Direct Messages</span>
                    <span class="w-8 h-8 rounded-[0.375rem] bg-[#0A1B2E] text-white flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </span>
                </div>
                <div class="mt-4 flex items-baseline justify-between">
                    <div class="exec-display text-2xl sm:text-3xl font-bold text-[#0A1B2E]">
                        @dashboard.UnreadMessageCount <span class="text-xs font-normal text-[#557392]">Unread</span>
                    </div>
                    <a href="chat" class="exec-btn-ghost text-xs">
                        Open Chat &rarr;
                    </a>
                </div>
            </div>

        </div>

        <!-- Main Workspace 2-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

            <!-- LEFT COLUMN (2 Columns): Pinned Communities, Composer, and Broadcast Stream -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Section: Your Pinned Communities -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#0A1B2E]"></span>
                            <h2 class="exec-display text-base font-bold text-[#0A1B2E]">Your Pinned Communities</h2>
