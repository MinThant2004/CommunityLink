@page "/"
@page "/home"
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserDashboardApiService DashboardApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject RoleAndPermissionApiService RoleApi
@inject ToastService Toast
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@inject GroupApiService GroupApi
@inject UserProfileApiService ProfileApi
@using System.IO

<PageTitle>Ecosystem Home — CommunityLink</PageTitle>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap');

    .exec-home {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0A1B2E;
        background-color: #F2F6FB;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .exec-display {
        font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: -0.025em;
    }

    .exec-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    .exec-card {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .exec-card:hover {
        border-color: #C4D2E1;
        box-shadow: 0 8px 24px -4px rgba(10, 27, 46, 0.07), 0 2px 6px -1px rgba(10, 27, 46, 0.03);
    }

    .exec-card-static {
        background: #ffffff;
        border: 1px solid #E1E8F0;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px -2px rgba(10, 27, 46, 0.04), 0 1px 3px 0 rgba(10, 27, 46, 0.02);
    }

    .exec-btn-primary {
        background-color: #0A1B2E;
        color: #ffffff !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.01em;
        border: 1px solid #0A1B2E;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-primary:hover:not(:disabled) {
        background-color: #112A46;
        border-color: #112A46;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(10, 27, 46, 0.18);
    }

    .exec-btn-primary:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .exec-btn-secondary {
        background-color: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #112A46 !important;
        border-radius: 0.25rem;
        padding: 0.625rem 1.25rem;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.18s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-secondary:hover {
        background-color: #D9EAFF;
        border-color: #A1B2C4;
        color: #0A1B2E !important;
    }

    .exec-btn-ghost {
        background-color: transparent;
        color: #34506D !important;
        border: 1px solid transparent;
        border-radius: 0.25rem;
        padding: 0.4rem 0.75rem;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.15s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .exec-btn-ghost:hover {
        background-color: #F2F6FB;
        color: #0A1B2E !important;
    }

    .exec-badge-standard {
        background: #F2F6FB;
        border: 1px solid #E1E8F0;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-active {
        background: #0A1B2E;
        border: 1px solid #0A1B2E;
        color: #ffffff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-label-md {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 500;
        line-height: 16px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #7A8CA6;
    }

    .exec-input {
        background: #ffffff;
        border: 1px solid #C4D2E1;
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        font-size: 13px;
        color: #0A1B2E;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .exec-input::placeholder {
        color: #A1B2C4;
    }

    .exec-input:focus {
        border-color: #1B3B5A;
        box-shadow: 0 0 0 3px rgba(27, 59, 90, 0.12);
    }

    .prof-code-block {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
        font-size: 11px;
        border-radius: 0.5rem;
        border: 1px solid #30363d;
    }

    .exec-badge-blue {
        background: #E3EFFF;
        border: 1px solid #C4D2E1;
        color: #34506D;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-badge-live {
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #047857;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: 0.25rem;
        padding: 3px 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .exec-card-tinted {
        background: #EDF4FF;
        border-color: #C4D2E1;
    }

    /* Nocturne Executive Dark Mode Rules */
    .dark .exec-home {
        color: #E1E8F0;
        background-color: #0A1B2E;
    }

    .dark .exec-card {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card:hover {
        border-color: rgba(196, 210, 225, 0.28);
        box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.45);
    }

    .dark .exec-card-static {
        background: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.12);
        box-shadow: none;
    }

    .dark .exec-card-tinted {
        background: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.20);
    }

    .dark .exec-btn-primary {
        background-color: #E1E8F0;
        color: #0A1B2E !important;
        border: 1px solid #E1E8F0;
    }

    .dark .exec-btn-primary:hover:not(:disabled) {
        background-color: #FFFFFF;
        border-color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px -2px rgba(225, 232, 240, 0.20);
    }

    .dark .exec-btn-secondary {
        background-color: #112A46;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0 !important;
    }

    .dark .exec-btn-secondary:hover {
        background-color: #1B3B5A;
        border-color: rgba(196, 210, 225, 0.35);
        color: #FFFFFF !important;
    }

    .dark .exec-btn-ghost {
        color: #C4D2E1 !important;
    }

    .dark .exec-btn-ghost:hover {
        background-color: #1B3B5A;
        color: #FFFFFF !important;
    }

    .dark .exec-badge-standard {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.15);
        color: #C4D2E1;
    }

    .dark .exec-badge-active {
        background: #E1E8F0;
        border: 1px solid #E1E8F0;
        color: #0A1B2E;
    }

    .dark .exec-badge-blue {
        background: #1B3B5A;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-badge-live {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.30);
        color: #34D399;
    }

    .dark .exec-label-md {
        color: #7A8CA6;
    }

    .dark .exec-input {
        background: #0A1B2E;
        border: 1px solid rgba(196, 210, 225, 0.20);
        color: #E1E8F0;
    }

    .dark .exec-input::placeholder {
        color: #7A8CA6;
    }

    .dark .exec-input:focus {
        border-color: rgba(196, 210, 225, 0.35);
        box-shadow: 0 0 16px rgba(225, 232, 240, 0.05);
    }

    /* Scoped Dark Utility Maps for Home Component */
    .dark .exec-home .text-\[\#0A1B2E\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#557392\] { color: #C4D2E1; }
    .dark .exec-home .text-\[\#112A46\] { color: #E1E8F0; }
    .dark .exec-home .text-\[\#34506D\] { color: #C4D2E1; }
    .dark .exec-home .border-\[\#E1E8F0\] { border-color: rgba(196, 210, 225, 0.12); }
    .dark .exec-home .border-\[\#F2F6FB\] { border-color: rgba(196, 210, 225, 0.08); }
    .dark .exec-home .border-\[\#C4D2E1\] { border-color: rgba(196, 210, 225, 0.20); }
    .dark .exec-home .bg-\[\#E3EFFF\] { background-color: #1B3B5A; }
    .dark .exec-home .bg-\[\#F2F6FB\] { background-color: #0A1B2E; }
    .dark .exec-home .bg-\[\#0A1B2E\]:not(button):not(.exec-badge-active) { background-color: #1B3B5A; color: #E1E8F0; }
</style>

<div class="-m-6 p-6 md:p-8 min-h-[calc(100vh-4rem)] exec-home bg-[#F2F6FB] dark:bg-[#0A1B2E]">
@if (isCheckingAuth || (isLoading && dashboard == null))
{
    <div class="exec-card-static p-16 text-center my-8 max-w-xl mx-auto">
        <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] border-t-transparent"></div>
        <h3 class="exec-display mt-5 text-base font-bold text-[#0A1B2E]">Synchronizing Executive Workspace</h3>
        <p class="mt-1 text-xs text-[#557392]">Loading ecosystem feeds, real-time channels, and analytical metrics...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="p-6 bg-[#ffdad6]/40 border border-[#ba1a1a]/30 rounded-lg text-[#93000a] flex flex-col md:flex-row items-center justify-between gap-4 max-w-4xl mx-auto my-6 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-[0.375rem] bg-[#93000a]/10 text-[#93000a] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
            <div>
                <h3 class="exec-display font-bold text-sm text-[#93000a]">Unable to synchronize workspace</h3>
                <p class="text-xs text-[#ba1a1a] mt-0.5">@errorMessage</p>
            </div>
        </div>
        <button @onclick="LoadDashboardAsync" class="exec-btn-primary text-xs">
            Retry Sync
        </button>
    </div>
}
else if (dashboard != null)
{
    <div class="max-w-4xl mx-auto pb-16 space-y-6">

        <!-- Sticky Top Switcher Bar: Post | People | Group -->
        <div class="sticky top-0 z-30 pt-2 pb-3 bg-[#F2F6FB] dark:bg-[#0A1B2E] transition-colors">
            <div class="flex items-center gap-2 p-1.5 bg-white dark:bg-[#112A46] border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.15)] rounded-2xl shadow-sm">
                <button type="button" @onclick='() => activeFeedTab = "posts"' 
                        class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition cursor-pointer @(activeFeedTab == "posts" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow" : "text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                    <span>Post</span>
                </button>
                <button type="button" @onclick='() => activeFeedTab = "people"' 
                        class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition cursor-pointer @(activeFeedTab == "people" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow" : "text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    <span>People</span>
                </button>
                <button type="button" @onclick='() => activeFeedTab = "groups"' 
                        class="flex-1 py-2.5 px-4 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition cursor-pointer @(activeFeedTab == "groups" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] shadow" : "text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] hover:text-[#0A1B2E] dark:hover:text-white")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    <span>Group</span>
                </button>
            </div>
        </div>

        @if (activeFeedTab == "posts")
        {
            <!-- Section: Free Public Post Composer -->
            <div id="quick-composer" class="exec-card p-5 md:p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                        <h3 class="exec-label-md !text-[#0A1B2E] dark:!text-[#E1E8F0] font-bold">Create Public Post</h3>
                    </div>
                    <span class="text-xs text-[#7A8CA6]">Free Public Broadcast</span>
                </div>

                <div class="space-y-3">
                    <textarea @bind="newPostContent" rows="3" placeholder="Share thoughts, discussions, updates, or code with everyone..." class="exec-input w-full resize-none leading-relaxed text-sm p-3 rounded-xl"></textarea>

                    <!-- Text File Preview -->
                    @if (!string.IsNullOrEmpty(composerCodeSnippet))
                    {
                        <div class="prof-code-block p-3 space-y-1.5">
                            <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                <span class="font-bold text-emerald-400 font-mono">📄 @(string.IsNullOrWhiteSpace(composerCodeFileName) ? "attachment.txt" : composerCodeFileName)</span>
                                <button type="button" @onclick="RemoveComposerCodeFile" class="text-xs text-rose-400 hover:underline">Remove</button>
                            </div>
                            <div class="overflow-x-auto overflow-y-auto max-h-48 text-[11px] leading-relaxed">
                                <pre class="whitespace-pre font-mono"><code>@composerCodeSnippet</code></pre>
                            </div>
                        </div>
                    }

                    <!-- Image Preview -->
                    @if (!string.IsNullOrWhiteSpace(uploadedImageUrl))
                    {
                        <div class="relative inline-block mt-2">
                            <img src="@uploadedImageUrl" alt="Attached upload" class="max-h-40 rounded border border-[#C4D2E1] object-cover" />
                            <button type="button" @onclick="RemoveUploadedImage" class="absolute -top-2 -right-2 bg-rose-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold shadow hover:bg-rose-700">
                                &times;
                            </button>
                        </div>
                    }

                    <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Attach Text File Button -->
                            <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-[#112A46] border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] text-xs font-semibold text-[#1B3B5A] dark:text-[#E1E8F0] transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <span>@(isReadingTextFile ? "Scanning..." : "Attach File (.txt)")</span>
                                <InputFile OnChange="HandleComposerTextFileSelected" accept=".txt" class="hidden" disabled="@isReadingTextFile" />
                            </label>

                            <!-- Attach Image Button -->
                            <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-[#112A46] border border-[#C4D2E1] dark:border-[rgba(196,210,225,0.20)] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] text-xs font-semibold text-[#1B3B5A] dark:text-[#E1E8F0] transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                <span>@(isUploadingImage ? "Attaching..." : "Attach Image")</span>
                                <InputFile OnChange="HandleFileSelected" accept="image/*" class="hidden" disabled="@isUploadingImage" />
                            </label>
                        </div>

                        <button @onclick="PublishPostAsync" disabled="@(isPublishingPost || isUploadingImage || isReadingTextFile || string.IsNullOrWhiteSpace(newPostContent))" class="exec-btn-primary">
                            @if (isPublishingPost)
                            {
                                <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                                <span>Publishing...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                                <span>Publish Post</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

            <!-- Feed Stream: Posts and Polls together -->
            <div class="space-y-5">
                <!-- Active Polls Banner in Post Stream -->
                @if (dashboard.ActivePolls != null && dashboard.ActivePolls.Any())
                {
                    <div class="space-y-4">
                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <h3 class="exec-display text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] uppercase tracking-wide">Live Community Polls</h3>
                            </div>
                            <a href="polls" class="text-xs text-[#557392] dark:text-[#C4D2E1] hover:underline font-mono">View All Polls &rarr;</a>
                        </div>

                        @foreach (var poll in dashboard.ActivePolls.Take(2))
                        {
                            <div class="exec-card overflow-hidden transition">
                                <div class="p-5 border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex items-center justify-between gap-3 mb-2">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] flex items-center justify-center font-bold text-xs shrink-0">
                                                📊
                                            </div>
                                            <div>
                                                <span class="font-bold text-xs text-[#0A1B2E] dark:text-[#E1E8F0]">@poll.AuthorName</span>
                                                <span class="text-[10px] text-[#7A8CA6] font-mono ml-1.5">@poll.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            </div>
                                        </div>
                                        <span class="exec-badge-live">
                                            @(poll.IsExpired ? "Closed" : "Active Voting")
                                        </span>
                                    </div>
                                    <h4 class="font-bold text-base text-[#0A1B2E] dark:text-[#E1E8F0] mt-1" style="font-family:'Manrope',sans-serif">@poll.Question</h4>
                                    @if (!string.IsNullOrWhiteSpace(poll.Content) && poll.Content != poll.Question)
                                    {
                                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-1">@poll.Content</p>
                                    }
                                </div>

                                <!-- Poll Options Voting -->
                                <div class="p-5 space-y-2.5">
                                    @foreach (var opt in poll.Options)
                                    {
                                        var hasUserVotedThis = opt.IsVotedByCurrentUser;
                                        var canVote = !poll.HasVoted && !poll.IsExpired;

                                        <div class="relative overflow-hidden rounded-xl border transition-all @(hasUserVotedThis ? "border-[#0A1B2E] dark:border-[#E1E8F0] bg-[#F1F5F9] dark:bg-[#1B3B5A]" : "border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E]")">
                                            <div class="absolute inset-y-0 left-0 bg-[#E2E8F0] dark:bg-[#1B3B5A] transition-all duration-500" style="width: @(opt.Percentage)%;"></div>
                                            <div class="relative z-10 p-3 flex items-center justify-between gap-3 text-xs sm:text-sm">
                                                <div class="flex items-center gap-2.5">
                                                    @if (canVote)
                                                    {
                                                        <button type="button" @onclick="() => VotePollFromHomeAsync(poll.PollId, opt.OptionId)"
                                                                class="w-4 h-4 rounded-full border-2 border-[#557392] dark:border-[#C4D2E1] hover:border-[#0A1B2E] dark:hover:border-white transition flex items-center justify-center shrink-0">
                                                            <div class="w-1.5 h-1.5 rounded-full bg-[#0A1B2E] dark:bg-white opacity-0 hover:opacity-100"></div>
                                                        </button>
                                                    }
                                                    else if (hasUserVotedThis)
                                                    {
                                                        <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">✓</span>
                                                    }
                                                    <span class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0]">@opt.Text</span>
                                                </div>
                                                <span class="font-mono text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@opt.Percentage% (@opt.VoteCount)</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="px-5 py-2.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between text-xs text-[#557392] dark:text-[#7A8CA6]">
                                    <span class="font-mono">👥 @poll.TotalVotes total votes</span>
                                    <span>@(poll.HasVoted ? "✓ You voted" : "Click option to vote")</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Posts Stream -->
                @if (!dashboard.RecentPosts.Any())
                {
                    <div class="exec-card p-10 text-center space-y-2">
                        <span class="w-12 h-12 rounded-[0.5rem] bg-[#E3EFFF] border border-[#C4D2E1] text-[#34506D] flex items-center justify-center mx-auto">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        </span>
                        <h3 class="exec-display font-bold text-sm text-[#0A1B2E] dark:text-[#E1E8F0]">No broadcasts published yet</h3>
                        <p class="text-xs text-[#557392] max-w-sm mx-auto">Publish your first broadcast above to start the discussion.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var post in dashboard.RecentPosts)
                        {
                            <div class="exec-card p-5 md:p-6 space-y-4">
                                <!-- Post Header -->
                                <div class="flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(post.AuthorAvatar))
                                        {
                                            <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-10 h-10 rounded-full object-cover ring-1 ring-[#E1E8F0]" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-[#F2F6FB] dark:bg-[#1B3B5A] border border-[#E1E8F0] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold text-xs flex items-center justify-center">
                                                @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <a href="u/@post.AuthorName" class="font-semibold text-sm text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-[#34506D] transition">
                                                    @post.AuthorName
                                                </a>
                                                <span class="exec-badge-blue !py-0.5 !px-2">
                                                    AUTHOR
                                                </span>
                                            </div>
                                            <p class="exec-mono text-[11px] text-[#7A8CA6] mt-0.5">@post.CreatedAt.ToString("g")</p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                        {
                                            <span class="exec-badge-blue">
                                                <span>@post.CommunityName</span>
                                            </span>
                                        }

                                        <!-- Post Options Menu Dropdown -->
                                        <div class="relative">
                                            <button type="button" @onclick="() => TogglePostMenu(post.PostId)" class="p-1.5 text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white rounded hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] transition cursor-pointer" title="Post Options">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                                </svg>
                                            </button>

                                            @if (activeMenuPostId == post.PostId)
                                            {
                                                <div class="absolute right-0 mt-1 w-44 bg-white dark:bg-[#112A46] rounded-xl shadow-lg border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.15)] py-1.5 z-30">
                                                    <button type="button" @onclick="() => ToggleSavePost(post.PostId)" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#112A46] dark:text-[#E1E8F0] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                        <span>@(post.IsSavedByCurrentUser ? "★" : "☆")</span>
                                                        <span>@(post.IsSavedByCurrentUser ? "Unsave Post" : "Save Post")</span>
                                                    </button>

                                                    @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                                    {
                                                        <button type="button" @onclick="() => OpenEditPost(post)" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#112A46] dark:text-[#E1E8F0] hover:bg-[#F2F6FB] dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                            <span>Edit Post</span>
                                                        </button>
                                                        <div class="border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] my-1"></div>
                                                        <button type="button" @onclick="() => PromptRecyclePost(post.PostId)" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/40 flex items-center gap-2 transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                                            <span>Move to Recycle Bin</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Post Content -->
                                <p class="text-[#112A46] dark:text-[#E1E8F0] text-sm leading-relaxed whitespace-pre-line">
                                    @post.Content
                                </p>

                                <!-- Text File / Code Snippet Container -->
                                @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                {
                                    <div class="prof-code-block p-3 space-y-1.5 mt-2">
                                        <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                            <span class="font-bold text-emerald-400 font-mono">📄 @(string.IsNullOrWhiteSpace(post.CodeFileName) ? "attachment.txt" : post.CodeFileName)</span>
                                            <span class="font-mono">@(string.IsNullOrWhiteSpace(post.CodeLanguage) ? "TEXT" : post.CodeLanguage)</span>
                                        </div>
                                        <div class="overflow-x-auto overflow-y-auto max-h-72 text-[11px] leading-relaxed">
                                            <pre class="whitespace-pre font-mono"><code>@post.CodeSnippet</code></pre>
                                        </div>
                                    </div>
                                }

                                <!-- Post Images -->
                                @if (post.ImageUrls != null && post.ImageUrls.Any())
                                {
                                    <div class="rounded-xl overflow-hidden border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] bg-slate-900 mt-2">
                                        @if (post.ImageUrls.Count == 1)
                                        {
                                            <div class="max-h-96 overflow-hidden flex items-center justify-center">
                                                <img src="@post.ImageUrls[0]" alt="Post attachment" class="w-full h-auto max-h-96 object-contain" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="grid grid-cols-2 gap-1 p-1 bg-slate-200 dark:bg-slate-950">
                                                @foreach (var img in post.ImageUrls)
                                                {
                                                    <div class="h-48 overflow-hidden bg-slate-900 flex items-center justify-center">
                                                        <img src="@img" alt="Post attachment" class="w-full h-full object-cover" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Post Metrics Strip -->
                                <div class="px-1 py-1 flex items-center justify-between text-xs text-[#7A8CA6] font-mono border-b border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] pb-2">
                                    <span>❤️ @post.LikeCount @(post.LikeCount == 1 ? "Like" : "Likes")</span>
                                    <span>@post.CommentCount comments • @post.ShareCount shares</span>
                                </div>

                                <!-- Post Actions: Like, Comment, Share -->
                                <div class="flex items-center justify-between pt-1 text-xs">
                                    <div class="flex items-center gap-5 w-full">
                                        <!-- Like -->
                                        <button type="button" @onclick="() => ToggleLikeAsync(post.PostId)" class="flex items-center gap-1.5 font-medium transition cursor-pointer @(post.IsLikedByCurrentUser ? "text-rose-600 font-semibold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white")">
                                            <svg class="w-4 h-4 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-currentColor")" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                            </svg>
                                            <span>Like</span>
                                        </button>

                                        <!-- Comment Toggle -->
                                        <button type="button" @onclick="() => ToggleHomeCommentBox(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer @(openHomeCommentPostIds.Contains(post.PostId) ? "!text-[#0A1B2E] dark:!text-white font-bold" : "")">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                            <span>Comment</span>
                                        </button>

                                        <!-- Share -->
                                        <button type="button" @onclick="() => OpenHomeShareModal(post.PostId)" class="flex items-center gap-1.5 font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition cursor-pointer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                            <span>Share</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Inline Comment Drawer -->
                                @if (openHomeCommentPostIds.Contains(post.PostId))
                                {
                                    <div class="border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] pt-4 space-y-3">
                                        <div class="flex items-center gap-2">
                                            <input type="text" @bind="homeCommentInputs[post.PostId]"
                                                   @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitHomeCommentAsync(post.PostId); })"
                                                   placeholder="Write a comment..."
                                                   class="flex-1 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20" />
                                            <button type="button" @onclick="() => SubmitHomeCommentAsync(post.PostId)"
                                                    class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold hover:opacity-90 transition">
                                                Post
                                            </button>
                                        </div>

                                        @if (homeCommentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                        {
                                            @if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#7A8CA6] text-center py-2">No comments yet. Be the first!</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-2.5 pt-1">
                                                    @foreach (var c in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs bg-[#F8FAFC] dark:bg-[#0A1B2E] p-2.5 rounded-xl border border-[#E1E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                            <div class="w-6 h-6 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold text-[10px] shrink-0">
                                                                @(string.IsNullOrWhiteSpace(c.AuthorName) ? "U" : c.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1">
                                                                <div class="flex items-center justify-between mb-0.5">
                                                                    <span class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@c.AuthorName</span>
                                                                    <span class="text-[10px] text-[#7A8CA6] font-mono">@c.CreatedAt.ToString("g")</span>
                                                                </div>
                                                                <p class="text-[#557392] dark:text-[#C4D2E1] leading-relaxed">@c.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (activeFeedTab == "people")
        {
            <!-- Section: People / Network Directory -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                        <h2 class="exec-display text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Ecosystem Members &amp; Network</h2>
                    </div>
                    <span class="text-xs text-[#7A8CA6]">Followed members appear first</span>
                </div>

                @if (!dashboard.People.Any())
                {
                    <div class="exec-card p-12 text-center space-y-3">
                        <p class="text-sm font-medium text-[#557392]">No other active members found.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var person in dashboard.People)
                        {
                            <div class="exec-card p-5 flex flex-col justify-between space-y-3">
                                <div class="flex items-start gap-3">
                                    @if (!string.IsNullOrWhiteSpace(person.AvatarUrl))
                                    {
                                        <img src="@person.AvatarUrl" alt="@person.DisplayName" class="w-12 h-12 rounded-full object-cover ring-2 ring-[#E1E8F0] shrink-0" />
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-full bg-[#E3EFFF] text-[#0A1B2E] font-bold text-sm flex items-center justify-center shrink-0 border border-[#C4D2E1]">
                                            @((string.IsNullOrWhiteSpace(person.DisplayName) ? person.UserName : person.DisplayName).Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5">
                                            <a href="u/@person.UserName" class="font-bold text-sm text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-[#34506D] truncate">
                                                @(string.IsNullOrWhiteSpace(person.DisplayName) ? person.UserName : person.DisplayName)
                                            </a>
                                            @if (person.IsVerified)
                                            {
                                                <span class="text-sky-500 text-xs" title="Verified">✓</span>
                                            }
                                        </div>
                                        <div class="text-[11px] text-[#7A8CA6] font-mono">@@@person.UserName</div>
                                        @if (person.IsFollowedByCurrentUser)
                                        {
                                            <span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                Following
                                            </span>
                                        }
                                    </div>
                                </div>

                                <p class="text-xs text-[#557392] dark:text-[#C4D2E1] line-clamp-2 leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(person.Bio) ? "Active member on CommunityLink." : person.Bio)
                                </p>

                                <div class="pt-3 border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between">
                                    <span class="exec-mono text-[11px] text-[#7A8CA6]">
                                        @(person.PostsCount) posts · @(person.JoinedCommunitiesCount) hubs
                                    </span>
                                    <button type="button" @onclick="() => ToggleFollowPersonAsync(person.UserId)" 
                                            class="text-xs font-semibold px-3 py-1 rounded-xl transition cursor-pointer @(person.IsFollowedByCurrentUser ? "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200" : "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] hover:opacity-90")">
                                        @(person.IsFollowedByCurrentUser ? "Unfollow" : "Follow")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (activeFeedTab == "groups")
        {
            <!-- Section: Groups (Joined First, then Discover) -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0]"></span>
                        <h2 class="exec-display text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Collaborative Groups</h2>
                    </div>
                    <a href="groups" class="exec-mono text-[11px] text-[#34506D] dark:text-[#C4D2E1] hover:text-[#0A1B2E] font-medium">BROWSE ALL &rarr;</a>
                </div>

                @if (dashboard.Groups == null || !dashboard.Groups.Any())
                {
                    <div class="exec-card p-12 text-center space-y-3">
                        <p class="text-sm font-medium text-[#557392]">No groups available at this time.</p>
                        <a href="groups" class="exec-btn-primary text-xs">
                            <span>Explore Groups</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var grp in dashboard.Groups)
                        {
                            <div class="exec-card p-5 flex flex-col justify-between space-y-3">
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between">
                                        @if (grp.IsJoined)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                JOINED
                                            </span>
                                        }
                                        else if (grp.UserJoinStatus == "PENDING")
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                REQUEST PENDING
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                                @(grp.Visibility ?? "PUBLIC")
                                            </span>
                                        }
                                        <span class="exec-mono text-[11px] text-[#7A8CA6]">@grp.MemberCount members</span>
                                    </div>

                                    <h3 class="exec-display text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] tracking-tight">@grp.Name</h3>
                                    <p class="text-xs text-[#557392] dark:text-[#C4D2E1] line-clamp-2 leading-relaxed">
                                        @(string.IsNullOrWhiteSpace(grp.Description) ? "Discussion and collaboration group." : grp.Description)
                                    </p>
                                </div>

                                <div class="pt-3 border-t border-[#E1E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-between text-xs">
                                    <span class="exec-mono text-[11px] text-[#7A8CA6]">
                                        @(grp.PostCount) posts
                                    </span>
                                    @if (grp.IsJoined)
                                    {
                                        <a href="group/@grp.GroupId" class="exec-btn-secondary text-xs !py-1 !px-3">
                                            Enter &rarr;
                                        </a>
                                    }
                                    else if (grp.UserJoinStatus == "PENDING")
                                    {
                                        <span class="text-xs text-amber-600 font-semibold">Pending Approval</span>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => JoinGroupFromHomeAsync(grp.GroupId)" class="exec-btn-primary text-xs !py-1 !px-3">
                                            Join Group
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

    </div>
}
</div>

