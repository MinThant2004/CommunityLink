                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Attach Text File (.txt) (Optional)</label>
                        @if (!string.IsNullOrEmpty(composerCodeSnippet))
                        {
                            <button type="button" @onclick="RemoveComposerCodeFile" class="text-xs text-rose-500 hover:underline">Remove file</button>
                        }
                    </div>

                    @if (string.IsNullOrEmpty(composerCodeSnippet))
                    {
                        <label class="cursor-pointer border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded-xl p-3 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center gap-2">
                            <span class="text-base">📄</span>
                            <span class="text-xs font-medium text-[#1B3B5A] dark:text-[#E1E8F0]">@(isReadingTextFile ? "Scanning text file..." : "Click to select a .txt file")</span>
