                                            }
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <a href="u/@post.AuthorName" class="font-semibold text-sm text-[#0A1B2E] hover:text-[#34506D] transition">
                                                        @post.AuthorName
                                                    </a>
                                                    <span class="exec-badge-blue !py-0.5 !px-2">
                                                        AUTHOR
                                                    </span>
                                                </div>
                                                <p class="exec-mono text-[11px] text-[#7A8CA6] mt-0.5">@post.CreatedAt.ToString("g")</p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                        {
                                            <span class="exec-badge-blue">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                                                <span>@post.CommunityName</span>
                                            </span>
                                        }
                                    </div>

                                    <!-- Post Content -->
                                    <p class="text-[#112A46] text-sm leading-relaxed whitespace-pre-line">
                                        @post.Content
