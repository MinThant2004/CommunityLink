    private static string GetRoleBadgeText(DirectoryPersonModel person)
    {
        if (!string.IsNullOrWhiteSpace(person.PercentileBadgeText))
            return person.PercentileBadgeText;

        return person.RoleCode switch
        {
            "PUBLIC_FIGURE" => "Public Figure",
            "DOMAIN_PROFESSIONAL" => "Domain Pro",
            "CREATOR" => "Creator",
            "ADMIN" => "Community Lead",
            "MODERATOR" => "Moderator",
            _ => person.IsVerified ? "Verified Member" : "Active Member"
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                    window.clInitHomeFeedObserver = function(dotNetHelper) {
                        var topBtn = document.getElementById('btn-scroll-to-top');
                        window.addEventListener('scroll', function() {
                            if (!topBtn) topBtn = document.getElementById('btn-scroll-to-top');
                            if (topBtn) {
                                if (window.scrollY > 350) {
                                    topBtn.classList.remove('opacity-0', 'pointer-events-none');
                                    topBtn.classList.add('opacity-100', 'pointer-events-auto');
                                } else {
                                    topBtn.classList.remove('opacity-100', 'pointer-events-auto');
                                    topBtn.classList.add('opacity-0', 'pointer-events-none');
                                }
                            }
                        });

                        var observer = new IntersectionObserver(function(entries) {
                            if (entries[0] && entries[0].isIntersecting) {
                                dotNetHelper.invokeMethodAsync('TriggerLoadMoreFeedPosts');
                            }
                        }, { rootMargin: '400px' });

                        var sentinel = document.getElementById('feed-infinite-sentinel');
                        if (sentinel) observer.observe(sentinel);
                    };
                ");

                await JS.InvokeVoidAsync("clInitHomeFeedObserver", dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task TriggerLoadMoreFeedPosts()
    {
        if (isLoadingMoreFeed || !hasMoreFeedPosts || isLoading) return;

        isLoadingMoreFeed = true;
        StateHasChanged();

        try
        {
            var nextPage = currentFeedPage + 1;
            var res = await PostApi.GetFeedAsync(page: nextPage, pageSize: FeedPageSize, cancellationToken: _cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                var newItems = res.Data;
                if (newItems.Count > 0)
                {
                    // Deduplicate against existing feed
                    var existingIds = new HashSet<int>(feedPosts.Select(p => p.PostId));
                    var toAdd = newItems.Where(p => !existingIds.Contains(p.PostId)).ToList();
                    feedPosts.AddRange(toAdd);
                    currentFeedPage = nextPage;
                    hasMoreFeedPosts = newItems.Count >= FeedPageSize;
                }
                else
                {
                    hasMoreFeedPosts = false;
                }
            }
            else
            {
                hasMoreFeedPosts = false;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            hasMoreFeedPosts = false;
        }
        finally
        {
            isLoadingMoreFeed = false;
            StateHasChanged();
        }
    }

