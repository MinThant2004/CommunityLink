        try
        {
            var req = new CreateCommentRequestModel(postId, content.Trim());
            var res = await PostApi.AddCommentAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                homeCommentInputs[postId] = string.Empty;
                var commentsRes = await PostApi.GetCommentsAsync(postId, _cts.Token);
