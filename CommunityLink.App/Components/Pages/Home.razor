                                    </div>

                                    <div class="pt-3 border-t border-[#E1E8F0] flex items-center justify-between text-xs">
                                        <div class="flex items-center gap-1.5 text-[#7A8CA6]">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
