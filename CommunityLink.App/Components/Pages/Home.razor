@page "/"
@rendermode InteractiveServer
@layout LandingLayout
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>CommunityLink — Connect Communities Worldwide</PageTitle>

@* ===== Top Navigation Bar ===== *@
<nav class="site-nav">
    <a class="site-logo" href="/">
        <span class="site-logo-icon">🌐</span>
        <span class="site-logo-text">CommunityLink</span>
    </a>

    <div class="site-nav-links">
        <a class="site-nav-link" href="/feed">Feed</a>
        <a class="site-nav-link" href="/communities">Communities</a>
        <a class="site-nav-link" href="/polls">Polls</a>
        <a class="site-nav-link" href="/chat">Messages</a>
    </div>

    <div class="site-nav-actions">
        <AuthorizeView>
            <Authorized>
                <a class="btn-nav btn-nav-primary" href="/feed">📰 Go to Feed</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn-nav btn-nav-outline" href="/login">Login</a>
                <a class="btn-nav btn-nav-primary" href="/register">Register</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@* ===== Hero Text ===== *@
<header class="hero">
    <span class="hero-badge">✦ Community Platform</span>
    <h1>Connect People. <span class="h1-accent">Build Communities.</span></h1>
    <p class="hero-tagline">
        A modern, scalable platform connecting people across the globe —
        with <strong>real-time messaging</strong>, <strong>live polls</strong>,
        and <strong>rich content feeds</strong>.
    </p>
</header>

@* ===== Globe Frame (nothing overlays the globe) ===== *@
<div class="globe-frame">
    <div class="frame-header">
        <div class="frame-header-left">
            <div class="frame-dots">
                <span></span><span></span><span></span>
            </div>
            <span class="frame-title">
                <span class="frame-title-highlight">COMMUNITYLINK</span> GLOBAL NETWORK GRID • LIVE
            </span>
        </div>
        <div class="frame-header-routes">
            <span class="frame-route">🌐 San Francisco <span class="route-arrow">⟷</span> London</span>
            <span class="frame-route">Singapore <span class="route-arrow">⟷</span> Tokyo <span class="route-arrow">⟷</span> Yangon</span>
        </div>
    </div>

    <div class="frame-hint">
        <span class="hint-icon">✦</span> Click &amp; Drag to Rotate 3D Globe • Scroll to Zoom
    </div>

    <div class="globe-viewport">
        <div id="globe-canvas"></div>
    </div>

    <div class="frame-footer">
        <span>Powered by</span>
        <span class="footer-accent">.NET 10</span>
        <span class="footer-dot">•</span>
        <span>Blazor Server</span>
        <span class="footer-dot">•</span>
        <span>Dynamic RBAC</span>
        <span class="footer-dot">•</span>
        <span class="footer-accent">Enterprise Grade</span>
    </div>
</div>

@* ===== Call-To-Action Band ===== *@
<section class="cta-band">
    <h2>Join the global community</h2>
    <p>Free to join. Built for connections that span continents.</p>
    <div class="cta-actions">
        <AuthorizeView>
            <Authorized>
                <a class="btn-glow btn-glow-primary" href="/feed">📰 Go to Public Feed</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn-glow btn-glow-outline" href="/login">🔑 Login</a>
                <a class="btn-glow btn-glow-gold" href="/register">📝 Create Account</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

@* ===== Feature Cards ===== *@
<section class="features">
    <div class="feature-card">
        <span class="feature-icon">👥</span>
        <h3>Communities &amp; Hubs</h3>
        <p>Join topical groups, manage memberships, and participate in community discussions.</p>
    </div>
    <div class="feature-card">
        <span class="feature-icon">📊</span>
        <h3>Live Polls &amp; Voting</h3>
        <p>Create polls with single or multiple choice questions and instant results.</p>
    </div>
    <div class="feature-card">
        <span class="feature-icon">💬</span>
        <h3>Real-Time Messaging</h3>
        <p>Direct messaging and threaded conversations between community members.</p>
    </div>
</section>

@* ===== Footer ===== *@
<footer class="site-footer">
    <span>© @DateTime.Now.Year CommunityLink — A community without borders.</span>
</footer>

@code {
    private bool _globeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_globeInitialized)
        {
            _globeInitialized = true;
            await JS.InvokeVoidAsync("initGlobe");
        }
    }

    public void Dispose()
    {
        _ = DisposeGlobeAsync();
    }

    private async Task DisposeGlobeAsync()
    {
        try
        {
            if (_globeInitialized)
            {
                await JS.InvokeVoidAsync("disposeGlobe");
            }
        }
        catch
        {
            // JS interop may fail during circuit disconnect — safe to ignore
        }
    }
}