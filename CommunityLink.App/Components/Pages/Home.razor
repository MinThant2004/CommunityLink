                                            }
                                            else
                                            {
                                                <div class="w-10 h-10 rounded-full bg-[#F2F6FB] border border-[#E1E8F0] text-[#0A1B2E] font-bold text-xs flex items-center justify-center">
                                                    @post.AuthorName.Substring(0, 1).ToUpper()
