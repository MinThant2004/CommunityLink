    private async Task HandleComposerTextFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error("Only plain text (.txt) files are allowed.");
            return;
        }

        try
        {
            isReadingTextFile = true;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            composerCodeSnippet = await reader.ReadToEndAsync();
            composerCodeFileName = file.Name;
            Toast.Success($"Text file '{file.Name}' read successfully.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to read text file: {ex.Message}");
        }
        finally
        {
            isReadingTextFile = false;
        }
    }

