                <button type="button" @onclick="CloseCreatePostModal" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg transition cursor-pointer">Cancel</button>
                <button type="button" @onclick="PublishPostAsync" disabled="@(isPublishingPost || isUploadingImage || isReadingTextFile || (string.IsNullOrWhiteSpace(newPostContent) && string.IsNullOrWhiteSpace(composerCodeSnippet) && uploadedImageUrls.Count == 0))"
