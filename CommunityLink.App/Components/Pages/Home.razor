                                        </div>
                                        <a href="communities" class="exec-btn-secondary text-xs !py-1.5 !px-3">
                                            <span>Enter Hub</span> &rarr;
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Section: Executive Broadcast Composer -->
                <div id="quick-composer" class="exec-card p-5 md:p-6 space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#E1E8F0]">
                        <div class="flex items-center gap-2">
