                                    <option value="0">Public / General Stream</option>
                                    @foreach (var comm in dashboard.JoinedCommunities)
                                    {
                                        <option value="@comm.CommunityId">@comm.Name</option>
                                    }
                                </select>
                            </div>

                            <button @onclick="PublishPostAsync" disabled="@(isPublishingPost || string.IsNullOrWhiteSpace(newPostContent))" class="exec-btn-primary">
