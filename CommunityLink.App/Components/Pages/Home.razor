@page "/"
@page "/home"
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject UserDashboardApiService DashboardApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast

<PageTitle>Member Home — CommunityLink</PageTitle>

@if (isCheckingAuth || (isLoading && dashboard == null))
{
    <div class="p-16 text-center text-slate-500 bg-white rounded-3xl shadow-sm border border-slate-200/80 my-8">
        <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-indigo-600 border-t-transparent"></div>
        <p class="mt-3 text-sm font-semibold text-slate-600">Loading your CommunityLink Home...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="p-8 bg-rose-50 border border-rose-200 rounded-3xl text-rose-700 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="text-2xl">⚠️</span>
            <div>
                <h3 class="font-bold text-base">Unable to load home feed</h3>
                <p class="text-xs text-rose-600 mt-0.5">@errorMessage</p>
            </div>
        </div>
        <button @onclick="LoadDashboardAsync" class="px-5 py-2.5 bg-rose-600 text-white text-xs font-semibold rounded-xl hover:bg-rose-700 transition shadow-sm">
            Retry
        </button>
    </div>
}
else if (dashboard != null)
{
    <div class="space-y-6 max-w-7xl mx-auto pb-12">
        <!-- Hero Banner for Authenticated Member -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white shadow-xl border border-slate-800 p-6 md:p-8">
            <div class="absolute -top-24 -right-24 w-80 h-80 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="relative">
                        @if (!string.IsNullOrWhiteSpace(dashboard.Profile?.AvatarUrl))
                        {
                            <img src="@dashboard.Profile.AvatarUrl" alt="@dashboard.Profile.DisplayName" class="w-16 h-16 rounded-2xl object-cover ring-4 ring-indigo-500/30 shadow-lg" />
                        }
                        else
                        {
                            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 text-white font-black text-2xl flex items-center justify-center ring-4 ring-indigo-500/30 shadow-lg">
                                @(dashboard.Profile?.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                        }
                        <div class="absolute -bottom-1 -right-1 bg-emerald-500 w-4 h-4 rounded-full ring-2 ring-slate-900" title="Online"></div>
                    </div>

                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-2xl font-black tracking-tight text-white">@GetGreeting(), @(dashboard.Profile?.DisplayName ?? "Member")!</h1>
                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white/10 text-indigo-200 border border-white/15">
                                @(dashboard.Profile?.RoleCode ?? "Member")
                            </span>
                        </div>
                        <p class="text-slate-300 text-xs md:text-sm mt-1">Here is your daily activity feed, community discussions, and live polls.</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
                    <a href="feed" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                        <span>📰</span> Public Feed
                    </a>
                    <a href="communities" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition flex items-center gap-2">
                        <span>🏛️</span> Explore Hubs
                    </a>
                    <a href="profile" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition flex items-center gap-2">
                        <span>👤</span> My Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Metrics Overview Grid -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Joined Hubs</div>
                    <div class="text-2xl font-black text-slate-900 mt-1">@dashboard.JoinedCommunities.Count</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
                    🏛️
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Recent Posts</div>
                    <div class="text-2xl font-black text-slate-900 mt-1">@dashboard.RecentPosts.Count</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                    📝
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Polls</div>
                    <div class="text-2xl font-black text-slate-900 mt-1">@dashboard.ActivePolls.Count</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                    📊
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Messages</div>
                    <div class="text-2xl font-black text-sky-600 mt-1">@dashboard.UnreadMessageCount</div>
                </div>
                <div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                    💬
                </div>
            </div>
        </div>

        <!-- Main Home 2-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
            
            <!-- Left Column: Activity Feed & Quick Composer (2 cols) -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Quick Post Composer -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(dashboard.Profile?.AvatarUrl))
                        {
                            <img src="@dashboard.Profile.AvatarUrl" alt="Avatar" class="w-10 h-10 rounded-xl object-cover" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white font-bold text-base flex items-center justify-center">
                                @(dashboard.Profile?.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                        }
                        <div class="flex-1">
                            <textarea @bind="newPostContent" rows="2" placeholder="Share an update, question, or thought with your communities..." class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none resize-none transition"></textarea>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-slate-500">Post to:</span>
                            <select @bind="selectedCommunityId" class="text-xs font-medium px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 outline-none">
                                <option value="0">🌐 Public / General Feed</option>
                                @foreach (var comm in dashboard.JoinedCommunities)
                                {
                                    <option value="@comm.CommunityId">🏛️ @comm.Name</option>
                                }
                            </select>
                        </div>

                        <button @onclick="PublishPostAsync" disabled="@(isPublishingPost || string.IsNullOrWhiteSpace(newPostContent))" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white font-bold text-xs transition shadow-md shadow-indigo-600/20 flex items-center gap-2">
                            @if (isPublishingPost)
                            {
                                <span class="animate-spin text-xs">⌛</span>
                                <span>Posting...</span>
                            }
                            else
                            {
                                <span>🚀 Publish Post</span>
                            }
                        </button>
                    </div>
                </div>

                <!-- Feed Stream Header -->
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <span>📰</span> Latest Activity Stream
                    </h2>
                    <a href="feed" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">
                        View Full Feed &rarr;
                    </a>
                </div>

                <!-- Post Cards -->
                @if (!dashboard.RecentPosts.Any())
                {
                    <div class="bg-white p-12 rounded-2xl shadow-sm border border-slate-200 text-center text-slate-500">
                        <span class="text-4xl">📝</span>
                        <h3 class="font-bold text-base text-slate-800 mt-2">No recent posts yet</h3>
                        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Be the first to publish an update or join more communities to see fresh updates in your feed.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var post in dashboard.RecentPosts)
                        {
                            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 space-y-3 hover:border-slate-300 transition">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(post.AuthorAvatar))
                                        {
                                            <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-10 h-10 rounded-xl object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-xl bg-slate-200 text-slate-700 font-bold text-sm flex items-center justify-center">
                                                @post.AuthorName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div>
                                            <a href="u/@post.AuthorName" class="font-bold text-sm text-slate-900 hover:text-indigo-600 transition">@post.AuthorName</a>
                                            <p class="text-xs text-slate-400">@post.CreatedAt.ToString("g")</p>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(post.CommunityName))
                                    {
                                        <span class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-semibold">
                                            🏛️ @post.CommunityName
                                        </span>
                                    }
                                </div>

                                <p class="text-slate-800 text-sm leading-relaxed whitespace-pre-line">@post.Content</p>

                                <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs text-slate-500">
                                    <div class="flex items-center gap-4">
                                        <button @onclick="() => ToggleLikeAsync(post.PostId)" class="flex items-center gap-1.5 font-semibold hover:text-rose-600 transition @(post.IsLikedByCurrentUser ? "text-rose-600" : "")">
                                            <span>@(post.IsLikedByCurrentUser ? "❤️" : "🤍")</span>
                                            <span>@post.LikeCount Likes</span>
                                        </button>
                                        <a href="feed" class="flex items-center gap-1.5 font-semibold hover:text-indigo-600 transition">
                                            <span>💬</span>
                                            <span>@post.CommentCount Comments</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right Column: Sidebar Widgets (1 col) -->
            <div class="space-y-6">
                
                <!-- My Joined Communities Widget -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                            <span>🏛️</span> My Communities
                        </h3>
                        <a href="communities" class="text-xs font-semibold text-indigo-600 hover:underline">View All</a>
                    </div>

                    @if (!dashboard.JoinedCommunities.Any())
                    {
                        <div class="text-center py-6 text-slate-400 text-xs">
                            <p>You haven't joined any hubs yet.</p>
                            <a href="communities" class="mt-2 inline-block px-3 py-1.5 bg-indigo-50 text-indigo-700 font-semibold rounded-lg hover:bg-indigo-100 transition">Explore Hubs</a>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2.5">
                            @foreach (var hub in dashboard.JoinedCommunities.Take(4))
                            {
                                <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-200">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0">
                                            @hub.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-xs text-slate-900 truncate">@hub.Name</div>
                                            <div class="text-[11px] text-slate-400">@hub.MemberCount members</div>
                                        </div>
                                    </div>
                                    <a href="communities" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                        Open
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Active Polls Widget -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                            <span>📊</span> Active Live Polls
                        </h3>
                        <a href="polls" class="text-xs font-semibold text-amber-600 hover:underline">All Polls</a>
                    </div>

                    @if (!dashboard.ActivePolls.Any())
                    {
                        <p class="text-xs text-slate-400 text-center py-4">No active polls at the moment.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var poll in dashboard.ActivePolls.Take(2))
                            {
                                <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2.5">
                                    <div class="font-bold text-xs text-slate-900">@poll.Question</div>
                                    <div class="space-y-1.5">
                                        @foreach (var opt in poll.Options)
                                        {
                                            <div class="text-xs p-2 bg-white rounded-lg border border-slate-200 flex items-center justify-between">
                                                <span class="text-slate-700 font-medium">@opt.Text</span>
                                                <span class="text-slate-400 font-bold">@opt.VoteCount</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="text-[11px] text-slate-400 text-right">Total Votes: @poll.TotalVotes</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Recommended Communities to Discover -->
                @if (dashboard.RecommendedCommunities.Any())
                {
                    <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-5 rounded-2xl shadow-lg border border-slate-800 space-y-4">
                        <div class="flex items-center justify-between border-b border-white/10 pb-3">
                            <h3 class="font-bold text-sm text-white flex items-center gap-2">
                                <span>✨</span> Recommended For You
                            </h3>
                            <a href="communities" class="text-xs font-semibold text-indigo-300 hover:underline">More</a>
                        </div>

                        <div class="space-y-3">
                            @foreach (var rec in dashboard.RecommendedCommunities.Take(3))
                            {
                                <div class="p-3 rounded-xl bg-white/5 border border-white/10 space-y-2">
                                    <div class="font-bold text-xs text-white">@rec.Name</div>
                                    <p class="text-[11px] text-slate-300 line-clamp-2 leading-relaxed">@rec.Description</p>
                                    <div class="flex items-center justify-between pt-1">
                                        <span class="text-[10px] text-slate-400">👥 @rec.MemberCount members</span>
                                        <a href="communities" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-500 hover:bg-indigo-400 text-white transition">
                                            Explore
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
}

@code {
    private bool isCheckingAuth = true;
    private bool isLoading = true;
    private string? errorMessage;
    private UserDashboardModel? dashboard;

    // Quick Composer State
    private string newPostContent = string.Empty;
    private int selectedCommunityId = 0;
    private bool isPublishingPost;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity == null || !user.Identity.IsAuthenticated)
        {
            // Unauthenticated guest -> redirect to Guest landing page
            Navigation.NavigateTo("/guest", replace: true);
            return;
        }

        isCheckingAuth = false;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await DashboardApi.GetUserDashboardAsync(_cts.Token);
            if (res.IsSuccess && res.Data != null)
            {
                dashboard = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load dashboard data.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PublishPostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostContent)) return;

        isPublishingPost = true;
        try
        {
            var req = new CreatePostRequestModel(
                selectedCommunityId > 0 ? selectedCommunityId : null,
                newPostContent.Trim(),
                null
            );

            var res = await PostApi.CreatePostAsync(req, _cts.Token);
            if (res.IsSuccess)
            {
                Toast.Success("Post published successfully!");
                newPostContent = string.Empty;
                await LoadDashboardAsync();
            }
            else
            {
                Toast.Error(res.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to publish post: {ex.Message}");
        }
        finally
        {
            isPublishingPost = false;
        }
    }

    private async Task ToggleLikeAsync(int postId)
    {
        try
        {
            var res = await PostApi.LikePostAsync(postId, _cts.Token);
            if (res.IsSuccess)
            {
                await LoadDashboardAsync();
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 17) return "Good afternoon";
        return "Good evening";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
