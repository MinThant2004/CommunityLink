    private async Task HandleMultipleImagesSelected(InputFileChangeEventArgs e)
    {
        if (uploadedImageUrls.Count >= 10)
        {
            Toast.Error("You can only attach up to 10 images.");
            return;
        }
        var availableSlots = 10 - uploadedImageUrls.Count;
        var files = e.GetMultipleFiles(maximumFileCount: availableSlots);
        if (files == null || files.Count == 0) return;
        try
        {
            isUploadingImage = true;
            var subfolder = DateTime.UtcNow.ToString("yyyyMM");
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads", "posts", subfolder);
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }
            foreach (var file in files)
            {
                var extension = Path.GetExtension(file.Name);
                if (string.IsNullOrEmpty(extension)) extension = ".jpg";
                var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
                var fullPath = Path.Combine(uploadsDir, uniqueFileName);
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var fileStream = new FileStream(fullPath, FileMode.Create);
                await stream.CopyToAsync(fileStream);
                uploadedImageUrls.Add($"/uploads/posts/{subfolder}/{uniqueFileName}");
            }
            Toast.Success(string.Format(Loc["GroupDetail_Toast_ImagesAttached"], files.Count));
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["GroupDetail_Toast_ImagesFailed"], ex.Message));
        }
        finally
        {
            isUploadingImage = false;
        }
    }
    private void RemoveUploadedImage(int index)
    {
        if (index >= 0 && index < uploadedImageUrls.Count)
        {
            uploadedImageUrls.RemoveAt(index);
        }
    }
    private async Task HandlePostTextFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".txt", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error("Only .txt files are allowed.");
            return;
        }
        try
        {
            isReadingTextFile = true;
            var subfolder = DateTime.UtcNow.ToString("yyyyMM");
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads", "posts", "files", subfolder);
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }
            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);
            using (var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            using (var fileStream = new FileStream(fullPath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }
            var fileUrl = $"/uploads/posts/files/{subfolder}/{uniqueFileName}";
            string content = string.Empty;
            if (file.Size <= 2 * 1024 * 1024)
            {
                try
                {
                    content = await File.ReadAllTextAsync(fullPath);
                }
                catch { }
            }
            var item = new AttachedTextFileItem(file.Name, content, fileUrl, file.Size);
            newPostCodeSnippet = JsonSerializer.Serialize(new List<AttachedTextFileItem> { item });
            newPostCodeFileName = file.Name;
            Toast.Success(string.Format(Loc["GroupDetail_Toast_TxtReadSuccess"], file.Name));
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["GroupDetail_Toast_TxtReadFailed"], ex.Message));
        }
        finally
        {
            isReadingTextFile = false;
        }
    }
    private void RemovePostCodeFile()
    {
        newPostCodeSnippet = null;
        newPostCodeFileName = null;
    }
    private async Task SubmitGroupPost()
    {
        if (string.IsNullOrWhiteSpace(newPostText) && string.IsNullOrWhiteSpace(newPostCodeSnippet) && uploadedImageUrls.Count == 0)
        {
            Toast.Warning(Loc["GroupDetail_Val_PostContentRequired"]);
            return;
        }
        isSubmitting = true;
        var images = uploadedImageUrls.Count > 0 ? uploadedImageUrls.ToList() : null;
        var req = new CreatePostRequestModel(
            null,
            newPostText?.Trim() ?? string.Empty,
            images,
            groupId,
            CodeSnippet: newPostCodeSnippet,
            CodeFileName: newPostCodeFileName,
            CodeLanguage: !string.IsNullOrWhiteSpace(newPostCodeSnippet) ? "FILE" : null
        );
        var res = await PostApi.CreatePostAsync(req);
        isSubmitting = false;
        if (res.IsSuccess)
        {
            Toast.Success(Loc["GroupDetail_Toast_PostPublished"]);
            showPostModal = false;
            newPostText = "";
            uploadedImageUrls.Clear();
            newPostCodeSnippet = null;
            newPostCodeFileName = null;
            activeTab = "feed";
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["GroupDetail_Toast_PostCreateFailed"]);
        }
    }
    private async Task SubmitGroupPoll()
    {
        if (string.IsNullOrWhiteSpace(newPollQuestion))
        {
            Toast.Warning(Loc["GroupDetail_Val_PollQuestionRequired"]);
            return;
        }
        var validOptions = pollOptionsList.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Toast.Warning(Loc["GroupDetail_Val_PollOptionsMin"]);
            return;
        }
        DateTime? expiresAt = null;
        var totalMinutes = (pollDurationDays * 24 * 60) + (pollDurationHours * 60) + pollDurationMinutes;
        if (totalMinutes > 0)
        {
            expiresAt = DateTime.UtcNow.AddMinutes(totalMinutes);
        }
        isSubmitting = true;
        var desc = string.IsNullOrWhiteSpace(newPollDescription) ? newPollQuestion : newPollDescription;
        var req = new CreatePollRequestModel(null, desc, newPollQuestion, pollIsMultipleChoice, expiresAt, validOptions, groupId);
        var res = await PollApi.CreatePollAsync(req);
        isSubmitting = false;
        if (res.IsSuccess)
        {
            Toast.Success(Loc["GroupDetail_Toast_PollCreated"]);
            showPollModal = false;
            activeTab = "polls";
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["GroupDetail_Toast_PollCreateFailed"]);
        }
    }
