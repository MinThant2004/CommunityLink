@page "/group/{groupId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@inject GroupApiService GroupApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject RoleAndPermissionApiService RoleApi
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment

<PageTitle>@(group?.Name ?? "Group Detail") - CommunityLink</PageTitle>

<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Back to Groups Link -->
    <div class="flex items-center justify-between">
        <a href="/groups" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span>Back to Groups Directory</span>
        </a>
    </div>

    @if (isLoadingGroup)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
        </div>
    }
    else if (group == null)
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="text-4xl mb-3">🔍</div>
            <h3 class="text-base font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">Group not found</h3>
            <p class="text-sm mt-1">This group may have been removed or does not exist.</p>
        </div>
    }
    else
    {
        <!-- Group Hero Header Banner -->
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden transition-colors duration-150">
            <div class="h-28 sm:h-36 bg-gradient-to-r from-[#F1F5F9] via-[#E2E8F0] to-[#F8FAFC] dark:from-[#1B3B5A] dark:via-[#112A46] dark:to-[#0A1B2E] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] relative p-4">
                <div class="absolute -bottom-6 left-6">
                    @if (!string.IsNullOrEmpty(group.AvatarUrl))
                    {
                        <img src="@group.AvatarUrl" alt="@group.Name" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-4 border-white dark:border-[#112A46] shadow-lg bg-[#F1F5F9] dark:bg-[#1B3B5A]" />
                    }
                    else
                    {
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[#F1F5F9] dark:bg-[#1B3B5A] border-4 border-white dark:border-[#112A46] shadow-lg flex items-center justify-center font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-2xl">
                            @(string.IsNullOrWhiteSpace(group.Name) ? "G" : group.Name.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>
            </div>

            <div class="p-6 pt-8 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h1 class="text-xl sm:text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">@group.Name</h1>
                            @if (group.Visibility == "PRIVATE")
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50">
                                    🔒 Private Group
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50">
                                    🔓 Public Group
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(group.SubCommunityName))
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] mt-1">
                                📁 Part of @group.SubCommunityName
                            </span>
                        }

                        <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-2 leading-relaxed">@group.Description</p>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="LeaveGroup"
                                    class="px-4 py-2 bg-white dark:bg-[#1B3B5A] hover:bg-rose-50 dark:hover:bg-rose-950/40 text-[#557392] dark:text-[#C4D2E1] hover:text-rose-600 dark:hover:text-rose-400 font-semibold text-xs rounded-xl transition border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                Leave Group
                            </button>
                        }
                        else if (group.UserJoinStatus == "PENDING")
                        {
                            <span class="px-4 py-2 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50 text-xs font-semibold rounded-xl">
                                ⏳ Join Requested
                            </span>
                        }
                        else
                        {
                            <button type="button" @onclick="JoinGroup"
                                    class="px-5 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs rounded-xl shadow-sm transition">
                                @(group.Visibility == "PRIVATE" ? "Request to Join" : "Join Group")
                            </button>
                        }
                    </div>
                </div>

                <!-- Stats Bar & Actions -->
                <div class="pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4 text-xs font-medium text-[#557392] dark:text-[#C4D2E1]">
                        <span>👥 @group.MemberCount members</span>
                        <span>•</span>
                        <span>📝 @group.PostCount posts</span>
                        <span>•</span>
                        <span class="inline-flex items-center gap-1 text-amber-600">
                            <span>⭐</span>
                            <span>@(group.AverageRating.HasValue ? group.AverageRating.Value.ToString("0.0") : "No ratings")</span>
                            <span class="text-slate-400">(@(group.RatingCount))</span>
                        </span>
                        <span>•</span>
                        <span>Created by @group.CreatorName</span>
                    </div>

                    @if (group.IsJoined)
                    {
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="OpenCreatePostModal"
                                    class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs rounded-xl shadow-sm transition inline-flex items-center gap-1.5 active:scale-95">
                                <span>✍️</span>
                                <span>Upload Group Post</span>
                            </button>
                            <button type="button" @onclick="OpenCreatePollModal"
                                    class="px-4 py-2 bg-white dark:bg-[#1B3B5A] hover:bg-[#F1F5F9] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold text-xs rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] shadow-sm transition inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
                                <span>📊</span>
                                <span>Upload Group Poll</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (group.Visibility == "PRIVATE" && !group.IsJoined)
        {
            <!-- PRIVATE GROUP LOCK BANNER -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-amber-300 dark:border-amber-500/30 p-12 text-center shadow-sm">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 flex items-center justify-center text-3xl text-amber-500">
                    🔒
                </div>
                <h2 class="text-lg font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">This group is private</h2>
                <p class="text-sm text-[#557392] dark:text-[#C4D2E1] max-w-md mx-auto mt-2">
                    Posts, polls, discussions, and member activity in this group are reserved for approved members only.
                </p>
                <div class="mt-6">
                    @if (group.UserJoinStatus == "PENDING")
                    {
                        <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 font-semibold text-sm rounded-xl border border-amber-200 dark:border-amber-900/50">
                            ⏳ Join Request Pending Approval
                        </span>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-sm rounded-xl shadow-sm transition">
                            <span>Request to Join Group</span>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Navigation Tabs: Feed, Polls, Members -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-2 flex items-center gap-2">
                <button type="button" @onclick='() => SetActiveTab("feed")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "feed" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    📝 Feed (@(posts?.Count ?? 0))
                </button>
                <button type="button" @onclick='() => SetActiveTab("polls")'
                        style="@(activeTab == "polls" ? "background-color: #7c3aed; color: #ffffff !important;" : "")"
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "polls" ? "bg-purple-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    📊 Polls (@(polls?.Count ?? 0))
                </button>
                <button type="button" @onclick='() => SetActiveTab("members")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "members" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    👥 Members (@(members?.Count ?? 0))
                </button>
                <button type="button" @onclick='() => SetActiveTab("ratings")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "ratings" ? "bg-amber-500 text-slate-950 shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    ⭐ Ratings (@(ratingSummary?.TotalRatings ?? group?.RatingCount ?? 0))
                </button>
            </div>

            <!-- Contextual Quick Action Header for Active Tab -->
            @if (activeTab == "polls")
            {
                <div class="flex items-center justify-between bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 shadow-sm">
                    <div>
                        <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Group Polls</h3>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Vote on active polls or start a new survey for this group.</p>
                    </div>
                    @if (group.IsJoined)
                    {
                        <button type="button" @onclick="OpenCreatePollModal"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition active:scale-95 cursor-pointer">
                            <span>📊</span>
                            <span>Upload Group Poll</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold text-xs rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] transition">
                            <span>Join group to create polls</span>
                        </button>
                    }
                </div>
            }
            else if (activeTab == "feed")
            {
                <div class="flex items-center justify-between bg-white dark:bg-[#112A46] rounded-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 shadow-sm">
                    <div>
                        <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Group Discussion</h3>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">Stay updated and connect with other members in this group.</p>
                    </div>
                    @if (group.IsJoined && canCreatePost)
                    {
                        <button type="button" @onclick="OpenCreatePostModal"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition active:scale-95">
                            <span>✍️ Create Post</span>
                        </button>
                    }
                    else if (!group.IsJoined)
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#F1F5F9] dark:bg-[#1B3B5A] hover:bg-[#E2E8F0] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold text-xs rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] transition">
                            <span>Join group to post</span>
                        </button>
                    }
                </div>
            }

            <!-- TAB 1: GROUP FEED -->
            @if (activeTab == "feed")
            {
                @if (isLoadingFeed)
                {
                    <div class="flex justify-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                    </div>
                }
                else if (posts == null || posts.Count == 0)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
                        <div class="text-4xl mb-3">✍️</div>
                        <h4 class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] text-base" style="font-family:'Manrope',sans-serif">No group posts yet</h4>
                        <p class="text-xs text-[#7A8CA6] mt-1 max-w-sm mx-auto">
                            @(group.IsJoined ? "Start the conversation by sharing the first post in this group!" : "Join this group to share the first post.")
                        </p>
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="OpenCreatePostModal" class="mt-4 px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-semibold rounded-xl shadow transition">
                                Create Post Now
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var post in posts)
                        {
                            <div id="post-@post.PostId" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition hover:shadow-md">
                                <!-- Post Author Header -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(post.AuthorAvatar))
                                        {
                                            <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-10 h-10 rounded-full object-cover border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold text-sm">
                                                @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <h4 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] leading-tight" style="font-family:'Manrope',sans-serif">@post.AuthorName</h4>
                                            <span class="text-[11px] text-[#7A8CA6] font-mono">@post.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                    </div>

                                    <div class="relative">
                                        <button type="button" @onclick="() => TogglePostMenu(post.PostId)"
                                                class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition cursor-pointer" title="Options">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
                                            </svg>
                                        </button>

                                        @if (activeMenuPostId == post.PostId)
                                        {
                                            <div class="absolute right-0 mt-1 w-44 bg-white rounded-xl shadow-lg border border-slate-200 py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                                                <!-- Save Button (For all users) -->
                                                <button type="button" @onclick="() => ToggleSavePost(post.PostId)"
                                                        class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                    <span>🔖</span>
                                                    <span>@(post.IsSavedByCurrentUser ? "Unsave Post" : "Save Post")</span>
                                                </button>

                                                <!-- Edit & Delete (Author only) -->
                                                @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                                {
                                                    <button type="button" @onclick="() => OpenEditPost(post)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                        <span>✏️</span>
                                                        <span>Edit Description</span>
                                                    </button>
                                                    <div class="border-t border-slate-100 my-1"></div>
                                                    <button type="button" @onclick="() => ConfirmDeletePost(post.PostId)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition cursor-pointer">
                                                        <span>🗑️</span>
                                                        <span>Delete Post</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Post Text Content -->
                                <div class="px-5 py-4 text-sm text-[#0A1B2E] dark:text-[#E1E8F0] leading-relaxed whitespace-pre-line">
                                    @post.Content
                                </div>

                                <!-- Post Images -->
                                @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                                {
                                    <div class="bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center max-h-96 overflow-hidden border-t border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                        <img src="@post.ImageUrls[0]" alt="Post attachment" class="max-h-96 object-contain w-full" />
                                    </div>
                                }

                                <!-- Actions: Like, Comment, Share -->
                                <div class="px-4 py-2 flex items-center justify-between text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] bg-[#F8FAFC]/50 dark:bg-[#0A1B2E]/50 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <!-- Like -->
                                    <button type="button" @onclick="() => ToggleLike(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(post.IsLikedByCurrentUser ? "text-rose-500 font-semibold" : "")">
                                        <svg class="w-4 h-4 @(post.IsLikedByCurrentUser ? "fill-rose-500 stroke-rose-500" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                        </svg>
                                        <span>Like</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-mono">@post.LikeCount</span>
                                    </button>

                                    <!-- Comment -->
                                    <button type="button" @onclick="() => ToggleCommentBox(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(openCommentPostIds.Contains(post.PostId) ? "text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold" : "")">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                        </svg>
                                        <span>Comment</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-mono">@post.CommentCount</span>
                                    </button>

                                    <!-- Share -->
                                    <button type="button" @onclick="() => OpenShareModal(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A]">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                        </svg>
                                        <span>Share</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-mono">@post.ShareCount</span>
                                    </button>
                                </div>

                                <!-- Comments Drawer -->
                                @if (openCommentPostIds.Contains(post.PostId))
                                {
                                    <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E] space-y-4">
                                        <!-- Add Comment -->
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                                                💬
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[post.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(post.PostId); })"
                                                       placeholder="Write a comment..."
                                                       class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20" />
                                                <button type="button" @onclick="() => SubmitComment(post.PostId)"
                                                        class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold shadow transition">
                                                    Post
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Comments List -->
                                        @if (commentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#7A8CA6] text-center py-2">No comments yet. Be the first to comment!</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@comment.AuthorName</span>
                                                                    <span class="text-[10px] text-[#7A8CA6] font-mono">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                                </div>
                                                                <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }                <!-- TAB 2: LIVE POLLS -->
            @if (activeTab == "polls")
            {
                @if (polls == null || polls.Count == 0)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] p-12 text-center text-[#557392] dark:text-[#7A8CA6]">
                        <div class="text-4xl mb-3">📊</div>
                        <h4 class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] text-base">No live polls in this group</h4>
                        <p class="text-xs text-[#557392] dark:text-[#7A8CA6] mt-1 max-w-sm mx-auto">
                            @(group.IsJoined ? "Launch a poll to gather feedback or opinions from fellow members." : "Join this group to participate in or create polls.")
                        </p>
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="OpenCreatePollModal"
                                    class="mt-4 px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-semibold rounded shadow-sm transition inline-flex items-center gap-1.5 cursor-pointer">
                                <span>📊</span>
                                <span>Upload Group Poll</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var poll in polls)
                        {
                            <div id="poll-@poll.PollId" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden transition hover:shadow-md">
                                <!-- Poll Author Info -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold text-sm">
                                            @(string.IsNullOrWhiteSpace(poll.AuthorName) ? "U" : poll.AuthorName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] leading-tight">@poll.AuthorName</h4>
                                            <span class="text-[11px] text-[#557392] dark:text-[#7A8CA6]">@poll.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        @if (poll.ExpiresAt.HasValue)
                                        {
                                            <span class="text-xs px-2.5 py-1 rounded-full @(poll.IsExpired ? "bg-rose-50 text-rose-600 border border-rose-100" : "bg-emerald-50 text-emerald-700 border border-emerald-100")">
                                                @(poll.IsExpired ? "Closed" : $"Ends {poll.ExpiresAt.Value.ToLocalTime():g}")
                                            </span>
                                        }

                                        <!-- Three-Dots Action Menu for Poll -->
                                        <div class="relative">
                                            <button type="button" @onclick="() => TogglePollMenu(poll.PollId)"
                                                    class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition cursor-pointer" title="Options">
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
                                                </svg>
                                            </button>

                                            @if (activeMenuPollId == poll.PollId)
                                            {
                                                <div class="absolute right-0 mt-1 w-44 bg-white rounded-xl shadow-lg border border-slate-200 py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                                                    <!-- Save Button (All users) -->
                                                    <button type="button" @onclick="() => ToggleSavePoll(poll.PostId)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                        <span>🔖</span>
                                                        <span>Save Poll</span>
                                                    </button>

                                                    <!-- Edit & Delete (Author only) -->
                                                    @if (currentUserId.HasValue && poll.AuthorId == currentUserId.Value)
                                                    {
                                                        <button type="button" @onclick="() => OpenEditPoll(poll)"
                                                                class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                            <span>✏️</span>
                                                            <span>Edit Poll</span>
                                                        </button>
                                                        <div class="border-t border-slate-100 my-1"></div>
                                                        <button type="button" @onclick="() => DeletePoll(poll.PollId)"
                                                                class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition cursor-pointer">
                                                            <span>🗑️</span>
                                                            <span>Delete Poll</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Poll Content & Question -->
                                <div class="px-5 pt-4 pb-2 space-y-2">
                                    <h3 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] leading-snug">@poll.Question</h3>
                                    @if (!string.IsNullOrWhiteSpace(poll.Content) && poll.Content != poll.Question)
                                    {
                                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line leading-relaxed">@poll.Content</p>
                                    }
                                </div>

                                <!-- Poll Options & Voting -->
                                <div class="px-5 py-4 space-y-3">
                                    @foreach (var opt in poll.Options)
                                    {
                                        var hasUserVotedThis = opt.IsVotedByCurrentUser;
                                        <div class="relative overflow-hidden rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] p-3 transition hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.25)]">
                                            <!-- Progress bar background -->
                                            <div class="absolute inset-y-0 left-0 bg-[#E2E8F0] dark:bg-[#1B3B5A] transition-all duration-500"
                                                 style="width: @(opt.Percentage)%"></div>

                                            <div class="relative flex items-center justify-between gap-3 text-xs sm:text-sm">
                                                <div class="flex items-center gap-2.5 flex-1">
                                                    @if (!poll.HasVoted && !poll.IsExpired)
                                                    {
                                                        <button type="button" @onclick="() => Vote(poll.PollId, opt.OptionId)"
                                                                class="w-5 h-5 rounded-full border-2 border-[#557392] dark:border-[#C4D2E1] hover:border-[#0A1B2E] dark:hover:border-white transition flex items-center justify-center shrink-0">
                                                            <div class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-white opacity-0 hover:opacity-100"></div>
                                                        </button>
                                                    }
                                                    else if (hasUserVotedThis)
                                                    {
                                                        <div class="w-5 h-5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] flex items-center justify-center text-xs shrink-0 font-bold">
                                                            ✓
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="w-5 h-5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] shrink-0"></div>
                                                    }
                                                    <span class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0] @(hasUserVotedThis ? "font-bold" : "")">
                                                        @opt.Text
                                                    </span>
                                                </div>
                                                <div class="text-right shrink-0">
                                                    <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@opt.Percentage%</span>
                                                    <span class="text-[11px] text-[#557392] dark:text-[#7A8CA6] ml-1">(@opt.VoteCount)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Poll Summary Footer -->
                                <div class="px-5 py-2.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between text-xs text-[#557392] dark:text-[#7A8CA6]">
                                    <div class="flex items-center gap-2">
                                        <span>👥 @poll.TotalVotes total votes</span>
                                        <span>•</span>
                                        <span>@(poll.IsMultipleChoice ? "Multiple votes allowed" : "Single choice")</span>
                                    </div>
                                    @if (poll.HasVoted)
                                    {
                                        <span class="text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold flex items-center gap-1">
                                            <span>✓</span> You voted
                                        </span>
                                    }
                                    else if (poll.IsExpired)
                                    {
                                        <span class="text-rose-600 dark:text-rose-400 font-medium">Voting ended</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#557392] dark:text-[#C4D2E1] font-medium">Click an option to vote</span>
                                    }
                                </div>

                                <!-- Actions: Like, Comment, Share on Poll -->
                                <div class="px-4 py-2 flex items-center justify-between text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] bg-white dark:bg-[#112A46] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                    <button type="button" @onclick="() => ToggleLike(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(poll.IsLikedByCurrentUser ? "text-red-500 font-semibold" : "")">
                                        <svg class="w-4 h-4 @(poll.IsLikedByCurrentUser ? "fill-red-500 stroke-red-500" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                        </svg>
                                        <span>Like</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#0A1B2E] text-[#557392] dark:text-[#C4D2E1]">@poll.LikeCount</span>
                                    </button>

                                    <button type="button" @onclick="() => ToggleCommentBox(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] @(openCommentPostIds.Contains(poll.PostId) ? "text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold" : "")">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                        </svg>
                                        <span>Comment</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#0A1B2E] text-[#557392] dark:text-[#C4D2E1]">@poll.CommentCount</span>
                                    </button>

                                    <button type="button" @onclick="() => OpenShareModal(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded transition hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A]">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                        </svg>
                                        <span>Share</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded bg-[#F1F5F9] dark:bg-[#0A1B2E] text-[#557392] dark:text-[#C4D2E1]">@poll.ShareCount</span>
                                    </button>
                                </div>

                                <!-- Poll Comments Drawer -->
                                @if (openCommentPostIds.Contains(poll.PostId))
                                {
                                    <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E] space-y-4">
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                                                💬
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[poll.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(poll.PostId); })"
                                                       placeholder="Comment on this poll..."
                                                       class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                                <button type="button" @onclick="() => SubmitComment(poll.PostId)"
                                                        class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded text-xs font-semibold shadow-sm transition">
                                                    Post
                                                </button>
                                            </div>
                                        </div>

                                        @if (commentsByPost.TryGetValue(poll.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#557392] dark:text-[#7A8CA6] text-center py-2">No comments yet.</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@comment.AuthorName</span>
                                                                    <span class="text-[10px] text-[#557392] dark:text-[#7A8CA6]">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                                </div>
                                                                <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 3: MEMBERS -->
            @if (activeTab == "members")
            {
                @if (members == null || members.Count == 0)
                {
                    <p class="text-xs text-[#557392] dark:text-[#7A8CA6] text-center py-6">No members listed.</p>
                }
                else
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.08)]">
                        @foreach (var m in members)
                        {
                            <div class="p-3.5 flex items-center justify-between text-xs hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/30 transition">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center font-bold">
                                        @(string.IsNullOrWhiteSpace(m.DisplayName) ? "U" : m.DisplayName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@m.DisplayName</span>
                                        <span class="text-[10px] text-[#557392] dark:text-[#7A8CA6] block">@@@m.UserName</span>
                                    </div>
                                </div>
                                <span class="px-2.5 py-0.5 rounded text-[10px] font-bold @(m.Role == "Owner" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E]" : (m.Role == "Admin" ? "bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)]" : "bg-[#F8FAFC] dark:bg-[#0A1B2E] text-[#557392] dark:text-[#7A8CA6] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]"))">
                                    @m.Role
                                </span>
                            </div>
                        }
                    </div>
                }
            }
            <!-- TAB 4: GROUP RATINGS & REVIEWS -->
            else if (activeTab == "ratings")
            {
                <div class="space-y-6">
                    <!-- Rating Header Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6">
                            <div class="flex items-center gap-5">
                                <div class="w-20 h-20 rounded-2xl bg-amber-50 border border-amber-200 flex flex-col items-center justify-center text-amber-500 shadow-xs">
                                    <span class="text-3xl font-black text-amber-600">
                                        @(ratingSummary != null && ratingSummary.TotalRatings > 0 ? ratingSummary.AverageScore.ToString("0.0") : "—")
                                    </span>
                                    <div class="flex text-xs text-amber-400 mt-0.5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span>@(ratingSummary != null && ratingSummary.TotalRatings > 0 && i <= Math.Round(ratingSummary.AverageScore) ? "★" : "☆")</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-slate-900">Group Ratings & Reviews</h3>
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        @(ratingSummary != null && ratingSummary.TotalRatings > 0 
                                            ? $"Based on {ratingSummary.TotalRatings} member review{(ratingSummary.TotalRatings > 1 ? "s" : "")}."
                                            : "No member ratings yet. Be the first member to review this group!")
                                    </p>
                                </div>
                            </div>

                            @if (group.IsJoined)
                            {
                                <button type="button" @onclick="OpenRatingModal"
                                        class="px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-amber-500/20 transition active:scale-95 inline-flex items-center gap-2 cursor-pointer">
                                    <span>⭐</span>
                                    <span>@(ratingSummary?.UserRating != null ? "Edit Your Review" : "Rate This Group")</span>
                                </button>
                            }
                        </div>

                        @if (!group.IsJoined)
                        {
                            <div class="mt-4 p-3.5 bg-amber-50/70 border border-amber-200 rounded-xl flex items-center justify-between gap-3 text-xs text-amber-800">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🔒</span>
                                    <span>Only approved group members can rate and review this group. You can still view all reviews below.</span>
                                </div>
                                <button type="button" @onclick="JoinGroup" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg shrink-0 transition">
                                    Join Group
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Reviews List -->
                    @if (isLoadingRatings)
                    {
                        <div class="flex justify-center py-12">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-amber-500"></div>
                        </div>
                    }
                    else if (ratingSummary == null || ratingSummary.Ratings.Count == 0)
                    {
                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500">
                            <div class="text-4xl mb-3">⭐</div>
                            <h4 class="font-semibold text-slate-800 text-base">No reviews yet</h4>
                            <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
                                @(group.IsJoined ? "Share your rating and feedback to help others know what this group is about." : "Members have not reviewed this group yet.")
                            </p>
                            @if (group.IsJoined)
                            {
                                <button type="button" @onclick="OpenRatingModal" class="mt-4 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl shadow transition">
                                    Write the First Review
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var review in ratingSummary.Ratings)
                            {
                                var isMyReview = currentUserId.HasValue && review.UserId == currentUserId.Value;
                                <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs transition hover:border-slate-300 @(isMyReview ? "ring-2 ring-amber-400/40" : "")">
                                    <div class="flex items-start justify-between gap-4">
                                        <!-- Reviewer Profile Info (Clickable link to user profile) -->
                                        <div class="flex items-center gap-3">
                                            <a href="u/@review.UserName" class="shrink-0 group">
                                                @if (!string.IsNullOrEmpty(review.UserAvatar))
                                                {
                                                    <img src="@review.UserAvatar" alt="@review.DisplayName" class="w-10 h-10 rounded-xl object-cover ring-2 ring-slate-100 group-hover:ring-indigo-400 transition" />
                                                }
                                                else
                                                {
                                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white font-bold text-sm flex items-center justify-center ring-2 ring-slate-100 group-hover:ring-indigo-400 transition">
                                                        @(string.IsNullOrWhiteSpace(review.DisplayName) ? "U" : review.DisplayName.Substring(0, 1).ToUpper())
                                                    </div>
                                                }
                                            </a>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <a href="u/@review.UserName" class="font-bold text-sm text-slate-900 hover:text-indigo-600 transition">
                                                        @review.DisplayName
                                                    </a>
                                                    @if (isMyReview)
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                                            Your review
                                                        </span>
                                                    }
                                                </div>
                                                <a href="u/@review.UserName" class="text-[11px] text-slate-400 hover:text-slate-600 transition block">
                                                    @@@review.UserName
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Stars and Date -->
                                        <div class="text-right">
                                            <div class="flex items-center justify-end text-amber-400 text-sm">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <span class="@(s <= review.Score ? "text-amber-400" : "text-slate-200")">★</span>
                                                }
                                                <span class="ml-1 text-xs font-black text-slate-800">@review.Score.0</span>
                                            </div>
                                            <span class="text-[11px] text-slate-400 block mt-0.5">
                                                @FormatTimeAgo(review.CreatedAt)
                                                @(review.UpdatedAt.HasValue ? " (edited)" : "")
                                            </span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                    {
                                        <p class="text-sm text-slate-700 mt-3 pl-13 leading-relaxed whitespace-pre-line">
                                            @review.ReviewText
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>

<!-- ================= MODAL: CREATE GROUP POST ================= -->
@if (showPostModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">✍️</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">Post to @group?.Name</h3>
                </div>
                <button type="button" @onclick="() => showPostModal = false" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white">✕</button>
            </div>
            <div class="p-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">What's on your mind? *</label>
                    <textarea @bind="newPostText" rows="4" placeholder="Share thoughts, news, or questions with the group..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded p-3 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>

                <!-- Image Attachment -->
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Attach Image (Optional)</label>
                    @if (string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="relative border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded p-4 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E]">
                            <InputFile OnChange="HandleFileSelected" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                            @if (isUploadingImage)
                            {
                                <div class="flex items-center justify-center gap-2 text-xs text-[#0A1B2E] dark:text-[#E1E8F0] font-medium">
                                    <span class="animate-spin">⏳</span> Uploading image...
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center">
                                    <span class="text-xl mb-1">🖼️</span>
                                    <span class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">Click to upload an image</span>
                                    <span class="text-[10px] text-[#557392] dark:text-[#7A8CA6]">PNG, JPG, WebP up to 10MB</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="modal-image-preview-container relative rounded-xl overflow-hidden border border-slate-200 bg-slate-950 flex items-center justify-center" style="height: 140px; max-height: 140px; width: 100%;">
                            <img src="@uploadedImageUrl" alt="Preview" class="modal-image-preview-img object-contain" style="max-height: 140px; max-width: 100%; height: auto; width: auto; display: block; margin: 0 auto;" />
                            <button type="button" @onclick="() => uploadedImageUrl = null"
                                    class="absolute top-2 right-2 bg-rose-600 hover:bg-rose-700 text-white rounded-full p-1.5 shadow transition text-xs font-bold" title="Remove image">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2">
                <button type="button" @onclick="() => showPostModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded transition">Cancel</button>
                <button type="button" @onclick="SubmitGroupPost" disabled="@(isSubmitting || isUploadingImage)" class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded shadow-sm transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span>Publish Post</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: CREATE GROUP POLL ================= -->
@if (showPollModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">📊</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">Create Poll in @group?.Name</h3>
                </div>
                <button type="button" @onclick="() => showPollModal = false" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white">✕</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Question *</label>
                    <input type="text" @bind="newPollQuestion" placeholder="e.g. Which project should we prioritize next?"
                           class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Details / Context (Optional)</label>
                    <textarea @bind="newPollDescription" rows="2" placeholder="Add extra details or guidelines for voters..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded p-2.5 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>

                <!-- Custom Duration Picker -->
                <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] space-y-2">
                    <span class="block text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">Poll Duration</span>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Days</label>
                            <input type="number" min="0" max="365" @bind="pollDurationDays"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Hours</label>
                            <input type="number" min="0" max="23" @bind="pollDurationHours"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">Minutes</label>
                            <input type="number" min="0" max="59" @bind="pollDurationMinutes"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- Dynamic Poll Options -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Poll Options * (Min 2, Max 10)</label>
                        @if (pollOptionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddPollOption" class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline">
                                + Add Option
                            </button>
                        }
                    </div>

                    <div class="space-y-2">
                        @for (int i = 0; i < pollOptionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold text-xs flex items-center justify-center shrink-0 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       value="@pollOptionsList[index]"
                                       @onchange="(e) => pollOptionsList[index] = e.Value?.ToString() ?? string.Empty"
                                       placeholder="@($"Option {labelChar}")"
                                       class="flex-1 text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                @if (pollOptionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemovePollOption(index)" class="p-1.5 text-[#557392] dark:text-[#7A8CA6] hover:text-rose-500 transition" title="Remove option">
                                        ✕
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Multiple Choice Toggle -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="grpMultiChoice" @bind="pollIsMultipleChoice" class="rounded text-[#0A1B2E] dark:text-[#E1E8F0] focus:ring-[#0A1B2E] bg-white dark:bg-[#0A1B2E] border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)]" />
                    <label for="grpMultiChoice" class="text-xs font-medium text-[#557392] dark:text-[#C4D2E1] cursor-pointer">Allow voters to select multiple choices</label>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-end gap-2">
                <button type="button" @onclick="() => showPollModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitGroupPoll" disabled="@isSubmitting"
                        class="px-5 py-2.5 text-xs font-bold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin text-sm">⏳</span>
                        <span>Creating Poll...</span>
                    }
                    else
                    {
                        <span class="text-sm">📊</span>
                        <span>Publish Group Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: SHARE POST / POLL ================= -->
@if (showShareModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-md overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🚀</span>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">Share to Your Network</h3>
                </div>
                <button type="button" @onclick="() => showShareModal = false" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white">✕</button>
            </div>
            <div class="p-5 space-y-3">
                <p class="text-xs text-[#557392] dark:text-[#7A8CA6]">Share this group update with other members. You can optionally add a note with your thoughts.</p>
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">Share Note <span class="text-[#557392] dark:text-[#7A8CA6] font-normal">(Optional)</span></label>
                    <textarea @bind="shareNoteText" rows="3" placeholder="Add your perspective (optional)..."
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded p-3 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2">
                <button type="button" @onclick="() => showShareModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded transition">Cancel</button>
                <button type="button" @onclick="SubmitShare" disabled="@isSubmitting" class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded shadow-sm transition disabled:opacity-50">
                    Share Now
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: EDIT POST ================= -->
@if (showEditPostModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                    <span>✏️</span> Edit Post Description
                </h3>
                <button type="button" @onclick="() => showEditPostModal = false" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-500">Post Description / Content</label>
                <textarea @bind="editingPostContent" rows="5" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none resize-none transition" placeholder="Update your post description..."></textarea>
                <p class="text-[11px] text-slate-400">Note: Post images cannot be modified.</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button type="button" @onclick="() => showEditPostModal = false" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SaveEditPostAsync" disabled="@(isSavingEditPost || string.IsNullOrWhiteSpace(editingPostContent))" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-xs font-bold rounded-xl transition shadow-md shadow-indigo-600/20 flex items-center gap-2 cursor-pointer">
                    @if (isSavingEditPost)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: EDIT POLL ================= -->
@if (showEditPollModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                    <span>✏️</span> Edit Poll
                </h3>
                <button type="button" @onclick="() => showEditPollModal = false" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Poll Question <span class="text-rose-500">*</span></label>
                    <input type="text" @bind="editingPollQuestion" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Description <span class="text-slate-400 font-normal">(Optional)</span></label>
                    <textarea @bind="editingPollContent" rows="3" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none resize-none transition" placeholder="Add additional context for voters..."></textarea>
                </div>
                <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-500 flex items-center gap-2">
                    <span>ℹ️</span>
                    <span>Options and existing votes cannot be modified to maintain voting integrity.</span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button type="button" @onclick="() => showEditPollModal = false" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SaveEditPollAsync" disabled="@(isSavingEditPoll || string.IsNullOrWhiteSpace(editingPollQuestion))" class="px-5 py-2 bg-purple-600 hover:bg-purple-700 disabled:opacity-50 text-white text-xs font-bold rounded-xl transition shadow-md shadow-purple-600/20 flex items-center gap-2 cursor-pointer">
                    @if (isSavingEditPoll)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: RATE / REVIEW GROUP ================= -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150 p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                    <span class="text-xl">⭐</span>
                    <h3 class="font-bold text-base text-slate-900">
                        @(ratingSummary?.UserRating != null ? "Edit Your Review" : "Rate This Group")
                    </h3>
                </div>
                <button type="button" @onclick="CloseRatingModal" class="text-slate-400 hover:text-slate-600 cursor-pointer">✕</button>
            </div>

            <div class="text-center space-y-3">
                <p class="text-xs text-slate-500">Tap a star to rate your experience in <strong class="text-slate-700">@group?.Name</strong></p>
                
                <!-- Interactive Star Selector -->
                <div class="flex items-center justify-center gap-2 text-3xl py-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starScore = i;
                        <button type="button" @onclick="() => selectedRatingScore = starScore" class="transition-transform hover:scale-125 cursor-pointer focus:outline-none">
                            <span class="@(starScore <= selectedRatingScore ? "text-amber-400" : "text-slate-200")">★</span>
                        </button>
                    }
                </div>
                <div class="text-xs font-bold text-amber-600 uppercase tracking-wider">
                    @selectedRatingScore Star@(selectedRatingScore > 1 ? "s" : "")
                </div>

                <div class="text-left mt-2">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Review / Comments</label>
                    <textarea @bind="ratingReviewText" rows="3" maxlength="1000" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition" placeholder="Tell other members what you think of this group, its topics, and discussions..."></textarea>
                    <div class="text-[11px] text-slate-400 text-right mt-0.5">@(ratingReviewText?.Length ?? 0)/1000</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                    @ratingErrorMessage
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button type="button" @onclick="CloseRatingModal" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-md shadow-amber-500/30 flex items-center gap-2 cursor-pointer">
                    @if (isSubmittingRating)
                    {
                        <span class="animate-spin text-xs">⌛</span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>@(ratingSummary?.UserRating != null ? "Update Review" : "Submit Review")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int groupId { get; set; }

    private GroupModel? group;
    private IReadOnlyList<PostModel>? posts;
    private IReadOnlyList<PollModel>? polls;
    private IReadOnlyList<GroupMemberModel>? members;
    private GroupRatingSummaryDto? ratingSummary;

    private int? currentUserId;
    private bool isLoadingGroup = true;
    private bool isLoadingFeed = true;
    private bool isLoadingRatings = false;
    private bool isSubmitting;
    private string activeTab = "feed";

    // Ratings Modal State
    private bool showRatingModal = false;
    private int selectedRatingScore = 5;
    private string? ratingReviewText = "";
    private bool isSubmittingRating = false;
    private string? ratingErrorMessage = null;

    // Social Interactions
    private HashSet<int> openCommentPostIds = [];
    private Dictionary<int, string> commentInputs = [];
    private Dictionary<int, IReadOnlyList<CommentModel>> commentsByPost = [];

    // Share Modal
    private bool showShareModal;
    private int sharingPostId;
    private string shareNoteText = "";

    // Post Options & Edit Post State
    private int? activeMenuPostId = null;
    private bool showEditPostModal = false;
    private int? editingPostId = null;
    private string editingPostContent = string.Empty;
    private bool isSavingEditPost = false;

    // Poll Options & Edit Poll State
    private int? activeMenuPollId = null;
    private bool showEditPollModal = false;
    private int? editingPollId = null;
    private string editingPollQuestion = string.Empty;
    private string editingPollContent = string.Empty;
    private bool isSavingEditPoll = false;

    // Create Post Modal State
    private bool showPostModal;
    private string newPostText = "";
    private string? uploadedImageUrl;
    private bool isUploadingImage;

    // Create Poll Modal State
    private bool showPollModal;
    private string newPollQuestion = "";
    private string newPollDescription = "";
    private int pollDurationDays = 1;
    private int pollDurationHours = 0;
    private int pollDurationMinutes = 0;
    private bool pollIsMultipleChoice;
    private List<string> pollOptionsList = ["", ""];

    private bool canCreatePost;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        var isAdmin = user.IsInRole("ADMIN") || user.HasClaim("permission", PermissionCatalog.AdminUserView);
        if (isAdmin)
        {
            canCreatePost = true;
        }
        else
        {
            try
            {
                var permRes = await RoleApi.GetMyPermissionsAsync();
                if (permRes.IsSuccess && permRes.Data != null)
                {
                    canCreatePost = permRes.Data.Any(p => p.Equals(PermissionCatalog.PostCreate, StringComparison.OrdinalIgnoreCase));
                }
            }
            catch { }
        }

        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tabVal))
        {
            var tabStr = tabVal.ToString().ToLowerInvariant();
            if (tabStr == "polls" || tabStr == "feed" || tabStr == "members" || tabStr == "ratings")
            {
                activeTab = tabStr;
            }
        }

        await LoadGroupData();
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "ratings" && ratingSummary == null)
        {
            await LoadGroupRatings();
        }
    }

    private async Task LoadGroupData()
    {
        isLoadingGroup = true;
        var res = await GroupApi.GetGroupByIdAsync(groupId);
        if (res.IsSuccess && res.Data != null)
        {
            group = res.Data;
            var tasks = new List<Task> { LoadGroupRatings() };
            if (group.Visibility != "PRIVATE" || group.IsJoined)
            {
                tasks.Add(LoadGroupPosts());
                tasks.Add(LoadGroupPolls());
                tasks.Add(LoadGroupMembers());
            }
            await Task.WhenAll(tasks);
        }
        isLoadingGroup = false;
    }

    private async Task LoadGroupPosts()
    {
        isLoadingFeed = true;
        var res = await PostApi.GetFeedAsync(groupId: groupId);
        if (res.IsSuccess)
        {
            posts = res.Data;
            foreach (var p in posts ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
        isLoadingFeed = false;
    }

    private async Task LoadGroupPolls()
    {
        var res = await PollApi.GetPollsAsync(groupId: groupId);
        if (res.IsSuccess)
        {
            polls = res.Data;
            foreach (var p in polls ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
    }

    private async Task LoadGroupMembers()
    {
        var res = await GroupApi.GetGroupMembersAsync(groupId);
        if (res.IsSuccess) members = res.Data;
    }

    private async Task LoadGroupRatings()
    {
        isLoadingRatings = true;
        var res = await GroupApi.GetGroupRatingsAsync(groupId);
        if (res.IsSuccess)
        {
            ratingSummary = res.Data;
        }
        isLoadingRatings = false;
    }

    private void OpenRatingModal()
    {
        ratingErrorMessage = null;
        if (ratingSummary?.UserRating != null)
        {
            selectedRatingScore = ratingSummary.UserRating.Score;
            ratingReviewText = ratingSummary.UserRating.ReviewText ?? "";
        }
        else
        {
            selectedRatingScore = 5;
            ratingReviewText = "";
        }
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
        ratingErrorMessage = null;
    }

    private async Task SubmitRatingAsync()
    {
        if (selectedRatingScore < 1 || selectedRatingScore > 5)
        {
            ratingErrorMessage = "Please select a rating between 1 and 5 stars.";
            return;
        }

        isSubmittingRating = true;
        ratingErrorMessage = null;

        var req = new SubmitGroupRatingRequestModel(selectedRatingScore, ratingReviewText);
        var res = await GroupApi.RateGroupAsync(groupId, req);
        isSubmittingRating = false;

        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Rating saved!");
            showRatingModal = false;
            await Task.WhenAll(LoadGroupRatings(), LoadGroupData());
        }
        else
        {
            ratingErrorMessage = res.Message ?? "Failed to submit rating.";
        }
    }

    private async Task JoinGroup()
    {
        var res = await GroupApi.JoinGroupAsync(groupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined!");
            await LoadGroupData();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join.");
        }
    }

    private async Task LeaveGroup()
    {
        var res = await GroupApi.LeaveGroupAsync(groupId);
        if (res.IsSuccess)
        {
            Toast.Success("Left group.");
            await LoadGroupData();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to leave.");
        }
    }

    private void OpenCreatePostModal()
    {
        newPostText = "";
        uploadedImageUrl = null;
        showPostModal = true;
    }

    private void OpenCreatePollModal()
    {
        newPollQuestion = "";
        newPollDescription = "";
        pollDurationDays = 1;
        pollDurationHours = 0;
        pollDurationMinutes = 0;
        pollIsMultipleChoice = false;
        pollOptionsList = ["", ""];
        showPollModal = true;
    }

    private void AddPollOption()
    {
        if (pollOptionsList.Count < 10)
        {
            pollOptionsList.Add("");
        }
    }

    private void RemovePollOption(int index)
    {
        if (pollOptionsList.Count > 2 && index >= 0 && index < pollOptionsList.Count)
        {
            pollOptionsList.RemoveAt(index);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedImageUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Image uploaded!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to process image: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task SubmitGroupPost()
    {
        if (string.IsNullOrWhiteSpace(newPostText))
        {
            Toast.Warning("Post content cannot be empty.");
            return;
        }

        isSubmitting = true;
        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };
        var res = await PostApi.CreatePostAsync(new CreatePostRequestModel(null, newPostText, images, groupId));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group post published!");
            showPostModal = false;
            newPostText = "";
            uploadedImageUrl = null;
            activeTab = "feed";
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create post.");
        }
    }

    private async Task SubmitGroupPoll()
    {
        if (string.IsNullOrWhiteSpace(newPollQuestion))
        {
            Toast.Warning("Please specify a poll question.");
            return;
        }

        var validOptions = pollOptionsList.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Toast.Warning("A poll must contain at least 2 non-empty options.");
            return;
        }

        DateTime? expiresAt = null;
        var totalMinutes = (pollDurationDays * 24 * 60) + (pollDurationHours * 60) + pollDurationMinutes;
        if (totalMinutes > 0)
        {
            expiresAt = DateTime.UtcNow.AddMinutes(totalMinutes);
        }

        isSubmitting = true;
        var desc = string.IsNullOrWhiteSpace(newPollDescription) ? newPollQuestion : newPollDescription;
        var req = new CreatePollRequestModel(null, desc, newPollQuestion, pollIsMultipleChoice, expiresAt, validOptions, groupId);

        var res = await PollApi.CreatePollAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group poll created successfully!");
            showPollModal = false;
            activeTab = "polls";
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create poll.");
        }
    }

    // Social Interactions
    private async Task ToggleLike(int postId)
    {
        var res = await PostApi.LikePostAsync(postId);
        if (res.IsSuccess)
        {
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update like.");
        }
    }

    private async Task ToggleCommentBox(int postId)
    {
        if (openCommentPostIds.Contains(postId))
        {
            openCommentPostIds.Remove(postId);
        }
        else
        {
            openCommentPostIds.Add(postId);
            await LoadComments(postId);
        }
    }

    private async Task LoadComments(int postId)
    {
        var res = await PostApi.GetCommentsAsync(postId);
        if (res.IsSuccess && res.Data != null)
        {
            commentsByPost[postId] = res.Data;
        }
    }

    private async Task SubmitComment(int postId)
    {
        if (!commentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var res = await PostApi.AddCommentAsync(new CreateCommentRequestModel(postId, content));
        if (res.IsSuccess)
        {
            commentInputs[postId] = "";
            await LoadComments(postId);
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to post comment.");
        }
    }

    private void OpenShareModal(int postId)
    {
        sharingPostId = postId;
        shareNoteText = "";
        showShareModal = true;
    }

    private async Task SubmitShare()
    {
        isSubmitting = true;
        var res = await PostApi.SharePostAsync(sharingPostId, new SharePostRequestModel(shareNoteText));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Shared successfully!");
            showShareModal = false;
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to share.");
        }
    }

    private async Task Vote(int pollId, int optionId)
    {
        var res = await PollApi.VoteAsync(new VoteRequestModel(pollId, [optionId]));
        if (res.IsSuccess)
        {
            Toast.Success("Vote recorded!");
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to submit vote.");
        }
    }

    private async Task ConfirmDeletePost(int postId)
    {
        activeMenuPostId = null;
        var res = await PostApi.DeletePostAsync(postId);
        if (res.IsSuccess)
        {
            Toast.Success("Post deleted.");
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete post.");
        }
    }

    private void TogglePostMenu(int postId)
    {
        activeMenuPostId = (activeMenuPostId == postId) ? null : postId;
    }

    private async Task ToggleSavePost(int postId)
    {
        activeMenuPostId = null;
        var res = await PostApi.ToggleSavePostAsync(postId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Data ? "Post saved to your profile!" : "Post removed from saved.");
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to save post.");
        }
    }

    private void OpenEditPost(PostModel post)
    {
        activeMenuPostId = null;
        editingPostId = post.PostId;
        editingPostContent = post.Content;
        showEditPostModal = true;
    }

    private async Task SaveEditPostAsync()
    {
        if (!editingPostId.HasValue || string.IsNullOrWhiteSpace(editingPostContent)) return;

        isSavingEditPost = true;
        var res = await PostApi.UpdatePostAsync(editingPostId.Value, new UpdatePostRequestModel(editingPostContent.Trim(), null));
        isSavingEditPost = false;

        if (res.IsSuccess)
        {
            Toast.Success("Post description updated!");
            showEditPostModal = false;
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update post.");
        }
    }

    private void TogglePollMenu(int pollId)
    {
        activeMenuPollId = (activeMenuPollId == pollId) ? null : pollId;
    }

    private async Task ToggleSavePoll(int postId)
    {
        activeMenuPollId = null;
        var res = await PostApi.ToggleSavePostAsync(postId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Data ? "Poll saved to your profile!" : "Poll removed from saved.");
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to save poll.");
        }
    }

    private void OpenEditPoll(PollModel poll)
    {
        activeMenuPollId = null;
        editingPollId = poll.PollId;
        editingPollQuestion = poll.Question;
        editingPollContent = (poll.Content != poll.Question) ? (poll.Content ?? "") : "";
        showEditPollModal = true;
    }

    private async Task SaveEditPollAsync()
    {
        if (!editingPollId.HasValue || string.IsNullOrWhiteSpace(editingPollQuestion)) return;

        isSavingEditPoll = true;
        var res = await PollApi.UpdatePollAsync(editingPollId.Value, new UpdatePollRequestModel(editingPollQuestion.Trim(), string.IsNullOrWhiteSpace(editingPollContent) ? null : editingPollContent.Trim()));
        isSavingEditPoll = false;

        if (res.IsSuccess)
        {
            Toast.Success("Poll updated successfully!");
            showEditPollModal = false;
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update poll.");
        }
    }

    private async Task DeletePoll(int pollId)
    {
        activeMenuPollId = null;
        var res = await PollApi.DeletePollAsync(pollId);
        if (res.IsSuccess)
        {
            Toast.Success("Poll deleted successfully.");
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete poll.");
        }
    }

    private string FormatTimeAgo(DateTime utcDate)
    {
        var span = DateTime.UtcNow - utcDate;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d, yyyy");
    }
}
