<!-- Prerequisite Hierarchy Modal -->
@if (showGroupPrereqModal && groupHierarchyContext != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="relative w-full max-w-lg rounded-2xl bg-white dark:bg-[#112A46] border border-slate-300 dark:border-[rgba(196,210,225,0.20)] shadow-2xl overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-slate-200 dark:border-[rgba(196,210,225,0.12)] bg-slate-50/50 dark:bg-[#0f243c]">
                <div class="flex items-center gap-2.5 text-sky-600 dark:text-sky-400">
                    <span class="material-symbols-outlined text-2xl">account_tree</span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Prerequisites Required</h3>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Hierarchical 3-tier membership check</p>
                    </div>
                </div>
                <button type="button" @onclick="() => showGroupPrereqModal = false" class="text-slate-400 hover:text-slate-700 dark:hover:text-white p-1 rounded-lg transition">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
                <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 space-y-1">
                    <div class="flex items-center gap-1.5 font-bold text-xs">
                        <span class="material-symbols-outlined text-sm">warning</span>
                        <span>Prerequisites Required Before Joining</span>
                    </div>
                    <p class="text-xs leading-relaxed">
                        To participate in <strong>@(group?.Name ?? "this group")</strong>, you must first be a member of its parent Community and Sub-Community.
                    </p>
                </div>

                <!-- Tier 1: Community -->
                <div class="space-y-1">
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Tier 1: Parent Community</span>
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-bold text-slate-900 dark:text-white truncate">@groupHierarchyContext.CommunityName</div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1">@(groupHierarchyContext.CommunityDescription ?? "Parent community hub")</p>
                        </div>
                        @if (groupHierarchyContext.IsCommunityJoined)
                        {
                            <span class="shrink-0 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[11px] font-bold border border-emerald-500/20 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">check</span> Joined
                            </span>
                        }
                        else
                        {
                            <span class="shrink-0 px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[11px] font-bold border border-amber-500/20">
                                Required
                            </span>
                        }
                    </div>
                </div>

                <!-- Tier 2: Sub-Community -->
                <div class="space-y-1">
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Tier 2: Sub-Community</span>
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-bold text-slate-900 dark:text-white truncate">@groupHierarchyContext.SubCommunityName</div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1">@(groupHierarchyContext.SubCommunityDescription ?? "Sub-community sector node")</p>
                        </div>
                        @if (groupHierarchyContext.IsSubCommunityJoined)
                        {
                            <span class="shrink-0 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[11px] font-bold border border-emerald-500/20 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">check</span> Joined
                            </span>
                        }
                        else
                        {
                            <span class="shrink-0 px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[11px] font-bold border border-amber-500/20">
                                Required
                            </span>
                        }
                    </div>
                </div>

                <!-- Tier 3: Target Group -->
                <div class="space-y-1">
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Tier 3: Working Group</span>
                    <div class="p-3 rounded-xl bg-sky-50/60 dark:bg-sky-950/20 border border-sky-200 dark:border-sky-800/40 flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-bold text-slate-900 dark:text-white truncate">@(group?.Name ?? "Target Group")</div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1">@(group?.Description ?? "Target working room")</p>
                        </div>
                        <span class="shrink-0 px-2 py-0.5 rounded-md bg-sky-500/10 text-sky-600 dark:text-sky-400 text-[11px] font-bold border border-sky-500/20">
                            Target Room
                        </span>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 bg-slate-50 dark:bg-[#0A1B2E] border-t border-slate-200 dark:border-[rgba(196,210,225,0.12)] flex flex-wrap items-center justify-end gap-2">
                <button type="button" @onclick="() => showGroupPrereqModal = false"
                        class="px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-200/70 dark:hover:bg-slate-800 rounded-xl border border-slate-300 dark:border-slate-600 transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="() => ExecuteJoinGroupAsync(true)"
                        disabled="@isExecutingGroupJoin"
                        class="px-5 py-2 text-xs font-bold rounded-xl text-white bg-[#0A1B2E] hover:bg-[#153252] dark:bg-white dark:hover:bg-slate-100 dark:text-[#0A1B2E] transition shadow-sm disabled:opacity-50 inline-flex items-center gap-1.5 cursor-pointer border border-[#0A1B2E] dark:border-white">
                    @if (isExecutingGroupJoin)
                    {
                        <span class="animate-spin rounded-full h-3.5 w-3.5 border-2 border-white dark:border-slate-900 border-t-transparent"></span>
                        <span>Enrolling in Tiers...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm">link</span>
                        <span>Join Prerequisites & Enter Group</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

