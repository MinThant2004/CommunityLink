                </div>
            </div>
            <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex justify-end gap-2">
                <button type="button" @onclick="() => showShareModal = false" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-200/50 rounded-xl">Cancel</button>
                <button type="button" @onclick="SubmitShare" disabled="@isSubmitting" class="px-5 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow transition disabled:opacity-50">
                    Share Now
