            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_EditPollQuestionLabel"] <span class="text-rose-500">*</span></label>
                    <input type="text" @bind="editingPollQuestion" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0A1B2E] text-slate-900 dark:text-[#E1E8F0] focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_EditPollDescLabel"] <span class="text-slate-400 dark:text-[#7A8CA6] font-normal">(@Loc["Common_Optional"])</span></label>
                    <textarea @bind="editingPollContent" rows="3" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0A1B2E] text-slate-900 dark:text-[#E1E8F0] focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none resize-none transition" placeholder="@Loc["GroupDetail_Modal_EditPollDescPlaceholder"]"></textarea>
                </div>
                <div class="p-2.5 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-500 dark:text-[#C4D2E1] flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>@Loc["GroupDetail_Modal_EditPollIntegrityNotice"]</span>
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" @onclick="() => showEditPollModal = false" class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SaveEditPollAsync" disabled="@(isSavingEditPoll || string.IsNullOrWhiteSpace(editingPollQuestion))" class="px-5 py-2 bg-purple-600 hover:bg-purple-700 disabled:opacity-50 text-white text-xs font-bold rounded-xl transition shadow-md shadow-purple-600/20 flex items-center gap-2 cursor-pointer">
                    @if (isSavingEditPoll)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["GroupDetail_Modal_Saving"]</span>
                    }
                    else
                    {
                        <span>@Loc["GroupDetail_Modal_SavePollBtn"]</span>
                    }
                </button>
            </div>
        </div>
