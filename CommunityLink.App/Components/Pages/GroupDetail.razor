@page "/group/{groupId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using System.Globalization
@using System.IO
@using System.Text.Json
@inject GroupApiService GroupApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject RoleAndPermissionApiService RoleApi
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment
@inject IStringLocalizer<AppResources> Loc
@inject IJSRuntime JS
<PageTitle>@(group?.Name ?? Loc["GroupDetail_PageTitleFallback"]) - CommunityLink</PageTitle>
<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 space-y-6 text-[#0A1B2E] dark:text-[#E1E8F0] transition-colors duration-150">
    <!-- Back to Groups Link -->
    <div class="flex items-center justify-between">
        <a href="/groups" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span>@Loc["GroupDetail_BackToGroups"]</span>
        </a>
    </div>
    @if (isLoadingGroup)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
        </div>
    }
    else if (group == null)
    {
        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
            <div class="w-12 h-12 rounded-xl bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <h3 class="text-base font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["GroupDetail_NotFound_Title"]</h3>
            <p class="text-sm mt-1">@Loc["GroupDetail_NotFound_Desc"]</p>
        </div>
    }
    else
    {
        <!-- Group Hero Header Banner -->
        <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden transition-colors duration-150">
            <div class="h-44 sm:h-56 relative overflow-hidden bg-[#071321] border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                @{
                    var heroPhoto = !string.IsNullOrWhiteSpace(group.BannerUrl) 
                        ? group.BannerUrl 
                        : (!string.IsNullOrWhiteSpace(group.AvatarUrl) 
                            ? group.AvatarUrl 
                            : "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=80");
                }
                <img src="@heroPhoto" alt="@group.Name" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0A1B2E] via-[#0A1B2E]/60 to-transparent"></div>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h1 class="text-xl sm:text-2xl font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" style="font-family:'Manrope',sans-serif">@group.Name</h1>
                            @if (group.Visibility == "PRIVATE")
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    @Loc["GroupDetail_Badge_PrivateRoom"]
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    @Loc["GroupDetail_Badge_PublicRoom"]
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(group.SubCommunityName))
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#557392] dark:text-[#C4D2E1] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] mt-1.5">
                                <svg class="w-3.5 h-3.5 text-[#D4AF37]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                @(string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_PartOfSubCommunity"], group.SubCommunityName))
                            </span>
                        }
                        <p class="text-xs sm:text-sm text-[#557392] dark:text-[#C4D2E1] mt-2 leading-relaxed">@group.Description</p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" @onclick="OpenReportGroupModal"
                                class="p-2 rounded-xl border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 text-xs font-semibold transition cursor-pointer flex items-center gap-1.5"
                                title="@Loc["GroupDetail_Tooltip_ReportGroup"]">
                            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                            <span class="hidden sm:inline">@Loc["GroupDetail_Action_Report"]</span>
                        </button>
                        @if (group.IsJoined)
                        {
                            @if (!isGroupOwner)
                            {
                                <button type="button" @onclick="OpenLeaveModal"
                                        class="px-4 py-2 bg-white dark:bg-[#1B3B5A] hover:bg-rose-50 dark:hover:bg-rose-950/40 text-[#557392] dark:text-[#C4D2E1] hover:text-rose-600 dark:hover:text-rose-400 font-semibold text-xs rounded-xl transition border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)]">
                                    @Loc["GroupDetail_Action_LeaveGroup"]
                                </button>
                            }
                            else
                            {
                                <span class="px-3.5 py-1.5 bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900/50 text-xs font-semibold rounded-xl inline-flex items-center gap-1.5" title="You are the creator of this group">
                                    <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                    <span>Owner</span>
                                </span>
                            }
                        }
                        else if (group.UserJoinStatus == "PENDING")
                        {
                            <span class="px-4 py-2 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50 text-xs font-semibold rounded-xl inline-flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <span>@Loc["GroupDetail_Status_JoinRequested"]</span>
                            </span>
                        }
                        else
                        {
                            <button type="button" @onclick="JoinGroup"
                                    class="px-5 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs rounded-xl shadow-sm transition">
                                @(group.Visibility == "PRIVATE" ? Loc["GroupDetail_Action_RequestToJoin"] : Loc["GroupDetail_Action_JoinGroup"])
                            </button>
                        }
                    </div>
                </div>
                <!-- Stats Bar & Actions -->
                <div class="pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4 text-xs font-medium text-[#557392] dark:text-[#C4D2E1]">
                        <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Stats_Members"], group.MemberCount)</span>
                        <span>•</span>
                        <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Stats_Posts"], group.PostCount)</span>
                        <span>•</span>
                        <span class="inline-flex items-center gap-1 text-slate-600 dark:text-[#C4D2E1]">
                            <svg class="w-3.5 h-3.5 fill-blue-500 text-blue-500" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                            <span>@(group.AverageRating.HasValue ? group.AverageRating.Value.ToString("0.0") : Loc["GroupDetail_Stats_NoRatings"])</span>
                            <span class="text-slate-400">(@(group.RatingCount))</span>
                        </span>
                    </div>
                    @if (!group.IsActive)
                    {
                        <!-- INACTIVE GROUP BANNER -->
                        <div class="w-full p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 flex items-start gap-3">
                            <svg class="w-5 h-5 shrink-0 text-amber-500 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <div class="text-xs space-y-1">
                                <p class="font-bold">@Loc["GroupDetail_Inactive_Title"]</p>
                                <p class="text-amber-800 dark:text-amber-200">@Loc["GroupDetail_Inactive_Desc"]</p>
                                @if (!string.IsNullOrWhiteSpace(group.ModerationReason))
                                {
                                    <p class="font-mono text-[11px] mt-1 bg-amber-500/15 p-2 rounded-lg">@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Inactive_Reason"], group.ModerationReason)</p>
                                }
                            </div>
                        </div>
                    }
                    @if (group.IsJoined)
                    {
                        <div class="flex items-center gap-2 flex-wrap">
                            @if (group.IsActive)
                            {
                                <button type="button" @onclick="OpenCreatePostModal"
                                        class="px-4 py-2 bg-white dark:bg-[#1B3B5A] hover:bg-[#F1F5F9] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold text-xs rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] shadow-sm transition inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                    <span>@Loc["GroupDetail_Btn_UploadPost"]</span>
                                </button>
                                <button type="button" @onclick="OpenCreatePollModal"
                                        class="px-4 py-2 bg-white dark:bg-[#1B3B5A] hover:bg-[#F1F5F9] dark:hover:bg-[#112A46] text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold text-xs rounded-xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] shadow-sm transition inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                                    <span>@Loc["GroupDetail_Btn_UploadPoll"]</span>
                                </button>
                            }
                            @if (isGroupManager)
                            {
                                <button type="button" @onclick="OpenRequestsModal"
                                        class="px-4 py-2 bg-indigo-50 dark:bg-indigo-950/40 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 font-semibold text-xs rounded-xl border border-indigo-200 dark:border-indigo-800 shadow-sm transition inline-flex items-center gap-1.5 cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                    <span>@Loc["GroupDetail_Btn_UpcomingRequests"]</span>
                                    @if (pendingRequestsCount > 0)
                                    {
                                        <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-indigo-600 text-white">
                                            @pendingRequestsCount
                                        </span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (group.Visibility == "PRIVATE" && !group.IsJoined)
        {
            <!-- PRIVATE GROUP LOCK BANNER -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-amber-300 dark:border-amber-500/30 p-12 text-center shadow-sm">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 flex items-center justify-center text-amber-500">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <h2 class="text-lg font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["GroupDetail_Lock_Title"]</h2>
                <p class="text-sm text-[#557392] dark:text-[#C4D2E1] max-w-md mx-auto mt-2">
                    @Loc["GroupDetail_Lock_Desc"]
                </p>
                <div class="mt-6">
                    @if (group.UserJoinStatus == "PENDING")
                    {
                        <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 font-semibold text-sm rounded-xl border border-amber-200 dark:border-amber-900/50">
                            <svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>@Loc["GroupDetail_Lock_Pending"]</span>
                        </span>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-sm rounded-xl shadow-sm transition">
                            <span>@Loc["GroupDetail_Lock_RequestBtn"]</span>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Navigation Tabs: Feed, Polls, Members -->
            <div class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-slate-200 dark:border-[rgba(196,210,225,0.12)] p-2 flex items-center gap-2">
                <button type="button" @onclick='() => SetActiveTab("feed")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center flex items-center justify-center gap-1.5 @(activeTab == "feed" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] shadow-sm border border-[#0A1B2E] dark:border-white" : "text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-[#1B3B5A]")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Tab_Feed"], posts?.Count ?? 0)</span>
                </button>
                <button type="button" @onclick='() => SetActiveTab("polls")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center flex items-center justify-center gap-1.5 @(activeTab == "polls" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] shadow-sm border border-[#0A1B2E] dark:border-white" : "text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-[#1B3B5A]")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    <span>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Tab_Polls"], polls?.Count ?? 0)</span>
                </button>
                <button type="button" @onclick='() => SetActiveTab("members")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center flex items-center justify-center gap-1.5 @(activeTab == "members" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] shadow-sm border border-[#0A1B2E] dark:border-white" : "text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-[#1B3B5A]")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    <span>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Tab_Members"], members?.Count ?? 0)</span>
                </button>
                <button type="button" @onclick='() => SetActiveTab("ratings")'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center flex items-center justify-center gap-1.5 @(activeTab == "ratings" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] shadow-sm border border-[#0A1B2E] dark:border-white" : "text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-[#1B3B5A]")">
                    <svg class="w-4 h-4 fill-current text-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    <span>@string.Format(CultureInfo.CurrentUICulture, Loc["GroupDetail_Tab_Ratings"], ratingSummary?.TotalRatings ?? group?.RatingCount ?? 0)</span>
                </button>
            </div>
            <!-- TAB 1: GROUP FEED -->
            @if (activeTab == "feed")
            {
                @if (isLoadingFeed)
                {
                    <div class="flex justify-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-4 border-[#0A1B2E] dark:border-[#E1E8F0] border-t-transparent"></div>
                    </div>
                }
                else if (posts == null || posts.Count == 0)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-[#557392] dark:text-[#C4D2E1]">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                        </div>
                        <h4 class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] text-base" style="font-family:'Manrope',sans-serif">@Loc["GroupDetail_Feed_EmptyTitle"]</h4>
                        <p class="text-xs text-[#7A8CA6] mt-1 max-w-sm mx-auto">
                            @(group?.IsJoined == true ? Loc["GroupDetail_Feed_EmptyJoinedDesc"] : Loc["GroupDetail_Feed_EmptyNotJoinedDesc"])
                        </p>
                        @if (group?.IsJoined == true)
                        {
                            <button type="button" @onclick="OpenCreatePostModal" class="mt-4 px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-semibold rounded-xl shadow transition">
                                @Loc["GroupDetail_Feed_CreatePostNow"]
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var post in posts)
                        {
                            <div id="post-@post.PostId" class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden transition hover:shadow-md">
                                @if (!post.IsActive && currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                {
                                    <!-- Post Banned Banner for Author -->
                                    <div @onclick="() => OpenBannedReasonModal(post)"
                                         class="cursor-pointer bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border-b border-red-500/30 px-4 py-2.5 flex items-center justify-between text-xs font-bold transition">
                                        <div class="flex items-center gap-2">
                                            <svg class="w-4 h-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                            <span>@Loc["GroupDetail_Post_BannedBannerTitle"]</span>
                                        </div>
                                        <span class="text-[11px] underline font-semibold flex items-center gap-1">
                                            <span>@Loc["GroupDetail_Post_BannedViewReason"]</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                        </span>
                                    </div>
                                }
                                <!-- Post Author Header -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex items-center gap-3">
                                        <a href="u/@(post.AuthorId > 0 ? post.AuthorId.ToString() : post.AuthorName)" class="shrink-0 hover:opacity-80 transition">
                                            <UserAvatar Url="@post.AuthorAvatar"
                                                        Name="@post.AuthorName"
                                                        Size="w-10 h-10"
                                                        RingClass="border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]"
                                                        BgClass="bg-[#F1F5F9] dark:bg-[#1B3B5A]"
                                                        ColorClass="text-[#0A1B2E] dark:text-[#E1E8F0]"
                                                        TextClass="text-sm" />
                                        </a>
                                        <div>
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <a href="u/@(post.AuthorId > 0 ? post.AuthorId.ToString() : post.AuthorName)" class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-indigo-600 transition inline-flex items-center gap-1 leading-tight" style="font-family:'Manrope',sans-serif">
                                                    <span>@post.AuthorName</span>
                                                    @if (post.IsAuthorVerified)
                                                    {
                                                        <VerifiedBadge CssClass="w-3.5 h-3.5 shrink-0" />
                                                    }
                                                </a>
                                                @if (post.AuthorRoleCode == "PUBLIC_FIGURE")
                                                {
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-100 dark:bg-purple-950/50 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800" title="@Loc["GroupDetail_Post_VipTooltip"]">
                                                        <svg class="w-3 h-3 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                                        <span class="hidden sm:inline">@Loc["GroupDetail_Post_VipBadge"]</span>
                                                    </span>
                                                }
                                                else if (post.AuthorRoleCode == "DOMAIN_PRO" || post.IsAuthorVerified)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800" title="@Loc["GroupDetail_Post_ProTooltip"]">
                                                        <svg class="w-3 h-3 fill-blue-500 text-blue-500" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                                                        <span class="hidden sm:inline">@Loc["GroupDetail_Post_ProBadge"]</span>
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] font-mono">@FormatTimeAgo(post.CreatedAt)</span>
                                        </div>
                                    </div>
                                    <div class="relative">
                                        <button type="button" @onclick="() => TogglePostMenu(post.PostId)"
                                                class="p-1.5 text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-[#1B3B5A] transition cursor-pointer" title="@Loc["GroupDetail_Post_OptionsTooltip"]">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
                                            </svg>
                                        </button>
                                        @if (activeMenuPostId == post.PostId)
                                        {
                                            <div class="absolute right-0 mt-1 w-44 bg-white dark:bg-[#112A46] rounded-xl shadow-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                                                <button type="button" @onclick='() => OpenReportContentModal(post.PostId, "POST")'
                                                        class="w-full text-left px-3.5 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                                                    <span>@Loc["GroupDetail_Post_ReportBtn"]</span>
                                                </button>
                                                <!-- Save Button (For all users) -->
                                                <button type="button" @onclick="() => ToggleSavePost(post.PostId)"
                                                        class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-slate-50 dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                                                    <span>@(post.IsSavedByCurrentUser ? Loc["GroupDetail_Post_UnsaveBtn"] : Loc["GroupDetail_Post_SaveBtn"])</span>
                                                </button>
                                                <!-- Privacy, Edit & Delete (Author only) -->
                                                @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                                {
                                                    <button type="button" @onclick="() => TogglePostPrivacyAsync(post)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                        <span>@(post.IsPrivate ? Loc["GroupDetail_Post_MakePublic"] : Loc["GroupDetail_Post_MakePrivate"])</span>
                                                    </button>
                                                    <button type="button" @onclick="() => OpenEditPost(post)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-slate-50 dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                        <span>@Loc["GroupDetail_Post_EditBtn"]</span>
                                                    </button>
                                                    <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] my-1"></div>
                                                    <button type="button" @onclick="() => ConfirmDeletePost(post.PostId)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2 transition cursor-pointer">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                        <span>@Loc["GroupDetail_Post_DeleteBtn"]</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- Post Text Content -->
                                <div class="px-5 py-4 text-sm text-[#0A1B2E] dark:text-[#E1E8F0] leading-relaxed whitespace-pre-line">
                                    @post.Content
                                </div>
                                <!-- Attached Files Component -->
                                @if (!string.IsNullOrWhiteSpace(post.CodeSnippet))
                                {
                                    var textFiles = ParseGroupTextFiles(post.CodeSnippet, post.CodeFileName);
                                    @foreach (var tf in textFiles)
                                    {
                                        <div class="px-5 pb-3">
                                            <div class="prof-code-block p-2.5 space-y-1 text-xs rounded-xl border border-gray-800 bg-[#0d1117] text-gray-200">
                                                <div class="flex items-center justify-between pb-1 border-b border-gray-800 text-[10px] text-gray-400">
                                                    <div class="flex items-center gap-1.5 font-mono min-w-0">
                                                        <span class="font-bold text-emerald-400 truncate">📄 @tf.FileName</span>
                                                        @if (tf.FileSizeBytes.HasValue)
                                                        {
                                                            <span class="text-gray-500 shrink-0">(@FormatGroupFileSize(tf.FileSizeBytes.Value))</span>
                                                        }
                                                    </div>
                                                    <div class="flex items-center gap-2 shrink-0 ml-2">
                                                        @if (!string.IsNullOrWhiteSpace(tf.FileUrl))
                                                        {
                                                            <a href="@tf.FileUrl" download="@tf.FileName" target="_blank"
                                                               class="flex items-center gap-1 text-[10px] text-gray-400 hover:text-white transition-colors cursor-pointer"
                                                               title="Download file">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                                                <span>Download</span>
                                                            </a>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(tf.Content))
                                                        {
                                                            <button type="button" class="flex items-center gap-1 text-[10px] text-gray-400 hover:text-white transition-colors cursor-pointer"
                                                                    @onclick="() => CopyGroupSnippetAsync(tf.Content)"
                                                                    title="Copy content">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                                <span>Copy</span>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(tf.Content))
                                                {
                                                    <div class="overflow-x-auto overflow-y-auto max-h-56 text-[11px] leading-relaxed select-text p-2">
                                                        <pre class="whitespace-pre font-mono text-tertiary"><code>@tf.Content</code></pre>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                <!-- Post Images (Carousel Style matching Home) -->
                                @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                                {
                                    var imgCount = post.ImageUrls.Count;
                                    var activeIdx = Math.Clamp(GetActiveImageIndex(post.PostId), 0, imgCount - 1);
                                    var currentImage = post.ImageUrls[activeIdx];
                                    <div class="relative w-full rounded-lg overflow-hidden bg-slate-950 group border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] select-none">
                                        <!-- Carousel Images Track -->
                                        <div class="w-full h-48 sm:h-60 flex transition-transform duration-500 ease-out">
                                            <div class="w-full h-full flex-shrink-0 relative">
                                                <img class="w-full h-full object-cover cursor-pointer hover:opacity-95 transition-opacity"
                                                     src="@currentImage"
                                                     alt="@string.Format(Loc["GroupDetail_Post_ImgAlt"], activeIdx + 1, imgCount)"
                                                     @onclick="() => OpenEnlargedImage(currentImage)" />
                                                <div class="absolute bottom-2.5 left-3 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded text-[11px] text-white pointer-events-none">
                                                    @(activeIdx + 1) / @imgCount
                                                </div>
                                            </div>
                                        </div>
                                        @if (imgCount > 1)
                                        {
                                            <!-- Pill Counter Badge -->
                                            <div class="absolute top-2.5 right-2.5 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded-full text-[10px] text-white font-mono shadow-xs">
                                                @(activeIdx + 1) / @imgCount
                                            </div>
                                            <!-- Carousel Controls -->
                                            @if (activeIdx > 0)
                                            {
                                                <button type="button" @onclick="() => PrevImage(post.PostId, imgCount)"
                                                        class="absolute left-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md hover:bg-black/80 cursor-pointer z-10"
                                                        aria-label="@Loc["GroupDetail_Post_PrevImgAria"]">
                                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                                </button>
                                            }
                                            @if (activeIdx < imgCount - 1)
                                            {
                                                <button type="button" @onclick="() => NextImage(post.PostId, imgCount)"
                                                        class="absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md hover:bg-black/80 cursor-pointer z-10"
                                                        aria-label="@Loc["GroupDetail_Post_NextImgAria"]">
                                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                                </button>
                                            }
                                            <!-- Pagination Indicator Dots -->
                                            <div class="absolute bottom-2.5 right-3 flex items-center gap-1 z-10">
                                                @for (int dotIdx = 0; dotIdx < imgCount; dotIdx++)
                                                {
                                                    var targetIdx = dotIdx;
                                                    <button type="button" @onclick="() => SetActiveImage(post.PostId, targetIdx)"
                                                            class="@(dotIdx == activeIdx ? "w-2 h-2 rounded-full bg-blue-500 transition-all" : "w-1.5 h-1.5 rounded-full bg-white/50 transition-all") cursor-pointer"
                                                            aria-label="@string.Format(Loc["GroupDetail_Post_GoToImgAria"], targetIdx + 1)">
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <!-- Engagement Strip (Home Style) -->
                                <div class="px-4 py-2.5 flex items-center justify-between border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex items-center gap-4">
                                        <!-- Like -->
                                        <button type="button" @onclick="() => ToggleLike(post.PostId)"
                                                class="flex items-center gap-1 text-xs @(post.IsLikedByCurrentUser ? "text-rose-500 font-semibold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-rose-500") transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_LikeBtn"]">
                                            <span class="material-symbols-outlined text-[17px] @(post.IsLikedByCurrentUser ? "text-rose-500" : "")">favorite</span>
                                            <span>@post.LikeCount</span>
                                        </button>
                                        <!-- Comment -->
                                        <button type="button" @onclick="() => ToggleCommentBox(post.PostId)"
                                                class="flex items-center gap-1 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_CommentBtn"]">
                                            <span class="material-symbols-outlined text-[17px]">chat_bubble</span>
                                            <span>@post.CommentCount</span>
                                        </button>
                                        <!-- Share -->
                                        <button type="button" @onclick="() => OpenShareModal(post.PostId)"
                                                class="flex items-center gap-1 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_ShareBtn"]">
                                            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                <path d="M15 14l5-5-5-5" />
                                                <path d="M4 20v-7a4 4 0 0 1 4-4h12" />
                                            </svg>
                                            <span>@post.ShareCount</span>
                                        </button>
                                    </div>
                                </div>
                                <!-- Comments Drawer -->
                                @if (openCommentPostIds.Contains(post.PostId))
                                {
                                    <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E] space-y-4">
                                        <!-- Add Comment -->
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] flex items-center justify-center shrink-0 mt-0.5">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[post.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(post.PostId); })"
                                                       placeholder="@Loc["GroupDetail_Post_CommentPlaceholder"]"
                                                       class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] dark:placeholder-[rgba(196,210,225,0.40)] rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20" />
                                                <button type="button" @onclick="() => SubmitComment(post.PostId)"
                                                        class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-xl text-xs font-semibold shadow transition">
                                                    @Loc["GroupDetail_Post_CommentSubmitBtn"]
                                                </button>
                                            </div>
                                        </div>
                                        <!-- Comments List -->
                                        @if (commentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#7A8CA6] text-center py-2">@Loc["GroupDetail_Post_NoComments"]</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded-xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <a href="u/@comment.AuthorName" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-indigo-600 transition">@comment.AuthorName</a>
                                                                    <span class="text-[10px] text-[#7A8CA6] font-mono">@FormatTimeAgo(comment.CreatedAt)</span>
                                                                </div>
                                                                <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }                <!-- TAB 2: LIVE POLLS -->
            @if (activeTab == "polls")
            {
                @if (polls == null || polls.Count == 0)
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-lg border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] p-12 text-center text-[#557392] dark:text-[#7A8CA6]">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        </div>
                        <h4 class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] text-base">@Loc["GroupDetail_Poll_EmptyTitle"]</h4>
                        <p class="text-xs text-[#557392] dark:text-[#7A8CA6] mt-1 max-w-sm mx-auto">
                            @(group?.IsJoined == true ? Loc["GroupDetail_Poll_EmptyJoinedDesc"] : Loc["GroupDetail_Poll_EmptyNotJoinedDesc"])
                        </p>
                        @if (group?.IsJoined == true)
                        {
                            <button type="button" @onclick="OpenCreatePollModal"
                                    class="mt-4 px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] text-xs font-semibold rounded shadow-sm transition inline-flex items-center gap-1.5 cursor-pointer">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                                <span>@Loc["GroupDetail_Btn_UploadPoll"]</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var poll in polls)
                        {
                            <div id="poll-@poll.PollId" class="bg-white dark:bg-[#112A46] rounded-2xl shadow-sm border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden transition hover:shadow-md">
                                <!-- Poll Author Info -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                    <div class="flex items-center gap-3">
                                        <a href="u/@(poll.AuthorId > 0 ? poll.AuthorId.ToString() : poll.AuthorName)" class="shrink-0 hover:opacity-80 transition">
                                            <UserAvatar Url="@poll.AuthorAvatar"
                                                        Name="@poll.AuthorName"
                                                        Size="w-10 h-10"
                                                        RingClass="border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)]"
                                                        BgClass="bg-[#F1F5F9] dark:bg-[#1B3B5A]"
                                                        ColorClass="text-[#0A1B2E] dark:text-[#E1E8F0]"
                                                        TextClass="text-sm" />
                                        </a>
                                        <div>
                                            <a href="u/@(poll.AuthorId > 0 ? poll.AuthorId.ToString() : poll.AuthorName)" class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-indigo-600 transition inline-flex items-center gap-1 leading-tight" style="font-family:'Manrope',sans-serif">
                                                <span>@poll.AuthorName</span>
                                                @if (poll.IsAuthorVerified)
                                                {
                                                    <VerifiedBadge CssClass="w-3.5 h-3.5 shrink-0" />
                                                }
                                            </a>
                                            <span class="text-[11px] text-[#557392] dark:text-[#C4D2E1] font-mono">@FormatTimeAgo(poll.CreatedAt)</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        @if (poll.ExpiresAt.HasValue)
                                        {
                                            <span class="text-xs px-2.5 py-1 rounded-full @(poll.IsExpired ? "bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-900/50" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-900/50")">
                                                @(poll.IsExpired ? Loc["GroupDetail_Poll_Closed"] : string.Format(Loc["GroupDetail_Poll_EndsAt"], poll.ExpiresAt.Value.ToLocalTime().ToString("dd-MM-yyyy")))
                                            </span>
                                        }
                                        <!-- Three-Dots Action Menu for Poll -->
                                        <div class="relative">
                                            <button type="button" @onclick="() => TogglePollMenu(poll.PollId)"
                                                    class="p-1.5 text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-[#1B3B5A] transition cursor-pointer" title="@Loc["GroupDetail_Post_OptionsTooltip"]">
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
                                                </svg>
                                            </button>
                                            @if (activeMenuPollId == poll.PollId)
                                            {
                                                <div class="absolute right-0 mt-1 w-44 bg-white dark:bg-[#112A46] rounded-xl shadow-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                                                    <button type="button" @onclick='() => OpenReportContentModal(poll.PollId, "POLL")'
                                                            class="w-full text-left px-3.5 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition cursor-pointer">
                                                        <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
                                                        <span>@Loc["GroupDetail_Poll_ReportBtn"]</span>
                                                    </button>
                                                    <!-- Save Button (All users) -->
                                                    <button type="button" @onclick="() => ToggleSavePoll(poll.PostId)"
                                                            class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-slate-50 dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                                                        <span>@Loc["GroupDetail_Poll_SaveBtn"]</span>
                                                    </button>
                                                    <!-- Edit, Privacy & Delete (Author only) -->
                                                    @if (currentUserId.HasValue && poll.AuthorId == currentUserId.Value)
                                                    {
                                                        <button type="button" @onclick="() => TogglePollPrivacyAsync(poll)"
                                                                class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 flex items-center gap-2 transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                            <span>@(poll.IsPrivate ? Loc["GroupDetail_Poll_MakePublic"] : Loc["GroupDetail_Poll_MakePrivate"])</span>
                                                        </button>
                                                        <button type="button" @onclick="() => OpenEditPoll(poll)"
                                                                class="w-full text-left px-3.5 py-2 text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:bg-slate-50 dark:hover:bg-[#1B3B5A] flex items-center gap-2 transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                            <span>@Loc["GroupDetail_Poll_EditBtn"]</span>
                                                        </button>
                                                        <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] my-1"></div>
                                                        <button type="button" @onclick="() => DeletePoll(poll.PollId)"
                                                                class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition cursor-pointer">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                            <span>@Loc["GroupDetail_Poll_DeleteBtn"]</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <!-- Poll Content & Question -->
                                <div class="px-5 pt-4 pb-2 space-y-2">
                                    <h3 class="text-base font-bold text-[#0A1B2E] dark:text-[#E1E8F0] leading-snug">@poll.Question</h3>
                                    @if (!string.IsNullOrWhiteSpace(poll.Content) && poll.Content != poll.Question)
                                    {
                                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line leading-relaxed">@poll.Content</p>
                                    }
                                </div>
                                <!-- Poll Options & Voting -->
                                <div class="px-5 py-4 space-y-3">
                                    @foreach (var opt in poll.Options)
                                    {
                                        var hasUserVotedThis = opt.IsVotedByCurrentUser;
                                        <div class="relative overflow-hidden rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] bg-[#F8FAFC] dark:bg-[#0A1B2E] p-3 transition hover:border-[#CBD5E1] dark:hover:border-[rgba(196,210,225,0.25)]">
                                            <!-- Progress bar background -->
                                            <div class="absolute inset-y-0 left-0 bg-[#E2E8F0] dark:bg-[#1B3B5A] transition-all duration-500"
                                                 style="width: @(opt.Percentage)%"></div>
                                            <div class="relative flex items-center justify-between gap-3 text-xs sm:text-sm">
                                                <div class="flex items-center gap-2.5 flex-1">
                                                    @if (!poll.HasVoted && !poll.IsExpired)
                                                    {
                                                        <button type="button" @onclick="() => Vote(poll.PollId, opt.OptionId)"
                                                                class="w-5 h-5 rounded-full border-2 border-[#557392] dark:border-[#C4D2E1] hover:border-[#0A1B2E] dark:hover:border-white transition flex items-center justify-center shrink-0">
                                                            <div class="w-2 h-2 rounded-full bg-[#0A1B2E] dark:bg-white opacity-0 hover:opacity-100"></div>
                                                        </button>
                                                    }
                                                    else if (hasUserVotedThis)
                                                    {
                                                        <div class="w-5 h-5 rounded-full bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E] flex items-center justify-center text-xs shrink-0 font-bold">
                                                            ✓
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="w-5 h-5 rounded-full border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] shrink-0"></div>
                                                    }
                                                    <span class="font-medium text-[#0A1B2E] dark:text-[#E1E8F0] @(hasUserVotedThis ? "font-bold" : "")">
                                                        @opt.Text
                                                    </span>
                                                </div>
                                                <div class="text-right shrink-0">
                                                    <span class="text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@opt.Percentage%</span>
                                                    <span class="text-[11px] text-[#557392] dark:text-[#7A8CA6] ml-1">(@opt.VoteCount)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <!-- Poll Summary Footer -->
                                <div class="px-5 py-2.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between text-xs text-[#557392] dark:text-[#7A8CA6]">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>@string.Format(Loc["GroupDetail_Poll_TotalVotes"], poll.TotalVotes)</span>
                                        <span>•</span>
                                        <span>@(poll.IsMultipleChoice ? Loc["GroupDetail_Poll_MultipleVotesAllowed"] : Loc["GroupDetail_Poll_SingleChoice"])</span>
                                    </div>
                                    @if (poll.HasVoted)
                                    {
                                        <span class="text-[#0A1B2E] dark:text-[#E1E8F0] font-semibold flex items-center gap-1">
                                            <span>✓</span> @Loc["GroupDetail_Poll_YouVoted"]
                                        </span>
                                    }
                                    else if (poll.IsExpired)
                                    {
                                        <span class="text-rose-600 dark:text-rose-400 font-medium">@Loc["GroupDetail_Poll_VotingEnded"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#557392] dark:text-[#C4D2E1] font-medium">@Loc["GroupDetail_Poll_ClickToVote"]</span>
                                    }
                                </div>
                                <!-- Actions: Like, Comment, Share on Poll (Home Style) -->
                                <div class="px-4 py-2.5 flex items-center justify-between border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                                    <div class="flex items-center gap-4">
                                        <button type="button" @onclick="() => ToggleLike(poll.PostId)"
                                                class="flex items-center gap-1 text-xs @(poll.IsLikedByCurrentUser ? "text-rose-500 font-semibold" : "text-[#557392] dark:text-[#C4D2E1] hover:text-rose-500") transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_LikeBtn"]">
                                            <span class="material-symbols-outlined text-[17px] @(poll.IsLikedByCurrentUser ? "text-rose-500" : "")">favorite</span>
                                            <span>@poll.LikeCount</span>
                                        </button>
                                        <button type="button" @onclick="() => ToggleCommentBox(poll.PostId)"
                                                class="flex items-center gap-1 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_CommentBtn"]">
                                            <span class="material-symbols-outlined text-[17px]">chat_bubble</span>
                                            <span>@poll.CommentCount</span>
                                        </button>
                                        <button type="button" @onclick="() => OpenShareModal(poll.PostId)"
                                                class="flex items-center gap-1 text-xs text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-[#E1E8F0] transition-colors cursor-pointer"
                                                title="@Loc["GroupDetail_Post_ShareBtn"]">
                                            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                <path d="M15 14l5-5-5-5" />
                                                <path d="M4 20v-7a4 4 0 0 1 4-4h12" />
                                            </svg>
                                            <span>@poll.ShareCount</span>
                                        </button>
                                    </div>
                                </div>
                                <!-- Poll Comments Drawer -->
                                @if (openCommentPostIds.Contains(poll.PostId))
                                {
                                    <div class="border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] p-4 sm:p-5 bg-[#F8FAFC] dark:bg-[#0A1B2E] space-y-4">
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center shrink-0 mt-0.5">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[poll.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(poll.PostId); })"
                                                       placeholder="@Loc["GroupDetail_Poll_CommentPlaceholder"]"
                                                       class="w-full text-sm bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                                <button type="button" @onclick="() => SubmitComment(poll.PostId)"
                                                        class="px-4 py-2 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded text-xs font-semibold shadow-sm transition">
                                                    @Loc["GroupDetail_Post_CommentSubmitBtn"]
                                                </button>
                                            </div>
                                        </div>
                                        @if (commentsByPost.TryGetValue(poll.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#557392] dark:text-[#7A8CA6] text-center py-2">@Loc["GroupDetail_Poll_NoComments"]</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center justify-center font-bold shrink-0">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-white dark:bg-[#112A46] p-2.5 rounded border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <span class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@comment.AuthorName</span>
                                                                    <span class="text-[10px] text-[#557392] dark:text-[#7A8CA6]">@comment.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                                                                </div>
                                                                <p class="text-[#557392] dark:text-[#C4D2E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            <!-- TAB 3: MEMBERS -->
            @if (activeTab == "members")
            {
                @if (members == null || members.Count == 0)
                {
                    <p class="text-xs text-[#557392] dark:text-[#7A8CA6] text-center py-6">@Loc["GroupDetail_Members_Empty"]</p>
                }
                else
                {
                    <div class="bg-white dark:bg-[#112A46] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] overflow-hidden divide-y divide-[#E2E8F0] dark:divide-[rgba(196,210,225,0.08)]">
                        @foreach (var m in members)
                        {
                            <div class="p-3.5 flex items-center justify-between text-xs hover:bg-[#F8FAFC] dark:hover:bg-[#1B3B5A]/30 transition">
                                <div class="flex items-center gap-3">
                                    <a href="u/@m.UserName" class="shrink-0 hover:opacity-80 transition">
                                        <div class="w-8 h-8 rounded-full bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] flex items-center justify-center font-bold">
                                            @(string.IsNullOrWhiteSpace(m.DisplayName) ? "U" : m.DisplayName.Substring(0, 1).ToUpper())
                                        </div>
                                    </a>
                                    <div>
                                        <a href="u/@m.UserName" class="font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:text-indigo-600 transition block">@m.DisplayName</a>
                                        <span class="text-[10px] text-[#557392] dark:text-[#7A8CA6] block">@@@m.UserName</span>
                                    </div>
                                </div>
                                <span class="px-2.5 py-0.5 rounded text-[10px] font-bold @(m.Role == "Owner" ? "bg-[#0A1B2E] dark:bg-[#E1E8F0] text-white dark:text-[#0A1B2E]" : (m.Role == "Admin" ? "bg-[#F1F5F9] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)]" : "bg-[#F8FAFC] dark:bg-[#0A1B2E] text-[#557392] dark:text-[#7A8CA6] border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)]"))">
                                    @GetMemberRoleLocalized(m.Role)
                                </span>
                            </div>
                        }
                    </div>
                }
            }
            <!-- TAB 4: GROUP RATINGS & REVIEWS -->
            else if (activeTab == "ratings")
            {
                <div class="space-y-6">
                    <!-- Rating Header Card -->
                    <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-slate-200 dark:border-[rgba(196,210,225,0.12)] p-6 shadow-sm">
                        <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6">
                            <div class="flex items-center gap-5">
                                <div class="w-20 h-20 rounded-2xl bg-slate-50 dark:bg-[#0A1B2E] border border-slate-200 dark:border-[rgba(196,210,225,0.15)] flex flex-col items-center justify-center text-blue-600 dark:text-blue-400 shadow-xs">
                                    <span class="text-3xl font-black text-blue-600 dark:text-blue-400">
                                        @(ratingSummary != null && ratingSummary.TotalRatings > 0 ? ratingSummary.AverageScore.ToString("0.0") : "—")
                                    </span>
                                    <div class="flex text-xs text-blue-500 dark:text-blue-400 mt-0.5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span>@(ratingSummary != null && ratingSummary.TotalRatings > 0 && i <= Math.Round(ratingSummary.AverageScore) ? "★" : "☆")</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-slate-900 dark:text-[#E1E8F0]">@Loc["GroupDetail_Ratings_HeaderTitle"]</h3>
                                    <p class="text-xs text-slate-500 dark:text-[#C4D2E1] mt-0.5">
                                        @(ratingSummary != null && ratingSummary.TotalRatings > 0 
                                            ? string.Format(Loc["GroupDetail_Ratings_BasedOn"], ratingSummary.TotalRatings)
                                            : Loc["GroupDetail_Ratings_NoRatingsSubtitle"])
                                    </p>
                                </div>
                            </div>
                            @if (group?.IsJoined == true)
                            {
                                <button type="button" @onclick="OpenRatingModal"
                                        class="px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition active:scale-95 inline-flex items-center gap-2 cursor-pointer border border-[#0A1B2E] dark:border-white">
                                    <svg class="w-4 h-4 fill-current text-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                                    <span>@(ratingSummary?.UserRating != null ? Loc["GroupDetail_Ratings_EditYourReview"] : Loc["GroupDetail_Ratings_RateThisGroup"])</span>
                                </button>
                            }
                        </div>
                        @if (group?.IsJoined != true)
                        {
                            <div class="mt-4 p-3.5 bg-blue-50/70 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/50 rounded-xl flex items-center justify-between gap-3 text-xs text-blue-800 dark:text-blue-300">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                    <span>@Loc["GroupDetail_Ratings_NonMemberNotice"]</span>
                                </div>
                                <button type="button" @onclick="JoinGroup" class="px-3.5 py-1.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs rounded-lg shrink-0 transition border border-[#0A1B2E] dark:border-white">
                                    @Loc["GroupDetail_Action_JoinGroup"]
                                </button>
                            </div>
                        }
                    </div>
                    <!-- Reviews List -->
                    @if (isLoadingRatings)
                    {
                        <div class="flex justify-center py-12">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
                        </div>
                    }
                    else if (ratingSummary == null || ratingSummary.Ratings.Count == 0)
                    {
                        <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-dashed border-slate-300 dark:border-[rgba(196,210,225,0.20)] p-12 text-center text-slate-500 dark:text-[#7A8CA6]">
                            <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-[#0A1B2E] flex items-center justify-center mx-auto mb-3 text-blue-600 dark:text-blue-400">
                                <svg class="w-7 h-7 fill-blue-500 text-blue-500" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                            </div>
                            <h4 class="font-semibold text-slate-900 dark:text-[#E1E8F0] text-base">@Loc["GroupDetail_Ratings_EmptyTitle"]</h4>
                            <p class="text-xs text-slate-500 dark:text-[#C4D2E1] max-w-sm mx-auto mt-1">
                                @(group?.IsJoined == true ? Loc["GroupDetail_Ratings_EmptyJoinedSubtitle"] : Loc["GroupDetail_Ratings_EmptyNotJoinedSubtitle"])
                            </p>
                            @if (group?.IsJoined == true)
                            {
                                <button type="button" @onclick="OpenRatingModal" class="mt-4 px-5 py-2.5 bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition active:scale-95 inline-flex items-center gap-2 cursor-pointer border border-[#0A1B2E] dark:border-white">
                                    @Loc["GroupDetail_Ratings_WriteFirstReview"]
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var review in ratingSummary.Ratings)
                            {
                                var isMyReview = currentUserId.HasValue && review.UserId == currentUserId.Value;
                                <div class="bg-white dark:bg-[#112A46] rounded-2xl border border-slate-200 dark:border-[rgba(196,210,225,0.12)] p-5 shadow-xs transition hover:border-slate-300 dark:hover:border-white/20 @(isMyReview ? "ring-2 ring-blue-500/40" : "")">
                                    <div class="flex items-start justify-between gap-4">
                                        <!-- Reviewer Profile Info (Clickable link to user profile) -->
                                        <div class="flex items-center gap-3">
                                            <a href="u/@review.UserName" class="shrink-0 group">
                                                <UserAvatar Url="@review.UserAvatar"
                                                            Name="@review.DisplayName"
                                                            Size="w-10 h-10"
                                                            Shape="xl"
                                                            RingClass="ring-2 ring-slate-100 group-hover:ring-indigo-400 transition"
                                                            BgClass="bg-gradient-to-tr from-indigo-600 to-purple-600"
                                                            ColorClass="text-white"
                                                            TextClass="text-sm" />
                                            </a>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <a href="u/@review.UserName" class="font-bold text-sm text-slate-900 dark:text-[#E1E8F0] hover:text-blue-600 dark:hover:text-blue-400 transition">
                                                        @review.DisplayName
                                                    </a>
                                                    @if (isMyReview)
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-900/50">
                                                            @Loc["GroupDetail_Ratings_YourReviewBadge"]
                                                        </span>
                                                    }
                                                </div>
                                                <a href="u/@review.UserName" class="text-[11px] text-slate-400 dark:text-[#7A8CA6] hover:text-slate-600 dark:hover:text-white transition block">
                                                    @@@review.UserName
                                                </a>
                                            </div>
                                        </div>
                                        <!-- Stars and Date -->
                                        <div class="text-right">
                                            <div class="flex items-center justify-end text-blue-500 dark:text-blue-400 text-sm">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <span class="@(s <= review.Score ? "text-blue-500 dark:text-blue-400" : "text-slate-200 dark:text-slate-700")">★</span>
                                                }
                                                <span class="ml-1 text-xs font-black text-slate-800 dark:text-[#E1E8F0]">@review.Score.0</span>
                                            </div>
                                            <span class="text-[11px] text-slate-400 block mt-0.5">
                                                @FormatTimeAgo(review.CreatedAt)
                                                @(review.UpdatedAt.HasValue ? $" {Loc["GroupDetail_Ratings_EditedBadge"]}" : "")
                                            </span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                                    {
                                        <p class="text-sm text-slate-700 dark:text-[#C4D2E1] mt-3 pl-13 leading-relaxed whitespace-pre-line">
                                            @review.ReviewText
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>
<!-- ================= MODAL: CREATE GROUP POST ================= -->
@if (showPostModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-xl shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0] animate-in fade-in duration-200">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">@string.Format(Loc["GroupDetail_Modal_PostToGroupTitle"], group?.Name)</h3>
                </div>
                <button type="button" @onclick="() => showPostModal = false" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white font-bold text-sm cursor-pointer">&times;</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_PostWhatsOnYourMind"]</label>
                    <textarea @bind="newPostText" rows="4" placeholder="@Loc["GroupDetail_Modal_PostPlaceholder"]"
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded-xl p-3 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>
                <!-- Text File Attachment Section -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Attach Text Files (.txt - only one file allowed )</label>
                        @if (!string.IsNullOrEmpty(newPostCodeSnippet))
                        {
                            <button type="button" @onclick="RemovePostCodeFile" class="text-xs text-rose-500 hover:underline">@Loc["GroupDetail_Modal_RemoveFileBtn"]</button>
                        }
                    </div>
                    @if (string.IsNullOrEmpty(newPostCodeSnippet))
                    {
                        <label class="cursor-pointer border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded-xl p-3 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center gap-2">
                            <span class="text-base">📄</span>
                            <span class="text-xs font-medium text-[#1B3B5A] dark:text-[#E1E8F0]">@(isReadingTextFile ? Loc["GroupDetail_Modal_ScanningTextFile"] : "Attach files")</span>
                            <InputFile OnChange="HandlePostTextFileSelected" accept=".txt" class="hidden" disabled="@isReadingTextFile" />
                        </label>
                    }
                    else
                    {
                        var previewFiles = ParseGroupTextFiles(newPostCodeSnippet, newPostCodeFileName);
                        var firstFile = previewFiles.FirstOrDefault();
                        <div class="prof-code-block p-3 space-y-1.5 rounded-xl border border-gray-800 bg-[#0d1117] text-gray-200">
                            <div class="flex items-center justify-between pb-1.5 border-b border-gray-800 text-[10px] text-gray-400">
                                <span class="font-bold text-emerald-400 font-mono">📄 @(firstFile?.FileName ?? newPostCodeFileName ?? "attachment")</span>
                                <span class="font-mono text-gray-500">@(firstFile?.FileSizeBytes.HasValue == true ? FormatGroupFileSize(firstFile.FileSizeBytes.Value) : Loc["GroupDetail_Modal_TextBadge"])</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(firstFile?.Content))
                            {
                                <div class="overflow-x-auto overflow-y-auto max-h-40 text-[11px] leading-relaxed">
                                    <pre class="whitespace-pre font-mono"><code>@firstFile.Content</code></pre>
                                </div>
                            }
                        </div>
                    }
                </div>
                <!-- Multiple Images Attachment Section -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">Attach Images ( Only 10 Images )</label>
                        <span class="text-[10px] text-[#7A8CA6]">@Loc["GroupDetail_Modal_ImageFormatsHint"]</span>
                    </div>
                    <label class="cursor-pointer border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] rounded-xl p-3 text-center hover:border-[#0A1B2E] dark:hover:border-[rgba(196,210,225,0.35)] transition bg-[#F8FAFC] dark:bg-[#0A1B2E] flex items-center justify-center gap-2">
                        <span class="text-base">🖼️</span>
                        <span class="text-xs font-medium text-[#1B3B5A] dark:text-[#E1E8F0]">@(isUploadingImage ? Loc["GroupDetail_Modal_UploadingImages"] : "Upload images")</span>
                        <InputFile OnChange="HandleMultipleImagesSelected" accept="image/*" multiple class="hidden" disabled="@isUploadingImage" />
                    </label>
                    @if (uploadedImageUrls.Count > 0)
                    {
                        <div class="grid grid-cols-3 gap-2 mt-2.5">
                            @for (int i = 0; i < uploadedImageUrls.Count; i++)
                            {
                                var imgIndex = i;
                                var imgUrl = uploadedImageUrls[imgIndex];
                                <div class="relative rounded-lg overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] bg-slate-900 group aspect-video">
                                    <img src="@imgUrl" alt="@Loc["GroupDetail_Modal_ThumbnailAlt"]" class="w-full h-full object-cover" />
                                    <button type="button" @onclick="() => RemoveUploadedImage(imgIndex)"
                                            class="absolute top-1 right-1 bg-rose-600 hover:bg-rose-700 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold shadow cursor-pointer transition">
                                        &times;
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="px-5 py-3.5 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2.5">
                <button type="button" @onclick="() => showPostModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg transition cursor-pointer">@Loc["Common_Cancel"]</button>
                <button type="button" @onclick="SubmitGroupPost" disabled="@(isSubmitting || isUploadingImage || isReadingTextFile || (string.IsNullOrWhiteSpace(newPostText) && string.IsNullOrWhiteSpace(newPostCodeSnippet) && uploadedImageUrls.Count == 0))"
                        class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded-lg shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmitting)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["GroupDetail_Modal_PublishingPost"]</span>
                    }
                    else
                    {
                        <span>@Loc["GroupDetail_Modal_PublishPostBtn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= MODAL: CREATE GROUP POLL ================= -->
@if (showPollModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-lg overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    <h3 class="font-bold text-[#0A1B2E] dark:text-[#E1E8F0] text-sm">@string.Format(Loc["GroupDetail_Modal_CreatePollTitle"], group?.Name)</h3>
                </div>
                <button type="button" @onclick="() => showPollModal = false" class="text-[#557392] dark:text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white">✕</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_PollQuestionLabel"]</label>
                    <input type="text" @bind="newPollQuestion" placeholder="@Loc["GroupDetail_Modal_PollQuestionPlaceholder"]"
                           class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_PollContextLabel"]</label>
                    <textarea @bind="newPollDescription" rows="2" placeholder="@Loc["GroupDetail_Modal_PollContextPlaceholder"]"
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded p-2.5 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>
                <!-- Custom Duration Picker -->
                <div class="p-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] rounded border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)] space-y-2">
                    <span class="block text-xs font-bold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["GroupDetail_Modal_PollDurationTitle"]</span>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">@Loc["GroupDetail_Modal_PollDays"]</label>
                            <input type="number" min="0" max="365" @bind="pollDurationDays"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">@Loc["GroupDetail_Modal_PollHours"]</label>
                            <input type="number" min="0" max="23" @bind="pollDurationHours"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#557392] dark:text-[#7A8CA6] block mb-0.5">@Loc["GroupDetail_Modal_PollMinutes"]</label>
                            <input type="number" min="0" max="59" @bind="pollDurationMinutes"
                                   class="w-full bg-white dark:bg-[#112A46] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] rounded px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                    </div>
                </div>
                <!-- Dynamic Poll Options -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1]">@Loc["GroupDetail_Modal_PollOptionsLabel"]</label>
                        @if (pollOptionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddPollOption" class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline">
                                @Loc["GroupDetail_Modal_AddOptionBtn"]
                            </button>
                        }
                    </div>
                    <div class="space-y-2">
                        @for (int i = 0; i < pollOptionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded bg-[#E2E8F0] dark:bg-[#1B3B5A] text-[#0A1B2E] dark:text-[#E1E8F0] font-bold text-xs flex items-center justify-center shrink-0 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.15)]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       value="@pollOptionsList[index]"
                                       @onchange="(e) => pollOptionsList[index] = e.Value?.ToString() ?? string.Empty"
                                       placeholder="@string.Format(Loc["GroupDetail_Modal_OptionPlaceholder"], labelChar)"
                                       class="flex-1 text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded px-3 py-2 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]" />
                                @if (pollOptionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemovePollOption(index)" class="p-1.5 text-[#557392] dark:text-[#7A8CA6] hover:text-rose-500 transition" title="@Loc["GroupDetail_Modal_RemoveOptionTooltip"]">
                                        ✕
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                <!-- Multiple Choice Toggle -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="grpMultiChoice" @bind="pollIsMultipleChoice" class="rounded text-[#0A1B2E] dark:text-[#E1E8F0] focus:ring-[#0A1B2E] bg-white dark:bg-[#0A1B2E] border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)]" />
                    <label for="grpMultiChoice" class="text-xs font-medium text-[#557392] dark:text-[#C4D2E1] cursor-pointer">@Loc["GroupDetail_Modal_AllowMultipleChoices"]</label>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-end gap-2">
                <button type="button" @onclick="() => showPollModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded transition">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitGroupPoll" disabled="@isSubmitting"
                        class="px-5 py-2.5 text-xs font-bold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isSubmitting)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["GroupDetail_Modal_CreatingPoll"]</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        <span>@Loc["GroupDetail_Modal_PublishPollBtn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= MODAL: SHARE POST / POLL ================= -->
@if (showShareModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#0A1B2E]/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-lg shadow-2xl border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.15)] w-full max-w-md overflow-hidden text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
