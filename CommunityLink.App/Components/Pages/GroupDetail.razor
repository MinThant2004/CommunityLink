@page "/group/{groupId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@inject GroupApiService GroupApi
@inject PostApiService PostApi
@inject PollApiService PollApi
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment

<PageTitle>@(group?.Name ?? "Group Detail") - CommunityLink</PageTitle>

<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 space-y-6 text-[#F8FAFC]">
    <!-- Back to Groups Link -->
    <div class="flex items-center justify-between">
        <a href="/groups" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#94A3B8] hover:text-[#2DD4BF] transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span>Back to Groups Directory</span>
        </a>
    </div>

    @if (isLoadingGroup)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-[#14B8A6] border-t-transparent"></div>
        </div>
    }
    else if (group == null)
    {
        <div class="bg-[#1E293B] rounded-2xl border border-dashed border-[rgba(241,245,249,0.15)] p-12 text-center text-[#94A3B8]">
            <div class="text-4xl mb-3">🔍</div>
            <h3 class="text-base font-semibold text-[#F8FAFC]">Group not found</h3>
            <p class="text-sm mt-1">This group may have been removed or does not exist.</p>
        </div>
    }
    else
    {
        <!-- Group Hero Header Banner -->
        <div class="bg-[#1E293B] rounded-2xl shadow-sm border border-[rgba(241,245,249,0.08)] overflow-hidden">
            <div class="h-28 sm:h-36 bg-gradient-to-r from-teal-600 via-cyan-600 to-indigo-600 relative p-4">
                <div class="absolute -bottom-6 left-6">
                    @if (!string.IsNullOrEmpty(group.AvatarUrl))
                    {
                        <img src="@group.AvatarUrl" alt="@group.Name" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-4 border-[#1E293B] shadow-lg bg-[#0F172A]" />
                    }
                    else
                    {
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[#0F172A] border-4 border-[#1E293B] shadow-lg flex items-center justify-center font-bold text-[#2DD4BF] text-2xl">
                            @(string.IsNullOrWhiteSpace(group.Name) ? "G" : group.Name.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>
            </div>

            <div class="p-6 pt-8 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h1 class="text-xl sm:text-2xl font-bold text-[#F8FAFC]">@group.Name</h1>
                            @if (group.Visibility == "PRIVATE")
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                                    🔒 Private Group
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[rgba(20,184,166,0.15)] text-[#2DD4BF] border border-[rgba(20,184,166,0.3)]">
                                    🔓 Public Group
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(group.SubCommunityName))
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[rgba(14,165,233,0.15)] text-[#38BDF8] border border-[rgba(14,165,233,0.3)] mt-1">
                                📁 Part of @group.SubCommunityName
                            </span>
                        }

                        <p class="text-xs sm:text-sm text-[#94A3B8] mt-2 leading-relaxed">@group.Description</p>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="LeaveGroup"
                                    class="px-4 py-2 bg-[#0F172A] hover:bg-rose-500/20 text-[#CBD5E1] hover:text-rose-400 font-semibold text-xs rounded-xl transition border border-[rgba(241,245,249,0.12)]">
                                Leave Group
                            </button>
                        }
                        else if (group.UserJoinStatus == "PENDING")
                        {
                            <span class="px-4 py-2 bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-semibold rounded-xl">
                                ⏳ Join Requested
                            </span>
                        }
                        else
                        {
                            <button type="button" @onclick="JoinGroup"
                                    class="px-5 py-2 bg-[#14B8A6] hover:bg-[#0D9488] text-white font-semibold text-xs rounded-xl shadow-md shadow-[#14B8A6]/20 transition">
                                @(group.Visibility == "PRIVATE" ? "Request to Join" : "Join Group")
                            </button>
                        }
                    </div>
                </div>

                <!-- Stats Bar & Actions -->
                <div class="pt-3 border-t border-[rgba(241,245,249,0.08)] flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4 text-xs font-medium text-[#94A3B8]">
                        <span>👥 @group.MemberCount members</span>
                        <span>•</span>
                        <span>📝 @group.PostCount posts</span>
                        <span>•</span>
                        <span>Created by @group.CreatorName</span>
                    </div>

                    @if (group.IsJoined)
                    {
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="OpenCreatePostModal"
                                    class="px-4 py-2 bg-[#14B8A6] hover:bg-[#0D9488] text-white font-semibold text-xs rounded-xl shadow-sm transition inline-flex items-center gap-1.5 active:scale-95">
                                <span>✍️</span>
                                <span>Upload Group Post</span>
                            </button>
                            <button type="button" @onclick="OpenCreatePollModal"
                                    class="px-4 py-2 bg-[#6366F1] hover:bg-[#4F46E5] text-white font-semibold text-xs rounded-xl shadow-sm transition inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
                                <span>📊</span>
                                <span>Upload Group Poll</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (group.Visibility == "PRIVATE" && !group.IsJoined)
        {
            <!-- PRIVATE GROUP LOCK BANNER -->
            <div class="bg-[#1E293B] rounded-2xl border border-amber-500/30 p-12 text-center shadow-sm">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-3xl text-amber-400">
                    🔒
                </div>
                <h2 class="text-lg font-bold text-[#F8FAFC]">This group is private</h2>
                <p class="text-sm text-[#94A3B8] max-w-md mx-auto mt-2">
                    Posts, polls, discussions, and member activity in this group are reserved for approved members only.
                </p>
                <div class="mt-6">
                    @if (group.UserJoinStatus == "PENDING")
                    {
                        <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-500/10 text-amber-400 font-semibold text-sm rounded-xl border border-amber-500/30">
                            ⏳ Join Request Pending Approval
                        </span>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#14B8A6] hover:bg-[#0D9488] text-white font-semibold text-sm rounded-xl shadow-md transition">
                            <span>Request to Join Group</span>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Navigation Tabs: Feed, Polls, Members -->
            <div class="bg-[#1E293B] rounded-2xl shadow-sm border border-[rgba(241,245,249,0.08)] p-2 flex items-center gap-2">
                <button type="button" @onclick='() => activeTab = "feed"'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "feed" ? "bg-[#14B8A6] text-white shadow-sm" : "text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#334155]")">
                    📝 Group Feed (@(posts?.Count ?? 0))
                </button>
                <button type="button" @onclick='() => activeTab = "polls"'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "polls" ? "bg-[#6366F1] text-white shadow-sm" : "text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#334155]")">
                    📊 Live Polls (@(polls?.Count ?? 0))
                </button>
                <button type="button" @onclick='() => activeTab = "members"'
                        class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition text-center @(activeTab == "members" ? "bg-[#0EA5E9] text-white shadow-sm" : "text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#334155]")">
                    👥 Members (@(members?.Count ?? 0))
                </button>
            </div>

            <!-- Contextual Quick Action Header for Active Tab -->
            @if (activeTab == "polls")
            {
                <div class="flex items-center justify-between bg-[#1E293B] rounded-2xl border border-[rgba(241,245,249,0.08)] p-4 shadow-sm">
                    <div>
                        <h3 class="text-sm font-bold text-[#F8FAFC]">Group Polls</h3>
                        <p class="text-xs text-[#94A3B8]">Vote on active polls or start a new survey for this group.</p>
                    </div>
                    @if (group.IsJoined)
                    {
                        <button type="button" @onclick="OpenCreatePollModal"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#6366F1] hover:bg-[#4F46E5] text-white font-semibold text-xs sm:text-sm rounded-xl shadow-md transition active:scale-95 cursor-pointer">
                            <span>📊</span>
                            <span>Upload Group Poll</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#0F172A] hover:bg-[#6366F1]/20 text-[#818CF8] font-semibold text-xs rounded-xl border border-[rgba(99,102,241,0.3)] transition">
                            <span>Join group to create polls</span>
                        </button>
                    }
                </div>
            }
            else if (activeTab == "feed")
            {
                <div class="flex items-center justify-between bg-[#1E293B] rounded-2xl border border-[rgba(241,245,249,0.08)] p-4 shadow-sm">
                    <div>
                        <h3 class="text-sm font-bold text-[#F8FAFC]">Group Discussion</h3>
                        <p class="text-xs text-[#94A3B8]">Stay updated and connect with other members in this group.</p>
                    </div>
                    @if (group.IsJoined)
                    {
                        <button type="button" @onclick="OpenCreatePostModal"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#14B8A6] hover:bg-[#0D9488] text-white font-semibold text-xs sm:text-sm rounded-xl shadow-md transition active:scale-95">
                            <span>✍️ Create Post</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="JoinGroup"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-[#0F172A] hover:bg-[#14B8A6]/20 text-[#2DD4BF] font-semibold text-xs rounded-xl border border-[rgba(20,184,166,0.3)] transition">
                            <span>Join group to post</span>
                        </button>
                    }
                </div>
            }

            <!-- TAB 1: GROUP FEED -->
            @if (activeTab == "feed")
            {
                @if (isLoadingFeed)
                {
                    <div class="flex justify-center py-12">
                        <div class="animate-spin rounded-full h-8 w-8 border-4 border-[#14B8A6] border-t-transparent"></div>
                    </div>
                }
                else if (posts == null || posts.Count == 0)
                {
                    <div class="bg-[#1E293B] rounded-2xl border border-dashed border-[rgba(241,245,249,0.15)] p-12 text-center text-[#94A3B8]">
                        <div class="text-4xl mb-3">✍️</div>
                        <h4 class="font-semibold text-[#F8FAFC] text-base">No group posts yet</h4>
                        <p class="text-xs text-[#64748B] mt-1 max-w-sm mx-auto">
                            @(group.IsJoined ? "Start the conversation by sharing the first post in this group!" : "Join this group to share the first post.")
                        </p>
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="OpenCreatePostModal" class="mt-4 px-4 py-2 bg-[#14B8A6] hover:bg-[#0D9488] text-white text-xs font-semibold rounded-xl shadow transition">
                                Create Post Now
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var post in posts)
                        {
                            <div class="bg-[#1E293B] rounded-2xl shadow-sm border border-[rgba(241,245,249,0.08)] hover:border-[rgba(241,245,249,0.18)] overflow-hidden transition duration-200">
                                <!-- Post Author Header -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[rgba(241,245,249,0.08)]">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(post.AuthorAvatar))
                                        {
                                            <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-10 h-10 rounded-full object-cover border border-[rgba(241,245,249,0.12)]" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#CBD5E1] flex items-center justify-center font-bold text-sm">
                                                @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <h4 class="text-sm font-bold text-[#F8FAFC] leading-tight">@post.AuthorName</h4>
                                            <span class="text-[11px] text-[#64748B]">@post.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                    </div>

                                    @if (currentUserId.HasValue && post.AuthorId == currentUserId.Value)
                                    {
                                        <button type="button" @onclick="() => ConfirmDeletePost(post.PostId)"
                                                class="text-[#64748B] hover:text-rose-400 p-1.5 rounded-lg hover:bg-[#334155] transition" title="Delete Post">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        </button>
                                    }
                                </div>

                                <!-- Post Text Content -->
                                <div class="px-5 py-4 text-sm text-[#CBD5E1] leading-relaxed whitespace-pre-line">
                                    @post.Content
                                </div>

                                <!-- Post Images -->
                                @if (post.ImageUrls != null && post.ImageUrls.Count > 0)
                                {
                                    <div class="bg-[#060E20] flex items-center justify-center max-h-96 overflow-hidden border-t border-b border-[rgba(241,245,249,0.08)]">
                                        <img src="@post.ImageUrls[0]" alt="Post attachment" class="max-h-96 object-contain w-full" />
                                    </div>
                                }

                                <!-- Actions: Like, Comment, Share -->
                                <div class="px-4 py-2 flex items-center justify-between text-xs font-semibold text-[#94A3B8] bg-[#1E293B] border-t border-[rgba(241,245,249,0.08)]">
                                    <!-- Like -->
                                    <button type="button" @onclick="() => ToggleLike(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155] @(post.IsLikedByCurrentUser ? "text-red-400 font-semibold" : "")">
                                        <svg class="w-4 h-4 @(post.IsLikedByCurrentUser ? "fill-red-400 stroke-red-400" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                        </svg>
                                        <span>Like</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@post.LikeCount</span>
                                    </button>

                                    <!-- Comment -->
                                    <button type="button" @onclick="() => ToggleCommentBox(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155] @(openCommentPostIds.Contains(post.PostId) ? "text-[#2DD4BF] font-semibold" : "")">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                        </svg>
                                        <span>Comment</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@post.CommentCount</span>
                                    </button>

                                    <!-- Share -->
                                    <button type="button" @onclick="() => OpenShareModal(post.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155]">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                        </svg>
                                        <span>Share</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@post.ShareCount</span>
                                    </button>
                                </div>

                                <!-- Comments Drawer -->
                                @if (openCommentPostIds.Contains(post.PostId))
                                {
                                    <div class="border-t border-[rgba(241,245,249,0.08)] p-4 sm:p-5 bg-[#0F172A] space-y-4">
                                        <!-- Add Comment -->
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[rgba(20,184,166,0.15)] text-[#2DD4BF] border border-[rgba(20,184,166,0.3)] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                                                💬
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[post.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(post.PostId); })"
                                                       placeholder="Write a comment..."
                                                       class="w-full text-sm bg-[#1E293B] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#14B8A6]" />
                                                <button type="button" @onclick="() => SubmitComment(post.PostId)"
                                                        class="px-4 py-2 bg-[#14B8A6] hover:bg-[#0D9488] text-white rounded-xl text-xs font-semibold shadow transition">
                                                    Post
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Comments List -->
                                        @if (commentsByPost.TryGetValue(post.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                             {
                                                <p class="text-xs text-[#64748B] text-center py-2">No comments yet. Be the first to comment!</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#334155] text-[#CBD5E1] flex items-center justify-center font-bold shrink-0">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-[#1E293B] p-2.5 rounded-xl border border-[rgba(241,245,249,0.08)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <span class="font-semibold text-[#F8FAFC]">@comment.AuthorName</span>
                                                                    <span class="text-[10px] text-[#64748B]">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                                </div>
                                                                <p class="text-[#CBD5E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 2: LIVE POLLS -->
            @if (activeTab == "polls")
            {
                @if (polls == null || polls.Count == 0)
                {
                    <div class="bg-[#1E293B] rounded-2xl border border-dashed border-[rgba(241,245,249,0.15)] p-12 text-center text-[#94A3B8]">
                        <div class="text-4xl mb-3">📊</div>
                        <h4 class="font-semibold text-[#F8FAFC] text-base">No live polls in this group</h4>
                        <p class="text-xs text-[#64748B] mt-1 max-w-sm mx-auto">
                            @(group.IsJoined ? "Launch a poll to gather feedback or opinions from fellow members." : "Join this group to participate in or create polls.")
                        </p>
                        @if (group.IsJoined)
                        {
                            <button type="button" @onclick="OpenCreatePollModal"
                                    class="mt-4 px-5 py-2.5 bg-[#6366F1] hover:bg-[#4F46E5] text-white text-xs font-semibold rounded-xl shadow transition inline-flex items-center gap-1.5 cursor-pointer">
                                <span>📊</span>
                                <span>Upload Group Poll</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var poll in polls)
                        {
                            <div class="bg-[#1E293B] rounded-2xl shadow-sm border border-[rgba(241,245,249,0.08)] hover:border-[rgba(241,245,249,0.18)] overflow-hidden transition duration-200">
                                <!-- Poll Author Info -->
                                <div class="p-4 sm:p-5 flex items-center justify-between border-b border-[rgba(241,245,249,0.08)]">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#CBD5E1] flex items-center justify-center font-bold text-sm">
                                            @(string.IsNullOrWhiteSpace(poll.AuthorName) ? "U" : poll.AuthorName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-[#F8FAFC] leading-tight">@poll.AuthorName</h4>
                                            <span class="text-[11px] text-[#64748B]">@poll.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                    </div>
                                    @if (poll.ExpiresAt.HasValue)
                                    {
                                        <span class="text-xs px-2.5 py-1 rounded-full @(poll.IsExpired ? "bg-rose-500/10 text-rose-400 border border-rose-500/30" : "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30")">
                                            @(poll.IsExpired ? "Closed" : $"Ends {poll.ExpiresAt.Value.ToLocalTime():g}")
                                        </span>
                                    }
                                </div>

                                <!-- Poll Content & Question -->
                                <div class="px-5 pt-4 pb-2 space-y-2">
                                    <h3 class="text-base font-bold text-[#F8FAFC] leading-snug">@poll.Question</h3>
                                    @if (!string.IsNullOrWhiteSpace(poll.Content) && poll.Content != poll.Question)
                                    {
                                        <p class="text-xs text-[#CBD5E1] whitespace-pre-line leading-relaxed">@poll.Content</p>
                                    }
                                </div>

                                <!-- Poll Options & Voting -->
                                <div class="px-5 py-4 space-y-3">
                                    @foreach (var opt in poll.Options)
                                    {
                                        var hasUserVotedThis = opt.IsVotedByCurrentUser;
                                        <div class="relative overflow-hidden rounded-xl border border-[rgba(241,245,249,0.12)] bg-[#0F172A] p-3 transition hover:bg-[#334155]/50">
                                            <!-- Progress bar background -->
                                            <div class="absolute inset-y-0 left-0 bg-[rgba(99,102,241,0.2)] transition-all duration-500"
                                                 style="width: @(opt.Percentage)%"></div>

                                            <div class="relative flex items-center justify-between gap-3 text-xs sm:text-sm">
                                                <div class="flex items-center gap-2.5 flex-1">
                                                    @if (!poll.HasVoted && !poll.IsExpired)
                                                    {
                                                        <button type="button" @onclick="() => Vote(poll.PollId, opt.OptionId)"
                                                                class="w-5 h-5 rounded-full border-2 border-[#6366F1] hover:bg-[#6366F1] transition flex items-center justify-center shrink-0">
                                                            <div class="w-2 h-2 rounded-full bg-white opacity-0 hover:opacity-100"></div>
                                                        </button>
                                                    }
                                                    else if (hasUserVotedThis)
                                                    {
                                                        <div class="w-5 h-5 rounded-full bg-[#6366F1] text-white flex items-center justify-center text-xs shrink-0 shadow-xs">
                                                            ✓
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="w-5 h-5 rounded-full border border-[rgba(241,245,249,0.2)] shrink-0"></div>
                                                    }
                                                    <span class="font-medium text-[#F8FAFC] @(hasUserVotedThis ? "font-semibold text-[#818CF8]" : "")">
                                                        @opt.Text
                                                    </span>
                                                </div>
                                                <div class="text-right shrink-0">
                                                    <span class="text-xs font-bold text-[#818CF8]">@opt.Percentage%</span>
                                                    <span class="text-[11px] text-[#64748B] ml-1">(@opt.VoteCount)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Poll Summary Footer -->
                                <div class="px-5 py-2.5 bg-[#0F172A] border-t border-[rgba(241,245,249,0.08)] flex items-center justify-between text-xs text-[#94A3B8]">
                                    <div class="flex items-center gap-2">
                                        <span>👥 @poll.TotalVotes total votes</span>
                                        <span>•</span>
                                        <span>@(poll.IsMultipleChoice ? "Multiple votes allowed" : "Single choice")</span>
                                    </div>
                                    @if (poll.HasVoted)
                                    {
                                        <span class="text-[#818CF8] font-semibold flex items-center gap-1">
                                            <span>✓</span> You voted
                                        </span>
                                    }
                                    else if (poll.IsExpired)
                                    {
                                        <span class="text-rose-400 font-medium">Voting ended</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#2DD4BF] font-medium">Click an option to vote</span>
                                    }
                                </div>

                                <!-- Actions: Like, Comment, Share on Poll -->
                                <div class="px-4 py-2 flex items-center justify-between text-xs font-semibold text-[#94A3B8] bg-[#1E293B] border-t border-[rgba(241,245,249,0.08)]">
                                    <button type="button" @onclick="() => ToggleLike(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155] @(poll.IsLikedByCurrentUser ? "text-red-400 font-semibold" : "")">
                                        <svg class="w-4 h-4 @(poll.IsLikedByCurrentUser ? "fill-red-400 stroke-red-400" : "fill-none stroke-current")" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                        </svg>
                                        <span>Like</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@poll.LikeCount</span>
                                    </button>

                                    <button type="button" @onclick="() => ToggleCommentBox(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155] @(openCommentPostIds.Contains(poll.PostId) ? "text-[#818CF8] font-semibold" : "")">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                        </svg>
                                        <span>Comment</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@poll.CommentCount</span>
                                    </button>

                                    <button type="button" @onclick="() => OpenShareModal(poll.PostId)"
                                            class="flex-1 inline-flex items-center justify-center gap-2 py-2 rounded-xl transition hover:bg-[#334155]">
                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                        </svg>
                                        <span>Share</span>
                                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-[#0F172A] text-[#CBD5E1]">@poll.ShareCount</span>
                                    </button>
                                </div>

                                <!-- Poll Comments Drawer -->
                                @if (openCommentPostIds.Contains(poll.PostId))
                                {
                                    <div class="border-t border-[rgba(241,245,249,0.08)] p-4 sm:p-5 bg-[#0F172A] space-y-4">
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-[rgba(99,102,241,0.15)] text-[#818CF8] border border-[rgba(99,102,241,0.3)] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                                                💬
                                            </div>
                                            <div class="flex-1 flex gap-2">
                                                <input type="text" @bind="commentInputs[poll.PostId]"
                                                       @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitComment(poll.PostId); })"
                                                       placeholder="Comment on this poll..."
                                                       class="w-full text-sm bg-[#1E293B] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#6366F1]" />
                                                <button type="button" @onclick="() => SubmitComment(poll.PostId)"
                                                        class="px-4 py-2 bg-[#6366F1] hover:bg-[#4F46E5] text-white rounded-xl text-xs font-semibold shadow transition">
                                                    Post
                                                </button>
                                            </div>
                                        </div>

                                        @if (commentsByPost.TryGetValue(poll.PostId, out var commentList) && commentList != null)
                                        {
                                            if (commentList.Count == 0)
                                            {
                                                <p class="text-xs text-[#64748B] text-center py-2">No comments yet.</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-3 pt-2">
                                                    @foreach (var comment in commentList)
                                                    {
                                                        <div class="flex items-start gap-2.5 text-xs">
                                                            <div class="w-7 h-7 rounded-full bg-[#334155] text-[#CBD5E1] flex items-center justify-center font-bold shrink-0">
                                                                @(string.IsNullOrWhiteSpace(comment.AuthorName) ? "U" : comment.AuthorName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div class="flex-1 bg-[#1E293B] p-2.5 rounded-xl border border-[rgba(241,245,249,0.08)]">
                                                                <div class="flex items-center justify-between gap-2 mb-1">
                                                                    <span class="font-semibold text-[#F8FAFC]">@comment.AuthorName</span>
                                                                    <span class="text-[10px] text-[#64748B]">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                                                </div>
                                                                <p class="text-[#CBD5E1] whitespace-pre-line">@comment.Content</p>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- TAB 3: MEMBERS -->
            @if (activeTab == "members")
            {
                @if (members == null || members.Count == 0)
                {
                    <p class="text-xs text-[#64748B] text-center py-6">No members listed.</p>
                }
                else
                {
                    <div class="bg-[#1E293B] rounded-2xl border border-[rgba(241,245,249,0.08)] overflow-hidden divide-y divide-[rgba(241,245,249,0.08)]">
                        @foreach (var m in members)
                        {
                            <div class="p-3.5 flex items-center justify-between text-xs hover:bg-[#334155]/30 transition">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-[rgba(20,184,166,0.15)] text-[#2DD4BF] border border-[rgba(20,184,166,0.3)] flex items-center justify-center font-bold">
                                        @(string.IsNullOrWhiteSpace(m.DisplayName) ? "U" : m.DisplayName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <span class="font-semibold text-[#F8FAFC]">@m.DisplayName</span>
                                        <span class="text-[10px] text-[#64748B] block">@@@m.UserName</span>
                                    </div>
                                </div>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(m.Role == "Owner" ? "bg-[rgba(99,102,241,0.15)] text-[#818CF8] border border-[rgba(99,102,241,0.3)]" : (m.Role == "Admin" ? "bg-[rgba(20,184,166,0.15)] text-[#2DD4BF] border border-[rgba(20,184,166,0.3)]" : "bg-[#0F172A] text-[#94A3B8] border border-[rgba(241,245,249,0.08)]"))">
                                    @m.Role
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        }
    }
</div>

<!-- ================= MODAL: CREATE GROUP POST ================= -->
@if (showPostModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#060E20]/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-[#1E293B] rounded-2xl shadow-2xl border border-[rgba(20,184,166,0.3)] w-full max-w-lg overflow-hidden text-[#F8FAFC]">
            <div class="px-5 py-4 border-b border-[rgba(241,245,249,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">✍️</span>
                    <h3 class="font-bold text-[#F8FAFC] text-sm">Post to @group?.Name</h3>
                </div>
                <button type="button" @onclick="() => showPostModal = false" class="text-[#64748B] hover:text-[#F8FAFC]">✕</button>
            </div>
            <div class="p-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#CBD5E1] mb-1">What's on your mind? *</label>
                    <textarea @bind="newPostText" rows="4" placeholder="Share thoughts, news, or questions with the group..."
                              class="w-full text-sm bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl p-3 focus:outline-none focus:ring-1 focus:ring-[#14B8A6]"></textarea>
                </div>

                <!-- Image Attachment -->
                <div>
                    <label class="block text-xs font-semibold text-[#CBD5E1] mb-1">Attach Image (Optional)</label>
                    @if (string.IsNullOrEmpty(uploadedImageUrl))
                    {
                        <div class="relative border-2 border-dashed border-[rgba(241,245,249,0.15)] rounded-xl p-4 text-center hover:border-[#14B8A6]/50 transition bg-[#0F172A]">
                            <InputFile OnChange="HandleFileSelected" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                            @if (isUploadingImage)
                            {
                                <div class="flex items-center justify-center gap-2 text-xs text-[#2DD4BF] font-medium">
                                    <span class="animate-spin">⏳</span> Uploading image...
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center">
                                    <span class="text-xl mb-1">🖼️</span>
                                    <span class="text-xs font-semibold text-[#CBD5E1]">Click to upload an image</span>
                                    <span class="text-[10px] text-[#64748B]">PNG, JPG, WebP up to 10MB</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="relative rounded-xl overflow-hidden border border-[rgba(241,245,249,0.12)] max-h-48 bg-[#060E20] flex items-center justify-center">
                            <img src="@uploadedImageUrl" alt="Preview" class="max-h-48 object-contain" />
                            <button type="button" @onclick="() => uploadedImageUrl = null"
                                    class="absolute top-2 right-2 bg-rose-600 hover:bg-rose-700 text-white rounded-full p-1.5 shadow transition text-xs font-bold" title="Remove image">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="px-5 py-3 bg-[#0F172A] border-t border-[rgba(241,245,249,0.08)] flex justify-end gap-2">
                <button type="button" @onclick="() => showPostModal = false" class="px-4 py-2 text-xs font-semibold text-[#94A3B8] hover:bg-[#334155] rounded-xl transition">Cancel</button>
                <button type="button" @onclick="SubmitGroupPost" disabled="@(isSubmitting || isUploadingImage)" class="px-5 py-2 text-xs font-semibold bg-[#14B8A6] hover:bg-[#0D9488] text-white rounded-xl shadow transition disabled:opacity-50 flex items-center gap-2">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span>Publish Post</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: CREATE GROUP POLL ================= -->
@if (showPollModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#060E20]/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-[#1E293B] rounded-2xl shadow-2xl border border-[rgba(99,102,241,0.3)] w-full max-w-lg overflow-hidden text-[#F8FAFC]">
            <div class="px-5 py-4 border-b border-[rgba(241,245,249,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">📊</span>
                    <h3 class="font-bold text-[#F8FAFC] text-sm">Create Poll in @group?.Name</h3>
                </div>
                <button type="button" @onclick="() => showPollModal = false" class="text-[#64748B] hover:text-[#F8FAFC]">✕</button>
            </div>
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-semibold text-[#CBD5E1] mb-1">Question *</label>
                    <input type="text" @bind="newPollQuestion" placeholder="e.g. Which project should we prioritize next?"
                           class="w-full text-sm bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#6366F1]" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#CBD5E1] mb-1">Details / Context (Optional)</label>
                    <textarea @bind="newPollDescription" rows="2" placeholder="Add extra details or guidelines for voters..."
                              class="w-full text-sm bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-[#6366F1]"></textarea>
                </div>

                <!-- Custom Duration Picker -->
                <div class="p-3 bg-[#0F172A] rounded-xl border border-[rgba(99,102,241,0.2)] space-y-2">
                    <span class="block text-xs font-bold text-[#818CF8]">Poll Duration</span>
                    <div class="grid grid-cols-3 gap-2 text-xs">
                        <div>
                            <label class="text-[11px] text-[#94A3B8] block mb-0.5">Days</label>
                            <input type="number" min="0" max="365" @bind="pollDurationDays"
                                   class="w-full bg-[#1E293B] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#94A3B8] block mb-0.5">Hours</label>
                            <input type="number" min="0" max="23" @bind="pollDurationHours"
                                   class="w-full bg-[#1E293B] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                        <div>
                            <label class="text-[11px] text-[#94A3B8] block mb-0.5">Minutes</label>
                            <input type="number" min="0" max="59" @bind="pollDurationMinutes"
                                   class="w-full bg-[#1E293B] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] rounded-lg px-2 py-1.5 text-center text-xs font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- Dynamic Poll Options -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-[#CBD5E1]">Poll Options * (Min 2, Max 10)</label>
                        @if (pollOptionsList.Count < 10)
                        {
                            <button type="button" @onclick="AddPollOption" class="text-xs font-semibold text-[#818CF8] hover:text-[#6366F1]">
                                + Add Option
                            </button>
                        }
                    </div>

                    <div class="space-y-2">
                        @for (int i = 0; i < pollOptionsList.Count; i++)
                        {
                            var index = i;
                            var labelChar = (char)('A' + index);
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-[rgba(99,102,241,0.15)] text-[#818CF8] font-bold text-xs flex items-center justify-center shrink-0 border border-[rgba(99,102,241,0.3)]">
                                    @labelChar
                                </span>
                                <input type="text"
                                       value="@pollOptionsList[index]"
                                       @onchange="(e) => pollOptionsList[index] = e.Value?.ToString() ?? string.Empty"
                                       placeholder="@($"Option {labelChar}")"
                                       class="flex-1 text-sm bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#6366F1]" />
                                @if (pollOptionsList.Count > 2)
                                {
                                    <button type="button" @onclick="() => RemovePollOption(index)" class="p-1.5 text-[#64748B] hover:text-rose-400 transition" title="Remove option">
                                        ✕
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Multiple Choice Toggle -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="grpMultiChoice" @bind="pollIsMultipleChoice" class="rounded text-[#6366F1] focus:ring-[#6366F1] bg-[#0F172A] border-[rgba(241,245,249,0.2)]" />
                    <label for="grpMultiChoice" class="text-xs font-medium text-[#CBD5E1] cursor-pointer">Allow voters to select multiple choices</label>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#0F172A] border-t border-[rgba(241,245,249,0.08)] flex items-center justify-end gap-2">
                <button type="button" @onclick="() => showPollModal = false" class="px-4 py-2 text-xs font-semibold text-[#94A3B8] hover:bg-[#334155] rounded-xl transition">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitGroupPoll" disabled="@isSubmitting"
                        class="px-5 py-2.5 text-xs font-bold bg-[#6366F1] hover:bg-[#4F46E5] text-white rounded-xl shadow-md transition disabled:opacity-50 flex items-center gap-2 cursor-pointer active:scale-95">
                    @if (isSubmitting)
                    {
                        <span class="animate-spin text-sm">⏳</span>
                        <span>Creating Poll...</span>
                    }
                    else
                    {
                        <span class="text-sm">📊</span>
                        <span>Publish Group Poll</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL: SHARE POST / POLL ================= -->
@if (showShareModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#060E20]/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-[#1E293B] rounded-2xl shadow-2xl border border-[rgba(99,102,241,0.3)] w-full max-w-md overflow-hidden text-[#F8FAFC]">
            <div class="px-5 py-4 border-b border-[rgba(241,245,249,0.08)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🚀</span>
                    <h3 class="font-bold text-[#F8FAFC] text-sm">Share to Your Network</h3>
                </div>
                <button type="button" @onclick="() => showShareModal = false" class="text-[#64748B] hover:text-[#F8FAFC]">✕</button>
            </div>
            <div class="p-5 space-y-3">
                <p class="text-xs text-[#94A3B8]">Share this group update with other members. You can optionally add a note with your thoughts.</p>
                <div>
                    <label class="block text-xs font-semibold text-[#CBD5E1] mb-1">Share Note <span class="text-[#64748B] font-normal">(Optional)</span></label>
                    <textarea @bind="shareNoteText" rows="3" placeholder="Add your perspective (optional)..."
                              class="w-full text-sm bg-[#0F172A] border border-[rgba(241,245,249,0.12)] text-[#F8FAFC] placeholder-[#64748B] rounded-xl p-3 focus:outline-none focus:ring-1 focus:ring-[#6366F1]"></textarea>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#0F172A] border-t border-[rgba(241,245,249,0.08)] flex justify-end gap-2">
                <button type="button" @onclick="() => showShareModal = false" class="px-4 py-2 text-xs font-semibold text-[#94A3B8] hover:bg-[#334155] rounded-xl transition">Cancel</button>
                <button type="button" @onclick="SubmitShare" disabled="@isSubmitting" class="px-5 py-2 text-xs font-semibold bg-[#6366F1] hover:bg-[#4F46E5] text-white rounded-xl shadow transition disabled:opacity-50">
                    Share Now
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int groupId { get; set; }

    private GroupModel? group;
    private IReadOnlyList<PostModel>? posts;
    private IReadOnlyList<PollModel>? polls;
    private IReadOnlyList<GroupMemberModel>? members;

    private int? currentUserId;
    private bool isLoadingGroup = true;
    private bool isLoadingFeed = true;
    private bool isSubmitting;
    private string activeTab = "feed";

    // Social Interactions
    private HashSet<int> openCommentPostIds = [];
    private Dictionary<int, string> commentInputs = [];
    private Dictionary<int, IReadOnlyList<CommentModel>> commentsByPost = [];

    // Share Modal
    private bool showShareModal;
    private int sharingPostId;
    private string shareNoteText = "";

    // Create Post Modal State
    private bool showPostModal;
    private string newPostText = "";
    private string? uploadedImageUrl;
    private bool isUploadingImage;

    // Create Poll Modal State
    private bool showPollModal;
    private string newPollQuestion = "";
    private string newPollDescription = "";
    private int pollDurationDays = 1;
    private int pollDurationHours = 0;
    private int pollDurationMinutes = 0;
    private bool pollIsMultipleChoice;
    private List<string> pollOptionsList = ["", ""];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var sub = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (int.TryParse(sub, out var uid))
        {
            currentUserId = uid;
        }

        await LoadGroupData();
    }

    private async Task LoadGroupData()
    {
        isLoadingGroup = true;
        var res = await GroupApi.GetGroupByIdAsync(groupId);
        if (res.IsSuccess && res.Data != null)
        {
            group = res.Data;
            if (group.Visibility != "PRIVATE" || group.IsJoined)
            {
                await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls(), LoadGroupMembers());
            }
        }
        isLoadingGroup = false;
    }

    private async Task LoadGroupPosts()
    {
        isLoadingFeed = true;
        var res = await PostApi.GetFeedAsync(groupId: groupId);
        if (res.IsSuccess)
        {
            posts = res.Data;
            foreach (var p in posts ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
        isLoadingFeed = false;
    }

    private async Task LoadGroupPolls()
    {
        var res = await PollApi.GetPollsAsync(groupId: groupId);
        if (res.IsSuccess)
        {
            polls = res.Data;
            foreach (var p in polls ?? [])
            {
                if (!commentInputs.ContainsKey(p.PostId)) commentInputs[p.PostId] = "";
            }
        }
    }

    private async Task LoadGroupMembers()
    {
        var res = await GroupApi.GetGroupMembersAsync(groupId);
        if (res.IsSuccess) members = res.Data;
    }

    private async Task JoinGroup()
    {
        var res = await GroupApi.JoinGroupAsync(groupId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? "Joined!");
            await LoadGroupData();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to join.");
        }
    }

    private async Task LeaveGroup()
    {
        var res = await GroupApi.LeaveGroupAsync(groupId);
        if (res.IsSuccess)
        {
            Toast.Success("Left group.");
            await LoadGroupData();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to leave.");
        }
    }

    private void OpenCreatePostModal()
    {
        newPostText = "";
        uploadedImageUrl = null;
        showPostModal = true;
    }

    private void OpenCreatePollModal()
    {
        newPollQuestion = "";
        newPollDescription = "";
        pollDurationDays = 1;
        pollDurationHours = 0;
        pollDurationMinutes = 0;
        pollIsMultipleChoice = false;
        pollOptionsList = ["", ""];
        showPollModal = true;
    }

    private void AddPollOption()
    {
        if (pollOptionsList.Count < 10)
        {
            pollOptionsList.Add("");
        }
    }

    private void RemovePollOption(int index)
    {
        if (pollOptionsList.Count > 2 && index >= 0 && index < pollOptionsList.Count)
        {
            pollOptionsList.RemoveAt(index);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            isUploadingImage = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedImageUrl = $"/uploads/{uniqueFileName}";
            Toast.Success("Image uploaded!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to process image: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task SubmitGroupPost()
    {
        if (string.IsNullOrWhiteSpace(newPostText))
        {
            Toast.Warning("Post content cannot be empty.");
            return;
        }

        isSubmitting = true;
        var images = string.IsNullOrWhiteSpace(uploadedImageUrl) ? null : new List<string> { uploadedImageUrl };
        var res = await PostApi.CreatePostAsync(new CreatePostRequestModel(null, newPostText, images, groupId));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group post published!");
            showPostModal = false;
            newPostText = "";
            uploadedImageUrl = null;
            activeTab = "feed";
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create post.");
        }
    }

    private async Task SubmitGroupPoll()
    {
        if (string.IsNullOrWhiteSpace(newPollQuestion))
        {
            Toast.Warning("Please specify a poll question.");
            return;
        }

        var validOptions = pollOptionsList.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        if (validOptions.Count < 2)
        {
            Toast.Warning("A poll must contain at least 2 non-empty options.");
            return;
        }

        DateTime? expiresAt = null;
        var totalMinutes = (pollDurationDays * 24 * 60) + (pollDurationHours * 60) + pollDurationMinutes;
        if (totalMinutes > 0)
        {
            expiresAt = DateTime.UtcNow.AddMinutes(totalMinutes);
        }

        isSubmitting = true;
        var desc = string.IsNullOrWhiteSpace(newPollDescription) ? newPollQuestion : newPollDescription;
        var req = new CreatePollRequestModel(null, newPollQuestion, desc, pollIsMultipleChoice, expiresAt, validOptions, groupId);

        var res = await PollApi.CreatePollAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Group poll created successfully!");
            showPollModal = false;
            activeTab = "polls";
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to create poll.");
        }
    }

    // Social Interactions
    private async Task ToggleLike(int postId)
    {
        var res = await PostApi.LikePostAsync(postId);
        if (res.IsSuccess)
        {
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update like.");
        }
    }

    private async Task ToggleCommentBox(int postId)
    {
        if (openCommentPostIds.Contains(postId))
        {
            openCommentPostIds.Remove(postId);
        }
        else
        {
            openCommentPostIds.Add(postId);
            await LoadComments(postId);
        }
    }

    private async Task LoadComments(int postId)
    {
        var res = await PostApi.GetCommentsAsync(postId);
        if (res.IsSuccess && res.Data != null)
        {
            commentsByPost[postId] = res.Data;
        }
    }

    private async Task SubmitComment(int postId)
    {
        if (!commentInputs.TryGetValue(postId, out var content) || string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var res = await PostApi.AddCommentAsync(new CreateCommentRequestModel(postId, content));
        if (res.IsSuccess)
        {
            commentInputs[postId] = "";
            await LoadComments(postId);
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to post comment.");
        }
    }

    private void OpenShareModal(int postId)
    {
        sharingPostId = postId;
        shareNoteText = "";
        showShareModal = true;
    }

    private async Task SubmitShare()
    {
        isSubmitting = true;
        var res = await PostApi.SharePostAsync(sharingPostId, new SharePostRequestModel(shareNoteText));
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Shared successfully!");
            showShareModal = false;
            await Task.WhenAll(LoadGroupPosts(), LoadGroupPolls());
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to share.");
        }
    }

    private async Task Vote(int pollId, int optionId)
    {
        var res = await PollApi.VoteAsync(new VoteRequestModel(pollId, [optionId]));
        if (res.IsSuccess)
        {
            Toast.Success("Vote recorded!");
            await LoadGroupPolls();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to submit vote.");
        }
    }

    private async Task ConfirmDeletePost(int postId)
    {
        var res = await PostApi.DeletePostAsync(postId);
        if (res.IsSuccess)
        {
            Toast.Success("Post deleted.");
            await LoadGroupPosts();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete post.");
        }
    }
}
