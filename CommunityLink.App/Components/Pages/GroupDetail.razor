            </div>
            <div class="p-5 space-y-3">
                <p class="text-xs text-[#557392] dark:text-[#7A8CA6]">@Loc["GroupDetail_Modal_ShareDesc"]</p>
                <div>
                    <label class="block text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] mb-1">@Loc["GroupDetail_Modal_ShareNoteLabel"] <span class="text-[#557392] dark:text-[#7A8CA6] font-normal">(@Loc["Common_Optional"])</span></label>
                    <textarea @bind="shareNoteText" rows="3" placeholder="@Loc["GroupDetail_Modal_ShareNotePlaceholder"]"
                              class="w-full text-sm bg-[#F8FAFC] dark:bg-[#0A1B2E] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.2)] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#557392] dark:placeholder-[#7A8CA6] rounded p-3 focus:outline-none focus:border-[#0A1B2E] dark:focus:border-[rgba(196,210,225,0.35)]"></textarea>
                </div>
            </div>
            <div class="px-5 py-3 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.08)] flex justify-end gap-2">
                <button type="button" @onclick="() => showShareModal = false" class="px-4 py-2 text-xs font-semibold text-[#557392] dark:text-[#7A8CA6] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded transition">@Loc["Common_Cancel"]</button>
                <button type="button" @onclick="SubmitShare" disabled="@isSubmitting" class="px-5 py-2 text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] rounded shadow-sm transition disabled:opacity-50">
                    @Loc["GroupDetail_Modal_ShareNowBtn"]
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= MODAL: EDIT POST ================= -->
@if (showEditPostModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                <h3 class="font-bold text-slate-900 dark:text-[#E1E8F0] text-base flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    <span>@Loc["GroupDetail_Modal_EditPostTitle"]</span>
                </h3>
                <button type="button" @onclick="() => showEditPostModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-lg">&times;</button>
            </div>
            <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-500 dark:text-[#C4D2E1]">@Loc["GroupDetail_Modal_EditPostDescLabel"]</label>
                <textarea @bind="editingPostContent" rows="5" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#0A1B2E] text-slate-900 dark:text-[#E1E8F0] focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none resize-none transition" placeholder="@Loc["GroupDetail_Modal_EditPostPlaceholder"]"></textarea>
                <p class="text-[11px] text-slate-400 dark:text-[#7A8CA6]">@Loc["GroupDetail_Modal_EditPostNote"]</p>
            </div>
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" @onclick="() => showEditPostModal = false" class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SaveEditPostAsync" disabled="@(isSavingEditPost || string.IsNullOrWhiteSpace(editingPostContent))" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-xs font-bold rounded-xl transition shadow-md shadow-indigo-600/20 flex items-center gap-2 cursor-pointer">
                    @if (isSavingEditPost)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["GroupDetail_Modal_Saving"]</span>
                    }
                    else
                    {
                        <span>@Loc["GroupDetail_Modal_SaveChangesBtn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= MODAL: EDIT POLL ================= -->
@if (showEditPollModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                <h3 class="font-bold text-slate-900 dark:text-[#E1E8F0] text-base flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    <span>@Loc["GroupDetail_Modal_EditPollTitle"]</span>
                </h3>
                <button type="button" @onclick="() => showEditPollModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-lg">&times;</button>
