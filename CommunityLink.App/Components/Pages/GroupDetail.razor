<!-- ================= MODAL: RATE / REVIEW GROUP ================= -->
@if (showRatingModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-3xl shadow-2xl border border-slate-200 dark:border-[rgba(196,210,225,0.15)] w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150 p-6 space-y-5 text-[#0A1B2E] dark:text-[#E1E8F0]">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 fill-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    <h3 class="font-bold text-base text-slate-900 dark:text-[#E1E8F0]">
                        @(ratingSummary?.UserRating != null ? Loc["GroupDetail_Ratings_EditYourReview"] : Loc["GroupDetail_Ratings_RateThisGroup"])
                    </h3>
                </div>
                <button type="button" @onclick="CloseRatingModal" class="text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer">✕</button>
            </div>
            <div class="text-center space-y-3">
                <p class="text-xs text-slate-500 dark:text-[#C4D2E1]">@string.Format(Loc["GroupDetail_Modal_RatePrompt"], group?.Name)</p>
                
                <!-- Interactive Star Selector -->
                <div class="flex items-center justify-center gap-2 text-3xl py-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starScore = i;
                        <button type="button" @onclick="() => selectedRatingScore = starScore" class="transition-transform hover:scale-125 cursor-pointer focus:outline-none">
                            <span class="@(starScore <= selectedRatingScore ? "text-blue-500 dark:text-blue-400" : "text-slate-200 dark:text-slate-700")">★</span>
                        </button>
                    }
                </div>
                <div class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
                    @string.Format(Loc["GroupDetail_Modal_StarCount"], selectedRatingScore)
                </div>
                <div class="text-left mt-2">
                    <label class="block text-xs font-bold text-slate-700 dark:text-[#C4D2E1] uppercase tracking-wider mb-1">@Loc["GroupDetail_Modal_ReviewCommentsLabel"]</label>
                    <textarea @bind="ratingReviewText" rows="3" maxlength="1000" class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-[#0A1B2E] text-slate-900 dark:text-[#E1E8F0] focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="@Loc["GroupDetail_Modal_ReviewPlaceholder"]"></textarea>
                    <div class="text-[11px] text-slate-400 text-right mt-0.5">@(ratingReviewText?.Length ?? 0)/1000</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ratingErrorMessage))
            {
                <div class="p-3 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs rounded-xl font-medium">
                    @ratingErrorMessage
                </div>
            }
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" @onclick="CloseRatingModal" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-[#C4D2E1] hover:bg-slate-100 dark:hover:bg-[#1B3B5A] transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitRatingAsync" disabled="@isSubmittingRating" class="px-5 py-2.5 rounded-xl text-xs font-semibold bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white text-white dark:text-[#0A1B2E] transition shadow-sm border border-[#0A1B2E] dark:border-white flex items-center gap-2 cursor-pointer">
                    @if (isSubmittingRating)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>@Loc["GroupDetail_Modal_Submitting"]</span>
                    }
                    else
                    {
                        <span>@(ratingSummary?.UserRating != null ? Loc["GroupDetail_Modal_UpdateReviewBtn"] : Loc["GroupDetail_Modal_SubmitReviewBtn"])</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= UPCOMING REQUESTS MODAL (For Group Owner/Admins) ================= -->
@if (showRequestsModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#112A46] rounded-3xl shadow-2xl border border-slate-200 dark:border-[rgba(196,210,225,0.20)] w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150 p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="p-2 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-base text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["GroupDetail_Requests_Title"]</h3>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@string.Format(Loc["GroupDetail_Requests_Subtitle"], group?.Name)</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseRequestsModal" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer">✕</button>
            </div>
            <div class="space-y-3 max-h-[60vh] overflow-y-auto pr-1">
                @if (isLoadingRequests)
                {
                    <div class="text-center py-8">
                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-indigo-600 border-t-transparent"></div>
                        <p class="text-xs text-[#557392] dark:text-[#C4D2E1] mt-2">@Loc["GroupDetail_Requests_Loading"]</p>
                    </div>
                }
                else if (pendingJoinRequests == null || pendingJoinRequests.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-center py-10 px-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                        </div>
                        <p class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["GroupDetail_Requests_EmptyTitle"]</p>
                        <p class="text-[11px] text-[#7A8CA6] mt-0.5">@Loc["GroupDetail_Requests_EmptySubtitle"]</p>
                    </div>
                }
                else
                {
                    @foreach (var req in pendingJoinRequests)
                    {
                        <div class="p-4 rounded-2xl bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-bold text-xs text-[#0A1B2E] dark:text-white truncate">@req.UserName</span>
                                <span class="text-[10px] font-mono text-[#7A8CA6] shrink-0">@req.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                            </div>
                            <p class="text-xs text-[#557392] dark:text-[#C4D2E1]">@req.UserEmail</p>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNote))
                            {
                                <p class="text-xs text-[#0A1B2E] dark:text-[#E1E8F0] bg-white dark:bg-[#112A46] rounded-xl p-2.5 border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] italic">
                                    "@req.RequestNote"
                                </p>
                            }
                            <div class="flex items-center justify-end gap-2 pt-2">
                                <button type="button" @onclick="() => ReviewRequestAsync(req.GroupJoinRequestId, false)"
                                        class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[#557392] dark:text-[#C4D2E1] rounded-xl text-xs font-semibold transition cursor-pointer">
                                    @Loc["GroupDetail_Requests_RejectBtn"]
                                </button>
                                <button type="button" @onclick="() => ReviewRequestAsync(req.GroupJoinRequestId, true)"
                                        class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition shadow-xs cursor-pointer">
                                    @Loc["GroupDetail_Requests_ApproveBtn"]
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="pt-3 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex justify-end">
                <button type="button" @onclick="CloseRequestsModal"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-[#0A1B2E] dark:text-[#E1E8F0] text-xs font-semibold rounded-xl cursor-pointer">
                    @Loc["Common_Close"]
                </button>
            </div>
        </div>
    </div>
}
<!-- ================= POST BANNED REASON MODAL ================= -->
