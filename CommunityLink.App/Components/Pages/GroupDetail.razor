    private string FormatTimeAgo(DateTime utcDate)
    {
        var utc = utcDate.Kind == DateTimeKind.Utc 
            ? utcDate 
            : (utcDate.Kind == DateTimeKind.Local
                ? utcDate.ToUniversalTime()
                : DateTime.SpecifyKind(utcDate, DateTimeKind.Utc));
        var span = DateTime.UtcNow - utc;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalSeconds < 60) return Loc["GroupDetail_Time_JustNow"];
        if (span.TotalMinutes < 60) return string.Format(CultureInfo.CurrentCulture, Loc["GroupDetail_Time_MinutesAgo"], Math.Max(1, (int)span.TotalMinutes));
        if (span.TotalHours < 24) return string.Format(CultureInfo.CurrentCulture, Loc["GroupDetail_Time_HoursAgo"], Math.Max(1, (int)span.TotalHours));
        return utc.ToLocalTime().ToString("dd-MM-yyyy");
    }
    private string GetMemberRoleLocalized(string? role)
    {
        if (string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)) return Loc["GroupDetail_Role_Owner"];
        if (string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase)) return Loc["GroupDetail_Role_Admin"];
        if (string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase)) return Loc["GroupDetail_Role_Member"];
        return role ?? string.Empty;
    }
    public sealed record AttachedTextFileItem(string FileName, string Content, string? FileUrl = null, long? FileSizeBytes = null);
    private static List<AttachedTextFileItem> ParseGroupTextFiles(string codeSnippet, string? codeFileName)
    {
        var list = new List<AttachedTextFileItem>();
        if (string.IsNullOrWhiteSpace(codeSnippet)) return list;
        if (codeSnippet.TrimStart().StartsWith("[") && codeSnippet.Contains("\"FileName\""))
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<AttachedTextFileItem>>(codeSnippet, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (parsed != null && parsed.Count > 0)
                {
                    return parsed;
                }
            }
            catch { }
        }
        list.Add(new AttachedTextFileItem(string.IsNullOrWhiteSpace(codeFileName) ? "attachment.txt" : codeFileName, codeSnippet));
        return list;
    }
    private static string FormatGroupFileSize(long? bytes)
    {
        if (!bytes.HasValue || bytes <= 0) return string.Empty;
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes.Value / 1024.0:F1} KB";
        return $"{bytes.Value / (1024.0 * 1024.0):F1} MB";
    }
    private async Task CopyGroupSnippetAsync(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success("Copied to clipboard!");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to copy: {ex.Message}");
        }
    }
