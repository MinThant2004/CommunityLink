@inject IJSRuntime JS
@inject ToastService Toast

<div class="flex flex-col @(Message.IsMine ? "items-end" : "items-start") group relative my-1.5">
    <div class="flex items-end gap-2.5 max-w-[85%] sm:max-w-[75%] @(Message.IsMine ? "flex-row-reverse" : "flex-row") min-w-0">
        <!-- Sender Avatar (for incoming messages) -->
        @if (!Message.IsMine)
        {
            if (ShowHeader)
            {
                <div class="w-8 h-8 rounded-full bg-slate-200 border border-slate-300 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden mb-1 shadow-xs">
                    @if (!string.IsNullOrWhiteSpace(Message.SenderAvatar))
                    {
                        <img src="@Message.SenderAvatar" alt="@Message.SenderDisplayName" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span>@(Message.SenderDisplayName.Substring(0, 1).ToUpper())</span>
                    }
                </div>
            }
            else
            {
                <div class="w-8 shrink-0"></div>
            }
        }

        <!-- Bubble Container -->
        <div class="relative group/bubble min-w-0">
            <div class="px-4 py-2.5 rounded-xl text-xs sm:text-sm leading-relaxed whitespace-pre-wrap break-words shadow-xs
                        @(Message.IsMine ? "bg-indigo-600 text-white max-w-full" : "bg-white text-slate-900 border border-slate-200 max-w-full")">

                @if (!Message.IsMine && ShowHeader)
                {
                    <div class="text-xs font-bold text-indigo-600 mb-1 truncate">
                        @Message.SenderDisplayName
                    </div>
                }

                <div class="font-normal">@Message.Content</div>

                <div class="text-[10px] mt-1 text-right select-none font-medium @(Message.IsMine ? "text-indigo-200" : "text-slate-400")">
                    @Message.CreatedAt.ToString("hh:mm tt")
                </div>
            </div>

            <!-- Action Toolbar on Hover -->
            <div class="hidden group-hover/bubble:flex items-center gap-1 absolute -top-3.5 @(Message.IsMine ? "right-2" : "left-2") bg-white border border-slate-200 rounded-lg p-1 shadow-md text-[11px] z-10">
                <button type="button" @onclick="CopyText" title="Copy text" class="px-2 py-0.5 text-slate-700 hover:text-indigo-600 hover:bg-slate-100 rounded transition cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                    </svg>
                </button>
                @if (Message.IsMine)
                {
                    <button type="button" @onclick="() => OnDelete.InvokeAsync(Message.ChatGroupMessageId)" title="Delete message" class="px-2 py-0.5 text-rose-600 hover:bg-rose-50 rounded transition cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public required ChatGroupMessageModel Message { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private async Task CopyText()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Content);
            Toast.Success("Message copied!");
        }
        catch
        {
            Toast.Info("Copied!");
        }
    }
}