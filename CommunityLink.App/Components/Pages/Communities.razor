@page "/communities"
@page "/community"
@rendermode InteractiveServer
@using System.IO
@using CommunityLink.Shared.Security
@using System.Globalization
@inject CommunityApiService CommunityApi
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject AuthenticationStateProvider AuthStateProvider
@inject RoleAndPermissionApiService RoleApi
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Communities_PageTitle"]</PageTitle>

<div class="min-h-screen bg-background font-body-md text-body-md text-on-surface antialiased transition-colors duration-200">

    <div class="relative w-full overflow-hidden">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute top-40 right-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pt-space-md pb-space-lg w-full">
            <nav aria-label="@Loc["Common_Breadcrumbs"]" class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant mb-space-md">
                <a class="hover:text-primary transition-colors" href="/">@Loc["Common_Platform"]</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-on-surface font-semibold">@Loc["Communities_Breadcrumb"]</span>
                @if (filterParentId.HasValue)
                {
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="text-on-surface font-semibold truncate">@filterParentName</span>
                }
            </nav>

            @if (isAdmin)
            {
                <!-- Hero Panel (Admin Telemetry & Directory) -->
                <div class="relative rounded-2xl bg-gradient-to-br from-white via-slate-50/95 to-sky-50/40 dark:from-surface-container-low dark:via-surface-container-low dark:to-surface-container-low p-space-md md:p-space-lg overflow-hidden border border-slate-200/90 dark:border-surface-container-high/40 shadow-[0_4px_24px_-4px_rgba(15,23,42,0.06),0_1px_3px_rgba(15,23,42,0.03)] hover:shadow-[0_12px_36px_-6px_rgba(15,23,42,0.10),0_2px_8px_rgba(15,23,42,0.05)] hover:border-sky-300/70 dark:hover:border-primary/40 transition-all duration-300 group/hero">
                    <!-- Ambient Decorative Shades (Soft colored depth in light mode) -->
                    <div class="absolute -top-24 -left-24 w-80 h-80 bg-gradient-to-br from-sky-400/15 via-blue-400/10 to-transparent rounded-full blur-3xl pointer-events-none group-hover/hero:scale-110 group-hover/hero:from-sky-400/25 transition-all duration-700"></div>
                    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-gradient-to-tl from-indigo-400/15 via-purple-400/10 to-transparent rounded-full blur-3xl pointer-events-none group-hover/hero:scale-110 group-hover/hero:from-indigo-400/25 transition-all duration-700"></div>
                    <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-64 h-32 bg-amber-400/10 dark:bg-transparent rounded-full blur-3xl pointer-events-none"></div>

                    <!-- Subtle Top Accent Highlight Line -->
                    <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-sky-500/50 dark:via-primary/40 to-transparent"></div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center relative z-10">
                        <div class="lg:col-span-7 flex flex-col gap-space-sm">
                            <div class="flex flex-wrap items-center gap-space-sm">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold tracking-wider text-sky-700 dark:text-sky-300 bg-sky-500/10 dark:bg-sky-500/10 border border-sky-300/60 dark:border-sky-500/20 shadow-2xs">
                                    <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
                                    @Loc["Communities_DirectoryIndex"]
                                </span>
                                @if (filterParentId.HasValue)
                                {
                                    <button type="button" @onclick="ClearParentFilter"
                                            class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-error/10 text-error font-label-sm text-label-sm border border-error/30 hover:bg-error/20 transition-colors cursor-pointer">
                                        <span class="material-symbols-outlined text-xs">close</span>
                                        <span class="truncate max-w-[10rem]">@filterParentName</span>
                                    </button>
                                }
                            </div>

                            <h1 class="font-headline-lg text-headline-lg md:text-display-md text-slate-900 dark:text-on-surface tracking-tight mt-space-xs font-bold">
                                @(filterParentId.HasValue ? filterParentName : Loc["Communities_HeroTitle"])
                            </h1>

                            <p class="font-body-md text-body-md text-slate-600 dark:text-on-surface-variant max-w-2xl leading-relaxed">
                                @Loc["Communities_HeroDescription"]
                            </p>

                            <div class="flex flex-wrap items-center gap-3 pt-space-sm mt-space-xs text-body-sm">
                                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/80 dark:bg-surface-container/60 border border-slate-200/90 dark:border-surface-container-high/40 shadow-2xs hover:border-sky-400/60 hover:bg-white dark:hover:bg-surface-container hover:shadow-xs transition-all duration-200 group/stat">
                                    <span class="flex items-center justify-center w-6 h-6 rounded-md bg-sky-500/10 text-sky-600 dark:text-primary group-hover/stat:scale-110 transition-transform">
                                        <span class="material-symbols-outlined text-sm">account_tree</span>
                                    </span>
                                    <span class="text-slate-600 dark:text-on-surface-variant font-medium text-xs">@Loc["Communities_Metric_ParentHubs"]</span>
                                    <span class="font-mono font-bold text-slate-900 dark:text-on-surface text-sm">@rootHubCount</span>
                                </div>
                                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/80 dark:bg-surface-container/60 border border-slate-200/90 dark:border-surface-container-high/40 shadow-2xs hover:border-indigo-400/60 hover:bg-white dark:hover:bg-surface-container hover:shadow-xs transition-all duration-200 group/stat">
                                    <span class="flex items-center justify-center w-6 h-6 rounded-md bg-indigo-500/10 text-indigo-600 dark:text-secondary group-hover/stat:scale-110 transition-transform">
                                        <span class="material-symbols-outlined text-sm">hub</span>
                                    </span>
                                    <span class="text-slate-600 dark:text-on-surface-variant font-medium text-xs">@Loc["Communities_Metric_SubCommunities"]</span>
                                    <span class="font-mono font-bold text-slate-900 dark:text-on-surface text-sm">@subHubCount</span>
                                </div>
                            </div>
                        </div>

                        <!-- Graph Card with soft background depth & interactive hover effects -->
                        <div class="lg:col-span-5 relative flex flex-col bg-white/95 dark:bg-surface-container-lowest/70 p-space-md rounded-xl border border-slate-200/90 dark:border-surface-container-high/40 backdrop-blur-md shadow-[0_2px_14px_-2px_rgba(15,23,42,0.06)] hover:shadow-[0_8px_24px_-4px_rgba(15,23,42,0.12)] hover:border-sky-400/60 dark:hover:border-primary/50 transition-all duration-300 group/graph overflow-hidden">
                            <!-- Internal subtle corner glows for the chart card -->
                            <div class="absolute -top-10 -right-10 w-28 h-28 bg-gradient-to-br from-sky-400/15 to-transparent rounded-full blur-xl pointer-events-none group-hover/graph:scale-125 transition-transform duration-500"></div>
                            <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-gradient-to-tr from-indigo-400/15 to-transparent rounded-full blur-xl pointer-events-none group-hover/graph:scale-125 transition-transform duration-500"></div>

                            <div class="relative z-10">
                                <TelemetryChart Title="@Loc["TelemetryChart_NetworkTitle"]" PrimaryLabel="@Loc["TelemetryChart_Members"]" SecondaryLabel="@Loc["TelemetryChart_Posts"]" Values="liquiditySeries" SecondaryValues="velocitySeries" Labels="chartLabels" Highlight="@networkHighlight" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Filter Strip -->
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pb-space-md w-full flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-md">
            <div class="flex flex-wrap items-center gap-space-sm">
                <span class="font-title-lg text-title-lg text-[#0A1B2E] dark:text-[#E1E8F0] font-bold">@(filterParentId.HasValue ? filterParentName : Loc["Communities_AllCommunities"])</span>
                <span class="px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-surface-container-high text-[#1E3A8A] dark:text-primary font-label-md text-label-md border border-slate-300 dark:border-primary/20 font-semibold">
                    @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_ShownCount"], ActiveCommunities.Count)
                </span>

                <!-- Type Dropdown Filter: All / Communities / Sub-communities -->
                <div class="inline-flex items-center gap-1.5 ml-1">
                    <span class="text-xs font-semibold text-slate-500 dark:text-on-surface-variant hidden sm:inline">@Loc["Communities_TypeLabel"]</span>
                    <select class="px-3 py-1.5 rounded-lg bg-white dark:bg-surface-container-low text-slate-800 dark:text-[#E1E8F0] text-xs font-medium border border-slate-300 dark:border-surface-container-high/40 shadow-xs focus:outline-none focus:border-primary cursor-pointer"
                            @bind="selectedTypeFilter"
                            @bind:after="OnTypeFilterChanged">
                        <option value="ALL">@Loc["Communities_Type_All"]</option>
                        <option value="COMMUNITIES">@Loc["Communities_Type_Communities"]</option>
                        <option value="SUB_COMMUNITIES">@Loc["Communities_Type_SubCommunities"]</option>
                    </select>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-space-sm w-full lg:w-auto">
                <!-- Joined / Browse Tabs -->
                <div class="inline-flex items-center gap-1 p-1 rounded-lg bg-slate-100 dark:bg-surface-container border border-slate-200 dark:border-surface-container-high/30 shadow-xs">
                    <button type="button" @onclick='() => SetTab("joined")'
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-label-md text-label-md font-semibold transition-all cursor-pointer @(activeTab == "joined" ? "bg-white dark:bg-primary text-slate-900 dark:text-on-primary shadow-xs" : "text-slate-600 dark:text-on-surface-variant hover:text-slate-900 dark:hover:text-white")">
                        <span class="material-symbols-outlined text-sm text-rose-500 dark:text-inherit" style="font-variation-settings: 'FILL' 1;">favorite</span>
                        <span>@Loc["Communities_Tab_Joined"]</span>
                        <span class="px-1.5 py-0.5 rounded font-mono text-label-sm @(activeTab == "joined" ? "bg-slate-100 dark:bg-on-primary/20 text-slate-900 dark:text-white font-bold" : "bg-slate-200/70 dark:bg-surface-container-high text-slate-600 dark:text-on-surface-variant")">@joinedCount</span>
                    </button>
                    <button type="button" @onclick='() => SetTab("browse")'
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md font-label-md text-label-md font-semibold transition-all cursor-pointer @(activeTab == "browse" ? "bg-white dark:bg-primary text-slate-900 dark:text-on-primary shadow-xs" : "text-slate-600 dark:text-on-surface-variant hover:text-slate-900 dark:hover:text-white")">
                        <span class="material-symbols-outlined text-sm text-indigo-500 dark:text-inherit">travel_explore</span>
                        <span>@Loc["Communities_Tab_Browse"]</span>
                        <span class="px-1.5 py-0.5 rounded font-mono text-label-sm @(activeTab == "browse" ? "bg-slate-100 dark:bg-on-primary/20 text-slate-900 dark:text-white font-bold" : "bg-slate-200/70 dark:bg-surface-container-high text-slate-600 dark:text-on-surface-variant")">@browseCount</span>
                    </button>
                </div>

                <!-- Search Input -->
                <div class="relative flex-1 sm:w-56">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-500 dark:text-on-surface-variant text-sm pointer-events-none">search</span>
                    <input type="text"
                           class="w-full bg-white dark:bg-surface-container-low text-slate-900 dark:text-on-surface placeholder:text-slate-500 dark:placeholder:text-on-surface-variant text-body-sm pl-9 pr-8 py-1.5 rounded-lg border border-slate-300 dark:border-surface-container-high/40 shadow-xs focus:outline-none focus:border-primary transition-colors"
                           placeholder="@Loc["Communities_SearchPlaceholder"]"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @bind:after="LoadCommunitiesAsync" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button type="button" @onclick="ClearSearch"
                                class="absolute right-2 top-2 flex items-center text-slate-400 hover:text-slate-700 dark:text-on-surface-variant dark:hover:text-on-surface transition-colors cursor-pointer">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    }
                </div>

                <!-- Create Community Button (shown only if permission is granted) -->
                @if (canCreateCommunity)
                {
                    <button type="button" @onclick="OpenCreateModal"
                            class="px-3.5 py-1.5 bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#1E3A8A] dark:hover:bg-[#1D4ED8] text-white rounded-lg font-label-md text-label-md font-bold flex items-center gap-1.5 shrink-0 transition-all cursor-pointer shadow-xs border border-transparent dark:border-blue-400/30">
                        <span class="material-symbols-outlined text-sm text-white">add</span>
                        <span class="text-white font-bold">@Loc["Communities_CreateHubBtn"]</span>
                    </button>
                }
            </div>
        </div>

        <!-- Community Cards Grid -->
        <div class="max-w-[1280px] mx-auto px-4 md:px-margin-desktop pb-space-lg w-full">
            @if (isLoading)
            {
                <div class="rounded-xl bg-surface-container-low border border-surface-container-high/30 flex flex-col items-center justify-center py-16">
                    <div class="animate-spin rounded-full h-8 w-8 border-4 border-primary border-t-transparent"></div>
                    <p class="font-label-md text-label-md text-on-surface-variant mt-3">@Loc["Communities_Loading"]</p>
                </div>
            }
            else if (ActiveCommunities.Count == 0)
            {
                <div class="rounded-xl bg-surface-container-low border border-dashed border-surface-container-high/40 text-center py-14 px-4">
                    <div class="w-11 h-11 rounded-xl bg-surface-container text-on-surface-variant flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-2xl">account_tree</span>
                    </div>
                    @if (activeTab == "joined")
                    {
                        <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">@Loc["Communities_Empty_JoinedTitle"]</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1.5 max-w-md mx-auto">@Loc["Communities_Empty_JoinedSubtitle"]</p>
                        <button type="button" @onclick='() => SetTab("browse")'
                                class="mt-4 px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold inline-flex items-center gap-1.5 cursor-pointer transition-colors hover:bg-primary-fixed-dim">
                            <span class="material-symbols-outlined text-sm">travel_explore</span>
                            <span>@Loc["Communities_Empty_BrowseCommunitiesBtn"]</span>
                        </button>
                    }
                    else
                    {
                        <h3 class="font-headline-md text-headline-md text-on-surface font-semibold">@Loc["Communities_Empty_NoMatchTitle"]</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1.5 max-w-md mx-auto">
                            @(string.IsNullOrEmpty(searchTerm)
                                ? Loc["Communities_Empty_NoMatchAllJoined"]
                                : string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Empty_NothingMatches"], searchTerm))
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-space-lg">
                    @for (var cIdx = 0; cIdx < DisplayedCommunities.Count; cIdx++)
                    {
                        var community = DisplayedCommunities[cIdx];
                        var isSub = community.ParentCommunityId.HasValue;
                        var cardIndex = cIdx;
                        var bannerUrl = GetBannerUrl(community);

                        <div class="relative overflow-hidden bg-white hover:bg-slate-50/70 dark:bg-[#131722] dark:hover:bg-[#171C28] rounded-2xl flex flex-col justify-between border border-slate-200/80 hover:border-slate-300 dark:border-white/[0.08] dark:hover:border-white/15 shadow-[0_2px_8px_-2px_rgba(10,27,46,0.06),0_1px_3px_rgba(10,27,46,0.04)] hover:shadow-[0_8px_20px_-4px_rgba(10,27,46,0.1),0_2px_6px_rgba(10,27,46,0.05)] dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.5),0_1px_3px_rgba(0,0,0,0.3)] dark:hover:shadow-[0_8px_28px_-2px_rgba(0,0,0,0.7)] transition-all group">

                            <!-- Decorative Soft Color Shades (Smooth Corner Wash Inspired by People Cards) -->
                            @if (cardIndex % 3 == 0)
                            {
                                <div class="absolute top-0 right-0 w-72 sm:w-80 h-60 sm:h-72 bg-gradient-to-bl from-sky-500/20 via-blue-500/10 to-transparent dark:from-sky-400/20 dark:via-blue-500/10 dark:to-transparent rounded-bl-full pointer-events-none"></div>
                                <div class="absolute -bottom-8 -left-8 w-44 h-44 bg-sky-500/10 dark:bg-sky-400/10 rounded-full blur-2xl pointer-events-none"></div>
                            }
                            else if (cardIndex % 3 == 1)
                            {
                                <div class="absolute top-0 right-0 w-72 sm:w-80 h-60 sm:h-72 bg-gradient-to-bl from-blue-600/20 via-cyan-500/10 to-transparent dark:from-blue-400/25 dark:via-cyan-400/15 dark:to-transparent rounded-bl-full pointer-events-none"></div>
                                <div class="absolute -bottom-8 -left-8 w-44 h-44 bg-blue-500/10 dark:bg-cyan-400/10 rounded-full blur-2xl pointer-events-none"></div>
                            }
                            else
                            {
                                <div class="absolute top-0 right-0 w-72 sm:w-80 h-60 sm:h-72 bg-gradient-to-bl from-indigo-500/15 via-sky-400/10 to-transparent dark:from-indigo-400/20 dark:via-sky-400/10 dark:to-transparent rounded-bl-full pointer-events-none"></div>
                                <div class="absolute -bottom-8 -left-8 w-44 h-44 bg-sky-400/10 dark:bg-indigo-400/10 rounded-full blur-2xl pointer-events-none"></div>
                            }

                            <div class="relative z-10 flex flex-col justify-between h-full">
                                <div class="p-space-md flex flex-col gap-space-sm">
                                    <!-- Banner -->
                                    <div class="relative h-36 rounded-xl overflow-hidden bg-surface-container-lowest border border-slate-200/80 dark:border-white/[0.08]">
                                        <img src="@bannerUrl" alt="@community.Name"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />

                                        <!-- Category Pill -->
                                        <div class="absolute top-3 left-3 flex items-center gap-2">
                                            <span class="px-2 py-1 rounded-md bg-white/90 dark:bg-surface-container-lowest/90 backdrop-blur-md text-[#0A1B2E] dark:text-primary font-label-sm text-label-sm uppercase tracking-wider flex items-center gap-1 border border-slate-300/80 dark:border-primary/20 truncate max-w-[70%] font-semibold shadow-xs">
                                                <span class="material-symbols-outlined text-xs shrink-0 text-primary">@GetCategoryIcon(isSub, cardIndex)</span>
                                                <span class="truncate">@(community.CategoryName ?? (isSub ? Loc["Communities_Card_SubCommunityFallback"] : Loc["Communities_Card_ParentHubFallback"]))</span>
                                            </span>
                                        </div>

                                        <!-- Banner Title (soft blue background) -->
                                        <div class="absolute bottom-2 left-2 right-2 p-2 rounded-lg bg-sky-50/95 dark:bg-[#0f243c]/95 backdrop-blur-md border border-sky-200/70 dark:border-sky-500/20 flex items-center justify-between gap-2 shadow-xs">
                                            <div class="min-w-0 flex-1">
                                                <div class="font-title-md text-sm text-slate-900 dark:text-on-surface font-bold tracking-tight truncate">@community.Name</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 leading-relaxed">
                                        @(string.IsNullOrWhiteSpace(community.Description)
                                            ? Loc["Communities_Card_NoDescription"]
                                            : community.Description)
                                    </p>

                                    <!-- Metrics -->
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm text-body-sm py-space-xs px-space-sm rounded-lg bg-slate-50 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/[0.06]">
                                        <span class="flex items-center gap-1 text-on-surface font-semibold">
                                            <span class="material-symbols-outlined text-xs text-primary">groups</span>
                                            @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_Members"], FormatCompact(community.MemberCount))
                                        </span>
                                        <span class="text-on-surface-variant">•</span>
                                        <span class="flex items-center gap-1 text-primary font-medium">
                                            <span class="material-symbols-outlined text-xs">account_tree</span>
                                            @(isSub ? string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_Groups"], community.GroupCount) : string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_SubHubs"], community.SubCommunityCount))
                                        </span>
                                        <span class="text-on-surface-variant">•</span>
                                        <span class="flex items-center gap-1 text-secondary font-medium">
                                            <span class="material-symbols-outlined text-xs">article</span>
                                            @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_Posts"], FormatCompact(community.PostCount))
                                        </span>
                                    </div>

                                    <!-- Child entities -->
                                    <div class="flex flex-col gap-space-xs pt-space-xs">
                                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant flex items-center gap-1 font-semibold">
                                            <span class="material-symbols-outlined text-xs text-primary">hub</span>
                                            @(isSub ? string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_WorkingGroupsTitle"], community.GroupCount) : string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_SubCommunitiesTitle"], community.SubCommunityCount))
                                        </span>

                                        <div class="grid grid-cols-1 gap-1.5 mt-1">
                                            @if (community.TopChildItems != null && community.TopChildItems.Any())
                                            {
                                                @for (var i = 0; i < Math.Min(3, community.TopChildItems.Count); i++)
                                                {
                                                    var child = community.TopChildItems[i];
                                                    <div class="flex items-center justify-between px-space-sm py-1.5 rounded-lg bg-slate-50/80 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/[0.05] transition-colors border border-slate-200/70 dark:border-white/[0.06]">
                                                        <div class="flex items-center gap-2 min-w-0 pr-2">
                                                            <span class="material-symbols-outlined text-sm shrink-0 @(i % 2 == 0 ? "text-primary" : "text-secondary")">@GetChildIcon(i)</span>
                                                            <span class="font-body-sm text-body-sm text-on-surface truncate">@child.Name</span>
                                                        </div>
                                                        <div class="flex items-center gap-1.5 shrink-0">
                                                            <span class="font-label-sm text-label-sm font-mono text-on-surface-variant">@child.MemberCount.ToString("N0")</span>
                                                            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase px-1.5 py-0.5 rounded bg-surface-container-high font-mono">@child.ItemType</span>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="px-space-sm py-3 rounded-lg bg-slate-50/50 dark:bg-white/[0.02] border border-dashed border-slate-300 dark:border-white/[0.08] text-center font-body-sm text-body-sm text-on-surface-variant">
                                                    @(isSub ? Loc["Communities_Card_NoGroups"] : Loc["Communities_Card_NoSubCommunities"])
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="p-space-md pt-0 flex flex-wrap items-stretch gap-2">
                                    <a class="flex-1 min-w-[110px] py-2 px-space-sm rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-900 font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all no-underline cursor-pointer border border-blue-200 font-bold"
                                       href="@(isSub ? $"groups?subCommunityId={community.CommunityId}" : $"/sub-communities/{community.CommunityId}")">
                                        <span class="truncate">@(isSub ? Loc["Communities_Card_SeeGroups"] : Loc["Communities_Card_SeeSubCommunities"])</span>
                                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                    </a>

                                    @if (canCreateCommunity || isAdmin)
                                    {
                                        <button type="button" @onclick="() => OpenEditModal(community)"
                                                class="px-3 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all cursor-pointer font-bold shadow-xs">
                                            <span class="material-symbols-outlined text-sm text-white">edit_note</span>
                                            <span>Edit</span>
                                        </button>
                                    }

                                    @if (community.IsJoined)
                                    {
                                        <button type="button" @onclick="() => PromptLeaveCommunity(community)"
                                                class="px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all cursor-pointer border border-rose-200 font-bold shadow-xs">
                                            <span class="material-symbols-outlined text-sm text-rose-600">logout</span>
                                            <span>@Loc["Communities_Card_Leave"]</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => JoinCommunity(community.CommunityId)"
                                                class="px-4 py-2 rounded-lg bg-blue-800 hover:bg-blue-900 text-white font-label-lg text-label-lg flex items-center justify-center gap-1.5 transition-all font-bold cursor-pointer shadow-sm border border-blue-900">
                                            <span class="material-symbols-outlined text-sm text-white">lock_open</span>
                                            <span class="text-white font-bold">@Loc["Communities_Card_Join"]</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (ActiveCommunities.Count > MaxInitialCommunities)
                {
                    <div class="flex justify-center mt-space-lg">
                        <button type="button" @onclick="() => showAllCommunities = !showAllCommunities"
                                class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-bold flex items-center gap-2 border border-surface-container-high/40 transition-all cursor-pointer shadow-xs hover:shadow-sm">
                            <span>@(showAllCommunities ? "See Less" : $"See More ({ActiveCommunities.Count - MaxInitialCommunities} more)")</span>
                            <span class="material-symbols-outlined text-sm transition-transform @(showAllCommunities ? "rotate-180" : "")">expand_more</span>
                        </button>
                    </div>
                }
            }
        </div>


    </div>
</div>

<!-- Create Hub Modal (Supports Photo Upload & Sub-Community Linking) -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[#0A1B2E]/60 dark:bg-black/75 backdrop-blur-sm p-4">
        <div class="relative bg-white dark:bg-[#112A46] rounded-xl shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] w-full max-w-lg overflow-hidden">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-[#E1E8F0] flex items-center gap-2" style="font-family:'Manrope',sans-serif">
                    <svg class="w-4 h-4 text-[#D4AF37]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/></svg>
                    <span>@Loc["Communities_Create_Title"]</span>
                </h3>
                <button type="button" @onclick="CloseCreateModal" class="text-[#7A8CA6] hover:text-[#0A1B2E] dark:hover:text-white p-1 rounded transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="p-2.5 rounded bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-700 dark:text-rose-300 text-xs flex items-start gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span class="flex-1">@modalError</span>
                    </div>
                }

                <!-- Hierarchy Type Selector -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1.5">@Loc["Communities_Create_StructureLabel"]</label>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <button type="button" 
                                @onclick="() => isSubCommunityCreation = false"
                                class="px-3 py-2 rounded-lg border text-left transition @(!isSubCommunityCreation ? "border-[#0A1B2E] dark:border-[#D4AF37] bg-[#F1F5F9] dark:bg-[#1B3B5A] font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[#557392] dark:text-[#C4D2E1]")">
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                <span>@Loc["Communities_Create_OptParent"]</span>
                            </div>
                            <div class="text-[10px] font-normal text-[#7A8CA6] mt-0.5">@Loc["Communities_Create_OptParentDesc"]</div>
                        </button>

                        <button type="button" 
                                @onclick="() => isSubCommunityCreation = true"
                                class="px-3 py-2 rounded-lg border text-left transition @(isSubCommunityCreation ? "border-[#0A1B2E] dark:border-[#D4AF37] bg-[#F1F5F9] dark:bg-[#1B3B5A] font-bold text-[#0A1B2E] dark:text-[#E1E8F0]" : "border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[#557392] dark:text-[#C4D2E1]")">
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-[#0A1B2E] dark:text-[#E1E8F0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                <span>@Loc["Communities_Create_OptSub"]</span>
                            </div>
                            <div class="text-[10px] font-normal text-[#7A8CA6] mt-0.5">@Loc["Communities_Create_OptSubDesc"]</div>
                        </button>
                    </div>
                </div>

                <!-- Parent Community Selector (if Sub-Community) -->
                @if (isSubCommunityCreation)
                {
                    <div>
                        <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">
                            @Loc["Communities_Create_SelectParentLabel"] <span class="text-rose-500">*</span>
                        </label>
                        <select class="w-full px-3 py-2 text-xs rounded-lg bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                                @bind="selectedParentCommunityId">
                            <option value="">@Loc["Communities_Create_ChooseParentPlaceholder"]</option>
                            @if (communities != null)
                            {
                                @foreach (var p in communities.Where(c => !c.ParentCommunityId.HasValue))
                                {
                                    <option value="@p.CommunityId">@p.Name</option>
                                }
                            }
                        </select>
                    </div>
                }

                <!-- Name Input -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">
                        @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Create_NameLabel"], isSubCommunityCreation ? Loc["Communities_Create_SubCommunityTerm"] : Loc["Communities_Create_CommunityTerm"]) <span class="text-rose-500">*</span>
                    </label>
                    <input type="text"
                           class="w-full px-3 py-2 text-xs rounded-lg bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                           placeholder="@Loc["Communities_Create_NamePlaceholder"]"
                           @bind="communityName"
                           @bind:event="oninput" />
                </div>

                <!-- Description Input -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1">@Loc["Communities_Create_DescLabel"]</label>
                    <textarea rows="3"
                              class="w-full px-3 py-2 text-xs rounded-lg bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-indigo-500/20 leading-relaxed"
                              placeholder="@Loc["Communities_Create_DescPlaceholder"]"
                              @bind="communityDesc"
                              @bind:event="oninput"></textarea>
                </div>

                <!-- Photo Upload Section -->
                <div>
                    <label class="block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] mb-1.5">
                        @Loc["Communities_Create_BannerLabel"]
                    </label>

                    @if (!string.IsNullOrWhiteSpace(uploadedBannerUrl))
                    {
                        <div class="relative h-32 rounded-lg overflow-hidden border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] group">
                            <img src="@uploadedBannerUrl" class="w-full h-full object-cover" alt="Banner Preview" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                                <button type="button" @onclick="RemoveUploadedBanner" class="px-2.5 py-1 rounded bg-rose-600 text-white text-xs font-semibold shadow hover:bg-rose-700 transition inline-flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    <span>@Loc["Communities_Create_RemovePhoto"]</span>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="border-2 border-dashed border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] rounded-xl p-4 text-center hover:border-indigo-500 transition">
                            <InputFile OnChange="HandleBannerUpload" accept=".jpg,.jpeg,.png,.webp" class="hidden" id="bannerFileInput" />
                            <label for="bannerFileInput" class="cursor-pointer flex flex-col items-center">
                                <svg class="w-7 h-7 text-[#7A8CA6] mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                                <span class="text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">@Loc["Communities_Create_UploadCustom"]</span>
                                <span class="text-[10px] text-[#7A8CA6] mt-0.5">@Loc["Communities_Create_UploadTypes"]</span>
                            </label>
                        </div>
                    }

                    @if (isUploadingBanner)
                    {
                        <div class="mt-2 flex items-center gap-2 text-xs text-indigo-600 dark:text-indigo-400">
                            <div class="w-3.5 h-3.5 border-2 border-indigo-600 dark:border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
                            <span>@Loc["Communities_Create_Uploading"]</span>
                        </div>
                    }

                    <!-- Image URL input -->
                    <div class="mt-2.5">
                        <label class="block text-[11px] font-semibold text-slate-700 dark:text-[#CBD5E1] mb-1">
                            @Loc["Communities_Create_OrWebUrl"]
                        </label>
                        <div class="flex items-center gap-1.5">
                            <input type="text"
                                   class="flex-1 px-3 py-1.5 text-xs rounded-lg bg-white dark:bg-[#0A1B2E] text-[#0A1B2E] dark:text-[#E1E8F0] placeholder-[#7A8CA6] border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                                   placeholder="https://example.com/image.jpg"
                                   value="@uploadedBannerUrl"
                                   @onchange="(ChangeEventArgs ev) => uploadedBannerUrl = ev.Value?.ToString()?.Trim()" />
                            @if (!string.IsNullOrWhiteSpace(uploadedBannerUrl))
                            {
                                <button type="button" @onclick="RemoveUploadedBanner"
                                        class="px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 dark:bg-rose-950/40 rounded-lg border border-rose-200 dark:border-rose-900/40 transition">
                                    @Loc["Communities_Create_Clear"]
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Quick Preset Selectors -->
                    <div class="mt-2.5">
                        <span class="text-[10px] font-mono text-[#7A8CA6] uppercase tracking-wider block mb-1">@Loc["Communities_Create_OrPreset"]</span>
                        <div class="grid grid-cols-4 gap-1.5">
                            @for (var i = 0; i < fallbackBanners.Length; i++)
                            {
                                var presetUrl = fallbackBanners[i];
                                var isSelected = uploadedBannerUrl == presetUrl;
                                <button type="button" @onclick="() => SelectPresetBanner(presetUrl)"
                                        class="relative h-12 rounded overflow-hidden border-2 transition @(isSelected ? "border-[#D4AF37] scale-102 ring-2 ring-[#D4AF37]/30" : "border-transparent opacity-70 hover:opacity-100")">
                                    <img src="@presetUrl" class="w-full h-full object-cover" alt="Preset" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-4 bg-[#F8FAFC] dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CloseCreateModal" disabled="@isSubmitting"
                        class="px-3.5 py-1.5 text-xs font-medium text-[#557392] dark:text-[#C4D2E1] hover:text-[#0A1B2E] dark:hover:text-white bg-white dark:bg-[#112A46] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] rounded-lg border border-[#E2E8F0] dark:border-[rgba(196,210,225,0.20)] transition">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitCreateAsync" disabled="@(isSubmitting || isUploadingBanner)"
                        class="px-4 py-1.5 text-xs font-semibold rounded-lg text-white dark:text-[#0A1B2E] bg-[#0A1B2E] dark:bg-[#E1E8F0] hover:bg-[#112A46] dark:hover:bg-white transition shadow-sm disabled:opacity-50">
                    @(isSubmitting ? Loc["Communities_Create_Submitting"] : (isSubCommunityCreation ? Loc["Communities_Create_SubmitSub"] : Loc["Communities_Create_SubmitParent"]))
                </button>
            </div>
        </div>
    </div>
}

<!-- Leave Community / Sub-community Confirmation Modal -->
@if (showLeaveConfirmModal && communityToLeave != null)
{
    var isSub = communityToLeave.ParentCommunityId.HasValue;
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[#0A1B2E]/60 dark:bg-black/75 backdrop-blur-sm p-4">
        <div class="relative bg-white dark:bg-[#112A46] rounded-xl shadow-2xl border border-slate-300 dark:border-[rgba(196,210,225,0.20)] w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-5 py-4 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400">
                    <span class="material-symbols-outlined text-xl">warning</span>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">@string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Leave_Title"], isSub ? Loc["Communities_Create_SubCommunityTerm"] : Loc["Communities_Create_CommunityTerm"])</h3>
                </div>
                <button type="button" @onclick="CancelLeave" class="text-slate-400 hover:text-slate-700 dark:hover:text-white p-1 rounded transition">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="p-5 space-y-3">
                <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
                    @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Leave_Prompt"], isSub ? Loc["Communities_Create_SubCommunityTerm"] : Loc["Communities_Create_CommunityTerm"])
                </p>
                <div class="p-3 rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg overflow-hidden shrink-0 bg-slate-200 dark:bg-slate-700 border border-slate-300 dark:border-slate-600">
                        <img src="@GetBannerUrl(communityToLeave)" alt="@communityToLeave.Name" class="w-full h-full object-cover" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-slate-900 dark:text-white truncate">@communityToLeave.Name</div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400">@string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Card_Members"], FormatCompact(communityToLeave.MemberCount))</div>
                    </div>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Leave_RejoinNote"], isSub ? Loc["Communities_Create_SubCommunityTerm"] : Loc["Communities_Create_CommunityTerm"])
                </p>
            </div>

            <!-- Modal Actions -->
            <div class="px-5 py-4 bg-slate-50 dark:bg-[#0A1B2E] border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] flex items-center justify-end gap-2.5">
                <button type="button" @onclick="CancelLeave" disabled="@isLeaving"
                        class="px-3.5 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-200/70 dark:hover:bg-slate-800 rounded-lg border border-slate-300 dark:border-slate-600 transition">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="ConfirmLeaveCommunityAsync" disabled="@isLeaving"
                        class="px-4 py-1.5 text-xs font-semibold rounded-lg text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm disabled:opacity-50 inline-flex items-center gap-1.5">
                    @if (isLeaving)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>@Loc["Communities_Leave_Leaving"]</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-xs">logout</span>
                        <span>@Loc["Communities_Leave_Confirm"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Community & Audit History Modal (Option A) -->
@if (showEditModal && editingCommunity != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-blue-950/60 backdrop-blur-sm p-4">
        <div class="relative bg-white rounded-xl shadow-2xl border border-blue-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="px-6 py-4 bg-blue-600 text-white flex items-center justify-between border-b border-blue-700">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-xl text-blue-100">edit_note</span>
                    <div>
                        <h3 class="text-base font-bold text-white">
                            Edit @(editingCommunity.ParentCommunityId.HasValue ? "Sub-Community" : "Community"): @editingCommunity.Name
                        </h3>
                        <p class="text-xs text-blue-100 font-medium">Manage details & inspect field modification audit history</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseEditModal" class="p-1 rounded-lg text-blue-200 hover:text-white hover:bg-blue-700 transition">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            </div>

            <!-- Tab Navigation (Pure Blue Tailwind) -->
            <div class="flex border-b border-blue-200 bg-blue-50/60 px-6 pt-2 gap-4">
                <button type="button" @onclick="() => editModalTab = 0"
                        class="pb-2.5 px-3 text-xs font-bold border-b-2 transition flex items-center gap-1.5 @(editModalTab == 0 ? "border-blue-600 text-blue-700" : "border-transparent text-blue-900/60 hover:text-blue-900")">
                    <span class="material-symbols-outlined text-sm">tune</span>
                    <span>Edit Details</span>
                </button>
                <button type="button" @onclick="() => SwitchToAuditTab()"
                        class="pb-2.5 px-3 text-xs font-bold border-b-2 transition flex items-center gap-1.5 @(editModalTab == 1 ? "border-blue-600 text-blue-700" : "border-transparent text-blue-900/60 hover:text-blue-900")">
                    <span class="material-symbols-outlined text-sm">history</span>
                    <span>Audit History</span>
                    @if (auditLogs != null)
                    {
                        <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-blue-100 text-blue-800 font-semibold font-mono">@auditLogs.Count</span>
                    }
                </button>
            </div>

            <!-- Tab Content -->
            <div class="p-6 overflow-y-auto flex-1">
                @if (editModalTab == 0)
                {
                    <!-- Tab 0: Edit Form -->
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(editModalError))
                        {
                            <div class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
                                <span class="material-symbols-outlined text-base shrink-0">error</span>
                                <span>@editModalError</span>
                            </div>
                        }

                        <div>
                            <label class="block text-xs font-bold text-blue-950 mb-1">
                                Name <span class="text-rose-600">*</span>
                            </label>
                            <input type="text"
                                   class="w-full px-3 py-2 text-xs rounded-lg bg-white text-blue-950 placeholder-blue-300 border border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition"
                                   placeholder="Enter community or sub-community name"
                                   @bind="editName" />
                            <p class="text-[11px] text-blue-700/70 mt-1">Must be unique across communities and sub-communities.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-blue-950 mb-1">
                                Description
                            </label>
                            <textarea rows="4"
                                      class="w-full px-3 py-2 text-xs rounded-lg bg-white text-blue-950 placeholder-blue-300 border border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 leading-relaxed transition"
                                      placeholder="Describe the mandate, purpose, or topics..."
                                      @bind="editDescription"></textarea>
                        </div>

                        <div class="p-3 bg-blue-50 rounded-lg border border-blue-200 text-blue-900 text-xs flex items-start gap-2">
                            <span class="material-symbols-outlined text-base text-blue-600 shrink-0">info</span>
                            <span class="text-[11px] leading-relaxed">
                                Note: Changing Name or Description creates a persistent audit entry with old & new values, timestamp, and your user record.
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Tab 1: Audit History (Option A Table) -->
                    <div>
                        @if (isLoadingAudits)
                        {
                            <div class="py-12 flex flex-col items-center justify-center text-blue-600 gap-2">
                                <div class="w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                                <span class="text-xs font-medium text-blue-900">Loading audit history...</span>
                            </div>
                        }
                        else if (auditLogs == null || auditLogs.Count == 0)
                        {
                            <div class="py-10 text-center border-2 border-dashed border-blue-200 rounded-xl bg-blue-50/50 p-6">
                                <span class="material-symbols-outlined text-3xl text-blue-400 mb-1">manage_search</span>
                                <h4 class="text-xs font-bold text-blue-950">No modification records found</h4>
                                <p class="text-[11px] text-blue-700/80 mt-0.5">This entity has not had any logged edits yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto border border-blue-200 rounded-lg">
                                <table class="w-full text-left text-xs">
                                    <thead class="bg-blue-600 text-white font-bold text-[11px] tracking-wider uppercase">
                                        <tr>
                                            <th class="py-2.5 px-3">No.</th>
                                            <th class="py-2.5 px-3">Type</th>
                                            <th class="py-2.5 px-3">Old-Value</th>
                                            <th class="py-2.5 px-3">New-Value</th>
                                            <th class="py-2.5 px-3">Editor</th>
                                            <th class="py-2.5 px-3">Date</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-blue-100 bg-white text-blue-950 font-medium">
                                        @for (int i = 0; i < auditLogs.Count; i++)
                                        {
                                            var item = auditLogs[i];
                                            <tr class="hover:bg-blue-50/80 transition-colors">
                                                <td class="py-2.5 px-3 font-mono font-bold text-blue-700">@(i + 1)</td>
                                                <td class="py-2.5 px-3">
                                                    <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold tracking-wide uppercase @(item.FieldChanged == "Name" ? "bg-blue-100 text-blue-800" : "bg-sky-100 text-sky-800")">
                                                        @item.FieldChanged
                                                    </span>
                                                </td>
                                                <td class="py-2.5 px-3 max-w-[140px] truncate text-slate-500 font-normal" title="@item.OldValue">
                                                    @(string.IsNullOrEmpty(item.OldValue) ? "—" : item.OldValue)
                                                </td>
                                                <td class="py-2.5 px-3 max-w-[140px] truncate text-blue-950 font-semibold" title="@item.NewValue">
                                                    @(string.IsNullOrEmpty(item.NewValue) ? "—" : item.NewValue)
                                                </td>
                                                <td class="py-2.5 px-3 text-blue-900 font-semibold whitespace-nowrap">
                                                    @item.EditorName
                                                </td>
                                                <td class="py-2.5 px-3 text-blue-700/70 text-[11px] font-mono whitespace-nowrap">
                                                    @item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Modal Actions -->
            <div class="px-6 py-3.5 bg-blue-50/80 border-t border-blue-200 flex items-center justify-between">
                <span class="text-[11px] text-blue-700 font-medium">
                    @(editingCommunity.ParentCommunityId.HasValue ? "Sub-Community ID: " : "Community ID: ")@editingCommunity.CommunityId
                </span>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="CloseEditModal" disabled="@isSubmittingEdit"
                            class="px-3.5 py-1.5 text-xs font-bold text-blue-900 hover:bg-blue-100 rounded-lg border border-blue-300 transition">
                        Cancel
                    </button>
                    @if (editModalTab == 0)
                    {
                        <button type="button" @onclick="SubmitEditCommunityAsync" disabled="@isSubmittingEdit"
                                class="px-4 py-1.5 text-xs font-bold rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-50 inline-flex items-center gap-1.5">
                            @if (isSubmittingEdit)
                            {
                                <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-xs">save</span>
                                <span>Save Changes</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CommunityModel>? communities;
    private string? searchTerm;
    private bool isLoading = true;
    private string activeTab = "joined";
    private string selectedTypeFilter = "ALL";

    // Parent Filter
    private int? filterParentId;
    private string? filterParentName;

    // Leave confirmation modal state
    private bool showLeaveConfirmModal;
    private CommunityModel? communityToLeave;
    private bool isLeaving;

    // Create modal state
    private bool canCreateCommunity;
    private bool showCreateModal;
    private bool isSubmitting;
    private bool isSubCommunityCreation;
    private int? selectedParentCommunityId;
    private string communityName = "";
    private string communityDesc = "";
    private string? uploadedBannerUrl;
    private bool isUploadingBanner;
    private string? modalError;

    private readonly string[] fallbackBanners = [
        "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=1200&q=80"
    ];

    private bool showAllCommunities = false;
    private const int MaxInitialCommunities = 12; // 4 rows on desktop (3 cols/row)

    // Edit modal & Audit log state (Option A)
    private bool showEditModal;
    private CommunityModel? editingCommunity;
    private string editName = "";
    private string editDescription = "";
    private string? editModalError;
    private bool isSubmittingEdit;
    private int editModalTab = 0; // 0 = Edit Details, 1 = Audit History
    private bool isLoadingAudits;
    private IReadOnlyList<CommunityAuditModel>? auditLogs;

    private void OnTypeFilterChanged()
    {
        showAllCommunities = false;
        StateHasChanged();
    }

    private IReadOnlyList<CommunityModel> ActiveCommunities
    {
        get
        {
            var list = activeTab == "joined"
                ? (communities?.Where(c => c.IsJoined) ?? Enumerable.Empty<CommunityModel>())
                : (communities?.Where(c => !c.IsJoined) ?? Enumerable.Empty<CommunityModel>());

            if (filterParentId.HasValue)
            {
                list = list.Where(c => c.ParentCommunityId == filterParentId.Value);
            }

            if (selectedTypeFilter == "COMMUNITIES")
            {
                list = list.Where(c => !c.ParentCommunityId.HasValue);
            }
            else if (selectedTypeFilter == "SUB_COMMUNITIES")
            {
                list = list.Where(c => c.ParentCommunityId.HasValue);
            }

            return list.ToList();
        }
    }

    private IReadOnlyList<CommunityModel> DisplayedCommunities =>
        showAllCommunities ? ActiveCommunities : ActiveCommunities.Take(MaxInitialCommunities).ToList();

    private int joinedCount => communities?.Count(c => c.IsJoined && (!filterParentId.HasValue || c.ParentCommunityId == filterParentId.Value) && (selectedTypeFilter == "ALL" || (selectedTypeFilter == "COMMUNITIES" ? !c.ParentCommunityId.HasValue : c.ParentCommunityId.HasValue))) ?? 0;
    private int browseCount => communities?.Count(c => !c.IsJoined && (!filterParentId.HasValue || c.ParentCommunityId == filterParentId.Value) && (selectedTypeFilter == "ALL" || (selectedTypeFilter == "COMMUNITIES" ? !c.ParentCommunityId.HasValue : c.ParentCommunityId.HasValue))) ?? 0;

    private int totalHubCount => communities?.Count ?? 0;
    private int rootHubCount => communities?.Count(c => !c.ParentCommunityId.HasValue) ?? 0;
    private int subHubCount => communities?.Count(c => c.ParentCommunityId.HasValue) ?? 0;
    private int totalMemberCount => communities?.Sum(c => c.MemberCount) ?? 0;

    // Telemetry chart series: ranked member concentration and post velocity across the directory.
    private const int MaxChartPoints = 12;

    private List<CommunityModel> chartSource => (communities ?? (IReadOnlyList<CommunityModel>)Array.Empty<CommunityModel>())
        .Where(c => c.MemberCount > 0 || c.PostCount > 0)
        .OrderByDescending(c => c.MemberCount)
        .ThenByDescending(c => c.PostCount)
        .Take(MaxChartPoints)
        .ToList();

    private List<double> liquiditySeries => chartSource.Select(c => (double)c.MemberCount).ToList();
    private List<double> velocitySeries => chartSource.Select(c => (double)c.PostCount).ToList();
    private List<string> chartLabels => chartSource.Select(c => ShortenLabel(c.Name)).ToList();

    private string networkHighlight
    {
        get
        {
            var ranked = chartSource;
            if (ranked.Count == 0) return Loc["TelemetryChart_NoSignal"];
            var total = ranked.Sum(c => c.MemberCount);
            if (total <= 0) return Loc["TelemetryChart_NoSignal"];
            var top = ranked.Take(3).Sum(c => c.MemberCount);
            var pct = (top / (double)total * 100d).ToString("0", CultureInfo.InvariantCulture);
            return string.Format(CultureInfo.CurrentUICulture, Loc["TelemetryChart_Concentration"], pct);
        }
    }

    private static string ShortenLabel(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Hub";
        var cleaned = name.Trim();
        var cut = cleaned.IndexOfAny(new[] { ' ', '&', '-', '/', ',' });
        if (cut > 1) cleaned = cleaned[..cut];
        return cleaned.Length <= 12 ? cleaned : cleaned[..12];
    }

    private static string InitialOf(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static string FormatCompact(int value)
    {
        if (value >= 1_000_000) return (value / 1_000_000D).ToString("0.#") + "M";
        if (value >= 1_000) return (value / 1_000D).ToString("0.#") + "k";
        return value.ToString("N0");
    }

    private string GetTierLabel(bool isSub) => isSub ? Loc["Communities_Card_SubCommunityTier"] : Loc["Communities_Card_ParentCommunityTier"];

    private static string GetCategoryIcon(bool isSub, int index) => (isSub, index % 4) switch
    {
        (true, 0) => "hub",
        (true, 1) => "memory",
        (true, 2) => "precision_manufacturing",
        (true, _) => "science",
        (false, 0) => "monetization_on",
        (false, 1) => "apartment",
        (false, 2) => "domain",
        _ => "corporate_fare"
    };

    private static string GetGlowGradientForIndex(int index) => (index % 4) switch
    {
        0 => "bg-gradient-to-r from-primary via-primary-fixed to-transparent",
        1 => "bg-gradient-to-r from-secondary via-secondary-container to-transparent",
        2 => "bg-gradient-to-r from-primary via-surface-tint to-transparent",
        _ => "bg-gradient-to-r from-tertiary via-secondary to-transparent"
    };

    private static string GetChildIcon(int index) => (index % 3) switch
    {
        0 => "description",
        1 => "swap_horiz",
        _ => "verified_user"
    };

    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CheckPermissionsAsync(), LoadCommunitiesAsync());
    }

    private async Task CheckPermissionsAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                isAdmin = user.IsInRole("ADMIN") ||
                          string.Equals(user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                          user.HasClaim("permission", PermissionCatalog.AdminUserView);
                if (isAdmin)
                {
                    canCreateCommunity = true;
                }
                else
                {
                    var permRes = await RoleApi.GetMyPermissionsAsync();
                    if (permRes.IsSuccess && permRes.Data != null)
                    {
                        canCreateCommunity = permRes.Data.Any(p =>
                            p.Equals("COMMUNITY.CREATE", StringComparison.OrdinalIgnoreCase) ||
                            p.Equals("SUBCOMMUNITY.CREATE", StringComparison.OrdinalIgnoreCase));
                    }
                }
            }
        }
        catch
        {
            canCreateCommunity = false;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        showAllCommunities = false;
    }

    private async Task LoadCommunitiesAsync()
    {
        isLoading = true;
        var result = await CommunityApi.GetCommunitiesAsync(searchTerm);
        if (result.IsSuccess)
        {
            communities = result.Data;
        }
        else
        {
            Toast.Error(result.Message ?? Loc["Communities_Toast_LoadFailed"]);
        }
        isLoading = false;
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        showAllCommunities = false;
        await LoadCommunitiesAsync();
    }

    private string GetBannerUrl(CommunityModel community)
    {
        if (!string.IsNullOrWhiteSpace(community.BannerUrl))
            return community.BannerUrl;

        var idx = Math.Abs(community.CommunityId) % fallbackBanners.Length;
        return fallbackBanners[idx];
    }

    private void FilterByParent(int parentId, string parentName)
    {
        filterParentId = parentId;
        filterParentName = parentName;
    }

    private void ClearParentFilter()
    {
        filterParentId = null;
        filterParentName = null;
    }

    private void NavigateToGroups(int communityId)
    {
        Navigation.NavigateTo($"/groups?subCommunityId={communityId}");
    }

    private void OpenCreateModal()
    {
        if (!canCreateCommunity) return;
        communityName = "";
        communityDesc = "";
        uploadedBannerUrl = null;
        isSubCommunityCreation = filterParentId.HasValue;
        selectedParentCommunityId = filterParentId;
        modalError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        modalError = null;
    }

    private void SelectPresetBanner(string url)
    {
        uploadedBannerUrl = url;
    }

    private void RemoveUploadedBanner()
    {
        uploadedBannerUrl = null;
    }

    private async Task HandleBannerUpload(InputFileChangeEventArgs e)
    {
        modalError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            modalError = Loc["Communities_Val_BannerTooLarge"];
            return;
        }

        try
        {
            isUploadingBanner = true;
            var uploadsDir = Path.Combine(Environment.WebRootPath, "uploads");
            if (!Directory.Exists(uploadsDir))
            {
                Directory.CreateDirectory(uploadsDir);
            }

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(extension)) extension = ".jpg";

            var uniqueFileName = $"comm_{Guid.NewGuid():N}_{DateTime.UtcNow.Ticks}{extension}";
            var fullPath = Path.Combine(uploadsDir, uniqueFileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var fileStream = new FileStream(fullPath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            uploadedBannerUrl = $"/uploads/{uniqueFileName}";
            Toast.Success(Loc["Communities_Toast_BannerUploaded"]);
        }
        catch (Exception ex)
        {
            modalError = string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Toast_BannerUploadError"], ex.Message);
        }
        finally
        {
            isUploadingBanner = false;
        }
    }

    private async Task SubmitCreateAsync()
    {
        modalError = null;
        if (string.IsNullOrWhiteSpace(communityName))
        {
            modalError = Loc["Communities_Val_NameRequired"];
            return;
        }

        if (isSubCommunityCreation && !selectedParentCommunityId.HasValue)
        {
            modalError = Loc["Communities_Val_ParentRequired"];
            return;
        }

        isSubmitting = true;
        var req = new CreateCommunityRequestModel(
            Name: communityName.Trim(),
            Slug: null,
            Description: string.IsNullOrWhiteSpace(communityDesc) ? null : communityDesc.Trim(),
            AvatarUrl: uploadedBannerUrl,
            BannerUrl: uploadedBannerUrl,
            Visibility: "PUBLIC",
            JoinPolicy: "INSTANT",
            ParentCommunityId: isSubCommunityCreation ? selectedParentCommunityId : null);

        var res = await CommunityApi.CreateCommunityAsync(req);
        isSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Toast_Created"], communityName.Trim()));
            CloseCreateModal();
            SetTab("joined");
            await LoadCommunitiesAsync();
        }
        else
        {
            modalError = res.Message ?? Loc["Communities_Toast_CreateFailed"];
        }
    }

    private async Task JoinCommunity(int communityId)
    {
        var res = await CommunityApi.JoinCommunityAsync(communityId);
        if (res.IsSuccess)
        {
            Toast.Success(res.Message ?? Loc["Communities_Toast_JoinedSuccess"]);
            await LoadCommunitiesAsync();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Communities_Toast_JoinFailed"]);
        }
    }

    private void PromptLeaveCommunity(CommunityModel community)
    {
        communityToLeave = community;
        showLeaveConfirmModal = true;
    }

    private void CancelLeave()
    {
        showLeaveConfirmModal = false;
        communityToLeave = null;
        isLeaving = false;
    }

    private async Task ConfirmLeaveCommunityAsync()
    {
        if (communityToLeave == null) return;

        try
        {
            isLeaving = true;
            var res = await CommunityApi.LeaveCommunityAsync(communityToLeave.CommunityId);
            if (res.IsSuccess)
            {
                Toast.Success(res.Message ?? string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Toast_LeftSuccess"], communityToLeave.Name));
                CancelLeave();
                await LoadCommunitiesAsync();
            }
            else
            {
                Toast.Error(res.Message ?? Loc["Communities_Toast_LeaveFailed"]);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(CultureInfo.CurrentUICulture, Loc["Communities_Toast_LeaveError"], ex.Message));
        }
        finally
        {
            isLeaving = false;
        }
    }

    private void OpenEditModal(CommunityModel community)
    {
        editingCommunity = community;
        editName = community.Name ?? "";
        editDescription = community.Description ?? "";
        editModalError = null;
        editModalTab = 0;
        auditLogs = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingCommunity = null;
        editModalError = null;
        auditLogs = null;
    }

    private async Task SwitchToAuditTab()
    {
        editModalTab = 1;
        if (editingCommunity == null) return;

        isLoadingAudits = true;
        try
        {
            var res = await CommunityApi.GetCommunityAuditsAsync(editingCommunity.CommunityId);
            if (res.IsSuccess && res.Data != null)
            {
                auditLogs = res.Data;
            }
            else
            {
                auditLogs = Array.Empty<CommunityAuditModel>();
            }
        }
        catch (Exception ex)
        {
            auditLogs = Array.Empty<CommunityAuditModel>();
            editModalError = $"Failed to load audits: {ex.Message}";
        }
        finally
        {
            isLoadingAudits = false;
        }
    }

    private async Task SubmitEditCommunityAsync()
    {
        if (editingCommunity == null) return;
        editModalError = null;

        if (string.IsNullOrWhiteSpace(editName))
        {
            editModalError = "Please enter a valid name.";
            return;
        }

        isSubmittingEdit = true;
        try
        {
            var req = new EditCommunityRequestModel(
                Name: editName.Trim(),
                Description: string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim()
            );

            var res = await CommunityApi.UpdateCommunityAsync(editingCommunity.CommunityId, req);
            if (res.IsSuccess)
            {
                Toast.Success("Changes saved successfully!");
                CloseEditModal();
                await LoadCommunitiesAsync();
            }
            else
            {
                editModalError = res.Message ?? "Failed to save changes. Duplicate name may exist.";
            }
        }
        catch (Exception ex)
        {
            editModalError = $"Error saving changes: {ex.Message}";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }
}
