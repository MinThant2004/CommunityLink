@inject ToastService Toast

<div class="px-3 sm:px-4 pb-3 sm:pb-4 pt-2 bg-slate-100 shrink-0">
    <div class="max-w-4xl mx-auto flex items-end gap-2 sm:gap-3 bg-white border border-slate-200 rounded-2xl shadow-sm px-3 sm:px-4 py-2.5">
        <!-- Emoji Button -->
        <div class="relative shrink-0">
            <button type="button" @onclick="ToggleEmojiPicker" title="Insert emoji"
                    class="p-2.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-slate-200 rounded-xl transition cursor-pointer text-base shadow-2xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
                </svg>
            </button>

            @if (showEmojiPicker)
            {
                <div class="absolute bottom-14 left-0 bg-white border border-slate-200 rounded-2xl p-3 shadow-xl z-20 flex gap-2 text-xl">
                    @foreach (var emoji in quickEmojis)
                    {
                        <button type="button" @onclick="() => AddEmoji(emoji)" class="p-1.5 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                            @emoji
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Message Text Area -->
        <div class="flex-1 min-w-0 relative">
            <textarea @ref="inputRef"
                      @bind="messageText"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      rows="1"
                      placeholder="Write a message..."
                      disabled="@IsSubmitting"
                      class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition resize-none max-h-32 leading-relaxed disabled:bg-slate-100 disabled:text-slate-400"></textarea>
        </div>

        <!-- Send Button -->
        <button type="button"
                @onclick="SubmitMessage"
                disabled="@(IsSubmitting || string.IsNullOrWhiteSpace(messageText))"
                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer disabled:opacity-40 disabled:hover:bg-indigo-600 shrink-0 flex items-center justify-center gap-1.5 h-[42px]">
            @if (IsSubmitting)
            {
                <span class="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-white"></span>
                <span>Sending...</span>
            }
            else
            {
                <span>Send</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.126A59.768 59.768 0 0 1 21.485 12 59.77 59.77 0 0 1 3.27 20.876L5.999 12Zm0 0h7.5" />
                </svg>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback<string> OnSend { get; set; }

    private ElementReference inputRef;
    private string messageText = "";
    private bool showEmojiPicker;

    private readonly string[] quickEmojis = ["👍", "❤️", "🔥", "😊", "🎉", "👏", "🚀", "💡"];

    private void ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
    }

    private void AddEmoji(string emoji)
    {
        messageText += emoji;
        showEmojiPicker = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SubmitMessage();
        }
    }

    private async Task SubmitMessage()
    {
        if (IsSubmitting || string.IsNullOrWhiteSpace(messageText)) return;

        var textToSend = messageText;
        messageText = "";
        showEmojiPicker = false;
        await OnSend.InvokeAsync(textToSend);
    }
}