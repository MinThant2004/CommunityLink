                t.IsOnline = true;
            }
        }
        return InvokeAsync(StateHasChanged);
    }

    private Task OnUserOffline(int userId, DateTime? lastActiveAt)
    {
        foreach (var t in allThreads)
        {
            if (t.IsDirect && t.DirectUserId == userId)
            {
                t.IsOnline = false;
                t.OtherUserLastActiveAt = lastActiveAt;
