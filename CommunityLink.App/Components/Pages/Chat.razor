    // ---------- Realtime ----------

    private Task OnPrivateMessageReceived(ChatMessageViewModel message)
    {
        if (activeThread is not null
            && message.ThreadType == ChatThreadType.Private
            && message.ThreadId == activeThread.Id)
        {
            AppendMessage(message);
        }

        TouchThreadPreview(ChatThreadType.Private, message);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnGroupMessageReceived(ChatMessageViewModel message)
    {
        if (activeThread is not null
            && message.ThreadType == ChatThreadType.Group
            && message.ThreadId == activeThread.Id)
        {
            AppendMessage(message);
        }

        TouchThreadPreview(ChatThreadType.Group, message);
        return InvokeAsync(StateHasChanged);
    }

    private void TouchThreadPreview(ChatThreadType type, ChatMessageViewModel message)
    {
        var thread = allThreads.FirstOrDefault(t => t.Type == type && t.Id == message.ThreadId);
        if (thread is null)
        {
            return;
        }

        thread.LastMessagePreview = message.Content;
        thread.LastActivityAt = message.SentAtLocal;

        var ordered = SortByActivity(allThreads).ToList();
        allThreads.Clear();
        allThreads.AddRange(ordered);
    }

    private async Task OnUserTypingAsync(bool isTyping)
    {
        if (activeThread is null) return;

        if (activeThread.IsDirect && activeThread.DirectUserId.HasValue)
        {
            await Realtime.SendTypingAsync(activeThread.DirectUserId.Value, isTyping);
        }
        else if (activeThread.IsGroup)
        {
            await Realtime.SendGroupTypingAsync(activeThread.Id, isTyping);
        }
    }

    private Task OnTypingChanged(int senderId, bool isTyping)
    {
        if (activeThread is not null && activeThread.IsDirect && activeThread.DirectUserId == senderId)
        {
            typingResetTimer?.Dispose();
            if (isTyping)
            {
                typingSenderId = senderId;
                typingSenderName = activeThread.Title;
                typingStatusText = "typing...";
                typingResetTimer = new System.Threading.Timer(_ =>
                {
                    typingStatusText = null;
                    typingSenderId = null;
                    typingSenderName = null;
                    InvokeAsync(StateHasChanged);
                }, null, 3500, System.Threading.Timeout.Infinite);
            }
            else
            {
                typingSenderId = null;
                typingSenderName = null;
                typingStatusText = null;
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task OnGroupTypingChanged(int chatGroupId, int senderId, bool isTyping)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId && senderId != currentUserId)
        {
            typingResetTimer?.Dispose();
            if (isTyping)
            {
                var member = groupMembers.FirstOrDefault(m => m.UserId == senderId);
                var fullName = member?.DisplayName ?? member?.UserName ?? "Someone";
                var frontName = fullName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;

                typingSenderId = senderId;
                typingSenderName = fullName;
                typingStatusText = $"{frontName} is typing...";
                typingResetTimer = new System.Threading.Timer(_ =>
                {
                    typingStatusText = null;
                    typingSenderId = null;
                    typingSenderName = null;
                    InvokeAsync(StateHasChanged);
                }, null, 3500, System.Threading.Timeout.Infinite);
            }
            else
            {
                typingSenderId = null;
                typingSenderName = null;
                typingStatusText = null;
            }
        }

        return InvokeAsync(StateHasChanged);
    }

