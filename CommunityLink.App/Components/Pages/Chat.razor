    /// <summary>
    /// Applies an owner settings change returned by the API. The server also broadcasts the
    /// same model, but applying it locally keeps the panel responsive for the owner who
    /// clicked Save instead of waiting for the round trip through SignalR.
    /// </summary>
    private Task ApplyGroupUpdateAsync(ChatGroupModel group)
    {
        if (activeThread is null || !activeThread.IsGroup || activeThread.Id != group.ChatGroupId)
        {
            return Task.CompletedTask;
        }

        activeThread.Title = group.Name;
        activeThread.AvatarUrl = group.AvatarUrl;
        activeThread.Description = group.Description;
        // Subtitle is the "N members" line, not the description - it is rendered next to the
        // creator name in the header and info panel, so it has to be recomputed from the count.
        activeThread.Subtitle = group.MemberCount + (group.MemberCount == 1 ? " member" : " members");
        activeThread.MemberCount = group.MemberCount;
        activeThread.FeeLinkDrops = group.JoinFeeLinkDrops;
        // ChatType, not the fee, is the source of truth for the paid badge: the mapper keys
        // off ChatType, and a PAID group can legitimately carry a 0 fee.
        activeThread.RequiresPayment = string.Equals(group.ChatType, "PAID", StringComparison.OrdinalIgnoreCase);
        activeThread.UserRole = group.UserRole;
        // UpdateInfoAsync returns a model built for the acting viewer, so its permission set is
        // authoritative for this client and keeps the panel in step after an owner settings save.
        activeThread.ViewerPermissions = group.ViewerPermissions;
        Realtime.SetSubscribedGroupPermissions(group.ViewerPermissions);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ApplyGroupImageAsync(string? imageUrl)
    {
        if (activeThread is not null && activeThread.IsGroup)
        {
            activeThread.AvatarUrl = imageUrl;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task DeleteGroupAsync()
    {
        if (activeThread is null || !activeThread.IsGroup) return;

        // Captured before the thread is cleared, because leaving the room still needs it.
        var chatGroupId = activeThread.Id;
        _deletingGroupId = chatGroupId;

        isActionSubmitting = true;
        StateHasChanged();

        var res = await ChatGroupApi.DeleteChatGroupAsync(chatGroupId);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("The group was deleted.");
            showInfo = false;
            await Realtime.LeaveGroupRoomAsync(chatGroupId);
            activeThread = null;
            messages = Array.Empty<ChatMessageViewModel>();
            groupMembers = Array.Empty<ChatGroupMemberModel>();
            await LoadThreadsAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Could not delete the group.");
        }
        StateHasChanged();
    }

    private async Task JoinGroupAsync()
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            return;
        }

        if (activeThread.RequiresPayment)
        {
            await LoadWalletAsync();
            unlockError = null;
            showUnlockModal = true;
            StateHasChanged();
            return;
        }

        isActionSubmitting = true;
        StateHasChanged();

        var res = await ChatGroupApi.JoinChatGroupAsync(activeThread.Id);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success($"You joined {activeThread.Title}.");
            await LoadThreadsAsync();
            var refreshed = allThreads.FirstOrDefault(t => t.IsGroup && t.Id == activeThread.Id);
            if (refreshed is not null)
            {
                activeThread = refreshed;
                placeholderThread = refreshed;
            }

            _handledRoute = activeThread.RouteSignature;
            await Realtime.SetSubscribedGroupAsync(activeThread.Id);
            await LoadGroupMembersAsync();
            await LoadMessagesAsync();
        }
        else
        {
            Toast.Error(res.Message ?? "Could not join this group.");
        }

        StateHasChanged();
    }

    private async Task LeaveGroupAsync()
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            return;
        }

        isActionSubmitting = true;
        StateHasChanged();

        var res = await ChatGroupApi.LeaveChatGroupAsync(activeThread.Id);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("You left the group.");
            showInfo = false;
            await LoadThreadsAsync();
            activeThread = null;
            mobileShowThread = false;
            NavManager.NavigateTo("/chat", replace: true);
        }
        else
        {
            Toast.Error(res.Message ?? "Could not leave this group.");
        }

        StateHasChanged();
    }

