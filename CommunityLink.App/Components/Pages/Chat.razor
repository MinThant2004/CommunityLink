@page "/chat"
@using CommunityLink.App.Components.Shared.Chat
@using Microsoft.Extensions.Localization
@inject ChatApiService ChatApi
@inject ChatGroupApiService ChatGroupApi
@inject LinkDropApiService LinkDropApi
@inject UserProfileApiService UserProfileApi
@inject ChatRealtimeService Realtime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject ToastService Toast
@inject IJSRuntime JS
@inject IStringLocalizer<AppResources> Loc
@implements IAsyncDisposable
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.ChatAccess)]

@*
    Unified Chat: one surface for 1-to-1 private conversations and one-to-many chat groups.
    The two backend stacks stay separate; this page adapts both into ChatThreadViewModel
    and routes reads, writes, payments and realtime events by ThreadType.
*@

<div class="app-shell -m-6 flex overflow-hidden border-t border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#10131A]">
    <!-- Pane 1: thread list -->
    <div class="@(mobileShowThread ? "hidden md:flex" : "flex") w-full md:w-auto">
        <ChatThreadList VisibleThreads="VisibleThreads"
                        ActiveThreadType="activeThread?.Type"
                        ActiveThreadId="activeThread?.Id"
                        ActiveSegment="activeSegment"
                        SearchText="@searchText"
                        IsLoading="isLoadingThreads"
                        HasError="threadsFailed"
                        IsPremiumCreator="isPremiumCreator"
                        EmptyTitle="@EmptyTitle"
                        EmptyDescription="@EmptyDescription"
                        OnSelect="SelectThreadAsync"
                        OnSegmentChanged="SetSegmentAsync"
                        OnSearchChanged="SetSearch"
                        UserMatches="userMatches"
                        DirectThreadUserIds="DirectThreadUserIds"
                        IsSearchingUsers="isSearchingUsers"
                        OnStartChat="StartChatWithUserAsync"
                        OnDiscover="OpenDiscover"
                        OnNewGroup="() => showCreateGroup = true"
                        OnRetry="LoadThreadsAsync" />
    </div>

    <!-- Pane 2: active thread -->
    <div class="@(mobileShowThread ? "flex" : "hidden md:flex") min-w-0 flex-1 flex-col bg-[#F8FAFC] dark:bg-[#10131A]">
        @if (activeThread is null)
        {
            <div class="flex h-full flex-col items-center justify-center px-6 text-center">
                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 dark:bg-[#191B23]">
                    <svg class="h-7 w-7 text-slate-400 dark:text-[#94A3B8]" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.189A8.721 8.721 0 0 1 3 12a8.721 8.721 0 0 1 3.04-6.06 8.721 8.721 0 0 1 6.96 0A8.721 8.721 0 0 1 21 12Z" />
                    </svg>
                </span>
                <p class="mt-4 text-sm font-semibold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">@Loc["Chat_SelectConversationToStart"]</p>
                <p class="mt-1 max-w-xs text-xs text-[#64748B] dark:text-[#94A3B8]">@Loc["Chat_DirectAndGroupsHere"]</p>
            </div>
        }
        else
        {
            <ChatThreadHeader Thread="activeThread"
                              TypingText="@typingStatusText"
                              ShowBackButton="true"
                              PinnedMessage="pinnedMessage"
                              CanUnpin="@(pinnedMessage is not null && (pinnedMessage.SenderId == currentUserId || activeThread.CanPinMessages))"
                              OnToggleInfo="ToggleInfo"
                              OnBack="CloseThreadOnMobile"
                              OnUnpin="UnpinMessageAsync"
                              OnSelectPinnedMessage="SelectPinnedMessageAsync" />

            @if (activeThread.IsGroup && activeThread.IsBanned)
            {
                <div class="min-h-0 flex-1 overflow-y-auto px-4 py-6">
                    <div class="mx-auto max-w-md rounded-xl border border-rose-200 dark:border-rose-900/50 bg-white dark:bg-[#111622] p-6 text-center select-none shadow-xs">
                        <UserAvatar Url="@activeThread.AvatarUrl"
                                    Name="@activeThread.Title"
                                    Size="h-16 w-16"
                                    Class="mx-auto"
                                    TextClass="text-xl"
                                    BgClass="bg-slate-100 dark:bg-[#191B23]"
                                    ColorClass="text-[#475569] dark:text-[#E1E2EC]" />

                        <h2 class="mt-4 text-base font-semibold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">@activeThread.Title</h2>

                        <div class="mt-5 rounded-lg border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/40 p-4 text-left">
                            <p class="flex items-center gap-2 text-sm font-semibold text-rose-800 dark:text-[#FFB4AB]">
                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
                                <span>@Loc["Chat_BannedFromGroupTitle"]</span>
                            </p>
                            <p class="mt-1.5 text-xs leading-relaxed text-rose-700 dark:text-rose-300">
                                @Loc["Chat_BannedFromGroupDesc"]
                            </p>
                            <p class="mt-3 text-xs leading-relaxed text-[#64748B] dark:text-[#94A3B8]">
                                @Loc["Chat_BannedContactAdmin"]
                            </p>
                        </div>
                    </div>
                </div>
            }
            else if (activeThread.IsGroup && !activeThread.IsJoined)
            {
                @* Non-member view: describe the group and gate entry behind the join payment. *@
                <div class="min-h-0 flex-1 overflow-y-auto px-4 py-6">
                    <div class="mx-auto max-w-md rounded-xl border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111622] p-6 text-center shadow-xs">
                        <UserAvatar Url="@activeThread.AvatarUrl"
                                    Name="@activeThread.Title"
                                    Size="h-16 w-16"
                                    Class="mx-auto"
                                    TextClass="text-xl"
                                    BgClass="bg-slate-100 dark:bg-[#191B23]"
                                    ColorClass="text-[#475569] dark:text-[#E1E2EC]" />

                        <h2 class="mt-4 text-base font-semibold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">@activeThread.Title</h2>
                        <p class="mt-0.5 text-xs text-[#475569] dark:text-[#94A3B8]">@activeThread.Subtitle · @string.Format(Loc["Chat_ByCreator"], activeThread.CreatorName)</p>

                        @if (!string.IsNullOrWhiteSpace(activeThread.Description))
                        {
                            <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-[#475569] dark:text-[#94A3B8]">@activeThread.Description</p>
                        }

                        @if (activeThread.IsInvited)
                        {
                            @* The owner invited this user, but the invite is an offer rather than
                                access: the paywall below still applies until they pay. *@
                            <div class="mt-4 rounded-lg border border-[#0A1B2E]/20 dark:border-[rgba(196,210,225,0.20)] bg-[#0A1B2E]/5 dark:bg-[#112A46]/50 p-3 text-left">
                                <p class="flex items-center gap-1.5 text-sm font-semibold text-[#0A1B2E] dark:text-[#E1E8F0]">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                                    </svg>
                                    @Loc["Chat_InvitedToGroup"]
                                </p>
                                <p class="mt-1 text-xs leading-relaxed text-[#475569] dark:text-[#C4D2E1]">
                                    @string.Format(Loc["Chat_InvitedToGroupDesc"], InviterDisplayName)
                                </p>
                            </div>
                        }

                        @if (activeThread.RequiresPayment)
                        {
                            <div class="mt-4 rounded-lg border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-950/40 p-3 text-left">
                                <p class="flex items-center gap-1.5 text-sm font-semibold text-amber-900 dark:text-amber-400">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                    </svg>
                                    @string.Format(Loc["Chat_PaidGroupFee"], activeThread.FeeLinkDrops)
                                </p>
                                <p class="mt-1 text-xs leading-relaxed text-amber-800 dark:text-amber-300">
                                    @Loc["Chat_OneTimePaymentJoin"]
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="mt-4 rounded-lg border border-emerald-200 dark:border-emerald-800/40 bg-emerald-50 dark:bg-emerald-950/40 p-3 text-left">
                                <p class="text-sm font-semibold text-emerald-800 dark:text-[#34D399]">@Loc["Chat_FreeToJoin"]</p>
                                <p class="mt-1 text-xs text-emerald-700 dark:text-emerald-300">@Loc["Chat_FreeToJoinDesc"]</p>
                            </div>
                        }

                        <button type="button"
                                @onclick="JoinGroupAsync"
                                disabled="@isActionSubmitting"
                                class="mt-5 w-full rounded-lg bg-[#0A1B2E] hover:bg-[#112A46] dark:bg-[#E1E8F0] dark:hover:bg-white text-white dark:text-[#0A1B2E] px-4 py-2.5 text-xs font-bold transition disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-[#0A1B2E]/20 dark:focus:ring-[#E1E8F0]/20 focus:ring-offset-2 cursor-pointer active:scale-[0.98]">
                            @(isActionSubmitting
                                ? Loc["Chat_Working"]
                                : activeThread.IsInvited
                                    ? string.Format(Loc["Chat_AcceptInvitationDrops"], activeThread.FeeLinkDrops)
                                    : activeThread.RequiresPayment
                                        ? string.Format(Loc["Chat_JoinForDrops"], activeThread.FeeLinkDrops)
                                        : Loc["Chat_JoinGroup"])
                        </button>

                        @if (activeThread.IsInvited)
                        {
                            <button type="button"
                                    @onclick="DeclineGroupInviteAsync"
                                    disabled="@isActionSubmitting"
                                    class="mt-2.5 w-full rounded-lg border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.12)] bg-white dark:bg-[#191B23] px-4 py-2 text-xs font-semibold text-[#475569] dark:text-[#E1E2EC] transition hover:bg-slate-50 dark:hover:bg-[#1D263B] disabled:opacity-50 focus:outline-none cursor-pointer">
                                @Loc["Chat_DeclineInvitation"]
                            </button>
                        }
                    </div>
                </div>
            }
            else if (activeThread.IsDirect && !activeThread.IsUnlocked)
            {
                @* Locked 1:1: the payment prompt appears before the first send, not after a 403. *@
                <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-6 text-center">
                    <div class="max-w-md rounded-xl border border-[#E2E8F0] dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111622] p-6 shadow-xs">
                        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-50 dark:bg-amber-950/50">
                            <svg class="h-7 w-7 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                            </svg>
                        </span>
                        <h2 class="mt-4 text-base font-semibold text-[#0F172A] dark:text-[#E1E2EC]" style="font-family:'Plus Jakarta Sans',sans-serif">@Loc["Chat_PaidConversation"]</h2>
                        <p class="mt-1.5 text-xs leading-relaxed text-[#475569] dark:text-[#94A3B8]">
                            @((MarkupString)string.Format(Loc["Chat_PaidConversationPrompt"], activeThread.Title, $"<span class=\"font-bold text-[#0F172A] dark:text-[#E1E2EC] font-mono\">{activeThread.FeeLinkDrops} LinkDrops</span>"))
                        </p>
                        <button type="button"
                                @onclick="OpenUnlockModal"
                                disabled="@isActionSubmitting"
                                class="mt-5 w-full rounded-lg bg-[#0F172A] hover:bg-[#1E293B] dark:bg-[#E1E8F0] dark:hover:bg-white text-white dark:text-[#0A1B2E] px-4 py-2.5 text-xs font-bold transition disabled:opacity-50 focus:outline-none cursor-pointer active:scale-[0.98]">
                            @(isActionSubmitting ? Loc["Chat_Working"] : string.Format(Loc["Chat_UnlockForDrops"], activeThread.FeeLinkDrops))
                        </button>
                        <a href="/link-drops" class="mt-3 inline-block text-xs font-semibold text-[#0A1B2E] dark:text-[#E1E8F0] hover:underline">@Loc["Chat_NeedMoreDrops"]</a>
                    </div>
                </div>
            }
            else
            {
                <ChatMessageList @ref="_messageList" Messages="messages"
                                  IsLoading="isLoadingMessages"
                                  HasError="messagesFailed"
                                  OnRetry="LoadMessagesAsync"
                                  OnReply="msg => activeReplyMessage = msg"
                                  OnDeleteForSelf="DeleteMessageForSelfAsync"
                                  OnDeleteForEveryone="DeleteMessageForEveryoneAsync"
                                  OnToggleReaction="ToggleMessageReactionAsync"
                                  OnPin="PinMessageAsync"
                                  OnUnpin="UnpinMessageAsync" />

                @if (activeThread.IsDirect && activeThread.IsBlockedByMe)
                {
                    <div class="border-t border-rose-200 dark:border-rose-950/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 text-center select-none">
                        <p class="text-xs font-semibold text-rose-700 dark:text-[#FFB4AB] flex items-center justify-center gap-1.5">
                            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
                            <span>@Loc["Chat_BlockedUserWarning"]</span>
                        </p>
                    </div>
                }
                else
                {
                    <ChatMessageComposer IsSubmitting="isSending"
                                      Placeholder="@ComposerPlaceholder"
                                      ReplyToMessage="activeReplyMessage"
                                      OnSend="SendMessageAsync"
                                      OnCancelReply="() => activeReplyMessage = null"
                                      OnTyping="OnUserTypingAsync" />
                }
            }
        }
    </div>
</div>

@* ---------- Overlays ---------- *@

<ChatThreadInfoPanel IsOpen="showInfo"
                     Thread="@(activeThread ?? placeholderThread)"
                     Members="groupMembers"
                     IsLoadingMembers="isLoadingMembers"
                     IsSubmitting="isActionSubmitting"
                     IsMuted="isCurrentGroupMuted"
                     Description="activeThread?.Description"
                     CreatorName="activeThread?.CreatorName"
                     OnClose="() => showInfo = false"
                     OnLeave="LeaveGroupAsync"
                     OnToggleMute="ToggleGroupMuteAsync"
                    OnPromoteMember="PromoteGroupMemberAsync"
                    OnDemoteMember="DemoteGroupMemberAsync"
                    OnRemoveMember="RemoveGroupMemberAsync"
                    OnBanMember="BanGroupMemberAsync"
                    OnUpdateMemberPermissions="UpdateGroupMemberPermissionsAsync"
                     OnAddMembers="AddGroupMemberAsync"
                     Invitations="groupInvitations"
                     IsLoadingInvitations="isLoadingInvitations"
                     OnRevokeInvitation="RevokeGroupInvitationAsync"
                     OnGroupChanged="ApplyGroupUpdateAsync"
                     OnGroupImageChanged="ApplyGroupImageAsync"
                     OnDeleteGroup="DeleteGroupAsync"
                     OnToggleBlockUser="ToggleBlockUserAsync"
                     OnDeleteConversation="DeleteConversationAsync"
                     OnReportUser="OpenChatUserReport"
                     OnViewInChat="ViewMessageInChatAsync" />

<ReportContentModal @bind-IsOpen="showChatReportModal"
                    ContentType="USER"
                    ContentId="@reportTargetUserId" />

@if (showDiscover)
{
    <DiscoverGroupsDrawer Groups="discoverGroups"
                          IsLoading="isLoadingDiscover"
                          IsPremiumCreator="isPremiumCreator"
                          searchText="discoverSearch"
                          OnSelect="SelectDiscoveredGroupAsync"
                          OnCreateGroup="() => { showDiscover = false; showCreateGroup = true; }"
                          SearchChanged="SetDiscoverSearch"
                          OnClose="() => showDiscover = false" />
}

<UnlockChatModal IsOpen="showUnlockModal"
                 IsGroupUnlock="@(activeThread?.IsGroup ?? false)"
                 SubjectName="@(activeThread?.Title ?? string.Empty)"
                 SubjectSubtitle="@(activeThread?.IsGroup == true ? $"{activeThread?.Subtitle} · {string.Format(Loc["Chat_ByCreator"], activeThread?.CreatorName)}" : activeThread?.Subtitle)"
                 AvatarUrl="activeThread?.AvatarUrl"
                 FeeLinkDrops="@(activeThread?.FeeLinkDrops ?? 0)"
                 Balance="walletBalance"
                 CommissionPercentage="@(activeThread?.CommissionPercentage ?? 10m)"
                 IsSubmitting="isActionSubmitting"
                 errorMessage="@unlockError"
                 OnConfirm="ConfirmUnlockAsync"
                 OnClose="CloseUnlockModal" />

@if (showCreateGroup)
{
    <CreateChatGroupModal OnSaved="OnGroupCreatedAsync" OnClose="() => showCreateGroup = false" />
}

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "thread")] public int? ThreadQuery { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public int? TargetUserId { get; set; }
    [SupplyParameterFromQuery(Name = "create")] public string? CreateQuery { get; set; }

    private readonly List<ChatThreadViewModel> allThreads = [];
    private IReadOnlyList<ChatMessageViewModel> messages = Array.Empty<ChatMessageViewModel>();
    private IReadOnlyList<ChatGroupModel> discoverGroups = Array.Empty<ChatGroupModel>();
    private IReadOnlyList<ChatGroupMemberModel> groupMembers = Array.Empty<ChatGroupMemberModel>();

    // Pending PAID-group invitations the owner/admin can still revoke. Only populated for the
    // open group; an invite never grants access, so these users are absent from groupMembers.
    private IReadOnlyList<ChatGroupInviteModel> groupInvitations = Array.Empty<ChatGroupInviteModel>();
    private bool isLoadingInvitations;
    private bool isCurrentGroupMuted;
    // The group's single pinned message, or null. Kept beside the message list rather than derived
    // from it so the banner still renders when the pin is outside the loaded page of history.
    private ChatGroupPinnedMessageModel? pinnedMessage;

    private ChatThreadViewModel? activeThread;
    private ChatThreadViewModel placeholderThread = new() { Title = "Conversation" };
    private ChatMessageViewModel? activeReplyMessage;
    private ChatMessageList? _messageList;

    private string activeSegment = "all";
    private string? searchText;
    private string? discoverSearch;
    private IReadOnlyList<UserSearchResultDto> userMatches = Array.Empty<UserSearchResultDto>();
    private bool isSearchingUsers;
    private CancellationTokenSource? userSearchCts;

    private int currentUserId;
    private bool isPremiumCreator;
    private long walletBalance;
    private int? typingSenderId;
    private string? typingSenderName;
    private string? typingStatusText;
    private System.Threading.Timer? typingResetTimer;

    private bool isLoadingThreads = true;
    private bool threadsFailed;
    private bool isLoadingMessages;
    private bool messagesFailed;
    private bool isSending;
    private bool isActionSubmitting;
    private bool isLoadingMembers;
    private bool isLoadingDiscover;

    private bool mobileShowThread;
    private bool showInfo;
    private bool showDiscover;
    private bool showCreateGroup;
    private bool showUnlockModal;
    private bool showChatReportModal;
    private int reportTargetUserId;
    private string? unlockError;
    private string? _handledRoute;
    private bool _eventsWired;
    private int? _deletingGroupId;

    private void OpenChatUserReport(int userId)
    {
        if (userId <= 0 && activeThread?.DirectUserId != null)
        {
            userId = activeThread.DirectUserId.Value;
        }

        if (userId > 0)
        {
            reportTargetUserId = userId;
            showChatReportModal = true;
            showInfo = false;
        }
    }

    private string? TypingSenderName => typingSenderName ?? (typingSenderId.HasValue ? Loc["Chat_Someone"].Value : null);

    private string ComposerPlaceholder => activeThread?.IsGroup == true
        ? string.Format(Loc["Chat_ComposerPlaceholderGroup"], activeThread.Title)
        : Loc["Chat_ComposerPlaceholderDirect"];

    private long CommissionAmount => (long)Math.Round(
        (activeThread?.FeeLinkDrops ?? 0) * ((activeThread?.CommissionPercentage ?? 0m) / 100m),
        MidpointRounding.AwayFromZero);

    private long CreatorEarnings => (activeThread?.FeeLinkDrops ?? 0) - CommissionAmount;

    // Falls back to the group creator so the copy still reads correctly if an invite predates
    // the InvitedByName field being populated.
    private string InviterDisplayName =>
        string.IsNullOrWhiteSpace(activeThread?.InvitedByName)
            ? activeThread?.CreatorName ?? Loc["Chat_TheGroupOwner"]
            : activeThread!.InvitedByName!;

    private string EmptyTitle => activeSegment switch
    {
        "direct" => Loc["Chat_EmptyTitleDirect"],
        "group" => Loc["Chat_EmptyTitleGroup"],
        _ => allThreads.Count == 0 ? Loc["Chat_EmptyTitleNoConversations"] : Loc["Chat_EmptyTitleFilterEmpty"]
    };

    private string EmptyDescription => activeSegment switch
    {
        "direct" => Loc["Chat_EmptyDescDirect"],
        "group" => Loc["Chat_EmptyDescGroup"],
        _ => Loc["Chat_EmptyDescDefault"]
    };

    // Rebuilt on render, but off a small list, so a HashSet beats a per-row scan.
    private IReadOnlyCollection<int> DirectThreadUserIds =>
        allThreads
            .Where(t => t.IsDirect && t.DirectUserId.HasValue)
            .Select(t => t.DirectUserId!.Value)
            .ToHashSet();

    private IReadOnlyList<ChatThreadViewModel> VisibleThreads
    {
        get
        {
            IEnumerable<ChatThreadViewModel> query = allThreads;

            query = activeSegment switch
            {
                "direct" => query.Where(t => t.IsDirect),
                "group" => query.Where(t => t.IsGroup),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                query = query.Where(t =>
                    t.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (t.Subtitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.LastMessagePreview?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                   ?? user.FindFirst("role")?.Value 
                   ?? string.Empty;
        bool isAdmin = user.HasClaim("is_admin", "true") ||
                       user.IsInRole("ADMIN") ||
                       user.IsInRole("SYSTEM_ADMIN") ||
                       user.IsInRole("SYSTEMADMIN") ||
                       user.IsInRole("SUPERADMIN") ||
                       string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                       string.Equals(role, "SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase) ||
                       string.Equals(role, "SYSTEMADMIN", StringComparison.OrdinalIgnoreCase) ||
                       string.Equals(role, "SUPERADMIN", StringComparison.OrdinalIgnoreCase);

        if (isAdmin)
        {
            NavManager.NavigateTo("/admin/dashboard", replace: true);
            return;
        }

        var userId = user.FindFirst("sub")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userId, out var parsedId))
        {
            currentUserId = parsedId;
        }

        placeholderThread.Title = Loc["Chat_Conversation"];

        isPremiumCreator = HasPremiumRole(user);

        Realtime.PrivateMessageReceived += OnPrivateMessageReceived;
        Realtime.GroupMessageReceived += OnGroupMessageReceived;
        Realtime.TypingChanged += OnTypingChanged;
        Realtime.GroupTypingChanged += OnGroupTypingChanged;
        Realtime.ConversationRead += OnConversationRead;
        Realtime.MessageDeleted += OnMessageDeleted;
        Realtime.ReactionUpdated += OnReactionUpdated;
        Realtime.GroupMembersUpdated += OnGroupMembersUpdated;
        Realtime.GroupUpdated += OnGroupUpdated;
        Realtime.GroupImageUpdated += OnGroupImageUpdated;
        Realtime.GroupDeleted += OnGroupDeleted;
        Realtime.GroupMemberRemoved += OnGroupMemberRemoved;
        Realtime.GroupPinnedMessageChanged += OnGroupPinnedMessageChanged;
        Realtime.GroupPermissionsChanged += OnGroupPermissionsChanged;
        Realtime.StateChanged += OnRealtimeStateChanged;
        Realtime.UserOnline += OnUserOnline;
        Realtime.UserOffline += OnUserOffline;
        _eventsWired = true;

        await LoadWalletAsync();
        await LoadThreadsAsync();
        await Realtime.EnsureConnectedAsync();
        await ApplyRouteAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ApplyRouteAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_eventsWired)
        {
            Realtime.PrivateMessageReceived -= OnPrivateMessageReceived;
            Realtime.GroupMessageReceived -= OnGroupMessageReceived;
            Realtime.TypingChanged -= OnTypingChanged;
            Realtime.GroupTypingChanged -= OnGroupTypingChanged;
            typingResetTimer?.Dispose();
            Realtime.ConversationRead -= OnConversationRead;
            Realtime.MessageDeleted -= OnMessageDeleted;
            Realtime.ReactionUpdated -= OnReactionUpdated;
            Realtime.GroupMembersUpdated -= OnGroupMembersUpdated;
            Realtime.GroupUpdated -= OnGroupUpdated;
            Realtime.GroupImageUpdated -= OnGroupImageUpdated;
Realtime.GroupDeleted -= OnGroupDeleted;
        Realtime.GroupMemberRemoved -= OnGroupMemberRemoved;
        Realtime.GroupPinnedMessageChanged -= OnGroupPinnedMessageChanged;
        Realtime.GroupPermissionsChanged -= OnGroupPermissionsChanged;
        Realtime.StateChanged -= OnRealtimeStateChanged;
            Realtime.UserOnline -= OnUserOnline;
            Realtime.UserOffline -= OnUserOffline;
        }

        CancelUserSearch();
        await Realtime.SetSubscribedGroupAsync(null);
        GC.SuppressFinalize(this);
    }

    private static bool HasPremiumRole(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole("DOMAIN_PROFESSIONAL") || user.IsInRole("PUBLIC_FIGURE");

    // ---------- Loading ----------

    private async Task LoadThreadsAsync()
    {
        isLoadingThreads = true;
        threadsFailed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var conversationsTask = ChatApi.GetConversationsAsync();
            var groupsTask = ChatGroupApi.GetMyMembershipsAsync();
            var previewsTask = ChatGroupApi.GetPreviewsAsync();
            // Pending PAID-group invites, so an invitee sees the group in the list with the
            // paywall still applied instead of having to find it through Discover.
            var invitationsTask = ChatGroupApi.GetMyInvitationsAsync();

            await Task.WhenAll(conversationsTask, groupsTask, previewsTask, invitationsTask);

            var conversations = await conversationsTask;
            var groups = await groupsTask;
            var previews = await previewsTask;
            var invitations = await invitationsTask;

            var threads = new List<ChatThreadViewModel>();

            if (conversations.IsSuccess && conversations.Data is not null)
            {
                threads.AddRange(conversations.Data.Select(c => c.ToThread(currentUserId)));
            }

            if (groups.IsSuccess && groups.Data is not null)
            {
                threads.AddRange(groups.Data.Select(g => g.ToThread()));
            }

            if (invitations.IsSuccess && invitations.Data is not null)
            {
                // A group can only be in one of the two lists - paying resolves the invite and
                // creates the membership in the same transaction - but the membership list wins
                // if a stale invite somehow overlaps, so a paid member is never shown a paywall.
                var joinedGroupIds = groups.IsSuccess && groups.Data is not null
                    ? groups.Data.Select(g => g.ChatGroupId).ToHashSet()
                    : [];

                threads.AddRange(invitations.Data
                    .Where(i => !joinedGroupIds.Contains(i.ChatGroupId))
                    .Select(i => i.ToThread()));
            }

            if (previews.IsSuccess && previews.Data is not null)
            {
                var byGroupId = previews.Data.ToDictionary(p => p.ChatGroupId);
                foreach (var thread in threads.Where(t => t.IsGroup))
                {
                    if (byGroupId.TryGetValue(thread.Id, out var preview))
                    {
                        thread.WithPreview(preview);
                    }
                }
            }

            allThreads.Clear();
            var deduplicatedThreads = threads
                .GroupBy(t => t.IsGroup ? $"G_{t.Id}" : $"D_{t.DirectUserId}")
                .Select(g => g.OrderByDescending(t => t.LastActivityAt ?? DateTime.MinValue).First())
                .ToList();

            allThreads.AddRange(SortByActivity(deduplicatedThreads));
            threadsFailed = false;
        }
        catch
        {
            threadsFailed = true;
        }
        finally
        {
            isLoadingThreads = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static IEnumerable<ChatThreadViewModel> SortByActivity(IEnumerable<ChatThreadViewModel> threads) =>
        threads.OrderByDescending(t => t.LastActivityAt ?? DateTime.MinValue).ThenBy(t => t.Title);

    private async Task LoadWalletAsync()
    {
        var res = await LinkDropApi.GetUserWalletAsync();
        if (res.IsSuccess && res.Data is not null)
        {
            walletBalance = res.Data.Balance;
        }
    }

    // ---------- Routing ----------

    private async Task ApplyRouteAsync()
    {
        var signature = $"{TypeQuery}|{ThreadQuery}|{TargetUserId}|{CreateQuery}";
        if (signature == _handledRoute)
        {
            return;
        }

        _handledRoute = signature;

        // Seed the list filter from ?type= only on entry links that do not open a thread,
        // so opening a thread never pulls the user out of the "All" filter.
        if (!ThreadQuery.HasValue && !TargetUserId.HasValue && CreateQuery != "1")
        {
            activeSegment = TypeQuery?.ToLowerInvariant() switch
            {
                "group" or "groups" => "groups",
                "direct" => "direct",
                _ => "all"
            };
        }

        // Deep link from Creator Center: /chat?type=groups&create=1 opens the composer.
        if (CreateQuery == "1")
        {
            showCreateGroup = true;
            StateHasChanged();
            return;
        }

        if (TargetUserId.HasValue && TargetUserId.Value != currentUserId)
        {
            await OpenDirectThreadAsync(TargetUserId.Value);
            return;
        }

        if (!ThreadQuery.HasValue)
        {
            activeThread = null;
            mobileShowThread = false;
            await Realtime.SetSubscribedGroupAsync(null);
            return;
        }

        var isGroup = string.Equals(TypeQuery, "group", StringComparison.OrdinalIgnoreCase);
        var existing = allThreads.FirstOrDefault(t => t.Id == ThreadQuery.Value && t.IsGroup == isGroup);

        if (existing is not null)
        {
            await ActivateThreadAsync(existing);
            return;
        }

        // Deep link to a thread that is not in the loaded set (e.g. a group we have not joined).
        if (isGroup)
        {
            var res = await ChatGroupApi.GetChatGroupByIdAsync(ThreadQuery.Value);
            if (res.IsSuccess && res.Data is not null)
            {
                await ActivateThreadAsync(res.Data.ToThread());
                return;
            }

            if (res.Error != null && res.Error.Contains("banned", StringComparison.OrdinalIgnoreCase))
            {
                var bannedThread = new ChatThreadViewModel
                {
                    Type = ChatThreadType.Group,
                    Id = ThreadQuery.Value,
                    Title = Loc["Chat_ChatGroup"],
                    IsBanned = true,
                    IsJoined = false
                };
                await ActivateThreadAsync(bannedThread);
                return;
            }

            Toast.Error(Loc["Chat_Toast_GroupNotFound"]);
        }
        else
        {
            Toast.Error(Loc["Chat_Toast_ConversationNotFound"]);
        }

        activeThread = null;
        mobileShowThread = false;
        await Realtime.SetSubscribedGroupAsync(null);
        NavManager.NavigateTo("/chat", replace: true);
    }

    private async Task<ChatThreadViewModel> OpenDirectThreadAsync(
        int targetUserId,
        string? displayTitle = null,
        string? displaySubtitle = null,
        string? displayAvatarUrl = null)
    {
        var statusRes = await ChatApi.GetPrivateChatStatusAsync(targetUserId);
        var isPaid = statusRes.IsSuccess && statusRes.Data is not null && statusRes.Data.IsPaidChat;
        var isUnlocked = !isPaid || (statusRes.Data?.IsUnlocked ?? false);

        var title = !string.IsNullOrWhiteSpace(displayTitle)
            ? displayTitle
            : (!string.IsNullOrWhiteSpace(statusRes.Data?.DisplayName)
                ? statusRes.Data.DisplayName
                : (!string.IsNullOrWhiteSpace(statusRes.Data?.UserName)
                    ? statusRes.Data.UserName
                    : $"User #{targetUserId}"));

        var subtitle = !string.IsNullOrWhiteSpace(displaySubtitle)
            ? displaySubtitle
            : (!string.IsNullOrWhiteSpace(statusRes.Data?.UserName)
                ? $"@{statusRes.Data.UserName}"
                : $"User #{targetUserId}");

        var avatarUrl = !string.IsNullOrWhiteSpace(displayAvatarUrl)
            ? displayAvatarUrl
            : statusRes.Data?.AvatarUrl;

        var placeholder = new ChatThreadViewModel
        {
            Type = ChatThreadType.Private,
            Id = 0,
            DirectUserId = targetUserId,
            Title = title,
            Subtitle = subtitle,
            AvatarUrl = avatarUrl,
            RequiresPayment = isPaid,
            FeeLinkDrops = statusRes.Data?.FeeLinkDrops ?? 0,
            IsUnlocked = isUnlocked,
            Badge = isPaid ? "Paid" : null
        };

        var known = allThreads.FirstOrDefault(t => t.IsDirect && t.DirectUserId == targetUserId);
        var thread = known ?? placeholder;

        if (known is not null)
        {
            if (string.IsNullOrWhiteSpace(known.Title) || known.Title == "New conversation")
            {
                known.Title = title;
            }
            if (string.IsNullOrWhiteSpace(known.Subtitle) || known.Subtitle == $"User #{targetUserId}")
            {
                known.Subtitle = subtitle;
            }
            if (string.IsNullOrWhiteSpace(known.AvatarUrl) && !string.IsNullOrWhiteSpace(avatarUrl))
            {
                known.AvatarUrl = avatarUrl;
            }
            known.RequiresPayment = isPaid;
            known.FeeLinkDrops = statusRes.Data?.FeeLinkDrops ?? 0;
            known.IsUnlocked = isUnlocked;
        }

        await ActivateThreadAsync(thread);
        return thread;
    }

    private async Task SelectThreadAsync(ChatThreadViewModel thread) => await ActivateThreadAsync(thread);

    private async Task ActivateThreadAsync(ChatThreadViewModel thread)
    {
        activeThread = thread;
        placeholderThread = thread;
        mobileShowThread = true;
        showInfo = false;
        typingSenderId = null;
        typingSenderName = null;
        StateHasChanged();

        // Keep the URL in sync. Setting _handledRoute first stops OnParametersSetAsync from
        // re-entering ApplyRouteAsync for the thread we are already activating.
        _handledRoute = thread.RouteSignature;
        NavManager.NavigateTo($"/chat{thread.RouteQuery}", replace: true);

        await Realtime.SetSubscribedGroupAsync((thread.IsGroup && thread.IsJoined && !thread.IsBanned) ? thread.Id : null);

        if (thread.IsGroup)
        {
            // Lets the realtime service compute permissions for live group messages.
            Realtime.SetSubscribedGroupPermissions(thread.ViewerPermissions);
            if (thread.IsJoined)
            {
                await LoadGroupMembersAsync();
                groupInvitations = Array.Empty<ChatGroupInviteModel>();
                await LoadMessagesAsync();
                return;
            }

            // Preview-only: membership is required before the history is readable. The roster
            // must be cleared too, otherwise the info panel would keep rendering the previous
            // group's members - LoadGroupMembersAsync only runs for joined groups.
            groupMembers = Array.Empty<ChatGroupMemberModel>();
            // An invitee is not a member, so they must not see the group's outstanding
            // invitations either; that list is owner/admin only.
            groupInvitations = Array.Empty<ChatGroupInviteModel>();
            messages = Array.Empty<ChatMessageViewModel>();
            messagesFailed = false;
            isLoadingMessages = false;
            StateHasChanged();
            return;
        }

        if (!thread.HasConversationId)
        {
            // Fresh 1:1 thread: status is already resolved, and there is no history to load.
            messages = Array.Empty<ChatMessageViewModel>();
            messagesFailed = false;
            isLoadingMessages = false;
            StateHasChanged();
            return;
        }

        await LoadPrivateChatStatusAsync();
        await LoadMessagesAsync();
        await MarkThreadReadAsync();
    }

    private void CloseThreadOnMobile()
    {
        mobileShowThread = false;
        NavManager.NavigateTo("/chat", replace: true);
    }

    // ---------- Messages ----------

    private async Task LoadPrivateChatStatusAsync()
    {
        if (activeThread is null || !activeThread.IsDirect || activeThread.DirectUserId is null)
        {
            return;
        }

        var res = await ChatApi.GetPrivateChatStatusAsync(activeThread.DirectUserId.Value);
        if (res.IsSuccess && res.Data is not null)
        {
            activeThread.RequiresPayment = res.Data.IsPaidChat;
            activeThread.FeeLinkDrops = res.Data.FeeLinkDrops;
            activeThread.IsUnlocked = !res.Data.IsPaidChat || res.Data.IsUnlocked;
            activeThread.Badge = res.Data.IsPaidChat ? "Paid" : null;

            if (string.IsNullOrWhiteSpace(activeThread.Title) || activeThread.Title == "New conversation")
            {
                if (!string.IsNullOrWhiteSpace(res.Data.DisplayName))
                {
                    activeThread.Title = res.Data.DisplayName;
                }
                else if (!string.IsNullOrWhiteSpace(res.Data.UserName))
                {
                    activeThread.Title = res.Data.UserName;
                }
            }

            if (string.IsNullOrWhiteSpace(activeThread.Subtitle) || activeThread.Subtitle.StartsWith("User #"))
            {
                if (!string.IsNullOrWhiteSpace(res.Data.UserName))
                {
                    activeThread.Subtitle = $"@{res.Data.UserName}";
                }
            }

            if (string.IsNullOrWhiteSpace(activeThread.AvatarUrl) && !string.IsNullOrWhiteSpace(res.Data.AvatarUrl))
            {
                activeThread.AvatarUrl = res.Data.AvatarUrl;
            }
        }
    }

    private async Task LoadMessagesAsync()
    {
        if (activeThread is null)
        {
            return;
        }

        if (activeThread.IsGroup && !activeThread.IsJoined)
        {
            messages = Array.Empty<ChatMessageViewModel>();
            return;
        }

        isLoadingMessages = true;
        messagesFailed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (activeThread.IsGroup)
            {
                // The pin is fetched alongside the history so the banner and the in-list marker
                // agree. A failure here must not fail the thread: the messages are the primary
                // content, so an unreachable pin simply renders no banner.
                var pinnedRes = await ChatGroupApi.GetPinnedMessageAsync(activeThread.Id);
                pinnedMessage = pinnedRes.IsSuccess ? pinnedRes.Data : null;

                var res = await ChatGroupApi.GetMessagesAsync(activeThread.Id);
                if (res.IsSuccess && res.Data is not null)
                {
                    messages = res.Data
                        .Select(m => m.ToMessage(
                            activeThread.Id,
                            currentUserId,
                            activeThread.ViewerPermissions,
                            pinnedMessage?.ChatGroupMessageId))
                        .ToList();
                }
                else
                {
                    messagesFailed = true;
                }
            }
            else
            {
                var res = await ChatApi.GetMessagesAsync(activeThread.Id);
                if (res.IsSuccess && res.Data is not null)
                {
                    messages = res.Data
                        .Select(m => m.ToMessage(ChatThreadType.Private, activeThread.Id, currentUserId))
                        .ToList();
                }
                else
                {
                    messagesFailed = true;
                }
            }
        }
        catch
        {
            messagesFailed = true;
        }
        finally
        {
            isLoadingMessages = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendMessageAsync(ChatMessageComposer.SendMessagePayload payload)
    {
        var hasText = !string.IsNullOrWhiteSpace(payload.Text);
        var hasAttachment = !string.IsNullOrWhiteSpace(payload.AttachmentUrl);

        if (activeThread is null || isSending || (!hasText && !hasAttachment))
        {
            return;
        }

        var thread = activeThread;
        var replyToId = payload.ReplyToId;
        isSending = true;
        StateHasChanged();

        try
        {
            if (thread.IsGroup)
            {
                var req = new SendChatGroupMessageRequestModel(
                    Content: payload.Text,
                    MessageType: payload.MessageType,
                    AttachmentUrl: payload.AttachmentUrl,
                    FileName: payload.FileName,
                    FileSizeByte: payload.FileSizeByte,
                    ReplyToChatGroupMessageId: replyToId
                );
                var res = await ChatGroupApi.SendMessageAsync(thread.Id, req);
                if (res.IsSuccess && res.Data is not null)
                {
                    AppendMessage(res.Data.ToMessage(thread.Id, currentUserId, thread.ViewerPermissions));
                    activeReplyMessage = null;
                }
                else
                {
                    Toast.Error(res.Message ?? Loc["Chat_Toast_MessageSendFailed"]);
                }
            }
            else
            {
                // A 1:1 thread that has no server-side conversation id yet must be
                // addressed by recipient; the server creates the conversation.
                var request = thread.Id > 0
                    ? new SendMessageRequestModel(thread.Id, null, payload.Text, payload.MessageType, payload.AttachmentUrl, payload.FileName, payload.FileSizeByte, replyToId)
                    : new SendMessageRequestModel(null, thread.DirectUserId, payload.Text, payload.MessageType, payload.AttachmentUrl, payload.FileName, payload.FileSizeByte, replyToId);

                var res = await ChatApi.SendMessageAsync(request);
                if (res.IsSuccess && res.Data is not null)
                {
                    AppendMessage(res.Data.ToMessage(ChatThreadType.Private, thread.Id, currentUserId));
                    activeReplyMessage = null;
                }
                else if (string.Equals(res.Message, "PRIVATE_CHAT_PAYMENT_REQUIRED", StringComparison.OrdinalIgnoreCase))
                {
                    // Lock state changed server-side; show the unlock prompt instead of a raw error.
                    await LoadPrivateChatStatusAsync();
                    await LoadWalletAsync();
                    StateHasChanged();
                }
                else
                {
                    Toast.Error(res.Message ?? Loc["Chat_Toast_MessageSendFailed"]);
                }
            }

            await RefreshThreadPreviewAsync(thread);
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task DeleteMessageForSelfAsync(ChatMessageViewModel msg)
    {
        if (activeThread is null)
        {
            return;
        }

        var res = activeThread.IsGroup
            ? await ChatGroupApi.HideMessageForSelfAsync(activeThread.Id, msg.Id)
            : await ChatApi.DeleteMessageForSelfAsync(activeThread.Id, msg.Id);

        if (res.IsSuccess)
        {
            messages = messages.Where(m => m.Id != msg.Id).ToList();
            Toast.Success(Loc["Chat_Toast_MessageDeletedForYou"]);
            StateHasChanged();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotDeleteForYou"]);
        }
    }

    private async Task DeleteMessageForEveryoneAsync(ChatMessageViewModel msg)
    {
        if (activeThread is null)
        {
            return;
        }

        var res = activeThread.IsGroup
            ? await ChatGroupApi.DeleteMessageAsync(activeThread.Id, msg.Id)
            : await ChatApi.DeleteMessageForEveryoneAsync(activeThread.Id, msg.Id);

        if (res.IsSuccess)
        {
            messages = messages.Where(m => m.Id != msg.Id).ToList();

            // A deleted message cannot stay pinned; the server filters deleted rows out of the
            // pinned read, so dropping it locally keeps the banner from pointing at a tombstone.
            if (msg.IsPinned)
            {
                pinnedMessage = null;
                messages = messages.Select(m => m.WithPinnedState(false)).ToList();
            }

            Toast.Success(Loc["Chat_Toast_MessageDeletedEveryone"]);
            StateHasChanged();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotDeleteEveryone"]);
        }
    }

    private async Task PinMessageAsync(ChatMessageViewModel msg)
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            return;
        }

        var res = await ChatGroupApi.PinMessageAsync(activeThread.Id, msg.Id);
        if (res.IsSuccess && res.Data is not null)
        {
            // Applied locally as well as broadcast: the acting client must not wait on the hub
            // round trip to see its own change.
            ApplyPinnedMessage(res.Data);
            Toast.Success(Loc["Chat_Toast_MessagePinned"]);
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotPin"]);
        }

        StateHasChanged();
    }

    private async Task UnpinMessageAsync()
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            return;
        }

        var res = await ChatGroupApi.UnpinMessageAsync(activeThread.Id);
        if (res.IsSuccess)
        {
            ApplyPinnedMessage(null);
            Toast.Success(Loc["Chat_Toast_MessageUnpinned"]);
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotUnpin"]);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Single point that moves the banner and the in-list marker together from the authoritative
    /// pin, so the two cannot disagree whichever path produced the change.
    /// </summary>
    private void ApplyPinnedMessage(ChatGroupPinnedMessageModel? pinned)
    {
        pinnedMessage = pinned;
        var pinnedId = pinned?.ChatGroupMessageId;
        messages = messages
            .Select(m => m.WithPinnedState(pinnedId.HasValue && m.Id == pinnedId.Value))
            .ToList();
    }

    private async Task ToggleMessageReactionAsync((ChatMessageViewModel Message, string Emoji) arg)
    {
        if (activeThread is null)
        {
            return;
        }

        var res = activeThread.IsGroup
            ? await ChatGroupApi.SetMessageReactionAsync(activeThread.Id, arg.Message.Id, arg.Emoji)
            : await ChatApi.SetMessageReactionAsync(activeThread.Id, arg.Message.Id, arg.Emoji);

        if (res.IsSuccess && res.Data is not null)
        {
            messages = messages.Select(m => m.Id == arg.Message.Id ? m.WithReactions(res.Data) : m).ToList();
            StateHasChanged();
        }
        else
        {
            Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotUpdateReaction"]);
        }
    }

    private void AppendMessage(ChatMessageViewModel message)
    {
        if (messages.Any(m => m.DedupeKey == message.DedupeKey))
        {
            return;
        }

        messages = messages.Append(message).OrderBy(m => m.SentAtLocal).ToList();
    }

    private async Task RefreshThreadPreviewAsync(ChatThreadViewModel thread)
    {
        await LoadThreadsAsync();

        // LoadThreadsAsync rebuilds every view model, so re-point the active state at the
        // refreshed instance. This matters for a first message in a new 1:1 thread, where
        // the server assigns a conversation id we must adopt in both state and the URL.
        var refreshed = thread.IsGroup
            ? allThreads.FirstOrDefault(t => t.IsGroup && t.Id == thread.Id)
            : allThreads.FirstOrDefault(t => t.IsDirect && t.Id == thread.Id)
              ?? allThreads.FirstOrDefault(t => t.IsDirect && t.DirectUserId == thread.DirectUserId);

        if (refreshed is not null)
        {
            activeThread = refreshed;
            placeholderThread = refreshed;
        }

        var current = refreshed ?? thread;
        _handledRoute = current.RouteSignature;
        NavManager.NavigateTo($"/chat{current.RouteQuery}", replace: true);

        if (thread.Id == 0 && current.Id > 0)
        {
            await LoadMessagesAsync();
            await MarkThreadReadAsync();
        }
    }

    private async Task MarkThreadReadAsync()
    {
        if (activeThread is null || activeThread.IsGroup)
        {
            return;
        }

        var res = await ChatApi.MarkConversationReadAsync(activeThread.Id);
        if (res.IsSuccess)
        {
            messages = messages.Select(m => m.IsMine ? m : m.WithRead()).ToList();
        }
    }

    // ---------- Members, join, leave ----------

    private async Task LoadGroupMembersAsync()
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            return;
        }

        isLoadingMembers = true;
        await InvokeAsync(StateHasChanged);

        var res = await ChatGroupApi.GetMembersAsync(activeThread.Id);
        groupMembers = res.IsSuccess && res.Data is not null ? res.Data : Array.Empty<ChatGroupMemberModel>();

        var selfMember = groupMembers.FirstOrDefault(m => m.UserId == currentUserId);
        isCurrentGroupMuted = selfMember?.IsMuted ?? false;

        // The roster is authoritative for the viewer's own powers, and it is the one source that is
        // correct whether the thread was opened from the list (whose group model carries no
        // permissions) or from a direct route. The owner's row reports every permission.
        if (selfMember is not null)
        {
            activeThread.ViewerPermissions = selfMember.Permissions;
            Realtime.SetSubscribedGroupPermissions(selfMember.Permissions);
        }

        isLoadingMembers = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Outstanding PAID-group invitations, for the owner/admin list in the info panel. Cleared
    /// whenever the open thread stops being a group, so a stale list cannot survive a switch.
    /// </summary>
    private async Task LoadGroupInvitationsAsync()
    {
        if (activeThread is null || !activeThread.IsGroup)
        {
            groupInvitations = Array.Empty<ChatGroupInviteModel>();
            return;
        }

        isLoadingInvitations = true;
        await InvokeAsync(StateHasChanged);

        var res = await ChatGroupApi.GetPendingInvitationsAsync(activeThread.Id);
        groupInvitations = res.IsSuccess && res.Data is not null ? res.Data : Array.Empty<ChatGroupInviteModel>();

        isLoadingInvitations = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleGroupMuteAsync()
    {
        if (activeThread is null || !activeThread.IsGroup) return;

        isActionSubmitting = true;
        StateHasChanged();

