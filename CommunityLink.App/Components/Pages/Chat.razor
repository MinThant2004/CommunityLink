        }
    }

    private async Task OnGroupUpdated(ChatGroupModel group)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == group.ChatGroupId)
        {
            // Header, info panel and join button all read from the thread model, so updating
            // the fields in place keeps them consistent without reloading the whole thread.
            activeThread.Title = group.Name;
            activeThread.AvatarUrl = group.AvatarUrl;
            activeThread.Description = group.Description;
            // Subtitle is the "N members" line shown next to the creator name, not the
            // description, so it has to be recomputed from the new count.
            activeThread.Subtitle = group.MemberCount + (group.MemberCount == 1 ? " member" : " members");
            activeThread.MemberCount = group.MemberCount;
            activeThread.FeeLinkDrops = group.JoinFeeLinkDrops;
            // ChatType drives the paid badge, matching the mapper: a PAID group can carry a
            // 0 fee, so the fee alone would flip the badge the wrong way.
            activeThread.RequiresPayment = string.Equals(group.ChatType, "PAID", StringComparison.OrdinalIgnoreCase);
            // IsJoined and UserRole are deliberately NOT applied here. The server builds the
            // broadcast payload with the *acting* user's view (the owner, who just saved), and
            // fans it out to every client. Applying it would tell a non-member they are joined
            // as OWNER. Membership is per-viewer and stays authoritative from REST and the
            // targeted removal event.
            await InvokeAsync(StateHasChanged);
        }

        await LoadThreadsAsync();
    }

    private Task OnGroupImageUpdated(int chatGroupId, string imageUrl)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId)
        {
            activeThread.AvatarUrl = imageUrl;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task OnGroupDeleted(int chatGroupId)
    {
        // Close the thread rather than leaving a dead conversation: the group is gone, so
        // history, composer and member panel are all unreachable.
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId)
        {
            activeThread = null;
            messages = Array.Empty<ChatMessageViewModel>();
            groupMembers = Array.Empty<ChatGroupMemberModel>();
            await InvokeAsync(StateHasChanged);
        }

        await LoadThreadsAsync();
        Toast.Info("This Chat Group was deleted by its owner.");
    }

    private async Task OnGroupMemberRemoved(int chatGroupId, int userId)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId)
        {
            // Only the affected client leaves: everyone else just refreshes the roster.
            if (userId == currentUserId)
            {
                activeThread.IsJoined = false;
                activeThread.UserRole = "NONE";
                activeThread.ViewerPermissions = null;
                groupMembers = Array.Empty<ChatGroupMemberModel>();
                messages = Array.Empty<ChatMessageViewModel>();
                pinnedMessage = null;
                await Realtime.LeaveGroupRoomAsync(chatGroupId);
                Toast.Info("You were removed from this Chat Group.");
            }
            else
            {
                await LoadGroupMembersAsync();
            }

            await InvokeAsync(StateHasChanged);
        }

        await LoadThreadsAsync();
    }

    private Task OnGroupPinnedMessageChanged(int chatGroupId, ChatGroupPinnedMessageModel? pinned)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId)
        {
            ApplyPinnedMessage(pinned);
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task OnGroupPermissionsChanged(int chatGroupId, int userId, ChatGroupPermissionSet permissions)
    {
        if (activeThread is null || !activeThread.IsGroup || activeThread.Id != chatGroupId)
        {
            return;
        }

        if (userId == currentUserId)
        {
            // This client's own powers changed. Rewire the thread model and the realtime mapper so
            // the controls appear or disappear immediately instead of after a reload.
            activeThread.ViewerPermissions = permissions;
            Realtime.SetSubscribedGroupPermissions(permissions);

            // Re-derive the per-message flags, which are computed at map time from the old set.
            var pinnedId = pinnedMessage?.ChatGroupMessageId;
            messages = messages
                .Select(m => m.WithViewerPermissions(permissions, currentUserId, pinnedId))
                .ToList();

            await InvokeAsync(StateHasChanged);
        }

        // The roster carries each admin's set for the owner's editor, so it refreshes for everyone.
        await LoadGroupMembersAsync();
    }

    private async Task SelectPinnedMessageAsync(int messageId)
    {
        if (_messageList is not null)
        {
            await _messageList.ScrollToAndHighlightMessageAsync(messageId);
        }
    }

    private void OnRealtimeStateChanged() => InvokeAsync(StateHasChanged);
