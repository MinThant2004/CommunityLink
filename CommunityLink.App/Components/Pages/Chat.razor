    /// <summary>
    /// Owner-only direct add. Returns success so the info panel can drop the candidate from
    /// its search results only when the server actually accepted the add.
    /// <para>
    /// In a PAID group the server issues an invite instead of a membership, so the candidate is
    /// still removable from the search list but is deliberately not added to the member roster -
    /// it appears in the pending invitations list until they pay.
    /// </para>
    /// </summary>
    private async Task<bool> AddGroupMemberAsync(int userId)
    {
        if (activeThread is null || !activeThread.IsGroup) return false;

        var isPaidInvite = activeThread.RequiresPayment && activeThread.FeeLinkDrops > 0;

        isActionSubmitting = true;
        StateHasChanged();

        var res = await ChatGroupApi.AddMembersAsync(activeThread.Id, [userId]);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(isPaidInvite
                ? $"Invitation sent. They must unlock the group for {activeThread.FeeLinkDrops} drops to join."
                : "Member added.");

            if (isPaidInvite)
            {
                await LoadGroupInvitationsAsync();
            }
            else
            {
                await LoadGroupMembersAsync();
            }

            StateHasChanged();
            return true;
        }

        Toast.Error(res.Message ?? "Could not add member.");
        StateHasChanged();
        return false;
    }

    /// <summary>
    /// Invitee-side decline. The invite is retained as DECLINED server-side, so the group stops
    /// appearing in the caller's list once the threads are reloaded.
    /// </summary>
    private async Task DeclineGroupInviteAsync()
    {
        if (activeThread is null || !activeThread.IsGroup || !activeThread.IsInvited) return;

        isActionSubmitting = true;
        StateHasChanged();

        var thread = activeThread;
        var res = await ChatGroupApi.DeclineInvitationAsync(thread.Id);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success("Invitation declined.");
            showUnlockModal = false;
            showInfo = false;
            // The group is gone from this viewer's list, so the open thread is closed out and the
            // route reset - otherwise the paywall would keep offering a declined invitation.
            activeThread = null;
            mobileShowThread = false;
            messages = Array.Empty<ChatMessageViewModel>();
            groupMembers = Array.Empty<ChatGroupMemberModel>();
            groupInvitations = Array.Empty<ChatGroupInviteModel>();
            await LoadThreadsAsync();
            NavManager.NavigateTo("/chat", replace: true);
        }
        else
        {
            Toast.Error(res.Message ?? "Could not decline the invitation.");
        }

        StateHasChanged();
    }

