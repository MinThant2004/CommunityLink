    private Task OnTypingChanged(int senderId, bool isTyping)
    {
        if (activeThread is not null && activeThread.IsDirect && activeThread.DirectUserId == senderId)
        {
            typingResetTimer?.Dispose();
            if (isTyping)
            {
                typingSenderId = senderId;
                typingSenderName = activeThread.Title;
                typingStatusText = "typing...";
                typingResetTimer = new System.Threading.Timer(_ =>
                {
                    typingStatusText = null;
                    typingSenderId = null;
                    typingSenderName = null;
                    InvokeAsync(StateHasChanged);
                }, null, 3500, System.Threading.Timeout.Infinite);
            }
            else
            {
                typingSenderId = null;
                typingSenderName = null;
                typingStatusText = null;
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task OnGroupTypingChanged(int chatGroupId, int senderId, bool isTyping)
    {
        if (activeThread is not null && activeThread.IsGroup && activeThread.Id == chatGroupId && senderId != currentUserId)
        {
            typingResetTimer?.Dispose();
            if (isTyping)
            {
                var member = groupMembers.FirstOrDefault(m => m.UserId == senderId);
                var fullName = member?.DisplayName ?? member?.UserName ?? "Someone";
                var frontName = fullName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;

                typingSenderId = senderId;
                typingSenderName = fullName;
                typingStatusText = $"{frontName} is typing...";
                typingResetTimer = new System.Threading.Timer(_ =>
                {
                    typingStatusText = null;
                    typingSenderId = null;
                    typingSenderName = null;
                    InvokeAsync(StateHasChanged);
                }, null, 3500, System.Threading.Timeout.Infinite);
            }
            else
            {
                typingSenderId = null;
                typingSenderName = null;
                typingStatusText = null;
            }
        }

        return InvokeAsync(StateHasChanged);
    }

