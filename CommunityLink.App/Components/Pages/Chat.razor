    private async Task ConfirmUnlockAsync()
    {
        if (activeThread is null)
        {
            return;
        }

        isActionSubmitting = true;
        unlockError = null;
        StateHasChanged();

        var thread = activeThread;

        if (thread.IsGroup)
        {
            var res = await ChatGroupApi.JoinPaidChatGroupAsync(thread.Id);
            isActionSubmitting = false;

            if (res.IsSuccess)
            {
                showUnlockModal = false;
                Toast.Success(string.Format(Loc["Chat_Toast_JoinedGroup"], thread.Title));
                await LoadWalletAsync();
                await LoadThreadsAsync();

                var refreshed = allThreads.FirstOrDefault(t => t.IsGroup && t.Id == thread.Id);
                if (refreshed is not null)
                {
                    activeThread = refreshed;
                    placeholderThread = refreshed;
                }

                _handledRoute = activeThread.RouteSignature;
                await Realtime.SetSubscribedGroupAsync(thread.Id);
                await LoadGroupMembersAsync();
                await LoadMessagesAsync();
            }
            else
            {
                unlockError = res.Message ?? Loc["Chat_PaymentCouldNotBeCompleted"];
            }
        }
        else
        {
            var creatorUserId = thread.DirectUserId ?? 0;
            if (creatorUserId == 0)
            {
                isActionSubmitting = false;
                unlockError = Loc["Chat_NoPaymentTarget"];
                return;
            }

            var res = await ChatApi.UnlockPrivateChatAsync(creatorUserId);
            isActionSubmitting = false;

            if (res.IsSuccess)
            {
                showUnlockModal = false;
                Toast.Success(Loc["Chat_Toast_UnlockedSuccess"]);
                await LoadWalletAsync();
                await LoadThreadsAsync();

                var refreshed = allThreads.FirstOrDefault(t => t.IsDirect && t.DirectUserId == creatorUserId);
                if (refreshed is not null)
                {
                    refreshed.RequiresPayment = true;
                    refreshed.IsUnlocked = true;
                    activeThread = refreshed;
                    placeholderThread = refreshed;
                    _handledRoute = refreshed.RouteSignature;
                    NavManager.NavigateTo($"/chat{refreshed.RouteQuery}", replace: true);
                }
                else
                {
                    activeThread.IsUnlocked = true;
                }

                await LoadMessagesAsync();
            }
            else
            {
                unlockError = res.Message ?? Loc["Chat_PaymentCouldNotBeCompleted"];
            }
        }

        StateHasChanged();
    }

