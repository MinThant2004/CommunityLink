    // ---------- Realtime ----------

    private Task OnPrivateMessageReceived(ChatMessageViewModel message)
    {
        if (activeThread is not null
            && message.ThreadType == ChatThreadType.Private
            && message.ThreadId == activeThread.Id)
        {
            AppendMessage(message);
        }

        TouchThreadPreview(ChatThreadType.Private, message);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnGroupMessageReceived(ChatMessageViewModel message)
    {
        if (activeThread is not null
            && message.ThreadType == ChatThreadType.Group
            && message.ThreadId == activeThread.Id)
        {
            AppendMessage(message);
        }

        TouchThreadPreview(ChatThreadType.Group, message);
        return InvokeAsync(StateHasChanged);
    }

    private void TouchThreadPreview(ChatThreadType type, ChatMessageViewModel message)
    {
        var thread = allThreads.FirstOrDefault(t => t.Type == type && t.Id == message.ThreadId);
        if (thread is null)
        {
            return;
        }

        thread.LastMessagePreview = message.Content;
        thread.LastActivityAt = message.SentAtLocal;

        var ordered = SortByActivity(allThreads).ToList();
        allThreads.Clear();
        allThreads.AddRange(ordered);
    }

    private async Task ToggleBlockUserAsync()
    {
        if (activeThread is null || !activeThread.IsDirect || !activeThread.DirectUserId.HasValue) return;

        isActionSubmitting = true;
        try
        {
            var targetUserId = activeThread.DirectUserId.Value;
            if (activeThread.IsBlockedByMe)
            {
                var res = await ChatApi.UnblockUserAsync(targetUserId);
                if (res.IsSuccess)
                {
                    activeThread.IsBlockedByMe = false;
                    Toast.Success("User unblocked successfully.");
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to unblock user.");
                }
            }
            else
            {
                var res = await ChatApi.BlockUserAsync(targetUserId);
                if (res.IsSuccess)
                {
                    activeThread.IsBlockedByMe = true;
                    Toast.Success("User blocked successfully.");
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to block user.");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"An error occurred: {ex.Message}");
        }
        finally
        {
            isActionSubmitting = false;
            showInfo = false;
            StateHasChanged();
        }
    }

    private async Task DeleteConversationAsync()
    {
        if (activeThread is null || !activeThread.IsDirect) return;

        isActionSubmitting = true;
        try
        {
            if (activeThread.HasConversationId)
            {
                var res = await ChatApi.DeleteConversationForSelfAsync(activeThread.Id);
                if (!res.IsSuccess)
                {
                    Toast.Error(res.Message ?? "Failed to delete chat.");
                    return;
                }
            }

            allThreads.RemoveAll(t => t.Type == ChatThreadType.Private && t.Id == activeThread.Id && t.DirectUserId == activeThread.DirectUserId);
            activeThread = null;
            messages = Array.Empty<ChatMessageViewModel>();
            showInfo = false;
            Toast.Success("Chat deleted.");
        }
        catch (Exception ex)
        {
            Toast.Error($"An error occurred: {ex.Message}");
        }
        finally
        {
            isActionSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OnUserTypingAsync(bool isTyping)
    {
        if (activeThread is null) return;

        if (activeThread.IsDirect && activeThread.DirectUserId.HasValue)
        {
            await Realtime.SendTypingAsync(activeThread.DirectUserId.Value, isTyping);
        }
        else if (activeThread.IsGroup)
        {
            await Realtime.SendGroupTypingAsync(activeThread.Id, isTyping);
        }
    }

    
    private Task OnUserOnline(int userId)
    {
        foreach (var t in allThreads)
