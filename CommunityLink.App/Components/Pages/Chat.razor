    private void TouchThreadPreview(ChatThreadType type, ChatMessageViewModel message)
    {
        var thread = allThreads.FirstOrDefault(t => t.Type == type && t.Id == message.ThreadId);
        if (thread is null)
        {
            return;
        }

        thread.LastMessagePreview = message.Content;
        thread.LastActivityAt = message.SentAtLocal;

        var ordered = SortByActivity(allThreads).ToList();
        allThreads.Clear();
        allThreads.AddRange(ordered);
    }

    private async Task ToggleBlockUserAsync()
    {
        if (activeThread is null || !activeThread.IsDirect || !activeThread.DirectUserId.HasValue) return;

        isActionSubmitting = true;
        try
        {
            var targetUserId = activeThread.DirectUserId.Value;
            if (activeThread.IsBlockedByMe)
            {
                var res = await ChatApi.UnblockUserAsync(targetUserId);
                if (res.IsSuccess)
                {
                    activeThread.IsBlockedByMe = false;
                    Toast.Success(Loc["Chat_Toast_UserUnblocked"]);
                }
                else
                {
                    Toast.Error(res.Message ?? Loc["Chat_Toast_FailedUnblock"]);
                }
            }
            else
            {
                var res = await ChatApi.BlockUserAsync(targetUserId);
                if (res.IsSuccess)
                {
                    activeThread.IsBlockedByMe = true;
                    Toast.Success(Loc["Chat_Toast_UserBlocked"]);
                }
                else
                {
                    Toast.Error(res.Message ?? Loc["Chat_Toast_FailedBlock"]);
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["Chat_Toast_AnErrorOccurred"], ex.Message));
        }
        finally
        {
            isActionSubmitting = false;
            showInfo = false;
            StateHasChanged();
        }
    }

    private async Task DeleteConversationAsync()
    {
        if (activeThread is null || !activeThread.IsDirect) return;

        isActionSubmitting = true;
        try
        {
            if (activeThread.HasConversationId)
            {
                var res = await ChatApi.DeleteConversationForSelfAsync(activeThread.Id);
                if (!res.IsSuccess)
                {
                    Toast.Error(res.Message ?? Loc["Chat_Toast_FailedDeleteChat"]);
                    return;
                }
            }

            allThreads.RemoveAll(t => t.Type == ChatThreadType.Private && t.Id == activeThread.Id && t.DirectUserId == activeThread.DirectUserId);
            activeThread = null;
            messages = Array.Empty<ChatMessageViewModel>();
            showInfo = false;
            Toast.Success(Loc["Chat_Toast_ChatDeleted"]);
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(Loc["Chat_Toast_AnErrorOccurred"], ex.Message));
        }
        finally
        {
            isActionSubmitting = false;
            StateHasChanged();
        }
    }

