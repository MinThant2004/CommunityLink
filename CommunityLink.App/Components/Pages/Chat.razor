    /// still removable from the search list but is deliberately not added to the member roster -
    /// it appears in the pending invitations list until they pay.
    /// </para>
    /// </summary>
    private async Task<bool> AddGroupMemberAsync(int userId)
    {
        if (activeThread is null || !activeThread.IsGroup) return false;

        var isPaidInvite = activeThread.RequiresPayment && activeThread.FeeLinkDrops > 0;

        isActionSubmitting = true;
        StateHasChanged();

        var res = await ChatGroupApi.AddMembersAsync(activeThread.Id, [userId]);
        isActionSubmitting = false;

        if (res.IsSuccess)
        {
            Toast.Success(isPaidInvite
                ? string.Format(Loc["Chat_Toast_InviteSentPaid"], activeThread.FeeLinkDrops)
                : Loc["Chat_Toast_MemberAdded"]);

            if (isPaidInvite)
            {
                await LoadGroupInvitationsAsync();
            }
            else
            {
                await LoadGroupMembersAsync();
            }

            StateHasChanged();
            return true;
        }

        Toast.Error(res.Message ?? Loc["Chat_Toast_CouldNotAddMember"]);
        StateHasChanged();
        return false;
    }

