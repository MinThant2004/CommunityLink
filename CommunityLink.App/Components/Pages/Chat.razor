@page "/chat"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.ChatAccess)]
@using Microsoft.AspNetCore.SignalR.Client
@inject ChatApiService ChatApi
@inject ToastService Toast
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Messages - CommunityLink</PageTitle>

<div class="h-[calc(100vh-6rem)] flex flex-col md:flex-row bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <!-- Left Sidebar: Conversations List -->
    <div class="w-full md:w-80 border-r border-slate-200 flex flex-col bg-slate-50">
        <div class="p-4 border-b border-slate-200 bg-white">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span>💬</span> Direct Messages
            </h2>
        </div>

        <div class="flex-1 overflow-y-auto divide-y divide-slate-100">
            @if (conversations == null)
            {
                <div class="p-8 text-center text-slate-400">
                    <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-indigo-600"></div>
                    <p class="text-xs mt-2 font-medium">Loading conversations...</p>
                </div>
            }
            else if (conversations.Count == 0)
            {
                <div class="p-8 text-center text-slate-400">
                    <span class="text-3xl block mb-2">💬</span>
                    <p class="text-xs font-semibold text-slate-600">No active conversations</p>
                    <p class="text-[11px] text-slate-400 mt-1">Start chatting with members or creators across CommunityLink.</p>
                </div>
            }
            else
            {
                @foreach (var c in conversations)
                {
                    <button type="button"
                            @onclick="() => SelectConversation(c.ConversationId)"
                            class="w-full p-3.5 flex items-start gap-3 transition text-left hover:bg-slate-100 cursor-pointer @(activeConversationId == c.ConversationId ? "bg-indigo-50/80 border-l-4 border-indigo-600" : "")">
                        <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold text-sm flex items-center justify-center shrink-0 border border-slate-200">
                            @if (!string.IsNullOrWhiteSpace(c.OtherAvatarUrl))
                            {
                                <img src="@c.OtherAvatarUrl" alt="@c.OtherDisplayName" class="w-full h-full rounded-full object-cover" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(c.OtherDisplayName) ? "U" : c.OtherDisplayName.Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-1">
                                <h4 class="text-xs font-bold text-slate-900 truncate">@c.OtherDisplayName</h4>
                                @if (c.LastMessageAt.HasValue)
                                {
                                    <span class="text-[10px] text-slate-400 shrink-0">@c.LastMessageAt.Value.ToLocalTime().ToString("t")</span>
                                }
                            </div>
                            <p class="text-xs text-slate-500 truncate mt-0.5">@(c.LastMessagePreview ?? "Start chatting...")</p>
                        </div>
                    </button>
                }
            }
        </div>
    </div>

    <!-- Right Panel: Message Thread -->
    <div class="flex-1 flex flex-col min-w-0 bg-slate-50/40">
        @if (activeConversationId.HasValue && activeConversation != null)
        {
            <!-- Thread Header -->
            <div class="p-4 bg-white border-b border-slate-200 flex items-center justify-between shadow-2xs">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center shrink-0">
                        @(string.IsNullOrWhiteSpace(activeConversation.OtherDisplayName) ? "U" : activeConversation.OtherDisplayName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h3 class="text-xs font-bold text-slate-900">@activeConversation.OtherDisplayName</h3>
                        <span class="text-[10px] text-slate-400 font-medium">Direct Message Thread</span>
                    </div>
                </div>
            </div>

            <!-- Messages Stream -->
            <div class="flex-1 p-4 overflow-y-auto space-y-3">
                @if (messages == null)
                {
                    <div class="p-8 text-center text-slate-400">
                        <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-indigo-600"></div>
                        <p class="text-xs mt-2 font-medium">Loading messages...</p>
                    </div>
                }
                else if (messages.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400">
                        <span class="text-2xl block mb-1">👋</span>
                        <p class="text-xs font-medium text-slate-600">No messages yet</p>
                        <p class="text-[11px] text-slate-400">Send a message below to begin the conversation.</p>
                    </div>
                }
                else
                {
                    @foreach (var m in messages)
                    {
                        <div class="flex flex-col @(m.SenderId != activeConversation.OtherUserId ? "items-end" : "items-start") my-1">
                            <div class="max-w-[80%] rounded-xl px-4 py-2.5 text-xs shadow-2xs @(m.SenderId != activeConversation.OtherUserId ? "bg-indigo-600 text-white" : "bg-white text-slate-900 border border-slate-200")">
                                <div class="font-normal break-words leading-relaxed">@m.MessageText</div>
                                <div class="text-[10px] mt-1 text-right select-none font-medium opacity-80">
                                    @m.SentAt.ToLocalTime().ToString("hh:mm tt")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Message Input Bar -->
            <div class="p-3.5 bg-white border-t border-slate-200 flex items-center gap-2">
                <input type="text"
                       class="flex-1 px-3.5 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-indigo-600 transition bg-slate-50"
                       @bind="newMessage"
                       @bind:event="oninput"
                       placeholder="Type a message..."
                       @onkeyup="HandleKeyUp" />
                <button type="button"
                        class="px-4 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-2xs transition cursor-pointer disabled:opacity-50"
                        disabled="@(string.IsNullOrWhiteSpace(newMessage))"
                        @onclick="SendMessage">
                    Send
                </button>
            </div>
        }
        else
        {
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400">
                <div class="w-16 h-16 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-3xl mb-3 text-indigo-600">
                    💬
                </div>
                <h3 class="text-sm font-bold text-slate-800">Select a Conversation</h3>
                <p class="text-xs text-slate-400 mt-1 max-w-xs leading-normal">Choose a conversation from the sidebar or click on a creator to initiate a private chat.</p>
            </div>
        }
    </div>
</div>

<!-- Unlock Modal -->
@if (showUnlockModal)
{
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-200 text-center animate-in fade-in duration-150">
            <div class="w-14 h-14 rounded-full bg-sky-50 border border-sky-200 flex items-center justify-center text-2xl mx-auto mb-3">
                🔒
            </div>
            <h3 class="text-base font-bold text-slate-900">Private Chat Locked</h3>
            <p class="text-xs text-slate-600 mt-1 leading-normal">
                This creator requires a one-time unlock fee for direct 1-on-1 private messaging.
            </p>

            <div class="my-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Creator Fee</span>
                <span class="text-xs font-bold text-sky-700 flex items-center gap-1">
                    💧 @unlockFeeLinkDrops Link Drops
                </span>
            </div>

            <div class="flex items-center gap-2 mt-5">
                <button type="button"
                        @onclick="CloseUnlockModal"
                        class="flex-1 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ConfirmUnlock"
                        disabled="@isUnlocking"
                        class="flex-1 py-2 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-2xs transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-1">
                    @if (isUnlocking)
                    {
                        <span class="animate-spin text-xs">⏳</span>
                        <span>Unlocking...</span>
                    }
                    else
                    {
                        <span>Unlock Chat</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ConversationModel>? conversations;
    private IReadOnlyList<ChatMessageModel>? messages;
    private int? activeConversationId;
    private ConversationModel? activeConversation;
    private string newMessage = "";

    // SignalR
    private HubConnection? hubConnection;

    // Modal state
    private bool showUnlockModal;
    private int targetCreatorUserId;
    private long unlockFeeLinkDrops;
    private bool isUnlocking;

    protected override async Task OnInitializedAsync()
    {
        await LoadConversationsAsync();
        await SetupSignalRAsync();
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/chat"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<ChatMessageModel>("ReceivePrivateMessage", async (msg) =>
            {
                if (activeConversationId.HasValue && msg.ConversationId == activeConversationId.Value)
                {
                    if (messages == null) messages = new List<ChatMessageModel>();
                    messages = messages.Concat(new[] { msg }).ToList();
                }
                await LoadConversationsAsync();
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch
        {
            // Silently handle fallback
        }
    }

    private async Task LoadConversationsAsync()
    {
        var res = await ChatApi.GetConversationsAsync();
        if (res.IsSuccess)
        {
            conversations = res.Data;
            if (activeConversationId.HasValue && conversations != null)
            {
                activeConversation = conversations.FirstOrDefault(c => c.ConversationId == activeConversationId.Value);
            }
        }
    }

    private async Task SelectConversation(int convId)
    {
        activeConversationId = convId;
        if (conversations != null)
        {
            activeConversation = conversations.FirstOrDefault(c => c.ConversationId == convId);
        }
        var res = await ChatApi.GetMessagesAsync(convId);
        if (res.IsSuccess)
        {
            messages = res.Data;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;
        var req = new SendMessageRequestModel(activeConversationId, null, newMessage);
        var res = await ChatApi.SendMessageAsync(req);

        if (res.IsSuccess)
        {
            newMessage = "";
            if (activeConversationId.HasValue)
            {
                await SelectConversation(activeConversationId.Value);
            }
            else
            {
                await LoadConversationsAsync();
            }
        }
        else if (string.Equals(res.Message, "PRIVATE_CHAT_PAYMENT_REQUIRED", StringComparison.OrdinalIgnoreCase))
        {
            if (activeConversation != null)
            {
                targetCreatorUserId = activeConversation.OtherUserId;
                var settingRes = await ChatApi.GetCreatorChatSettingsAsync(targetCreatorUserId);
                unlockFeeLinkDrops = settingRes.IsSuccess && settingRes.Data != null ? settingRes.Data.PrivateChatFeeLinkDrops : 0;
                showUnlockModal = true;
            }
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to send message.");
        }
    }

    public async Task OpenUnlockModalForCreator(int creatorUserId, long fee)
    {
        targetCreatorUserId = creatorUserId;
        unlockFeeLinkDrops = fee;
        showUnlockModal = true;
        await Task.CompletedTask;
    }

    private void CloseUnlockModal()
    {
        showUnlockModal = false;
    }

    private async Task ConfirmUnlock()
    {
        try
        {
            isUnlocking = true;
            var unlockRes = await ChatApi.UnlockPrivateChatAsync(targetCreatorUserId);
            if (unlockRes.IsSuccess)
            {
                Toast.Success("Private chat unlocked successfully!");
                showUnlockModal = false;
                await LoadConversationsAsync();
                await SelectConversation(unlockRes.Data);
            }
            else
            {
                Toast.Error(unlockRes.Message ?? "Failed to unlock private chat.");
            }
        }
        finally
        {
            isUnlocking = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}