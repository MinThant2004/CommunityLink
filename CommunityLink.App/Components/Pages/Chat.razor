@page "/chat"
@attribute [Authorize(Policy = PermissionCatalog.PolicyPrefix + PermissionCatalog.ChatAccess)]
@inject ChatApiService ChatApi
@inject ToastService Toast

<PageTitle>Messages - CommunityLink</PageTitle>

<div class="row">
    <div class="col-md-4 border-end">
        <h5 class="font-bold mb-3">💬 Conversations</h5>
        @if (conversations == null)
        {
            <div class="spinner-border spinner-border-sm text-primary"></div>
        }
        else if (conversations.Count == 0)
        {
            <div class="text-muted small">No active conversations.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var c in conversations)
                {
                    <button class="list-group-item list-group-item-action @(activeConversationId == c.ConversationId ? "active" : "")"
                            @onclick="() => SelectConversation(c.ConversationId)">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1 font-bold">@c.OtherDisplayName</h6>
                        </div>
                        <small class="text-muted">@(c.LastMessagePreview ?? "Start chatting...")</small>
                    </button>
                }
            </div>
        }
    </div>

    <div class="col-md-8">
        <div class="d-flex flex-column" style="height: 500px;">
            <div class="flex-grow-1 p-3 overflow-auto bg-light border rounded mb-3">
                @if (messages == null)
                {
                    <div class="text-center text-muted mt-5">Select a conversation or send a message below to start.</div>
                }
                else
                {
                    @foreach (var m in messages)
                    {
                        <div class="mb-2">
                            <span class="font-bold text-primary">@m.SenderName:</span>
                            <span class="bg-white p-2 rounded shadow-sm d-inline-block ms-2">@m.MessageText</span>
                            <span class="text-muted small ms-2">@m.SentAt.ToLocalTime().ToString("t")</span>
                        </div>
                    }
                }
            </div>

            <div class="d-flex gap-2">
                <input type="text" class="form-control" @bind="newMessage" @bind:event="oninput" placeholder="Type a message..." @onkeyup="HandleKeyUp" />
                <button class="btn btn-primary" @onclick="SendMessage">Send</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<ConversationModel>? conversations;
    private IReadOnlyList<ChatMessageModel>? messages;
    private int? activeConversationId;
    private string newMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var res = await ChatApi.GetConversationsAsync();
        if (res.IsSuccess)
        {
            conversations = res.Data;
            if (conversations?.Count > 0)
            {
                await SelectConversation(conversations[0].ConversationId);
            }
        }
    }

    private async Task SelectConversation(int convId)
    {
        activeConversationId = convId;
        var res = await ChatApi.GetMessagesAsync(convId);
        if (res.IsSuccess) messages = res.Data;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;
        var req = new SendMessageRequestModel(activeConversationId, null, newMessage);
        var res = await ChatApi.SendMessageAsync(req);
        if (res.IsSuccess)
        {
            newMessage = "";
            if (activeConversationId.HasValue) await SelectConversation(activeConversationId.Value);
            else
            {
                var convRes = await ChatApi.GetConversationsAsync();
                if (convRes.IsSuccess) conversations = convRes.Data;
            }
        }
    }
}