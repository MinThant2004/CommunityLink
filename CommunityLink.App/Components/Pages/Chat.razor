    // ---------- People search ----------

    private const int UserSearchDebounceMs = 300;
    private const int UserSearchMinTermLength = 2;

    private async Task ScheduleUserSearchAsync()
    {
        CancelUserSearch();

        var term = (searchText ?? string.Empty).Trim();
        if (term.Length < UserSearchMinTermLength)
        {
            userMatches = Array.Empty<UserSearchResultDto>();
            isSearchingUsers = false;
            return;
        }

        userSearchCts = new CancellationTokenSource();
        var token = userSearchCts.Token;
        isSearchingUsers = true;

        // Render the skeleton before awaiting, otherwise the loading state is never
        // painted: Blazor only re-renders once this handler finishes.
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(UserSearchDebounceMs, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            var res = await UserProfileApi.SearchUsersAsync(term, cancellationToken: token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            userMatches = res.IsSuccess && res.Data is not null ? res.Data : Array.Empty<UserSearchResultDto>();
            isSearchingUsers = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke superseded this request; the newer one owns the UI state.
        }
    }

    private void CancelUserSearch()
    {
        if (userSearchCts is null)
        {
            return;
        }

        try
        {
            userSearchCts.Cancel();
            userSearchCts.Dispose();
        }
        catch (ObjectDisposedException)
        {
            // Already torn down by a previous keystroke.
        }

        userSearchCts = null;
    }

    private async Task StartChatWithUserAsync(UserSearchResultDto user)
    {
        CancelUserSearch();
        searchText = null;
        userMatches = Array.Empty<UserSearchResultDto>();
        isSearchingUsers = false;

        var known = allThreads.FirstOrDefault(t => t.IsDirect && t.DirectUserId == user.UserId);
        if (known is not null)
        {
            await SelectThreadAsync(known);
            return;
        }

        _handledRoute = null;
        var thread = await OpenDirectThreadAsync(user.UserId, user.DisplayName, $"@{user.UserName}", user.AvatarUrl);

        // ActivateThreadAsync only promotes a thread that already has a server-side id, so
        // seed the brand-new 1:1 thread here to keep it visible in the list.
        if (!allThreads.Any(t => t.IsDirect && t.DirectUserId == thread.DirectUserId))
        {
            allThreads.Insert(0, thread);
        }
    }


