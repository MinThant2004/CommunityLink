@using CommunityLink.Shared.Features.Administration
@using System.Globalization
@inject AdministrationApiService AdminApi
@inject ToastService Toast
@inject IStringLocalizer<AppResources> Loc

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#112A46] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] space-y-4">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-2 border-b border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-full bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-[#0A1B2E] dark:text-white">@Loc["ReportContent_Title"]</h3>
                        <p class="text-[11px] text-[#7A8CA6]">@Loc["ReportContent_Subtitle"]</p>
                    </div>
                </div>
                <button type="button" @onclick="Close" aria-label="@Loc["Common_Cancel"]" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Reason Presets -->
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] uppercase tracking-wider">@Loc["ReportContent_ReasonLabel"]</label>
                <div class="space-y-1.5">
                    @foreach (var reason in reasonPresets)
                    {
                        <label class="flex items-center gap-2.5 p-2.5 rounded-xl border transition cursor-pointer @(selectedReason == reason.Key ? "bg-rose-50/70 dark:bg-rose-950/40 border-rose-500 text-rose-700 dark:text-rose-300" : "bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)] text-[#0A1B2E] dark:text-[#E1E8F0]")">
                            <input type="radio" name="reportReason" checked="@(selectedReason == reason.Key)"
                                   @onchange="() => selectedReason = reason.Key"
                                   class="text-rose-600 focus:ring-rose-500" />
                            <div class="text-xs">
                                <div class="font-bold">@Loc[reason.TitleKey]</div>
                                <div class="text-[11px] text-[#7A8CA6] mt-0.5">@Loc[reason.DescriptionKey]</div>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- Optional message details -->
            <div class="space-y-1.5">
                <label class="text-[11px] font-bold text-[#557392] dark:text-[#C4D2E1] uppercase tracking-wider">@Loc["ReportContent_DetailsLabel"]</label>
                <textarea @bind="details" rows="2" placeholder="@Loc["ReportContent_DetailsPlaceholder"]"
                          class="w-full text-xs p-3 rounded-xl bg-[#F8FAFC] dark:bg-[#0A1B2E]/60 border border-[#CBD5E1] dark:border-[rgba(196,210,225,0.20)] text-[#0A1B2E] dark:text-white placeholder-[#7A8CA6] focus:outline-none focus:ring-2 focus:ring-rose-500/30"></textarea>
            </div>

            <!-- Footer actions -->
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#E2E8F0] dark:border-[rgba(196,210,225,0.12)]">
                <button type="button" @onclick="Close" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#557392] dark:text-[#C4D2E1] hover:bg-[#F1F5F9] dark:hover:bg-[#1B3B5A] cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>
                <button type="button" @onclick="SubmitReportAsync" disabled="@isSubmitting"
                        class="px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white transition shadow-sm cursor-pointer disabled:opacity-50 flex items-center gap-1.5">
                    @if (isSubmitting)
                    {
                        <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    }
                    <span>@Loc["ReportContent_SubmitBtn"]</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ContentType { get; set; } = "POST"; // "POST" or "POLL"
    [Parameter] public int ContentId { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string selectedReason = "INAPPROPRIATE_CONTENT";
    private string details = "";
    private bool isSubmitting = false;

    private readonly List<(string Key, string TitleKey, string DescriptionKey)> reasonPresets =
    [
        ("INAPPROPRIATE_CONTENT", "ReportContent_ReasonInappropriate_Title", "ReportContent_ReasonInappropriate_Desc"),
        ("MISINFORMATION", "ReportContent_ReasonMisinformation_Title", "ReportContent_ReasonMisinformation_Desc"),
        ("MISLEADING", "ReportContent_ReasonMisleading_Title", "ReportContent_ReasonMisleading_Desc")
    ];

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SubmitReportAsync()
    {
        isSubmitting = true;
        try
        {
            var req = new CreateContentReportRequestModel(
                ContentType,
                ContentId,
                selectedReason,
                details);

            var res = await AdminApi.SubmitContentReportAsync(req);
            if (res.IsSuccess)
            {
                Toast.Success(Loc["ReportContent_Toast_Success"]);
                details = "";
                await Close();
            }
            else
            {
                Toast.Error(res.Message ?? Loc["ReportContent_Toast_Failed"].Value);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(CultureInfo.CurrentUICulture, Loc["ReportContent_Toast_ErrorPrefix"].Value, ex.Message));
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
