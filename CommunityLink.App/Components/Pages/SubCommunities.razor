<!-- Leave Sub-Community Impact Warning Modal -->
@if (showLeaveSubModal && subCommunityToLeave != null)
{
    var hasChildGroups = subChildGroupsToLeave.Count > 0;
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="relative w-full max-w-lg rounded-2xl bg-surface-container-low border border-surface-container-high/40 shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="px-6 py-4 flex items-center justify-between border-b border-surface-container-high/30 bg-surface-container-lowest/60">
                <div class="flex items-center gap-2.5 text-rose-600 dark:text-rose-400">
                    <span class="material-symbols-outlined text-2xl">warning</span>
                    <div>
                        <h3 class="font-title-lg text-title-lg font-bold text-on-surface">Leave Sub-Community</h3>
                        <p class="text-xs text-on-surface-variant">Membership departure review</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseLeaveSubModal" class="text-on-surface-variant hover:text-on-surface p-1 rounded-lg transition cursor-pointer">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
                <div class="p-3.5 rounded-xl bg-surface-container border border-surface-container-high/50 flex items-center gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-bold text-on-surface truncate">@subCommunityToLeave.Name</div>
                        <p class="text-xs text-on-surface-variant line-clamp-1 mt-0.5">@(subCommunityToLeave.Description ?? "No description available")</p>
                    </div>
                </div>

                @if (isLoadingSubChildren)
                {
                    <div class="py-6 flex flex-col items-center justify-center gap-2 text-on-surface-variant">
                        <div class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                        <span class="text-xs">Checking child working groups...</span>
                    </div>
                }
                else if (hasChildGroups)
                {
                    <!-- Impact Warning Box -->
                    <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 space-y-1">
                        <div class="flex items-center gap-1.5 font-bold text-xs">
                            <span class="material-symbols-outlined text-sm">report_problem</span>
                            <span>Child Groups Warning</span>
                        </div>
                        <p class="text-xs leading-relaxed">
                            You have joined <strong>@subChildGroupsToLeave.Count @(subChildGroupsToLeave.Count == 1 ? "working group" : "working groups")</strong> within this Sub-Community:
                        </p>
                    </div>

                    <!-- Groups List -->
                    <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                        @foreach (var grp in subChildGroupsToLeave)
                        {
                            <div class="p-3 rounded-lg bg-surface-container-low border border-surface-container-high/40">
                                <div class="text-xs font-bold text-on-surface">@grp.Name</div>
                                <p class="text-[11px] text-on-surface-variant line-clamp-1 mt-0.5">@(grp.Description ?? "Active working room")</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        Are you sure you want to leave <strong>@subCommunityToLeave.Name</strong>? You can rejoin anytime.
                    </p>
                }
            </div>

            <!-- Footer Actions -->
            <div class="px-6 py-4 border-t border-surface-container-high/30 bg-surface-container-lowest/60 flex flex-wrap items-center justify-end gap-2">
                <button type="button" @onclick="CloseLeaveSubModal" disabled="@isExecutingLeave"
                        class="px-4 py-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high font-label-md text-xs font-semibold transition cursor-pointer">
                    @Loc["Common_Cancel"]
                </button>

                @if (hasChildGroups)
                {
                    <button type="button" @onclick="() => ExecuteLeaveSubCommunityAsync(true)" disabled="@isExecutingLeave"
                            class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-label-md text-xs font-bold flex items-center gap-1.5 transition shadow-sm cursor-pointer disabled:opacity-50">
                        @if (isExecutingLeave)
                        {
                            <span class="animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                            <span>Departing...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm">delete_sweep</span>
                            <span>Confirm & Leave All</span>
                        }
                    </button>
                }
                else
                {
                    <button type="button" @onclick="() => ExecuteLeaveSubCommunityAsync(false)" disabled="@isExecutingLeave"
                            class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-label-md text-xs font-bold flex items-center gap-1.5 transition shadow-sm cursor-pointer disabled:opacity-50">
                        @if (isExecutingLeave)
                        {
                            <span class="animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                            <span>Leaving...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm">logout</span>
                            <span>Confirm Leave</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

