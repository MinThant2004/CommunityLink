    private bool isAdmin = false;
    private bool canCreateSubCommunity = false;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CheckAdminAsync(), LoadDataAsync());
    }

    private async Task CheckAdminAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                           ?? user.FindFirst("role")?.Value
                           ?? string.Empty;

                isAdmin = user.HasClaim("is_admin", "true") ||
                          user.HasClaim("role_type", "1") ||
                          user.IsInRole("ADMIN") ||
                          user.IsInRole("SYSTEM_ADMIN") ||
                          user.IsInRole("SYSTEMADMIN") ||
                          user.IsInRole("SUPERADMIN") ||
                          string.Equals(role, "ADMIN", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(role, "SYSTEM_ADMIN", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(role, "SYSTEMADMIN", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(role, "SUPERADMIN", StringComparison.OrdinalIgnoreCase) ||
                          user.HasClaim("permission", PermissionCatalog.AdminUserView);

                if (isAdmin)
                {
                    var permRes = await RoleApi.GetMyPermissionsAsync();
                    if (permRes.IsSuccess && permRes.Data != null)
                    {
                        canCreateSubCommunity = permRes.Data.Any(p =>
                            p.Equals(PermissionCatalog.CommunityCreate, StringComparison.OrdinalIgnoreCase) ||
                            p.Equals(PermissionCatalog.SubCommunityCreate, StringComparison.OrdinalIgnoreCase));
                    }
                    else
                    {
                        canCreateSubCommunity = false;
                    }
                }
                else
                {
                    canCreateSubCommunity = false;
                }
            }
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (allCommunities.Any())
        {
            ApplyParentSelection();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var res = await CommunityApi.GetCommunitiesAsync();
            if (res.IsSuccess && res.Value != null)
            {
                allCommunities = res.Value;
                parentCommunities = allCommunities
                    .Where(c => !c.ParentCommunityId.HasValue)
                    .OrderByDescending(c => c.MemberCount)
                    .ToList();

                ApplyParentSelection();
            }
            else
            {
                Toast.Error(res.Message ?? Loc["SubCommunities_Toast_LoadFailed"]);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(string.Format(CultureInfo.CurrentUICulture, Loc["SubCommunities_Toast_LoadError"], ex.Message));
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyParentSelection()
    {
        if (ParentCommunityId.HasValue && ParentCommunityId.Value > 0)
        {
            selectedParent = parentCommunities.FirstOrDefault(p => p.CommunityId == ParentCommunityId.Value)
                ?? allCommunities.FirstOrDefault(c => c.CommunityId == ParentCommunityId.Value);
        }

        if (selectedParent == null && parentCommunities.Any())
        {
            // Default to AI & DeepTech or the highest membership parent
            selectedParent = parentCommunities.FirstOrDefault(p => p.Name.Contains("Intelligence", StringComparison.OrdinalIgnoreCase) || p.Name.Contains("AI", StringComparison.OrdinalIgnoreCase))
                ?? parentCommunities.First();
        }

        if (selectedParent != null)
        {
            subCommunities = allCommunities
                .Where(c => c.ParentCommunityId == selectedParent.CommunityId)
                .OrderByDescending(c => c.MemberCount)
                .ToList();
        }
        else
        {
            subCommunities = [];
        }
    }

    private void OnParentCommunityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newId))
        {
            Navigation.NavigateTo($"sub-communities/{newId}");
        }
    }

    private string activeTab = "joined";

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private int joinedCount => subCommunities.Count(s => s.IsJoined || joinedCommunityIds.Contains(s.CommunityId));
    private int browseCount => subCommunities.Count(s => !s.IsJoined && !joinedCommunityIds.Contains(s.CommunityId));

    private List<CommunityModel> filteredSubCommunities
    {
        get
        {
            var list = subCommunities.AsEnumerable();

            if (activeTab == "joined")
            {
                list = list.Where(s => s.IsJoined || joinedCommunityIds.Contains(s.CommunityId));
            }
            else
            {
                list = list.Where(s => !s.IsJoined && !joinedCommunityIds.Contains(s.CommunityId));
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                list = list.Where(s =>
                    s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (s.Description != null && s.Description.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (s.CategoryName != null && s.CategoryName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return sortMode switch
            {
                "Name" => list.OrderBy(s => s.Name).ToList(),
                "Members" => list.OrderByDescending(s => s.MemberCount).ToList(),
                _ => list.OrderByDescending(s => s.MemberCount).ThenByDescending(s => s.PostCount).ToList()
            };
        }
    }

    private int totalGroupsCount => subCommunities.Sum(s => s.GroupCount);

    private int totalMemberCount => subCommunities.Sum(s => s.MemberCount);

    // Telemetry chart series: ranked member concentration and post velocity per sub-community.
    private const int MaxChartPoints = 12;

    private List<double> liquiditySeries => subCommunities
        .Take(MaxChartPoints)
        .Select(s => (double)s.MemberCount)
        .ToList();

    private List<double> velocitySeries => subCommunities
        .Take(MaxChartPoints)
        .Select(s => (double)s.PostCount)
        .ToList();

    private List<string> chartLabels => subCommunities
        .Take(MaxChartPoints)
        .Select(s => ShortenLabel(s.Name))
        .ToList();

    private string clusterHighlight
    {
        get
        {
            var total = totalMemberCount;
            if (total <= 0 || subCommunities.Count == 0) return Loc["TelemetryChart_NoSignal"];

            var top = subCommunities.Take(3).Sum(s => s.MemberCount);
            var share = (double)top / total * 100d;
            var pct = share.ToString("0", CultureInfo.InvariantCulture);
            return share >= 0 && share < 100
                ? string.Format(CultureInfo.CurrentUICulture, Loc["TelemetryChart_Top3Concentration"], pct)
                : string.Format(CultureInfo.CurrentUICulture, Loc["TelemetryChart_Concentration"], pct);
        }
    }

    private static string ShortenLabel(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Node";
        var cleaned = name.Trim();
        var cut = cleaned.IndexOfAny(new[] { ' ', '&', '-', '/', ',' });
        if (cut > 1) cleaned = cleaned[..cut];
        return cleaned.Length <= 12 ? cleaned : cleaned[..12];
    }

    private static string InitialOf(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private string GetLocalizedSortMode(string mode) => mode switch
