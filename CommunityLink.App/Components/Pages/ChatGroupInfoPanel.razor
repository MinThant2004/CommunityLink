@inject ToastService Toast

<div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <!-- Backdrop -->
    <div class="fixed inset-0" @onclick="OnClose"></div>

    <!-- Centered Modal Card -->
    <div class="relative w-full max-w-lg bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-2xl flex flex-col" @onclick:stopPropagation>
        <!-- Header -->
        <div class="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50 shrink-0">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                    </svg>
                </span>
                Group Info &amp; Members
            </h3>
            <button type="button" @onclick="OnClose" title="Close"
                    class="text-slate-500 hover:text-slate-900 p-1.5 rounded-lg hover:bg-slate-200 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Body Content (scrollable, never stuck) -->
        <div class="p-5 space-y-6 overflow-y-auto">

            <!-- Group Avatar & Main Info -->
            <div class="text-center space-y-3">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-slate-100 border border-slate-200 text-indigo-600 font-bold text-3xl flex items-center justify-center overflow-hidden shadow-xs">
                    @if (!string.IsNullOrWhiteSpace(Group.AvatarUrl))
                    {
                        <img src="@Group.AvatarUrl" alt="@Group.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span>@(Group.Name.Substring(0, 1).ToUpper())</span>
                    }
                </div>

                <div>
                    <h2 class="font-bold text-slate-900 text-base">@Group.Name</h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Created by <span class="text-indigo-600 font-semibold">@Group.CreatorName</span>
                    </p>
                </div>

                <div class="flex items-center justify-center gap-2">
                    @if (Group.ChatType == "PAID")
                    {
                        <span class="px-2.5 py-1 bg-amber-50 border border-amber-200 text-amber-700 font-semibold text-xs rounded-md flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Paid (@Group.JoinFeeLinkDrops LD)
                        </span>
                    }
                    else
                    {
                        <span class="px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-700 font-semibold text-xs rounded-md flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            Free Group
                        </span>
                    }
                </div>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrWhiteSpace(Group.Description))
            {
                <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-1">
                    <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">About</div>
                    <p class="text-xs text-slate-700 leading-relaxed">@Group.Description</p>
                </div>
            }

            <!-- Role-based Action Buttons -->
            <div class="space-y-2">
                @if (Group.UserRole == "OWNER")
                {
                    <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-center space-y-2">
                        <div class="text-xs font-bold text-amber-800 flex items-center justify-center gap-1">
                            <svg class="w-4 h-4 text-amber-700" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.563.563 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                            </svg>
                            You are the Group Owner
                        </div>
                        <div class="flex items-center justify-center gap-2">
                            <button type="button" @onclick='() => Toast.Info("Group Settings is available in Creator Dashboard.")'
                                    class="px-3 py-1.5 bg-white border border-amber-300 hover:bg-amber-100 text-amber-900 text-xs font-semibold rounded-lg transition shadow-2xs flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 0 1 .12-1.45l.773-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.781-.929l.149-.894ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                Settings
                            </button>
                            <button type="button" @onclick='() => Toast.Info("Member management is active.")'
                                    class="px-3 py-1.5 bg-white border border-amber-300 hover:bg-amber-100 text-amber-900 text-xs font-semibold rounded-lg transition shadow-2xs flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                                </svg>
                                Manage
                            </button>
                        </div>
                    </div>
                }
                else if (Group.IsJoined)
                {
                    <button type="button" @onclick="OnLeave" disabled="@IsSubmitting"
                            class="w-full py-2 bg-white hover:bg-rose-50 hover:text-rose-700 border border-rose-200 text-rose-600 font-semibold text-xs rounded-xl transition cursor-pointer shadow-2xs flex items-center justify-center gap-1.5 disabled:opacity-50">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                        </svg>
                        Leave Chat Group
                    </button>
                }
            </div>

            <!-- Members Section -->
            <div class="space-y-3">
                <div class="flex items-center justify-between text-xs border-b border-slate-200 pb-2">
                    <span class="font-bold text-slate-900 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                        Members (@(Members?.Count ?? 0))
                    </span>
                </div>

                @if (Members == null || Members.Count == 0)
                {
                    <p class="text-xs text-slate-500 py-2">No member info available.</p>
                }
                else
                {
                    <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
                        @foreach (var member in Members)
                        {
                            <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-8 h-8 rounded-lg bg-white border border-slate-300 text-indigo-600 font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden shadow-2xs">
                                        @if (!string.IsNullOrWhiteSpace(member.UserAvatar))
                                        {
                                            <img src="@member.UserAvatar" alt="@member.DisplayName" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <span>@(member.DisplayName.Substring(0, 1).ToUpper())</span>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-xs font-semibold text-slate-800 truncate">@member.DisplayName</div>
                                        <div class="text-[10px] text-slate-500 truncate">@@member.UserName</div>
                                    </div>
                                </div>

                                @if (member.Role == "OWNER")
                                {
                                    <span class="px-1.5 py-0.5 bg-amber-100 border border-amber-300 text-amber-800 font-bold text-[9px] rounded-md shrink-0 flex items-center gap-0.5">
                                        <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.563.563 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                                        </svg>
                                        OWNER
                                    </span>
                                }
                                else if (member.Role == "ADMIN")
                                {
                                    <span class="px-1.5 py-0.5 bg-indigo-100 border border-indigo-300 text-indigo-800 font-bold text-[9px] rounded-md shrink-0 flex items-center gap-0.5">
                                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                                        </svg>
                                        ADMIN
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Footer -->
        <div class="px-5 py-3.5 border-t border-slate-200 bg-slate-50 flex justify-end shrink-0">
            <button type="button" @onclick="OnClose"
                    class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 shadow-2xs transition cursor-pointer">
                Close
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public required ChatGroupModel Group { get; set; }
    [Parameter] public IReadOnlyList<ChatGroupMemberModel>? Members { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}