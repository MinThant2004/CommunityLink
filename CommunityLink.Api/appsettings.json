{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CommunityLink;Trusted_Connection=True;TrustServerCertificate=True;",
  },
  "Jwt": {
    "Key": "CommunityLinkSuperSecretSigningKey1234567890!_SecurityKey",
    "Issuer": "CommunityLink.Api",
    "Audience": "CommunityLink.Clients",
    "ExpiryMinutes": 480
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordHistoryLimit": 5,
    "PasswordExpiryDays": 90
  }
}
